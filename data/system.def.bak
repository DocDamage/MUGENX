; MUGEN X ENGINE - SYSTEM CONFIGURATION
; Points the engine to the MUGEN X Lua hooks

[Info]
name = "MUGEN X ENGINE"
author = "MUGEN X Team"
versiondate = 11,25,2025
mugenversion = 1.1
localcoord = 1280,720

[Files]
spr = system.sff
snd = system.snd
logo.storyboard = 
