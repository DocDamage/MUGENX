; MUGEN X ENGINE - SYSTEM CONFIGURATION (CYBERPUNK EDITION)
; Updated: 11/25/2025

[Info]
name = "MUGEN X ENGINE"
author = "MUGEN X Team"
versiondate = 11,25,2025
mugenversion = 1.1
localcoord = 1280,720

[Files]
spr = system.sff
snd = system.snd
logo.storyboard = 
intro.storyboard = 
select = select.def
fight = fight.def
font1 = font/f-6x9.def
font2 = font/f-6x9.def
font3 = font/enter48.def
font4 = font/Open_Sans.def
font5 = font/name14.def

[Music]
; Music assets are currently not present in the workspace, so keep menu
; BGM paths empty to avoid repeated startup warnings during smoke tests.
title.bgm =
select.bgm =
vs.bgm =
victory.bgm =

[Module]
script = external/script/main.lua

; -------------------------------------------------------------------
; TITLE SCREEN (CLEAN & STABLE)
; -------------------------------------------------------------------
[Title Info]
fadein.time = 20
fadeout.time = 20
menu.pos = 640, 360
menu.item.font = 5,0,0
menu.item.active.font = 5,5,0
menu.item.spacing = 0, 40
menu.window = 0,0, 1280,720
menu.boxcursor.visible = 0

; Menu Items
menu.itemname.arcade = "ARCADE"
menu.itemname.versus = "VERSUS"
menu.itemname.teamarcade = "TEAM ARCADE"
menu.itemname.teamversus = "TEAM VERSUS"
menu.itemname.training = "TRAINING"
menu.itemname.watch = "WATCH"
menu.itemname.options = "OPTIONS"
menu.itemname.exit = "EXIT"

; Cursor
cursor.move.snd = 100,0
cursor.done.snd = 100,1
cancel.snd = 100,2

[TitleBGdef]
bgclearcolor = 15,15,20

; Simple Gradient Effect
[TitleBG Dark]
type = normal
spriteno = -1
start = 0,0
mask = 1
window = 0,0, 1280,720
velocity = 0,0

; -------------------------------------------------------------------
; SELECT SCREEN
; -------------------------------------------------------------------
[Select Info]
fadein.time = 15
fadeout.time = 15
rows = 7
columns = 15
wrapping = 1
pos = 60, 120
showemptyboxes = 0
moveoveremptyboxes = 1

; Cell Size & Spacing
cell.size = 70, 70
cell.spacing = 6
cell.bg.spr = 150,0
cell.random.spr = 151,0
cell.random.switchtime = 4

; P1 Cursor
p1.cursor.startcell = 0,0
p1.cursor.active.spr = 160,0
p1.cursor.done.spr = 161,0
p1.cursor.move.snd = 100,0
p1.cursor.done.snd = 100,1

; P2 Cursor
p2.cursor.startcell = 0,14
p2.cursor.active.spr = 170,0
p2.cursor.done.spr = 171,0
p2.cursor.move.snd = 100,0
p2.cursor.done.snd = 100,1

; Portraits
portrait.spr = 9000,0
portrait.offset = 0,0
portrait.scale = 0.58, 0.58

; Big Portraits (P1/P2)
p1.face.spr = 9000,1
p1.face.offset = 100, 600
p1.face.scale = 1,1
p1.face.facing = 1

p2.face.spr = 9000,1
p2.face.offset = 1180, 600
p2.face.scale = 1,1
p2.face.facing = -1

; Names
p1.name.offset = 100, 580
p1.name.font = 5,0,1
p2.name.offset = 1180, 580
p2.name.font = 5,0,-1

; Stage Selection
stage.pos = 640, 680
stage.active.font = 5,5,0
stage.active2.font = 5,5,0
stage.done.font = 5,0,0

[SelectBGdef]
bgclearcolor = 20,20,30

; -------------------------------------------------------------------
; VS SCREEN
; -------------------------------------------------------------------
[VS Screen]
time = 300
fadein.time = 20
fadeout.time = 20

; P1
p1.pos = 300, 360
p1.spr = 9000, 1
p1.facing = 1
p1.scale = 1.5, 1.5

; P2
p2.pos = 980, 360
p2.spr = 9000, 1
p2.facing = -1
p2.scale = 1.5, 1.5

; VS Logo
vs.spr = 200,0
vs.offset = 640, 360
vs.scale = 1,1

[VSBGdef]
bgclearcolor = 0,0,0

[VSBG Flash]
type = normal
spriteno = 0,0
start = 0,0
tile = 1,1
velocity = 0,0
window = 0,0, 1280,720
trans = add
alpha = 128,128
