type = U
physics = U
ctrl = 1

[State anim]
type = ChangeAnim
trigger1 = time = 0
value = 140+(statetype=C)+(statetype=A)*2

[State type]
type = StateTypeSet
trigger1 = time = 0 && statetype = S
physics = S
[State type]
