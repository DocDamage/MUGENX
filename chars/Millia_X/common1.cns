value = 131

;---------------------------------------------------------------------------
; AIR GUARD (guarding)
[Statedef 132]
type = A
physics = N

[State anim]
type = ChangeAnim
trigger1 = anim!= 132
value = 132

[State vel]
type = veladd
trigger1 = 1
y = const(movement.yaccel)

[State 132]
type = varset
trigger1 = 1
sysvar(0) =(pos y >= 0)&&(vel y > 0)

[State vel]
type = velset
trigger1 = sysvar(0)
y = 0

[State pos]
type = posset
trigger1 = sysvar(0)
y = 0

[State 132]
type = ChangeState
trigger1 = sysvar(0)
trigger1 = command!= "holdback"
value = 52

[State 132]
type = ChangeState
trigger1 = sysvar(0)
value = 130

;---------------------------------------------------------------------------
