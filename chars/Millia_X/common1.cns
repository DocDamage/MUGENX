trigger1 = time = 4
trigger1 = command = "holdback"
x = -1

[State hit]
type = NotHitBy
trigger1 = time = 0
value = SCA
time = 8

[State ctrl]
type = ctrlset
trigger1 = time = 20
value = 1

[State vel]
type = veladd
trigger1 = time >= 4
y = const(movement.yaccel)

[State Land on ground]
type = ChangeState
trigger1 = time >= 4
trigger1 = pos y >= 0 && vel y > 0
value = 52
ctrl = 1

