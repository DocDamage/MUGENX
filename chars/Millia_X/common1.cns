type = S
movetype = I
physics = S
anim = 5200
facep2 = 1

[State Turn if not facing opponent]
type = turn
trigger1 = time = 0
trigger1 = p2dist x < -5

[State vel]
type = velset
trigger1 = time = 0
x = -15
y = 0

[State pos]
type = posset
trigger1 = 1
y = 0

[State hit]
type = NotHitBy
trigger1 = 1
value = SCA

[State Blink white]
