;---------------------------------------------------------------------------
; GUARD (start)
[Statedef 120]
type = U
physics = U

[State anim]
type = ChangeAnim
trigger1 = time = 0
value = 120+(statetype=C)+(statetype=A)*2

[State type]
type = StateTypeSet
trigger1 = time = 0 && statetype = S
physics = S
[State type]
type = StateTypeSet
trigger1 = time = 0 && statetype = C
physics = C
[State type]
type = StateTypeSet
trigger1 = time = 0 && statetype = A
physics = A

[State 120]
type = ChangeState
trigger1 = animtime = 0
value = 130+(statetype=C)+(statetype=A)*2

