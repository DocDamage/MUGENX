[Statedef 110]
type = S
physics = N
anim = 110
velset = 0
ctrl = 0

[State hit]
type = HitBy
trigger1 = time = 0
value = SCA,NT,ST,HT
time = 30

[State vel]
type = velset
trigger1 = time = 0
z = -7

[State 110]
type = velmul
trigger1 = 1
z = 0.8

[State vel]
type = velset
trigger1 = animtime = -8
z = 0

[State end]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; RUN_DOWN
[Statedef 115]
type = S
physics = N
anim = 110
velset = 0
ctrl = 0

[State hit]
