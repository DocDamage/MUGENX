type = S
ctrl = 0
velset = 0,0

[State 190, 1]
type = ChangeAnim
trigger1 = selfanimexist(190)
value = 190

[State 190, 2] ;Go straight to intro.
type = ChangeState
trigger1 = time = 0
value = 191

;---------------------------------------------------------------------------
; INTRO (override this state to give character an intro)
[Statedef 191]
type = S
ctrl = 0

[State 191, 1]
type = ChangeState
trigger1 = time = 0
value = 0


;---------------------------------------------------------------------------
; HITG_SHAKE
[Statedef 5000]
type = S
movetype = H
physics = N
velset = 0,0

[State Anim for HIT_LIGHT to HIT_HARD]
type = ChangeAnim
trigger1 = time = 0
trigger1 = gethitvar(animtype)!= [3,5]
value = ifelse((gethitvar(groundtype)=1),5000,5010)+gethitvar(animtype)

[State Anim for HIT_BACK]
type = ChangeAnim
trigger1 = time = 0
trigger1 = gethitvar(animtype) = [3,5]
value = 5030

[State Anim for HIT_UP/HIT_DIAGUP (only if it exists)]
type = ChangeAnim
trigger1 = time = 0
trigger1 =(gethitvar(animtype)=[4,5])&&(selfanimexist(5047+gethitvar(animtype)))
value = 5047+gethitvar(animtype)

[State Freeze anim]
type = ChangeAnim
trigger1 = time > 0
value = anim

[State State type gets set to aerial if getting hit up]
type = StateTypeSet
trigger1 = time = 0
trigger1 = gethitvar(yvel)!= 0 && gethitvar(fall)
trigger2 = pos y!= 0
type = A

[State 5000]
type = ChangeState
trigger1 = hitshakeover
trigger1 = gethitvar(yvel) = 0
value = 5001

[State 5000]
type = ChangeState
trigger1 = hitshakeover
value = 5030

;---------------------------------------------------------------------------
; HITG_SLIDE
[Statedef 5001]
type = S
movetype = H
physics = S

[State vel]
type = HitVelSet
trigger1 = time = 0
x = 1

[State anim]
type = ChangeAnim
trigger1 = animtime = 0
value = 5005+gethitvar(animtype)+(gethitvar(groundtype)=2)*10

[State Stop sliding back]
type = velmul
trigger1 = time >= gethitvar(slidetime)
x = .6

[State vel]
type = velset
trigger1 = hitover
x = 0

[State defence]
type = DefenceMulSet
trigger1 = hitover
value = 1

[State end]
type = ChangeState
trigger1 = hitover
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; HITC_SHAKE
[Statedef 5010]
type = C
movetype = H
physics = N
velset = 0,0

[State Anim for HIT_LIGHT to HIT_HARD]
type = ChangeAnim
trigger1 = time = 0
trigger1 = gethitvar(animtype)!= [3,5]
value = 5020+gethitvar(animtype)

[State Anim for HIT_BACK]
type = ChangeAnim
trigger1 = time = 0
trigger1 = gethitvar(animtype) = [3,5]
value = 5030

[State Anim for HIT_UP/HIT_DIAGUP (only if it exists)]
type = ChangeAnim
trigger1 = time = 0
trigger1 =(gethitvar(animtype)=[4,5])&&(selfanimexist(5047+gethitvar(animtype)))
value = 5047+gethitvar(animtype)

[State Freeze anim]
type = ChangeAnim
trigger1 = time > 0
value = anim

[State 5010]
type = ChangeState
trigger1 = hitshakeover
trigger1 = gethitvar(yvel) = 0
value = 5011

[State 5010]
type = ChangeState
trigger1 = hitshakeover
value = 5030

;---------------------------------------------------------------------------
; HITC_SLIDE
[Statedef 5011]
type = C
movetype = H
physics = C

[State vel]
type = HitVelSet
trigger1 = time = 0
x = 1

[State 5011]
type = ChangeAnim
trigger1 = animtime = 0
value = 5025+gethitvar(animtype)

[State Stop sliding back]
type = velmul
trigger1 = time >= gethitvar(slidetime)
x = .6

[State vel]
type = velset
trigger1 = hitover
x = 0

[State defence]
type = DefenceMulSet
trigger1 = hitover
value = 1

[State end]
type = ChangeState
trigger1 = hitover
value = 11
ctrl = 1

;---------------------------------------------------------------------------
; HITA_SHAKE
[Statedef 5020]
type = A
movetype = H
physics = N
velset = 0,0

[State Anim for HIT_LIGHT to HIT_HARD]
type = ChangeAnim
trigger1 = time = 0
trigger1 = gethitvar(animtype)!= [3,5]
value = ifelse((gethitvar(airtype)=1),5000,5010)+gethitvar(animtype)

[State Anim for HIT_BACK]
type = ChangeAnim
trigger1 = time = 0
trigger1 = gethitvar(animtype) = [3,5]
value = 5030

[State Anim for HIT_UP/HIT_DIAGUP (only if it exists)]
type = ChangeAnim
trigger1 = time = 0
trigger1 =(gethitvar(animtype)=[4,5])&&(selfanimexist(5047+gethitvar(animtype)))
value = 5047+gethitvar(animtype)

[State Freeze anim]
type = ChangeAnim
trigger1 = time > 0
value = anim

[State 5020]
type = ChangeState
trigger1 = hitshakeover
value = 5030

;---------------------------------------------------------------------------
; HITA_UP (initial going up)
[Statedef 5030]
type = A
movetype = H
physics = N
ctrl = 0

[State vel]
type = veladd
trigger1 = 1
y = gethitvar(yaccel)

[State hit]
type = HitVelSet
trigger1 = time = 0
x = 1
y = 1

[State HITA_RECOV]
type = ChangeState
triggerall =!hitfall
trigger1 = hitover
trigger2 = vel y > 0 && pos y >= 10
value = 5040

[State HITA_FALL]
type = ChangeState
triggerall = hitfall
trigger1 = hitover
trigger2 = vel y > 0 && pos y >= 10
value = 5050

[State 5030]
type = ChangeState
trigger1 = animtime = 0
value = 5035 ;HITA_UP (transition)

;---------------------------------------------------------------------------
; HITA_UP_T (transition)
[Statedef 5035]
type = A
movetype = H
physics = N

[State 5035]
type = ChangeAnim
trigger1 = time = 0
trigger1 = selfanimexist(5035)
trigger1 = anim!=[5051,5059] ;Not if in hit up anim
trigger1 = anim!= 5090 ;Not if hit off ground anim
value = 5035

[State vel]
type = veladd
trigger1 = 1
y = gethitvar(yaccel)

[State HITA_RECOV]
type = ChangeState
triggerall =!HitFall
trigger1 = hitover
trigger2 = animtime = 0
trigger3 = vel y > 0 && pos y >= 10
trigger4 = time = 0    ;No transition anim
trigger4 = anim!= 5035
value = 5040

[State HITA_FALL]
type = ChangeState
triggerall = HitFall
trigger1 = hitover
trigger2 = animtime = 0
trigger3 = vel y > 0 && pos y >= 10
trigger4 = time = 0    ;No transition anim
trigger4 = anim!= 5035
value = 5050

;---------------------------------------------------------------------------
; HITA_RECOV (recovering in air, not falling)
[Statedef 5040]
type = A
movetype = H
physics = N

[State 5040]
type = ChangeState
trigger1 =!alive
value = 5050

[State 5040]
type = ChangeAnim
trigger1 = animtime = 0
trigger1 = anim!= 5040
trigger2 = time = 0
trigger2 = anim!= 5035
value = 5040

[State ctrl]
type = ctrlset
trigger1 = hitover
value = 1

[State 5040]
type = StateTypeSet
trigger1 = hitover
movetype = I

[State vel]
type = veladd
trigger1 = 1
y = gethitvar(yaccel)

[State land]
type = ChangeState
trigger1 = vel y > 0 && pos y >= 0
value = 52

;---------------------------------------------------------------------------
; HITA_FALL (knocked up, falling)
[Statedef 5050]
type = A
movetype = H
physics = N

[State Change anim when done with transition]
type = ChangeAnim
trigger1 = animtime = 0
trigger1 = anim = 5035
trigger2 = time = 0 ;If no transition anim
trigger2 = anim!= 5035
trigger2 =(anim!=[5051,5059])&&(anim!=[5061,5069])
trigger2 = anim!= 5090 ;Not if hit off ground anim
value = 5050

[State Coming down anim]
type = ChangeAnim
trigger1 = anim = [5050,5059]
trigger1 = vel y >= ifelse(anim=5050,1,-2)
trigger1 = selfanimexist(anim+10)
value = anim+10
persistent = 0

[State vel]
type = veladd
trigger1 = 1
y = gethitvar(yaccel)

[State Recover]
type = ChangeState
triggerall = vel y > -1
triggerall = alive && canrecover
trigger1 = command = "recovery"
value = 5200

[State 5050]
type = ChangeState
trigger1 = vel y > 0
trigger1 = pos y >= ifelse((anim=[5051,5059])||(anim=[5061,5069]),0,25)
value = 5100

;---------------------------------------------------------------------------
; HIT_TRIP (shaking)
[Statedef 5070]
type = A
movetype = H
physics = N
velset = 0,0

[State anim]
type = ChangeAnim
trigger1 =!selfanimexist(5071)
value = 5070

[State anim]
type = ChangeAnim
trigger1 = selfanimexist(5071)
value = ifelse((gethitvar(animtype)=4),5071,5070)

[State 5070]
type = ChangeState
trigger1 = hitshakeover
value = 5071

;---------------------------------------------------------------------------
; HIT_TRIP2 (fall through air)
[Statedef 5071]
type = A
movetype = H
physics = N

[State vel]
type = HitVelSet
trigger1 = time = 0
x = 1
y = 1

[State Acceleration]
type = veladd
trigger1 = 1
y = gethitvar(yaccel)

[State anim]
type = ChangeAnim
trigger1 = anim = 5071
trigger1 = selfanimexist(5071)
trigger1 = pos y >= 15 && vel y > 0
value = 5161

[State Hit ground]
type = ChangeState
trigger1 = pos y >= 15 && vel y > 0
value = 5110

;---------------------------------------------------------------------------
; HITL_SHAKE
[Statedef 5080]
type = L
movetype = H
physics = N
velset = 0,0

[State Set default anim]
type = varset
trigger1 = time = 0
sysvar(2) = ifelse(gethitvar(yvel)=0,5080,5090)

[State var]
type = varadd
trigger1 = time = 0
trigger1 =(anim = [5081,5089])||(anim = [5111,5119])
trigger1 = selfanimexist(sysvar(2)+(anim%10))
sysvar(2) = anim%10

[State If 5090 doesn't exist, default to 5030]
type = varset
trigger1 = time = 0
trigger1 = sysvar(2) = 5090
trigger1 = !selfanimexist(5090)
sysvar(2) = 5030

[State Freeze]
type = ChangeAnim
trigger1 = 1
value = sysvar(2)

[State HITL_SLIDE]
type = ChangeState
trigger1 = hitshakeover
trigger1 = gethitvar(yvel) = 0
value = 5081

[State HITA_UP]
type = ChangeState
trigger1 = hitshakeover
trigger1 = gethitvar(yvel)!= 0
value = 5090

;---------------------------------------------------------------------------
; HITL_SLIDE
[Statedef 5081]
type = L
movetype = H
physics = C

[State vel]
type = hitvelset
trigger1 = time = 0
x = 1

[State vel]
type = velset
trigger1 = hitover
x = 0

[State Don't show hit ground frame]
type = varset
trigger1 = time = 0
sysvar(0) = 1

[State HIT_LIEDOWN]
type = ChangeState
trigger1 = hitover
value = 5110

;---------------------------------------------------------------------------
; LieDown Hit (hit up into air)
[Statedef 5090]
type = A
movetype = H
physics = N
ctrl = 0

[State vel]
type = veladd
trigger1 = 1
y = gethitvar(yaccel)

[State hit]
type = HitVelSet
trigger1 = time = 0
x = 1
y = 1

[State Recover]
type = null;ChangeState
triggerall = vel y > -1
triggerall = alive && canrecover
trigger1 = command = "recovery"
value = 5200

[State 5090]
type = ChangeState
trigger1 = pos y >= 25 && vel y > 0
value = 5100

;---------------------------------------------------------------------------
; HIT_BOUNCE (hit ground)
[Statedef 5100]
type = L
movetype = H
physics = N

[State vel]
type = velset
trigger1 = time = 0
trigger1 = gethitvar(fall.yvel) = 0
trigger1 = vel x > 1
x = 1

[State EnvShake]
type = FallEnvShake
trigger1 = time = 0

[State Save fall velocity]
type = varset
trigger1 = time = 0
;trigger1 = gethitvar(fall.yvel) = 0
sysvar(1) = floor(vel y)

[State Hit ground anim (normal)]
type = ChangeAnim
triggerall = time = 0
trigger1 =(anim!= [5051,5059])&&(anim!= [5061,5069])
trigger2 =!selfanimexist(5100+(anim%10))
value = 5100

[State Hit ground anim (for hit up)]
type = ChangeAnim
trigger1 = time = 0
trigger1 =(anim = [5051,5059])||(anim = [5061,5069])
trigger1 = selfanimexist(5100+(anim%10))
value = 5100+(anim%10)

[State pos]
type = posset
trigger1 = time = 0
y = 0
[State vel]
type = velset
trigger1 = time = 0
y = 0

[State Reduce speed]
type = velmul
trigger1 = time = 0
x = .75

[State 5100]
type = ChangeState
trigger1 = time = 0
trigger1 = gethitvar(fall.yvel) = 0
value = 5110 ;HIT_LIEDOWN

[State explod]
type = Explod
trigger1 = time = 1
anim = f60+(sysvar(1)>5)+(sysvar(1)>14)
sprpriority = -6+(sysvar(1)>14)*12
ownpal = 1

[State 5100]
type = HitFallDamage
trigger1 = time = 3

[State snd]
type = PlaySnd
trigger1 = time = 1
value = f7,(sysvar(1)>5)+(sysvar(1)>14)

[State pos]
type = PosFreeze
trigger1 = 1

[State 5100]
type = ChangeState
trigger1 = animtime = 0
value = 5101

;---------------------------------------------------------------------------
; HIT_BOUNCE (bounce into air)
[Statedef 5101]
type = L
movetype = H
physics = N

[State Coming hit ground anim (normal)]
type = ChangeAnim
triggerall = time = 0
trigger1 = anim!= [5101,5109]
trigger2 =!selfanimexist(5160+(anim%10))
value = 5160

[State Coming hit ground anim (for hit up)]
type = ChangeAnim
triggerall = time = 0
trigger1 = anim = [5101,5109]
trigger1 = selfanimexist(5160+(anim%10))
value = 5160+(anim%10)

[State 5101]
type = HitFallVel
trigger1 = time = 0

[State pos]
type = posset
trigger1 = time = 0
y = 20

[State Acceleration]
type = veladd
trigger1 = 1
y = .5

[State Hit ground]
type = ChangeState
trigger1 = vel y > 0 && pos y >= 10
value = 5110

;---------------------------------------------------------------------------
; HIT_LIEDOWN
[Statedef 5110]
type = L
movetype = H
physics = N

[State EnvShake]
type = FallEnvShake
trigger1 = time = 0

[State For hit up/up-diag type (from state 5081)]
type = ChangeAnim
trigger1 = selfanimexist(5110+(anim%10))
trigger1 = anim = [5081,5089]
value = 5110+(anim%10)
persistent = 0

[State Hit ground anim (normal)]
type = ChangeAnim
triggerall = time = 0
triggerall = anim!= [5110,5119] ;Not already changed anim
trigger1 = anim!= [5161,5169]
trigger2 =!selfanimexist(5170+(anim%10))
value = 5170

[State Hit ground anim (for hit up)]
type = ChangeAnim
triggerall = time = 0
triggerall = anim!= [5110,5119] ;Not already changed anim
trigger1 = anim = [5161,5169]
trigger1 = selfanimexist(5170+(anim%10))
value = 5170+(anim%10)

[State 5110]
type = HitFallDamage
trigger1 = time = 0

[State pos]
type = posset
trigger1 = time = 0
y = 0

[State Get fall velocity]
type = varset
trigger1 = time = 0
trigger1 = gethitvar(fall.yvel)!= 0
sysvar(1) = floor(vel y)

[State explod]
type = Explod
trigger1 = time = 0
trigger1 =!sysvar(0)
anim = f60+(sysvar(1)>5)+(sysvar(1)>14)
sprpriority = -6+(sysvar(1)>14)*12
ownpal = 1

[State snd]
type = PlaySnd
trigger1 = time = 0
trigger1 =!sysvar(0)
value = f7,(sysvar(1)>5)+(sysvar(1)>14)

[State vel]
type = velset
trigger1 = time = 0
y = 0

[State For hit up type]
type = ChangeAnim
triggerall = anim = [5171,5179]
triggerall = selfanimexist(5110+(anim%10))
trigger1 = animtime = 0
trigger2 = sysvar(0) ;sysvar(0) = 1 avoids hit ground anim
value = 5110+(anim%10)
persistent = 0

[State For normal]
type = ChangeAnim
triggerall = anim!= [5111,5119]
trigger1 = animtime = 0
trigger2 = sysvar(0) ;sysvar(0) = 1 avoids hit ground frame
value = 5110
persistent = 0

[State If just died]
type = ChangeState
triggerall =!alive
trigger1 = animtime = 0
trigger2 = sysvar(0) ;sysvar(0) = 1 avoids hit ground frame
trigger3 = anim = [5110,5119]
value = 5150

[State var]
type = varset
trigger1 = sysvar(0)
trigger1 = time = 0
sysvar(0) = 0

[State Friction]
type = velmul
trigger1 = 1
x = .85

;---------------------------------------------------------------------------
; HIT_GETUP
[Statedef 5120]
type = L
movetype = I
physics = N

[State Get up anim (normal)]
type = ChangeAnim
triggerall = time = 0
trigger1 = anim!= [5111,5119]
trigger2 =!selfanimexist(5120+(anim%10))
value = 5120

[State Get up anim (for hit up/diag-up)]
type = ChangeAnim
triggerall = time = 0
trigger1 = anim = [5111,5119]
trigger1 = selfanimexist(5120+(anim%10))
value = 5120+(anim%10)

[State vel]
type = velset
trigger1 = time = 0
x = 0

[State hit]
type = NotHitBy
trigger1 = 1
value = SCA

[State 5120]
type = HitFallSet
trigger1 = animtime = 0
value = 1

[State Can't be thrown right after getting up]
type = NotHitBy
trigger1 = animtime = 0
value = ,NT,ST
time = 1
[State Can't be hit right after getting up (short time)]
type = NotHitBy
trigger1 = animtime = 0
value2 = SCA
time = 1

[State end]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; HIT_LIEDEAD
[Statedef 5150]
type = L
movetype = H
physics = N
sprpriority = -3

[State Normal anim]
type = null;ChangeAnim
triggerall = enemy,var(50) = 0
triggerall = time = 0
triggerall = selfanimexist(5140)
trigger1 =(anim!=[5111,5119])&&(anim!=[5171,5179])
trigger2 =!selfanimexist(5140+(anim%10))
value = 5140

[State Hit up type anim]
type = ChangeAnim
trigger1 = enemy,var(50) = 0
trigger1 = time = 0
;trigger1 =(anim=[5111,5119])||(anim=[5171,5179])
trigger1 = selfanimexist(5140+(anim%10))
value = 5140+(anim%10)

[State Match over anim]
type = ChangeAnim
trigger1 = enemy,var(50) >= 1
trigger1 = time = 0
;trigger1 = matchover = 1
trigger1 = anim = [5140,5149]
trigger1 = selfanimexist(anim+10)
value = anim+10
persistent = 0

[State Switch to 5110 if liedead anim does not exist]
type = null;ChangeAnim
trigger1 = time = 0
trigger1 = anim!= [5140,5159]
trigger1 = anim!= [5110,5119]
value = 5110

[State Friction]
type = velmul
trigger1 = 1
x = .85

[State Friction]
type = velset
trigger1 = vel x < .05
x = 0
persistent = 0

[State hit]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

