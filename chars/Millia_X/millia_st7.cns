;------------------------------------------------------------------
; Faultless Defense
[State var]
type = varset
triggerall = power > 0 && roundstate = 2
trigger1 = command = "holdback"
trigger1 =(command = "hold_x" && command = "hold_a")|| command = "hold_c"
