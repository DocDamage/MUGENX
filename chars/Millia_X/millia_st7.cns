;------------------------------------------------------------------
[State var]
type = varset
trigger1 = enemynear,movetype = A
trigger1 = stateno!= 910 && stateno!= 970
var(8) = 25
[State attack]
type = AttackMulSet
trigger1 = 1
value = (const(data.attack)+var(8))/100
[State snd]
type = PlaySnd
trigger1 = var(8)!= 0 && movetype = A && enemynear,movetype = H
trigger1 = movehit && hitdefattr = SCA,AA
value = 4090,0
ignorehitpause = 1
[State var]
type = varset
trigger1 = enemynear,movetype!= A
trigger2 = stateno = 910 || stateno = 970
var(8) = 0
ignorehitpause = 1

[State var]
