triggerall = var(9)>= 512
triggerall = alive = 1 && roundstate = 2
trigger1 = stateno = 5120 && animtime = -1
trigger2 =(stateno = 5001 || stateno = 5011)&& hitover
value = 5300
ctrl = 0
ignorehitpause = 1

