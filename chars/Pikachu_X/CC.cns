;---------------------------------------------------------------------------
; HITG_SHAKE


[Statedef 5000]
type    = S
movetype= H
physics = N
velset = 0,0

;**************
[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),5000,5010) + GetHitVar(animtype)

[State 5000, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030

[State 5000, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type

[State 5000, 3] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim
;**************

[State 5000, 1]
type = ChangeState
trigger1 = HitShakeOver = 1
trigger1 = HitVel Y = 0
trigger1 = Time != 0
value = 5001 ;HITG_SLIDE

[State 5000, 2]
type = ChangeState
trigger1 = HitShakeOver = 1
trigger1 = Time != 0
value = 5030

[State 5000, 3sude]
type = ForceFeedback
triggerall = NumHelper(1) = 1
trigger1 = anim = 5500
trigger2 = anim = 5510
persistent = 0
time = 6
waveform = square

[State 5000, 3]
type = ForceFeedback
triggerall = NumHelper(1) = 0
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square


[State 5000, 4]
type = ForceFeedback
triggerall = NumHelper(1) = 1
trigger1 = anim = 5501
trigger2 = anim = 5511
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5000, 4]
type = ForceFeedback
triggerall = NumHelper(1) = 0
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3



[State 5000, 5]
type = ForceFeedback
triggerall = NumHelper(1) = 1
trigger1 = anim = 5512
trigger2 = anim = 5502
trigger3 = anim = 5530
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

[State 5000, 5]
type = ForceFeedback
triggerall = NumHelper(1) = 0
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140


