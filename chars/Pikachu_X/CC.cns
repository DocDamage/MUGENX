; HITA_UP_T (transition)
[Statedef 5035]
type    = A
movetype= H
physics = N
anim = 5035

[State 5035, 1]
type = Changeanim
trigger1= NumHelper(1) = 1
value = 5535

[State 5035, 1]
type = VelAdd;Gravity
trigger1 = Time >= 0
y = .35

[State 5035, 2]
type = ChangeState
triggerall = NumHelper(1) = 1
triggerall = HitFall = 0
trigger1 = HitOver = 1  ;Hit is over
trigger2 = AnimTime = 0 ;Animation over
trigger3 = Vel Y > 0    ;Hit ground
trigger3 = Pos Y >= 10  ;.
trigger4 = Time = 0     ;No transition anim
trigger4 = Anim != 5535 ;.
value = 5040 ;HITA_RECOV

[State 5035, 2]
type = ChangeState
triggerall = NumHelper(1) = 0
triggerall = HitFall = 0
trigger1 = HitOver = 1  ;Hit is over
trigger2 = AnimTime = 0 ;Animation over
trigger3 = Vel Y > 0    ;Hit ground
trigger3 = Pos Y >= 10  ;.
trigger4 = Time = 0     ;No transition anim
trigger4 = Anim != 5035 ;.
value = 5040 ;HITA_RECOV

[State 5035, 3]
type = ChangeState
triggerall = NumHelper(1) = 1
triggerall = HitFall = 1
trigger1 = HitOver = 1  ;Hit is over
trigger2 = AnimTime = 0 ;Anim is over
trigger3 = Vel Y > 0    ;Hit ground
trigger3 = Pos Y >= 10  ;.
trigger4 = Time = 0     ;No transition anim
trigger4 = Anim != 5535 ;.
value = 5050 ;HITA_FALL

[State 5035, 3]
type = ChangeState
triggerall = NumHelper(1) = 0
triggerall = HitFall = 1
trigger1 = HitOver = 1  ;Hit is over
trigger2 = AnimTime = 0 ;Anim is over
trigger3 = Vel Y > 0    ;Hit ground
trigger3 = Pos Y >= 10  ;.
trigger4 = Time = 0     ;No transition anim
trigger4 = Anim != 5035 ;.
value = 5050 ;HITA_FALL

;---------------------------------------------------------------------------
; HITA_RECOV (recovering in air, not falling)
[Statedef 5040]
type    = A
movetype= H
physics = N

[State 5040, 1]
type = ChangeState
trigger1 = Alive = 0
value = 5050

[State 5040, 2]
type = ChangeAnim
triggerall = NumHelper(1) = 1
trigger1 = AnimTime = 0
trigger1 = Anim != 5540
trigger2 = Time = 0
trigger2 = Anim != 5535
value = 5540

[State 5040, 2]
type = ChangeAnim
triggerall = NumHelper(1) = 0
trigger1 = AnimTime = 0
trigger1 = Anim != 5040
trigger2 = Time = 0
trigger2 = Anim != 5035
value = 5040

[State 5040, 3]
type = CtrlSet
trigger1 = HitOver = 1
value = 1

[State 5040, 4]
type = StateTypeSet
trigger1 = HitOver = 1
movetype = I

[State 5040, 5]
type = VelAdd;Gravity
trigger1 = Time >= 0
y = .35

[State 5040, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52 ;JUMPLAND

;---------------------------------------------------------------------------
; HITA_FALL (knocked up, falling)
[Statedef 5050]
type    = A
movetype= H
physics = N

[State 5050, 1] ;Change anim when done with last
type = ChangeAnim
triggerall = NumHelper(1) = 1
triggerall = anim != 5560 ;Not if in hit up anim
trigger1 = AnimTime = 0
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5535
value = 5550

[State 5050, 1] ;Change anim when done with last
type = ChangeAnim
triggerall = NumHelper(1) = 0
triggerall = anim != 5060 ;Not if in hit up anim
trigger1 = AnimTime = 0
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035
value = 5050

[State 5050, 2] ;Coming down anim (normal fall type)
type = ChangeAnim
triggerall = NumHelper(1) = 1
triggerall = anim != 5560 ;Not if in hit up anim
trigger1 = Vel Y >= 1
trigger1 = animexist(5551)
value = 5551
persistent = 0

[State 5050, 2] ;Coming down anim (normal fall type)
type = ChangeAnim
triggerall = NumHelper(1) = 0
triggerall = anim != 5060 ;Not if in hit up anim
trigger1 = Vel Y >= 1
trigger1 = animexist(5051)
value = 5051
persistent = 0

[State 5050, 2] ;Coming down anim (hit up type)
type = ChangeAnim
triggerall = NumHelper(1) = 1
triggerall = anim = 5560 ;Not if in hit up anim
trigger1 = Vel Y >= -2
trigger1 = animexist(5561)
value = 5561
persistent = 0

[State 5050, 2] ;Coming down anim (hit up type)
type = ChangeAnim
triggerall = NumHelper(1) = 0
triggerall = anim = 5060 ;Not if in hit up anim
trigger1 = Vel Y >= -2
trigger1 = animexist(5061)
value = 5061
persistent = 0

[State 5050, 3]
type = VelAdd;Gravity
trigger1 = Time >= 0
y = .35

[State 5050, 4] ; Recover near ground
type = ChangeState
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive = 1
triggerall = CanRecover = 1
trigger1 = Command = "recovery"
value = 5200 ;HITFALL_RECOVER

[State 5050, 5] ; Recover in mid air
type = ChangeState
triggerall = Vel Y > -1
triggerall = Vel Y < 40 ;4
triggerall = alive = 1
triggerall = CanRecover = 1
trigger1 = Command = "recovery"
value = 5210 ;HITFALL_AIRRECOVER

[State 5050, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 25
value = 5100 ;HIT_BOUNCE

[State 5050, 6] ;If in hit up animation
type = ChangeState
triggerall = NumHelper(1) = 1
triggerall = Vel Y > 0
triggerall = Pos Y >= 0
trigger1 = anim = 5560
trigger2 = anim = 5561
value = 5100 ;HIT_BOUNCE

[State 5050, 6] ;If in hit up animation
type = ChangeState
triggerall = NumHelper(1) = 0
triggerall = Vel Y > 0
triggerall = Pos Y >= 0
trigger1 = anim = 5060
trigger2 = anim = 5061
value = 5100 ;HIT_BOUNCE

