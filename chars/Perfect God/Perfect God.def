[Info]
name = "Perfect God"
displayname = "Perfect God"
versiondate = 07,23,2009
mugenversion =
author = "kronos"
pal.defaults = 4,1,5,2,3,6

; Files for the player
[Files]
cmd      = ssjgss.cmd	        ;Other config
cns      = ssjgss.cns	        ;Constants
st       = ssjgss.cns	        ;States
st1      = attack.cns
st2      = enemy.cns
st3      = null.cns
st4      = othk.cns
st5      = isolation.cns
st6      = -2.cns
stcommon = ssjgss.cns		;Common states
sprite   = goku.sff	;Sprite
anim     = goku.air	;Animation
sound    = ssjgss.snd	;Sound
	
pal1 = 1.act

; Arcade mode
[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def