; Definition file for Zuku
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Hanzo_X"        ;Name of character
displayname = "Hanzo_X" ;Name of character to display
versiondate = 04,01,2006    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "Tommy-gun"         ;Character author name
pal.defaults = 3,8,9,10,2,5,7,6,11,1,4,12      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = z.cmd   ;Command set
cns     = z.cns   ;Constants
st      = z.cns   ;States
stcommon = common1.cns ;Common states
sprite  = z.sff   ;Sprite
anim    = z.air   ;Animation
sound   = z.snd   ;Sound
pal1    = 1.act
pal2    = 2.act
pal3    = 3.act
pal4    = 4.act
pal5    = 5.act
pal6    = 6.act
pal7    = 7.act
pal8    = 8.act
pal9    = 9.act
pal10   = 10.act
pal11   = 11.act
pal12   = 12.act

; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
