; ここにキャラ情報を書いてください
[Info]
name = "Marco"        ;キャラの名前
displayname = "Marco" ;表示されるキャラの名前
versiondate = 11,22,2000    ;キャラの更新情報
mugenversion = 11,22,2000   ;キャラが動くmugenのバージョン
author = "ahuron"         ;キャラの製作者名
pal.defaults = 1      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = Marco_nbc.cmd   ;キャラのコマンド
cns     = Marco_nbc.cns   ;キャラのプログラム
st      = Marco_nbc.cns   ;基本動作、必殺技、特殊ゲージ、-2、-3
st2     = Marco_nbc2.cns  ;超必殺技
st3     = Marco_nbc3.cns  ;通常動作
stcommon = common1.cns 
sprite  = Marco_nbc.sff   ;キャラの絵
anim    = Marco_nbc.air   ;キャラの動き
sound   = Marco_nbc.snd   ;キャラの音
pal1    = Marco_nbc2.act
pal2    = Marco_nbc2.act
pal3    = Marco_nbc2.act
pal4    = Marco_nbc.act
pal5    = Marco_nbc.act
pal6    = Marco_nbc.act