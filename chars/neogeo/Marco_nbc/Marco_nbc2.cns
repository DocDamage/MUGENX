; メタスラ・アタック　メタスラ・バックアタック
[Statedef 2000]
type    = A
movetype= A
physics = N
velset = 0,0
juggle = 0
poweradd= -1000
anim = 2000
ctrl = 0

;---------------------[コマンド判定]
[state a]
type = varset
trigger1 = time = 0
trigger1 = command = "a"
v = 5
value = 0

[state a]
type = varset
trigger1 = time = 0
trigger1 = command = "b"
v = 5
value = 1

[state a]
type = poweradd
trigger1 = time = 0
trigger1 = var(5) = 1
value = -1000


[state a];キャノンコマンド
type = varset
trigger1 = time = 0
v = 7
value = 0

[state a];キャノンコマンド
type = varset
trigger1 = command = "メタスラ・キャノン"
trigger1 = numhelper(2000) != 0
v = 7
value = 1



;---------------------[超必殺技演出]
[State 1];無敵の状態を作る
type = null;NotHitBy 
trigger1 = time <= 28
value = SCA

[State 00]
type = SuperPause
