; ここにキャラ情報を書いてください
[Info]
name = "Lee"        ;キャラの名前
displayname = "Lee" ;表示されるキャラの名前
versiondate = 11,22,2000    ;キャラの更新情報
mugenversion = 11,22,2000   ;キャラが動くmugenのバージョン
author = "ahuron"         ;キャラの製作者名
pal.defaults = 1      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = Lee_nbc.cmd   ;キャラのコマンド
cns     = Lee_nbc.cns   ;キャラのプログラム
st      = Lee_nbc.cns   ;基本動作、必殺技、特殊ゲージ、-2、-3
st2     = Lee_nbc2.cns  ;超必殺技
stcommon = common1.cns 
sprite  = Lee_nbc.sff   ;キャラの絵
anim    = Lee_nbc.air   ;キャラの動き
sound   = Lee_nbc.snd   ;キャラの音
pal1    = Lee_nbc2.act
pal2    = Lee_nbc2.act
pal3    = Lee_nbc2.act
pal4    = Lee_nbc.act
pal5    = Lee_nbc.act
pal6    = Lee_nbc.act

pal7    = Lee_nbc2.act
pal8    = Lee_nbc2.act
pal9    = Lee_nbc2.act
pal10   = Lee_nbc.act
pal11   = Lee_nbc.act
pal12   = Lee_nbc.act