;変数使用表
;　1 = キャラクターの判別
;　2 = 勝利ポーズ変更
;　3 = 
;　4 = スロー処理
;　5 = 強弱ボタン判定
;　6 = 通常攻撃ボイス、乱数指定
;　7 = 斬り回数カウント
;　8 = 
;　9 = 
; 10 = プレイヤーの向き設定
; 11 = 
; 12 = KOサウンド
; 13 = 
; 14 = 
; 15 = ハイジャンプ
; 16 = 小ジャンプ
; 17 = ダメージ補正に使用
; 18 = 攻撃値の保存
; 19 = 
; 20 = 
; 21 = 
; 22 = 
; 23 = 
; 24 = 
; 25 = 
; 26 = 
;
; 30 = AI判定(にしたいな…)

; f(1) = 攻撃補正
; f(2) = 



[Data]
  ;体力ゲージの初期値
life = 1000
  ;攻撃力（これ以上に設定すると強くなる）
attack = 100
  ;防御力（これ以上に設定すると強くなる）
defence = 100
  ;コンボをくらっている時にあがる防御力
fall.defence_up = 50
  ;倒れてから起上がるまでのフレーム数
liedown.time = 11
  ;空中でどれだけコンボが繋がるか（高くすると無限コンボになるので注意）
airjuggle = 15
  ;hitdefで設定していない時の基本ヒットスパークナンバー
sparkno = 2
  ;設定してない時のガードナンバー
guard.sparkno = 40
  ;KOした時に声にエコーをかけるか（１でＯＮ）
KO.echo = 0
 volume = 5
  IntPersistIndex = 0
FloatPersistIndex = 40

[Size]
xscale = 1           ;水平方向の縮尺（通常１）
yscale = 1           ;垂直方向の縮尺（通常１）
ground.back = 15     ;キャラの幅(後方,地上)
ground.front = 16    ;キャラの幅(前方,地上)
air.back = 12        ;キャラの幅(後方,空中)
air.front = 12       ;キャラの幅(前方,空中)
height = 97          ;キャラの高さ
attack.dist = 320    ;攻撃をした時相手がガード体制に入る最低距離
proj.attack.dist = 320;攻撃をした時相手がガード体制に入る最低距離（飛び道具）
proj.doscale = 0     ;上で設定した縮尺を飛び道具にも適用するか（１でＯＮ）   
head.pos = -9, -87   ;頭の大体の座標
mid.pos = -11, -60    ;体の中心の大体の座標
shadowoffset = 0     ;影の垂直方向のオフセット
draw.offset = 0,0    ;使用しない

[Velocity]
walk.fwd  = 2.9      ;前進の速度
walk.back = -2.9     ;後退の速度
run.fwd  = 6.1130434, 0    ;前ダッシュの速度（ホップする時はyを-にする）
run.back = -6.2,-2.1 ;後ダッシュの速度（ホップする時はyを-にする）
jump.neu = 0,-11.4    ;垂直ジャンプの速度
jump.back = -4.05,2    ;後ジャンプの速度
jump.fwd = 4.0,2       ;前ジャンプの速度
runjump.back = -2.55,-8.1 ;後ダッシュしながらのジャンプ速度(オプション)
runjump.fwd = 4,-8.1      ;前ダッシュしながらのジャンプ速度(オプション)
airjump.neu = 0,-8.1      ;２段ジャンプ以降の垂直ジャンプの速度(オプション)
airjump.back = -2.55      ;２段ジャンプ以降の後ジャンプの速度(オプション)
airjump.fwd = 2.5         ;２段ジャンプ以降の前ジャンプの速度

[Movement]
airjump.num = 0      ;空中でジャンプする回数
airjump.height = 35  ;空中でジャンプする最低限の高さ
yaccel = .60         ;重力
stand.friction = .85  ;立ち状態の摩擦係数
crouch.friction = .82 ;屈み状態の摩擦係数

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 + var(1) && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0 + var(1)

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; フロントステップ
[Statedef 100]
type    = S
physics = N
anim = 100
sprpriority = 1

;---------------------[銃のエフェクト]
[State removeexplod];前のステートの銃消去
type = removeexplod
trigger1 = time = 0
ID = 3000

;---------------------[]


[State 00]
type = poweradd
triggerall = time = 0
trigger1 = prevstateno = 150
trigger2 = prevstateno = 151
value = -500

[State 01];点滅
type = palfx
triggerall = time = 0
trigger1 = prevstateno = 150
trigger2 = prevstateno = 151
time = 3
add = 255,255,255
mul = 255,255,255
color = 1
ignorehitpause = 1

[State 00]
type = null;ctrlset
triggerall = time = 0
trigger1 = prevstateno = 150
trigger2 = prevstateno = 151
value = 1

[State 02]
type = PlaySnd
trigger1 = Time= 0
value = 100, 1

[State 03]
type = VelSet
trigger1 = animelem = 2;1
x = 8;const(velocity.run.fwd.x)

[State 04]
type = VelSet
trigger1 = animelem = 4
x = 0

[State 05] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 06] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 07]
type = ChangeState
trigger1 = command = "holdfwd"
trigger1 = animelem = 4,>=0
value = 101

[State 08]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1
;---------------------------------------------------------------------------
; commonより ダッシュ
[Statedef 101]
type    = S
physics = S
anim = 101
sprpriority = 1
ctrl = 1

[State 00]
type = PlaySnd
trigger1 = Time= 0
value = 100, 0
loop = 1
channel = 1

[State 01]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 02] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 03] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 04]
type = ChangeState
trigger1 = command != "holdfwd"
value = 0


;---------------------------------------------------------------------------
; commonより バックステップ
[Statedef 105]
type    = S
physics = S
ctrl = 0
anim = 104
velset = 0,0

[State 00]
type = ChangeState
trigger1 = animtime = 0
value = 106

; 空中
[Statedef 106]
type    = A
physics = A
ctrl = 1
anim = 105
sprpriority = 1

[State 00]
type = VelSet
trigger1 = Time = 0
x = -5.5
y = -3.8

[State 01]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 107



; 着地
[Statedef 107]
type    = S
physics = N
ctrl = 0
anim = 106
velset = 0,0

[State 00]
type = VelSet
trigger1 = Time = 0
x = 0
y = 0

[State 01]
type = PosSet
trigger1 = Time = 0
y = 0

[State 02]
type = MakeDust
trigger1 = Time = 2
pos = -5,-2
spacing = 1

[State 03]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; タイムオーバーで負けた時
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 00]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; 勝った動作
[Statedef 180]
type = S

[State 00]
type = VarRandom
trigger1 = Time = 0
v = 2
range = 0,1

[State 01]
type = ChangeState
trigger1 = var(2) = 0
value = 181

[State 01]
type = ChangeState
trigger1 = var(2) = 1
value = 181

;---------------------------------------------------------------------------
; 勝った動作[ひょーう]
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0


[State 00];ひょーう
type = PlaySnd
trigger1 = animelem = 3
value = 181,0


[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 181, 4]
type = AssertSpecial
trigger1 = time = [0,170]
flag = roundnotover

;---------------------------------------------------------------------------
; 勝った動作[]
[Statedef 182]
type = S
ctrl = 0
anim = 182
velset = 0,0

[State 00];
type = PlaySnd
trigger1 = animelem = 3
value = 182,0

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 181, 4]
type = AssertSpecial
trigger1 = time = [0,170]
flag = roundnotover


;---------------------------------------------------------------------------
; 通常登場
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State a]
type = PlaySnd
trigger1 = Time= 1
value = 160, 0
channel = 2;(1:ダッシュ音)


[State a];一撃必殺じゃて
type = PlaySnd
trigger1 = animelem = 3
value = 190,0


[State a] 
type = AssertSpecial
trigger1 = 1
flag = Intro

[State a] 
type = ChangeState
trigger1 = AnimTime = 0
value = 0


;---------------------------------------------------------------------------
; 挑発の動作
[Statedef 195]
type = S
ctrl = 0
anim = 195
velset = 0,0
movetype = I
physics = S
sprpriority = 1

[State 00]
type = VarRandom
trigger1 = Time = 0
v = 2
range = 0,1

[State 191, 3];本気で来ぬか
type = PlaySnd
trigger1 = animelem = 2
trigger1 = var(2) = 0
value = 195,0

[State 191, 3];ひょーひょひょひょひょひょ
