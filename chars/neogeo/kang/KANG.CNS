type = PlaySnd
trigger1 = anim = 40 && animtime = 0
value = S7,1
channel = 2
persistent = 0

[State 40, turn]
type = turn
trigger1 = time = 0 && P2dist X < 0

[State 40, Varset]
type = VarSet
trigger1 = Time = 0
var(1) = 0

[State 40, Varset]
type = VarSet
trigger1 = command = "holdfwd"
trigger1 = var(1) != 2
var(1) = 1

[State 40, Varset]
type = VarSet
trigger1 = command = "holdback"
trigger1 = var(1) != -2
var(1) = -1

[State 40, Varset]
type = VarSet
triggerall = Time = 0
triggerall = command = "holdfwd"
trigger1 = command = "longjump"
trigger2 = prevstateno = 100 ;RUN_FWD
var(1) = 2

[State 40, Varset]
type = VarSet
trigger1 = Time = 0
trigger1 = command = "holdback"
trigger1 = command = "longjump"
var(1) = -2

[State 40, Varset]
type = VarSet
trigger1 = Time = 0
trigger1 = command != "holdback"
trigger1 = command != "holdfwd"
trigger1 = command = "longjump"
var(1) = 3

