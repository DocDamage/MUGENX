[Data]
life = 1000			;体力（バランスを考え極力弄らない）
attack = 150			;攻撃力（％）
defence = 100			;防御力（％）
fall.defence_up = 50		;?れこむ毎に増加する防御力 ※commonの仕様でtripでも増加します
liedown.time = 60		;起き上がるまでの時間
airjuggle = 15		;juggleの設定（fall時の相手に追い討ちする際に使用）
sparkno = 2			;基?的な攻撃hit??ク（hitdefでsparkno省略時の数値）
guard.sparkno = 40		;基?的なガ?ドhit??ク(hitdefでguard.sparkno省略時の数値）
KO.echo = 0			;?亡時の声のエコ?
volume = 0			;playsndのvolume省略時の数値
IntPersistIndex = 59		;次のラウンドに持ち越すvarの先頭
FloatPersistIndex = 40	;次のラウンドに持ち越すfvarの先頭

;------------------------------------------------
[Size]
xscale = 1			;元の画像と?示される画像の大きさの比率（横方向）
yscale = 1			;元の画像と?示される画像の大きさの比率（縦方向）
ground.back = 19		;地上時のキャラの中心より後ろ方向の幅（押し返し幅）
ground.front = 18		;地上時のキャラの中心より前方向の幅（押し返し幅）
air.back = 19			;空中時のキャラの中心より後ろ方向の幅（押し返し幅）
air.front = 18		;空中時のキャラの中心より前方向の幅（押し返し幅）
height = 60      		;相手が自分を飛び越せない高さ
attack.dist = 160   		;相手がガ?ドモ?ションに入る距離（hitdef省略時の数値）
proj.attack.dist = 90 	;相手がガ?ドモ?ションに入る距離?pujectの初期幅（hitdef省略時の数値）
proj.doscale = 0		;projectをキャラのスケ?ルに依存するか否かの設定
head.pos = -5, -90   	;頭の位置?※この数値をみて投げてくるキャラもいるのでしっかり設定すること
mid.pos = -5, -60    	;体の中心位置?※この数値をみて投げてくるキャラもいるのでしっかり設定すること
shadowoffset = 0     	;影の?き込み位置をずらす設定（y方向のみ）
draw.offset = 0,0    	;キャラを?き込む位置をずらす設定（x,y方向）?※当たり判定、その他全てずれます

;------------------------------------------------
[Velocity]
walk.fwd  = 2.8      	;前進する速度
walk.back = -2.6     	;後退する速度
run.fwd  = 5.6, 0    	;前?ッシュの速度（x, y)
run.back = -3.5,0 	;後ろ?ッシュの速度 (x, y) ※commonのままだとバックステップとなります
jump.neu = 0,-8.4    	;垂直ジャンプの速度(x, y)
jump.back = -2.4    	;後ろジャンプの速度(x, y)
jump.fwd = 2.6       	;前ジャンプの速度(x, y)
runjump.back = -2.55,-8.1 	;?ッシュ後ろジャンプの速度 (省略可?)
runjump.fwd = 4,-8.1      	;?ッシュ前ジャンプの速度 (省略可?)
airjump.neu = 0,-8.1      	;垂直２段ジャンプの速度 (省略可?)
airjump.back = -2.55      	;後ろ２段ジャンプの速度 (省略可?)
airjump.fwd = 2.5         	;前２段ジャンプの速度 (省略可?)

;------------------------------------------------
;基?設定 [Movement]部分
;ここでキャラに関する重力や２段ジャンプの基?的な設定を行います
;バランス、その他を良く考えた上で設定しましょう
[Movement]
airjump.num = 0      	;２段ジャンプ可?な回数 (省略可?)
airjump.height = 35  	;２段ジャンプ可?な地面からの高さ (省略可?)
yaccel = .44         	;空中状態にかかる重力
stand.friction = .85  	;立ち状態にかかる?擦
crouch.friction = .82 	;しゃがみ状態にかかる?擦
;.44や.85というのは0.44、0.85の略した書き方で
;MUGEN内全てのパラメ??に使用可?です
;重力や?擦は毎フレ??ごとに減少、もしくは増加していく値です

;※powerに関しては個人的に弄って?しくない（???バトルで不都合が起きまくる）ので
;?省略させて頂きました