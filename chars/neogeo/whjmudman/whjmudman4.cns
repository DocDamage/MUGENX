;===========================================================================
; 投げ
;===========================================================================
; だきつきパンチ
;---------------------------------------------------------------------------
[Statedef 1000]
type = S
movetype= A
physics = S
juggle = 0
velset = 0,0
ctrl = 0
anim = 1000
sprpriority = 2
ctrl = 0
poweradd = 60


[State 1000, 1]
type = HitDef
Trigger1 = Time = 0
attr = S, NT ;ｓ：立ち　ｎ：通常　ｔ：投げ
hitflag = M- ;コンボの途中から投げが入らないよう設定してある
『M-』の『-』を消せば、相手が攻撃食らっている状態(GetHit)の場合でも投げに
移行できます。
『-』の代わりに『+』を入れればGetHit状態のみ受けつけるようになります。
priority = 1, Miss ;１は優先順位が低いので技がでないかミスするという設定
sparkno = -1 ;-1をつければスパークエフェクトは無い
sprpriority = 1 ;２Ｐより上に１Pが表示される
p2facing = 1 ;？
p1stateno = 1001 ;投げが成功した場合の移動する１Ｐのステート
p2stateno = 1010 ;投げが成功した場合の移動する２Ｐのステート
fall = 1 ;落ちる力を２Ｐにかけるか

[State 1000, 2]
type = ChangeState
Trigger1 = AnimTime = 0
value = 0
ctrl = 1
;---------------------------------------------------------------------------
