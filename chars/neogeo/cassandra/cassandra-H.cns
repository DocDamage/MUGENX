trigger1 = movehit && !NumExplod(2300)
anim = 2300
id=2300
pos = 0,0
postype = p2
sprpriority = 7
bindtime = -1
ownpal = 1
ignorehitpause = 1

[State 3005, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

