;=====================================================================
; Definition of the Super Arts
;=====================================================================

;---------------------------------------------------------------------
; ホワイトウェーブ（空中）
;------------------------ 超必殺版・空中
[Statedef 3000]
type = A
movetype = A
physics = N
anim = 3000
velset = 0, 0
ctrl = 0
juggle = 5

[State 3000, varset(18)]
type = varset
trigger1 = Time = 0
var(18) = 0
ignorehitpause = 1

[State 3000, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 3000, EnvColor]
type = EnvColor
trigger1 = Time = [1,30]
value = 0, 0, 0
time = 1
under = 1

[State 3000, AssertSpecial]
type = AssertSpecial
trigger1 = Time = [1,30]
flag = NoFG

[State 3000, Explod]
type = Explod
trigger1 = Time = 1
anim = 2205
ID = 2205
pos = 10,-50
postype = P1
sprpriority = 4
ownpal = 1
bindtime = -1
pausemovetime = 40

[State 3000, Explod]
type = Explod
trigger1 = Time = 1
anim = 2200
ID = 2200
pos = 10,-50
postype = P1
sprpriority = -2
ownpal = 1
bindtime = -1
pausemovetime = 40

[State 3000, PlaySnd]
type = PlaySnd
trigger1 = Time = 1
value = 1, 5

[State 3000, poweradd]
type = poweradd
trigger1 = Time = 1
value = -1000

[State 3000, VelSet]
type = VelSet
trigger1 = Time = 32
x = 4
y = 10

[State 3000, AfterImage]
type = AfterImage
trigger1 = Time = 7
time = 999999
length = 15
palbright = 40,40,40
palcontrast = 250,250,250
palpostbright = -80,-80,-80
timegap = 1
flamegap = 1
trans = add1

[State 3005, HitDef]
type = HitDef
trigger1 = Time = 0
attr = A, HA
animtype = Hard
damage    = 29
getpower = 0,0
guardflag = HA
hitflag = MAF
pausetime = 28,28
sparkno = S2020
guard.sparkno = S2060
sparkxy = 0,-30
hitsound =  S3, 2
guardsound = S4, 0
ground.type = Low
ground.slidetime = 16
ground.hittime  = 20
ground.velocity = 0
air.velocity = -2.3,-9
yaccel = .47
air.fall = 1
fall.recover = 0

[State 3000, Pause]
type = Pause
trigger1 = Time = 1
time = 30
movetime = 30

[State 3110,MoveHitReset]
type = MoveHitReset
trigger1 = MoveHit

[State 3005, Envcolor]
type = Envcolor
trigger1 = movehit && HitPauseTime > 24
value = 255, 255, 255
ignorehitpause = 1
time = 1
under = 1

[State 3000, AfterImageTime]
type = AfterImageTime
trigger1 = Time > 32 && Pos Y >= 0 && Vel Y > 0
time = 0

[State 3000, End]
type = ChangeState
trigger1 = Time > 32 && Pos Y >= 0 && Vel Y > 0
value = 3005
ctrl = 0

