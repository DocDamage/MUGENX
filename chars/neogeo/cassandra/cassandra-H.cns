palfx.sinadd = 10,50,50,30
palfx.color = 0
palfx.invertall = 1

[State 3110,MoveHitReset]
type = MoveHitReset
trigger1 = MoveHit

[State 3005, Envcolor]
type = Envcolor
trigger1 = movehit && HitPauseTime > 21
value = 255, 255, 255
ignorehitpause = 1
time = 1
under = 1

[State 3005, Explod]
