guardsound = S4, 0
ground.type = Low
ground.slidetime = 16
ground.hittime  = 20
ground.velocity = -2.3,-9
guard.velocity = -12
air.velocity = -2.3,-9
yaccel = .47
fall = 1
fall.recover = 0
Palfx.time = 65
