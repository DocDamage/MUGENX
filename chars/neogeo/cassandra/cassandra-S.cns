[Statedef 1050]
type = S
movetype = I
physics = S
velset = 0,0
ctrl = 0
anim = 1050
sprpriority = 3

[State 1010, PlaySnd]
type = PlaySnd
trigger1 = Time % 10=0
value = 1,10

[State 1150, BindToParent]
type = BindToParent
trigger1 = 1
pos = 0,0
facing = 1

[State 6010, 1]
type = AssertSpecial
trigger1 = gameTime % 2
flag = invisible

[State 1150,ChangeAnim]
type = ChangeAnim
trigger1 = Parent,HitPauseTime != 0
value = anim
elem = AnimElemNo(0)

[State 1150, ChangeState]
type = DestroySelf
trigger1 = parent,StateNo != 1000 && parent,StateNo != 1010 && parent,StateNo != 1005

[State 1005, End]
type = ChangeState
trigger1 = parent,Stateno = 1005
value = 1051

