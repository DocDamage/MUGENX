; ここにキャラ情報を書いてください
[Info]
name = "Goodman"        ;キャラの名前
displayname = "Goodman" ;表示されるキャラの名前
versiondate = 11,22,2000    ;キャラの更新情報
mugenversion = 11,22,2000   ;キャラが動くmugenのバージョン
author = "ahuron"         ;キャラの製作者名
pal.defaults = 1      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = Goodman_nbc.cmd   ;キャラのコマンド
cns     = Goodman_nbc.cns   ;キャラのプログラム
st      = Goodman_nbc.cns   ;基本動作、必殺技、特殊ゲージ、-2、-3
st2     = Goodman_nbc2.cns  ;超必殺技
st3     = Goodman_nbc3.cns  ;ヘルパー制御
stcommon = Goodman_common1.cns 
sprite  = Goodman_nbc.sff   ;キャラの絵
anim    = Goodman_nbc.air   ;キャラの動き
sound   = Goodman_nbc.snd   ;キャラの音
pal1    = Goodman_nbc.act
