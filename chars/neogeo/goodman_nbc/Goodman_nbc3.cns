;猿王キターカ(待機)
[Statedef 3000]
type    = S
movetype= I
physics = N
velset = 0,0
juggle = 8
poweradd= 0
sprpriority = -5
anim = 3000
ctrl = 0

;---------------------[透過]
[state a]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256, 100

;---------------------[]
[State a];影の消去
type = AssertSpecial
trigger1 = 1
flag = noshadow

;---------------------[超必殺技演出]
[State 1];無敵の状態を作る
type = NotHitBy 
trigger1 = 1
value = SCA

;---------------------[速度指定]

[state a]
type = velset
trigger1 = ParentDist X > 7
x = 3

[state a]
type = velset
trigger1 = ParentDist X < -7
x = -3

[state a]
type = velset
trigger1 = ParentDist X <= 7
trigger1 = ParentDist X >= -7
x = 0

;---------------------[振り向き]
[state a]
type = turn
trigger1 = ParentDist X < 0
trigger1 = p2Dist X < 0
trigger2 = ParentDist X >= 0
trigger2 = p2Dist X < 0


;---------------------[ステートの移行]
[state a];放物線攻撃
type = changestate
trigger1 = root,var(20) = 1
value = 3011

[State 2900, 1];落下攻撃
type = helper
trigger1 = root,var(21) = 1
id = 3000
persistent = 0
name = "ennou"
pos = 0,0
postype = P1
stateno = 3020
helpertype = normal
keyctrl = 0
ownpal = 1

[State 1000, 5];落下攻撃
type = null;Explod
trigger1 = root,var(21) = 1
anim = 3020
sprpriority = -2
postype = p1
pos = 0,0
bindtime = 1
supermove = 1
ignorehitpause = 0
under = 0

[state a];落下攻撃
type = destroyself
trigger1 = root,var(21) = 1

[state a];火柱攻撃
type = changestate
trigger1 = root,var(22) = 1
value = 3030

