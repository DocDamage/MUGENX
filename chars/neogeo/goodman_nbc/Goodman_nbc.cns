;変数使用表
;　1 = 
;　2 = 勝利ポーズ変更
;　3 = 
;　4 = スロー処理
;　5 = 強弱ボタン判定
;　6 = 通常攻撃ボイス、乱数指定
;　7 = パワーアップ
;　8 = 
;　9 = 
; 10 = プレイヤーの向き設定
; 11 = 
; 12 = KOサウンド
; 13 = 
; 14 = 
; 15 = ハイジャンプ
; 16 = 小ジャンプ
; 17 = ダメージ補正に使用
; 18 = 攻撃値の保存
; 19 = 
; 20 = 放物線攻撃フラグ
; 21 = 落下攻撃フラグ
; 22 = 火柱攻撃フラグ
; 23 = 
; 24 = 
; 25 = 
; 26 = 
;
; 30 = AI判定(にしたいな…)

; f(1) = 攻撃補正
; f(2) = 



[Data]
  ;体力ゲージの初期値
life = 2000
  ;攻撃力（これ以上に設定すると強くなる）
attack = 100
  ;防御力（これ以上に設定すると強くなる）
defence = 100
  ;コンボをくらっている時にあがる防御力
fall.defence_up = 50
  ;倒れてから起上がるまでのフレーム数
liedown.time = 11
  ;空中でどれだけコンボが繋がるか（高くすると無限コンボになるので注意）
airjuggle = 15
  ;hitdefで設定していない時の基本ヒットスパークナンバー
sparkno = 2
  ;設定してない時のガードナンバー
guard.sparkno = 40
  ;KOした時に声にエコーをかけるか（１でＯＮ）
KO.echo = 0
 volume = 5
  IntPersistIndex = 0
FloatPersistIndex = 40

[Size]
xscale = 1           ;水平方向の縮尺（通常１）
yscale = 1           ;垂直方向の縮尺（通常１）
ground.back = 15     ;キャラの幅(後方,地上)
ground.front = 16    ;キャラの幅(前方,地上)
air.back = 12        ;キャラの幅(後方,空中)
air.front = 12       ;キャラの幅(前方,空中)
height = 97          ;キャラの高さ
attack.dist = 320    ;攻撃をした時相手がガード体制に入る最低距離
proj.attack.dist = 320;攻撃をした時相手がガード体制に入る最低距離（飛び道具）
proj.doscale = 0     ;上で設定した縮尺を飛び道具にも適用するか（１でＯＮ）   
head.pos = 4, -110   ;頭の大体の座標
mid.pos = 10, -80    ;体の中心の大体の座標
shadowoffset = 0     ;影の垂直方向のオフセット
draw.offset = 0,0    ;使用しない

[Velocity]
walk.fwd  = 2.9      ;前進の速度
walk.back = -2.9     ;後退の速度
run.fwd  = 4.4, 0    ;前ダッシュの速度（ホップする時はyを-にする）
run.back = -4.2,-2.1 ;後ダッシュの速度（ホップする時はyを-にする）
jump.neu = 0,-11.4    ;垂直ジャンプの速度
jump.back = -4.05,2    ;後ジャンプの速度
jump.fwd = 4.0,2       ;前ジャンプの速度
runjump.back = -2.55,-8.1 ;後ダッシュしながらのジャンプ速度(オプション)
runjump.fwd = 4,-8.1      ;前ダッシュしながらのジャンプ速度(オプション)
airjump.neu = 0,-8.1      ;２段ジャンプ以降の垂直ジャンプの速度(オプション)
airjump.back = -2.55      ;２段ジャンプ以降の後ジャンプの速度(オプション)
airjump.fwd = 2.5         ;２段ジャンプ以降の前ジャンプの速度

[Movement]
airjump.num = 0      ;空中でジャンプする回数
airjump.height = 35  ;空中でジャンプする最低限の高さ
yaccel = .60         ;重力
stand.friction = .85  ;立ち状態の摩擦係数
crouch.friction = .82 ;屈み状態の摩擦係数

;---------------------------------------------------------------------------
; フロントステップ
[Statedef 100]
type    = S
physics = N
anim = 100
sprpriority = 1

;---------------------[銃のエフェクト]
[State removeexplod];前のステートの銃消去
type = removeexplod
trigger1 = time = 0
ID = 3000

;---------------------[]


[State 00]
type = poweradd
triggerall = time = 0
trigger1 = prevstateno = 150
trigger2 = prevstateno = 151
value = -500

[State 01];点滅
type = palfx
triggerall = time = 0
trigger1 = prevstateno = 150
trigger2 = prevstateno = 151
time = 3
add = 255,255,255
mul = 255,255,255
color = 1
ignorehitpause = 1

[State 00]
type = null;ctrlset
triggerall = time = 0
trigger1 = prevstateno = 150
trigger2 = prevstateno = 151
value = 1

[State 02]
type = PlaySnd
trigger1 = Time= 0
value = 100, 1

[State 03]
type = VelSet
trigger1 = animelem = 2;1
x = 6;const(velocity.run.fwd.x)

[State 04]
type = VelSet
trigger1 = animelem = 6
x = 0

[State 05] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 06] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 07]
type = ChangeState
trigger1 = command = "holdfwd"
trigger1 = animelem = 4,>=0
value = 101

[State 08]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1
;---------------------------------------------------------------------------
; commonより ダッシュ
[Statedef 101]
type    = S
physics = S
anim = 101
sprpriority = 1
ctrl = 1

[State 00]
type = null;PlaySnd
trigger1 = Time= 0
value = 100, 0
loop = 1
channel = 1

[State 01]
type = VelSet
trigger1 = 1
x = 6;const(velocity.run.fwd.x)

[State 02] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 03] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 04]
type = ChangeState
trigger1 = command != "holdfwd"
value = 0


