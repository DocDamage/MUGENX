Triggerall = p2stateno != [150,153]
Trigger1 = enemynear,movetype != H
Trigger1 = P2BodyDist X < 15
Trigger1 = statetype != A && ctrl

[State -1]
type = ChangeState
value = 840
Triggerall = p2life > 0
Triggerall = var(59) = 1
Triggerall = random <= 15
Triggerall = P2statetype != A
Triggerall = p2stateno != [150,153]
Trigger1 = enemynear,movetype != H
Trigger1 = P2BodyDist X < 80
Trigger1 = statetype != A && ctrl

[State -1]
type = ChangeState
value = 100
Triggerall = p2life > 0
Triggerall = var(59) = 1
Triggerall = random <= 50
Trigger1 = enemynear,movetype != A
Trigger1 = P2BodyDist X > 70
Trigger1 = statetype != A && ctrl

[State dist]
Trigger1 = 1
type = DisplayToClipboard
ignorehitpause = 1
text = "enemy dist X= %f"
params = p2bodydist x
ignorehitpause = 1

[State screen]
type = ScreenBound
Triggerall = enemy,movetype = H
Trigger1 = enemy,stateno = [1011,1013]
Trigger2 = enemy,stateno = [1031,1033]
movecamera = 0,0

[State 1]
type = velset
Triggerall = backedgedist <= 30
Triggerall = anim = 21 || anim = 105
Trigger1 = enemy,stateno = [1031,1033]
x = 0





