[Statedef 11]
type = C
physics = C
ctrl = 1
anim = 11
sprpriority = 0

[State 0, 1]
type = ChangeAnim
Triggerall = P2BodyDist X <= 140
Trigger1 = Anim != 6
Trigger1 = p2statetype = A
Trigger2 = Anim = 6 && AnimTime = 0
value = 7

[State 0, 1]
type = ChangeAnim
Trigger1 = Anim != 6
Trigger1 = p2statetype != A
Trigger2 = Anim = 6 && AnimTime = 0
value = 11


[Statedef 20]
type    = S
physics = S
anim = 20
ctrl = 1

[State 20, 1]
type = VelSet
Trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
Trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
Triggerall = vel x > 0
Trigger1 = Anim != 20
value = 20

[State 1]
type = velset
Triggerall = backedgedist <= 8
Trigger1 = enemy,stateno = [1031,1033]
x = 0

[State 20, 4]
type = ChangeAnim
Triggerall = vel x < 0
Trigger1 = Anim != 21
value = 21

