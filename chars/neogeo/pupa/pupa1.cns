trigger1 = AnimTime = 0
trigger1 = Var(2) = 1
trigger1 = Var(3) = 1
x = ifelse(sysvar(1)=0, 0, ifelse(sysvar(1)=1, 3.7, -3.7))

[State 40, 11]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = Var(2) = 1
trigger1 = Var(3) = 0
x = ifelse(sysvar(1)=0, 0, ifelse(sysvar(1)=1, 4.5, -4.5))

[State 40, 12]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = Var(2) = 0
trigger1 = Var(3) = 1
y = -4

[State 40, 13]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = Var(2) = 1
trigger1 = Var(3) = 1
y = -6.5

[State 40, 14]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = Var(2) = 1
trigger1 = Var(3) = 0
y = const(velocity.jump.y)

[State 40, 15]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

