;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------




[Statedef -2]

; Play "heh" sound when recovering in air or on ground
[State -2, 1]
type = PlaySnd
triggerall = stateno = 5201 || stateno = 5210
trigger1 = Time = 1
value = s6,3

; Play sound when jumping
[State -2, 1]
type = PlaySnd
trigger1 = stateno = 50 && Time = 1
value = s4,2

; Play sound when landing
[State -2, 1]
type = PlaySnd
triggerall = stateno = 52 || stateno = 106
trigger1 = Time = 1
value = s4,25

; Play sound when running
[State -2, 1]
type = PlaySnd
triggerall = stateno = 100
trigger1 = time = 2
channel = 10
loop = 1
value = s30,0

; Stop running sound
[State -2, 1]
type = StopSnd
trigger1 = StateNo != 100
channel = 10

; Play "ow" sound when hit
[State -2, 1]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 5001
trigger1 = anim != 5000 ;Not hit light
trigger1 = anim != 5010 ;Not hit light
trigger2 = stateno = 5040
trigger2 = random < 400
trigger3 = stateno = 5050
value = s6,2 + (random % 2)
;volume = 0

[State -2, 5]
type = EnvColor
trigger1 = Projhit7060 = 1
value = 245,245,245
;ignorehitpause = 1
time = 1

[State -2, 19] 
type = explod
trigger1 = projcontact7060 = 1
;trigger2 = projcontact7062 = 1
anim = 7061
pos = -10,-80
postype = p2
sprpriority = 3
bindtime = 1


