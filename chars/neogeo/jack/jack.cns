; Jack Turner's constants.
; Format (case insensitive):
;  [groupname]        
;  constname = "value"

[Data]
life = 1100          ;Amount of life to start with
attack = 100         ;100% attack power (more is stronger)
defence = 100        ;100% defensive power (more is stronger)
fall.defence_up = 50 ;Def goes up by 50% everytime player is hit on ground
liedown.time = 60    ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 15       ;Can do 15 points of juggling
sparkno = S8011        ;Default spark number
guard.sparkno = S8001  ;Default guard spark number
KO.echo = 0          ;1 to enable echo on KO
volume = 255           ;Volume offset (negative for softer)

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 27    ;Player width (back, ground)
ground.front = 24    ;Player width (front, ground)
air.back = 25        ;Player width (back, air)
air.front = 25       ;Player width (front, air)
z.width = 4          ;Player width (into and out)
height = 110	     ;Height of player (for opponent to jump over)
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = -31, -131  ;Def: -5,-90
mid.pos = -3, -80   ;Def: -5,-60 

[Velocity]
walk.fwd  = 2.8      ;Walk forward
walk.back = -2.5     ;Walk backward
run.fwd  = 5.2, 0    ;Run forward (x, y)  - if y<0, player will hop
run.back = -5.1,-4 ;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-9    ;Neutral jumping velocity (x, y)
jump.back = -3    ;Jump back Speed (x, y)
jump.fwd = 3.2       ;Jump forward Speed (x, y)
runjump.back = -3.5,-9 ;Running jump speeds (opt)
runjump.fwd = 4.5,-9      ;.
airjump.neu = 0,-9      ;.
airjump.back = -3,-9 ;Air jump speeds (opt)
airjump.fwd = 3.2,-9    ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .45         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; LOSE (Time over)
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

;-------------------------------------------------------------------------------------

[Statedef 180]
type = S
physics = N
ctrl = 0
anim = 180
velset = 0,0

[State 180, 1] ;go to alternate win pose (ramdom)
type = ChangeState
trigger1 = Time = 0
trigger1 = random >= 500
value = 181

[State 180, 2]
type = PlaySnd
trigger1 = animelem = 2
value = s7,1

[State 180, 2]
type = PlaySnd
trigger1 = animelem = 20
value = s7,3

[State 180, 2]
type = PlaySnd
trigger1 = animelem = 2
trigger2 = animelem = 8
trigger3 = animelem = 14
trigger4 = animelem = 5
trigger5 = animelem = 11
trigger6 = animelem = 17
trigger7 = animelem = 20
value = s4,1

[State 180, begin]
type = AssertSpecial
trigger1 = time = [0, 290]
flag = roundnotover

[State 180, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1


