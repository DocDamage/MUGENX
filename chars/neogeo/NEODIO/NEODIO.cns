trigger1 = Time = 48
value = 1

[State 191,]
type = PlaySnd
triggerall = AnimElem = 5
trigger1 = Alive
value = 0,4

[State 191,]
type = PlaySnd
triggerall = AnimElem = 6
trigger1 = Alive
value = s100,9
volume = 255

[State 195, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

