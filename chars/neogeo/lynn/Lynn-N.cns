type = S
ctrl = 0
anim = 192
velset = 0, 0

[State 191,AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 7
value = 191, 1

[State 191,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 11
value = 194, 0

[State 191,ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

