[Data]
life = 1000
attack = 100
defence = 100
power = 3000
fall.defence_up = 100	;ダウン時に攻撃された時に一時的に上がる防御力のパーセンテージ
liedown.time = 30		;ダウンしてから起き上がるまでの時間
airjuggle = 1			;ジャグルポイント（空中に浮いてる間のコンボの制限）
sparkno = 0,0			;デフォルトのスパーク番号
guard.sparkno = 0,0		;ガード時のデフォルトスパーク番号
KO.echo = 0			;1にするとKOされた時に声にエコーがかかります
volume = 255			;ボリュームオフセット (negative for softer)
IntPersistIndex = [0,50]

;---------------------------------------------------------------------------
; サイズ指定

[Size]
xscale = 1			;水平方向の縮尺（通常１）
yscale = 1			;垂直方向の縮尺（通常１）
ground.back = 17		;キャラクターの幅（後方、地上）
ground.front = 17		;キャラクターの幅（前方、地上）
air.back = 17			;キャラクターの幅（後方、空中）
air.front = 17		;キャラクターの幅（前方、空中）
height = 60			;キャラの高さ
attack.dist = 100		;攻撃時に相手がガード体勢に入る最低距離（最大320）
proj.attack.dist = 100	;攻撃時に相手がガード体勢に入る最低距離（最大320）（飛び道具）
proj.doscale = 0		;xscale, yscaleの設定が発射物にも適用するかどうかの設定（1なら有効）
head.pos = 10, -65		;頭の大体の座標（BindToTarget使用時に必要です。）
mid.pos = -5, -44		;体中心の大体の座標（BindToTarget使用時に必要です。）
shadowoffset = 0		;影の垂直方向オフセット

;---------------------------------------------------------------------------
; 移動速度の設定

[Velocity]
walk.fwd  = 2.5
walk.back = -2.3
run.fwd  = 6, 0
run.back = -5,0
jump.neu = 0,-9.7		;垂直ジャンプの速度
jump.back = -2.6		;後ジャンプの速度
jump.fwd = 3			;前ジャンプの速度
runjump.back = -2.6,0	;後ろに走りながらのジャンプ時の速度指定 (オプション)
runjump.fwd = 3.3,0		;前に走りながらのジャンプ時の速度指定 (オプション)
airjump.neu = 0,-7		;２段ジャンプ以降の垂直移動速度 (オプション)
airjump.back = -2.55,-7	;２段ジャンプ以降の後ろのジャンプ速度(オプション)
airjump.fwd = 2.5,-7		;２段ジャンプ以降の前のジャンプ速度(オプション)

;---------------------------------------------------------------------------
; 動作の設定

[Movement]
airjump.num = 0
airjump.height = 20		;空中ジャンプに必要な最低限の高さ （オプション）
yaccel = .49			;垂直方向にかかる加速度（重力）
stand.friction = .85		;立ち状態の摩擦係数
crouch.friction = .82	;しゃがみ状態の摩擦係数

