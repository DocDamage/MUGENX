[Statedef -3]
;===============================　　　AI　　　=======================================
[State -3];AI発動
type = VarSet
trigger1 = command = "AI_01" || command = "AI_02" || command = "AI_03" || command = "AI_04" || command = "AI_05"
trigger2 = command = "AI_06" || command = "AI_07" || command = "AI_08" || command = "AI_09" || command = "AI_10"
trigger3 = command = "AI_11"
trigger4 = var(59) = 2 && RoundState = 2
var(59) = 1

[State -3];ランダム
type = varrandom
trigger1 = time = 1 && stateno >= 0
trigger2 = time % 2 = 0 && stateno = 0
v= 58
range = 0,100

[State -3];ランダム2
type = varrandom
trigger1 = time = 1 && stateno >= 0
trigger2 = time % 2 = 0 && stateno = 0
v= 57
range = 0,100

[State -3];AI終了
type = VarSet
triggerall = var(59) = 1 && pos y = 0
trigger1 = RoundState != 2
trigger2 = life <= 0 || p2life <= 0
var(59) = 2

;==================================================================================
[State -3];立ち攻撃
type = ChangeState
triggerall = statetype != A && var(59) = 1 && p2movetype != A
trigger1 = ctrl = 1 && p2bodydist x < 80
value = 199

[State -3];しゃがみ攻撃
type = ChangeState
triggerall = statetype != A && var(59) = 1 && p2movetype != A
trigger1 = ctrl = 1 && p2bodydist x < 90
value = 399

[State -3];空中攻撃
type = ChangeState
triggerall = statetype = A && var(59) = 1 && p2movetype != A
trigger1 = ctrl = 1 && p2bodydist x < 50
