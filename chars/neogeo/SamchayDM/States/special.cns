;----------------------------------------[ SPECIALS ]------------------------------------------

; Flying fist
;-------------------------
[Statedef 1000]
type = S
physics = S
movetype = A
anim = 1000
ctrl = 0
velset = 0,0
poweradd = 45*!var(15)
sprpriority = 1

[State 1000, strengthvar]
type = varset
trigger1 = !time
var(14) = ifelse(command = "qcfy",2,1)

[State 4100, snd]
type = playsnd
trigger1 = animelem = 1
value = 2,2
ignorehitpause = 1
persistent = 0

[State 4100, snd]
type = playsnd
trigger1 = animelem = 3
value = 3,1
ignorehitpause = 1
persistent = 0

[State 1000, Helper]
type = helper
trigger1 = AnimElem = 3
helpertype = normal
stateno = 4100
ID = 4100
name = "Flying fist"
postype = p1
pos = 100,-71
size.xscale = 1
size.yscale = 1
ownpal = 1

[State 1000, end]
type = changestate
trigger1 = !animtime
value = 0
ctrl = 1

