[Statedef -3]

; Sounds
;--------------------
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 
trigger2 = stateno = 106 
trigger3 = stateno = 1053
value = 40, 0

[State -3, dash Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 105 
value = 100, 0

[State -3, super jump]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 7000 && time = 1
trigger2 = stateno = 7002 && time = 1
trigger3 = stateno = 7004 && time = 1
value = 3, 3

[State -3, dizzy snd]
type = PlaySnd
triggerall = Time = 1
trigger1 = Anim = 5300
trigger2 = Anim = 170
value = 12, 0

; Variables
;--------------------
[state -3, jump/short jump] 
type = varset 
trigger1 = (var(10) = 1) && (stateno = 50) 
v = 10 
value = 0 

[state -3, special strength var reset] 
type = varset 
trigger1 = (var(14) > 0) && Stateno < 1000 
v = 14 
value = 0 

[State -3, Golpes Normais Fracos]
type = VarSet
trigger1 = Stateno = 200 || Stateno = 230 || Stateno = 400 || Stateno = 430 || Stateno = 600 || Stateno = 630
var(0) = 1

[State -3, Golpes Normais Fortes]
type = VarSet
trigger1 = Stateno = 210 || Stateno = 240 || Stateno = 410 || Stateno = 440 || Stateno = 610 || Stateno = 640
trigger2 = Stateno = 216 || Stateno = 246 || Stateno = 635 || Stateno = 645 || Stateno = 810 || Stateno = 811
var(0) = 2

[State -3, Golpes Especiais Fracos]
type = VarSet
trigger1 = var(14) = 1
var(0) = 3

[State -3, Golpes Especiais Fortes]
type = VarSet
trigger1 = var(14) = 2
var(0) = 4

[State -3, Golpes Super]
type = VarSet
trigger1 = Stateno = 750 || Stateno >= 2000
var(0) = 5

