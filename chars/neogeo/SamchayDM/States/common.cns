; Forward Roll 
;-------------------------
[statedef 510]
type = s
physics = n
movetype = i
anim = 510
velset = 0,0
ctrl = 0
sprpriority = -1

[state 510, vel]
type = velset
trigger1 = animelem = 3
x = 7

[state 810, afterimage]
type = afterimage
trigger1 = animelem = 2
time = 9999
framegap = 3
length = 9
palbright = 1,1,1
palcontrast = 128, 128, 128
paladd = 0,0,0
palmul = .5,.5,.5
trans = add1

[state 810, afterimage remover]
type = afterimagetime
trigger1 = !animtime
time = 0

[state 510, vel]
type = velmul
trigger1 = animelemtime(5)>0
x = .85

[state 510, push]
type = playerpush
trigger1 = 1
value = 0

[state 510, nhb]
type = nothitby
trigger1 = 1
value = sca
time = 1
ignorehitpause = 1

[state 510, end]
type = changestate
trigger1 = !animtime
value = 0
ctrl = 1

