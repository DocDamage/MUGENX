; Lose by time over
;-------------------------
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

; Winposes 
;-------------------------
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = ifelse(matchover = 0,181,182)

;---[After 1st. round]---
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, voz]
type = PlaySnd
trigger1 = AnimElem = 3
value = 2, 3

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---[After 2nd. round or more]---
[Statedef 182]
type = S
ctrl = 0
anim = 182
velset = 0,0

[State 182, voz]
type = PlaySnd
trigger1 = AnimElem = 9
value = 2, 4

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

