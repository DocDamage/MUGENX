anim = 3102
ID = 31025
sprpriority = 5
postype = p1
removetime = 20
supermovetime = 300
ownpal = 1

[State 3100, modifica]
type = modifyexplod
trigger1 = numexplod(31024)
ID = 31024
scale = .2+(.03*(time-30)),.2+(.03*(time-30))

[State 3100, modifica mais]
type = modifyexplod
trigger1 = numexplod(31025)
ID = 31025
