[State 4100, hit]
type = hitdef
trigger1 = 1
priority = 6,Hit
attr = S,HP
damage = 50
animtype = Hard
hitflag = MAF
guardflag = MA
pausetime = 3,3
sparkno = -1
guard.sparkno = s8519
sparkxy = -10,0
