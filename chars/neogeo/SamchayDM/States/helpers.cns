[State 3100, sem sombra]
type = assertspecial
trigger1 = 1
flag = noshadow
flag2 = invisible
ignorehitpause = 1

[State 3100, congela a tela]
type = screenbound
trigger1 = 1
value = 0

[State 3100, remove todos os circulos]
type = removeexplod
trigger1 = time >= 46

[State 3100, fim]
type = destroyself
trigger1 = time >= 46

; Normal Hitsparks
;----------------------
[Statedef 8512]
type = S
anim = 8528+(random%5)
scale = 1
sprpriority = 6
supermove = 1

[State 8512, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[State 8512, var]
type = varset
trigger1 = !time
var(0) = root,var(0)

[State 8512, AfterImage]
type = AfterImage
trigger1 = !time
time = 200
trans = add
TimeGap = 1
FrameGap = 2
length = 60
PalBright = 0, 0, 0
PalContrast = 100,100,100
PalAdd = 0, 0, 0
PalMul = 0, 0, 0

[state 8512, HitSparks]
type = explod
trigger1 = !Time
removetime = 15
supermovetime = 300
pausemovetime = 300
bindtime = -1
anim = 8539
pos = 0, 0
scale = 1, 1
sprpriority = 4
id = 8539
removeongethit = 1

[state 8512, HitSparks]
type = modifyexplod
trigger1 = 1
ID = 8539
scale = var(0)*0.1+(.050*time),var(0)*0.1+(.050*time)

[state 8512, HitSparks circle]
type = explod
trigger1 = !Time
pausemovetime = 100
supermovetime = 100
removetime = 15
bindtime = -1
anim = 8535+(random%4)
pos = 0, 0
scale = 0,0
sprpriority = 4
id = 8535
removeongethit = 1

[state 8512, HitSparks circle]
type = modifyexplod
trigger1 = 1
ID = 8535
scale = var(0)*0.1+(.025*time),var(0)*0.1+(.025*time)

[state 8512, palfx]
type = palfx
trigger1 = time = [10,16]
time = 1
add = ceil(-time/12.0*200),ceil(-time/12.0*200),ceil(-time/12.0*200)

[State 3100, remove todos os explods]
type = removeexplod
trigger1 = time >= 15

[State 8512, DestroySelf]
type = DestroySelf
trigger1 = time >= 15

