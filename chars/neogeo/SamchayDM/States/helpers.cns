;Partículas vindo à Samchay (power charge}
;-------------------------
[Statedef 8500]
physics = N
anim = 8500
sprpriority = 3

[State 8500, vel]
type = velset
trigger1 = 1
x = rootdist x/30.0
y = (rootdist y-70*root,const(size.yscale))/30.0

[State 8500, afterimage]
type = afterimage
trigger1 = !time
time = 999
timegap = 1
framegap = 1
length = 6
palbright = 30,0,0
palmul = .75,.33,.33
palcontrast = 120,0,0
palpostbright = 50,0,0
trans = add

[State 8500, fim]
type = destroyself
trigger1 = !animtime
ignorehitpause = 1

; Flying fist helper
;-------------------------
[Statedef 4100]
type = A
physics = N
movetype = A
anim = 4000
ctrl = 0
velset = 0,0
sprpriority = 4

[State 4100, hitby]
type = hitby
trigger1 = 1
time = -1
value = SCA,NP,SP,HP
ignorehitpause = 1

[State 4100, hitoverride]
type = hitoverride
trigger1 = 1
time = -1
attr = SCA,NP,SP,HP
stateno = 4101
ignorehitpause = 1

[State 4100, strengthvar]
type = varset
trigger1 = !time
var(14) = root,var(14)

[State 4100, sparkvar]
type = varset
trigger1 = !time
var(0) = root,var(0)

[State 4100, partículas]
type = Explod
trigger1 =!(time%3) && Time > 2
anim = 8500
ID = 8500
vel = ifelse(var(13) = 2,0.50,0.20),vel y/2
random = 5,25
pos = -40,0
scale = .3,.3
facing = -1+(random<500)*2
sprpriority = 9
supermove = 1
removetime = -2
supermovetime = 300
pausemovetime = 300

[State 4100, vel]
type = velset
trigger1 = 1
x = ifelse(var(14) = 2,6,4)
y = 0

[State 4100, assert]
type = assertspecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 4100, hit]
type = hitdef
trigger1 = 1
priority = 6,Hit
attr = S,SP
damage = ifelse(var(14) = 2,75,90),5
animtype = Hard
hitflag = MAF
guardflag = MA
pausetime = 4,4
sparkno = -1
guard.sparkno = s8519
sparkxy = -10,0
guardsound = s1,4
hitsound = s1,5
ground.type = High
ground.slidetime = 24
ground.hittime = 24
ground.velocity = ifelse(p2dist x < 5,-5,-2),0
ground.cornerpush.veloff = 0
air.velocity = -3,-3
air.fall = 1
fall = ifelse(p2dist x < 5,1,0)
p2facing = 1
getpower=140*!(root,var(15))
envshake.time = 12
envshake.freq = 100
envshake.ampl = 4
sprpriority = 4

[State 1302, HitSpark Especial]
type = Helper
trigger1 = (movehit && numtarget)
trigger1 = (target,movetype=H) && !(target,time)
helpertype = Normal
ID = 85121
stateno = 85121
name = "HitSparkEspecial"
sprpriority = 7
postype = p1
ownpal = 1
pos = 0,0
ignorehitpause = 1 
persistent = 1
size.xscale = 0.5+var(0)*0.1
size.yscale = 0.5+var(0)*0.1

[State 4100, ChangeState]
type = ChangeState
trigger1 = MoveContact || BackEdgeDist < -30 || FrontEdgeDist < -30 
value = 4101

