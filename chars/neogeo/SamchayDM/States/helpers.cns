; Super Charge
;-------------------------

[Statedef 3100]
physics=N
velset=0,0
anim=9999

[State 7500, bgpalfx1]
type = bgpalfx
trigger1 = !time
time = 40
invertall = 1
add = 100,100,100
sinadd = -710,-710,-355,160

[State 7500, bgpalfx1]
type = bgpalfx
trigger1 = time = 40
time = 5
add = -255,-255,-255
sinadd = 255,255,255,20

[State 7500, fade]
type = palfx
trigger1 = !time
time = 40
sinadd = -255,-255,-255,160

[State 7500, fade]
type = palfx
trigger1 = time = 40
time = -1
add = -255,-255,-255

[State 7500, spiral]
type = null
trigger1 = !time
helpertype = normal
stateno = 8543
ID = 8543
name = "Super Charge Spiral"
postype = p1
supermovetime = 300
ownpal = 1
scale = 0.5,0.5

[State 3100, explod circular]
type = explod
trigger1 = !time
anim = 3100
ID = 3100
sprpriority = 5
postype = p1
removetime = -1
supermovetime = 300
ownpal = 1

[State 3100, modifica]
type = modifyexplod
trigger1 = time > 0
ID = 3100
scale = 1.4-(.038*time),1.4-(.038*time)

[State 3100, modifica mais]
type = modifyexplod
trigger1 = time > 7
ID = 3100
scale = 1.4-(.033*time),1.4-(.033*time)

[State 3100, midifica mais um pouco]
type = modifyexplod
trigger1 = time > 16
ID = 3100
scale = 1.4-(.030*time),1.4-(.030*time)

[State 3100, explod circular]
type = explod
trigger1 = !time
anim = 3102
ID = 31021
sprpriority = 5
postype = p1
removetime = 20
supermovetime = 300
ownpal = 1

[State 3100, o mesmo mas modificado]
