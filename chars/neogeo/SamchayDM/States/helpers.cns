pausemovetime = 300

[State 4100, vel]
type = velset
trigger1 = 1
x = 8.5
y = 0

[State 4100, assert]
type = assertspecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 4100, hitcountvar]
type = varadd
trigger1 = !time
