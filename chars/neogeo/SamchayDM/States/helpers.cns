sprpriority = 4

[State 4100, vel]
type = varset
trigger1 = !time
var(7) = -10

[State 4100, vel]
type = varset
trigger1 = !time
var(8) = -0

[State 200, Normal HitSpark]
type = Helper
trigger1 = movehit && numtarget
trigger1 = (target,movetype = H) && !(target,time)
helpertype = Normal
ID = 85121
stateno = 85121
name = "Special HitSpark"
sprpriority = 5
postype = p2
ownpal = 1
pos = (target,const(size.ground.front) + var(7)),var(8)-floor(p2dist y)
ignorehitpause = 1 
persistent = 0
size.xscale = 0.5+var(0)*0.1
size.yscale = 0.5+var(0)*0.1
supermove = 1
supermovetime = 16
pausemovetime = 16

[State 8502, end]
type = changestate
trigger1 = movecontact
value = ifelse(var(4)<3,8502,8503)
ignorehitpause = 1

[State 8502, end]
type = changestate
trigger1 = frontedgedist < -60 || backedgedist < -65
value = 8503

