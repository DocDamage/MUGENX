trigger1 = time = 10
anim = 3102
ID = 31022
sprpriority = 5
postype = p1
removetime = 20
supermovetime = 300
ownpal = 1

[State 3100, modifica]
type = modifyexplod
trigger1 = numexplod(31021)
ID = 31021
scale = .2+(.03*time),.2+(.03*time)

[State 6100, modifica mais]
type = modifyexplod
trigger1 = numexplod(31022)
ID = 31022
scale = .2+(.03*(time-10)),.2+(.03*(time-10))

[State 3100, explod circular]
