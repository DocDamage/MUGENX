type = A
movetype = A
physics = A
sprpriority = 2
anim = 1030
poweradd = 80
ctrl = 0

[State 1030, 0]
type = VarSet
fv = 0
value = p2BodyDist X/105
trigger1 = time = 0

[State 1030, 0]
type = velset
x = 4 * p2BodyDist X/105
y = -7-(0.1 * p2BodyDist X/105)
trigger1 = time = 0

[State 1030, 2]
type = PlaySnd
trigger1 = time = 1
value = 2, 13

[State 1030, 3]
type = Hitdef
triggerall = movecontact = 0
trigger1 = stateno = 1030
damage = 20, 4
attr = A, SA
hitflag = MAF
guardflag = MA
animtype = High
pausetime = 0,12
;ground.type = High (default)
ground.hittime = 25-time
getpower = 75,10
givepower = 10,5
sparkno = 40
sparkxy = 0,-60
hitsound = S0,2
guardsound = S0,14

[State 1030, last]
type = ChangeState
value = 1031
trigger1 = movecontact != 0
trigger2 = moveguarded != 0

