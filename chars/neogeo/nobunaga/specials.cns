; special moves here

;grey normale (1)
[Statedef 1000]
type = S
movetype = A
anim = 1000
sprpriority = 2
velset = 5, 0
poweradd = 80
ctrl = 0

[State 1000, 2]
type = PlaySnd
trigger1 = time = 1
value = 2, 13

[State 1000, 3]
type = Hitdef
triggerall = movecontact = 0
trigger1 = stateno = 1000
damage = 75, 10
attr = S, SA
hitflag = MAF
guardflag = MA
animtype = Hard
pausetime = 0,12
ground.type = Low
ground.hittime = 25-time
ground.velocity = -6,0
ground.slidetime = 25-time
getpower = 20,5
givepower = 10,5
sparkno = 40
sparkxy = 0,-60
hitsound = S0,2
guardsound = S0,14

[State 1000, 4]
type = ChangeState
value = 1001
trigger1 = time = 30
trigger2 = movecontact != 0

