;tentativo di presa speciale
[StateDef 1100]
type    = S
movetype= A
physics = S
juggle  = 0
velset = 0,0
ctrl = 0
anim = 801
sprpriority = 2

[State 1100, 1]
type = HitDef
Trigger1 = Time = 0
attr = S, ST          ;Attributes: Standing, Special Throw
hitflag = M-          ;Affect only ground people who are not being hit
guardflag = L
priority = 1, Miss    ;Throw has low priority, must be miss or dodge type.
sparkno = -1          ;No spark
p1facing = 1
p2facing = 1          ;Force p2 to face KFM
p1stateno = 1101       ;On success, KFM changes to state 800
p2stateno = 1102      ;If hit, p2 changes to state 802 in This cns
guard.dist = 0        ;This prevents p2 from going into a guard state if close
fall = 1              ;Force p2 into falling down

[State 1100, AI Extracting sword decider]
type = ChangeState
value = 810
triggerall = var(30) = 1 && var(10) = 0
trigger1 = animtime = 0 && random < 700

[State 1100, 3]
type = ChangeState
Trigger1 = AnimTime = 0
value = ifelse(var(10)=1,270,230)

;"special throw" vera e propria
[Statedef 1101]
type    = S
movetype= A ;è un attacco, ma lo definisco così per far 
            ;apparire la spada quando estratta
physics = N
anim = 1101
poweradd = 80
ctrl = 0

[State 1001, first sound]
type = playsnd
value = 2, 9
trigger1 = time = 0

[State 1101, bind 1]
type = TargetBind
pos = 35,35
time = 2
trigger1 = time = 0

[State 1101, width]
type = Width
edge = 130
trigger1 = frontedgedist < 130

[State 1101, bind 2]
type = TargetBind
pos = 35,28
time = 2
trigger1 = time = 2

[State 1101, bind 3]
type = TargetBind
pos = 45,15
time = 2
trigger1 = time = 4

[State 1101, bind 4-5]
type = TargetBind
pos = 58,-13
time = 80
trigger1 = time = 6

[State 1101, parte 2 starts]
type = ChangeAnim
value = 1107
trigger1 = time = 86

[State 1101, bind 6]
type = TargetBind
pos = 58,-15
time = 2
trigger1 = time = 86

[State 1101, second sound]
type = playsnd
value = 2, 7
trigger1 = anim = 1107 && animelem = 2

[State 1101, bind 7]
type = TargetBind
pos = 58, -9
time = 2
trigger1 = time = 88

[State 1101, tolgo energia]
type = TargetLifeAdd
value = -150
trigger1 = time = 90

[State 1101, Hitdef at frame 8]
type = HitDef
trigger1 = anim = 1107 && animelem = 3
attr = S, ST
hitflag = MAFD
guardflag = H
animtype = hard
damage = 20,20; last damage 
sparkno = 2
sparkxy = 0,-60
hitsound = S0,10
fall = 1
ground.type = low
ground.slidetime = 20
ground.velocity = -6,-2
air.velocity = -6,-2
ground.cornerpush.veloff = -2
air.cornerpush.veloff = -2
down.bounce = 1
givepower = 20,20
fall.envshake.time = 20
fall.envshake.freq = 60
fall.envshake.ampl = -4
fall.envshake.phase = 90

[State 1101, fine della presa]
type = ChangeState
value = 0
trigger1 = anim = 1107 && animtime = 0
ctrl = 1

