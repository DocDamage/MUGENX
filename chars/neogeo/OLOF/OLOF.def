cns     = CNS/OLOF.cns   ;Constants
st      = CNS/OLOF_normal.cns
st1	= CNS/OLOF_special.cns
st2	= CNS/OLOF_hyper.cns   ;States
st3	= CNS/etc.cns
st4	= CNS/-2.cns
stcommon = CNS/common1.cns ;Common states
sprite  = OLOF.sff   ;Sprite
anim    = OLOF.air   ;Animation
sound   = OLOF.snd   ;Sound
pal1    = ACT/OLOF.act  
pal2    = ACT/OLOF4.act 
pal3    = ACT/OLOF3.act 
pal4    = ACT/OLOF2.act 
pal5    = ACT/OLOF5.act 
pal6    = ACT/OLOF6.act 

