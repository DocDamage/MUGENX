;基本動作

;---------------------------------------------------------------------------
; 立ち状態
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
;trigger1 = PrevStateNo = [200,299]
trigger1 = Anim != 0 && Anim != 5 && Anim != 1 && Anim != 2
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 2

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 && Anim != 1 && Anim != 2
trigger2 = Anim = 2 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

;---------------------------------------------------------------------------
; 立ち→しゃがみ
[Statedef 10]
type    = C
physics = C
anim = 10

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; しゃがみ状態
[Statedef 11]
type    = C
physics = C
;anim = 11
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = PrevStateNo = [400,499]
trigger1 = Anim != 11 && Anim != 13 && Anim != 6 ;&& Anim != 1 && Anim != 2
;trigger1 = Anim = 6 && AnimTime = 0
value = 13

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim != 11 && Anim != 13 && Anim != 6 ;&& Anim != 1 && Anim != 2
trigger2 = Anim = 6 && AnimTime = 0
trigger3 = Anim = 13 && AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; しゃがみ→立ち
[Statedef 12]
type    = S
physics = S
anim = 12

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0


;---------------------------------------------------------------------------
; ジャンプ開始前
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
trigger1 = var(1) !=  1
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
trigger1 = var(1) !=  -1
sysvar(1) = -1

[State 40, 2]
type = VarSet
trigger1 = time = 0
var(1) = 0

[State 40, 2]
type = VarSet
trigger1 = var(1) = 0
trigger1 = command = "holdfwd"
trigger1 = command = "jump"
var(1) = 1

[State 40, 3]
type = VarSet
trigger1 = var(1) = 0
trigger1 = command = "holdback"
trigger1 = command = "jump"
var(1) = -1

[State 40, 4]
type = VelSet
triggerall = !(var(1) = 1 || var(1) = -1)
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 4]
type = VelSet
triggerall = (var(1) = 1 || var(1) = -1)
trigger1 = AnimTime = 0
x = const(velocity.runjump.fwd.x)*var(1)
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 1000,00]
type = Afterimagetime
trigger1 = Animelem = 6
time = 1

[State 100,00]
type = Afterimage
trigger2 = (var(1) = 1 || var(1) = -1)
triggerall = command != "holdup"
trigger1 = PrevStateNo = 100
trigger1 = sysvar(1) = 1
triggerall = animtime= 0
trans = none
TimeGap = 2
FrameGap = 3
length = 4
time = 11
PalBright = 75,75,75
PalContrast = 125,125,125
palpostbright = 0,0,0
PalAdd = 0,0,0
PalMul = 1,1,1

[State 40, 6]
type = ChangeState
triggerall = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
triggerall = sysvar(1) = [-1,1]
triggerall = command != "holdup"
trigger2 = (var(1) = 1 || var(1) = -1)
value = 56

[State 40, 6]
type = ChangeState
triggerall = !(var(1) = 1 || var(1) = -1)
triggerall = AnimTime = 0
trigger1 = sysvar(1) = [-1,1]
trigger1 = command != "holdup"
value = 55
ctrl = 1

[State 100,00]
type = Afterimage
trigger2 = (var(1) = 1 || var(1) = -1)
trigger1 = PrevStateNo = 100
trigger1 = sysvar(1) = 1
triggerall = animtime= 0
trans = none
TimeGap = 2
FrameGap = 3
length = 4
time = 22
PalBright = 75,75,75
PalContrast = 125,125,125
palpostbright = 0,0,0
PalAdd = 0,0,0
PalMul = 1,1,1

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; 空中ジャンプ開始前
[Statedef 45]
type    = A
physics = N
;anim = 50
ctrl = 0
velset = 0,0

[State 3000, Super D] ;無敵
type = NotHitBy
trigger1 = 1;AnimElem = 1,0
value = sca
time = 1

[State 45, 3]
type = VarSet
trigger1 = Time = 0
;trigger1 = var(2) = 1
var(2) = 2

[State 45, 2]
type = ChangeAnim
;trigger1 = animelem = 8, >= 0 
trigger1 = time >= 8
trigger1 = SelfAnimExist(50)
value = 50
elem = 8

[State 45, 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = SelfAnimExist(50)
value = 50

[State 45, 2]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = !SelfAnimExist(50)
value = 41

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 8
;trigger1 = PrevStateNo != 55
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State -3, Landing Sound]
type = PlaySnd
;trigger1 = Time = 0
trigger1 = PrevStateNo = [50,50]
;trigger2 = Time = 0
trigger2 = PrevStateNo = [55,55]
value = s50, 0
persistent = 0

[State 1000,00]
type = Afterimagetime
