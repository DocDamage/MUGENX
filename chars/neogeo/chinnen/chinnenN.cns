;====================================== && 
;chinnen by wara
;======================================

;=======================================================================================================
; 書式:		CNSの書き方
;
;statedef部分:
;	stateは[Statedef ***]によって区切られるので
;	次の[Statedef ***]が出てくるまでは同じstateno内である
;[Statedef ***]
;	※***の部分は数値のみ設定可能これがstatenoとなる
;～Statedefで設定可能な項目（全て省略可能）～
;1. type : 状態
;	S:立ち
;	C:しゃがみ
:	A:空中
:	L:倒れこみ
;	U:前stateを引き継ぐ
;2. movetype : 行動
;	I:通常
;	A:攻撃
;	H:食らい
;	U:前stateを引き継ぐ
;3. physics : 重力や摩擦
;	S:立ち状態の摩擦を受ける
;	C:しゃがみ状態の摩擦を受ける
;	A:重力を受ける（pos Y = 0になったら自動的に着地stateに移行する）
;	N:重力及び摩擦を一切受けない
;	U:前stateを引き継ぐ
;4. anim : アニメーション（changeanimを自動的に行う）
;5. velset : 速度 （velsetを自動的に行う）
;6. ctrl : コントロールの変更 （ctrlset）
;7. poweradd : パワー増加 （poweraddを自動的に行う）
;8. juggle : ここでの攻撃を当てるのに必要なjuggle、当てるとこれだけjuggleが減る ※追い討ち時のみ
;9. facep2 : もし敵が自分より裏に回っていたら自動的に向き直る（turn）
;10. hitdefpersist : hitdefを前のstateより引き継ぐ
;11. movehitpersist : movehit等の値を前のstateより引き継ぐ
;12. hitcountpersist : hitcountを前のstateより引き継ぐ
;13. sprpriority : 自分の表示位置の設定（-5（奥）～5（手前））
;
;state部分:
;	stateというよりはこの場合命令と言ったほうが良い
;	必須項目はtype = ***のみだし
;	※***の部分はsctrlが入ります
;[State xxx, yyy]
; type = ?
; ...
;	xxxには任意の文字又は数値
;	yyyの部分にも任意の文字又は数値を入れる
;	自分が解り易いように書くのが一番だと思う
;	「,」は必ず入れなければならない
;	typeにはsctrlが入る
;	※[statedef]には必ず一つは[state]が必要です
;
;～Stateで設定可能な項目（全て省略可能）～
;1. persistent : 何度も条件が成立した場合の実行感覚
;	persistentは一度条件が成立しその命令を行った後に必要となる命令で
;	0 だと最初の1回のみ
;	1 だと毎フレーム
;	2 だと1フレームおきに
;	3 だと2フレームおきにといった具合に
;	一度実行した後何フレーム毎に再度実行するかという設定になる
;	当然trigger部分が最優先なので設定フレーム後条件が成立しなければ実行されることはない
;2. ignorehitpause : 自分が硬直している間に命令を実行するか
;	基本的に自分が硬直している間はtimeが停止し
;	命令が実行されることはない
;	しかし硬直中に実行した場合もあるので
;	必要に応じてこの値を1にすれば硬直中にも命令を実行できる
;
;=======================================================================================================

;---------------------------------------------------------------------------
; 時間切れにて負け ※lifeがまだ残っている（state170)
;
; このstateはmugen内部より強制的に飛ばされるstateで
; 必ず設定しなくてはならない
; もし負けを数種類設定したい場合は他のstateに飛ばしたり
; 条件を変えたりして処理しましょう
; ※このstateはcommon1.cnsを上書きしています
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1];一応無敵にしておく
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; 勝利（state180）
;
; このstateはmugen内部より強制的に飛ばされるstateで
; 必ず設定しなくてはならない
; もし勝利ポーズを何種類も設定したい場合は他のstateに飛ばしたり
; 条件を変えたりして処理しましょう
; ※このstateはcommon1.cnsを上書きしています
[Statedef 180]
type = S

[State 181, 1]
type = ChangeState
trigger1 = Time = 0
trigger1 = MatchOver = 0
value = 181

[State 181, 1]
type = ChangeState
trigger1 = Time = 0
trigger1 = MatchOver = 1
value = 182

;---------------------------------------------------------------------------
; 勝利ポーズその１（state181）煩悩のままに！
[Statedef 181]
type = S
ctrl = 0
anim = 182
velset = 0,0

[State 181, 1];一応無敵にしておく
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 191, Snd 1]
type = PlaySnd
trigger1 = AnimElem = 15
value = s190,3
channel = 0

[State 191, 2] ;このstateが実行されてる間戦闘を開始させないようにする
type = AssertSpecial
trigger1 = time <= 150
flag = roundnotover

;---------------------------------------------------------------------------
; 勝利ポーズその１（state181）煩悩万歳！ニャー
[Statedef 182]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, 1];一応無敵にしておく
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 191, Snd 1]
type = PlaySnd
trigger1 = AnimElem = 1
value = s190,1
channel = 0

[State 191, Snd 1]
type = PlaySnd
trigger1 = AnimElem = 20
value = s190,2
channel = 0

[State 191, 2] ;このstateが実行されてる間戦闘を開始させないようにする
type = AssertSpecial
trigger1 = time <= 200
flag = roundnotover

;---------------------------------------------------------------------------
; イントロ分岐（state190）煩悩のままに、、、

[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190, 1]
type = null;VarRandom
trigger1 = Time = 0
v = 1
range = 0,1

[State 180, VarSet]
type = VarSet
trigger1 = command != "holdup"
trigger1 = command != "holddown"
var(5) = 0

[State 180, VarSet]
type = VarSet
trigger1 = command = "holdup"
trigger2 = command = "holddown"
var(5) = 1

[State 190, Flaming Fist Intro]
type = ChangeState
trigger1 = Var(5) = 0
value = 192

[State 190, Turning Around Intro]
type = ChangeState
trigger1 = Var(5) = 1
value = 191

;---------------------------------------------------------------------------
; イントロその１（state191）煩悩のままに、、、
;
; このstateはmugen内部より強制的に飛ばされるstate5900（common内にあるstate）より
; round1の時に強制的に飛ばされるstate190から更に飛ばされてくるstateである
; commonの書き換えをしない限り設定しなくてはならない
; もし勝利ポーズを何種類も設定したい場合は他のstateに飛ばしたり
; 条件を変えたり、state190を上書きしたりして処理しましょう
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 21000, AssertSpecial]
type = AssertSpecial
trigger1 = pos y >= 5
flag = NoShadow
;flag2 = Invisible
ignorehitpause = 1

[State 191, 3]
type = posset
trigger1 = anim != 190
trigger1 = RoundState = 0
trigger2 = time = 0
y = 96

[State 191, 3]
type = posset
trigger1 = animtime = 0
y = 0

[State 191, 3]
type = posset
trigger1 = animtime != 0
trigger1 = pos y <= 5
y = 5

[State 191, 3]
type = velset
trigger1 = pos y <= 5
y = 0

[State 191, 3]
type = velset
trigger1 = RoundState = 1
trigger1 = pos y >= 5
y = -5.0;+(time*-0.5)

[State 191, 1] ;アドオンに設定されたイントロ開始時間までアニメを最初の１フレーム目で止めておく
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 181, 1];一応無敵にしておく
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 191, 2] ;このstateが実行されてる間戦闘を開始させないようにする
type = AssertSpecial
trigger1 = 1
flag = Intro
flag2 = nobardisplay

[State 191, 3] ;アニメーションが終了したらstate0へ移動する
type = ChangeState
trigger1 = AnimTime = 0
value = 0

[State 191, Snd 1] 
type = PlaySnd
trigger1 = AnimElem = 36
value = s190,0
channel = 0

;---------------------------------------------------------------------------
; イントロその２（state192）煩悩のままに、、、
;
; このstateはmugen内部より強制的に飛ばされるstate5900（common内にあるstate）より
; round1の時に強制的に飛ばされるstate190から更に飛ばされてくるstateである
; commonの書き換えをしない限り設定しなくてはならない
; もし勝利ポーズを何種類も設定したい場合は他のstateに飛ばしたり
; 条件を変えたり、state190を上書きしたりして処理しましょう
[Statedef 192]
type = S
ctrl = 0
anim = 191
velset = 0,0

[State 191, 3]
type = posset
;trigger1 = RoundState = 0
trigger1 = time = 0
y = 0

[State 191, 1] ;アドオンに設定されたイントロ開始時間までアニメを最初の１フレーム目で止めておく
type = ChangeAnim
trigger1 = RoundState = 0
value = 191

[State 181, 1];一応無敵にしておく
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 191, 2] ;このstateが実行されてる間戦闘を開始させないようにする
type = AssertSpecial
trigger1 = 1
flag = Intro
flag2 = nobardisplay

[State 191, 3] ;アニメーションが終了したらstate0へ移動する
type = ChangeState
trigger1 = AnimTime = 0
value = 0

[State 191, Snd 1] 
type = PlaySnd
trigger1 = AnimElem = 29
value = s190,0
channel = 0

;---------------------------------------------------------------------------
; 手合わせ合図　ほら、相手をしてやろう
[Statedef 195]
type = S
movetype = I
physics = S
anim = 195
velset = 0,0
ctrl = 0

[State 195, 1]
type = CtrlSet
trigger1 = Time = 61
value = 1

[State 195, 1]
type = PowerAdd
trigger1 = Time = 61
value = 334

[State 200, slide]
type = varadd
triggerall = PalNo >= 7
trigger1 = Time = 61
trigger1 = var(59) < 1000
;trigger1 = MoveGuarded = 1
var(59) = 334
persistent = 0
ignorehitpause  = 1

[State 195, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; 黒子呼び出し　お～い！パン！パン！
[Statedef 196]
type = S
ctrl = 0
anim = 196
velset = 0,0
movetype = I
physics = S
sprpriority = 2

[State 195, 1] ;33フレームたったら行動可能にする
type = CtrlSet
trigger1 = Time = 33
value = 1

[State 195, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

