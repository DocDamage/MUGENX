;---------------------------------------------------------------------------
; トレーニングモード
; -アーケードモードの第1戦とVSモードで、ラウンド開始直後にF3を押して
; -パワーを満タンにすると暴発します。
[State -2, Training]
type = VarSet
triggerall = PalNo < 7
trigger1 = !var(57)
trigger1 = ctrl
trigger2 = RoundNo > 1
var(57) = 1

[State -2, Training]
type = VarSet
triggeralll = PalNo < 7
trigger1 = !var(57)
trigger1 = Power >= 3000
trigger1 = RoundNo = 1 && MatchNo = 1 && NumPartner = 0 && NumEnemy = 1
var(57) = 2

[State -2, Training]
type = VarSet
triggerall = PalNo < 7
trigger1 = var(57) = 2
var(58) = 3

;---------------------------------------------------------------------------
; 攻撃力補正
; -パワーゲージ補正
[State -2, AttackFix]
type = VarSet
trigger1 = 1
fvar(1) = ifelse(var(58)=0||(StateNo=[3000,3110]),1.0,ifelse(var(58)=1,1.01,ifelse(var(58)=2,1.02,1.05)))

; -コンボ補正
[State -2, AttackFix]
type = VarSet
trigger1 = StateNo != [3000,3110]
trigger1 = stateno != [1000,1074]
fvar(1) = fvar(1)*(20-var(17))/20

[State -2, DefenceFix]
type = AttackMulSet
trigger1 = 1
value = fvar(1)
ignorehitpause = 1

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

[State -2, 3]
type = VarSet
trigger1 = 1
fvar(2) = ifelse(Life <= 500 && Life > 400 ,0.9,ifelse(Life <= 400 && Life > 300 ,0.8,ifelse(Life <= 300 && Life > 200 ,0.7,ifelse(Life <= 200 && Life > 100 ,0.6,ifelse(Life <= 100 ,0.5 ,1.0)))))
;ifelse(Life < 450,0.9,ifelse(Life < 400,0.8,ifelse(Life < 350,0.7,ifelse(Life < 300,0.6,ifelse(Life < 250,0.5,ifelse(Life < 200,0.4,ifelse(Life < 150,0.3,ifelse(Life < 100,0.2,ifelse(Life < 50,0.1,0.0))))))))
;ifelse(Life < 450,1.1,ifelse(Life < 400,1.2,ifelse(Life < 350,1.3,ifelse(Life < 300,1.4,ifelse(Life < 250,1.5,ifelse(Life < 200,1.6,ifelse(Life < 150,1.7,ifelse(Life < 100,1.8,ifelse(Life < 50,1.9,2.0))))))))
;ifelse(Life >= 450,1.1,(((Life * 0.1 * 5)*-0.1) + 2))
;ifelse(Life >= 450,1.0,((((Life * 0.1 * 5)*-0.1) + 1) - 1))

