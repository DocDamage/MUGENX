trigger2 = StateNo = [1001,1002]
trigger3 = StateNo = [1011,1012]
trigger4 = StateNo = [1051,1052]
trigger5 = StateNo = [1061,1063]
trigger6 = StateNo = [1100,1100]
trigger7 = StateNo = [1110,1110]
trigger8 = StateNo = [1150,1150]
trigger9 = StateNo = [1160,1160]
trigger10 = StateNo = [1300,1300]
trigger11 = StateNo = [3050,3050]
trigger12 = StateNo = [3001,3003]
trigger13 = StateNo = [3101,3102]
