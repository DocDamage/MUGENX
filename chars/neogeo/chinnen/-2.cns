[State -2, DEBUG]
trigger1 = 1
type = DisplayToClipboard
ignorehitpause = 1
text = "var(59) = %d var(55) = %d pos y = %f P2distx = %f P2disty =%f \n CHINNEN "
params = var(59), var(55), vel x , pos x, p2bodydist x
;-------------------------
[Statedef -3]
;意味：
;	相手のstateに飛ばされていない限り常時実行されるstate
;	※ＡＩ関連はこっちで組んだほうが良いです
;
;---------------------------------------------------------------------------
; ヒット数
[State -3, NumHit]
type = VarAdd
triggerall = StateNo != [3000,3110]
triggerall = stateno != [1000,1074]
trigger1 = var(14) = 1
trigger2 = ProjHitTime(1180) = 1
trigger3 = ProjHitTime(1210) = 1
trigger4 = ProjHitTime(1211) = 1
trigger5 = ProjHitTime(1212) = 1
trigger6 = ProjHitTime(1311) = 1
var(17) = 1
ignorehitpause = 1

[State -3, NumHit]
type = VarSet
trigger1 = P2MoveType != H
var(17) = 0
;---------------------------------------------------------------------------
; 友情パワー
[State -3, Friendship]
type = PowerAdd
triggerall = PalNo < 7
trigger1 = NumPartner
trigger1 = ctrl && StateType != A
trigger1 = !partner,Alive && !var(9)
value = 1000

[State 200, slide]
type = varadd
triggerall = PalNo >= 7
trigger1 = NumPartner
trigger1 = ctrl && StateType != A
trigger1 = !partner,Alive && !var(9)
trigger1 = var(55) < 1000
;trigger1 = MoveGuarded = 1
var(55) = 1*(1000-var(59))
persistent = 0
ignorehitpause  = 1

[State -3, Friendship]
type = VarSet
trigger1 = NumPartner
trigger1 = ctrl && StateType != A
trigger1 = !partner,Alive && !var(9)
var(9) = 1

[State -3, Friendship]
type = VarSet
trigger1 = RoundState < 2
var(9) = 0
;---------------------------------------------------------------------------
; 怒り爆発
[State -3, Burst]
type = ChangeState
triggerall = PalNo < 7
triggerall = floor(power / 1000) > var(58)
triggerall = RoundState < 3
trigger1 = StateType != A && ctrl
trigger2 = RoundState = 1 && (StateNo = 0 || StateNo = 5900)
value = 900

[State -3, Burst]
type = VarSet
triggerall = PalNo < 7
trigger1 = floor(power / 1000) < var(58)
var(58) = floor(power / 1000)

