; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "CHINNEN"        ;Name of character
displayname = "CHINNEN" ;Name of character to display
versiondate = 04,14,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "wara"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd	= chinnen.cmd   ;Command set
cns     = chinnen.cns   ;Constants
st     = chinnenN.cns
st0	= chinnenS.cns
st1	= chinnenH.cns   ;States
st2	= -2.cns   ;States
stcommon = common1.cns ;Common states
sprite  = chinnen.sff   ;Sprite
anim    = chinnen.air   ;Animation
sound   = chinnen.snd   ;Sound
pal1    = chinnen4.act  ;Palettes (can have up to 12)
pal2    = chinnen5.act
pal3    = chinnen6.act
pal4    = chinnen1.ACT
pal5    = chinnen2.act
pal6    = chinnen3.act
pal7    = chinnen4.act  ;Palettes (can have up to 12)
pal8    = chinnen5.act
pal9    = chinnen6.act
pal10    = chinnen1.ACT
pal11    = chinnen2.act
pal12    = chinnen3.act

; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def