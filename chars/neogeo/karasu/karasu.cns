movetype = I
physics = S

[State 100, 1]
type = ChangeAnim
trigger1 = Var(1) = 1
trigger1 = Time = 0
value = 10100

[State 100, 1]
type = ChangeAnim
trigger1 = Var(1) = 0
trigger1 = Time = 0
value = 100

[State 100, 2]
type = VelSet
trigger1 = Time = 0
X = 13

[State 100, 3]
