;【ブレイカーズリベンジ　ティア用エンディング】
;2005 1/4 公開
;2005 6/14 BGMを追加
;
;endtia.def と endtia.sff と ending.mp3 の
;３つのファイルをティアのフォルダに入れ、
;ティアのdefファイル（デフォルトはtia.def）に
;
;[Arcade]
;ending.storyboard = endtia.def
;
;と書き加えれば使用できます。『;』マークは削除してください。
;
;録音する環境ができたので今回はBGMつきです。
;BGMはコンドルと共用なので、コピーして使用してください。
;容量を節約したい方はendingフォルダ等にまとめて登録してください。
;
;素晴らしいキャラを製作してくれた、の。さんに感謝です。
;---------------------------------------------------------
[SceneDef]
spr = endtia.sff

[Scene 1]
clearcolor = 0,0,0
layerall.pos = 0,0
bgm = ending.mp3
bgm.loop = 1

fadein.time = 100
fadein.col = 0,0,0
fadeout.time = 100
fadeout.col = 0,0,0
layer0.anim = 2
layer0.offset = 40,224
layer1.anim = 1
layer1.offset = 0,0
end.time = 1066

[Scene 2]
fadeout.time = 100
fadeout.col = 0,0,0
layer0.anim = 3
layer0.offset = 0,0
end.time = 400

[Begin Action 1]
1, 1, 0,0, -1

[Begin Action 3]
1, 2, 0,0, -1

