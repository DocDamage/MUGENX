; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Tia"        ;Name of character
displayname = "Tia" ;Name of character to display
versiondate = 04,14,2002    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "Elecbyte"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = tiacmd.txt   ;Command set
cns     = tia.cns   ;Constants
st      = tia.cns   ;States
stcommon = common1.cns ;Common states
sprite  = tia.sff   ;Sprite
anim    = tia.air   ;Animation
sound   = tia.snd   ;Sound
pal1    = tia.act  ;Palettes (can have up to 12)
pal2    = tia2.act
pal3    = tia3.act
pal4    = tia4.act
pal5    = tia5.act
pal6    = tia6.act
pal7    = tia7.act  ;Palettes (can have up to 12)
pal8    = tia8.act
pal9    = tia9.act
pal10   = tia10.act
pal11   = tia11.act
pal12   = tia12.act
; Arcade mode
[Arcade]
ending.storyboard = endtia.def
