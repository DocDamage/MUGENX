; ここにキャラ情報を書いてください
[Info]
name = "Yuki"        ;キャラの名前
displayname = "Yuki" ;表示されるキャラの名前
versiondate = 11,22,2000    ;キャラの更新情報
mugenversion = 11,22,2000   ;キャラが動くmugenのバージョン
author = "ahuron"         ;キャラの製作者名
pal.defaults = 1      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = Yuki_nbc.cmd   ;キャラのコマンド
cns     = Yuki_nbc.cns   ;キャラのプログラム
st      = Yuki_nbc.cns   ;基本動作、必殺技、特殊ゲージ、-2、-3
st2     = Yuki_nbc2.cns  ;超必殺技
st3     = Yuki_nbc3.cns  ;通常動作
st4     = Yuki_nbc4.cns  ;アトミックガイ動作
stcommon = common1.cns 
sprite  = Yuki_nbc.sff   ;キャラの絵
anim    = Yuki_nbc.air   ;キャラの動き
sound   = Yuki_nbc.snd   ;キャラの音
pal1    = Yuki_nbc2.act
pal2    = Yuki_nbc2.act
pal3    = Yuki_nbc2.act
pal4    = Yuki_nbc.act
pal5    = Yuki_nbc.act
pal6    = Yuki_nbc.act