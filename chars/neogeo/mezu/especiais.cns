; giratória com talons
[Statedef 1200]
type = A
movetype= A 
physics = S 
poweradd= 100 
ctrl = 0
velset = 0
anim = 1200 
hitcountpersist = 1

[State 1200 , 0]
type = PlaySnd 
trigger1 = AnimElem = 1
value = 1,4 

[State 1200 , 0a]
type = PlaySnd 
trigger1 = AnimElem = 1
value = 3,1

[State 1200 , 1]
type = PlaySnd 
triggerall = p2stateno = [5000,5050]
trigger1 = hitcount = 1 && Time = 1 * TicksPerSecond
trigger2 = movehit = 1 && (GameTime%7)=0 
volume = -40
value = 1,2

[State 1200 , 2]
type = HitDef
trigger1 = time = 0 
trigger2 = hitcount = 1 && Animelem = 4
attr = S, SA
damage    = 30
guardflag = MA
pausetime = 20,5
sparkno = -1
hitsound   = 5,2
guardsound = 6,0
ground.type = High
ground.slidetime = 4
ground.hittime  = 25
ground.velocity = 2
ground.cornerpush.veloff = 0
air.velocity = 1,-0.5

[State 1200 , 2b]
type = HitDef
trigger1 = hitcount = 2 && Animelem = 4;(GameTime%7)=0 
attr = S, SA
damage    = 30
guardflag = MA
pausetime = 13,5
sparkno = -1
hitsound   = 5,2
guardsound = 6,0
ground.type = High
ground.slidetime = 5
ground.hittime  = 20
ground.velocity = -2, -2 
air.velocity = -2.5,-2
fall = 1
fall.recover = 0

[State 1200 , 3]
type = explod
trigger1 = AnimElem = 3
persistent = 0
anim = 912
pos = -10, 0       
postype = p1
sprpriority = 6

[State 1200 , 3a]
type = makedust
trigger1 = AnimElem = 1 
pos = 20, 0       
pos2 = -50, 0

[State 1200 , 4]
type = velset
trigger1 = time >= 38
x = 6.5

[State 1200 , 5]
type = velset
trigger1 = MoveHit
x = 0.9

[State 1200 , 5a]
type = explod
ID = 1234
trigger1 = HitCount = 1 && numexplod = 0 && p2stateno = [5000,5050]
trigger2 = Hitcount = 2 && numexplod = 0 && p2stateno = [5000,5050]
trigger3 = Hitcount = 3 && numexplod = 0 && p2stateno = [5000,5050]
anim = 920
pos = 0, -40       
postype = p2
sprpriority = 6

[State 1200 , 6]
type = ChangeState
trigger1 = HitCount = 3 
trigger2 = MoveGuarded
trigger3 = frontedgedist <= 5
trigger4 = time = 140 && movehit = 0
trigger5 = movehit = 1 && p2stateno != [5000,5050] 
value = 1300
ctrl = 0

