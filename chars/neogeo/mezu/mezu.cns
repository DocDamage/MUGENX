; RUN_FWD
[Statedef 101]
type    = A
physics = S
anim = 100
sprpriority = 1
ctrl = 0

[State 101, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 101, 1a]
type = VelSet
trigger1 = animelem = 1
y = -2

[State 101, 1b]
type = veladd
trigger1 = animelem = 2
y = 4

[State 101, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 101, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 101, 4]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 106

[State 101, 4b]
type = ChangeState
trigger1 = stateno = [5000,5030]
value = 50
