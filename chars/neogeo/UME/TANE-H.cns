;------------------------ エフェクト
[Statedef 3150]
type = A
movetype = A
physics = N
anim = IfElse((IsHelper(3150)=1),3150,3550)
ctrl = 0
velset = 10, 0
sprpriority = 3

[State -2,varset(1)]
type = VarSet
trigger1 = Time = 0
var(1) = 0
persistent = 0

[State -2,varset(23)]
type = Varadd
trigger1 = Root,var(23) >= 0
var(2) = 1
ignorehitpause = 1

[State -2,varset(1)]
type = VarSet
trigger1 = AnimElem = 14
var(1) = var(2)-9

[State 183, PlaySnd]
type = PlaySnd
trigger1 = Time = 0
value = 6,12

[State 9100, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[State 6010, 1]
type = AssertSpecial
trigger1 = gameTime % 2
flag = invisible

[State 5020, 2]
type = ChangeAnim
trigger1 = 1
value = Anim
elem = var(2)-Var(1)

[State 1005,end]
type = Destroyself
trigger1 = FrontEdgeDist < -30
trigger2 = BackEdgeDist < -30

