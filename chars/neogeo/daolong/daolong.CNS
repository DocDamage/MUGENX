; Lose (Time over)
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0,0

[State 170, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

[State 170, 10]
type = AssertSpecial
trigger1 = time = [0, 172]
flag = roundnotover
             
