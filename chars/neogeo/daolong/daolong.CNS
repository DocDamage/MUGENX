;---------------------------------------------------------------------------
; KO Flashes Controller
[Statedef 6060]
type    = S
movetype= I
physics = N
ctrl = 0
anim = 6000

; Gets a random angle in radians
[State 6060, 0]
type = VarSet
trigger1 = Time = 0
fv = 4
value = (Pi*(Random%360))/180

; Gets X component from the random angle (max. range of [-1, 1])
[State 6060, 1]
type = VarSet
trigger1 = Time = 0
fv = 2
value = 2*(Cos(FVar(4)))

; Gets Y component from the random angle (max. range of [-1, 1])
[State 6060, 2]
type = VarSet
trigger1 = Time = 0
fv = 3
value = Sin(FVar(4))

; Gets a random acceleration for the particle
[State 6060, 3]
type = VarSet
trigger1 = Time = 0
fv = 1
value = 13 ;(13+(Random % 3)) ;(1.5*10)/10 ;15/10 ;(13+2)/10 ;1.3 ;1.5 ;Random % 100

; X component of particle velocity
[State 6060, 4]
type = VarSet
trigger1 = Time = 0
fv = 5
value = FVar(2)*30

; Y component of particle velocity
[State 6060, 5]
type = VarSet
trigger1 = Time = 0
fv = 6
value = FVar(3)*30

[State 6060, 9]
type = VarSet
trigger1 = Time <= 15
fv = 2
value = (FVar(2)*FVar(1))/10

[State 6060, 10]
type = VarSet
trigger1 = Time <= 15
fv = 3
value = (FVar(3)*FVar(1))/10

[State 6060, 15]
type = Explod
trigger1 = Time <= 15
ownpal = 1
postype = back
pos = 160+Floor( FVar(5)+FVar(2) ), 120+Floor( FVar(6)+FVar(3) )
bindtime = 500
anim = 8060 + Time
ID = 8031
pausemovetime = 100
sprpriority = ifelse( Time<13, -2, 5 )
ignorehitpause = 1

[State 6060, Debug]
type = Null ;DisplayToClipboard
trigger1 = 1
text = "a:FVar(4) = %f    x:FVar(2) = %f    y:FVar(3) = %f    acc:FVar(1) = %f    "
params = FVar(4), FVar(2), FVar(3),  FVar(1)
ignorehitpause = 1

[State 6060, 20]
type = DestroySelf
trigger1 = Time > 15























;---------------------------------------------------------------------------
; Override common states (use same number to override) :

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 0]
type = AttackMulSet
trigger1 = Time = 0
value = 1

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
triggerall = PrevStateNo != 100
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 0]
type = PlaySnd
trigger1 = AnimTime = 0
value = 0, 0

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
triggerall = AnimTime = 0
trigger1 = prevstateno = 100
trigger2 = prevstateno = 101
x = ifelse(sysvar(1)=0, 1.5, ifelse(sysvar(1)=1, 4.75, -1.75 ))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno != 100
trigger1 = prevstateno != 101
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X = 1.5
value = 41

[State 50, 10]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

