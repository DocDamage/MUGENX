; Player information for Dao-Long ^_^
[Info]
name = "Dao-Long 100% by Inverse"
author = "Inverse"
displayname = "Dao-Long"
versiondate = 11,20,2001
mugenversion = 11,1,2001
pal.defaults = 4, 9, 3, 8

; Files for the player
[Files]
; By default, controls are set as in the original game (KOF style). If you
; prefer Capcom style controls, comment out the next line and uncomment the
; following one.
cmd     = daolong.cmd
;cmd     = daolo_2.cmd

cns     = daolong.cns
st      = daolong.cns
stcommon = common1.cns
sprite  = daolong.sff
anim    = daolong.air
sound   = daolong.snd
pal1    = dao3.act
pal2    = dao4.act
pal3    = dao6.act
pal4    = dao1.act
pal5    = dao2.act
pal6    = dao5.act
pal7    = dao8.act
pal8    = dao10.act
pal9    = dao12.act
pal10   = dao7.act
pal11   = dao9.act
pal12   = dao11.act

; Arcade mode
[Arcade]
intro.storyboard = intro.def
ending.storyboard = ending.def
