[State -2, HitAttack]
type = PlaySnd
triggerall = !HitFall
triggerall = Random < 200
triggerall = Time = 1
triggerall = life != 0
trigger1 = stateno = 5000
trigger1 = GetHitVar(groundtype) = 1
value = 11, 1
channel = 0

[State -2, HitAttack]
type = PlaySnd
triggerall = !HitFall
triggerall = Random < 200
triggerall = Time = 1
triggerall = life != 0
trigger1 = stateno = 5000
trigger1 = GetHitVar(groundtype) = 2
value = 11, 2
channel = 0

[State -2, HitAttack]
type = PlaySnd
triggerall = HitFall
triggerall = Random < 200
triggerall = Time = 1
triggerall = life != 0
trigger1 = stateno = 5000
value = 11, 3
channel = 0
