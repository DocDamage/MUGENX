;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -2,];虫取り用
type = DisplayToClipboard
trigger1 = 1
text = "sto=%d,h=%d,X=%d,Y=%d"
params = var(6),HitCount,floor(P2BodyDist X) , floor(P2BodyDist Y)
ignorehitpause = 1

[State -2, 1];コレで硬直回避できるのだろーか？
type = SelfState
trigger1 = P2StateNo = 4999 && P2movetype = H
value = 5000

[State -2, 7]
type = VarSet
trigger1 = p2dist x != 0
trigger1 = win = 1
var(5) = ceil(p2dist x)
ignorehitpause = 1

[State -2, 2]
type = ChangeState
triggerall = RoundState = 2
triggerall = statetype != A
triggerall = ctrl
trigger1 =  power >= 1000 && var(58) = 0
trigger2 =  power >= 2000 && var(58) = 1
trigger3 =  power = 3000 && var(58) = 2
value = 780

[State -2, 2]
type = ChangeState
triggerall = RoundNo != 1
triggerall = RoundState = 1
triggerall = statetype != A
;triggerall = ctrl
trigger1 =  power >= 1000 && var(58) = 0
trigger2 =  power >= 2000 && var(58) = 1
trigger3 =  power = 3000 && var(58) = 2
value = 780

[State 191, 2];トレーニング対策
type = varset
trigger1 =  power >= 3000
trigger1 = RoundNo = 1 && MatchNo = 1
v = 58
value = 3

[State -2, 10];スターダスト時間減少
type = Varadd
trigger1 = var(3) > 0
trigger1 = p2life != 0
V = 3
value = -1
ignorehitpause = 1

[State -2, 10];
type = Varset
trigger1 = var(3) > 0
trigger1 = wintime = 1
V = 3
value = 0
ignorehitpause = 1
;----------------------------------------------------------------
;相手変身中の処理。あー、この辺りの処理ややこしくて発狂しそうだ。
;air見ながら相手飛ばしたstateと下のExplodを組み合わせていかにゃなんねぇ
;----------------------------------------------------------------
[State -2, 1]
type = Varset
trigger1 = NumExplod(3500) = 0
V = 4
value = 0

[State -2, 1]
type = Varadd
triggerall = var(4) < 10
trigger1 = NumExplod(3500) = 1
V = 4
value = 1

[State -2, 8]
type = Explod
triggerall = NumExplod(3500) = 0
trigger1 = P2StateNo = 3500 && P2movetype = H && Enemy, Anim = 3600
trigger2 = P2StateNo = 3900 && P2movetype = H && Enemy, Anim = 3900
trigger3 = P2StateNo = 3901 && P2movetype = H && Enemy, Anim = 3900
Anim = 3999+(var(2)*100);-(p2stateno = 3901)
Id = 3500
Pos = 0,1
postype = p2
facing = 1
bindtime = -1
RemoveTime = 9999
sprpriority = -1
ownpal = 1
;scale = 1,1
ignorehitpause = 1
persistent = 0
ignorehitpause = 1

[State -2, 9]
type = RemoveExplod
trigger1 = p2stateno != 3500
trigger1 = p2stateno != 3900
trigger1 = p2stateno != 3901
ID = 3500
ignorehitpause = 1

[State -2, 7]
type = ModifyExplod
trigger1 = NumExplod(3500) = 1
trigger1 = var(4) = 0
ID = 3500
scale = 1,ifelse(Enemy,Anim = 3600,0,1)
;scaleにvar(4)/10;←この式使うと何故かうまくいかない

[State -2, 7]
type = ModifyExplod
trigger1 = NumExplod(3500) = 1
trigger1 = var(4) = 2
ID = 3500
scale = 1,ifelse(Enemy,Anim = 3600,0.2,0.8)

[State -2, 7]
type = ModifyExplod
trigger1 = NumExplod(3500) = 1
trigger1 = var(4) = 4
ID = 3500
scale = 1,ifelse(Enemy,Anim = 3600,0.4,0.6)

[State -2, 7]
type = ModifyExplod
trigger1 = NumExplod(3500) = 1
trigger1 = var(4) = 6
ID = 3500
scale = 1,ifelse(Enemy,Anim = 3600,0.6,0.4)

[State -2, 7]
type = ModifyExplod
trigger1 = NumExplod(3500) = 1
trigger1 = var(4) = 8
ID = 3500
scale = 1,ifelse(Enemy,Anim = 3600,0.8,0.2)

[State -2, 7]
type = ModifyExplod
trigger1 = NumExplod(3500) = 1
trigger1 = var(4) = 10
ID = 3500
scale = 1,ifelse(Enemy,Anim = 3600,1,0)



[State -2, 8]
type = Explod
trigger1 = P2StateNo = 3600 && P2movetype = I && Enemy, Anim = 3600 && NumExplod(3600) = 0
Anim = 4000+(var(2)*100)
Id = 3600
Pos = 0,1
postype = p2
facing = 1
bindtime = -1
RemoveTime = 9999
sprpriority = -1
ownpal = 1
ignorehitpause = 1
persistent = 0
;shadow = 128,128,128
;↑影がないと違和感あるけど、各ステージに設定されてる
;影の色を参照できない上、カンフー道場の床の映り込みの表示が変になる。
;よって、とりあえず影無しに。

