;コンビネーション食らってる相手
[Statedef 4500]
type    = A
movetype= H
physics = N
velset = 0,0

[State 4500,1]
type = Turn
trigger1 = Time >= 15
trigger1 = P2Dist X < 0

[State 4500, 1]
type = velset
Trigger1 = time >= 15
x = -1
y = 0

[State 4500, 1]
type = velset
Trigger1 = time >= 15
Trigger1 = pos y  > -20
y = -3

[State 4500, 1]
type = velset
Trigger1 = time >= 15
Trigger1 = pos y  < -24
y = 3

[State 4010,p2位置]
type = velSet
trigger1 = pos Y <= -20
trigger1 = pos Y > -24
y = 0

;5052の最後のパターンがフレーム数-1で終わってるキャラもいるので
;いちおう対応キャラの記述をしときます。
[State 4500, ChangeAnim]
type = ChangeAnim
triggerall = Time = 0 && Animexist(5052)
trigger1 = name = "alice" && authorname = "NHK"
trigger2 = name = "cassandra" && authorname = "H”"
trigger3 = name = "Annie" && authorname = "Nyankoro"
value = 5052

;アニメパターン8600にレイドラ用ぐるぐる食らいモーションが指定されてるキャラは
;defファイルに記載されてるキャラ名、制作者名を↓に記入すると
;コンビネーション発動時にぐるぐるします。するハズ。たぶん。
[State 4500, 1]
type = ChangeAnim2
triggerall = Time = 0 && Animexist(8600)
trigger1 = name = "Pupa Salgueiro" && authorname = "Nyan☆Kiryu"
trigger2 = name = "Lynn Baker" && authorname = "TARUSE"
trigger3 = name = "キャラ名" && authorname = "制作者名"
value = 8600

[State 4500, 2]
type = ChangeAnim2
trigger1 = Anim != 8600 && Anim != 5052
value = 4500

