trigger1 = AnimTime = 0
value = 106
;---------------------------------------------------------------------------
;バックステップ
[Statedef 106]
type = A
movetype = I
physics = N
anim = 106

[State 101, 1]
type = veladd
trigger1 = Time
y = .6

[State 106, 2]
type = velset
trigger1 = Time = 0
x = const(velocity.run.back.x)
y = const(velocity.run.back.y)

[State 106, 4]
type = ChangeState
trigger1 = Pos Y >= 0 && Vel Y > 0
value = 107
;---------------------------------------------------------------------------
;バックダッシュ終了
