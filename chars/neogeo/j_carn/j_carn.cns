;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, run forward sound1]
type = PlaySnd
trigger1 = time = 2
trigger1 = stateno = 170
value = 60, 3
channel = 1
loop = 1

[State -2, run forward sound2]
type = stopSnd
trigger1 = stateno != 170
channel = 1

[State -2, 13]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52
value = 40,0

[State -2, 13]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 50
value = 40,2

[state -2, 4]
type = playsnd
triggerall = Time = 1
trigger1 = stateno = 5100
value = 60,0

[State 5100, 0]
type = envshake
trigger1 = stateno = 5100
time = 8
ampl = 8
freq = 12

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0
