;---------------------------------------------------------------------------
; 鉄鋼将軍ブロッケン　キャラ情報
;---------------------------------------------------------------------------
[Info]
name = "BROCKEN"            ;キャラの名前
displayname = "BROCKEN"     ;表示されるキャラの名前
versiondate = 09,19,2001    ;キャラの更新情報
mugenversion = 04,14,2001   ;キャラが動くmugenのバージョン
author = "FUJY"             ;キャラの製作者名
pal.defaults = 3,5,2,4      ;敵としてでるキャラのパレット
;---------------------------------------------------------------------------
[Files]
cmd     = Brocken.cmd    ;キャラのコマンド
cns     = Brocken.cns    ;キャラのプログラム
st      = Brocken.cns    ;キャラのプログラム
st1     = Brocken-N.cns  ;通常攻撃・特殊攻撃・通常投げのステート
st2     = Brocken-S.cns  ;必殺技のステート
st3     = Brocken-H.cns  ;超必殺技のステート
st4     = Brocken-O.cns  ;ヘルパーのステート
stcommon = common1.cns 
sprite  = Brocken.sff    ;キャラの絵
anim    = Brocken.air    ;キャラの動き
sound   = Brocken.snd    ;キャラの音
pal1    = Brocken05.act  ;キャラの色
pal2    = Brocken02.act
pal3    = Brocken03.act
pal4    = Brocken04.act
;WHの1PカラーとしてBrocken01.actを用意しています。好みに応じて使って下さい。
;---------------------------------------------------------------------------