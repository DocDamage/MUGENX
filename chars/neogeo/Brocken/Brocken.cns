;---------------------------------------------------------------------------
;===========================================================================
; これは鉄鋼将軍 ブロッケンのＣＮＳファイルです。
;===========================================================================
;---------------------------------------------------------------------------
[Data]

life = 1000           ;体力ゲージの初期値
attack = 100          ;攻撃力（これ以上に設定すると強くなる）
defence = 100         ;防御力（これ以上に設定すると強くなる）
fall.defence_up = 50  ;コンボをくらっている時にあがる防御力
liedown.time = 60     ;倒れてから起上がるまでのフレーム数
airjuggle = 15        ;空中でどれだけコンボが繋がるか（高くすると無限コンボになるので注意）
sparkno = 2           ;hitdefで設定していない時の基本ヒットスパークナンバー
guard.sparkno = 40    ;設定してない時のガードナンバー
KO.echo = 0           ;KOした時に声にエコーをかけるか（１でＯＮ）
 volume = 0
  IntPersistIndex = 60
FloatPersistIndex = 40

[Size]

xscale = 1           ;水平方向の縮尺（通常１）
yscale = 1           ;垂直方向の縮尺（通常１）
ground.back = 15     ;キャラの幅(後方,地上)
ground.front = 16    ;キャラの幅(前方,地上)
air.back = 12        ;キャラの幅(後方,空中)
air.front = 12       ;キャラの幅(前方,空中)
height = 60          ;キャラの高さ
attack.dist = 160    ;攻撃をした時相手がガード体制に入る最低距離
proj.attack.dist = 90;攻撃をした時相手がガード体制に入る最低距離（飛び道具）
proj.doscale = 0     ;上で設定した縮尺を飛び道具にも適用するか（１でＯＮ）   
head.pos = -5, -90   ;頭の大体の座標
mid.pos = -5, -60    ;体の中心の大体の座標
shadowoffset = -1    ;影の垂直方向のオフセット
draw.offset = 0,0    ;使用しない

[Velocity]
walk.fwd  = 1.4           ;前進の速度
walk.back = -1.0          ;後退の速度
run.fwd  = 4.5, 0         ;前ダッシュの速度（ホップする時はyを-にする）
run.back = -4.5, 0   　   ;後ダッシュの速度（ホップする時はyを-にする）
jump.neu = 0,-8.4         ;垂直ジャンプの速度
jump.back = -2.55         ;後ジャンプの速度
jump.fwd = 2.5            ;前ジャンプの速度
runjump.back = -2.55,-8.1 ;後ダッシュしながらのジャンプ速度(オプション)
runjump.fwd = 4,-8.1      ;前ダッシュしながらのジャンプ速度(オプション)
airjump.neu = 0,-8.1      ;２段ジャンプ以降の垂直ジャンプの速度(オプション)
airjump.back = -2.55      ;２段ジャンプ以降の後ジャンプの速度(オプション)
airjump.fwd = 2.5         ;２段ジャンプ以降の前ジャンプの速度

[Movement]
airjump.num = 0       ;空中でジャンプする回数
airjump.height = 35   ;空中でジャンプする最低限の高さ
yaccel = .34          ;重力
stand.friction = .85  ;立ち状態の摩擦係数
crouch.friction = .82 ;屈み状態の摩擦係数

;---------------------------------------------------------------------------
; ステイトの解説
; [Statedef STATENO]
; type = ?      S/C/A/L  Ｓ：立ち/Ｃ：屈み/Ａ：空中/Ｌ：ダウン
; movetype = ?  I/A/H    Ｉ：通常状態/Ａ：攻撃状態/Ｈ：ダメージをくらってる状態
; physics = ?   S/C/A/N  Ｓ：立ち/Ｃ：屈み/Ａ：空中/Ｎ：無し
; juggle = ?             その攻撃に使うジャグル数

;---------------------------------------------------------------------------
;===========================================================================
; 通常動作（ダッシュ、挑発等）
;===========================================================================
;---------------------------------------------------------------------------
;前ダッシュ開始
[Statedef 100]
type = S
movetype = I
physics = S
anim = 100
ctrl = 0
velset = 0

[State 100, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 101
ctrl = 1

;---------------------------------------------------------------------------
;前ダッシュ
[Statedef 101]
type = S
movetype = I
physics = N
anim = 101

[State 101, 0]
type = PlaySnd
trigger1 = Time = 0
value = 2,6

[State 101, 1]
type = AssertSpecial
trigger1 = Time >= 0
flag = nowalk

[State 101, 2]
type = velset
trigger1 = Time = 0
x = const(velocity.run.fwd.x)

[State 101,3]
type = Width
trigger1 = (AnimElemTime (2) >= 0) && (AnimElemTime (7) < 0)
value = 5,0

[State 101, 4]
type = ChangeState
trigger1 = Time = 18 || command = "holdback"
value = 102

;---------------------------------------------------------------------------
;前ダッシュ終了
[Statedef 102]
type = S
movetype = I
physics = S
anim = 100
ctrl = 0

[State 102, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;後ダッシュ開始
[Statedef 105]
type = S
movetype = I
physics = S
anim = 100
ctrl = 0
velset = 0

[State 105, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 106

;---------------------------------------------------------------------------
;後ダッシュ
[Statedef 106]
type = S
movetype = I
physics = N
anim = 105
ctrl = 1

[State 106, 0]
type = PlaySnd
trigger1 = Time = 0
value = 2,6

[State 106, 1]
type = AssertSpecial
trigger1 = Time >= 0
flag = nowalk
flag2 = nostandguard
flag3 = nocrouchguard

[State 106, 2]
type = velset
trigger1 = Time = 0
x = const(velocity.run.back.x)

[State 106, 3]
type = ChangeState
trigger1 = Time = 12 || command = "holdfwd"
value = 107

;---------------------------------------------------------------------------
;後ダッシュ終了
[Statedef 107]
type = S
movetype = I
physics = S
anim = 100
ctrl = 0

[State 107, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; タイムオーバーで負けた時
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
;勝ちポーズ分岐
[Statedef 180]
type = S

;パーフェクト勝ち
[State 180, 2]
type = ChangeState
trigger1 = Life > 1000
value = 181

;通常の勝ち
[State 180, 3]
type = ChangeState
trigger1 = Life < 1000
value = 182
;---------------------------------------------------------------------------
;勝ちポーズ（パーフェクト）
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0

[State 181, 1]
type = PlaySnd
trigger1 = AnimElem = 5
value = 2,0
;---------------------------------------------------------------------------
;勝ちポーズ（通常）
[Statedef 182]
type = S
ctrl = 0
anim = 180
velset = 0

[State 182, 1]
type = PlaySnd
trigger1 = AnimElem = 3
value = 0,8
;---------------------------------------------------------------------------
; 開始前の動作
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 191, 1] 
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 191, 2] 
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, 3]
type = PlaySnd
trigger1 = AnimElem = 13
value = 2,0

[State 191, 4] 
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; 挑発（ジャーマンヘディング）
[Statedef 195]
type = S
ctrl = 0
anim = 195
velset = 0,0
movetype = A
physics = S
juggle  = 4
poweradd= 65
sprpriority = 2

[State 195, 1]
type = CtrlSet
trigger1 = Time = 40
value = 1

[State 210, 2]
type = HitDef
Trigger1 = Time = 0
attr = S, NA
animtype  = Medium
damage    = 10
guardflag = MA
pausetime = 12,12
sparkno = s6010
sparkxy = -10,-70
guard.sparkno = S6000
hitsound   = s0,8
guardsound = s1,6
ground.type = High               
ground.slidetime = 5            
ground.hittime  = 20             
ground.velocity = -1 ,-4           
airguard.velocity = -1,0     
air.type = High                  
air.velocity = -3,-1                                  
air.hittime = 20  
fall.animtype = Hard
fall = 1

[State 191, 3]
type = PlaySnd
trigger1 = AnimElem = 1
value = 1,0

[State 191, 3]
type = PlaySnd
trigger1 = AnimElem = 7
value = 2,8

[State 195, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;===========================================================================
; 通常投げ
;===========================================================================
;---------------------------------------------------------------------------
;超ジャーマンスープレックス・発動
;     
;     投げのステートは少し複雑ですが順序良くならべればなんてことありません。
;     700：投げの発生と失敗した時
;     710：投げが成功した時の自分の動き
;     720：投げが成功した瞬間の相手の状態
;     721：投げが成功した時の相手の飛んでいく状態
;     とこんな具合です、投げは自分の他に相手の分も記述しなくてはなりません

[Statedef 700]
type    = S
movetype= A
physics = S
juggle  = 0
velset = 0,0
ctrl = 0
anim = 700
sprpriority = 2

[State 700, 1]
type = HitDef
Trigger1 = Time = 0
attr = S, NT          ;ｓ：立ち　ｎ：通常　ｔ：投げ
hitflag = M-          ;コンボの途中から投げが入らないよう設定してある
priority = 1, Miss    ;１は優先順位が低いので技がでないかミスするという設定
sparkno = -1          ;-をつければスパークエフェクトは無い
sprpriority = 1       ;２Ｐより上にカンフーマンが表示される
p1stateno = 710       ;投げが成功した場合の移動する１Ｐのステート
p2stateno = 720       ;投げが成功した場合の移動する２Ｐのステート
fall = 1              ;落ちる力を２Ｐにかけるか

[State 700, 2]
type = ChangeState
Trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;超ジャーマンスープレックス・投げている自分
;     このステートでは相手を設定した場所に固定した後、相手を飛ばしています
;     ここで相手の動きを制御しているのはtype = TargetBindというステートです
;     これを一定時間事にやっていくと綺麗に投げ飛ばされているように見えます。
;     そしてここにはHitDefが無いのでダメージはtype = TargetLifeAddで、ダメージを減らしています

[Statedef 710]
type    = S
movetype= A
physics = N
anim = 710
poweradd = 60

[State 710, Grab Sound]
type = PlaySnd
trigger1 = AnimElem = 1
value = 1, 0

[State 710, Grab Sound]
type = PlaySnd
trigger1 = AnimElem = 2
value = 1, 1

[State 710, Bind 1]
type = TargetBind
trigger1 = AnimElem = 1
pos = 53, 0

[State 710, Bind 2]
type = TargetBind
trigger1 = AnimElem = 2
pos = -25, -101

[State 810, Bind 3]
type = TargetBind
trigger1 = AnimElem = 3
pos = 35, -130

[State 810, Bind 4]
type = TargetBind
trigger1 = AnimElem = 4
pos = 35, -181

[State 810, Bind 5]
type = TargetBind
trigger1 = AnimElem = 5
pos = 77, -183

[State 810, Bind 6]
type = TargetBind
trigger1 = AnimElem = 6
pos = 77, -166

[State 810, Bind 7]
type = TargetBind
trigger1 = AnimElem = 7
pos = 77, -117

[State 810, Bind 8]
type = TargetBind
trigger1 = AnimElem = 8
pos = 78, -11

[State 810, Hurt 11]
type = TargetLifeAdd
trigger1 = AnimElem = 8
value = -80

[State 810, Throw 11]
type = TargetState
trigger1 = AnimElem = 9
value = 721

[State 810, State End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;超ジャーマンスープレックス・投げられている相手
; 
;     ここは投げられた瞬間の相手のステートです
;     たいしたことは書いてありませんがtypeがAになっている事です。
;     相手が投げれて空中にいる事を設定して次の821ステートに移動します

[Statedef 720]
type    = A
movetype= H
physics = N
velset = 0,0

[State 820, 1]
type = ChangeAnim2
Trigger1 = Time = 0
value = 720

;---------------------------------------------------------------------------
;超ジャーマンスープレックス・相手の空中の状態
;     
;     これは投げられている相手の状態ととれる行動を設定しています
;     type = SelfStateは相手のリカバー状態を設定する物でこの状態ならこれ。
;     と言うように地上近く、空中、叩きつけられた時と３つ設定しています。

[Statedef 721]
type    = A
movetype= H
physics = N
velset = -3,0
poweradd = 40

[State 821, 1] ;これは重力これは毎フレーム事に0.4の力が加わります
type = VelAdd
Trigger1 = 1
y = .4

[State 930, 10]
type = velset
Trigger1 = Animtime = 0
x = 3
y = 2

[State 821, 4] 
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 5100 

