;---------------------------------------------------------------------------
; ここから下は-3のステートを書いてください、ここに書いたものはゲーム中
; に条件が成立すればいつでも開始するステートです。
;---------------------------------------------------------------------------

[Statedef -3]

;---------------------------------------------------------------------------
;立ちの放射能排出音
[State -3, Standing Sound]
type = PlaySnd
trigger1 = stateno = 0
trigger1 = AnimElem = 7
value = 2, 8

;---------------------------------------------------------------------------
;ジャンプ時のジェット噴射音
[State -3, Janping Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 50
value = 2, 6

;---------------------------------------------------------------------------
;着地音
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 
