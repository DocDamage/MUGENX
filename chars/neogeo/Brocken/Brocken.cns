trigger1 = Projguarded1000 = 0
trigger1 = numexplod(6060) = 0
anim = 6060
postype = p2
pos = -10,-45
bindtime = -1
sprpriority = 2
ownpal = 1

; 炎のエフェクト（真中の奥）
[State -2]
