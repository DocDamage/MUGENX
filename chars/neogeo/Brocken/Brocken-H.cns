type = HitDef
trigger1 = Time = 0
attr = S, HA
animtype  = Hard
damage    = 300,30
getpower  = 0
priority  = 6
guardflag = MA
pausetime = 15,15
sparkno = s6020
sparkxy = -10,-70
guard.sparkno = S6020
hitsound   = S2,7
guardsound = S2,7
ground.type = Low
ground.slidetime = 30
ground.hittime  = 30
ground.velocity = -30,-8
air.velocity = -30,-8
air.fall = 1
fall = 1
fall.animtype = Hard
fall.recover = 0
palfx.time = 75
palfx.add = 32,0,0
palfx.mul = 400,192,192

