trigger1 = AnimElem = 16,=0
value = 0,3
channel = 0

[State 191,1]
type = AssertSpecial
trigger1 = 1
flag = Intro
flag2 = nobardisplay

[State 191,4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

