;---------------------------------------------------------------------
; ダメージ時の特殊エフェクト消去
[State -2,AfterImageTime]
type = AfterImageTime
trigger1 = MoveType = H
time = 0

;---------------------------------------------------------------------
; 特殊ジャンプ管理
[State -2,VarSet]
type = VarSet
trigger1 = Command = "holddown"
var(11) = 5

[State -2,VarSet]
type = Varadd
trigger1 = Var(11) > 0 && StateNo != 40 && StateNo != 45 && Command != "holddown"
var(11) = -1

[State -2,VarSet]
type = VarSet
trigger1 = MoveType = H
var(11) = 0

;---------------------------------------------------------------------
; ２段ジャンプ管理
[State -2,VarSet]
type = VarSet
trigger1 = StateType = A && command != "holdup"
var(14) = 0

[State -2,VarSet]
type = VarSet
trigger1 = StateType != A
var(13) = 0

;---------------------------------------
; 超必KO演出
[State -3, KO Effect]
type = VarSet
trigger1 = RoundState < 3
var(18) = 0

[State -3, KO Effect]
type = VarSet
trigger1 = RoundState = 3
trigger1 = StateNo != [3000,3110]
var(18) = 1

[State -3, KO Effect]
type = Helper
triggerall = !var(18)
triggerall = RoundState = 3 && !NumHelper(6010)
trigger1 = StateNo = 3020 && AnimElem = 12,=1
trigger2 = MoveHit && AnimElem = 56,>=0
stateno = 6010
id = 6010
ignorehitpause = 1

[State -3, KO Effect]
type = AssertSpecial
trigger1 = RoundState = 2 && StateNo = [3000,3110]
trigger2 = NumHelper(6010)
flag = nokoslow
ignorehitpause = 1

;---------------------------------------------------------------------------
; 喰らい時パワー増加
[State -2, PowerAdd]
type = PowerAdd
trigger1 = (StateNo = 5000 || StateNo = 5020) && Time = 1
trigger1 = GetHitVar(animtype) = 0
value = 80

[State -2, PowerAdd]
type = PowerAdd
trigger1 = (StateNo = 5000 || StateNo = 5020) && Time = 1
trigger1 = GetHitVar(animtype) = 1
value = 100

[State -2, PowerAdd]
type = PowerAdd
trigger1 = (StateNo = 5000 || StateNo = 5020) && Time = 1
trigger1 = GetHitVar(animtype) >= 2
value = 130

[State -2, PowerAdd]
type = PowerAdd
trigger1 = MoveType = H && !var(19)
trigger1 = StateNo != [5000,6000)
trigger1 = StateNo != [120,155]
value = 130

[State -2, PowerAdd]
type = VarSet
trigger1 = MoveType = H && !var(19)
trigger1 = StateNo != [5000,6000)
trigger1 = StateNo != [120,155]
var(19) = 1

[State -2, PowerAdd]
type = VarSet
trigger1 = ctrl
var(19) = 0

;---------------------------------------------------------------------------
; 屈ごっつい浮かせ処理
[State -2, AirCombo]
type = AssertSpecial
trigger1 = PrevStateNo = 510
flag = nojugglecheck

;---------------------------------------------------------------------------
; トレーニングモード
; -アーケードモードの第1戦とVSモードで、ラウンド開始直後にF3を押して
; -パワーを満タンにすると暴発します。
[State -2, Training]
type = VarSet
trigger1 = !var(16)
trigger1 = ctrl
trigger2 = RoundNo > 1
var(16) = 1

[State -2, Training]
type = VarSet
trigger1 = !var(16)
trigger1 = Power >= 3000
trigger1 = RoundNo = 1 && MatchNo = 1 && NumPartner = 0 && NumEnemy = 1
var(16) = 2

[State -2, Training]
type = VarSet
trigger1 = var(16) = 2
var(15) = 3

;---------------------------------------------------------------------------
; States that are executed when in self's state file
;---------------------------------------------------------------------------
[Statedef -3]

;---------------------------------------------------------------------
; Sound Fix
[State -3,PlaySnd]
type = PlaySND
trigger1 = StateNo = 100 && (AnimElem = 2 || AnimElem = 5)
value = 1,0

[State 52, PlaySnd]
type = PlaySnd
trigger1 = Time = 1 && (StateNo = 52 || StateNo = 1005)
trigger2 = AnimElem = 5,=1 && StateNo = 105
value = 1,3

[State -2,PlaySnd]
type = PlaySnd
triggerall = Time = 1
trigger1 = StateNo = 200 || StateNo = 205
trigger2 = StateNo = 400 || StateNo = 600
value = 2, 0

[State -2,PlaySnd]
type = PlaySnd
triggerall = Time = 1
trigger1 = StateNo = 210 || StateNo = 215 || StateNo = 300
trigger2 = StateNo = 410 || StateNo = 610 || StateNo = 615
value = 2, 1

[State -2,PlaySnd]
type = PlaySnd
triggerall = Time = 1
trigger1 = StateNo = 230 || StateNo = 235
trigger2 = StateNo = 430 || StateNo = 630
value = 2, 2

[State -2,PlaySnd]
type = PlaySnd
triggerall = AnimElem = 2,=1
trigger1 = StateNo = 240 || StateNo = 245 || StateNo = 310
trigger2 = StateNo = 440 || StateNo = 640 || StateNo = 645
value = 2, 3

[State -2,PlaySnd]
type = PlaySnd
trigger1 = StateNo = 700 && AnimElem = 4,=1
trigger2 = StateNo = 710 && AnimElem = 2,=1
value = 2, 4

[State -2,PlaySnd]
type = PlaySnd
triggerall = !MoveType = H
trigger1 = StateNo = 210 && AnimElem = 1,=1
trigger2 = StateNo = 215 && AnimElem = 1,=1
trigger3 = StateNo = 410 && AnimElem = 1,=1
trigger4 = StateNo = 610 && AnimElem = 1,=1
trigger5 = StateNo = 615 && AnimElem = 2,=1
value = 0, 5
channel = 0

[State -2,PlaySnd]
type = PlaySnd
triggerall = !MoveType = H
trigger1 = (StateNo = 240 || StateNo = 241 || StateNo = 310) && AnimElem = 1,=1
trigger2 = (StateNo = 245 || StateNo = 246) && AnimElem = 1,=1
trigger3 = StateNo = 440 && AnimElem = 2,=1
trigger4 = StateNo = 640 && AnimElem = 1,=1
trigger5 = (StateNo = 645 || StateNo = 646) && AnimElem = 1,=1
value = 0, 6
channel = 0

[State -2,PlaySnd]
type = PlaySnd
triggerall = !MoveType = H
trigger1 = (StateNo = 500 || StateNo = 4500) && AnimElem = 2,=1
trigger2 = StateNo = 510 && AnimElem = 1,=1
trigger3 = StateNo = 700 && AnimElem = 4,=1
value = 0, 7
channel = 0

[State -2,PlaySnd]
type = PlaySnd
triggerall = Time = 1 && Alive && Random < 333
triggerall = StateNo = 5000 || StateNo = 5010
trigger1 = Anim = 5000 || Anim = 5010 || Anim = 5020
value = 5000, 0
channel = 0

[State -2,PlaySnd]
type = PlaySnd
triggerall = Time = 1 && Alive && Random < 333
triggerall = StateNo = 5000 || StateNo = 5010
trigger1 = Anim = 5001 || Anim = 5011 || Anim = 5021
trigger2 = Anim = 5002 || Anim = 5012 || Anim = 5022
value = 5000, 10
channel = 0

[State -2,PlaySnd]
type = PlaySND
triggerall = Alive && random < 500
trigger1 = StateNo = 5000 && Time = 1
trigger1 = GetHitVar(fall)
trigger2 = StateNo = 5020 && Time = 1
trigger3 = StateNo = 5071 && Time = 1
value = 5000, 20
channel = 0

;---------------------------------------------------------------------------
; 怒り爆発処理
[State -3, Burst]
type = ChangeState
triggerall = floor(power / 1000) > var(15)
triggerall = RoundState < 3
trigger1 = StateType != A && ctrl
trigger2 = RoundState = 1 && (StateNo = 0 || StateNo = 5900)
value = 4200

[State -3, Burst]
type = VarSet
trigger1 = floor(power / 1000) < var(15)
var(15) = floor(power / 1000)
