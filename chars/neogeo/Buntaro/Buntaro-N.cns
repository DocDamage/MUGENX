;	Var(38) : 

;	FVar(1) : 
;	FVar(2) : 
;	FVar(3) : 
;	FVar(4) : 
;---------------------------------------------------------------------

;---------------------------------------------------------------------
; 基本設定
[Data]
life = 1000          ; 体力ゲージ、上限値（デフォルト：1000）
attack = 100         ; 攻撃力（％）
defence = 100        ; 防御力（％）
fall.defence_up = 50 ; 空中コンボ修正率（％）
liedown.time = 15    ; ダウン時間
airjuggle = 10        ; 空中コンボ
sparkno = 2        ; 初期ヒットスパーク番号
guard.sparkno = 40 ; 初期ガードスパーク番号
KO.echo = 0          ; ＫＯボイスエコー（0:OFF、1:ON）
volume = 128          ; キャラボイスボリューム値

[Size]
xscale = 1           ; 水平サイズ倍率
yscale = 1           ; 垂直サイズ倍率
ground.back = 17     ; キャラ幅（地上、後ろ側）
ground.front = 17    ; キャラ幅（地上、前側）
air.back = 17        ; キャラ幅（空中、後ろ側）
air.front = 17       ; キャラ幅（空中、前側）
z.width = 10         ; キャラ幅（ｚ軸）
height = 30	     ; キャラの高さ（ジャンプで飛び越せる高さ）
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = 0,-95    ; 頭部座標
mid.pos = 0,-65     ; 体中心部座標
shadowoffset = 0     ; キャラの影・オフセット値

[Velocity]
walk.fwd  = 3.4		; 前進速度
walk.back = -3.4		; 後退速度
run.fwd  = 6.1, 0		; 前ダッシュ速度（y<0の場合、ホップステップ）
run.back = -7,0		; バックステップ速度（y=0の場合、走り）
jump.neu = 0,-9		; 垂直ジャンプ速度
jump.back = -3		; 後方ジャンプ速度
jump.fwd = 3			; 前方ジャンプ速度
runjump.back = -4.2,-9	; 後方ジャンプ速度（ダッシュ中）
runjump.fwd = 4.2,-9		; 前方ジャンプ速度（ダッシュ中）
airjump.neu = 0,0		; 空中垂直ジャンプ速度
airjump.back = 0,0		; 空中後方ジャンプ速度
airjump.fwd = 0,0		; 空中前方ジャンプ速度

[Movement]
airjump.num = 0       ; 空中ジャンプ回数
airjump.height = 35  ; 空中ジャンプ最低高度
yaccel = .49	        ; キャラ重力加速度
stand.friction = .85  ; 摩擦係数（立ち状態）
crouch.friction = .82 ; 摩擦係数（しゃがみ状態）

;===============================================================================
; Definition of the Basic Action
;===============================================================================

;-------------------------------------------------------------------------------
; ダッシュ
[Statedef 100]
type    = S
movetype = I
physics = N
anim = 100
ctrl = 0

[State 100,0]
type = VelSet
trigger1 = AnimElem = 2
x = Const(velocity.run.fwd.x)

[State 100,1]
type = ChangeState
trigger1 = Command != "holdfwd"
value = 101
ctrl = 0

[State 100,2]
type = ChangeState
trigger1 = Command = "holdupfwd"
value = 40

[State 1000, 3]
type = DefenceMulSet
trigger1 = 1
value = 1.2

[State 100,4]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

;------------------------ 停止
[Statedef 101]
type = S
movetype = I
physics = S
anim = 101
ctrl = 0

[State 100,0]
type = VelSet
trigger1 = Time = 7
x = 0

[State 1000, 1]
type = DefenceMulSet
trigger1 = 1
value = 1.2

[State 101,End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------
; バックステップ
;------------------------ 開始
[Statedef 105]
type = S
movetype = I
physics = N
anim = 105
ctrl = 0
velset = 0, 0

[State 105,VelSet]
type = VelSet
trigger1 = AnimElem = 2
x = Const(velocity.run.back.x)

[State 45, PlaySnd]
type = PlaySND
trigger1 = AnimElem = 2,=0
value = 1,1

[State 105, VelMul]
type = VelMul
trigger1 = AnimElem = 2, > 0
x = .95

[State 4150,0]
type = NotHitBy
trigger1 = AnimElem = 2, >= 0 && AnimElem = 5, < 0
value = SCA

[State 105,VelSet]
type = VelSet
trigger1 = AnimElem = 5
x = 0

[State 100,6]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 101,End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;===============================================================================
; Definition of the Win/Lose/Intro Pause
;===============================================================================

;-------------------------------------------------------------------------------
; 時間切れ負け
[Statedef 170]
type = S
ctrl = 0
anim = 175
velset = 0,0

[State 192,1]
type = AssertSpecial
trigger1 = 1
flag = nobardisplay

[State 170,3]
type = AssertSpecial
trigger1 = Time = [0,140]
flag = RoundNotOver

;-------------------------------------------------------------------------------
; 時間切れ引き分け
[Statedef 175]
type = S
ctrl = 0
velset = 0,0

[State 192,1]
type = AssertSpecial
trigger1 = 1
flag = nobardisplay

[State 175,2]
type = ChangeState
trigger1 = Time = 0
value = 170

;-------------------------------------------------------------------------------
; 勝利
[Statedef 180]
type = S

[State 180,VarSet]
type = VarSet
trigger1 = Time = 0
v = 14
value = Random

[State 192,1]
type = AssertSpecial
trigger1 = 1
flag = nobardisplay

[State 180,ChangeState]
type = ChangeState
triggerall = Time = 0
trigger1 = Command = "hold_y"
value = 182

[State 180,ChangeState]
type = ChangeState
triggerall = Time = 0
trigger1 = Command = "hold_a"
value = 181

[State 180,ChangeState]
type = ChangeState
trigger1 = Time = 1
value = IfElse((Random = [0,499]),181,182)

;-------------------------------------------------------------------------------
; 勝利１
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0,0

[State 192,1]
type = AssertSpecial
trigger1 = 1
flag = nobardisplay

[State -2,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1,=1
value = 0, 1

[State 181,3]
type = AssertSpecial
trigger1 = Time = [0,140]
flag = RoundNotOver

;-------------------------------------------------------------------------------
; 勝利２
[Statedef 182]
type = S
ctrl = 0
anim = 182
velset = 0,0,0

[State 192,1]
type = AssertSpecial
trigger1 = 1
flag = nobardisplay

[State -2,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 6,=1
value = 6, 1

[State 182,3]
type = AssertSpecial
trigger1 = Time = [0,90]
flag = RoundNotOver

;---------------------------------------------------------------------------
; プレイントロ
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190, ChangeState]
type = ChangeState
triggerall = Time = 0
trigger1 = P2Name = "Genryusai Maki" || P4Name = "Genryusai Maki"
value = 192

[State 180,ChangeState]
type = ChangeState
trigger1 = Time = 0
value = 191

