;	Var(7)	 : 
;	Var(8)	 : 
;	Var(10) : 
;	Var(11) : 特殊ジャンプフラグ
;	Var(12) : ジャンプ種類管理
;	Var(13) : ２段ジャンプ管理
;	Var(14) : ２段ジャンプ用上押しフラグ
;	Var(15) : 怒り爆発処理
;	Var(16) : トレーニングモード
;	Var(17) : 
;	Var(18) : 超必KO演出管理
;	Var(19) : 喰らい時パワー増加管理
;	Var(20) : 必殺技段階管理
;	Var(21) : カカツツーンキック追加攻撃管理
;	Var(22) : 
;	Var(23) : 
;	Var(24) : 
;	Var(25) : 
;	Var(26) : 
;	Var(27) : 
;	Var(28) : 
;	Var(29) : 
