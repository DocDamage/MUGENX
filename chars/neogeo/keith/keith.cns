type = PowerAdd
trigger1 = (StateNo = 5000 || StateNo = 5020) && Time = 1
trigger1 = GetHitVar(animtype) = 0
value = 80

[State -2, PowerAdd]
type = PowerAdd
trigger1 = (StateNo = 5000 || StateNo = 5020) && Time = 1
trigger1 = GetHitVar(animtype) = 1
value = 100

[State -2, PowerAdd]
type = PowerAdd
trigger1 = (StateNo = 5000 || StateNo = 5020) && Time = 1
trigger1 = GetHitVar(animtype) >= 2
value = 130

[State -2, PowerAdd]
type = PowerAdd
trigger1 = MoveType = H && !var(12)
trigger1 = StateNo != [5000,6000)
trigger1 = StateNo != [120,155]
