;---------------------------------------------------------------------------
; トレーニングモード
; -アーケードモードの第1戦とVSモードで、ラウンド開始直後にF3を押して
; -パワーを満タンにすると暴発します。
[State -2, Training]
type = VarSet
trigger1 = !var(9)
trigger1 = ctrl
trigger2 = RoundNo > 1
var(9) = 1

[State -2, Training]
type = VarSet
trigger1 = !var(9)
trigger1 = Power >= 3000
trigger1 = RoundNo = 1 && MatchNo = 1 && NumPartner = 0 && NumEnemy = 1
var(9) = 2

[State -2, Training]
type = VarSet
trigger1 = var(9) = 2
var(8) = 3
;---------------------------------------------------------------------------
; 攻撃力補正
; -パワーゲージ補正
[State -2, AttackFix]
type = VarSet
trigger1 = 1
fvar(1) = ifelse(var(8)=0||(StateNo=[3000,3010]),1.0,ifelse(var(8)=1,1.01,ifelse(var(8)=2,1.02,1.05)))

; -コンボ補正
[State -2, AttackFix]
type = VarSet
trigger1 = StateNo != [3000,3010]
fvar(1) = fvar(1)*(20-var(11))/20

[State -2, DefenceFix]
type = AttackMulSet
trigger1 = 1
value = fvar(1)
ignorehitpause = 1
;---------------------------------------------------------------------------
; 防御力補正
; -根性値
[State -2, DefenceFix]
type = VarSet
trigger1 = 1
fvar(2) = ifelse(Life < 150,0.9,ifelse(Life < 300,0.95,1.0))

; -カウンター
[State -2, DefenceFix]
type = VarSet
trigger1 = StateNo = [100,101]
fvar(2) = fvar(2)*1.2

; -ダブルカウンター
[State -2, DefenceFix]
type = VarSet
trigger1 = StateNo = [240,250]
trigger2 = StateNo = 1050
fvar(2) = fvar(2)*1.4

[State -2, DefenceFix]
type = DefenceMulSet
trigger1 = 1
value = fvar(2)
ignorehitpause = 1
