; ここにキャラ情報を書いてください
[Info]
name = "Izumo Ryoko"        ;キャラの名前
displayname = "Ryoko" ;表示されるキャラの名前
versiondate = 10,09,2001    ;キャラの更新情報
mugenversion = 04,14,2000   ;キャラが動くmugenのバージョン
author = "bad darkness"         ;キャラの製作者名
pal.defaults = 1      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = ryoko.cmd   ;キャラのコマンド
cns     = ryoko.cns   ;キャラのプログラム
st      = ryoko.cns   ;キャラのプログラム
stcommon = common1.cns 
sprite  = ryoko.sff   ;キャラの絵
anim    = ryoko.air   ;キャラの動き
sound   = ryoko.snd   ;キャラの音
pal1    = ryoko.act  ;キャラの色（最大１２個）