trigger1 = GetHitVar(AnimType) = [1, 2]  ; Medium and Hard strength hit
trigger2 = StateNo = 5010
trigger2 = GetHitVar(AnimType) = [1, 2]  ; Medium and Hard strength hit
trigger3 = StateNo = 5020
trigger3 = GetHitVar(AnimType) = 0       ; Light strength hit
