; Welcome to Elias's constants, my friend.
; By Inverse ^_^
;
; Please send any comments to:
; mr_santana@hotmail.com
; http://inverse.mgbr.net

; ** Variables summary **

; Var(0)  - Temporary variable (for one state).
; Var(4)  - Temporary variable (for one state).

; Var(1)  - Temporary variable (for commands).

; Var(5)  - Temporary variable (for combo issues).

; Var(2)  - First Impact Combo time counter.
; Var(3)  - First Impact Combo hit count.

; Var(6)  - Super Jump command time counter.

; Var(9)  - Counts number of ticks after a win by KO.
; Var(13) - Records the state Elias is when P2 is KOed (if Elias killed P2,
;           it shows with which move).
; Var(16) - Trigger for KO effects.

; FVar(26) - Damage multiplier (used to implement combo damage reduction).


[Data]
life = 1000          ;Amount of life to start with
attack = 100         ;100% attack power (more is stronger)
defence = 100        ;100% defensive power (more is stronger)
fall.defence_up = 50 ;Def goes up by 50% everytime player is hit on ground
liedown.time = 60    ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 15       ;Can do 15 points of juggling
sparkno = 2          ;Default spark number
guard.sparkno = 40   ;Default guard spark number
KO.echo = 0          ;1 to enable echo on KO
volume = 100         ;Volume offset (negative for softer)
IntPersistIndex = 60

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
head.pos = -8, -64
mid.pos = -3, -43
ground.back = 21     ;Player width (back, ground)
ground.front = 16    ;Player width (front, ground)
air.back = 21        ;Player width (back, air)
air.front = 16       ;Player width (front, air)
z.width = 3          ;Player width (into and out)
height = 60	     ;Height of player (for opponent to jump over)
attack.width = 33,33 ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   

[Velocity]
walk.fwd  = 3.25     ;Walk forward
walk.back = -2.5     ;Walk backward
run.fwd  = 6, 0    ;Run forward (x, y)  - if y<0, player will hop
run.back = -4.5,-3.8 ;Run backward (x, y) - if y=0, player will run
jump.neu = 0, -8.75    ;Neutral jumping velocity (x, y)
jump.back = -2.5     ;Jump back Speed (x, y)
jump.fwd = 3         ;Jump forward Speed (x, y)

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .43         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .85 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;
; ********************
; **  Elias states  **
; ********************
;

;---------------------------------------------------------------------------
; Running
[Statedef 100]
type    = S
physics = S
velset = 0,0
ctrl = 1
anim = 100

[State 100, 2]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 3]
type = PlaySnd
trigger1 = AnimElem = 1, = 1
trigger2 = AnimElem = 4, = 1
value = 20, 0

[State 100, 6] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 9]
type = VelSet
trigger1 = command != "holdfwd"
x = 0

[State 100, 10]
type = ChangeState
trigger1 = command != "holdfwd"
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; HOP_BACK (taking impulse)
[Statedef 105]
type    = S
physics = N
ctrl = 0
anim = 105

[State 105, 0]
type = PlaySnd
trigger1 = AnimElem = 2, = 1
value = 20, 2

[State 105, 1]
type = VelSet
trigger1 = AnimElem = 2
x = -6.5
y = 0

[State 105, 2]
type = VelMul
trigger1 = AnimElem = 2, >= 0
trigger1 = AnimElem = 4, < 0
x = 0.97

[State 105, 3]
type = VelMul
trigger1 = AnimElem = 4, >= 0
x = 0.92

[State 105, 9]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 105, 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; LOSE (Time over)
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0,0

[State 170, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

[State 170, 5]
type = PlaySnd
trigger1 = AnimElem = 1, = 1
value = 0, 3

;---------------------------------------------------------------------------
; DRAWGAME (Time over)
[Statedef 175]
type = S
ctrl = 0
anim = 175
velset = 0,0,0

[State 175, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

[State 175, 5]
type = PlaySnd
trigger1 = AnimElem = 1, = 1
value = 0, 3

;---------------------------------------------------------------------------
; WIN
[Statedef 180]
type = S
ctrl = 0
anim = 180
velset = 0,0,0

[State 180, 3]
type = ChangeState
trigger1 = MatchOver ;Random < 500
value = 182

[State 180, 4]
type = ChangeState
trigger1 = 1
value = 181

;---------------------------------------------------------------------------
; WIN POSE 1
[Statedef 181]
type = S
ctrl = 0
anim = 180
velset = 0,0,0

[State 181, 0]
type = AssertSpecial
trigger1 = Time = [0, 150]
flag = roundnotover

[State 181, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 100

;---------------------------------------------------------------------------
; WIN POSE 2
[Statedef 182]
type = S
ctrl = 0
anim = 181
velset = 0,0,0

[State 182, 0]
type = AssertSpecial
trigger1 = Time = [0, 180]
flag = roundnotover

[State 182, 1]
type = PlaySnd
trigger1 = AnimElem = 6, = 0
value = 0, 1

[State 182, 2]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 100

;---------------------------------------------------------------------------
; INTRO
[Statedef 191]
type = S
ctrl = 0
velset = 0,0,0

[State 191, 5]
type = ChangeState
trigger1 = Random < 500
value = 192

[State 191, 10]
type = ChangeState
trigger1 = 1
value = 193

; Intro 1 - Back to the camera
[Statedef 192]
type = S
ctrl = 0
anim = 190
velset = 0,0,0

[State 192, 0] ;Intro not yet over
type = AssertSpecial
trigger1 = 1
flag = intro

[State 192, 5]
type = PlaySnd
trigger1 = AnimElem = 1, = 5
value = 0, 0

[State 192, 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 0

; Intro 2 - Let Me Help You!
[Statedef 193]
type = S
ctrl = 0
anim = 191
velset = 0,0,0

[State 193, 0] ;Intro not yet over
type = AssertSpecial
trigger1 = Time = [0, 260]
flag = intro

[State 193, 5]
type = PlaySnd
trigger1 = AnimElem = 3, = 20
value = 0, 17

[State 193, 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 0

