;--------------------------------------------------------------
; JIMMY LEE'S CONSTANTS AND STATES FILE
; WRITTEN BY JIN KAZAMA
;--------------------------------------------------------------

[Data]
life = 1000          ;Amount of life to start with
attack = 85          ;100% attack power (more is stronger)
defence = 100        ;100% defensive power (more is stronger)
fall.defence_up = 50 ;Def goes up by 50% everytime player is hit on ground
liedown.time = 15    ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 10       ;Can do 10 points of juggling
sparkno = -1         ;Default spark number
guard.sparkno = -1   ;Default guard spark number
KO.echo = 0          ;1 to enable echo on KO
volume = 125         ;Volume offset (negative for softer)

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 16     ;Player width (back, ground)
ground.front = 16    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
height = 60          ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = -5, -90   ;Approximate position of head
mid.pos = -5, -60    ;Approximate position of midsection
shadowoffset = -2    ;Number of pixels to vertically offset the shadow
draw.offset = 0,-2   ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 3.2           ;Walk forward
walk.back = -2.8          ;Walk backward
run.fwd  = 6, 0           ;Run forward (x, y)
run.back = -7,0           ;Hop backward (x, y)
jump.neu = 0,-9.3         ;Neutral jumping velocity (x, y)
jump.back = -2.5          ;Jump back Speed (x, y)
jump.fwd = 3              ;Jump forward Speed (x, y)
runjump.back = -5,-9.3    ;Running jump speeds (opt)
runjump.fwd = 6,-9        ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.

[Movement]
airjump.num = 0       ;Number of air jumps allowed (opt)
airjump.height = 35   ;Minimum distance from ground before you can air jump (opt)
yaccel = .48918       ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...
;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = Time = 0
var(5) = 0

[State 40, 3]
type = VarSet
trigger1 = command = "longjump"
trigger2 = PrevStateno = 100 && command = "holdfwd"
var(5) = 1

[State 40, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 6]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 7]
type = PlaySnd
trigger1 = AnimTime = 0 && (Var(5) = 0 || (Var(5) && Sysvar(1) = 0))
value = 500,1

[State 40, 8]
type = PlaySnd
trigger1 = Var(5) && Sysvar(1) != 0 && AnimTime = 0 
value = 40,0

[State 40, 9]
type = AfterImageTime
trigger1 = time = 0
time = 0

[State 40, 10]
type = ChangeState
trigger1 = AnimTime = 0 && command != "holdup"
value = 950
ctrl = 1

[State 40, 11]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1
;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = VelSet
trigger1 = Time = 0 && Var(5)
x = IfElse(vel x = 0,0,IfElse(vel x < 0,-4,4))

[State 50, 3]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 4]
type = AfterImage
trigger1 = Time = 0 && Var(5) && Vel X != 0
time = 15
length = 7
trans = add1
palcontrast = 128,128,128
paladd = 0,0,0
palmul = 1,1,1
framegap = 2
timegap = 1
;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47

[State 52, 1]
type = VelSet
trigger1 = Time = 0
x = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, 4]
type = PlaySnd
trigger1 = time = 0
value = 52,0

[State 52, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
;---------------------------------------------------------------------------
; Short jump
[Statedef 950]
type = A
movetype = I
physics = A
anim = 950

[State 950, 1]
type = VelSet
trigger1 = Time = 0
x = IfElse(vel x = 0,0,IfElse(vel x < 0,-2.8,2.9))
y = -6.5

[State 950, 2]
type = VelSet
trigger1 = Time = 0 && Var(5)
x = IfElse(vel x = 0,0,IfElse(vel x < 0,-3.75,3.75))

[State 950, 3]
type = AfterImage
trigger1 = Time = 0 && Var(5) && Vel X != 0
time = 8
length = 7
trans = add1
palcontrast = 128,128,128
paladd = 0,0,0
palmul = 1,1,1
framegap = 2
timegap = 1

[State 950, 4]
type = ChangeState
trigger1 = Pos Y >= 0 && Vel Y > 0
value = 52
;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1

[State 100, 1]
type = PlaySnd
trigger1 = AnimElem = 3 || AnimElem = 7
channel = 1
persistent = 1
value = 100,0

[State 100, 2]
type = VelSet
trigger1 = time <= 3
x = 0

[State 100, 3]
type = VelSet
trigger1 = time > 3
x = const(velocity.run.fwd.x)

[State 100, 4]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 5]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 6]
type = ChangeState
trigger1 = command != "holdfwd"
value = 0
ctrl = 1
;---------------------------------------------------------------------------
; RUN_BACK1 (start)
[Statedef 105]
type    = S
physics = S
ctrl = 0
anim = 105

[State 105, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 105, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 105, 3]
type = ChangeState
trigger1 = animtime = 0
value = 106
ctrl = 1
;-------------------------------------------------------------------------
; RUN_BACK
[Statedef 106]
type    = S
physics = N
ctrl = 0
anim = 106
sprpriority = 1

[State 106, 1]
type = VelAdd
trigger1 = time % 3 = 2
x = 1

[State 106, 2]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.back.x)
y = const(velocity.run.back.y)

[State 106, 3]
type = PlaySnd
trigger1 = time = 1
value = 500,1

[State 106, 4]
type = ChangeState
trigger1 = time = 19
value = 107
;---------------------------------------------------------------------------
; RUN_BACK2 (end)
[Statedef 107]
type    = S
physics = S
ctrl = 0
anim = 107

[State 107, 1]
type = VelSet
trigger1 = Time = 0
x = 0
y = 0

[State 107, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 107, 3]
type = MakeDust
trigger1 = Time = 2
pos = -5,-2
spacing = 1

[State 107, 4]
type = ChangeState
trigger1 = Time = 7
value = 0
ctrl = 1
;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
VelSet = 0,0

[State 170, 1]
type = PlaySnd
trigger1 = AnimElem = 3
value = 170,0

[State 170, 2]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1
;---------------------------------------------------------------------------
; Win State decider
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = 1
value = 181
;---------------------------------------------------------------------------
; Win 1
[Statedef 181]
type = S
ctrl = 0
anim = 181
VelSet = 0,0

[State 181, 1]
type = AssertSpecial
trigger1 = Time = [0,120]
flag = RoundNotOver

[State 181, 2]
type = PlaySnd
trigger1 = AnimElem = 10
value = 190,0
channel = 0

[State 181, 3]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1
