[Statedef -2]

[State -2, Super Finish BG]
type = Explod
triggerall = var(9) = 0 && Numexplod(8000) = 0
trigger1 = winKO = 1
trigger1 = P2life = 0 && Life > 0
trigger1 = (Stateno = [3000,3500]) && movehit = 1
trigger1 = facing = -1
anim = 8000
removetime = -1
id = 8000
sprpriority = -5
pos = -30,-20 
postype = front
bindtime = -1
ignorehitpause = 1
ownpal = 1

