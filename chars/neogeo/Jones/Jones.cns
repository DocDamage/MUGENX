;---------------------------------------------------------------------------
; INICIO DO SALTO
;---------------------------------------------------------------------------
[Statedef 40]
type = S
movetype = I
physics = S
anim = 40
velset = 0, 0
ctrl = 0

[State 40, VarSet]
type = VarSet
trigger1 = Var(28) = 1
v = 26
value = 1

[State 40, VarSet]
type = VarSet
trigger1 = Time = 0
v = 27
value = 0

[State 40, VarSet]
type = VarSet
trigger1 = Command = "holdfwd"
v = 27
value = 1

[State 40, VarSet]
type = VarSet
trigger1 = Command = "holdback"
v = 27
value = -1

[State 40, VelSet]
type = VelSet
triggerall = AnimTime = 0
trigger1 = PrevStateNo != 100 && Var(26) = 0
trigger2 = PrevStateNo = 100 && Var(27) != 1
x = IfElse(Var(27) = 0,0,IfElse(Var(27) = -1,Const(velocity.jump.back.x),Const(velocity.jump.fwd.x)))
y = Const(velocity.jump.y)

[State 40, VelSet]
type = VelSet
triggerall = AnimTime = 0
trigger1 = PrevStateNo != 100 && Var(26) = 1
trigger2 = PrevStateNo = 100 && Var(27) = 1
x = IfElse(Var(27) = 0,0,IfElse(Var(27) = -1,Const(velocity.runjump.back.x),Const(velocity.runjump.fwd.x)))
y = Const(velocity.jump.y)

[State 40, VelSet]
type = VelSet
triggerall = AnimTime = 0
trigger1 = Command != "holdup"
y = -6.88

[State 40, VarSet]
type = VarSet
triggerall = AnimTime = 0
trigger1 = Command != "holdup"
v = 25
value = 1

[State 40, PlaySnd]
type = PlaySnd
trigger1 = AnimTime = 0
value = 1,4

[State 40, AfterImage]
type = AfterImage
trigger1 = Var(26) = 1 || (PrevStateNo = 100 && Var(27) = 1)
trigger1 = Var(27) != 0
trigger1 = AnimTime = 0
time = 16
length = 20
palbright = 40,40,40
palcontrast = 250,250,250
palpostbright = -80,-80,-80
timegap = 1
flamegap = 1
trans = add1

[State 4600, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

