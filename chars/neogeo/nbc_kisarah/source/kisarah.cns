; デモ 
	
; 170: 負け 
;-------------------
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170,AssertSpecial]
type = AssertSpecial
trigger1 = Time < 250
flag = roundnotover
 
; 180: 勝ちポーズ1 
;-------------------
[Statedef 180]
type = S
ctrl = 0
anim = 180
velset = 0,0

[State 180,AssertSpecial]
type = AssertSpecial
trigger1 = Time < 250
flag = roundnotover

[State 180,ChangeState]
type = ChangeState
trigger1 = time = 0 && random % 10 < 5
value = 181

[state 1005, 1]
type = PlaySnd
trigger1 = Time = 1
value = 30,27
channel = 0

[state 1005, 1]
type = PlaySnd
trigger1 = AnimElem = 11
value = 30,28
channel = 0

[state 1005, 1]
type = PlaySnd
trigger1 = AnimElem = 15
value = 30,34
channel = 0
 
