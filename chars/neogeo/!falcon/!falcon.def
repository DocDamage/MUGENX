; Definition file for Falcon
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Falcon by O ILUSIONISTA"        ;Name of character
displayname = "Falcon" ;Name of character to display
versiondate = 04,14,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "O ILUSIONISTA"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = falcon.cmd   ;Command set
cns     = falcon.cns   ;Constants
st      = falcon.cns   ;States
st1     = supers.cns
st2     = hypers.cns
st3     = helpers.cns
stcommon = common1.cns ;Common states
sprite  = falcon.sff   ;Sprite
anim    = falcon.air   ;Animation
sound   = falcon.snd   ;Sound
pal1    = falcon.act  ;Palettes (can have up to 12)
pal2    = falcon2.act
pal3    = falcon3.act
pal4    = falcon4.act
pal5    = falcon5.act
pal6    = falcon6.act

; Arcade mode
[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def