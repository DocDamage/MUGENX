;ヨハン　基本設定・通常技用ｃｎｓ
;---------------------------------------
;Var(41)	着地隙フラグ
;Var(49)	ダウン回避フラグ
;=======================================
;基本能力値
;========================================
[Data]
life = 1000
attack = 100
defence = 120
fall.defence_up = 50
liedown.time = 51
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 128
IntPersistIndex = 1,3
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 20
ground.front = 18
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -70
mid.pos = -5, -50
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3.5
walk.back = -2.8
run.fwd = 5,5
run.back = -5,0
jump.neu = 0,-9.0
jump.back = -2.4
jump.fwd = 2.4
run.jump.fwd = 3.9

[Movement]
airjump.num = 0
airjump.height = 28
yaccel = .45
stand.friction = .85
crouch.friction = .82

