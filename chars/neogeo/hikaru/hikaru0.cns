;---------------------------------------------------------------------
; 各種ジャンプ
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
velset = 0,0,0

[State 40, 1]
type = turn
trigger1 = time = 0 && P2dist X < 0

[State 40, 2]
type = VarSet
trigger1 = Time = 0
var(1) = 0

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(3) = 1

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(4) = 0

[State 40, 3]
type = VarSet
trigger1 = command = "holdfwd"
trigger1 = var(1) != 2
var(1) = 1

[State 40, 4]
type = VarSet
trigger1 = command = "holdback"
trigger1 = var(1) != -2
var(1) = -1

[State 40, 5]
type = VarSet
triggerall = Time = 0
triggerall = command = "holdfwd"
trigger1 = command = "longjump"
trigger2 = prevstateno = 100 ;RUN_FWD
var(1) = 2

[State 40, 6]
type = VarSet
trigger1 = Time = 0
trigger1 = command = "holdback"
trigger1 = command = "longjump"
var(1) = -2

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(2) = 0

[State 40, 5]
type = VarSet
trigger1 = command != "holdup"
var(2) = 1

[State 1007, AI]
type = AfterImage
trigger1 = prevstateno = 100
trigger1 = sysvar(1) = 1
time = 20
palmul = 1,1,1
palcontrast = 100,100,100
palbright = 0,0,0
PalAdd = 20,20,20
length = 15
framegap = 5
trans = none
sprpriority = 2

[State 40, 8]
type = ChangeState
triggerall = AnimTime = 0
trigger1 = var(1) != 0
trigger1 = var(1) != 1
trigger1 = var(1) != -1
trigger1 = command = "holdup"
trigger2 = command != "holdup"
trigger3 = var(20) = 1
trigger3 = p2stateno = 1031
value = 48

[State 40, 9]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(var(1)=0, const(velocity.jump.neu.x), ifelse(var(1)>0, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; ２段ジャンプスタート
[Statedef 45]
type    = A
physics = N
ctrl = 0
anim = 51
velset = 0,0

[State 40, 4]
type = NotHitBy
trigger1 = 1
value = SCA

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(4) = 1

[State 40, 2]
type = VarSet
trigger1 = Time = 0
sysvar(1) = ifelse(command = "holdfwd",1,ifelse(command = "holdback",-1,0))

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(2) = 0

[State 40, 5]
type = VarSet
trigger1 = command != "holdup"
var(2) = 1

[State 40, 6]; ジャンプ・小ジャンプX軸速度設定
type = VelSet
trigger1 = AnimTime = 0
trigger1 = var(1) = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))

[State 40, 7]; 中ジャンプ・大ジャンプX軸速度設定
type = VelSet
trigger1 = AnimTime = 0
trigger1 = var(1)
x = ifelse(sysvar(1)=0, 0, ifelse(sysvar(1)=1, 3.8, -3.3))

[State 40, 8]; ジャンプ・大ジャンプY軸速度設定
type = VelSet
trigger1 = AnimTime = 0
trigger1 = !var(2)
y = const(velocity.jump.y)

[State 40, 9]; 小ジャンプ・中ジャンプY軸速度設定
type = VelSet
trigger1 = AnimTime = 0
trigger1 = var(2)
y = -6

[State 45, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

