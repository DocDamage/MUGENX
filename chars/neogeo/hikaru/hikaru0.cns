;---------------------------------------------------------------------
; ここは-2のステートを書いてください、ヘルパー関係です
;---------------------------------------------------------------------
[Statedef -2]

; 2段ジャンプ関連
[State -2, Jump Flag]
type = VarSet
trigger1 = var(3)
trigger1 = StateType = A && command != "holdup"
var(3) = 0

[STate -2]
type=AfterImagetime
trigger1=Movetype=H
time=0

; クリップボード
[State -2, Clipboard]
type = DisplayToClipboard
trigger1 = 1
text = "vel(%f,%f)%d %d"
params = Vel X,Vel Y,var(3),RoundState
ignorehitpause = 1

;---------------------------------------------------------------------------
; 喰らい時パワー増加
[State -2, PowerAdd]
type = PowerAdd
trigger1 = (StateNo = 5000 || StateNo = 5010 || StateNo = 5020) && Time = 1
trigger1 = GetHitVar(animtype) = 0
value = 70

[State -2, PowerAdd]
type = PowerAdd
trigger1 = (StateNo = 5000 || StateNo = 5010 || StateNo = 5020) && Time = 1
trigger1 = GetHitVar(animtype) = 1
value = 90

[State -2, PowerAdd]
type = PowerAdd
trigger1 = (StateNo = 5000 || StateNo = 5010 || StateNo = 5020) && Time = 1
trigger1 = GetHitVar(animtype) >= 2
value = 110

[State -2, PowerAdd]
type = PowerAdd
trigger1 = MoveType = H && !var(12)
trigger1 = StateNo != [5000,6000)
trigger1 = StateNo != [120,155]
value = 100

[State -2, PowerAdd]
type = VarSet
trigger1 = MoveType = H && !var(12)
trigger1 = StateNo != [5000,6000)
trigger1 = StateNo != [120,155]
var(12) = 1

[State -2, PowerAdd]
type = VarSet
trigger1 = ctrl
var(12) = 0

;---------------------------------------------------------------------------
; トレーニングモード
; -アーケードモードの第1戦とVSモードで、ラウンド開始直後にF3を押して
; -パワーを満タンにすると暴発します。
[State -2, Training]
type = VarSet
trigger1 = !var(9)
trigger1 = ctrl
trigger2 = RoundNo > 1
var(9) = 1

[State -2, Training]
type = VarSet
trigger1 = !var(9)
trigger1 = Power >= 3000
trigger1 = RoundNo = 1 && MatchNo = 1 && NumPartner = 0 && NumEnemy = 1
var(9) = 2

[State -2, Training]
type = VarSet
trigger1 = var(9) = 2
var(8) = 3

;---------------------------------------------------------------------
; ここから下は-3のステートを書いてください、ここに書いたものはゲーム中
; に条件が成立すればいつでも開始するステートです。
;---------------------------------------------------------------------
[Statedef -3]

; 超必KO演出
[State -3, KO Effect]
type = VarSet
trigger1 = RoundState < 3
var(18) = 0

[State -3, KO Effect]
type = VarSet
trigger1 = RoundState = 3
trigger1 = StateNo != [3000,3445]
var(18) = 1

[State -3, KO Effect]
type = Helper
triggerall = !var(18)
triggerall = RoundState = 3 && !NumHelper(7700)
trigger1 = StateNo = [3001,3450]
trigger1 = P2Life = 0
;trigger1 = MoveHit
stateno = 7700
id = 7700
ignorehitpause = 1

[State -3, KO Effect]
type = AssertSpecial
trigger1 = RoundState = 2 && StateNo = [3000,3450]
trigger2 = NumHelper(7700)
flag = nokoslow
ignorehitpause = 1

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 40
trigger2 = stateno = 105
value = S0, 0
channel = 5

;---------------------------------------------------------------------
くらった時の声
[State -3, HitAttack]
type = PlaySnd
triggerall = random < 700
triggerall = Time = 0
trigger1 = stateno = 5000
trigger2 = stateno = 5001
trigger3 = stateno = 5010
trigger4 = stateno = 5011
trigger5 = stateno = 5020
trigger6 = stateno = 5021
trigger7 = stateno = 5080
value = S6,0 + (random %2)
channel = 0
lowpriority = 0

[State -3, HitAttack]
type = PlaySnd
triggerall = random < 700
triggerall = Time = 0
trigger1 = stateno = 5002
trigger2 = stateno = 5012
trigger3 = stateno = 5022
trigger4 = stateno = 5030
trigger5 = stateno = 5050
trigger6 = stateno = 5052
trigger7 = stateno = 5070
trigger8 = stateno = 3151
value = S6,1 
channel = 0
lowpriority = 0

;---------------------------------------------------------------------
[State -3, Burst]
type = VarSet
trigger1 = floor(power / 1000) < var(8)
var(8) = floor(power / 1000)

; 怒り爆発処理
[State -3, Burst]
type = ChangeState
triggerall = floor(power / 1000) > var(8)
triggerall = RoundState < 3
trigger1 = StateType != A && ctrl
;trigger2 = (StateNo = 0 || StateNo = 5900) 
;trigger3 = (StateNo = 130 || StateNo = 131)
trigger2 = var(20) != 1
trigger2 = RoundState = 1 && (StateNo = 0 || StateNo = 5900)
trigger3 = var(20) != 1
trigger3 = RoundState = 1 && (StateNo = 130 || StateNo = 131)
value = 700

