ctrl = 0
anim = 190
velset = 0,0

[State 192, 1] 
type = ChangeAnim ;애니메이션을 바꾼다.
trigger1 = RoundState = 0  ;0 : 화면이 페이드인 될 때(맨처음 라운드 시작시 화면 밝아지는 순간)
value = 190 ;스테이트 190(인트로)으로 변경

[State 192, 2] 
