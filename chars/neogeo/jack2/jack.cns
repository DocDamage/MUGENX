trigger1 = 1 ;이 명령어를 지속한다.
flag = Intro ;캐릭터가 인트로 중이므로 round 1 의 글짜가 아직 뜨지 않는다.
flag2 = nobardisplay ;라이프바 표시 x

[State 192, 3] 
type = ChangeState 
trigger1 = AnimTime = 0 
value = 0 ;스테이트 0(스탠딩)으로 변경

