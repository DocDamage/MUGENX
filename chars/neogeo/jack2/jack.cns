;---------------------------------------------------------------------------
; 타임 오버로 인한 패배
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy ;무적판정설정
trigger1 = 1
value = SCA ;모든 공격에 대해
time = 1

;---------------------------------------------------------------------------
; 승리 결정
[Statedef 180] 
type = S 

[State 180,0] 
type = VarRandom ;value 정수 값을 무작위로 결정
trigger1 = Time = 0 ;승리 판정 나자 마자
v = 1 
range = 0,50
 
[State 180,1] 
type = ChangeState 
trigger1 = Var(1) = [0,25]
value = 181 

[State 180,2] 
type = ChangeState 
trigger1 = Var(1) = [26,50] 
value = 182 

;---------------------------------------------------------------------------
; 승리 포즈 
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, 1]
type = NotHitBy ;무적판정설정
trigger1 = 1 ;true 값 (뭔지 모르겠다아.;)
value = SCA ;모든 공격에 무적
time = 1

[State 181, 2] 
type = AssertSpecial ;인트로의 스프라이트에 특수한 속성을 부여한다.
trigger1 = 1 ;이 명령어를 지속한다.
flag = nobardisplay ;라이프바 표시 x

[State 181, Snd 1]
type = PlaySnd ;소리 내기
trigger1 = time = 3  ;2프레임 부터
value = 40,14   ;40,14 의 소리를

;---------------------------------------------------------------------------
;승리 포즈 2
[Statedef 182]
