;---------------------------------------------------------------------------
;서서 약손
[Statedef 200]
type    = S           ;서 있으면서           
movetype= A           ;공격 타입에           
physics = S           ;물리 속성 역시 서 있을 때           
juggle  = 1           ;저글수치는 1           
velset = 0,0          ;속도는 없고           
ctrl = 0              ;수행 중에 움직임은 불가능           
anim = 200            ;anim 200을 air에서 수행
poweradd = 20         ;기 증가량은 20
sprpriority = 2       ;레이어 우선권은 2이므로 제일 앞

[State 200, 1]
type = HitDef ;공격 판정 옵션
trigger1 = AnimElem = 3 ;스프라이트가 3번째일 때 판정
attr = S, NA            ;서서 사용하는 기본기
damage = 23, 0          ;맞을 때는 23, 가드시에는 0 의 에너지가 달고
animtype = Light        ;맞은 상대방의 모습은 light
guardflag = MA          ;지상과 공중에서만 막을 수 있음
hitflag = MAF ;공격이 들어갈 수 있는 상대의 상태는 지상이거나 공중이거나 넘어지고 있는 상태이며
priority = 3, Hit                ;공격의 우선권은 3, 상대랑 같을 경우 명중
pausetime = 8, 10                 ;때린 후의 경직시간
sparkno = S6000                      ;맞는 스파크의 애니메이션 설정, 앞에 S 붙이면 자신것 사용
guard.sparkno = S6005
sparkxy = -10, -70               ;스파크의 위치 설정
hitsound = S50, 1                  ;히트시 나오는 소리 설정, 앞에 S 붙이면 자신것 사용
guardsound = S60, 1                ;가드시 나오는 소리 설정, 앞에 S 붙이면 자신것 사용
ground.type = High               ;맞은 상대방의 판정은 상단 판정
ground.slidetime = 4             ;맞은 상대가 밀려나는 시간
ground.hittime  = 10             ;상대가 맞는 동작을 취하는 시간
ground.velocity = -7             ;맞은 상대가 밀려나는 속도
airguard.velocity = -1.9,-.8     ;공중에서 가드한 상대의 속도
air.type = High                  ;공중에서 맞았을 때의 판정은 상단 판정
air.velocity = -1.4,-3           ;공중에서 맞았을 때 밀려나는 속도
air.hittime = 12                 ;공중에서 맞은 상대가 돌아서서 착지하기 까지의 시간

[State 200, Snd 1]
type = PlaySnd
trigger1 = Time = 1
value = 0, 0

[State 200, 2]
type = CtrlSet
trigger1 = Time = 7
value = 1

[State 200, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
