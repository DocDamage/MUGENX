;-------------------------------------------------------
; Stand 
[Statedef 0]
type = S
physics = S
sprpriority = 0
facep2 = 1

[State 0, 1]
type = ChangeAnim
trigger1 = (Anim != [0,2]) && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 1]
type = ChangeAnim
triggerall = time = 0
trigger1 = prevstateno = [200,399]
trigger2 = prevstateno = [1000,3990]
trigger3 = prevstateno = 192
value = 1
persistent = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0];GtFNg
type = Helper
triggerall = Roundstate <= 2
trigger1 = Anim = 0
trigger1 = AnimElem = 9
trigger1 = numhelper(196) = 0
stateno = 196
pos = 0,0
size.xscale = 1;10*ceil(const(size.xscale))
size.yscale = 1;10*ceil(const(size.yscale))
ownpal = 1
keyctrl = 0
id = 196

[State 0, 2]
type = destroyself
trigger1 = ishelper
