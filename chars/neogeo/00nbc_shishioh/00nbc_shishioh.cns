y = const(velocity.jump.y)-2

[State 40,5]
type = PlaySnd
trigger1 = AnimTime = 0
trigger2 = prevstateno = 100 && time = 3
value = 9,1

[State 41]
type = ChangeState
trigger1 =animTime=0&&command!="holdup"
trigger2 = prevstateno = 100 && time = 3 && command != "holdup"
value = 55
