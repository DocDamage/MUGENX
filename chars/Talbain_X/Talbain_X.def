

; Player information
[Info]
name = "Talbain_X"        ;Name of character
displayname = "Talbain_X" ;Name of character to display
versiondate = 09,22,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "Splode"         ;Character author name
pal.defaults = 9,10,1,2,3,8,11,4,6,12,7,5      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = Talbain.cmd   ;Command set
cns     = talbain.cns   ;Constants
st      = talbain.cns   ;States
stcommon = common1.cns ;Common states
sprite  = talbain.sff   ;Sprite
anim    = talbain.air   ;Animation
sound   = talbain.snd   ;Sound
pal1    = talbain.act  ;Palettes (can have up to 12)
pal2    = talbain6.act
pal3    = talbain5.act
pal4    = talbain4.act
pal5    = talbain3.act
pal6    = talbain2.act

; Arcade mode
[Arcade]
