projhitanim = 1021 ;　　　　　　　発射物が当たった時のアニメーションの指定
offset = 110, -56 ;　　　　　　　　　自分の軸から見た発射物の軸位置の初期位置
velocity = 2.5, 0 ;　　　　　　　　　発射物の速度
attr = S, SP ;　　　　　　　　　　　攻撃の特質「通常、必殺技発射物」
