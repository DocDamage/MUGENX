;剣心CNSふぁいる

;---------------------------------------------------------------------------
; キャラクター基準値の設定

[Data]
life = 1000          ;スタート時の体力総計
attack = 100         ;攻撃力パーセンテージ （多いほど強くなります Def:100%）
defence = 100        ;防御力パーセンテージ （多いほど強くなります Def:100%）
fall.defence_up = 50 ;ダウン時に攻撃された時に一時的に上がる防御力のパーセンテージ
liedown.time = 60    ;ダウンしてから起き上がるまでの時間
airjuggle = 15       ;ジャグリングポイント数
sparkno=2;ディフォルトのスパーク番号
guard.sparkno=00;ガード時のディフォルトスパーク番号
KO.echo = 0          ;1にするとKOされた時に声にエコーがかかります
volume = 0           ;ボリュームオフセット (negative for softer)
;---------------------------------------------------------------------------
; サイズ指定

[Size]
xscale = 1           ;水平方向の縮尺
yscale = 1           ;垂直方向の縮尺
ground.back = 13     ;キャラクターの幅（後方、地上）
ground.front = 19    ;キャラクターの幅（前方、地上）
air.back = 17        ;キャラクターの幅（後方、空中）
air.front = 14       ;キャラクターの幅（前方、空中）
z.width = 3          ;Player width (into and out)（現在使用されていないと思われます）
height = 60	     ;Height of player (for opponent to jump over)（不明）
attack.width = 4,4   ;Default attack width: back, front（現在使用されていないと思われます）
attack.dist = 160    ;攻撃時に相手がガード体勢に入る最低距離（最大320）
proj.attack.dist = 90 ;相手がガード体勢に入る発射物との最低距離（最大320） 
proj.doscale = 0     ;xscale, yscaleの設定が発射物にも有効かどうかの設定（1なら有効です）
head.pos = 10, -65   ;頭の大体の座標（BindToTarget使用時に必要です。）
mid.pos = -5, -44    ;体中心の大体の座標（BindToTarget使用時に必要です。）
shadowoffset = -6     ;影の垂直方向オフセット

[Movement]
airjump.num=2          ;空中ジャンプの回数 （オプション）
airjump.height=35      ;空中ジャンプに必要な最低限の高さ （オプション）
yaccel=0.43            ;垂直方向にかかる加速度（重力）
crouch.friction=0.82   ;立ち状態の摩擦係数
stand.friction=0.85    ;しゃがみ状態の摩擦係数

;---------------------------------------------------------------------------
; 移動速度の設定

[Velocity]
walk.fwd  = 2.5      ;前に歩く時の速度
walk.back = -2.4     ;後ろに歩く時の速度
run.fwd  = 7.2, 0    ;前に走る時の速度 (x, y) ホップさせる時は y を 0 以下にします
run.back = -4.5,-3.8 ;後ろに走る時の速度 (x, y) 走らせる時は y を 0 にします
jump.neu = 0,-9.5    ;ジャンプ時の垂直移動速度 (x, y)
jump.back = -3    ;後ろにジャンプした時の水平移動速度
jump.fwd = 3       ;前にジャンプした時の水平移動速度
runjump.back = -3,-9.5 ;後ろに走りながらのジャンプ時の速度指定 (オプション)
runjump.fwd = 4,-9.5      ;前に走りながらのジャンプ時の速度指定 (オプション)
;airjump.neu = 0,-8.1      ;空中ジャンプ時の垂直移動速度 (オプション)
;airjump.back = -2.55,-8.1 ;空中で後ろにジャンプした時の水平移動速度
;airjump.fwd = 2.5,-8.1    ;空中で前にジャンプした時の水平移動速度

;---------------------------------------------------------------------------
; [Statedef]の基本的な書き方
;
; [Statedef STATENO]
; type = ?      S/C/A/L  状態の設定（立ち/しゃがみ/空中/ダウン）
; movetype = ?  I/A/H    動作状態（何もしていない/攻撃/攻撃を受けている）
; physics = ?   S/C/A/N  物理的な状態（通常/しゃがみ/空中/特になし）
; juggle = ?             動作が必要とするエアージャッグルポイント
;
; [State STATENO, ?]     ? - 任意の番号
; type = ?

;---------------------------------------------------------------------------
; RUN_foward

[Statedef 100]
type    = S
physics = N
anim = 100
ctrl = 0

[State 100 , 1]
type = AfterImage
trigger1 = AnimElem = 2
time = 9

[State 100 , 1]
type = VelSet
trigger1 = Time >= 0
trigger1 = AnimElem = 2, < 0
x = 13

[State 100 , 2]
type = VelMul
trigger1 = AnimElem = 2, >= 0
x = .96

[State 100 , 3]
type = VelSet
trigger1 = Time >= 0
trigger1 = AnimElem = 3, < 0
x = 8

[State 100 , 4]
type = VelMul
trigger1 = AnimElem = 3, >= 0
x = .92

[State 100 , 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[State 100 , 6]
type = MakeDust
trigger1 = AnimElem = 3
pos = -25,-2
spacing = 1

[State 100 , 6]
type = MakeDust
trigger1 = AnimElem = 3, >= 0
pos = -15,-2

[State 100 , 7]
type = MakeDust
trigger1 = AnimElem = 3
pos =  9,-2
spacing = 1

[State 100 , 7]
type = MakeDust
trigger1 = AnimElem = 3, >= 0
pos = 14,-2

