pausetime = 0,9 ;　　　　　　　　　ヒット時の硬直時間（自分は0、相手は9）
sparkxy = 10, 0 ;　　　　　　　　　ヒット時のエフェクト表示位置
hitsound = 5,3 ;　　　　　　　　　ヒット時の効果音
