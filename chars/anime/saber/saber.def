[Info]
name = "saber"        ;キャラの名前
displayname = "saber" ;表示されるキャラの名前
versiondate = 11,22,2000    ;キャラの更新情報
mugenversion = 11,22,2000   ;キャラが動くmugenのバージョン
author = "kuri"         ;キャラの製作者名
pal.defaults = 1      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = saber.cmd   ;キャラのコマンド
st     = -2&-3_2.cns
st3     = common_saber.cns
st2     = saber.cns
st4     = DUST.cns
st5     = EX.cns
st6     = CHARGE.cns
st7     = EXLP.cns
st8     = EEE.cns
cns     = saber.cns   ;キャラのプログラム
sprite  = saber.sff   ;キャラの絵
anim    = saber.air   ;キャラの動き
sound   = saber.snd   ;キャラの音
pal1    = saber1p.act  ;キャラの色（最大１２個）
pal2    = saber2P.act
pal3    = saber3P.act
pal4    = saber4P.act
pal5    = saber5P.act
pal6    = saber6P.act
pal7    = saber7p.act
pal8    = saber8P.act
pal9    = saber9P.act
pal10    = saber10P.act
pal11    = saber11P.act
pal12    = saber12P.act
