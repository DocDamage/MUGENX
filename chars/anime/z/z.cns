trigger1 = Time = 0
x = 15 - BackEdgeBodyDist

[State 1047, Stop moving]
type = PosFreeze
trigger1 = 1
x = 1
y = 1

[State 1047, No scroll]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 0,1

[State 1047, Spark]
