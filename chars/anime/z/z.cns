;---------------------------------------------------------------------------
;Kung Fu Throw - Attempt
[Statedef 800]
type    = S
movetype= A
physics = S
juggle  = 0
velset = 0,0
ctrl = 0
anim = 800
sprpriority = 2

[State 800, 1]
type = HitDef
Trigger1 = Time = 0
attr = S, NT          ;Attributes: Standing, Normal Throw
hitflag = M-          ;Affect only ground people who are not being hit
priority = 1, Miss    ;Throw has low priority, must be miss or dodge type.
sparkno = -1          ;No spark
p1sprpriority = 1     ;Draw p1's sprite in front of p2
                      ;p2's sprite priority is set to 0 by default
p1facing = 1
p2facing = 1          ;Force p2 to face KFM
p1stateno = 810       ;On success, KFM changes to state 810
p2stateno = 820       ;If hit, p2 changes to state 820 in KFM's cns
guard.dist = 0        ;This prevents p2 from going into a guard state if close
palfx.time = 96
palfx.mul = 250, 200, 250
palfx.add = 170, 20, 250

[State 800, 2]
type = ChangeState
Trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;Kung Fu Throw - Throwing the opponent
[Statedef 810]
type    = S
movetype= A
physics = N
anim = 810+(frontedgedist <= 70)
poweradd = 60

[State 810, Holding fwd?]
type = VarSet
trigger1 = Time = 0
var(2) = command = "holdfwd"

[State 810, pos]
type = PosAdd
trigger1 = Time = 0 && var(2) = 1 && frontedgedist <= 70
x = frontedgedist-70

[State 810, Width 2-11]
type = Width
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(12) < 0
edge = 60,0

[State exp]
type = Explod
trigger1 = AnimElemTime(4) = 8 && numexplod(802) = 0
id = 802
anim = 135
facing = 1
pos = 50,-95
postype = p1
sprpriority = 3
bindtime = -1
supermovetime = 1000000
ownpal = 1
ignorehitpause = 1

[State 810, Grab Sound]
type = PlaySnd
trigger1 = AnimElem = 2
value = 1, 1

[State 810, Throw Sound]
type = PlaySnd
trigger1 = AnimElem = 7
value = 800, 0

[State 810, Bind 1]
type = TargetBind
trigger1 = AnimElemTime(8) < 0
pos = 60, 0

[State 810, Bind 2-4]
type = TargetBind
trigger1 = AnimElemTime(8) >= 0 && AnimElemTime(8) < 2
pos = 70,-10

[State 810, Bind 2-4]
type = TargetBind
trigger1 = AnimElemTime(8) >= 2 && AnimElemTime(8) < 4
pos = 80,-20

[State 810, Bind 5]
type = TargetBind
trigger1 = AnimElemTime(8) >= 4 && AnimElemTime(6) < 6
pos = 90,-30

[State 810, Bind 6]
type = TargetBind
trigger1 = AnimElemTime(8) >= 6 && AnimElemTime(7) < 8
pos = 100, -30

[State 810, Bind 7]
type = TargetBind
trigger1 = AnimElemTime(8) >= 8 && AnimElemTime(9) < 0
pos = 110, -20

[State 810, Bind 8]
type = TargetBind
trigger1 = AnimElemTime(9) >= 0 && AnimElemTime(10) < 0
pos = 120, -10

[State 810, Bind 9]
type = TargetBind
trigger1 = AnimElemTime(10) >= 0; && AnimElemTime(16) < 0
pos = 130, 0

[State 810, vel]
type = VelSet
trigger1 = anim = 811 && AnimElemTime(8) = 0
x = -5

[State 810, vel]
type = VelSet
trigger1 = anim = 811 && AnimElemTime(11) = 2
x = 0

[State 810, Hurt 11]
type = TargetLifeAdd
trigger1 = AnimElem = 15
value = -78

[State 810, State End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;Thrown by Kung Fu Throw
; (a custom gethit state)
[Statedef 820]
type    = S
movetype= H
physics = N
velset = 0,0

[State 820, 1]
type = ChangeAnim2
Trigger1 = Time = 0
value = 820

;In case attacker loses binding on player for any reason, this controller
;guarantees that the player will never get stuck in this thrown state.
[State 820, 2]
type = SelfState
trigger1 = AnimTime = 0
trigger2 = time = 5 && p2stateno != 810
value = 0
ctrl = 1

