;---------------------------------------------------------------------------
; Win pose 1 - Bow
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State var]
type = VarRandom
trigger1 = time = 0
v = 1
range = 8

[state 181,1]
type = AssertSpecial
trigger1 = time = [0,200]
flag = roundnotover

[State snd]
type = PlaySnd
trigger1 = AnimElem = 1
value = 3,7

[State snd]
type = PlaySnd
trigger1 = AnimElem = 16 && PalNo < 10
value = 5,6

[State snd]
type = PlaySnd
trigger1 = AnimElem = 1 && PalNo > 9 && var(1) > 4
value = 8,2

[State snd]
type = PlaySnd
trigger1 = AnimElem = 1 && PalNo > 9 && var(1) < 5
value = 8,4

;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 191]
type = S
ctrl = 0
anim = 1050
velset = 0,0

[State 191, 3]
type = ChangeState
trigger1 = Time = 0 && Roundno != 1
value = 0

[State 191, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 1050

[State snd]
type = PlaySnd
trigger1 = time = 1
value = 3,7

[State snd]
type = PlaySnd
trigger1 = time = 10 && PalNo > 9
value = 8, 0

[State 191, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, 3] ;Change to stand state when done
type = ChangeState
trigger1 = AnimTime = 0
value = 0

