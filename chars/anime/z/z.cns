; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = ChangeState
trigger1 = (command = "holduf" || command = "holdub") && command = "holdz" && var(5) > 0
value = 710

[State 20, 1]
type = ChangeState
trigger1 = (command = "holdf" || command = "holdb") && command = "holdz" && var(5) > 0
value = 705

[State 20, 1]
type = changestate
trigger1 = Time = 0 && command = "holdfwd" && command != "z"
value = 21

[State 20, 2]
type = changestate
trigger1 = Time = 0 && command = "holdback" && command != "z"
value = 23

