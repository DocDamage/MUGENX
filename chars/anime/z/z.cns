trigger1 = AnimElem = 2 || AnimElem = 3 || AnimElem = 4 || AnimElem = 5
trigger2 = AnimElem = 14 || AnimElem = 15 || AnimElem = 16 || AnimElem = 17
trigger3 = AnimElem = 18 || AnimElem = 19 || AnimElem = 20 || AnimElem = 21
trigger4 = AnimElem = 30 || AnimElem = 31 || AnimElem = 32 || AnimElem = 33
trigger5 = AnimElem = 34 || AnimElem = 35 || AnimElem = 36
trigger6 = AnimElem = 37 || AnimElem = 38 || AnimElem = 39
x = 4

[State Pos]
