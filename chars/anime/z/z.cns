;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = turn
trigger1 = Time = 0 && (enemynear,movetype != H) && (enemynear,facing = facing)

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 1]
type = ChangeState
trigger1 = (command = "holduf" || command = "holdub") && command = "holdz"
value = 710

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x)*(1+.3*(PalNo > 6)), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x)*(1+.3*(PalNo > 6)), const(velocity.jump.back.x)*(1+.3*(PalNo > 6))))
y = const(velocity.jump.y)*(1+.3*(PalNo > 6))

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1
;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State var]
type = varset
trigger1 = time = 0
var(6) = 0

[State var]
type = varset
trigger1 = var(6) = 0 && command = "holdz"
trigger1 = command = "holdf" || command = "holdb" || command = "holduf"
var(6) = ifelse(command = "holdf",2,ifelse(command = "holdb",3,4))

[State var]
type = varset
trigger1 = var(6) = 0 && command = "holdz"
trigger1 = command = "holdub" || command = "holddf" || command = "holddb"
var(6) = ifelse(command = "holdub",5,ifelse(command = "holddf",6,7))

[State var]
type = varset
trigger1 = var(6) = 0 && command = "holdz"
trigger1 = command = "holdd"
var(6) = 9

[State var]
type = varset
trigger1 = var(6) = 0 && command = "holdz"
trigger1 = command != "holdf" && command != "holdb" && command != "holduf" && command != "holdub" && command != "holddf" && command != "holddb" && command != "holdd"
var(6) = 8

[State 50, 4]
type = ChangeState
trigger1 = var(6) > 1
value = 720

;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47

[State 52, 1]
type = EnvShake
trigger1 = Time = 0
time = 10
freq = 70
ampl = -2

[State 52, 0]
type = turn
trigger1 = Time = 0 && (p2dist X < 0) && (EnemyNear,stateno != [5100,5120])

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time >= 3
trigger1 = command != "holdz"
value = 1

[State -3]
type = Explod
trigger1 = var(13) = 1
trigger1 = numexplod(86) = 0
id = 86
anim = 86+(var(5) = 1)+2*(var(5) = 2)+3*(var(5) = 3)+4*(var(5) = 4)
facing = 1
pos = 30,30
postype = left
sprpriority = -5
bindtime = -1
supermovetime = 1000000
ownpal = 1
ignorehitpause = 1

[State -3]
type = Explod
trigger1 = var(13) = 2
trigger1 = numexplod(86) = 0 && numexplod(80) = 0
id = 86
anim = 86+(var(5) = 1)+2*(var(5) = 2)+3*(var(5) = 3)+4*(var(5) = 4)
facing = -1
pos = -30,30
postype = right
sprpriority = -5
bindtime = -1
supermovetime = 1000000
ownpal = 1
ignorehitpause = 1

[State var]
type = varset
trigger1 = var(5) != 5
;trigger1 = command != "holdz"
var(5) = 5

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1

[State snd]
type = PlaySnd
trigger1 = AnimElem = 5
trigger2 = AnimElem = 14
value = 2,1

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)*(1+.3*(PalNo > 6))

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = command != "holdfwd"
value = 101

[Statedef 101]
type    = S
physics = S
anim = 101
sprpriority = 1

[State 101, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

[Statedef 102]
type    = S
physics = N
anim = 100
sprpriority = 1

[State snd]
type = PlaySnd
trigger1 = AnimElem = 5
trigger2 = AnimElem = 14
value = 2,1

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)*(1+.3*(PalNo > 6))

[State 100, 2]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = p2dist x < 100 && random < 400
value = 101

[State 100, 4]
type = ChangeState
trigger1 = p2dist x < 40
value = 101

;---------------------------------------------------------------------------
; RUN_BACK
[Statedef 105]
type    = S
physics = S
ctrl = 0
anim = 105
sprpriority = 1

[State 105, 1]
type = StateTypeSet
trigger1 = AnimElem = 4
statetype = A
physics = A

[State 105, 1]
type = VelSet
trigger1 = AnimElem = 4
x = const(velocity.run.back.x)*(1+.3*(PalNo > 6))
y = const(velocity.run.back.y)*(1+.3*(PalNo > 6))

[State 105, 2]
type = CtrlSet
trigger1 = AnimElem = 5
value = 1

[State 105, 3]
