trigger1 = AnimElem = 22 || AnimElem = 23 || AnimElem = 28 || AnimElem = 29
trigger2 = AnimElem = 6 || AnimElem = 7 || AnimElem = 12 || AnimElem = 13
x = 3

[State Pos]
type = PosAdd
trigger1 = AnimElem = 8 || AnimElem = 9 || AnimElem = 10 || AnimElem = 11
trigger2 = AnimElem = 24 || AnimElem = 25 || AnimElem = 26 || AnimElem = 27
x = 2

[State snd]
type = PlaySnd
trigger1 = AnimElem = 1
value = 2,0

[State snd]
type = PlaySnd
trigger1 = AnimElem = 9
trigger2 = AnimElem = 25
value = 2,1

[State 21, 1]
type = ChangeState
