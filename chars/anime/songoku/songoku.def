; Definition file for Iron Goku
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Songoku"
displayname = "Son Goku"
versiondate = 01,12,2004 ;Started
mugenversion = 04,01,2001
author = "CHOUJIN"
pal.defaults = 4,1,5,2,3,6

; Files for the player
[Files]
cmd      = files/goku.cmd        ;Other config
cns      = files/goku.cns        ;Constants
st       = files/goku.cns        ;States
st1      = files/attacks.cns        ;States
st2      = files/specials.cns       ;States
st3      = files/hypers.cns         ;States
stcommon = common1.cns           ;Common states
sprite   = files/goku.sff        ;Sprite
anim     = files/goku.air        ;Animation
sound    = sound/goku.snd        ;Sound
pal1     = pal/anime.act          ;Normal palette
pal2     = pal/manga.act          ;2nd palette
pal3     = pal/vegetto.act
pal4     = pal/goku.act
pal5     = pal/user.act
pal6     = pal/super.act
pal7     = pal/black.act
pal8     = pal/green.act
pal9     = pal/original2.act
pal10     = pal/white.act
pal11     = pal/purple.act
pal12     = pal/original.act

; Arcade mode
[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def