[Info]
name = "Songoku"
displayname = "Super Goku"
versiondate = 01,12,2004 ;Started
mugenversion = 04,01,2001
author = "CHOUJIN"
pal.defaults = 4,1,5,2,3,6

; Files for the player
[Files]
cmd      = goku.cmd        ;Other config
cns      = goku.cns        ;Constants
st       = goku.cns        ;States
st1      = attacks.cns     ;States
st2      = specials.cns    ;States
st3      = hypers.cns      ;States
st4      = misc.cns        ;States
stcommon = common1.cns     ;Common states
sprite   = goku.sff        ;Sprite
anim     = goku.air        ;Animation
sound    = goku.snd        ;Sound
pal1     = anime.act       ;Normal palette
pal2     = manga.act       ;2nd palette
pal3     = vegetto.act
pal4     = user.act
pal5     = goku.act
pal6     = gt.act

; Arcade mode
[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def