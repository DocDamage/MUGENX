;---------------------------------------------------------------------------
; RUN_BACK
[Statedef 100]
type    = A
physics = A
ctrl = 0
anim = 100

[State 100, 1]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.fwd.x)
y = const(velocity.run.fwd.y)

[State 100, 2]
type = CtrlSet
trigger1 = Time = 2
value = 1

[State 100, 3]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 101

;---------------------------------------------------------------------------
; RUN_FWD2 (land)
[Statedef 101]
type    = S
physics = S
ctrl = 0
anim = 47

[State 101, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 101, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 101, 3]
type = MakeDust
trigger1 = Time = 2
pos = -5,-2
spacing = 1

[State 101, 4]
type = ChangeState
trigger1 = Time = 7
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47

[State 52, 1] ;Turn if not facing opponent
type = Turn
trigger1 = Time = 0
trigger1 = p2dist X < -5

[State 52, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 4]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------

[Statedef -2]

; Play "uhhh" sound when hit
[State -2, 1]
type = VarRandom
trigger1 = stateno = 5000
trigger1 = Time = 1
v = 8

; Play "uhhh" sound when hit
[State -2, 1]
type = PlaySnd
triggerall = Time = 1
triggerall = var(8) < 500
trigger1 = stateno = 5001
trigger1 = anim != 5000 ;Not hit light
trigger1 = anim != 5010 ;Not hit light
trigger2 = stateno = 5040
trigger2 = random < 400
trigger3 = stateno = 5050
value = 10,0

; Play "uhhh2" sound when hit
[State -2, 1]
type = PlaySnd
triggerall = Time = 1
triggerall = var(8) >= 500
trigger1 = stateno = 5001
trigger1 = anim != 5000 ;Not hit light
trigger1 = anim != 5010 ;Not hit light
trigger2 = stateno = 5040
trigger2 = random < 400
trigger3 = stateno = 5050
value = 10,1

; falling sound
[State -2, 1]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 5100
trigger2 = stateno = 5105
trigger3 = stateno = 5110
value = 7,2

;---------------------------------
;HYPER_MODE_BLINKING (FULL_POWER)

[State -2, 2]
type = VarSet
trigger1 = Var(10) <= 0
v = 10
value = 10
ignorehitpause = 1

[State -2, 3]
type = VarAdd
trigger1 = Var(10) >= 0
v = 10
value = -1
ignorehitpause = 1

[State -2, 4]
type = PalFX
trigger1 = Var(10) >= 5
trigger1 = Var(2) >= 2
time = 2
add = 80, 60, 40
ignorehitpause = 1

[State -2, 5]
type = PalFX
trigger1 = Var(10) < 5
trigger1 = Var(2) >= 2
time = 2
add = 0, 0, 0
ignorehitpause = 1

;---------------------------------
;HYPER_MODE_POWER_SUB

[State -2, 8]
type = PowerAdd
trigger1 = Var(2) >= 2
value = -3
ignorehitpause = 1

;---------------------------------
;HYPER_MODE_OFF

[State -2, 9]
type = VarSet
trigger1 = power <= 0
trigger1 = Var(2) = 2
v = 2
value = 0

;---------------------------------
;POWER_FULL_LEFT
[State -2, 10]
type = Explod
triggerall = power = 3000
triggerall = numexplod(22) = 0
trigger1 = var(30) = 1
anim = 22222
id = 22
pos = -320, 180
postype = right
ontop = 1
ownpal = 1
removetime = 1000
bindtime = 1000

;POWER_FULL_RIGHT
[State -2, 11]
type = Explod
triggerall = power = 3000
triggerall = numexplod(22) = 0
trigger1 = var(30) = 2
anim = 22222
id = 22
pos = -50, 180
postype = right
ontop = 1
ownpal = 1
removetime = 1000
bindtime = 1000

;POWER_OFF
[State -2, 12]
type = RemoveExplod
trigger1 = power < 3000
trigger1 = numexplod(22) = 1
id = 22

;WAZA_POS?
[State -2, 13]
type = VarSet
trigger1 = var(30) = 0
trigger1 = Pos X < 0
v = 30
value = 1

[State -2, 12]
type = VarSet
trigger1 = var(30) = 0
trigger1 = Pos X >= 0
v = 30
value = 2



