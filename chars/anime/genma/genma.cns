trigger3 = time = 72
trigger4 = time = 92
trigger5 = time = 112
value = 10,1

[State 182, 1.5]
type = PlaySnd
trigger1 = time = 42
trigger2 = time = 62
trigger3 = time = 82
trigger4 = time = 102
value = 10,0

    [State 182, 2] 
    type = AssertSpecial
    trigger1 = Time = [0,160]
    flag = roundnotover

