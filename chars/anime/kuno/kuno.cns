value = 1

[State 52, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

[Statedef -2]

; Play "uhhh" sound when hit
[State -2, 1]
type = VarRandom
trigger1 = stateno = 5000
trigger1 = Time = 0
v = 8

; Play "uhhh" sound when hit
[State -2, 2]
type = PlaySnd
triggerall = alive = 1
triggerall = Time = 0
triggerall = stateno = 5000
trigger1 = var(8) < 200
value = 10,0

; Play "uhhh2" sound when hit
[State -2, 3]
type = PlaySnd
triggerall = alive = 1
triggerall = Time = 0
triggerall = stateno = 5000
trigger1 = var(8) > 700
value = 10,1
volume = -70

; falling sound
[State -2, 4]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 5100
trigger2 = stateno = 5105
trigger3 = stateno = 5110
value = 7,3

; YELLING!
[State -2, 5]
type = VarRandom
triggerall = Time = 1
trigger1 = stateno = 220
trigger2 = stateno = 230
trigger3 = stateno = 240
trigger4 = stateno = 420
trigger5 = stateno = 430
v = 10

; YELL#1
[State -2, 6]
type = PlaySnd
triggerall = Time = 1
triggerall = var(10) < 333
trigger1 = stateno = 220
trigger2 = stateno = 230
trigger3 = stateno = 240
trigger4 = stateno = 420
trigger5 = stateno = 430
value = 7,5

;---------------------------------
;BLINKING (FULL_POWER)
[State -2, 7]
type = VarSet
trigger1 = Var(5) <= 0
v = 5
value = 10
ignorehitpause = 1

[State -2, 8]
type = VarAdd
trigger1 = Var(10) >= 0
v = 5
value = -1
ignorehitpause = 1

[State -2, 9]
type = PalFX
trigger1 = Var(5) >= 5
trigger1 = power >= 3000
time = 2
add = 80, 60, 40
ignorehitpause = 1

[State -2, 10]
type = PalFX
trigger1 = Var(5) < 5
trigger1 = power >= 3000
time = 2
add = 0, 0, 0
ignorehitpause = 1

