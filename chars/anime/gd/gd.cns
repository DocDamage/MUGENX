type = S
movetype = I
physics = N
anim = 50
velset = 0,0
ctrl = 0

[State var]
type = varset
trigger1 = time = 0
var(7) = 1-2*(command != "holdf")

[State var]
type = VarAdd
trigger1 = Time = 0
var(5) = -1

[State 705, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 706

[Statedef 706]
type = A
movetype = I
physics = N
anim = 53+(var(7) = -1)
velset = 5-10*(var(7) = -1),0
ctrl = 0

[State snd]
