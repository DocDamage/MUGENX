var(6) = 1

[State 701, 5]
type = ChangeState
trigger1 = AnimTime = 0
trigger2 = var(6) = 1 && AnimElem = 7
trigger3 = var(6) = 1 && AnimElem = 13
trigger4 = var(6) = 1 && AnimElem = 19
trigger5 = var(6) = 1 && AnimElem = 25
trigger6 = var(6) = 1 && AnimElem = 31
trigger7 = var(5) = 0
value = 702

[State var]
type = VarAdd
trigger1 = AnimElem = 7 || AnimElem = 13 || AnimElem = 19 || AnimElem = 25
var(5) = -1

[Statedef 702]
type = A
movetype = I
physics = N
anim = 52
velset = 0,-3
ctrl = 0

[State var]
type = varset
trigger1 = time = 0
var(6) = 0

[State 702, 1]
type = VelSet
Trigger1 = AnimElem = 3
y = 0

[State var]
type = varset
trigger1 = var(6) = 0 && command = "holdz"
trigger1 = command = "holdf" || command = "holdb" || command = "holduf"
var(6) = ifelse(command = "holdf",2,ifelse(command = "holdb",3,4))

[State var]
type = varset
trigger1 = var(6) = 0 && command = "holdz"
trigger1 = command = "holdub" || command = "holddf" || command = "holddb"
var(6) = ifelse(command = "holdub",5,ifelse(command = "holddf",6,7))

[State var]
type = varset
trigger1 = var(6) = 0 && command = "holdz"
trigger1 = command = "holdd"
var(6) = 9

[State var]
type = varset
trigger1 = var(6) = 0 && command = "holdz"
trigger1 = command != "holdf" && command != "holdb" && command != "holduf" && command != "holdub" && command != "holddf" && command != "holddb" && command != "holdd"
