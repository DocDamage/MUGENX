; Gungul's constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

;var(4)=combo
;var(5)(6)(7)=boost
;var(8)=thruster mode
;var(9)=rising attack
;var(10)=stock
;var(11)=3100
;var(13)=facing
;var(14)=vulcan
;var(16)=clock up
;var(58)=MSgauge

[Data]
;Amount of life to start with
;体力ゲージの初期値
life = 1000
;attack power (more is stronger)
;攻撃ダメージ
attack = 100
;defensive power (more is stronger)
;体力パワー
defence = 100
;Percentage to increase defense everytime player is knocked down
fall.defence_up = 50
;Time which player lies down for, before getting up
liedown.time = 60
;Number of points for juggling
airjuggle = 15
;Default hit spark number for HitDefs
sparkno = 2
;Default guard spark number
guard.sparkno = 40
;1 to enable echo on KO
KO.echo = 0
;Volume offset (negative for softer)
volume = 0
;Variables with this index and above will not have their values
;reset to 0 between rounds or matches. There are 60 int variables,
;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
;If omitted, then it defaults to 60 and 40 for integer and float
;variables repectively, meaning that none are persistent, i.e. all
;are reset. If you want your variables to persist between matches,
;you need to override state 5900 from common1.cns.
IntPersistIndex = 58,59
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 15     ;Player width (back, ground)
ground.front = 19    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
height = 60          ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = -5, -90   ;Approximate position of head
mid.pos = -5, -60    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.4      ;Walk forward
walk.back = -2.2     ;Walk backward
run.fwd  = 4.6, 0    ;Run forward (x, y)
run.back = -5.5,-3.8 ;Hop backward (x, y)
jump.neu = 0,-8.4    ;Neutral jumping velocity (x, y)
jump.back = -2.55    ;Jump back Speed (x, y)
jump.fwd = 2.5       ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-8.1      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .44         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Variable usage:
; This is a record of the variables that KFM uses. Keeping a record of your
; variable usage helps you avoid careless mistakes later.
; var(1)  - Used in kfm.cmd for combo condition (updated every tick)
; var(2)  - Used in Kung Fu Throw (state 800) to remember if fwd was being
;           held (remembered from state 800 through state 810).


;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10

[State snd]
type = PlaySnd
trigger1 = AnimElem = 1
value = 2,0

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12

[State snd]
type = PlaySnd
trigger1 = AnimElem = 1
value = 2,0

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
;---------------------------------------------------------------------------

; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = ChangeState
trigger1 = (command = "holduf" || command = "holdub") && command = "holdz" && var(5) > 0
value = 710

[State 20, 1]
type = ChangeState
trigger1 = (command = "holdf" || command = "holdb") && command = "holdz" && var(5) > 0
value = 705

[State 20, 1]
type = changestate
trigger1 = Time = 0 && command = "holdfwd" && command != "z"
value = 21

[State 20, 2]
type = changestate
trigger1 = Time = 0 && command = "holdback" && command != "z"
value = 23

[Statedef 21]
type    = S
physics = N
anim = 20
sprpriority = 0
ctrl = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd" && animelemtime(20) < 0
x = 1;const(velocity.walk.fwd.x)

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd" && animelemtime(20) >= 0
x = 1.6;const(velocity.walk.fwd.x)

[State 21, 1]
type = ChangeState
trigger1 = (command = "holduf" || command = "holdub") && command = "z" && var(5) > 0
value = 710

[State 21, 1]
type = ChangeState
trigger1 = (command = "holdf" || command = "holdb") && command = "z" && var(5) > 0
value = 705

[State Pos]
type = PosAdd
trigger1 = AnimElem = 2 || AnimElem = 3 || AnimElem = 4 || AnimElem = 5
trigger2 = AnimElem = 14 || AnimElem = 15 || AnimElem = 16 || AnimElem = 17
trigger3 = AnimElem = 18 || AnimElem = 19 || AnimElem = 20 || AnimElem = 21
trigger4 = AnimElem = 30 || AnimElem = 31 || AnimElem = 32 || AnimElem = 33
trigger5 = AnimElem = 34 || AnimElem = 35 || AnimElem = 36
trigger6 = AnimElem = 37 || AnimElem = 38 || AnimElem = 39
x = 0

[State Pos]
type = PosAdd
trigger1 = AnimElem = 22 || AnimElem = 23 || AnimElem = 28 || AnimElem = 29
trigger2 = AnimElem = 6 || AnimElem = 7 || AnimElem = 12 || AnimElem = 13
x = 0;3

[State Pos]
type = PosAdd
trigger1 = AnimElem = 8 || AnimElem = 9 || AnimElem = 10 || AnimElem = 11
trigger2 = AnimElem = 24 || AnimElem = 25 || AnimElem = 26 || AnimElem = 27
x = 0;2

[State snd]
type = PlaySnd
trigger1 = AnimElem = 1
value = 2,0

[State snd]
type = PlaySnd
trigger1 = AnimElem = 19
trigger2 = AnimElem = 37
trigger3 = AnimElem = 54
value = 2,1

[State 21, 1]
type = ChangeState
trigger1 = command = "FF"
value = 100
ctrl = 1

[State 21, 1]
type = ChangeState
trigger1 = command = "BB"
value = 105
ctrl = 1

[State 21, 1]
type = ChangeState
trigger1 = command = "z" && var(5) > 0
value = 700

[State 21, 1]
type = ChangeState
trigger1 = command = "holdup" && command != "holdz"
value = 40

[State 21, 1]
type = ChangeState
trigger1 = command = "holddown"
value = 10
ctrl = 1

[State 21, 2]
type = ChangeState
trigger1 = command = "holdb" && command != "z"
value = 23

[State 21, 2]
type = ChangeState
trigger1 = AnimElemTime(19) = 1 && command != "holdf" && command != "z"
trigger2 = AnimElemTime(54) = 1 && command != "holdf" && command != "z"
value = 22

[Statedef 22]
type    = S
physics = S
anim = 22
sprpriority = 0

[State 22, 1]
type = PosAdd
trigger1 = AnimElem = 1 || AnimElem = 2 || AnimElem = 3
value = 2

[State 22, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[Statedef 23]
type    = S
physics = N
anim = 21
sprpriority = 0
ctrl = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdback" && animelemtime(20) < 0
x = -1;const(velocity.walk.fwd.x)

[State 20, 1]
type = VelSet
trigger1 = command = "holdback" && animelemtime(20) >= 0
x = -1.6;const(velocity.walk.fwd.x)

[State snd]
type = PlaySnd
trigger1 = AnimElem = 1
value = 2,0

[State snd]
type = PlaySnd
trigger1 = AnimElem = 13
trigger2 = AnimElem = 31
trigger3 = AnimElem = 50
value = 2,1

[State 23, 1]
type = ChangeState
trigger1 = (command = "holduf" || command = "holdub") && command = "z"
value = 710

[State 23, 1]
type = ChangeState
trigger1 = (command = "holdf" || command = "holdb") && command = "z"
value = 705

[State Pos]
type = PosAdd
trigger1 = AnimElem = 3 || AnimElem = 4 || AnimElem = 5
trigger2 = AnimElem = 6 || AnimElem = 7 || AnimElem = 8
trigger3 = AnimElem = 17 || AnimElem = 18 || AnimElem = 19
trigger4 = AnimElem = 37 || AnimElem = 38 || AnimElem = 41 || AnimElem = 42
x = 0;-4

[State Pos]
type = PosAdd
trigger1 = AnimElem = 9 || AnimElem = 10 || AnimElem = 11
trigger2 = AnimElem = 12 || AnimElem = 13 || AnimElem = 14
trigger3 = AnimElem = 15 || AnimElem = 16
trigger4 = AnimElem = 20 || AnimElem = 21 || AnimElem = 22 || AnimElem = 23
trigger5 = AnimElem = 31 || AnimElem = 32 || AnimElem = 33
trigger6 = AnimElem = 34 || AnimElem = 35 || AnimElem = 36
trigger7 = AnimElem = 39 || AnimElem = 40 || AnimElem = 43 || AnimElem = 44
x = 0;-2

[State 23, 1]
type = ChangeState
trigger1 = command = "FF"
value = 100
ctrl = 1

[State 23, 1]
type = ChangeState
trigger1 = command = "BB"
value = 105
ctrl = 1

[State 23, 1]
type = ChangeState
trigger1 = numenemy > 0
trigger1 = enemy,movetype = A && command != "z"
trigger1 = command = "holdback" && InGuardDist
value = 120

[State 23, 1]
type = ChangeState
trigger1 = command = "z"
value = 700

[State 23, 1]
type = ChangeState
trigger1 = command = "holdup" && command != "z"
value = 40

[State 23, 1]
type = ChangeState
trigger1 = command = "holddown"
value = 10
ctrl = 1

[State 23, 2]
type = ChangeState
trigger1 = command = "holdf" && command != "z"
value = 21

[State 23, 2]
type = ChangeState
trigger1 = AnimElemTime(14) = 1 && command != "holdb" && command != "z"
trigger2 = AnimElemTime(50) = 1 && command != "holdb" && command != "z"
value = 24

[Statedef 24]
type    = S
physics = S
anim = 25
sprpriority = 0

[State 22, 1]
type = PosAdd
trigger1 = AnimElem = 2
value = -2

[State 22, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = turn
trigger1 = Time = 0 && (enemynear,movetype != H) && (enemynear,facing = facing)

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 1]
type = ChangeState
trigger1 = (command = "holduf" || command = "holdub") && command = "holdz"
value = 710

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1
;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State var]
type = varset
trigger1 = time = 0
var(6) = 0

[State var]
type = varset
trigger1 = var(6) = 0 && command = "holdz"
trigger1 = command = "holdf" || command = "holdb" || command = "holduf"
var(6) = ifelse(command = "holdf",2,ifelse(command = "holdb",3,4))

[State var]
type = varset
trigger1 = var(6) = 0 && command = "holdz"
trigger1 = command = "holdub" || command = "holddf" || command = "holddb"
var(6) = ifelse(command = "holdub",5,ifelse(command = "holddf",6,7))

[State var]
type = varset
trigger1 = var(6) = 0 && command = "holdz"
trigger1 = command = "holdd"
var(6) = 9

[State var]
type = varset
trigger1 = var(6) = 0 && command = "holdz"
trigger1 = command != "holdf" && command != "holdb" && command != "holduf" && command != "holdub" && command != "holddf" && command != "holddb" && command != "holdd"
var(6) = 8

[State 50, 4]
type = ChangeState
trigger1 = var(6) > 1
value = 720

;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47

[State 52, 1]
type = EnvShake
trigger1 = Time = 0
time = 10
freq = 70
ampl = -2

[State 52, 0]
type = turn
trigger1 = Time = 0 && p2dist X < 0 && (EnemyNear,stateno != [5100,5120])

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time >= 3
trigger1 = command != "holdz"
value = 1

[State -3]
type = Explod
trigger1 = var(13) = 1
trigger1 = numexplod(86) = 0
id = 86
anim = 86+(var(5) = 1)+2*(var(5) = 2)+3*(var(5) = 3)+4*(var(5) = 4)
facing = 1
pos = 30,30
postype = left
sprpriority = -5
bindtime = -1
supermovetime = 1000000
ownpal = 1
ignorehitpause = 1

[State -3]
type = Explod
trigger1 = var(13) = 2
trigger1 = numexplod(86) = 0
id = 86
anim = 86+(var(5) = 1)+2*(var(5) = 2)+3*(var(5) = 3)+4*(var(5) = 4)
facing = -1
pos = -30,30
postype = right
sprpriority = -5
bindtime = -1
supermovetime = 1000000
ownpal = 1
ignorehitpause = 1

[State var]
type = varset
trigger1 = var(5) != 5
var(5) = 5

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1

[State snd]
type = PlaySnd
trigger1 = AnimElem = 7 || AnimElem = 16 || AnimElem = 25 || AnimElem = 35
value = 2,1

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = command != "holdfwd"
value = 101

[Statedef 101]
type    = S
physics = S
anim = 101
sprpriority = 1

[State 101, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; RUN_BACK
[Statedef 105]
type    = S
physics = S
ctrl = 0
anim = 105
sprpriority = 1

[State 105, 1]
type = StateTypeSet
trigger1 = AnimElemTime(8) = 0
statetype = A
physics = A

[State 105, 1]
type = VelSet
trigger1 = AnimElemTime(8) = 0
x = const(velocity.run.back.x)
y = const(velocity.run.back.y)

[State 105, 2]
type = CtrlSet
trigger1 = AnimElemTime(8) = 2
value = 1

[State 105, 3]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 106

;---------------------------------------------------------------------------
; RUN_BACK2 (land)
[Statedef 106]
type    = S
physics = S
ctrl = 0
anim = 106

[State 106, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 106, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 106, 3]
type = CtrlSet
trigger1 = AnimElem = 4
value = 1

[State 106, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
