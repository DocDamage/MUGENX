; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Gungul"        ;Name of character
displayname = "Gundam" ;Name of character to display
versiondate = 04,01,2006    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "Tommy-gun"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = gd.cmd   ;Command set
cns     = gd.cns   ;Constants
st      = gd.cns   ;States
stcommon = common1.cns ;Common states
sprite  = gd.sff   ;Sprite
anim    = gd.air   ;Animation
sound   = gd.snd   ;Sound
pal1    = 1.act  ;Palettes (can have up to 12)
pal2    = 2.act
pal3    = 3.act
pal4    = 4.act
pal5    = 5.act
pal6    = 6.act

; Arcade mode
[Arcade]
intro.storyboard = intro.def
ending.storyboard = ending.def
