; Definition file for Lion-O
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Lion-O"        ;Name of character
displayname = "Lion-O" ;Name of character to display
versiondate = 02,27,2005    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "Erradicator and Hystalin"    ;Character author name
pal.defaults = 1,2,3,4    ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = lion.cmd   ;Command set
cns     = lion.cns   ;Constants
st      = lion.cns   ;States
stcommon = common1.cns ;Common states
sprite  = liono.sff   ;Sprite
anim    = lion.air   ;Animation
sound   = lion.snd   ;Sound

Pal1 = liono01.act ;Wild storm
Pal2 = liono02.act ;cartoon
Pal3 = liono03.act
Pal4 = liono04.act
Pal5 = liono05.act
Pal6 = liono06.act
Pal7 = liono07.act ;gold
Pal8 = liono08.act ;inverted
Pal9 = liono09.act ;black
Pal10 = liono10.act
pal11 = liono11.act ;brazillian pal
pal12 = liono12.act ;green
