; Definition file for MK2 I Mileena
; Contains all the filenames needed for the character

; Player information
[Info]
name = "MK2 Mileena"        ;Name of character
displayname = "Mileena" ;Name of character to display
versiondate = 4,2,2001    ;Version date of character
mugenversion = 4,2,2001   ;Version of M.U.G.E.N character works on
author = "Kazmer13"         ;Character author name
pal.defaults = 1,5


; Files for the player
[Files]
cmd=mileena.cmd   ;Command set
cns=mileena.cns   ;Constants
st=mileena.cns   ;States
st2=blood.cns
st3=swept.cns
st4=basics.cns
stcommon = common1.cns ;Common states
sprite  = mileena.sff   ;Sprite
anim    = mileena.air   ;Animation
sound   = mileena.snd ; Sound
pal1    = mileena1.act  ; Basic outfit
pal2    = mileena2.act
pal3    = mileena3.act
pal5    = mileena5.act

; If you don't have or want the ending, just delete these lines:
[Arcade]
intro.storyboard = intro.def
ending.storyboard = ending.def
