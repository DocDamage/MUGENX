;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

;--[Fatality related shit]----------------------------------
;----------------------------------------
[State -2, Check Fatality readiness]
type = VarSet
trigger1 = p2life <= 1
trigger1 = p2MoveType = H
;trigger1 = p2stateno != [9100, 9999]
;trigger1 = stateno != [9010, 9999]
trigger1 = Var(9) = 1
v = 3
value = 1


; Fatal helper activates
[State -2, Fatal H]
type = Helper
trigger1 = Var(3) = 1
trigger1 = p2movetype != H
trigger1 = Pos Y = 0
trigger1 = p2stateno != 5080
trigger1 = p2stateno != 5090
trigger1 = p2stateno != 5100
trigger1 = p2stateno != 5110
trigger1 = p2stateno != 5120
trigger1 = p2stateno != [9100, 9999]
trigger1 = stateno != [9010, 9999]
trigger1 = Var(9) = 1
trigger1 = roundno >= 2
trigger1 = var(50) = 1
stateno = 10000
name = "Fatality Helper"
id = 10000
pos = 0, 0
helpertype = normal
sprpriority = 1
keyctrl = 0
ownpal = 0
under = 1


; Moves don't KO
[State -2, nokill]
type = Varset
trigger1 = power != 0
trigger1 = Roundno != 1
trigger1 = var(50) = 1
v = 9
value = 1



; Moves KO
[State -2, kill]
type = VarSet
trigger1 = power = 0
v = 9
value = 0

; End 
[State -2,8]
type = Helper
triggerall = p2Life != 0
triggerall = win != 1
triggerall = lose != 1
trigger1 = Var(9) = 0
trigger1 = p2stateno = 9010
stateno = 9020
name = "No hit"
id = 9020
pos = 0, 0
helpertype = normal
sprpriority = 1
keyctrl = 0
ownpal = 0
under = 1


[State -2, no power]
type = Poweradd
trigger1 = life < 1
value = -3000

[State -2, Kill again]
type = Varset
trigger1 = p2stateno = 9010
v = 9
value = 0

;---------------------------
; Get rid of shit for Fatality/Finishers
[State -2, Nothing]
type = AssertSpecial
trigger1 = Var(6) = 1
flag = nomusic
flag2 = nokosnd
flag3 = nokoslow

; Punch counter
[State -2, 100]
type = VarSet
triggerall = var(20) > 0
trigger1 = (stateno != [200,204]) && (stateno != [210,214])
v = 20
value = 0
