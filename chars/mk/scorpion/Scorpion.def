; Definition file for Scorpion
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Scorpion"
displayname = "Scorpion"
versiondate = 12,01,2001    ;Version date of character
mugenversion = 04,01,2001   ;Version of M.U.G.E.N character works on
author = "Kazmer13"           ;Character author name
pal.defaults = 1, 3, 2, 4

; Files for the player
[Files]
cmd      = scorpion.cmd   ;Command set
cns      = scorpion.cns   ;Constants
st       = scorpion.cns   ;States
st2      = scorpionsp.st ;Specials
st3      = scorpionComm.st ; Common state overrides
st4      = scorpionBlood.st
st5      = scorpionFatality.st
stcommon = common1.cns     ;Common states
sprite   = scorpion.sff   ;Sprite
anim     = scorpion.air   ;Animation
sound   = scorpion.snd   ;Sound
pal1     = scorpion.act   ;(regular)
pal2     = scorpion3.act   ;(yellow/orange)
pal3     = scorpion4.act   ;(dead)
pal4     = scorpion2.act   ;(true yellow)

; Arcade mode
[Arcade]
intro.storyboard = intro.def
ending.storyboard = ending.def


