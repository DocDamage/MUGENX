ownpal = 0
under = 1

;THIS CHANGES SCORPIONS MOVES FROM KILL TO NON-KILL, VERY IMPORTANT
[State -2, 7.6]
type = Varset
trigger1 = power != 0
trigger1 = Roundstate = 1
v = 9
value = 1

;MAKES HIS MOVES KILL
[State -2, 7.7]
type = Varset
trigger1 = power = 0
v = 9
value = 0

;THE FATALITY COUNT DOWN
[State -2, 7.9]
type = Varadd
trigger1 = Var(13) != 0
V = 13
value = -1

;THIS IS THE END OF FATALITY TIME
[State -2,8]
type = Helper
triggerall = p2Life != 0
triggerall = win != 1
triggerall = lose != 1
trigger1 = Var(13) = 1
trigger1 = Var(9) = 0
