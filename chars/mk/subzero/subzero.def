; Definition file for Scorpion
; Contains all the filenames needed for the character

; Player information
[Info]
name = "subzero"
displayname = "Sub-Zero"
versiondate = 06,03,2001    ;Version date of character
mugenversion = 04,01,2001   ;Version of M.U.G.E.N character works on
author = "Kazmer13"           ;Character author name
pal.defaults = 5, 1

; Files for the player
[Files]
cmd      = subzero.cmd   ;Command set
cns      = subzero.cns   ;Constants
st       = subzero.cns   ;States
st2      = subzerosp.st ;Specials
st3      = subzeroComm.st ; Common state overrides
st4      = subzeroBlood.st
st5      = subzeroFatality.st
stcommon = common1.cns     ;Common states
sprite   = subzero.sff   ;Sprite
anim     = subzero.air   ;Animation
sound   = subzero.snd   ;Sound
pal1     = subzero.act   ;(light blue)
pal2     = subzero3.act   ;(light blue2)
pal3     = subzero2.act   ;(dark blue)
pal4     = subzero4.act   ;(Cold Blooded1)
pal5     = subzero5.act   ;(Cold Blooded2)




; Arcade mode
[Arcade]
intro.storyboard = intro.def
ending.storyboard = ending.def


