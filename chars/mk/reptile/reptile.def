; Definition file for Scorpion
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Reptile"
displayname = "Reptile"
versiondate = 06,03,2001    ;Version date of character
mugenversion = 04,01,2001   ;Version of M.U.G.E.N character works on
author = "Cipher/Kazmer13"           ;Character author name
pal.defaults = 5, 2, 1, 3, 4

; Files for the player
[Files]
cmd      = reptile.cmd   ;Command set
cns      = reptile.cns   ;Constants
st       = reptile.cns   ;States
st2      = reptilesp.st ;Specials
st3      = reptileComm.st ; Common state overrides
st4      = reptileBlood.st
st5      = reptileFatality.st
stcommon = common1.cns     ;Common states
sprite   = reptile.sff   ;Sprite
anim     = reptile.air   ;Animation
sound   = reptile.snd   ;Sound
pal1     = reptile1.act   ;(normal)
pal2     = reptile2.act   ;(dead)
pal3     = reptile3.act   ;(grass green)
pal4     = reptile4.act   ;(swamp green)
pal5     = reptile5.act   ;(swamp green with yellow skin)


; Arcade mode
[Arcade]
intro.storyboard = intro.def
ending.storyboard = ending.def


