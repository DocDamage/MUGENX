; Definition file for Scorpion
; Contains all the filenames needed for the character

; Player information
[Info]
name = "shao kahn"
displayname = "Shao Kahn"
versiondate = 06,03,2001    ;Version date of character
mugenversion = 04,01,2001   ;Version of M.U.G.E.N character works on
author = "Kazmer13"           ;Character author name
pal.defaults = 1

; Files for the player
[Files]
cmd      = shaokahn.cmd   ;Command set
cns      = shaokahn.cns   ;Constants
st       = shaokahn.cns   ;States
st2      = shaokahnsp.st ;Specials
st3      = shaokahnComm.st ; Common state overrides
st4      = shaokahnBlood.st
st5      = shaokahnFatality.st
stcommon = common1.cns     ;Common states
sprite   = shaokahn.sff   ;Sprite
anim     = shaokahn.air   ;Animation
sound   = shaokahn.snd   ;Sound
pal1     = shaokahn1.act   
pal2     = shaokahn2.act
pal3     = shaokahn3.act
pal4     = shaokahn4.act

; Arcade mode
[Arcade]
intro.storyboard = intro.def
ending.storyboard = ending.def


