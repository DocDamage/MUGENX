; Definition file for Scorpion
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Raiden"
displayname = "RAIDEN"
versiondate = 06,03,2001    ;Version date of character
mugenversion = 04,01,2001   ;Version of M.U.G.E.N character works on
author = "ChairmanKaga/Kazmer13"           ;Character author name
pal.defaults = 1,2   

; Files for the player
[Files]
cmd      = raiden.cmd   ;Command set
cns      = raiden.cns   ;Constants
st       = raiden.cns   ;States
st2      = raidensp.st ;Specials
st3      = RaidenComm.st ; Common state overrides
st4      = RaidenBlood.st
st5      = RaidenFatality.st
stcommon = common1.cns     ;Common states
sprite   = raiden.sff   ;Sprite
anim     = raiden.air   ;Animation
sound   = raiden.snd   ;Sound
pal1     = raiden00.act   ;Palettes (blue)
pal2     = raiden01.act   ;Palettes (red)
pal3     = raiden06.act   ;Palettes (Light Green)
pal4     = raiden03.act   ;Palettes (beige)
pal5     = raiden04.act   ;Palettes (grey)
pal6     = raiden05.act   ;Palettes (dark blue)
pal7     = raiden02.act   ;Palettes (yellow)

; Arcade mode
[Arcade]
intro.storyboard = intro.def
ending.storyboard = ending.def


