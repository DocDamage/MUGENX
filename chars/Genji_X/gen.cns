; Guard Hit (Stand/Shaking)
[Statedef 150]
type    = S
movetype= H
physics = N
velset = 0,0

[State 150, 1]
type = ChangeAnim
trigger1 = Var(1) = 0
trigger1 = 1
value = 150

[State 150, 2]
type = ChangeAnim
trigger1 = Var(1) > 0
trigger1 = 1
value = 153

[State 150, 3]
type = ForceFeedback
trigger1 = time = 0
waveform = square
time = 3

[State 150, Minus Guard Gauge]
type = varadd
trigger1 = time = 0
var(8) = -(gethitvar(hitshaketime)+gethitvar(hittime))/10
ignorehitpause = 1

[State 150, NotHitBY]
type = nothitby
trigger1 = var(8)<=0
value = SCA
time = 1

[State 150, Guard Break BOOM!]
type = PlaySnd
trigger1 = time = 0 && var(8)<=0
value = 5,4
ignorehitpause = 1
persistent = 0

[State 150, Pause]
type = pause
trigger1 = var(8)<=0 && time = 0
time = ifelse(gethitvar(hitshaketime)<15,15-gethitvar(hitshaketime),0)
ignorehitpause =1
persistent = 0

[State 150, Red Stuff]
