;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------


;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0

[State -3, Recuo Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 105 ;recuo
value = 100, 0

[State -3,PlaySnd]
type = PlaySnd
triggerall = Time = 1 && Alive && Random <= 500
triggerall = StateNo = 5000 || StateNo = 5010
trigger1 = Anim = 5000 || Anim = 5010 || Anim = 5020
;value = 5000, 0
value = 5000, ifelse (random <= 500, 3, 5)


[State -3,PlaySnd]
type = PlaySnd
triggerall = Time = 1 && Alive && Random <= 500
triggerall = StateNo = 5000 || StateNo = 5010
trigger1 = Anim = 5001 || Anim = 5011 || Anim = 5021
;value = 5000, 1
value = 5000, ifelse (random <= 500, 0, 4)

[State -3,PlaySnd]
type = PlaySnd
triggerall = Time = 1 && Alive && Random <= 500
triggerall = StateNo = 5000 || StateNo = 5010
trigger1 = Anim = 5002 || Anim = 5012 || Anim = 5022
;value = 5000, 2
value = 5000, ifelse (random <= 500, 1, 2)

[State -3,PlaySnd]
type = PlaySnd
triggerall = Time = 1 && Alive
trigger1 = Anim = 5300
value = 5300, 1

[State -2, AttackFix]
type = null;VarSet
trigger1 = 1
fvar(2) = fvar(2)/(10-(GetHitVar(damage)/100)/10)
ignorehitpause = 1

[State -2, AttackFix]
type = Varset
trigger1 = 1
;trigger1 = 1
var(30) = floor(((1*GetHitVar(damage)))*(10-(1*GetHitVar(hitcount)))/10*(1*(10-(GetHitVar(damage)/10)/10))/10)
ignorehitpause = 1

[State -2, AttackFix]
type = Varadd
trigger1 = var(33) = 0
trigger1 = var(30) > 0
trigger1 = stateno != [150,153]
trigger1 = stateno = 5000 || stateno = 5010 || stateno = 5020
;trigger1 = 1
var(34) = 1*(var(30))
ignorehitpause = 1

[State -2, AttackFix]
type = null;VarSet
trigger1 = var(30) > 0;var(30) = 0
var(30) = 0;/(5-(GetHitVar(damage)/100)/5)
ignorehitpause = 1

[State -2, AttackFix]
type = Varadd
triggerall = var(31) > 0
;trigger1 = stateno != [150,153]
;trigger1 = stateno != [5000,5900]
trigger1 = movetype != H
;trigger1 = 1
var(31) = -1
ignorehitpause = 1

[State -2, AttackFix]
type = varset
triggerall = var(34) > 0
trigger1 = movetype = H
;trigger1 = 1
var(31) = 120
ignorehitpause = 1

[State -2, AttackFix]
type = Varset
trigger1 = var(31) = 0
;trigger1 = 1
var(34) = 0
ignorehitpause = 1

[State -2, AttackFix]
type = ChangeState
trigger1 = var(34) >= 500
trigger1 = stateno = 5000 || stateno = 5010 || stateno = 5020
;trigger1 = 1
value = 5300
ignorehitpause = 1

[State -2, AttackFix]
type = varset
triggerall = var(33) > 0
trigger1 = StateNo != [5302,5302]
;trigger1 = movetype != H
;trigger1 = 1
var(33) = 0
ignorehitpause = 1

