; Player information
[Info]
name = "Nicola ZaZa"        ;Name of character
displayname = "Nicola" ;Name of character to display
versiondate = 04,14,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "Fervicante"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = nicola.cmd   ;Command set
cns     = nicola.cns   ;Constants
;st      = carol.cns   ;States
;st2      = carolnaughty.cns
st      = nicola.cns   ;States
st2      = nicolaS.cns
st3      = nicolaH.cns
stcommon = common1.cns ;Common states
sprite  = nicola.sff   ;Sprite
anim    = nicola.air   ;Animation
sound   = nicola.snd   ;Sound
pal1    = nicola06.act  ;Palettes (can have up to 12)
pal2    = nicola04.act
pal3    = nicola02.act
pal4    = nicola05.act
pal5    = nicola03.act
pal6    = nicola01.act

; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def