[Statedef 95]
type = A
physics = A
hitcountpersist = (enemy, movetype = H)

[State 95, 1a]
type = Velset
trigger1 = time = 0
x = ifelse(command = "holdfwd", 2.7, ifelse(command = "holdback", -2.7, 0))

[State 95, 1b]
type = Varset
trigger1 = time = 0
var(9) = -1

[State 95, 2]
type = Velset
trigger1 = time = 0
y = -11.5

[State 95, 3]
type = Playsnd
trigger1 = time = 0
value = 90,0

[State 95, 4]
type = VarSet
trigger1 = Time = 0
