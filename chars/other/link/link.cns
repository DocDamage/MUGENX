persistent = 0

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = N
anim = 100
sprpriority = 1
hitcountpersist = (enemy, movetype = H)

[State 100, 1]
type = Playsnd
trigger1 = time%floor(tickspersecond*4.1) = 0
value = 100,0
volume = 100
channel = 24

[State 100, 2]
type = Varset
trigger1 = time = 0
var(11) = 0

[State 100, 3]
type = Varadd
trigger1 = time > 0
trigger1 = time > var(11)
var(11) = (random/250)+1

[State 100, 4]
type = Explod
trigger1 = time = var(11)
anim = 110+random/200
pos = -10-random/20,-random/10
postype = p1
sprpriority = 5
ownpal = 1

[State 100, 5]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 6]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 7]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 8]
type = Changestate
trigger1 = command != "holdfwd"
value = 0

