; GUARD (start)
[Statedef 120]
type = U
physics = U
hitcountpersist = (enemy, movetype = H)

[State 120,0 - MW]
type = Null ; Width
trigger1 = 1
value = -9,-13

[State 120, 1]
type = Hitoverride
trigger1 = var(1) = 1
attr = SA, HA, HP
stateno = 150
time = 1

[State 120, 2]
type = Hitoverride
trigger1 = var(2) = 1
attr = C, HA
stateno = 152
time = 1

[State 120, 3]
type = Hitoverride
trigger1 = var(2) = 1
attr = SC, HP
stateno = 152
time = 1

[State 120, 4]
type = Ctrlset
trigger1 = var(1) = 1
value = 1

[State 120, 5]
type = Changeanim
trigger1 = var(1) = 0 && var(2) = 0
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2

[State 120, 6]
type = StateTypeSet
trigger1 = var(1) = 0 && var(2) = 0
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 7]
type = StateTypeSet
trigger1 = var(1) = 0 && var(2) = 0
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 8]
type = StateTypeSet
trigger1 = var(1) = 0 && var(2) = 0
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, 9]
type = Changestate
trigger1 = anim = 20
;trigger1 = anim != [120,152]
;trigger1 = anim != [5,6]
;trigger1 = anim != 500
trigger1 = command != "holdfwd2"
trigger1 = var(1) = 0
trigger2 = anim = 5
trigger2 = animtime = 0
value = ifelse(command = "holdfwd",20,0)

[State 120, 10]
type = Changestate
trigger1 = anim = [10,11]
;trigger1 = anim != [120,152]
;trigger1 = anim != [5,6]
;trigger1 = anim != 500
trigger1 = command != "holddown2"
trigger1 = var(2) = 0
value = 11

[State 120, 11]
type = Changestate
trigger1 = var(1) = 1
trigger1 = command = "holdup"
value = 40

[State 120, 12]
type = Changestate
trigger1 = var(1) = 1
trigger1 = command = "holddown2"
value = 10

[State 120, 13]
type = Changestate
;trigger1 = var(1) = 1
trigger1 = anim = 20
trigger1 = time = 6
;trigger1 = anim != 500
value = 20

[State 120, 14]
type = Changestate
;trigger1 = var(1) = 1
trigger1 = anim = [10,11]
trigger1 = time = 6
;trigger1 = anim != 500
value = 11

[State 120, 15]
type = Changestate
trigger1 = var(1) = 0 && var(2) = 0
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

;---------------------------------------------------------------------------
; STAND GUARD (guarding)
[Statedef 130]
type    = S
physics = S
hitcountpersist = (enemy, movetype = H)

[State 130, 1]
type = Changeanim
trigger1 = Anim != 130
value = 130

[State 130, 2]
type = ChangeState
triggerall = !(Enemy, NumProj)
trigger1 = command != "holdback"
trigger2 = P2MoveType != A
trigger3 = P2BodyDist X > Enemy, const(size.attack.dist)
value = 140

