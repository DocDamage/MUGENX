trigger1 = command != "holdback"
value = 52

[State 132, 7]
type = Changestate
trigger1 = sysvar(0)
value = 130

[State 132, 8]
type = ChangeState
triggerall = !(Enemy, NumProj)
trigger1 = command != "holdback"
trigger2 = P2MoveType != A
trigger3 = P2BodyDist X > Enemy, const(size.attack.dist)
value = 140

