; Link The Hylian Knight
; Constants and state file.

[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 60
liedown.time = 50
airjuggle = 15
sparkno = -1
guard.sparkno = -1
KO.echo = 0
volume = 50
IntPersistIndex = 55
FloatPersistIndex = 35

[Size]
xscale = 1
yscale = 1
ground.back = 18 ;31
ground.front = 22 ;31
air.back = 15
air.front = 15
height = 55
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = 0,-70
mid.pos = 0,-40
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd = 2.7
walk.back = -2.4
run.fwd = 6.5, 0
run.back = -5,-4.5
jump.neu = 0,-7.75
jump.back = -2.7
jump.fwd = 2.7
runjump.back = -3
runjump.fwd = 4
airjump.neu = 0,-8.1
airjump.back = -2.7
airjump.fwd = 2.7

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .35
stand.friction = .85
crouch.friction = .82

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
movetype = I
physics = S
sprpriority = 0
hitcountpersist = (enemy, movetype = H)

[State 0,0]
type = lifeset
trigger1 = life < 1
ignorehitpause = 1
value = 100

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3]
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10
hitcountpersist = (enemy, movetype = H)

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = Changestate
trigger1 = AnimTime = 0
trigger2 = var(51) != 0
trigger2 = animelemtime(animelemno(0)+1) = 0
trigger2 = animelemtime(animelemno(0)) - animelemtime(animelemno(0)+1) - ifelse(animelemtime(animelemno(0)+1)=0,animtime,0) > 1
trigger2 = animelemtime(animelemno(0)) >= (animelemtime(animelemno(0))-animtime)/2
value = 11

[State 10, 3]
type = Changestate
trigger1 = prevstateno != 120
trigger1 = var(2) = 1
value = 120

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0
hitcountpersist = (enemy, movetype = H)

[State 11, 1]
type = Changeanim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

[State 11, 2]
type = Changestate
;trigger1 = prevstateno != 120
trigger1 = var(2) = 1
value = 120

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12
hitcountpersist = (enemy, movetype = H)

[State 12, 1]
type = Changestate
trigger1 = AnimTime = 0
trigger2 = var(51) != 0
trigger2 = animelemtime(animelemno(0)+1) = 0
trigger2 = animelemtime(animelemno(0)) - animelemtime(animelemno(0)+1) - ifelse(animelemtime(animelemno(0)+1)=0,animtime,0) > 1
trigger2 = animelemtime(animelemno(0)) >= (animelemtime(animelemno(0))-animtime)/2
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = N
sprpriority = 0
hitcountpersist = (enemy, movetype = H)

[State 20,0 - MW]
type = Null ;Width
trigger1 = 1
value = -9,-13

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = Changeanim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = Changeanim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 20, 5]
type = Changestate
trigger1 = anim = [20,21]
trigger1 = prevstateno != 120
trigger1 = var(1) = 1
value = 120

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
hitcountpersist = (enemy, movetype = H)

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
;y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0
hitcountpersist = (enemy, movetype = H)

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A
velset = vel x, ifelse(command="holdup",const(velocity.jump.y),-5.8)
hitcountpersist = (enemy, movetype = H)

[State 50, 0]
type = Playsnd
trigger1 = time = 0
value = 40,0

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = Changeanim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = Changeanim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
value = Anim + 3
persistent = 0

[State 50, 4]
type = Changestate
trigger1 = pos y < -40
trigger1 = command = "up2" && command != "up3"
trigger1 = prevstateno != 45
value = 45

;---------------------------------------------------------------------------
; Jump Down
[Statedef 51]
type    = A
physics = A

[State 51, 1]
type = Null
trigger1 = 1

;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47
hitcountpersist = (enemy, movetype = H)

[State 52, 1]
type = Destroyself
trigger1 = ishelper

[State 52, 2]
type = Changestate
trigger1 = time = 0
value = 53
ctrl = 1

;---------------------------------------------------------------------------
; Jump Land
[Statedef 53]
type    = S
physics = S
ctrl = 0
anim = 47
hitcountpersist = (enemy, movetype = H)

[State 53, 0]
type = Playsnd
trigger1 = ishelper = 0
trigger1 = time = 0
value = 52,0

[State 53, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 53, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 53, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 53, 4]
type = Explod
trigger1 = time = 1
anim = 50
sprpriority = 0
ownpal = 1

[State 53, 5]
type = Changestate
trigger1 = AnimTime = 0
trigger2 = var(51) != 0
trigger2 = animelemtime(animelemno(0)+1) = 0
trigger2 = animelemtime(animelemno(0)) - animelemtime(animelemno(0)+1) - ifelse(animelemtime(animelemno(0)+1)=0,animtime,0) > 1
trigger2 = animelemtime(animelemno(0)) >= (animelemtime(animelemno(0))-animtime)/2
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Superjump
[Statedef 90]
type = S
physics = S
anim = 90
ctrl = 0
sprpriority = 1
hitcountpersist = (enemy, movetype = H)

[State 90, 1]
type = Playsnd
trigger1 = time = 0
value = 40,0

[State 90, 2]
type = Playsnd
trigger1 = time = 0
value = 90,0

[State 90, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 90, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 90, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 90, 6]
type = VelSet
