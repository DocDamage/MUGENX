[State 18100, NayruVar]
type = varset
trigger1 = time = 0
var(3) = 1

[State 18100, VarCheck-Add]
type = VarAdd
trigger1 = Anim = [18001,18003]
var(4) = 1

[State 18100, Change]
type = VarSet
trigger1 = abs(ParentDist X) > 50
trigger1 = var(4) > 10
var(2) = -1*var(2)

[State 18100, VarCheck-Reset]
type = VarSet
trigger1 = abs(ParentDist X) > 50
var(4) = 0

[State 18100, Move]
type = VarSet
trigger1 = Anim = [18001,18003]
var(1) = var(1)+(2*var(2))

[State 18100, Bind]
type = PosSet
trigger1 = Anim = [18001,18003]
X = Parent, Pos X + var(1)
Y = Parent, Pos Y

[State 18100, SprPrior]
type = SprPriority
trigger1 = Anim = [18001, 18003]
value = 5*var(2)

[State 18100, Anims]
type = ChangeAnim
triggerall = var(3)
trigger1 = anim = 18000
trigger1 = animtime = 0
trigger2 = anim = [18002,18003]
trigger2 = Floor(power/1000)+1 < anim-18000
value = IfElse(Floor(power/1000)=3,18003,18001+Floor(power/1000))

[State 18100, Pal]
type = PalFX
trigger1 = anim != 18000
trigger1 = var(3)
time = 1
add = 100+(100*(anim=18002)), -30*(anim=18002)-100*(anim=18001), -100-(100*(anim=18003))

[State 18100, VarEnd] ; trigger2 = cancel in training mode
