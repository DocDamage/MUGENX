trigger1 = Power <= 0
trigger2 = parent, command = "Nayru"
trigger2 = var(3)
trigger2 = power = 3000
trigger2 = parent, stateno != 18000
var(3) = 0

[State 18100, Blink]
type = AssertSpecial
trigger1 = Power < 500
trigger1 = Time%2 = 0
flag = invisible

[State 18100, EndInvis]
type = ChangeAnim
triggerall = Anim != 18005
trigger1 = var(3) = 0
trigger2 = RoundState > 2
value = 18005

[State 18100, End]
type = DestroySelf
trigger1 = anim = 18005
trigger1 = AnimTime = 0

