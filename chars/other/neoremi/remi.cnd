;---------------------------------------------------------------------------
; 2. State entry
; --------------
; This is where you define what commands bring you to what states.
;
; Each state entry block looks like:
;   [State -1, Label]           ;Change Label to any name you want to use to
;                               ;identify the state with.
;   type = ChangeState          ;Don't change this
;   value = new_state_number
;   trigger1 = command = command_name
;   . . .  (any additional triggers)
;
; - new_state_number is the number of the state to change to
; - command_name is the name of the command (from the section above)
; - Useful triggers to know:
;   - statetype
;       S, C or A : current state-type of player (stand, crouch, air)
;   - ctrl
;       0 or 1 : 1 if player has control. Unless "interrupting" another
;                move, you'll want ctrl = 1
;   - stateno
;       number of state player is in - useful for "move interrupts"
;   - movecontact
;       0 or 1 : 1 if player's last attack touched the opponent
;                useful for "move interrupts"
;
; Note: The order of state entry is important.
;   State entry with a certain command must come before another state
;   entry with a command that is the subset of the first.  
;   For example, command "fwd_a" must be listed before "a", and
;   "fwd_ab" should come before both of the others.
;
; For reference on triggers, see CNS documentation.
;
; Just for your information (skip if you're not interested):
; This part is an extension of the CNS. "State -1" is a special state
; that is executed once every game-tick, regardless of what other state
; you are in.


; Don't remove the following line. It's required by the CMD standard.
[Statedef -1];---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;training
;---------------------------------------------------------------------------
[State -1,2]
type = null;lifeset
trigger1 = movetype != H
value = 1000

[State -1,2]
type = null;displaytoclipboard
trigger1 = 1
text = "Trainflag(59) = %d possible(58) = %d SPflag(57) =%d Reversalflag(56) = %d"
params = var(59),var(58),var(57),var(56)
ignorehitpause = 1

;===========================================================================
[State -1, Smash Kung Fu Upper];reset
type = varset
trigger1 = command = "start"
v = 59
value = 0
ignorehitpause = 1

;--flag
[State -1, Smash Kung Fu Upper]
type = varset
triggerall = command = "holdstart"
trigger1 = command = "up"
v = 59
value = 40
ignorehitpause = 1

[State -1, Smash Kung Fu Upper]
type = varset
triggerall = command = "holdstart"
trigger1 = command = "down"
v = 59
value = 1000
ignorehitpause = 1

;--statecheck
[State -1, Smash Kung Fu Upper]
type = varset
trigger1 = 1
v = 58
value = 0
ignorehitpause = 1

[State -1, Smash Kung Fu Upper]
type = varset
triggerall = var(59) = 40
triggerall = movetype != H
trigger1 = stateno = 0
trigger1 = ctrl = 1
v = 58
value = 1

[State -1, Smash Kung Fu Upper]
type = varset
triggerall = var(59) = 1000
triggerall = movetype != H
trigger1 = ctrl = 1
trigger1 = statetype = S || statetype = C
v = 58
value = 1

;-------------------------------------------------------------
;--spflag
;-------------------------------------------------------------
[State -1, Smash Kung Fu Upper];reset
type = varset
trigger1 = var(59) = 0
v = 57
value = 0
ignorehitpause = 1

[State -1, Smash Kung Fu Upper]
type = varadd
trigger1 = var(57)%10 = 0
trigger1 = var(59)
trigger1 = command = "recovery"
v = 57
value = 1
ignorehitpause = 1

[State -1, Smash Kung Fu Upper]
type = varadd
trigger1 = (var(57)/10)%10 = 0
trigger1 = var(59)
trigger1 = command = "back"
v = 57
value = 10
ignorehitpause = 1

;--sp_statechange
[State 5050, 4] ;Recover near ground
type = ChangeState
triggerall = var(59)
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = stateno = 5050
trigger1 = var(57)%10
value = 5200 ;HITFALL_RECOVER

[State 5050, 5]; Recover in mid air
type = ChangeState
triggerall = var(59)
triggerall = Vel Y > -1
triggerall = alive
triggerall = CanRecover
trigger1 = stateno = 5050
trigger1 = var(57)%10
value = 5210 ;HITFALL_AIRRECOVER


[State 5050, 4]
type = ChangeState
triggerall = var(59)
triggerall = (var(57)/10)%10
triggerall = alive
triggerall = ctrl
trigger1 = p2movetype = A
trigger1 = stateno != [130,159]
value = 120

;-------------------------------------------------------------
;--Reversalflag
;-------------------------------------------------------------
[State -1, Smash Kung Fu Upper];reset
type = varset
trigger1 = var(59) = 0
v = 56
value = 0
ignorehitpause = 1

[State -1, Smash Kung Fu Upper]
type = varset
trigger1 = var(59)
trigger1 = command = "x"
v = 56
value = 200*(var(56) != 200)
ignorehitpause = 1
[State -1, Smash Kung Fu Upper]
type = varset
trigger1 = var(59)
trigger1 = command = "y"
v = 56
value = 210*(var(56) != 210)
ignorehitpause = 1
[State -1, Smash Kung Fu Upper]
type = varset
trigger1 = var(59)
trigger1 = command = "z"
v = 56
value = 220*(var(56) != 220)
ignorehitpause = 1
[State -1, Smash Kung Fu Upper]
type = varset
trigger1 = var(59)
trigger1 = command = "a"
v = 56
value = 230*(var(56) != 230)
ignorehitpause = 1
[State -1, Smash Kung Fu Upper]
type = varset
trigger1 = var(59)
trigger1 = command = "b"
v = 56
value = 240*(var(56) != 240)
ignorehitpause = 1
[State -1, Smash Kung Fu Upper]
type = varset
trigger1 = var(59)
trigger1 = command = "c"
v = 56
value = 250*(var(56) != 250)
ignorehitpause = 1

;--Re_statechange
[State -1, Smash Kung Fu Upper];
type = varset
triggerall = var(59)
trigger1 = movetype = H
v = 55
value = 1
ignorehitpause = 1

[State -1, Smash Kung Fu Upper];
type = changestate
triggerall = var(59)
triggerall = var(55) && var(56)
trigger1 = ctrl
value = var(56) + (statetype = A)*400 + (statetype = C)*200

[State -1, Smash Kung Fu Upper];
type = varset
trigger1 = var(59) = 0
trigger2 = ctrl
trigger3 = movetype = A
v = 55
value = 0
ignorehitpause = 1



;---change
[State -1, Smash Kung Fu Upper]
type = changestate
triggerall = movetype != H
trigger1 = stateno != var(59)%1000
trigger1 = var(59) && var(58)
value = var(59)%1000








;---------------------------------------------------------------------------
;
;---------------------------------------------------------------------------
;
[State -1, Run Fwd]
type = posset
triggerall = var(45) != 0
trigger1 = stateno = 5120
trigger1 = animtime = 0

trigger2 = statetype = A
trigger2 = (stateno = [600,699])||(stateno = [120,158])||(stateno = 50)||(stateno = 42)
trigger2 = pos y >= 0
trigger2 = vel y > 0

trigger3 = statetype = A
trigger3 = (stateno = 1620)||(stateno = 1650)||(stateno = 3203)
trigger3 = pos y >= 0
trigger3 = vel y > 0

trigger4 = statetype = A
trigger4 = anim = 44
trigger4 = pos y >= 0
trigger4 = vel y > 0
y = 0

;---------------------------------------------------------------------------
;
[State -1, Run Fwd]
type = ChangeState
value = var(45)
triggerall = var(45) != 0
trigger1 = stateno = 5120
trigger1 = animtime = 0

trigger2 = statetype = A
trigger2 = (stateno = [600,699])||(stateno = [120,158])||(stateno = 50)||(stateno = 42)
trigger2 = pos y >= 0
trigger2 = vel y > 0

trigger3 = statetype = A
trigger3 = anim = 44
trigger3 = pos y >= 0
trigger3 = vel y > 0

