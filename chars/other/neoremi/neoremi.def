; Player information
[Info]
name = "MVCremi by ryokucha"        ;Name of character
displayname = "Remi" ;Name of character to display
versiondate = 08,28,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "ryokucha"         ;Character author name
;pal.defaults = 6,3,4,2      ;Default palettes in order of preference
pal.defaults = 1,2,3,4

; Files for the player
[Files]
