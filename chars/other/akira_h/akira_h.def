
[Info]
name = "Akira Honjoji"        
displayname = "Akira" 
versiondate = 04,14,2001      
mugenversion = 04,14,2001     
author = "YAMAKICHI"          
pal.defaults = 1,4          

[Files]
cmd      = akira.cmd     ;コマンド
cns      = akira.cns     ;定数と状態
st       = akira.cns     ;定数と状態 
st1      = akira_n.cns   ;特殊動作
st2      = jump.cns      ;ハイジャンプ
st3      = akira_s.cns   ;超必殺技
st4      = power.cns     ;パワー溜
st5      = away.cns      ;回避
stcommon = common1.cns   ;
sprite   = akira.sff     ;スプライト
anim     = akira.air     ;アニメ
sound    = akira.snd     ;サウンド

;カラー
pal1     = color/color.act     ;ノーマル
pal2     = color/color2.act    ;落ち着いた色味のノーマルカラー
pal3     = color/color3.act    ;学生風
pal4     = color/color4.act    ;黒のゴスロリミニドレスで黒髪
pal5     = color/color5.act    ;黒のゴスロリミニドレスで金髪
pal6     = color/color6.act    ;黒のゴスロリミニドレスで茶髪
pal7     = color/color7.act    ;青髪
pal8     = color/color8.act    ;黄髪

[Arcade]
;オープニング
;intro.storyboard = intro.def
;エンディング
;ending.storyboard = ending.def

