;---------------------------------------------------------------------------
; 前回避　開始
;---------------------------------------------------------------------------
[Statedef 2200]
type    = S
movetype= A
physics = S
juggle  = 0
poweradd= 0
ctrl = 0         ;このステート中に他のコマンドを受け付けるか(1で受け付ける)
velset = 1.5,0     ;このステートが始まった時に移動するか（0,0で動かない）
anim = 2200      ;このステートで表示するスプライトステート番号(0で変化無し)
sprpriority = -1 ;表示した絵の重なり具合(2一番前　0通常　-1奥)

[State 2200,01]
type = ChangeState
trigger1 = animtime = 0
value = 2210
ctrl = 0

[State 2200,02]
type = PlaySnd
trigger1 = AnimElem = 1
value = 1000, 2

[State 2200,03]
type = AfterImage
trigger1 = AnimElem = 1
time = 20
trans = add1
timegap = 2
framegap = 2
length = 10
palbright = 1,1,1
palcontrast = 156,128,172
paladd = 0,0,0
palmul = 1,1,1
ignorehitpause = 1

