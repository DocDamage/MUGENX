type = S

[State 191, 1]
type = VarRandom
trigger1 = Time = 0
v = 8
range = 0,50

[State 191, 5]
type = ChangeState
trigger1 = Var(8) = [0,25]
value = 181

[State 191, 6]
type = ChangeState
trigger1 = Var(8) = [25,50]
value = 181

