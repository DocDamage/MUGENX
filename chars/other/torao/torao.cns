trigger1 = time = 0
trigger1 = sysvar(2) = 5090
trigger1 = !SelfAnimExist(5090)
sysvar(2) = 5030

[State 5080, 3] ;Freeze
type = ChangeAnim
trigger1 = 1
value = sysvar(2)

[State 5080, 4]
type = null;ChangeState
trigger1 = time = 1;HitShakeOver
trigger1 = GetHitVar(yvel) = 0
value = 5081 ;HITL_SLIDE

[State 5080, 5]
type = SelfState
trigger1 = time = 1;HitShakeOver
trigger1 = GetHitVar(yvel) != 0
value = 5030 ;HITA_UP
