;「ユェン・ソイレン」CNSファイル０５　ＡＩ編
;varは５０が１の時ＣＰＵ始動

[Statedef -3]

[State -3, teigi]
type = VarSet
triggerall = var(50) != 1
trigger1 = Command = "AI01"
trigger2 = Command = "AI02"
trigger3 = Command = "AI03"
trigger4 = Command = "AI04"
trigger5 = Command = "AI05"
trigger6 = Command = "AI06"
trigger7 = Command = "AI07"
trigger8 = Command = "AI08"
var(50) = 1



;悪あがきスレイヤー--------------------------------------------------------
[State -3, waru01]
type = changestate
triggerall = var(50) = 1
triggerall = statetype != A
triggerall = ctrl = 1
trigger1 = RoundNo != 1
trigger1 = Life < 80
trigger1 = power >= 3000
value = 2500
