; Shin Kaname Ameri - cns file No.1
;===========================================================================
; Var(0) = Random Win Pause
; Var(1) = Random Intro
; Var(2) = Random Win Message
; Var(3) = Win Message On
; Var(4) = "Shadow Play"
; Var(5) = Custom AI
; Var(6) = Chain Combo
; Var(7) = Super Jump Control
; Var(8) = Damage Voice
; ---------------------------------------
; Var(39) = Hold-Push
; ---------------------------------------
; Var(40) = Custom AI Support
; Var(41) = Weak AI Support
; Var(42) = Projectile HitCheck
;===========================================================================
;---------------------------------------------------------------------------
; キャラクター基準値の設定

[Data]
life = 1201                 ;ライフゲージ最大値
attack = 100                ;攻撃力パーセンテージ （多いほど強くなります Def:100%）
defence = 100               ;防御力パーセンテージ （多いほど強くなります Def:100%）
power = 3001                ;超必殺技ゲージ最大値（デフォルトは 3000 = Lv.3）
fall.defence_up = 100       ;ダウン時に攻撃された時に一時的に上がる防御力のパーセンテージ
liedown.time = 15           ;ダウンしてから起き上がるまでの時間
airjuggle = 15              ;ジャッグルポイント限界値
sparkno = 2                 ;デフォルトのヒットスパーク番号
guard.sparkno = 40          ;デフォルトのガードスパーク番号
KO.echo = 0                 ;1にするとKOされた時に声にエコーがかかります
volume = 255                ;キャラの音量。255が最高
IntPersistIndex = 40        ;Varの次ラウンド持ち越しが可能 (min=0, max=59)
FloatPersistIndex = 99      ;同じくFVarの次ラウンド持ち越しが可能 (min=0, max=39)

;---------------------------------------------------------------------------
; サイズ指定

[Size]
xscale = 1                  ;水平方向の縮尺
yscale = 1                  ;垂直方向の縮尺
ground.back = 13            ;キャラクターの幅（後方、地上）
ground.front = 19           ;キャラクターの幅（前方、地上）
air.back = 17               ;キャラクターの幅（後方、空中）
air.front = 14              ;キャラクターの幅（前方、空中）
z.width = 3                 ;Player width (into and out)（現在使用されていないと思われます）
height = 60                 ;Height of player (for opponent to jump over)（不明）
attack.width = 4,4          ;Default attack width: back, front（現在使用されていないと思われます）
attack.dist = 100           ;攻撃時に相手がガード体勢に入る最低距離（最大320）
proj.attack.dist = 90       ;相手がガード体勢に入る発射物との最低距離（最大320） 
proj.doscale = 0            ;xscale, yscaleの設定が発射物にも有効かどうかの設定（1なら有効です）
head.pos = -5,-90           ;頭の大体の座標（BindToTarget使用時に必要です。）
mid.pos = -5,-60            ;体中心の大体の座標（BindToTarget使用時に必要です。）
shadowoffset = -2           ;影の垂直方向オフセット

;---------------------------------------------------------------------------
; 移動速度の設定

[Velocity]
walk.fwd  = 3.0             ;前に歩く時の速度
walk.back = -3.0            ;後ろに歩く時の速度
run.fwd  = 12,0             ;前に走る時の速度 (x, y) ホップさせる時は y を 0 以下にします
run.back = -10,0            ;後ろに走る時の速度 (x, y) 走らせる時は y を 0 にします
jump.neu = 0,-9.5           ;ジャンプ時の垂直移動速度 (x, y)
jump.back = -3              ;後ろにジャンプした時の水平移動速度
jump.fwd = 3                ;前にジャンプした時の水平移動速度
runjump.back = -3,-9.5      ;後ろに走りながらのジャンプ時の速度指定 (オプション)
runjump.fwd = 4,-9.5        ;前に走りながらのジャンプ時の速度指定 (オプション)
;airjump.neu = 0,-8.1       ;空中ジャンプ時の垂直移動速度 (オプション)
;airjump.back = -2.55,-8.1  ;空中で後ろにジャンプした時の水平移動速度
;airjump.fwd = 2.5,-8.1     ;空中で前にジャンプした時の水平移動速度

;---------------------------------------------------------------------------
; 動作の設定

[Movement]
airjump.num = 15            ;空中ジャンプの回数 （オプション）
airjump.height = 20         ;空中ジャンプに必要な最低限の高さ （オプション）
yaccel = .43                ;垂直方向にかかる加速度（重力）
stand.friction = .85        ;立ち状態の摩擦係数
crouch.friction = .82       ;しゃがみ状態の摩擦係数

;---------------------------------------------------------------------------
; [Statedef]の基本的な書き方
;
; [Statedef STATENO]
; type = ?      S/C/A/L  状態の設定（立ち/しゃがみ/空中/ダウン）
; movetype = ?  I/A/H    動作状態（何もしていない/攻撃/攻撃を受けている）
; physics = ?   S/C/A/N  物理的な状態（通常/しゃがみ/空中/特になし）
; juggle = ?             動作が必要とするエアージャッグルポイント
;
; [State STATENO, ?]     ? - 任意の番号
; type = ?
; ...
;===========================================================================
;基本動作
;===========================================================================
;---------------------------------------------------------------------------
; 前ダッシュ
[Statedef 100]
type     = S
physics  = N
anim     = 100
velset   = 0,0

[State 100, Zanzou]
type = AfterImage          ;タイプ：残像
trigger1 = Time = 1        ;１フレーム目に発動
Time = 15                  ;残像が出ている時間
PalBright   =   0,  0,  0  ;残像の明るさ。ＲＧＢで記述
PalContrast = 255,255,255  ;残像の色合い。これもＲＧＢで
Trans = Add                ;半透明の効果。Subだと影効果になる
TimeGap  = 2               ;残像が一つずつ表示する間隔。上手くいけば変則的な表示になる
FrameGap = 1               ;残像が一つずつ表示する時間の間隔。数値が多過ぎるとあまり表示せず
length = 8                 ;残像が表示している大きさ（表示数も決まる）

;******************************
[State 100, Pos]
type = PosSet
trigger1 = Time >= 0
y = 0

[State 100, Speed]
type = Velset
trigger1 = Time >= 1
x = 10
y = 0

[State 100, Dust]
type = MakeDust
trigger1 = Time = 1
pos = 0,0
spacing = 1

;******************************
[State 100, No Walk & No Turn]
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2= NoAutoTurn
ignorehitpause = 1

[State 100, SE]
type = PlaySnd
trigger1 = Time = 1
value = s2,2

;******************************
[State 100, DashStop]
type = ChangeState
triggerall = StateNo = 100
trigger1 = command != "holdfwd"
value = 101
ctrl = 1

;---------------------------------------------------------------------------
; ダッシュ終了
[Statedef 101]
type     = S
physics  = S
anim     = 101
ctrl     = 1

[State 101, No Walk & No Turn]
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2= NoAutoTurn
ignorehitpause = 1

[State 101, Pos]
type = PosSet
trigger1 = Time >= 0
y = 0

[State 101, Change]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

