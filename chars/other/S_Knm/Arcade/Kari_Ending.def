; Kaname Ameri's Temporary Ending cutscene
; 雨里　要ＬＥの仮エンディング

; 作成者　：　ちょっとこ丸  (creator : Chotto-Komaru)

;=============================================================
;-------------------------------------------------------------
[SceneDef]
spr = Kari_Ending.sff         ;呼び出す画像ファイル（*.sff）
;startscene = 0               ;開始するシーンナンバー。記述しない時はシーン０から開始する。

;-------------------------------------------------------------
[Scene 0]
fadein.time      = 20         ;画面が徐々に現れるまでの時間。
fadein.col       = 0,0,0      ;画面が徐々に現れる前のデフォルトの色。
fadeout.time     = 20         ;画面が徐々に消えるまでの時間。
fadeout.col      = 0,0,0      ;画面が完全に消えた時のデフォルトの色。
clearcolor       = 0,0,0      ;全画面のバックの色。
layerall.pos     = 0,0        ;全てのレイヤー（画像）の基準となる軸位置。
layer0.anim      = 2          ;レイヤー０（０～９まで設定可能）のアニメを呼び出す。
layer0.offset    = 0,0        ;レイヤー０の位置。
layer0.starttime = 0          ;レイヤー０の始める時間。
layer1.anim      = 0
layer1.offset    = 0,0
layer2.anim      = 1
layer2.offset    = 0,0
bgm              = bgm.mid    ;バックで流すＢＧＭ。って出来るんかい！(＠▽＠;)
bgm.loop         = 1          ;ＢＧＭを繰り返すかどうか。
end.time         = 1200       ;そのシーンの全体的にアニメする時間。必須だぜぃ。

;=============================================================
