[Info]
name = "TigreNegro"
displayname = "TigreNegro"
mugenversion = 01,04,2000
author = "MAXIMUS_MamboJambo"
pal.defaults=3,4,5,0,1,2

; Files for the player
[Files]
cmd     = TigreNegro.cmd   ;Command set
cns     = TigreNegro.cns   ;Constants
st      = TigreNegro.cns   ;States
st1      = supers.cns
st2      = hipers.cns
st3      = inteligente.cns

  
stcommon = tigrecom.cns     
sprite  = TigreNegro.sff   ;Sprite
anim    = TigreNegro.air   ;Animation
sound   = TigreNegro.snd   ;Sound

pal1    = nego.act   
pal2    = nego6.act
pal3    = nego2.act
pal4    = nego3.act
pal5    = nego4.act
pal6    = nego5.act
pal7    = nego1.act

; Arcade mode
[Arcade]
intro.storyboard = intro.def
ending.storyboard = ending.def