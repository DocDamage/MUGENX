[Statedef 700]
type    = S
movetype= A
physics = S
ctrl = 0
anim = 40

[State 700, som]
type = PlaySnd
Trigger1 = AnimElem = 1
value = 3000,0

[State 700, pulo ]
type = Explod
trigger1 = AnimElem = 1
anim = 6200
postype = p1
pos = 0,0
ownpal = 1
sprpriority = 100
bindtime = -1
ignorehitpause = 2

[State 700, veladd] 
type = VelAdd
trigger1 = AnimElem = 1, [1, 5]
y = -3.5  


[State 100, AfterImage]
type = AfterImage
trigger1 = AnimElem = 1     ;onde começa
time = 45                        ;tempo que dura as sombras
length = 15                     ;quantas sombras "perseguem" o movimento do char
palbright = 0,0,0               ;daqui pra baixo sao ajustes de cores, com RGB!
palcontrast = 140,102,0
alpostbright = 140,102,0 
timegap = 1
flamegap = 1
trans = add 

[State 700, end]
type = ChangeState
trigger1 = AnimTime = 0
value = 54
ctrl = 1


[Statedef 54]
type    = A
physics = A

[State 54, Holding Back]
type = VelAdd
triggerall = P2BodyDist y >= 100 || !ifelse((vel x)>0, 42, 43)
trigger1 = (command = "holdback")
x = -0.1

[State 54, Holding Forward]
type = VelAdd
triggerall = P2BodyDist y >= 100 || !ifelse((vel x)>0, 42, 43)
trigger1 = (command = "holdfwd") 
x = 0.1

[State 54, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 54, 2]
type = ChangeAnim
trigger1 = Time = 0
value = 41  


[State 54, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

