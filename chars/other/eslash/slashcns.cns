velset = 0,0
anim = 5150
sprpriority = -1


[State 5151, 2]
type = NotHitBy
trigger1 = Time = 0
value = SCA
time = 1

[State 5151, 3] 
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
