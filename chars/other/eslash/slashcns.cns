;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1


[Statedef 5150]
type    = L
velset = 0,0

[State 5150, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

[State 5150, 20]
type = ChangeState
triggerall = MatchOver = 0
trigger1 = p2stateno = 180
trigger2 = p2stateno = 181
trigger3 = p2stateno = 182
trigger4 = p2stateno = 183
trigger5 = p2stateno = 184
trigger6 = p2stateno = 185
trigger7 = p2stateno = 186
trigger8 = p2stateno = 187
value = 5151

;---------------------------------------------------------------------------

[Statedef 5151]
