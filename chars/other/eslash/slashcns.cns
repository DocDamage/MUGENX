velset = 0 

[State 180, 1] 
type = ChangeState 
trigger1 = command = "holda" 
value = 181 

[State 180, 2] 
type = ChangeState 
trigger1 = command = "holdb" 
value = 182 


[State 180, 2] 
type = ChangeState 
trigger1 = command = "holdc" 
value = 183


[State 180, 3] 
