;

; Player information
[Info]
name = "Slash"        ;Name of character
displayname = "Slash" ;Name of character to display
versiondate = 04,14,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "Keioh"         ;Character author name

; Files for the player
[Files]
cmd     = slashcmd.cmd   ;Command set
cns     = slashcns.cns   ;Constants
st      = slashcns.cns   ;States
st1     = coger.cns
stcommon = common1.cns ;Common states
sprite  = slash.sff   ;Sprite
anim    = s-air.air   ;Animation
sound   = eslash.snd   ;Sound
pal1    = slash.act
pal2    = slash2.act
pal3    = slash3.act
pal4    = slash4.act
pal5    = slash5.act
pal6    = slash6.act

