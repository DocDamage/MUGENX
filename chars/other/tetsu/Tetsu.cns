; Template's constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.
; These are Kung Fu Man's default values. They're good for testing
; a character you're building, but must be changed accordingly.

[Data]
life = 1000           ;Amount of life to start with
attack = 100         ;100% attack power (more is stronger)
defence = 100        ;100% defensive power (more is stronger)
fall.defence_up = 70 ;Def goes up by 50% everytime player is hit on ground
liedown.time = 20    ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 15       ;Can do 15 points of juggling
sparkno = 0        ;Default spark number
guard.sparkno = 40 ;Default guard spark number
KO.echo = 0          ;1 to enable echo on KO
volume = 255

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 20     ;Player width (back, ground)
ground.front = 20     ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
z.width = 3          ;Player width (into and out)
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 165    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
mid.pos = 0,-40

[Velocity]
walk.fwd  = 3.0      ;Walk forward
walk.back = -2.5     ;Walk backward
run.fwd  = 7.9,-3    ;Run forward (x, y)  - if y<0, player will hop
run.back = -7.6,-3 ;Run backward (x, y) - if y=0, player will run
jump.neu = 0, -8.7    ;Neutral jumping velocity (x, y)
jump.back = -3, 16.3    ;Jump back Speed (x, y)
jump.fwd = 3, -16.3       ;Jump forward Speed (x, y)
runjump.back = -2.55, -16.3 ;Running jump speeds (opt)
runjump.fwd = 4, -16.3      ;.
airjump.neu = 0, -16.3      ;.
airjump.back = -2.55, -16.3 ;Air jump speeds (opt)
airjump.fwd = 2.7, -16.3    ;.

[Movement]
airjump.num = 0     ;Number of air jumps allowed (opt)
airjump.height = 20  ;Minimum distance from ground before you can air jump (opt)
yaccel = .43         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching


