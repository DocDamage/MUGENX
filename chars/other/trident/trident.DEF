; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Trident"        ;Name of character
displayname = "Trident" ;Name of character to display
versiondate = 04,01,2001    ;Version date of character
mugenversion = 04,01,2001   ;Version of M.U.G.E.N character works on
author = "Keioh"         ;Character author name


; Files for the player
[Files]
cmd     = tridcmd.cmd   ;Command set
cns     = tridcnsAI2.cns   ;Constants
st      = tridcnsAI2.cns   ;States
st2     = larcen.cns
st3     = jetta.cns
st4     = ayudantes2.cns
st5     = ramses.cns
st6     = tridentarmour2.cns
st7    = tridentarmour3.cns
stcommon = common1.cns ;Common states
sprite  = trident.sff   ;Sprite
anim    = tridair.air   ;Animation
sound   = trident.snd   ;Sound
pal1    = trident.act  
pal2    = trident2.act
pal3    = trident3.act
pal4    = trident6.act  
pal5    = trident5.act
pal6    = trident4.act
pal7    = trident7.act


[Arcade]
intro.storyboard  = introtrident.def