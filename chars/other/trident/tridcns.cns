type = S 
velset = 0 

[State 180, 1] 
type = ChangeState 
trigger1 = command = "holda" 
value = 181 

[State 180, 2] 
type = ChangeState 
trigger1 = command = "holdb" 
value = 182 


[State 180, 2] 
type = ChangeState 
trigger1 = command = "holdc" 
value = 183


[State 180, 3] 
type = VarRandom 
trigger1 = Time = 0 
v = 1 
range = 0,2 ; Variable de 0 a 2 

[State 180, 4] 
type = ChangeState 
trigger1 = time = 1 
value = 180 + var(1)

