walk.back = -3
run.fwd  = 5.6, 0
run.back = -5.5,-4.8
jump.neu = 0,-9.5
jump.back = -3.4
jump.fwd = 3.4
runjump.back = -3.55,-9.1
runjump.fwd = 5,-9.1
airjump.neu = 0,-9.1
airjump.back = -3.55,-9.1
airjump.fwd = 3.5,-9.1

[Movement]
