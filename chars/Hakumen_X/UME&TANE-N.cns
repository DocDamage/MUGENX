type = DefenceMulSet
trigger1 = 1
value = 1.2

[State 101,End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------
; obNXebv
;------------------------ Jn
[Statedef 105]
type = S
movetype = I
physics = N
anim = 105
ctrl = 0
velset = 0, 0

[State 105,VelSet]
type = VelSet
trigger1 = AnimElem = 2
x = Const(velocity.run.back.x)

[State 45, PlaySnd]
type = PlaySND
trigger1 = AnimElem = 2,=0
value = 1,1

[State 105, VelMul]
type = VelMul
trigger1 = AnimElem = 2, > 0
x = .95

[State 4150,0]
type = NotHitBy
trigger1 = AnimElem = 2, >= 0 && AnimElem = 5, < 0
value = SCA

[State 105,VelSet]
type = VelSet
trigger1 = AnimElem = 5
x = 0

[State 100,6]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 101,End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

