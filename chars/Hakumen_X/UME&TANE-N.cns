[Statedef 180]
type = S

[State 192,1]
type = AssertSpecial
trigger1 = 1
flag = nobardisplay

[State 180,ChangeState]
type = ChangeState
triggerall = Time = 0 && var(39)!=0
trigger1 = Command = "hold_y"
value = IfElse((var(39)=1),181,183)

[State 180,ChangeState]
type = ChangeState
triggerall = Time = 0 && var(39)!=0
trigger1 = Command = "hold_a"
value = IfElse((var(39)=1),182,184)

[State 180,ChangeState]
type = ChangeState
trigger1 = Time = 1 && var(39)!=0
value = IfElse((Random = [0,499]),IfElse((var(39)=1),181,183),IfElse((var(39)=1),182,184))

[State 180,ChangeState]
type = ChangeState
trigger1 = Time = 1 && var(39)=0
value = IfElse((Random = [0,249]),181,IfElse((Random = [250,499]),182,IfElse((Random = [500,749]),183,184)))

