;===============================================================================
; Definition of the Basic Action
;===============================================================================

;-------------------------------------------------------------------------------
; _bV
[Statedef 100]
type    = S
movetype = I
physics = N
anim = 100
ctrl = 0

[State 100,0]
type = VelSet
trigger1 = AnimElem = 2
x = Const(velocity.run.fwd.x)

[State 100,1]
type = ChangeState
trigger1 = Command != "holdfwd"
value = 101
ctrl = 0

[State 100,2]
type = ChangeState
trigger1 = Command = "holdupfwd"
value = 40

[State 1000, 3]
type = DefenceMulSet
trigger1 = 1
value = 1.2

[State 100,4]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

;------------------------ ~
