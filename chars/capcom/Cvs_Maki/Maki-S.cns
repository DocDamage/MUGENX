;-------------------------------------------------------------------------------
; 疾駆け
[Statedef 1100]
type    = S
movetype = I
physics = S
anim = 1100
ctrl = 0
poweradd = floor(72*fvar(5))

[State 100,0]
type = VelSet
trigger1 = PrevStateNo != 1230
x = 0
y = 0

[State 100,1]
type = PlaySnd
trigger1 = Time = 0
value = 0, 8
channel = 0

[State 100,0]
type = VelSet
trigger1 = 1
x = 7.5

[State 105,PlaySnd]
type = PlaySnd
trigger1 = Time = 0
trigger1 = PrevStateNo != 1230
value = 1, 2
channel = 5

[State 105,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 3,=1
value = 1, 3
channel = 5

[State 105,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 6,=1
value = 1, 4
channel = 5

[State 100,4]
type = ChangeState
trigger1 = Time > 2
trigger1 = Command = "Hassoukyaku_a" || Command = "Hassoukyaku_b" || Command = "Hassoukyaku_c"
value = 1200
ctrl = 0

[State 100,4]
type = ChangeState
triggerall = Time > 2
trigger1 = Command = "a" || Command = "b" || Command = "c"
value = IfElse((Command = "a"),1110,IfElse((Command = "b"),1120,1150))
ctrl = 0

[State 100,4]
type = ChangeState
trigger1 = Time >= 44
value = 1110
ctrl = 0

[State 100,6]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

