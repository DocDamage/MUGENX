;-------------------------------------------------------------------------------
; 拳コ・弱
[Statedef 1000]
type    = S
movetype= A
physics = N
velset = 0,0
anim = 1000
ctrl = 0
poweradd = floor(72*fvar(5))
juggle  = 8+(MoveHit&&P2StateType = A)*8

[State -2,VarSet]
type = VarSet
trigger1 = Time = 0
var(20) = -25

[State -2,VarSet]
type = VarSet
trigger1 = Time = 0
var(21) = -55

[State 100,1]
type = PlaySnd
trigger1 = AnimElem = 2
value = 0, 16
channel = 0

[State 100,1]
type = PlaySnd
trigger1 = AnimElem = 3
value = 4,2

[State 1100,VelSet]
type = VelSet
trigger1 = AnimElem = 4
x = 6

[State 105, VelMul]
type = VelMul
trigger1 = 1
x = .85

[State 1100,VelSet]
type = VelSet
trigger1 = AnimElem = 7
x = 0

[State 1321, HitDef]
type = HitDef
trigger1 = AnimElem = 5
attr = S, SA
damage = 77,10
animtype = UP
getpower = floor(IfElse(var(41)>1,72,143)*fvar(5)),floor(36*fvar(5))
guardflag = M
hitflag = MAF
hitsound = S5,2
guardsound = S6,0
pausetime = Ceil(15*IfElse((Var(30)=2&&Fvar(8)),.5,1)),Ceil(15*IfElse((Var(30)=2&&Fvar(8)),.5,1))
sparkno = S(Var(27)+10)
guard.sparkno = S2045
sparkxy = -25,-55
ground.type = Low
ground.slidetime = 20
ground.hittime  = 20
ground.velocity = -4.5,-7
air.velocity = -4.5,-7
guard.velocity = -10
guard.cornerpush.veloff = -18
air.cornerpush.veloff = 0
yaccel = .5
air.juggle = 8
fall = 1
fall.recover = !(Var(30) = 2 && Fvar(8))
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
palfx.time = 15*var(34)
palfx.add = 255,255,255
palfx.mul = 130,130,130

[State 400,StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 6
movetype = I

[State 400,End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

