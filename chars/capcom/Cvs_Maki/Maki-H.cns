type = S
movetype = I
physics = N
anim = 3001

[State 105, VelMul]
type = VelMul
trigger1 = 1
x = .95

[State 1100,VelSet]
type = VelSet
trigger1 = AnimElem = 3
x = 0

[State 1000, 0]
type = AfterImageTime
trigger1 = AnimElem = 3
time = 0

[State 101,End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

