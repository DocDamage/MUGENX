; Definition file for Strider Hien
; Made by K3nShiN

; Player information
[Info]
name = "Strider Hien"        ;Name of character
displayname = "Strider Hien" ;Name of character to display
versiondate = 010/24/2000    ;Version date of character
mugenversion = 06,27,2000   ;Version of M.U.G.E.N character works on
author = "K3nShiN"         ;Character author name
pal.defaults = 1, 3, 2, 4  ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = Hien.cmd   ;Command set
cns     = Hien.cns   ;Constants
st      = Hien.cns   ;States
stcommon = common1.cns ;Common states
sprite  = Hien.sff   ;Sprite
anim    = Hien.air   ;Animation
sound   = Hien.snd   ;Sound
pal1    = u_hien-white.act  ;Palettes (can have up to 12)
pal2    = m_hien-white.act
pal3    = u_hien-gray.act
pal4    = m_hien-gray.act