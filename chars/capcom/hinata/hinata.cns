;---------------------------------------------------------------------------;
;                             Variables                                     ;
;---------------------------------------------------------------------------;
; Var(1)  = Winstate Decider
; var(2)  = Light/Medium/Strong Attacks
; var(3)  = Rengekiken Addon
; var(4)  = Double Kiaidan time fix
; var(5)  = Hyper Moves Cancel Controller
; var(6)  = Hassen Enbukyaku Cancel Controller
; var(7)  =
; var(9)  =
; var(10) =
; var(11) =
; var(12) =
; var(13) =
; var(14) = 
; var(15) = 
; var(16) = 
; var(17) = Long Jump Controler
; var(18) = Air Combo fix
; var(59) = Special Winposes

;---------------------------------------------------------------------------;
;                              Constants                                    ;
;---------------------------------------------------------------------------;

[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1           
yscale = 1           
ground.back = 18
ground.front = 18
air.back = 12        
air.front = 12       
height = 60          
attack.dist = 160    
proj.attack.dist = 90 
proj.doscale = 0     
head.pos = -5, -90   
mid.pos = -5, -60    
shadowoffset = 0     
draw.offset = 0,0    

[Velocity]
walk.fwd  = 3
walk.back = -2.7
run.fwd  = 4.6, 0    
run.back = -4.5,-3.8 
jump.neu = 0,-8.4    
jump.back = -3.05
jump.fwd = 3
runjump.back = -4.5,-8.1
runjump.fwd = 4.5,-8.1
airjump.neu = 0,-8.1      
airjump.back = -2.55      
airjump.fwd = 2.5         

[Movement]
airjump.num = 0      
airjump.height = 35  
yaccel = .44         
stand.friction = .85  
crouch.friction = .82

