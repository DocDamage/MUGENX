;---------------------------------------------------------------------------
; Win state decider
[Statedef 180]
type = S

[State 180, 1]
type = VarRandom
trigger1 = Time = 0
v = 1
range = 0, 3

[State 180, 3]
type = ChangeState
triggerall = var(59) = 1
trigger1 = Time = 1
value = 184

[State 180, 3]
type = ChangeState
triggerall = !var(59)
trigger1 = Time = 1
value = 180 + var(1)

