;---------------------------------------------------------------------------
; Jump After Launcer
[Statedef 257]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 257, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 257, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 257, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 257, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1) = 0, const(velocity.jump.neu.x), ifelse(sysvar(1) = 1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))
y = const(velocity.jump.y)*1.1

[State 257, 5]
type = Explod
trigger1 = Time = 1
anim = ifelse(sysvar(1)=0, 8070, ifelse(sysvar(1)=1, 8080, 8090))
ID = 8070
postype = p1
pos = 0,0
bindtime = 1
sprpriority = -1
ownpal = 1

[State 257, 6]
type = Playsnd
trigger1 = Time = 1
value = s4000, ifelse((prevstateno = 100 || var(17) = 1), 14, 13)

[State 257, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

