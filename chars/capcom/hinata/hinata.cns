; Dash Back
[Statedef 105]
type = S
movetype = I
physics = S
anim = 105
sprpriority = 1
ctrl = 0
Velset = 0, 0

[State 105, 1]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 105, 2]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 105, 3]
type = Playsnd
trigger1 = time = 0
value = s4000,16

[State 105, 4]
type = Explod
trigger1 = Time = 1
Anim = 8110
ID = 8110
pos = 0, 3
postype = p1
ownpal = 1
bindtime = 1
pausemovetime = -1
supermove = 1
ignorehitpause = 1
sprpriority = 2

[State 105, 5]
type = ChangeState
trigger1 = Animtime = 0
value = 106
ctrl = 0

;---------------------------------------------------------------------------;
; Dash Back
