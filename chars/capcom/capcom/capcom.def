
; Player information
[Info]
name = "Captain Commando"        ;Name of character
displayname = "Captain Commando" ;Name of character to display
versiondate = 04,14,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "Splode"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = capcom.cmd   ;Command set
cns     = capcom.cns   ;Constants
st      = capcom.cns   ;States
stcommon = common1.cns ;Common states
sprite  = capcom.sff   ;Sprite
anim    = capcom.air   ;Animation
sound   = capcom.snd   ;Sound
pal1    = capcom.act  ;Palettes (can have up to 12)
pal2    = alt1.act
pal3    = alt2.act
pal4    = alt3.act
pal5    = alt4.act
pal6    = alt5.act

; Arcade mode
[Arcade]
