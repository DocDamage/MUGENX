; Definition file for Megaman1
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Megaman1"           ;Name of character
displayname = "Megaman"   ;Name of character to display
versiondate = 02,14,2002    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "Jin Kazama"       ;Character author name
pal.defaults = 1            ;Default palettes in order of preference

; Files for the player
[Files]
cmd      = megaman1.cmd    ;Command set
cns      = megaman1.cns    ;Constants
st       = megaman1.cns    ;States
st1      = rush.cns        ;Rush's states
st2      = megabust.cns    ;Mega Buster Weapons
st3      = p2states.cns    ;P2 Get Hit states
stcommon = common1.cns     ;Common states
sprite   = megaman1.sff    ;Sprite
anim     = megaman1.air    ;Animation
sound    = megaman1.snd    ;Sound
pal1     = megaman01.act   ;Red
pal2     = megaman02.act   ;Light Green
pal3     = megaman03.act   ;Purple
pal4     = megaman04.act   ;Blue
pal5     = megaman05.act   ;Orange
pal6     = megaman06.act   ;Charcoal
pal7     = megaman07.act   ;Saikyo
pal8     = megaman08.act   ;Dark Grey
pal9     = megaman09.act   ;Golden Yellow
pal10    = megaman10.act   ;Brown
pal11    = megaman11.act   ;Green
pal12    = megaman12.act   ;Olive

; Arcade mode
;[Arcade]
;ending.storyboard = megaend.def
