; Rush Win Pose (being held by Megaman)
[Statedef 1126]
type = S
ctrl = 0
anim = 1103
velset = 0,0
physics = N
sprpriority = -4

[state 1126,1]
type = velset
trigger1 = time = 0 && rootdist x = [60, 4000]
x = 3.5

[state 1126,2]
type = velset
trigger1 = time = 0 && rootdist x = [-4000, 50]
x = -3.5

[state 1126,3]
type = changeanim
trigger1 = anim != 1104 && vel x < 0
value = 1104

[state 1126,4]
type = velmul
trigger1 = rootdist x = [40,50]
x = 0

[state 1126,5]
type = ChangeAnim
trigger1 = anim != 1126 && rootdist x = [40,50]
value = 1126

[state 1126,6]
type = sprpriority
trigger1 = anim = 1126
value = 5
