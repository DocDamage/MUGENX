; Super Jump Up/Fwd 
[Statedef 9850] 
type    = A 
physics = A 


;--[Starting S-Jump Efects...] --

[State 9850, 3] 
type = MakeDust 
trigger1 = Vel Y < -10 && gametime % 3
pos = 10-ceil(random/50),-2 
spacing = 1 

[State 9850, sound1] 
type=PlaySnd 
trigger1 = time=0;1
value = 8,0;3,5 
persistent = 0 
channel = 1 

;--[Finishing S-Jump Efects...] --

[State 9850, 1] 
type = VarSet 
trigger1 = Time = 0 
sysvar(1) = 0 

[State 9850, VelAdd] 
type = VelSet 
triggerall = var(10) = 1
trigger1 = (var(20) = 0) && (command = "holdfwd") && (command != "holdback") 
trigger2 = var(20) = 1 && P2bodydist x > 10 && abs(P2bodydist y)<abs(Const(size.head.pos.y))
trigger3 = p2bodydist X > 50 && var(20)=1 && (enemynear, pos y < 0)
x = 4 

[State 9850, 2] 
type = ChangeAnim 
trigger1 = Time = 0 
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43)) 

[State 9850, 3] 
type = ChangeState 
trigger1 = AnimTime = 0 
trigger2 = (Vel y > -2) && (SelfAnimExist(anim + 3))
value = 9851 

