[Statedef 5123] 
type    = C 
movetype= I 
physics = N 
ctrl = 0 
Anim = 5122 + (var(3)=2)
sprpriority = -2
velset=0,0

[State 182, 2]
type = PlayerPush
trigger1 = 1
value = 0

[State 1005, 8]
trigger1 = pos y > 0;time = 0
type = posset
y=0

[State 5123, 2]
type = Velset;add 
triggerall = anim != 5125
trigger1 = AnimElemTime(2) = 0
x = -8 + 16 * (var(3)=2)

[State 900, VelSet 2]
type = VelSet
trigger1 = animelem = 1 && anim = 5125
;trigger2 = animelem = 2 && anim = 5125
;trigger3 = animelem = 3 && anim = 5125
trigger4 = time = 0
x = (vel x) / 2
y = 0

[State 5123, 3] 
type = NotHitBy 
trigger1 = 1 
value = SCA 
time = 1 

[State 5123, 6] 
type = NotHitBy 
triggerall = anim = 5125
trigger1 = AnimTime = 0 
value = , NT,ST,HT 
time = 12 

[State 5123, 7] 
type = Changeanim 
triggerall = anim != 5125
triggerall = time > 8
trigger1 = backedgedist < 50 && vel x < 0
trigger2 = frontedgedist < 50 && vel x > 0
trigger3 = abs(p2bodydist x) < 20
value = 5125

[State 5123, 7] 
type = Statetypeset
triggerall = anim = 5125
trigger1 = animelem = 1
statetype = S

[State 5123, 7] 
type = ChangeState 
triggerall = anim = 5125
trigger1 = animtime = 0 
value = 0 
ctrl = 1 
