;var(1) =Agarrar no combo
;var(2) =Magia fraca, média ou forte.
;var(3) =Air Combo
;var(4) =hit Counter / Pantonerre: quantidade de hits do hiper
;var(5) =Número de helpers / projéteis do adversário
;var(6) =Número de helpers / projéteis ameaçadores
;var(7) =Congela power bar no Especial infinito
;var(8) =Plasma Combo (extensão)
;var(9) =Power Up: Duração (1000)
;var(10)=Super pulo: deslocamento horizontal
;var(11)=Schwarzaile: direção do ataque
;var(12)=Schwarzaile: mais de um ataque
;var(13)=Força do combo
;var(14)=Contador do Advanced-Guard
;var(15)=Schwarzaile: contador de ataque
;var(16)=Fantome: contador de fantasma grudado
;var(17)=Estou em DOS ou WinMugen?
;var(20)=AI
;var(38)=TAG-TEAM:ajuda
;
; Sonson's constants and state file.
[Data] 
life=1000 
attack=100 
defence=85;100 
power=5000 
fall.defence_up=50 
liedown.time=20
airjuggle=100 
sparkno = s900;0,7 
guard.sparkno = s910;0,20 
KO.echo=0 
volume=0 
IntPersistIndex=0 
FloatPersistIndex=0 
echo=0 

[Size]
xscale = 1            ;Horizontal scaling factor.
yscale = 1            ;Vertical scaling factor.
ground.back = 30      ;Player width (back, ground)
ground.front = 18     ;Player width (front, ground)
air.back = 16         ;Player width (back, air)
air.front = 18        ;Player width (front, air)
height = 60           ;Height of player (for opponent to jump over)
attack.dist = 160     ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0      ;Set to 1 to scale projectiles too
head.pos = 4,-62     ;Approximate position of head
mid.pos = 0,-39       ;Approximate position of midsection
shadowoffset = 0      ;Number of pixels to vertically offset the shadow
draw.offset = 0,0     ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.6
walk.back = -2.4
run.fwd  = 7,0;5.2, 0     ;Run forward (x, y)
run.back = -5.5,-4.2      ;Hop backward (x, y)
jump.neu = 0,-9.55         ;Neutral jumping velocity (x, y)
jump.back = -2.45         ;Jump back Speed (x, y)
jump.fwd = 2.65            ;Jump forward Speed (x, y)
runjump.back=-4.5,-8.1
runjump.fwd=5.5,-8.1 
airjump.neu=0,-9.5 
airjump.back=-3,-9.5 
airjump.fwd=3,-9.5 

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
yaccel = .40;.44         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

