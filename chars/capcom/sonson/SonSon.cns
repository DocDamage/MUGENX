[State 9851, VelAdd3] 
type = VelSet 
trigger1 = (var(10) = 1 && vel X <= 0 && command = "holdback") 
x = -1 

[State 9851, 3] 
type = ChangeAnim 
triggerall = anim = 41 || anim = 42 || anim = 43 
trigger1 = (Vel y > -2) && (SelfAnimExist(anim + 3)) 
persistent = 0 
value = Anim + 3 

