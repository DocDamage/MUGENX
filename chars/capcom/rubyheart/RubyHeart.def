; Definition file for kfm
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Ruby Heart"        ;Name of character
displayname = "Ruby Heart" ;Name of character to display
VersionDate=03,12,2006
MugenVersion=04,14,2000
author = "Ryou Win"         ;Character author name
;pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = RubyHeart.cmd   ;Command set
cns     = RubyHeart.cns   ;Constants
st      = RubyHeart.cns   ;States
st2 = state-2.cns
st9 = TagBattle4.cns   ;Tag mode
stcommon = common1.cns ;Common states
sprite  = RubyHeart.sff   ;Sprite
anim    = RubyHeart.air   ;Animation
sound   = RubyHeart.snd   ;Sound
pal1    = RubyHeart1.act  ;Palettes (can have up to 12)
pal2    = RubyHeart2.act
pal3    = RubyHeart3.act
pal4    = RubyHeart4.act
;pal5    = RubyHeart5.act
;pal6    = RubyHeart6.act
;pal7    = amingo7.act
;pal8    = amingo8.act
;pal9    = amingo9.act
;pal10    = amingo10.act
;pal11    = amingo11.act  ;Palettes (can have up to 12)
;pal12    = amingo12.act

[Arcade]
;intro.storyboard=intro.def
ending.storyboard=MvsC2-end.def

