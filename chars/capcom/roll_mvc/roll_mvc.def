; Definition file for Roll
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Roll"               ;Name of character
displayname = "Roll"        ;Name of character to display
versiondate = 04,14,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "Thomas Hsieh"     ;Character author name
pal.defaults = 1,4,2,5      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = roll.cmd   ;Command set
cns     = roll.cns   ;Constants
st      = roll.cns   ;States
stcommon = common1.cns ;Common states
sprite  = roll.sff   ;Sprite
anim    = roll.air   ;Animation
sound   = roll.snd   ;Sound
pal4    = roll1.act  ;Palettes (can have up to 12)
pal5    = roll2.act
pal6    = roll3.act
pal1    = roll4.act
pal2    = roll5.act
pal3    = roll6.act
