

; Player information
[Info]
name = "Strider Hiryu"        ;Name of character
displayname = "Strider Hiryu" ;Name of character to display
versiondate = 05,6,2003    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2003   ;Version of M.U.G.E.N character works on
author = "Splode"         ;Character author name
pal.defaults = 1,2,3,6      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = hiryu.cmd   ;Command set
cns     = hiryu.cns   ;Constants
st      = hiryu.cns   ;States
stcommon = common1.cns ;Common states
sprite  = hiryu.sff   ;Sprite
anim    = hiryu.air   ;Animation
sound   = hiryu.snd   ;Sound
pal1    = hiryu.act  ;Palettes (can have up to 12)
pal2    = sassyhiryu.act
pal3    = dan.act
pal4    = darkblue.act
pal5    = yeller.act
pal6    = notchipp.act
pal7	= wtf.act
pal8	= bushin.act
pal9	= hiryu2.act
pal10	= mvchiryu.act
pal11 	= EVILSTRIDER.act
pal12	= uh.act

; Arcade mode
[Arcade]

