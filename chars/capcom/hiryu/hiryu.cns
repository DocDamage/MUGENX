triggerall = EnemyNear, statetype != C
triggerall = EnemyNear, Movetype = A
trigger1 = stateno = 152
value = 150

[State -2, Air guard]
type = ChangeState
triggerall = var(26) > 0
triggerall = StateType = A
triggerall = EnemyNear, Movetype = A
triggerall = StateNo != 132
trigger1 = ctrl = 1
value = 132

; End-of-tick updates

[State -2, Hit Count]
type = VarSet
trigger1 = var(7)
v = 9
value = HitCount

