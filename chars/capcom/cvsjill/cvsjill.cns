trigger1 = AnimTime = 0
trigger1 = !Var(4)
y = ifelse (Var(3) && !SysVar(1), const(velocity.jump.y)*1.15, const(velocity.jump.y))

[State 40, 9]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = Var(4)
y = ifelse (Var(3) && !SysVar(1), const(velocity.jump.y)*1.15*.75, const(velocity.jump.y)*.75)

[State 40, Position]
type = PosAdd
trigger1 = 1 && Var(3) && Vel X
x = -Vel X

[State 52, Effect]
type = PlaySnd
trigger1 = AnimTime = 0
value = 40, ifelse(var(3),1,0)
channel = 20

[State 40, 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

