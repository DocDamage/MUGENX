triggerall = command = "holdfwd" 
trigger1 = command = "hold_z" || command = "hold_y" || command = "hold_x"
trigger2 = command = "hold_a" || command = "hold_b" || command = "hold_c"
value = 5124 

[State 5120, 1a] ;Get up anim (normal) 
type = ChangeAnim 
triggerall = time = 0 
trigger1 = anim != 5111 
trigger2 = !animexist(5121) 
value = 5120 

[State 5120, 1b] ;Get up anim (for hit up) 
type = ChangeAnim 
triggerall = time = 0 
trigger1 = anim = 5111 
trigger1 = animexist(5121) 
value = 5121 

[State 5120, 2] 
type = VelSet 
trigger1 = Time = 0 
x = 0 

[State 5120, 3] 
type = VelAdd 
trigger1 = Time >= 10 
y = .6 

[State 5120, 3] 
type = NotHitBy 
trigger1 = 1 
value = SCA 
time = 20

[State 5120, 5] 
type = HitFallSet 
trigger1 = AnimTime = 0 
value = 1 

[State 5120, 6] ;Can't be thrown right after getting up 
type = NotHitBy 
trigger1 = AnimTime = 0 
value = , NT,ST,HT 
time = 12 

[State 5120, 6] ;Can't be hit right after getting up (short time) 
type = NotHitBy 
trigger1 = AnimTime = 0 
value2 = SCA 
time = 3 

[State 5120, 7] 
type = ChangeState 
trigger1 = Vel Y > 0 
trigger1 = Pos Y >= 0 
value = 5125 
