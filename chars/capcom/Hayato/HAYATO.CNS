triggerall = var(10) = 1
trigger1 = (var(20) = 0) && (command = "holdfwd") && (command != "holdback") 
trigger2 = var(20) = 1 && P2bodydist x > 10 && abs(P2bodydist y)<abs(Const(size.head.pos.y))
trigger3 = p2bodydist X > 50 && var(20)=1 && (enemynear, pos y < 0)
x = 4 

