; Definition file for kfm
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Hayato"        ;Name of character
displayname = "HAYATO" ;Name of character to display
VersionDate=22,08,2005
MugenVersion=04,14,2000
author = "Ryou Win"         ;Character author name
;pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = hayato.cmd   ;Command set
cns     = hayato.cns   ;Constants
st      = hayato.cns   ;States
st9 = TagBattle4.cns   ;Tag mode
stcommon = common1.cns ;Common states
sprite  = hayato.sff   ;Sprite
anim    = hayato.air   ;Animation
sound   = hayato.snd   ;Sound
pal1    = hayato.act  ;Palettes (can have up to 12)
pal2    = hayato2.act
pal3    = hayato3.act
pal4    = hayato4.act
pal5    = hayato5.act
pal6    = hayato6.act
pal7    = hayato7.act
pal8    = hayato8.act
;pal9    = Jill03.act
;pal10   = Jill04.act
;pal11   = Jill05.act
;pal12   = Jill07.act

[Arcade]
intro.storyboard=intro.def
ending.storyboard=sg2-end.def

