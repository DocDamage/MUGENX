;====================================
; Definition file for Kagami Kyôsuke (Capcom VS SNK 2)
;====================================
; Player information
[Info]
name = "CvS2Kyosuke"
displayname = "Kyosuke"
versiondate = 04,14,2001
mugenversion = 04,14,2001
author = "Byakko"
pal.defaults = 1,2,11,10

; Files for the player
[Files]
cmd      = Cvs2Kyosuke.cmd
cns       = Cvs2Kyosuke.cns
st         = Cvs2Kyosuke.cns
st1       = commonst.cns
st2      = super.cns
st3      = CrossCutter.cns
st4      = Synphony.cns
stcommon = common1.cns
sprite   = Cvs2Kyosuke.sff
anim     = Cvs2Kyosuke.air
sound  = Cvs2Kyosuke.snd
pal1     = Cvs2Kyosuke01.act ; light orange hair, blueish white uniform
pal2     = Cvs2Kyosuke02.act ; platine hair, dark grey uniform ; Hinata : red uniform, Batsu : black uniform
pal3     = Cvs2Kyosuke03.act ; red hair, blueish uniform ; Hinata : apple green uniform, Batsu : dirty green uniform
pal4     = Cvs2Kyosuke04.act ; light brown hair, light brownish uniform
pal5     = Cvs2Kyosuke05.act ; dark blonde hair, tanned skin, brownish uniform
pal6     = Cvs2Kyosuke06.act ; light brown hair, greenish white uniform
pal7     = Cvs2Kyosuke07.act ; brown hair, dark grey uniform
pal8     = Cvs2Kyosuke08.act ; blonde hair, black uniform
pal9     = Cvs2Kyosuke09.act ; brown hair, golden uniform ; Batsu & Hinata : golden uniform
pal10     = Cvs2Kyosuke10.act ; dark brown hair, brown skin, dark red uniform (same for Batsu & Hinata) : Silent Storm palette
pal11     = Cvs2Kyosuke11.act ; platine hair, black uniform ; Batsu & Hinata : black uniform : Matrix palette
pal12     = Cvs2Kyosuke12.act ; light brown hair, pink uniform (same for Batsu & Hinata) : Dan palette

