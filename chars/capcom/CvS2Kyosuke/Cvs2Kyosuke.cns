[State -2, Clipboard]
type = DisplayToClipboard
trigger1 = time
text = "hijump : %d, parry : %d, button : %d, direction : %d"; \n CvS2 Kagami Kyosuke by Byakko"
params = Var(1),var(3),var(4), var(5)
ignorehitpause = 1
