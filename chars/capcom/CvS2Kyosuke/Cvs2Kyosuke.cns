;==========================================
; Constants and state file for Capcom VS SNK 2 Kagami Kyôsuke
;==========================================
; var(1) : super jump
; var(2) : jump direction
; var(3) : parry, Tardy Counter
; var(4) : button level detection
; var(5) : GenEi kick chain, Hinata's and Batsu ID for Final Synphony Remix, Tardy counter StateType
; var(58) : AI (not implemented yet)
;---------------------------------------------------------------------------
[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 255
IntPersistIndex =
FloatPersistIndex =

[Size]
xscale = 1
yscale = 1
ground.back = 25
ground.front = 25
air.back = 12
air.front = 12
height = 70
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = 6, -93
mid.pos = -2, -67
shadowoffset = 0
draw.offset = 0,1

[Velocity]
walk.fwd  = 3.5
walk.back = -3
run.fwd  = 6.5,0
run.back = -6.5,0
jump.neu = 0,-9.3
jump.back = -2.9
jump.fwd = 2.8
runjump.back = 0,0
runjump.fwd = 0,0
airjump.neu = 0,0
airjump.back = 0
airjump.fwd = 0

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .45
stand.friction = .65
crouch.friction = .82
;---------------------------------------------------------------------------
; 
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1
;---------------------------------------------------------------------------
; Winpose
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = ifelse(command = "hold_p", 181, ifelse(command = "hold_k", 182, ifelse(random < 500, 181, 182)))
;---------------------------------------------------------------------------
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 1100, voice]
type = PlaySnd
trigger1 = AnimElem = 1
value = 181,0;2*(random<500)
channel = 1

[State 181, 1]
type = AssertSpecial
trigger1 = Time < 120
flag = roundnotover
;---------------------------------------------------------------------------
[Statedef 182]
type = S
ctrl = 0
anim = 182
velset = 0,0

[State 1100, voice]
type = PlaySnd
trigger1 = AnimElem = 1
value = 181,1+2*(random<500)
channel = 1

[State 181, 1]
type = AssertSpecial
trigger1 = Time < 160
flag = roundnotover
;---------------------------------------------------------------------------
; PREINTRO
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190, 3]
type = ChangeState
trigger1 = 1
value = 191
;---------------------------------------------------------------------------
;
[Statedef 191]
type = S
ctrl = 0
anim = 191
velset = 0,0

[State 191, Intro]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 1100, voice]
type = PlaySnd
trigger1 = AnimElem = 1, = 40
value = 191,0
channel = 1

[State 191, 2]
type = ChangeState
trigger1 = Anim = 191
trigger1 = AnimTime = 0
value = 0
;---------------------------------------------------------------------------
; Taunt
[Statedef 195]
type = S
movetype = I
physics = S
anim = 195
velset = 0
ctrl = 0

[State 195,ctrl]
type = ctrlset
triggerall = time > 25
trigger1 = command = "holdfwd"
trigger2 = command = "holdback"
trigger3 = command = "holdup"
trigger4 = command = "holddown"
value = 1

[State 1100, voice]
type = PlaySnd
trigger1 = AnimElem = 4
value = 195,(random%3)
channel = 1

[State 195, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
