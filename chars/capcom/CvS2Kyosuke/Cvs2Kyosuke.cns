;---------------------------------------------------------------------------
[state -2, SuperJumpReset]
type = varset
triggerall = var(1)
trigger1 = StateNo != [40,55]
var(1) = 0
;---------------------------------------------------------------------------
[State -2, Tardy Counter]
type = ChangeState
trigger1 = MoveType = A || StateNo = 800 || StateNo = 805
trigger1 = PrevStateNo = 151 || PrevStateNo = 153 || PrevStateNo = 155
trigger1 = Var(3) := StateNo
trigger1 = Var(5) := IfElse(PrevStateNo = 151, 1, IfElse(PrevStateNo = 153, 2, 3))
value = 855
;---------------------------------------------------------------------------
[State -2, AftImgEndFromSuper]
type = AfterImageTime
trigger1 = MoveType = H
value = 0
;---------------------------------------------------------------------------
[state -2, noai]
type = varset
trigger1 = var(58)
var(58) = 0
;---------------------------------------------------------------------------
[State -2, StopVoice]
type = StopSnd
trigger1 = MoveType = H
channel = 1
;---------------------------------------------------------------------------
[State -2, NoBar]
type = AssertSpecial
trigger1 = roundstate = [0,1]
trigger2 = roundstate = 4
trigger3 = Ctrl = 0 && Anim = 0 && MoveType != H
flag = NoBarDisplay
ignorehitpause = 1
;---------------------------------------------------------------------------
[state -2, ButtonLvReset]
type = varset
triggerall = var(4)
trigger1 = stateno != [1000,1600]
trigger1 = stateno != [2000,3020]
trigger1 = StateNo != 855
var(4) = 0
