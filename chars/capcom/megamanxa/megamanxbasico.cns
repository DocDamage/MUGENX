;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; Run Forwards
[Statedef 100]
type    = S
physics = N
anim = 100
sprpriority = 1
ctrl = 1

[State 0]
type = Explod
trigger1 = AnimElem = 3 || AnimElem = 6 || AnimElem = 9 || AnimElem = 12
anim = 720
;postype = p1
pos = 0, -5
bindtime = 1
ownpal = 1

[State 0]
type = Explod
trigger1 = AnimElem = 4 || AnimElem = 7 || AnimElem = 10
anim = 721
;postype = p1
pos = -1, -5
bindtime = 1
ownpal = 1

[State 0]
type = Explod
trigger1 = AnimElem = 5 || AnimElem = 8 || AnimElem = 11
anim = 722
;postype = p1
pos = -2, -5
bindtime = 1
ownpal = 1

[State 100, 0]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 1]
type = VelSet
trigger1 = AnimElem = 2
x = const(velocity.run.fwd.x)

[State 100, 1]
type = VelMul
trigger1 = AnimElem = 2, > 10
x = .9

[State 100, 2]
type = PlaySnd
trigger1 = AnimElem = 2
value = 0, 3

[State 100, 3]
type = ChangeState
trigger1 = Time >= 13
value = 101

;---------------------------------------------------------------------------
