; Definition file for Norimaro
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Norimaro"           ;Name of character
displayname = "Norimaro"    ;Name of character to display
versiondate = 10,18,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "Jin Kazama"       ;Character author name
pal.defaults = 1            ;Default palettes in order of preference

; Files for the player
[Files]
cmd      = Norimaro.cmd    ;Command set
cns      = Norimaro.cns    ;Constants
st       = Norimaro.cns    ;States
st2      = p2states.cns    ;P2 Get Hit states
stcommon = common1.cns     ;Common states
sprite   = Norimaro.sff    ;Sprite
anim     = Norimaro.air    ;Animation
sound    = Norimaro.snd    ;Sound
pal1     = Norimaro01.act  ;Purple
pal2     = Norimaro02.act  ;Blue
pal3     = Norimaro03.act  ;Green
pal4     = Norimaro04.act  ;Red
pal5     = Norimaro05.act  ;Orange
pal6     = Norimaro06.act  ;Yellow
pal7     = Norimaro07.act  ;White
pal8     = Norimaro08.act  ;Black
pal9     = Norimaro09.act  ;Pink
pal10    = Norimaro10.act  ;Tan
pal11    = Norimaro11.act  ;Light Blue
pal12    = Norimaro12.act  ;Light Purple


; Arcade mode
[Arcade]
ending.storyboard = noriend.def
