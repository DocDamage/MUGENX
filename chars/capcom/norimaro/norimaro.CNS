;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -2, 0]
type = DisplayToClipboard
trigger1 = 1
text = "Var9 = %d Var6 = %d Var11 = %d"
params = Var(9), Var(6), Var(11)

[state -2,0]
type = removeexplod
trigger1 = stateno != 100
id = 101

[State -2,1]
type = Explod
triggerall = time = 1
trigger1 = stateno = 52 || stateno = 653
anim = 456
postype = p1
pos = -5, 0
bindtime = 1
removetime = -2
sprpriority = -5

[state -2,2]
type = explod
trigger1 = p2stateno = 212 && p2movetype = H && numexplod(4446) = 0
persistent = 0
anim = 446
id = 4446
pos = -70,0
postype = p2
sprpriority = 5
velocity = 0, 0
bindtime = 1
ownpal = 1

[state -2,3]
