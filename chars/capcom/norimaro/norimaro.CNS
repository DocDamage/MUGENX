anim = 467
id = 467
postype = p1
pos = 0,0
ownpal = 1
bindtime = 1
sprpriority = 5
persistent = 0
removeongethit = 1

[state 90,6]
type = varset
trigger1 = 1
v = 6
value = 1

[State 90,6]
type = ChangeState
trigger1 = AnimTime = 0
value = 91
ctrl = 1
