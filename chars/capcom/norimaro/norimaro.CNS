[state -3,2]
type = afterimagetime
trigger1 = movetype = H
time = 0
 
[state -3, 1]
type = varset
trigger1 = statetype != A && ctrl
v = 6
value = 0

[state -3, 2]
type = varset
trigger1 = statetype != A && ctrl && stateno != 100
v = 9
value = 0

[state -3, 2]
type = varset
trigger1 = statetype != A && ctrl
v = 11
value = 0

[State -3, 3]
type = ScreenBound
trigger1 = Var(9) = 1 ; && var(11) < 32 && stateno != 100
value = 0
movecamera = 0,0

[State -3, 4]
type = ScreenBound
trigger1 = Var(9) = 0 ; || (statetype = A && var(11) >= 32)
value = 1
