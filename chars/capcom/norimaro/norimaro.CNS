persistent = 0
anim = 447
pos = -70,0
postype = p2
sprpriority = -5
velocity = 0, 0
bindtime = 1
ownpal = 1

[State -2,4]
type = VarSet
trigger1 = StateNo != 5050 && StateNo != 5071
v = 10
value = 0

[state -2,5]
type = assertspecial
trigger1 = numexplod(4000) != 0 || numexplod(4001) != 0
flag = noFG

[state -2,6]
type = stopsnd
trigger1 = stateno != [191,192]
trigger1 = Roundstate = 2
channel = 1

[State -2,7]
type = playsnd
triggerall = random < 250 && time = 1 && alive = 1
trigger1  = stateno = 5000 && anim = 5000 
trigger2  = stateno = 5000 && anim = 5001
trigger3  = stateno = 5000 && anim = 5010
trigger4  = stateno = 5000 && anim = 5011
trigger5  = stateno = 5010 && anim = 5020
trigger6  = stateno = 5010 && anim = 5021
trigger7  = stateno = 5020 && anim = 5000
trigger8  = stateno = 5020 && anim = 5001 
trigger9  = stateno = 5020 && anim = 5010
trigger10 = stateno = 5020 && anim = 5011 
value = 15, 0

[State -2,8]
