; Definition file for kfm
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Amingo"        ;Name of character
displayname = "Amingo" ;Name of character to display
VersionDate=10,22,2005
MugenVersion=04,14,2000
author = "Danielps & Ryou Win"         ;Character author name
;pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = amingo.cmd   ;Command set
cns     = amingo.cns   ;Constants
st      = amingo.cns   ;States
st2     = state-2.cns  ;States -2
st9 = TagBattle4.cns   ;Tag mode
stcommon = common1.cns ;Common states
sprite  = amingo.sff   ;Sprite
anim    = amingo.air   ;Animation
sound   = amingo.snd   ;Sound
pal1    = amingo1.act  ;Palettes (can have up to 12)
pal2    = amingo2.act
pal3    = amingo3.act
pal4    = amingo4.act
pal5    = amingo5.act
pal6    = amingo6.act
pal7    = amingo7.act
pal8    = amingo8.act
pal9    = amingo9.act
pal10    = amingo10.act
pal11    = amingo11.act  ;Palettes (can have up to 12)
pal12    = amingo12.act

[Arcade]
;intro.storyboard=intro.def
ending.storyboard=MvsC2-end.def

