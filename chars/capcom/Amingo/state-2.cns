; Quem_sou_eu [Var(39)]: 0-Morto, 1-Primeiro, 2-Segundo
; Colaboração [Var(38)]: 1-Lutar só, 2-Duplo Especial, 3-Um Ataque, 4-Counter
; Vez na luta [Var(37)]: 1-Primeiro, 2-Segundo
; Verificação [Var(36)]: Meu ID
;             [Var(35)]: 0-Proíbe sair de tela, 1-Permite sair de tela
; P3 life     [Var(34)]: Memoriza a vida
; Recuperação [Var(33)]: Memoriza a vida


;---------------------------------------------------------------------------
; States that are always checked (use -2) :
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, 1] ; debug
type = DisplayToClipboard
trigger1 = roundstate > 0
;text="eu39 %d, vez37 %d, Id %d, sair? %d";bake %d";
;params = Var(39), var(37),var(36),Var(35);floor(backedgedist);
;text="Q_s_e Var(49) %d, proj Var(6) %d, V_n_l Var(5) %d, pos y %d var(3) %d"
;params = Var(49), Var(6), Var(5), floor(pos y),var(3)
;text="39=37? %d, Colab %d, p3life %d, sair? %d";bake %d";
;params = (Var(39)=Var(37)), var(38),var(34),Var(35);floor(backedgedist);
text="p2bodydist x %d, p2bodydist y %d, var(33) %d, var(34) %d"
params = floor(p2bodydist x), floor(p2bodydist y), (var(33)),(var(34))

Decrementa o especial infinito
; =============================
[State -2, 1]
type = DefenceMulSet
trigger1 = 1;stateno=9000
value = 1 - 0.5 * (var(9)>0)

[State -2]
type = Varadd
triggerall = stateno!=2700;3500
trigger1 = var(9)>0
v=9
value = -2

[State -2]
type = removeexplod
trigger1 = var(9)>=0 && numexplod(3520)=1
id = 3520

[State -2]
type = removeexplod
trigger1 = var(9)>=0 && numexplod(3521)=1
id = 3521

[State -2]
type = removeexplod
