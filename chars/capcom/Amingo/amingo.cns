; Super Jump Up/Fwd 
[Statedef 9850] 
type    = A 
physics = A 


;--[Starting S-Jump Efects...] --

[State 9850, 3] 
type = MakeDust 
trigger1 = Vel Y < -10 && gametime % 3
pos = 10-ceil(random/50),-2 
spacing = 1 

[State 9850, sound1] 
type=PlaySnd 
trigger1 = 1
value = 3,5 
persistent = 0 
channel = 1 

;--[Finishing S-Jump Efects...] --

[State 9850, 1] 
type = VarSet 
trigger1 = Time = 0 
sysvar(1) = 0 

[State 9850, VelAdd] 
type = VelSet 
triggerall = var(10) = 1
trigger1 = (var(20) = 0) && (command = "holdfwd") && (command != "holdback") 
trigger2 = var(20) = 1 && P2bodydist x > 10 && abs(P2bodydist y)<abs(Const(size.head.pos.y))
trigger3 = p2bodydist X > 50 && var(20)=1 && (enemynear, pos y < 0)
x = 4 

[State 9850, 2] 
type = ChangeAnim 
trigger1 = Time = 0 
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43)) 

[State 9850, 3] 
type = ChangeState 
trigger1 = AnimTime = 0 
trigger2 = (Vel y > -2) && (SelfAnimExist(anim + 3))
value = 9851 

; Super Jump Up/Fwd Landing 
[Statedef 9851] 
type    = A 
physics = A 

[State 9851, turn] 
type = ChangeState 
trigger1 = p2dist x < 0 && vel Y > 0 
value = 9852 

[State 9851, 1] 
type = VarSet 
trigger1 = Time = 0 
sysvar(1) = 0 

[State 9851, VelAdd1] 
type = VelSet 
trigger1 = (var(10) = 1 && command = "holdfwd" && command != "holdback") 
x = 4 

[State 9851, VelAdd2] 
type = VelSet 
trigger1 = (var(10) = 1 && vel X > 0 && command = "holdback") 
x = 2.3 

[State 9851, VelAdd3] 
type = VelSet 
trigger1 = (var(10) = 1 && vel X <= 0 && command = "holdback") 
x = -1 

[State 9851, 3] 
type = ChangeAnim 
triggerall = anim = 41 || anim = 42 || anim = 43 
trigger1 = (Vel y > -2) && (SelfAnimExist(anim + 3)) 
persistent = 0 
value = Anim + 3 

; Super Jump Up/Fwd/Back Turning on Landing 
[Statedef 9852] 
type    = A 
physics = A 

[State 9852, turn] 
type = turn 
trigger1 = time = 0 

[State 9852, 1] 
type = VarSet 
trigger1 = Time = 0 
sysvar(1) = 0 

[State 9852, 3] 
type = ChangeAnim 
triggerall = anim = 41 || anim = 42 || anim = 43 
trigger1 = (Vel y > -2) && (SelfAnimExist(anim + 3)) 
persistent = 0 
value = Anim + 3 

