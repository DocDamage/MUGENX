;===================================================================================================
;Revenge system =)
;===================================================================================================
[State -2,revenge]
type = VarSet
trigger1 = roundstate = 0
var(30) = (p2life - 1000)

[State -2,revenge]
type = AttackMulSet
trigger1 = var(30) > 0
value = ifelse(var(30)<=250,1+var(30)*0.002,1.5)

[State -2,revenge]
type = DefenceMulSet
trigger1 = var(30) > 0
value = ifelse(var(30)<=250,1-var(30)*0.002,0.5)


