bindtime = 1

[State 5110, 8]
type = envshake
trigger1 = time = 2
time = 2
freq = 100
ampl = -4
phase =100

[State 5110, 9]
type = VelSet
trigger1 = Time = 0
y = 0

[State 5110, 10] ;For hit up type
type = ChangeAnim
persistent = 0
triggerall = anim = [5171,5179]
triggerall = SelfAnimExist(5110 + (anim % 10))
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground anim
