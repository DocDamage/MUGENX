;-----
;Stand
;-----
[Statedef 0]
type = S
physics = S
sprpriority = -2

[State 0,0]
type = ChangeState
triggerall = Var(45) = 0
trigger1 = Var(44) >= 1500
value = 5905
ctrl = 0

[State 0,1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0,2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0,3]
type = PosSet
trigger1 = Time = 0
y = 0

[State 0,4] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

