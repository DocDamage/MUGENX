;---------------------------------------------------------------------------
; 亀舞
[Statedef 1000]
type    = S
movetype= A
physics = S
juggle  = 4
poweradd= 100
velset = 0,0
anim = 1000
ctrl = 0
sprpriority = 2

;[State 1000, 1]
type = PlaySnd
trigger1 = Time = 1
value = S8, 3

[State 1000, 2]
type = PosAdd
trigger1 = AnimElem = 1
x = 15

[State 1000, 3]
type = PosAdd
trigger1 = AnimElem = 2
x = 20

[State 1000, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 1001

;------------------
; ハッパ（大）・空中動作
; 
[Statedef 1001]
type    = A
movetype= A
physics = N
velset = 3.5,-5
anim = 1001
hitdefpersist = 0 ;攻撃が当たった場合その動きのままにするか（１でＯＮ）

[State 1001, 1] ;これがここだけの重力設定
type = VelAdd
trigger1 = 1
y = .75

[State 1001, 2] ;設定した値に達したらチェンジステート
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= -1
value = 1002

;------------------
; ハッパ（大）・着地

[Statedef 1002]
type    = S
movetype= A
physics = S
juggle  = 4
poweradd= 110
velset = 0,0
anim = 1002
ctrl = 0
sprpriority =2

[State 1002, 1] ;地面に設置させるステート
type = PosSet
trigger1 = Time = 0
y = 0

[State 1003, 5]
type = HitDef
trigger1 = AnimElem = 2
attr = S, SA
animtype  = hard
damage    = 100,10
priority  = 6
guardflag = MA
pausetime = 12,12
hitsound   = S31,4
guardsound = 6,0
ground.type = High
ground.slidetime = 5
ground.hittime  = 15
ground.velocity = -2.5,-5
air.velocity = -2.5,-4.5
palfx.time = 50
palfx.mul = 240,220,128
palfx.add = 160,50,50
palfx.mul = 140,50,50
palfx.sinadd = 30,50,70,20
fall =1

[State 1003, 3] ;ここで十三を操作可能に戻す
type = CtrlSet
trigger1 = AnimElem = 5, -1
value = 1

[State 1003, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

