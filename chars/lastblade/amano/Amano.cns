type = S
ctrl = 0
velset = 0,0,0

[state 2000,1]
type = changeanim
trigger1 = time = 0
trigger1 = matchover = 1
value = 182

[state 2000,1]
type = changeanim
trigger1 = time = 0
trigger1 = matchover != 1
value = 183

