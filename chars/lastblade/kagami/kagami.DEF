; Definition file for Shinnosuke Kagami
; Contains all the filenames needed for the character

; Character information
[Info]
name         = "Shinnosuke Kagami"  ;
displayname = "Kagami"             ; If your fonts cannot accomodate long
                                    ;names, try using his displayname.
versiondate  = 06,16,2000           ;Version date of character
mugenversion = 04,14,2001           ;Version of M.U.G.E.N character works on
author       = "Orochi Herman"      ;Character author name
pal.defaults = 4,5,6,1,2,3          ;Default palettes in order of preference

; Files for the character
[Files]
cmd      = kagami.cmd     ;Command set
cns      = kagami.cns     ;Constants
st       = kagami.cns     ;States
st1      = constant.cns
st2      = override.cns   ; Overidden stuff from common1.cns
st3      = supers.cns     ;Super Moves
stcommon = common1.cns    ;Common states
sprite   = kagami.sff     ;Sprite
anim     = kagami.air     ;Animation
sound    = kagami.snd     ;Sound
pal4     = original.act
;pal4     = kagami.act     ;LB Original Color
pal5     = power2.act     ;LB2 Power Alternate Color
pal6     = speed1.act     ;LB2 Speed Color
pal1     = speed2.act     ;LB2 Speed Alternate Color
pal2     = ex1.act        ;LB2 EX Color
pal3     = ex2.act        ;LB2 EX Alternate Color
pal7     = green.act      ;Green Color
pal8     = gold.act       ;Gold Bison...este Gold Kagami...>:P
pal9     = vampire.act    ;Vampire Color
pal10    = mono.act       ;Monochrome
