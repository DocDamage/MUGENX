; Rugal's constants. Wait, it's Kagami's Constants now!
; Format (case insensitive):
;  [groupname]        
;  constname = value  

[Data]
life = 1200          ;Amount of life to start with
attack = 140         ;100% attack power (more is stronger)
defence = 115        ;100% defensive power (more is stronger)
fall.defence_up = 50 ;Def goes up by 50% everytime player is hit on ground
liedown.time = 30    ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 5        ;Can do 15 points of juggling
sparkno = 0,7        ;Default spark number
guard.sparkno = 0,20 ;Default guard spark number
KO.echo = 0          ;1 to enable echo on KO

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 20     ;Player width (back, ground)
ground.front = 26    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
z.width = 3          ;Player width (into and out)
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 460    ;Default attack distance
proj.attack.dist = 220 ;Default attack distance for projectiles

[Velocity]
walk.fwd  = 2        ;Walk forward
walk.back = -2     ;Walk backward
run.fwd  = 8.4, 0    ;Run forward (x, y)  - if y<0, player will hop
run.back = -5.1,-3.91     ;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-8    ;Neutral jumping velocity (x, y)
jump.back = -2.55,-6    ;Jump back Speed (x, y)
jump.fwd = 2.5,-6       ;Jump forward Speed (x, y)
runjump.back = -5,-9 ;Running jump speeds (opt)
runjump.fwd = 4,-9      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55,-8.1 ;Air jump speeds (opt)
airjump.fwd = 2.5,-8.1    ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .43        ;Vertical acceleration
stand.friction = -0.63  ;Friction coefficient when standing
crouch.friction = -0.63 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; LOSE (Time over)
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0,0

[State 170, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

[State 170, 2]
type = playsnd
trigger1 = animelem = 3
value = s0,34

;---------------------------------------------------------------------------
; WIN
[Statedef 180]
type = S

[State 180, 1]
type = VarRandom
trigger1 = Time = 0
v = 1
range = 1,3

[State 180, 2] ;Choose win1
type = VarSet
trigger1 = Command = hold_x
v = 1
value = 1

[State 180, 3] ;Choose win2
type = VarSet
trigger1 = Command = hold_y
v = 1
value = 2

[State 180, 4] ;Choose win3
type = VarSet
trigger1 = Command = hold_z
v = 1
value = 3

;[State 180, 5] ;Choose win4
;type = VarSet
;trigger1 = Command = hold_a
;v = 1
;value = 4

;[State 180, 6] ;Choose win5
;type = VarSet
