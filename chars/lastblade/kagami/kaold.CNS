;v = 1
;value = 5

;[State 180, 7] ;Choose win6
;type = VarSet
;trigger1 = Command = hold_c
;v = 1
;value = 6

[State 180, 8]
type = ChangeState
trigger1 = Var1 = 1
value = 181

[State 180, 9]
type = ChangeState
trigger1 = Var1 = 2
value = 182

[State 180, 10]
type = ChangeState
trigger1 = Var1 = 3
value = 183

