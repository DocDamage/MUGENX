[state haha]
type = varset
trigger1 = statetype != A
var(10) = 0
ignorehitpause = 1

[State 1010, 2]
type = VarRandom
trigger1 = alive && name = "Shinnosuke Kagami"
trigger1 = roundstate = 2
v = 1
range = 0,5
ignorehitpause = 1

[state haha]
type = playerpush
trigger1 = winko
value = 0
ignorehitpause = 1

[state haha]
type = varset
trigger1 = movetype != A
trigger2 = stateno >= 1000
var(9) = 0
ignorehitpause = 1

; Play "hmmph" sound when recovering in air or on ground
[State -2, 1]
type = PlaySnd
triggerall = Time = 1
trigger1   = stateno = 5201
trigger2   = stateno = 5210
value      = S0,31
channel = 0
persistent = 0

[State -2, Play Fly Sound]
type = PlaySnd
triggerall = Time = 1
triggerall = stateno != 2041
triggerall = stateno = 50
trigger1   = anim = 41
trigger2   = anim = 42
trigger3   = anim = 43
value      = S0,15
persistent = 0

[State -2, Delte Trails when hit]
type       = AfterImageTime
triggerall = Time = 0
trigger1   = movetype = h
time       = 0

[state -2, Remove Tendrill]
type     = RemoveExplod
trigger1 = movetype = h
id       = (2023)

[state -2, Remove Tendrill]
type     = RemoveExplod
trigger1 = movetype = h
id       = (2006)

[state -2, Varset for certain function Reset]
type     = Varset
trigger1 = stateno = 52
v        = 10
value    = 0

[state -2, Varset for Color Spark: Blue]
type     = Varset
trigger1 = life > 300
v        = 7
value    = 0

[state -2, Varset for Color Spark: Red]
type     = Varset
trigger1 = life < 400
v        = 7
value    = 1

[State -2, Varset Reset]
type     = VarSet
trigger1 = time = 6
v        = 11
value    = 0

[State -2, General PlaySnd for Something]
type       = PlaySnd
trigger1   = Anim = 501
trigger1   = AnimElem = 4
value      = S0,19
persistent = 0

[state -2, Varset for certain function Reset]
type     = Varset
trigger1 = statetype != A
trigger1 = stateno != 40
v        = 10
value    = 0

[state -2, PosAdd for Run Stop and similar ani's]
type     = PosAdd
trigger1 = anim = 105
trigger1 = animelem = 5
x        = 8

[State 1010, 2]
type = StopSnd
trigger1 = time = 0
trigger1 = var(22) = 1
channel = 1
persistent = 0

[State 1010, 2]
type = NotHitby
trigger1 = enemy, Const(data.defence) > 200 && 1
value = SCA
time = 214748364799999999

[State 1010, 2]
type = varset
triggerall = enemy, const(data.defence) >= 200
trigger1 = command != "hold_x" || command != "hold_y" || command != "hold_z"
v = 15
value = 0

[State -3, Ow Sound]
type = PlaySnd
triggerall = p1name = "shinnosuke kagami"
triggerall = alive && time = 1
trigger1 = stateno = 5001 || stateno = 5011
;trigger1 = (anim % 10) != 0 ;Not hit light
trigger1 = random < ifelse ((anim % 10) = 1, 400, 750)
trigger2 = stateno = 5040 || stateno = 5050
trigger2 = random < 500
trigger3 = stateno = 5070
trigger4 = stateno = 5100 && random < 250
value = S2,var(1)
channel = 0
;lowpriority = 1
ignorehitpause = 1

[State 210, KO Screen 1]
type = helper
triggerall = p1name = "shinnosuke kagami"
trigger1 = winko
;trigger1 = roundstate = 2 && alive
trigger1 = p1name = "shinnosuke kagami" && numhelper(6005) = 0
helpertype = normal
name = "6005"
id = (6005)
pos = 0,0
bindtime = -1
postype = left
stateno = 6005
keyctrl = 0
;persistent = 0
ignorehitpause = 1
ownpal = 1
pausemovetime = 214748364721474836479
supermovetime = 21474836479

[state 1002, Palfx]
type     = AssertSpecial
triggerall = p1name = "shinnosuke kagami" && movetype = H
trigger1 = roundno = 1
trigger2 = roundno >= 2 && var(30) = 0
flag = nokosnd
ignorehitpause = 1

[state 1002, Palfx]
type     = varset
triggerall = p1name = "shinnosuke kagami"
trigger1 = roundno = 1 && lose   ; If Setsuna loses round 1
var(30) = 1                      ; Var30 signifies this.

