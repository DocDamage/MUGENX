value    = s0,34

;---------------------------------------------------------------------------
; WIN (Determiner)
[Statedef 180]
type = S

[State 180, VarRandom]
type     = VarRandom
trigger1 = Time = 0
v        = 1
range    = 2

[State 180, Win 1 Choice]
type     = ChangeState
trigger1 = Command = "hold_x"
value    = 181

[State 180, Win 2 Choice]
type     = ChangeState
trigger1 = Command = "hold_y"
value    = 182

[State 180, Win 3 Choice]
type     = ChangeState
trigger1 = Command = "hold_z"
value    = 183

[State 180, 8]
type = ChangeState
trigger1 = Time = 1
value = 181 + var(1)

