; This is Kagami's CNS data, made by Orochi Herman, aka. Herman who is just a bum that had Orochi blood.

; var(1) = Standard randomizer
; var(2) = Old style  sound randomizer
; var(3) = guard cancel type randomizer
; var(4) = Guard Cancel selection
; var(5) = Mode Identifier
;		   0 = Standard Crossover Mode
;          1 = Power Mode
;  		   2 = Speed Mode
;  		   3 = Ex Mode
; var(6) = Power Type
;		   0 = Normal LB2 Mode
;		   1 = Hyper (boss) Mode.
; var(10) = Air combo activity status

; fvar(1) = attackmulset damage reduction

[Data]
life            = 1200
attack          = 100
defence         = 100
fall.defence_up = 0
liedown.time    = 30
airjuggle       = 15
sparkno         = 3
guard.sparkno   = 42
KO.echo         = 0

[Size]
xscale           = 1
yscale           = 1
ground.back      = 20
ground.front     = 26
air.back         = 12
air.front        = 12
z.width          = 3
attack.width     = 4,4
attack.dist      = 460
proj.attack.dist = 220
shadowoffset = -3

[Velocity]
walk.fwd     = 2.1
walk.back    = -1.3
run.fwd      = 9.4,0
run.back     = -4.5,-5
jump.neu     = 0,-10.4
jump.back    = -2.55,-6
jump.fwd     = 2.5,-6
runjump.back = -5,-9
runjump.fwd  = 4,-9
airjump.neu  = 0,-8.1
airjump.back = -2.55,-8.1
airjump.fwd  = 2.5,-8.1

[Movement]
