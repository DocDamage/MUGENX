time = 1

;===========================================================================
; WINPOSE SELECT
;===========================================================================
[Statedef 180]
type = S

[State 180, 1]
type = VarRandom
trigger1 = Time = 0
v = 1
range = 1,4

[State 180, 2] ;Choose win1
type = VarSet
trigger1 = Command = "hold_a"
v = 1
value = 1

[State 180, 3] ;Choose win2
type = VarSet
trigger1 = Command = "hold_b"
v = 1
value = 2

[State 180, 5] ;Choose win3
type = VarSet
trigger1 = Command = "hold_c"
v = 1
value = 3

[State 180, 5] ;Choose win3
type = VarSet
trigger1 = Command = "hold_d"
v = 1
value = 4

[State 180, 2]
type = ChangeState
trigger1 = time = 0
value = 180 + var(1)

