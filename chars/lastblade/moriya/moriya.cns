trigger1 = movetype = H
v = 9
range = 0,5

[State -2, 3]
type = PlaySnd
triggerall = random < 500
triggerall = time = 1
triggerall = stateno = 5000
trigger1 = anim = [5000,5012]
value = S7,(var(9)) ;0-5

[State -2, 9]
type = PlaySnd
triggerall = random < 500
triggerall = time = 1
triggerall = stateno = 5010
trigger1 = anim = [5020,5022]
value = S7,(var(9))

