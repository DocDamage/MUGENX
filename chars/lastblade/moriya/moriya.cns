; Minakata Moriya's constants.
; Written by Deuce, copyright 2000 Deuce
; deuce@classicgaming.com
; http://come.to/deucemugen
; Not for copying or redistribution.  Do not modify.

[Data]
life = 1000          ;Amount of life to start with
attack = 315         ;Set to 315 for LB1 attack strength
                     ;Set to 391 for LB2 attack strength
defence = 100        ;100% defensive power (more is stronger)
fall.defence_up = 50 ;Def goes up by 50% everytime player is hit on ground
liedown.time = 60    ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 15       ;Can do 15 points of juggling
sparkno = 2        ;Default spark number
guard.sparkno = 0 ;Default guard spark number
KO.echo = 0          ;1 to enable echo on KO

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 27     ;Player width (back, ground)
ground.front = 21    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
z.width = 3          ;Player width (into and out)
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
head.pos = 0, -94
mid.pos = -1, -66

[Velocity]
walk.fwd  = 2.4      ;Walk forward
walk.back = -2.4     ;Walk backward
run.fwd  = 6.25, 0      ;Run forward (x, y)  - if y<0, player will hop
run.back = -5,-6 ;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-9    ;Neutral jumping velocity (x, y)
jump.back = -3,-9    ;Jump back Speed (x, y)
jump.fwd = 3,-9        ;Jump forward Speed (x, y)
runjump.back = -6,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-10

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump
yaccel = .43         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;===========================================================================
; DASH (common state override)
;===========================================================================
[Statedef 100]
type    = S
physics = S
anim = 100

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, NoWalk]
type = AssertSpecial
trigger1 = time >= 0
flag = nowalk

[State 100, 15]
type = playsnd
trigger1 = animelem = 3, =0
value = S8,9
channel = 0

[State 100, 15]
type = playsnd
trigger1 = animelem = 6, =0
value = S8,10
channel = 0

[State 100, 2]
type = ChangeState
trigger1 = command != "holdfwd"
value = 101

[Statedef 101]
type = S
physics = S
anim = 101
ctrl = 0

[State 101, SFX]
type = PlaySnd
trigger1 = time = 0
value = S8,6
channel = 0

[State 101, State]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; RUN_BACK
[Statedef 105]
type    = A
physics = N
ctrl = 0
anim = 105

[State 105, SFX]
type = PlaySnd
trigger1 = time = 0
value = S8,4

[State 105, 1]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.back.x)
y = const(velocity.run.back.y)

[State 105, Gravity]
type = VelAdd
trigger1 = time >= 0
y = .56

[State 105, 3]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 106

