;---------------------------------------------------------------------------
;===========================================================================
;黄　　龍
;===========================================================================
;---------------------------------------------------------------------------
;===========================================================================
;Var設定
;1.モード決定用
;2.小攻撃によるダメージボイス決定用
;3.大攻撃によるダメージボイス決定用
;4.小攻撃時のボイス決定用
;5.大攻撃時のボイス決定用
;6.連殺斬特殊ルートの判定用
;7.連殺斬特殊ルートの判定用
;8.終焉ノ舞の判定用
;9.乱舞奥義の判定用
;10.十一言神咒判定用
;30.CPUか否かの判定用
;31.CPUのルーチン決定用
;===========================================================================
;---------------------------------------------------------------------------
; キャラクター基準値の設定

[Data]
life = 1500          ;スタート時の体力総計
attack = 100         ;攻撃力パーセンテージ （多いほど強くなります Def:100%）
defence = 120        ;防御力パーセンテージ （多いほど強くなります Def:100%）
fall.defence_up = 60 ;ダウン時に攻撃された時に一時的に上がる防御力のパーセンテージ
liedown.time = 45    ;ダウンしてから起き上がるまでの時間
airjuggle = 15       ;ジャグリングポイント数
sparkno = S902       ;ディフォルトのスパーク番号
guard.sparkno = S900 ;ガード時のディフォルトスパーク番号
KO.echo = 0          ;1にするとKOされた時に声にエコーがかかります
volume = 99          ;ボリュームオフセット (negative for softer)

;---------------------------------------------------------------------------
; サイズ指定

[Size]
xscale = 1            ;水平方向の縮尺
yscale = 1            ;垂直方向の縮尺
ground.back = 25      ;キャラクターの幅（後方、地上）
ground.front = 28     ;キャラクターの幅（前方、地上）
air.back = 12         ;キャラクターの幅（後方、空中）
air.front = 24        ;キャラクターの幅（前方、空中）
z.width = 3           ;Player width (into and out)（現在使用されていないと思われます）
height = 60　　　　　　;キャラクターの高さ
attack.width = 4,4    ;Default attack width: back, front（現在使用されていないと思われます）
attack.dist = 160     ;攻撃時に相手がガード体勢に入る最低距離（最大320）
proj.attack.dist = 90 ;相手がガード体勢に入る発射物との最低距離（最大320） 
proj.doscale = 0      ;xscale, yscaleの設定が発射物にも有効かどうかの設定（1なら有効です）
head.pos = -22, -132  ;頭の大体の座標（BindToTarget使用時に必要です。）
mid.pos = 0, -70      ;体中心の大体の座標（BindToTarget使用時に必要です。）
shadowoffset = 6      ;影の垂直方向オフセット

;---------------------------------------------------------------------------
; 移動速度の設定

[Velocity] 
walk.fwd  = 1.6            ;前に歩く時の速度
walk.back = -1.4           ;後ろに歩く時の速度
run.fwd  = 6.5, 0          ;前に走る時の速度 (x, y) ホップさせる時は y を 0 以下にします
run.back = -6,-3           ;後ろに走る時の速度 (x, y) 走らせる時は y を 0 にします
jump.neu = 0,-9.6          ;ジャンプ時の垂直移動速度 (x, y)
jump.back = -2.8           ;後ろにジャンプした時の水平移動速度
jump.fwd = 3               ;前にジャンプした時の水平移動速度
runjump.back = -3.7,-11    ;後ろに走りながらのジャンプ時の速度指定 (オプション)
runjump.fwd = 3.9,-10      ;前に走りながらのジャンプ時の速度指定 (オプション)

;---------------------------------------------------------------------------
; 動作の設定

[Movement]
airjump.num = 0       ;空中ジャンプの回数 （オプション）
airjump.height = 35   ;空中ジャンプに必要な最低限の高さ （オプション）
yaccel = .43          ;垂直方向にかかる加速度（重力）
stand.friction = .9   ;立ち状態の摩擦係数
crouch.friction = .87 ;しゃがみ状態の摩擦係数

