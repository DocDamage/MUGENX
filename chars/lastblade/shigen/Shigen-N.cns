trigger1 = Time = 0
y = 0

[State 107,1]
type = PosSet
trigger1 = Time = 0
y = 0

[State 107,2]
type = MakeDust
trigger1 = Time >= 0
pos = -30, 0

[State 107,3]
type = PlaySnd
trigger1 = Time = 0
value = 47, 0

[State 107,4]
type = EnvShake
trigger1 = Time = 0
time = 15

[State 107,4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

