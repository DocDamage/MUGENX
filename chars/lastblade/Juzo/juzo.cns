;月華の剣士 神崎十三
;Created by Nyankoro
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::

[Data]
  ;体力ゲージの初期値
life = 1100
  ;攻撃力（これ以上に設定すると強くなる）
attack = 130
  ;防御力（これ以上に設定すると強くなる）
defence = 110
  ;コンボをくらっている時にあがる防御力
fall.defence_up = 60
  ;倒れてから起上がるまでのフレーム数
liedown.time = 50
  ;空中でどれだけコンボが繋がるか（高くすると無限コンボになるので注意）
airjuggle = 10
  ;hitdefで設定していない時の基本ヒットスパークナンバー
sparkno = 7000
  ;設定してない時のガードナンバー
guard.sparkno = 7105
  ;KOした時に声にエコーをかけるか（１でＯＮ）
KO.echo = 0
 volume = 100
  IntPersistIndex = 30
FloatPersistIndex = 40

[Size]
xscale = 1           ;水平方向の縮尺（通常１）
yscale = 1           ;垂直方向の縮尺（通常１）
ground.back = 15     ;キャラの幅(後方,地上)
ground.front = 16    ;キャラの幅(前方,地上)
air.back = 12        ;キャラの幅(後方,空中)
air.front = 12       ;キャラの幅(前方,空中)
height = 60          ;キャラの高さ
attack.dist = 160    ;攻撃をした時相手がガード体制に入る最低距離
proj.attack.dist = 90;攻撃をした時相手がガード体制に入る最低距離（飛び道具）
proj.doscale = 0     ;上で設定した縮尺を飛び道具にも適用するか（１でＯＮ）   
head.pos = -5, -90   ;頭の大体の座標
mid.pos = -5, -60    ;体の中心の大体の座標
shadowoffset = 0     ;影の垂直方向のオフセット
draw.offset = 0,0    ;使用しない

[Velocity]
walk.fwd  = 2        ;前進の速度
walk.back = -1.6     ;後退の速度
run.fwd  = 5, 0    ;前ダッシュの速度（ホップする時はyを-にする）
run.back = -5,-4 ;後ダッシュの速度（ホップする時はyを-にする）
jump.neu = 0,-8.8    ;垂直ジャンプの速度
jump.back = -3    ;後ジャンプの速度
jump.fwd = 2.5       ;前ジャンプの速度
;runjump.back = -2.55,-8.1 ;後ダッシュしながらのジャンプ速度(オプション)
runjump.fwd = 4,-9.1      ;前ダッシュしながらのジャンプ速度(オプション)

[Movement]
airjump.num = 0      ;空中でジャンプする回数
airjump.height = 200  ;空中でジャンプする最低限の高さ
yaccel = .45         ;重力
stand.friction = .85  ;立ち状態の摩擦係数
crouch.friction = .82 ;屈み状態の摩擦係数

;---------------------------------------------------------------------------
; ステイトの解説
; [Statedef STATENO]
; type = ?      S/C/A/L  Ｓ：立ち/Ｃ：屈み/Ａ：空中/Ｌ：ダウン
; movetype = ?  I/A/H    Ｉ：通常状態/Ａ：攻撃状態/Ｈ：ダメージをくらってる状態
; physics = ?   S/C/A/N  Ｓ：立ち/Ｃ：屈み/Ａ：空中/Ｎ：無し
; juggle = ?             その攻撃に使うジャグル数
;

;---------------------------------------------------------------------------
; タイムオーバーで負けた時
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
;勝利分岐 押したボタンで勝利アニメを選択
[Statedef 180]
type = S

[State 180, 0]
type = VarRandom
trigger1 = Time = 0
v = 2
range = 0,9

[State 180, 1]
type = ChangeState
trigger1 = MatchOver = 0
value = 181

[State 180, 3]
type = VarSet
trigger1 = Command = "hold_a"
v = 4
value = 10

[State 180, 4]
type = ChangeState
trigger1 = MatchOver = 1
trigger1 = var(4) = [0,10]
value = 182

