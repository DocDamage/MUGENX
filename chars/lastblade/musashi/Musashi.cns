;---------------------------------------------------------------------------
;===========================================================================
;暁　武蔵
;===========================================================================
;---------------------------------------------------------------------------
;===========================================================================
;Var設定
;1.勝利時の演出変化用
;2.小攻撃時のボイス決定用
;3.大攻撃時のボイス決定用
;4.ダメージを受けた際のボイス決定用
;5.乱舞奥義の判定
;6.乱舞奥義2の判定
;7.モード決定用
;9.ガードクラッシュ判定用
;11.ショートジャンプの判定用
;12.気絶判定用
;13.気絶よりの回復判定用
;14.ダウン攻撃判定用
;30.CPUか否かの判定用
;31.CPUのルーチン決定用
;===========================================================================
;---------------------------------------------------------------------------
; キャラクター基準値の設定

[Data]
life = 1200          ;スタート時の体力総計
attack = 100         ;攻撃力パーセンテージ （多いほど強くなります Def:100%）
defence = 110        ;防御力パーセンテージ （多いほど強くなります Def:100%）
fall.defence_up = 60 ;ダウン時に攻撃された時に一時的に上がる防御力のパーセンテージ
liedown.time = 50    ;ダウンしてから起き上がるまでの時間
airjuggle = 15       ;ジャグリングポイント数
sparkno = 2          ;ディフォルトのスパーク番号
guard.sparkno = 40   ;ガード時のディフォルトスパーク番号
KO.echo = 0          ;1にするとKOされた時に声にエコーがかかります
volume = 0           ;ボリュームオフセット (negative for softer)

;---------------------------------------------------------------------------
; サイズ指定

[Size]
xscale = 1            ;水平方向の縮尺
yscale = 1            ;垂直方向の縮尺
ground.back = 17      ;キャラクターの幅（後方、地上）
ground.front =  43    ;キャラクターの幅（前方、地上）
air.back = 25         ;キャラクターの幅（後方、空中）
air.front = 30        ;キャラクターの幅（前方、空中）
z.width = 3           ;Player width (into and out)（現在使用されていないと思われます）
height = 60	        ;Height of player (for opponent to jump over)（不明）
attack.width = 4,4    ;Default attack width: back, front（現在使用されていないと思われます）
attack.dist = 160     ;攻撃時に相手がガード体勢に入る最低距離（最大320）
proj.attack.dist = 90 ;相手がガード体勢に入る発射物との最低距離（最大320） 
proj.doscale = 0      ;xscale, yscaleの設定が発射物にも有効かどうかの設定（1なら有効です）
head.pos = 16, -100   ;頭の大体の座標（BindToTarget使用時に必要です。）
mid.pos = 5, -64      ;体中心の大体の座標（BindToTarget使用時に必要です。）
shadowoffset = 0      ;影の垂直方向オフセット

;---------------------------------------------------------------------------
; 移動速度の設定

[Velocity] 
walk.fwd  = 1.6            ;前に歩く時の速度
walk.back = -1.4           ;後ろに歩く時の速度
run.fwd  = 5.5, 0          ;前に走る時の速度 (x, y) ホップさせる時は y を 0 以下にします
run.back = -4,-3.8         ;後ろに走る時の速度 (x, y) 走らせる時は y を 0 にします
jump.neu = 0,-9            ;ジャンプ時の垂直移動速度 (x, y)
jump.back = -3             ;後ろにジャンプした時の水平移動速度
jump.fwd = 3               ;前にジャンプした時の水平移動速度
runjump.back = -3,-8       ;後ろに走りながらのジャンプ時の速度指定 (オプション)
runjump.fwd = 4,-8         ;前に走りながらのジャンプ時の速度指定 (オプション)
;airjump.neu = 0,-8.1      ;空中ジャンプ時の垂直移動速度 (オプション)
;airjump.back = -2.55,-8.1 ;空中で後ろにジャンプした時の水平移動速度
;airjump.fwd = 2.5,-8.1    ;空中で前にジャンプした時の水平移動速度

;---------------------------------------------------------------------------
; 動作の設定

[Movement]
airjump.num = 0       ;空中ジャンプの回数 （オプション）
airjump.height = 35   ;空中ジャンプに必要な最低限の高さ （オプション）
yaccel = .35          ;垂直方向にかかる加速度（重力）
stand.friction = .9   ;立ち状態の摩擦係数
crouch.friction = .87 ;しゃがみ状態の摩擦係数

;===========================================================================
;演出系
;===========================================================================
;---------------------------------------------------------------------------
;勝利(分岐）
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
trigger1 = Matchover = 0 
value = 181

[State 180, 2]
type = VarRandom
trigger1 = Time = 0
v = 1
range = 0,9

[State 180, 3]
type = VarSet
trigger1 = Command = "hold_x"
v = 1
value = 9

[State 180, 4]
type = VarSet
trigger1 = Command = "hold_y"
v = 1
value = 0

[State 180, 5]
type = ChangeState
trigger1 = Matchover = 1 
trigger1 = Var(1) = [0,3]
value = 183

[State 180, 6]
type = ChangeState
trigger1 = Matchover = 1 
trigger1 = Var(1) = [4,9]
value = 182

