[Statedef 8000]
ctrl = 0

[State 8000, 1]
type = Turn
trigger1 = facing != parent, facing

[State 8000, 2]
type = ParentVarSet
triggerall = parent, RoundState = 2 && Var(29) = 0
triggerall = (Parent, Stateno != [5000,5999]) && (Parent, Anim != [5,6]) && parent, Movetype = I
trigger1 = parent, command = "x"
trigger2 = parent, command = "y"
trigger3 = parent, command = "a"
trigger4 = parent, command = "b"
trigger5 = parent, command = "s"
var(30) = 1

[State 8000, 3]
type = ParentVarSet
triggerall = (parent, var(30) = 1)
trigger1 = (command = "x" && parent, command = "x")
trigger2 = (command = "y" && parent, command = "y")
trigger3 = (command = "a" && parent, command = "a")
trigger4 = (command = "b" && parent, command = "b")
trigger5 = (command = "s" && parent, command = "s")
trigger6 = Life = 0 || P2Life = 0 || Win = 1 || Lose = 1
var(30) = 0

[State 8000, 4]
type = VarSet
trigger1 = var(29) = 1
var(29) = 0

[State 8000, 5]
type = VarSet
triggerall = root, RoundState = 2 && Var(29) = 0
trigger1 = parent, command = "x"
trigger2 = parent, command = "y"
trigger3 = parent, command = "a"
trigger4 = parent, command = "b"
trigger5 = parent, command = "s"
var(29) = 1

[State 8000, 6]
type = Destroyself
trigger1 = RoundState = 3 || Life = 0 || P2Life = 0

