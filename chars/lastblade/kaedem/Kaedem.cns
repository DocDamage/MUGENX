;---------------------------------------------------------------
;---------------------------------------------------------------
;變數用途:
;
; Var(8) -區別跳躍類型
; Var(9) -關閉跑步音效
; Var(10)-出現刀光的時間點
; Var(11)-亂舞時閃爍的計時
; Var(12)-用於ABC連段、亂舞奧義發動時、FDF_b的攻擊判定
; Var(13)-隨機選取亂舞奧義時
; Var(15)-\
; Var(16)- \__計算HitCount
; Var(17)- /
; Var(18)-/
; 
;
; 跨場次的設定:
; Var(40)-劍質
; Var(41)- A.I.開關
; Var(42)-濺血開關
; Var(43)-垂死狀態
; Var(44)-設定 熱鍵-1
; Var(45)-設定 熱鍵-1 是否連發
; Var(46)-設定 熱鍵-2
; Var(47)-設定 熱鍵-2 是否連發
; Var(48)-Life Max 開關
; Var(49)-Power Max 開關
; Var(50)-選單語言選擇
;
;
;>Helper(9999)
;   Var(0) -選擇頁面
;   Var(1) -招式表捲動位置
;   Var(2) -選項位置
;   Var(3) -按左右鍵選擇時
;   Var(4) -熱鍵選擇時
;   Var(31)-暫停開關
;
;---------------------------------------------------------------
;---------------------------------------------------------------

[Data]
life = 1000          ;Amount of life to start with
power = 2000         ;
attack = 100         ;100% attack power (more is stronger)
defence = 100        ;100% defensive power (more is stronger)
fall.defence_up = 50 ;Def goes up by 50% everytime player is hit on ground
liedown.time = 60    ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 15       ;Can do 15 points of juggling
sparkno = -1         ;Default spark number
guard.sparkno = -1   ;Default guard spark number
KO.echo = 0          ;1 to enable echo on KO
volume = 0           ;Volume offset (negative for softer)
IntPersistIndex = 32
FloatPersistIndex = 20

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 19     ;Player width (back, ground)
ground.front = 22    ;Player width (front, ground)
air.back = 14        ;Player width (back, air)
air.front = 18       ;Player width (front, air)
height = 60	     ;Height of player (for opponent to jump over)
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = -5, -90   ;Approximate position of head
mid.pos = -5, -60    ;Approximate position of midsection
shadowoffset = -2    ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.7        ;Walk forward
walk.back = -2.5       ;Walk backward
run.fwd  = 6, 0        ;Run forward (x, y)  - if y<0, player will hop
run.back = -8.8,-6.3   ;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-9.6      ;Neutral jumping velocity (x, y)
jump.back = -2.75      ;Jump back Speed (x, y)
jump.fwd = 2.75        ;Jump forward Speed (x, y)
runjump.back = -2.7,-9.6  ;Running jump speeds (opt)
runjump.fwd = 4.5,-9.6    ;.
airjump.neu = 0,0         ;.
airjump.back = 0,0        ;Air jump speeds (opt)
airjump.fwd = 0,0         ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .5         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

