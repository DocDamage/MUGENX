; Definition file for kfm
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Johnny_Cage_X"        ;Name of character
displayname = "Johnny_Cage_X" ;Name of character to display
versiondate = 06,27,2000    ;Version date of character
mugenversion = 06,27,2000   ;Version of M.U.G.E.N character works on
author = "Sweater"         ;Character author name
pal.defaults = 6,3,8,1,5,7,11,2,10,9,12,4      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = Aof_John.cmd   ;Command set
cns     = Aof_John.cns   ;Constants
st      = Aof_John.cns   ;States
stcommon = common1.cns ;Common states
sprite  = Aof_John.sff   ;Sprite
anim    = Aof_John.air   ;Animation
sound   = Aof_John.snd   ;Sound
pal1    = Aof_John2.act  ;Palettes (can have up to 12)
pal2    = Aof_John3.act  ;Palettes (can have up to 12)
pal3    = Aof_John4.act  ;Palettes (can have up to 12)
pal4    = Aof_John1.act  ;Palettes (can have up to 12)
pal5    = Aof_John5.act  ;Palettes (can have up to 12)
pal6    = Aof_John6.act  ;Palettes (can have up to 12)
