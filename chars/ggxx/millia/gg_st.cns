trigger1 = time = 0 && statetype!= A
trigger1 = gethitvar(animtype)!= [3,5]
trigger1 = gethitvar(chainID) = 4090
trigger1 = selfanimexist(5003)
value = 5003

[State anim]
type = ChangeAnim
trigger1 = time = 0
trigger1 = gethitvar(animtype) = [3,5]
value = 5030

[State anim]
