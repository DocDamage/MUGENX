
;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State dizzy]
type = ChangeState
trigger1 = var(9)>= 512
trigger1 = alive = 1 && roundstate = 2
value = 5300
ctrl = 0
ignorehitpause = 1

[State anim]
type = ChangeAnim
trigger1 = anim!= 0 && anim!= 5
trigger2 = anim = 5 && animtime = 0
value = 0

[State vel]
type = velset
trigger1 = time = 0
y = 0

[State vel]
type = velset
triggerall = prevstateno!= 101
trigger1 = abs(vel x) < 2
trigger2 = time = 4
x = 0

;------------------------------------------------------------------
; Jump Start
[Statedef 40]
type = S
physics = S
anim = 40
ctrl = 0
facep2 = 1
sprpriority = 1

[State var]
type = varset
trigger1 = time = 0
sysvar(1) = 0
[State var]
type = varset
trigger1 = command = "holdfwd"
sysvar(1) = 1
[State var]
type = varset
trigger1 = command = "holdback"
sysvar(1) = -1

[State explod]
type = Explod
trigger1 = animtime = -1
anim = 4601
scale = .5,.5
sprpriority = 5
ownpal = 1
persistent = 0

[State vel]
type = velset
trigger1 = animtime = 0
x = ifelse(sysvar(1)=0,const(velocity.jump.neu.x),ifelse(sysvar(1)=1,const(velocity.jump.fwd.x),const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State vel]
type = velset
trigger1 = animtime = 0
trigger1 = prevstateno = 100
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State vel]
type = velset
trigger1 = animtime = 0 && command!= "holdup"
trigger1 = prevstateno = 100
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)
y = const(velocity.jump.y)*.75

[State vel]
type = null;velset
trigger1 = animtime = 0 && command!= "holdup"
trigger1 = prevstateno!= 100
x = ifelse(sysvar(1)=0,const(velocity.jump.neu.x),ifelse(sysvar(1)=1,const(velocity.jump.fwd.x),const(velocity.jump.back.x)))
y = const(velocity.jump.y)*.75

[State snd]
type = PlaySnd
trigger1 = animtime = 0
value = 40,0

[State 40]
type = null;ChangeState
trigger1 = animtime = 0 && command!= "holdup"
value = 41
ctrl = 1

[State 40]
type = ChangeState
trigger1 = animtime = 0
value = 50
ctrl = 1

[Statedef 41]
type = A
movetype = I
physics = A
anim = 41

[State 41]
type = ChangeAnim
trigger1 = vel y > -2
trigger1 = selfanimexist(anim+3)
value = anim+3
persistent = 0

[State land]
type = ChangeState
trigger1 = pos y >= 0 && vel y > 0
value = 52

