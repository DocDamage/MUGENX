; Introduction cutscene for KFM's story.

; This storyboard has multiple scenes.
; Each scene uses two overlay anims, one for the picture, and
; another for the text.
; The fadein and fadeout parameters are used to fade one screen
; to the next.

[SceneDef]
spr = oped.sff
startscene = 0         ;Starting scene number (for debugging)
;‚±‚ê‚Í“ú–{Œê”Å‚Å‚·
;------------------------------------
[Scene 0];
; Fade
fadein.time = 20       ;Time to take for fading in
fadein.col = 0,0,0     ;Use 255,255,255 for white-fade
fadeout.time = 20
fadeout.col = 0,0,0
; Screen color
clearcolor = 0,0,0
; Overlay Anims (from 0 to 9)
layerall.pos = 10,10   ;Default position for all layers
layer0.anim =  0       ;Anim action number
layer0.offset = 0,0   ;Position offset
layer0.starttime = 0   ;Time to start display
; Music
;bgm = intro.mp3        ;Name of music file to play
;bgm.loop = 0
; Total time
end.time = 300

;------------------------------------
[Scene 1];
; Fade
fadein.time = 20
fadein.col = 0,0,0
fadeout.time = 20
fadeout.col = 0,0,0
; Screen color
; The previous clearcolor value is carried over by default
; Overlay Anims (from 0 to 9)
; The previous layerall.pos value is carried over by default
layer0.anim =  1
layer0.offset = 0,0
layer0.starttime = 0
; Total time
end.time = 300

;------------------------------------
[Scene 2];
; Fade
fadein.time = 20
fadein.col = 0,0,0
fadeout.time = 20
fadeout.col = 0,0,0
; Screen color
; The previous clearcolor value is carried over by default
; Overlay Anims (from 0 to 9)
; The previous layerall.pos value is carried over by default
layer0.anim =  3
layer0.offset = 0,0
layer0.starttime = 0
; Total time
end.time = 300

;------------------------------------
[Scene 3];
; Fade
fadein.time = 20
fadein.col =  0,0,0
fadeout.time = 20
fadeout.col = 0,0,0
; Overlay Anims (from 0 to 9)
layer0.anim =  4
layer0.offset = 0,0
layer0.starttime = 0
; Total time
end.time = 200

;------------------------------------
[Scene 4];
; Fade
fadein.time = 20
fadein.col = 0,0,0
fadeout.time = 20
fadeout.col =  0,0,0
clearcolor = 0,0,0
; Overlay Anims (from 0 to 9)
layer0.anim =  5
layer0.offset = 0,0
layer0.starttime = 0
; Total time
end.time = 350

;------------------------------------
[Scene 5]
; Fade
fadein.time = 20
fadein.col = 0,0,0
fadeout.time = 50
fadeout.col = 0,0,0
clearcolor = 0,0,0
; Overlay Anims (from 0 to 9)
layer0.anim =  6
layer0.offset = 0,0
layer0.starttime = 0
; Total time
end.time = 200

;Background image
[Begin Action 0]
0,1, 0,0, -1

;Background image
[Begin Action 1]
0,1, 0,0, -1

;Background image
[Begin Action 2]
0,2, 0,0, -1

;Background image
[Begin Action 3]
0,3, 0,0, -1

;Text
[Begin Action 4]
0,4, 0,0, -1

;Background image
[Begin Action 5]
0,5, 0,0, -1

;Text
[Begin Action 6]
0,6, 0,0, -1

