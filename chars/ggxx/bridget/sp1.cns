fvar(16) = (helper(1850),rootdist x)  / (helper(1850),rootdist y + ifelse(helper(1850),rootdist y > 0,-50,50))

[state 1430,x2];
type = varset
triggerall = numhelper(1850)
triggerall = (helper(1850),rootdist x) != 0
trigger1 = time  = 0;% 10 = 0
fvar(17) = (helper(1850),rootdist y + ifelse(helper(1850),rootdist y > 0,-50,50)) / (helper(1850),rootdist x)  

;----------最大値があるように見えるけど・・・？
;一定値をたさないと、いけない。distだと近いと小さいし遠いとハヤすぎになる・・
;pos参照して、vel-addするのはどうか。またはフリー移行直前にdistによって速度を足す・・？いや、攻撃いった時困る・・？
;初期距離による係数を設定して、増加値を調節？・・・
;この式だと、fvar(16とか定期的にかわるからおかしくなる
[State velx1];dist/ｎは、角度間違いなくいけるが・・早すぎる
type = veladd
trigger1 = 0;fvar(14) < fvar(15)
trigger1 =vel x < 6;(6 * abs(fvar(16)))
trigger1 =vel x > -6;(-6 * abs(fvar(16)))
x = ifelse(helper(1850),rootdist x > 0,-0.4,0.4); * abs(fvar(16)); / fvar(16)

[State velx2];
type = veladd
trigger1 = 0;fvar(14) >= fvar(15)
trigger1 =vel x < 6
trigger1 =vel x > -6
x = ifelse(helper(1850),rootdist x > 0,-0.4,0.4)

[State vely]
type = veladd
trigger1= 0;helper(1850),rootdist y < -70
trigger1= helper(1850),rootdist y < -30
trigger1 = fvar(14) < fvar(15)
trigger1 =vel y < 6
y = 0.4;
;------ここまで。

;符号無視：大きい方が何Fでつくか計算、代入　基本量（スピード）=7、EX：X77y50>77/7で11f,移動量X=7(11F),Y移動量7/11f(11F)
;distが０以外のとき、０除算注意のため
[state 8150,2]
type = varset
triggerall = numhelper(1850)
triggerall = ABS(helper(1850),rootdist y) != 0
triggerall = ABS(helper(1850),rootdist x) != 0
trigger1 = 1
fvar(28) = ifelse(ABS(helper(1850),rootdist x) > ABS(helper(1850),rootdist y),helper(1850),rootdist x / 6,helper(1850),rootdist y / 6)
ignorehitpause = 1

;distが０、もしくはdist x=dist y
[state 8150,2]
type = varset
triggerall = numhelper(1850)
triggerall = 1
trigger1 = helper(1850),rootdist y = 0
trigger2 = helper(1850),rootdist x = 0
trigger3 = helper(1850),rootdist x = helper(1850),rootdist y
fvar(28) = 0
ignorehitpause = 1

;----------------------基本移動量＝7
[state 8150,5];-217,90 
type = velset
triggerall = numhelper(1850)
triggerall = fvar(28);0でないなら比計算されてるはず
trigger1 = 1
x = ABS(helper(1850),rootdist x / fvar(28)) * ifelse(helper(1850),rootdist x > 0,-1,1)
y = ABS(helper(1850),rootdist y / fvar(28)) * ifelse(helper(1850),rootdist y > 0,-1,1)
ignorehitpause = 1

[state 8150,5];
type = velset
triggerall = numhelper(1850)
triggerall = !fvar(28);0の時は特殊
triggerall = 1
trigger1 = helper(1850),rootdist y = 0
trigger2 = helper(1850),rootdist x = 0
x = ifelse(helper(1850),rootdist x = 0,0,6) * ifelse(helper(1850),rootdist x > 0,-1,1)
y = ifelse(helper(1850),rootdist y = 0,0,6) * ifelse(helper(1850),rootdist y > 0,-1,1)
ignorehitpause = 1

[state 8150,5];同じ値で90.90　ともに0じゃない時（0除算　
type = velset
triggerall = numhelper(1850)
triggerall = !fvar(28);0の時は特殊
triggerall =1
trigger1 = helper(1850),rootdist x = helper(1850),rootdist y
trigger1 = helper(1850),rootdist x != 0 && helper(1850),rootdist y != 0
x = ABS(helper(1850),rootdist x / 6) * ifelse(helper(1850),rootdist x > 0,-1,1);
y = ABS(helper(1850),rootdist y / 6) * ifelse(helper(1850),rootdist y > 0,-1,1)
ignorehitpause = 1

[state 8150,5];
type = velset
triggerall = numhelper(1850)
triggerall = !fvar(28);0の時は特殊
triggerall = 1
trigger1 = helper(1850),rootdist x = helper(1850),rootdist y
trigger1 = helper(1850),rootdist x = 0 && helper(1850),rootdist y = 0
x = 0
y = 0
ignorehitpause = 1

