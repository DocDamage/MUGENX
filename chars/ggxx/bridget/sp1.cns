;--
[state 1400,x2];0除算に注意
type = varset
triggerall = numhelper(0)
trigger1 =  time =0
fvar(14) = helper(0),rootdist x + ifelse(helper(0),rootdist x = 0,0.1,0)

;---絵的に目標Ｙ点を下にずらす。そうすればーかさなるようになるはずだよ
;なんだけど、YYが上の時おかしいけど・・使う時absしちゃうから?
[state 1400,x2];ヨーヨーを原点0とするとより↑が負、下が正なのでたせばよい？ーらしい
type = varset
triggerall = numhelper(0)
trigger1 =  time = 0
fvar(15) = helper(0),rootdist y;新、0,0基準
;fvar(15) = helper(0),rootdist y + ifelse(helper(0),rootdist y < -25,-25,-50) ;前、

[state 1400,x2];距離大きい方を基準？
type = varset
triggerall = numhelper(0)
triggerall = helper(0),rootdist y != 0; (helper(0),rootdist y - 25) != 0
;triggerall = (helper(0),rootdist y - 50) != 0
trigger1 = time = 0;1
fvar(16) = helper(0),rootdist x  / helper(0),rootdist y; ００基準
;fvar(16) = (helper(0),rootdist x)  / (helper(0),rootdist y + ifelse(helper(0),rootdist y < -25,-25,-50));前

[state 1400,x2];
type = varset
triggerall = numhelper(0)
triggerall = (helper(0),rootdist x) != 0
trigger1 = time = 0;1
fvar(17) = helper(0),rootdist y / (helper(0),rootdist x)  ;00
;fvar(17) = (helper(0),rootdist y + ifelse(helper(0),rootdist y < -25,-25,-50)) / (helper(0),rootdist x)  ;zenn 

;----------最大値があるように見えるけど・・・？
;一定値をたさないと、いけない。distだと近いと小さいし遠いとハヤすぎになる・・
;pos参照して、vel-addするのはどうか。またはフリー移行直前にdistによって速度を足す・・？いや、攻撃いった時困る・・？
;初期距離による係数を設定して、増加値を調節？・・・
[State velx1];
type = veladd
trigger1 = 0;abs(fvar(14)) < abs(fvar(15))
trigger1 =vel x < (6 * abs(fvar(16)))
trigger1 =vel x > (-6 * abs(fvar(16)))
x = ifelse(helper(0),rootdist x > 0,-0.3,0.3) * abs(fvar(16)); / fvar(16)

[State velx2];
type = veladd
trigger1 = 0;abs(fvar(14)) >= abs(fvar(15))
trigger1 =vel x < 6
trigger1 =vel x > -6
x = ifelse(helper(0),rootdist x > 0,-0.3,0.3)

[State vely]
type = veladd
trigger1 = 0;abs(fvar(14)) < abs(fvar(15))
trigger1 =vel y < 6
trigger1 =vel y > -6
;y = ifelse(helper(0),rootdist y > 0,-0.3,0.3)
;y = ifelse(helper(0),pos y > pos y,-0.5,0.5)
y = ifelse((fvar(15)) > 0,-0.3,0.3)

;----------------------------------check! point  fvar(17)を探れ！
[State vel]
type = veladd
trigger1 = 0;abs(fvar(14)) >= abs(fvar(15))
trigger1 =vel y < (6 * abs(fvar(17)))
trigger1 =vel y > (-6 * abs(fvar(17)))
;y = ifelse(helper(0),rootdist y > 0,-0.5,0.5) * abs(fvar(17)) ; 
;y = ifelse(helper(0),pos y > pos y,-0.5,0.5) * abs(fvar(17)) ; 
y = ifelse((fvar(15)) > 0,-0.3,0.3) * abs(fvar(17)) ; 
;------ここまで。

;符号無視：大きい方が何Fでつくか計算、代入　基本量（スピード）=7、EX：X77y50>77/7で11f,移動量X=7(11F),Y移動量7/11f(11F)
;distが０以外のとき、０除算注意のため
[state 8150,2]
type = varset
triggerall = ABS(helper(0),rootdist y) != 0
triggerall = ABS(helper(0),rootdist x) != 0
trigger1 = time = 0
fvar(28) = ifelse(ABS(helper(0),rootdist x) > ABS(helper(0),rootdist y),helper(0),rootdist x / 5,helper(0),rootdist y / 5)
ignorehitpause = 1

;distが０、もしくはdist x=dist y
[state 8150,2]
type = varset
triggerall = time = 0
trigger1 = helper(0),rootdist y = 0
trigger2 = helper(0),rootdist x = 0
trigger3 = helper(0),rootdist x = helper(0),rootdist y
fvar(28) = 0
ignorehitpause = 1

