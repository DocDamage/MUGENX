;----------ーーーーーーーーーーーーーーーーーーーーーーーーーー状態変化
;分岐は、墜落、着地、R移動、空中行動、攻撃系（いくつかはcmdで？
[state 1410,];ハグの時間切れで、強制フリーに移行
type = changestate
trigger1 =!numhelper(1850)
trigger2 = var(30) != 1830
value = 1440

[state 1400,];着地。
type = changestate
trigger1 =1 
trigger1 = vel y > 0 && pos y >= -10
value = 52
ctrl = 0

[state 1400,];たまに目を回して落下->墜落  3回以上はランダムで10回いくと確実に墜落
type = changestate
triggerall =1
trigger1 = var(14) >= 10
trigger2 = random % var(14) >= 4 
value = 1450
ctrl = 0

[state 1410,];わけて考えよう、真上跳ね・フリーに移行  YYが低いか　かさなった時 time=0で
type = changestate
triggerall = 0;numhelper(1850)
triggerall = time = 0
trigger1 = helper(1850),rootdist x = [-35,35]
trigger1= helper(1850),rootdist y = [-30,100]
trigger2 = helper(1850),rootdist x = [-35,35]
value = 1445

[state 1410,];動いてから（規定点達してから）フリーに移行 敵は接触判定ありなので範囲を広めにしておく
type = changestate
triggerall = numhelper(1850)
triggerall = time > 0
trigger1 = helper(1850),rootdist x = [-60,60]
trigger1= helper(1850),rootdist y = [-60,60]
trigger2 = helper(1850),rootdist x = [-60,60]
trigger3= time >= 70
value = 1440

;-----------------------------vel　X設定
[state 1410,];真上に跳ねない時のみ０に初期化？ ↑で先にちぇんすて移行だからこれだけでかくのいいかな
type = velset
triggerall = numhelper(1850)
trigger1 = time = 0
x = 0
y = 0

[state 8150,1];はりつきへるぱの現在地X
type = varset
triggerall = numhelper(1850)
trigger1 = time = 0
fvar(20) = helper(1850),pos x
ignorehitpause = 1

[state 8150,2];はりつきへるぱ現在地Y
type = varset
triggerall = numhelper(1850)
trigger1 = time = 0
fvar(21) = helper(1850),pos y
ignorehitpause = 1

;----------------------- 
;--距離によって加速がかわってしまう・・・？つねに一定値をaddしないといけないので・・
;---最大値は既定、増加値も一定・・？
;原作、一定時間ごとに微妙に角度かわってる（再決定？してるように見えるけど・・・
;--ハグ中は、敵動くから・・・どうしよ？とりあえずてすってみて
[state 1400,x2];0除算に注意
type = varset
triggerall = numhelper(1850)
trigger1 =  time =0
fvar(14) = helper(1850),rootdist x + ifelse(helper(1850),rootdist x = 0,0.1,0)

;---絵的に目標Ｙ点を下にずらす。そうすればーかさなるようになるはずだよ
;なんだけど、YYが上の時おかしいけど・・使う時absしちゃうから?
[state 1400,x2];ヨーヨーを原点0とするとより↑が負、下が正なのでたせばよい？ーらしい
type = varset
triggerall = numhelper(1850)
trigger1 =  time = 0
fvar(15) = helper(1850),rootdist y;新、0,0基準

[state 1400,x2];距離大きい方を基準？
type = varset
triggerall = numhelper(1850)
triggerall = helper(1850),rootdist y != 0; (helper(0),rootdist y - 25) != 0
;triggerall = (helper(1850),rootdist y - 50) != 0
trigger1 = time = 0
fvar(16) = helper(1850),rootdist x  / helper(1850),rootdist y; ００基準

[state 1400,x2];
type = varset
triggerall = numhelper(1850)
triggerall = (helper(1850),rootdist x) != 0
trigger1 = time = 0
fvar(17) = helper(1850),rootdist y / (helper(1850),rootdist x)  ;00

;----------最大値があるように見えるけど・・・？
;一定値をたさないと、いけない。distだと近いと小さいし遠いとハヤすぎになる・・
;pos参照して、vel-addするのはどうか。またはフリー移行直前にdistによって速度を足す・・？いや、攻撃いった時困る・・？
;初期距離による係数を設定して、増加値を調節？・・・
;ここでは数値だけfvarに設定して、実際に動くステートに戻す(再設定
[State velx1];
type = varset;add
triggerall = numhelper(1850)
triggerall = time = 0
trigger1 = abs(fvar(14)) < abs(fvar(15))
trigger1 =vel x < (6 * abs(fvar(16)))
trigger1 =vel x > (-6 * abs(fvar(16)))
fvar(24) = ifelse(helper(1850),rootdist x > 0,-0.3,0.3) * abs(fvar(16)); / fvar(16)
;x = ifelse(helper(0),rootdist x > 0,-0.3,0.3) * abs(fvar(16)); / fvar(16)

[State velx2];
type = varset;veladd
triggerall = numhelper(1850)
triggerall = time = 0
trigger1 = abs(fvar(14)) >= abs(fvar(15))
trigger1 =vel x < 6
trigger1 =vel x > -6
fvar(24) = ifelse(helper(1850),rootdist x > 0,-0.3,0.3)
;x = ifelse(helper(0),rootdist x > 0,-0.3,0.3)

[State vely]
type = varset;veladd
triggerall = numhelper(1850)
triggerall = time = 0
trigger1 = abs(fvar(14)) < abs(fvar(15))
trigger1 =vel y < 6
trigger1 =vel y > -6
fvar(25) = ifelse((fvar(15)) > 0,-0.3,0.3)
;y = ifelse((fvar(15)) > 0,-0.3,0.3)

;----------------------------------check! point  fvar(17)を探れ！
[State vel]
type = veladd
triggerall =numhelper(1850)
triggerall = time = 0
trigger1 = abs(fvar(14)) >= abs(fvar(15))
trigger1 =vel y < (6 * abs(fvar(17)))
trigger1 =vel y > (-6 * abs(fvar(17)))
fvar(25) = ifelse((fvar(15)) > 0,-0.3,0.3) * abs(fvar(17)) ; 
;y = ifelse((fvar(15)) > 0,-0.3,0.3) * abs(fvar(17)) ; 

[state 1410,];
type = changestate
trigger1 =numhelper(1850)
trigger1 = time = 0
value = 8465

;------------------------------------------------------------実際に動く
;--------------------------------------------------------------
[Statedef 8465];8460で決めた数値でVELADD、ある程度ずれたと判断したら再設定へ
type = A
movetype =A
physics = N
ctrl = 0
hitcountpersist = 1

;----------ーーーーーーーーーーーーーーーーーーーーーーーーーー状態変化
;分岐は、墜落、着地、R移動、空中行動、攻撃系（いくつかはcmdで？
[state 1410,];ハグの時間切れで、強制フリーに移行
type = changestate
trigger1 =!numhelper(1850)
trigger2 = var(30) != 1830
value = 1440

[state 1400,];着地。
type = changestate
trigger1 =1 
trigger1 = vel y > 0 && pos y >= -10
value = 52
ctrl = 0

[state 1410,]
type = veladd
trigger1 = abs(fvar(14)) < abs(fvar(15))
trigger1 =vel x < (6 * abs(fvar(16)))
trigger1 =vel x > (-6 * abs(fvar(16)))
x = fvar(24)

[state 1410,]
type = veladd
trigger1 = abs(fvar(14)) >= abs(fvar(15))
trigger1 =vel x < 6
trigger1 =vel x > -6
x = fvar(24)

[state 1410,]
type = veladd
trigger1 = abs(fvar(14)) < abs(fvar(15))
trigger1 =vel y < 6
trigger1 =vel y > -6
y = fvar(25)

[state 1410,]
type = veladd
trigger1 = abs(fvar(14)) >= abs(fvar(15))
trigger1 =vel y < (6 * abs(fvar(17)))
trigger1 =vel y > (-6 * abs(fvar(17)))
y = fvar(25)

[state 1410,];動いてから（規定点達してから）フリーに移行 敵は接触判定ありなので範囲を広めにしておく
type = changestate
triggerall = numhelper(1850)
triggerall = time > 0
trigger1 = helper(1850),rootdist x = [-60,60]
trigger1= helper(1850),rootdist y = [-60,60]
trigger2 = helper(1850),rootdist x = [-60,60]
trigger3= time >= 70
value = 1440

[state 8510,];ある程度位置がずれたら再設定に8470
type = changestate
triggerall = numhelper(1850)
triggerall = time != 0
trigger1 = helper(1850),pos x + 40 > fvar(20)
trigger2 = helper(1850),pos x - 40 > fvar(20)
trigger3 = helper(1850),pos y + 40 > fvar(21)
trigger4 = helper(1850),pos y - 40 > fvar(21)
trigger5 = vel x = 0 && vel y = 0
value = 8470

