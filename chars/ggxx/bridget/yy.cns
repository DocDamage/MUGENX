;YY
;----rootdist yは正ならー５０の位置を目標、負なら＋５０しないとおかしくなります0なら・・？？
;----長い方を基準にして何フレームで本体に着くか、フレーム数を決定。ex.75なら約10F、としてもう片方を10で割った数字に設定？
;ex x>y(通常横配置に多い）vel x=-7.5,vel y = rootdist y / 10->rootdist y / rootdist x / 7.5
;--本体が一定幅以上動いたと判断したら再設定して戻る
;----------------
[Statedef 8400];初期設定一回のみ
type = A
movetype =A
physics = n
ctrl = 0
hitcountpersist = 1

[state -2, displayb]
type = displaytoclipboard
trigger1 = 1
text = "px=%f,py=%f,rtx=%f,rty=%f,";ABY=%f\n"
params =pos x,pos y,rootdist x,rootdist y,;ABS(rootdist y - 50)

[state -2, displayb]
type = appendtoclipboard
trigger1 = 1
text = "dx/=%f,dy/=%f,vx=%f,vy=%f,22=%d"
params =rootdist x / 8,rootdist y / 7.5,vel x,vel y, var(22)

[state 7000,test];
type = Explod
triggerall = !Numexplod(1500) 
trigger1 = 1
anim = 1575
ID=1500 
postype = p1
pos = 0,10
sprpriority = 2
bindtime = -1
removetime = -2
ownpal=1
scale = 1.0,1.0
ignorehitpause =1
persistent = 1

[state 8000,];なんで消えない！？
type = RemoveExplod
trigger1 = anim = 1555
trigger2 = rootdist y = [25,55];[40,50]  
trigger2 = rootdist x = [-20,20]
trigger3 = root,var(30) = 0
ID=1500
ignorehitpause = 1
persistent = 1

;---------------------------------------
[state 8110,varset];手ぶらフラグ reset
type = parentvarset
trigger1 = rootdist y = [-10,10]  
trigger1 = rootdist x = [-25,25]
var(30) = 0
ignorehitpause = 0

[state 8110,vel]
type = destroyself
trigger1 = rootdist y = [-10,10]  
trigger1 = rootdist x = [-25,25]
ignorehitpause = 0

;-----基本
[state 8000x,nohit];無敵設定
type = NotHitBy
trigger1 = 1
value = SCA, NA, SA, HA, NT, ST, HT ,NP, SP, HP
time = 1
ignorehitpause = 1

[State 8000x, ride];テスト結果:P2stateno無効？すりぬける
type = HitOverride
trigger1 =1 
attr = sca,na,sa,ha,np,sp,hp,nt,st,ht
slot = 0
stateno =8090
time = 1
ignorehitpause = 1

[State 8000x, 1];バグ用　本体が来ちゃったとき０に（有効かどうか不明
type = Changestate
trigger1 = !ishelper(0)
value = 0
ctrl = 1
ignorehitpause = 1

[state 8000,]
type = playerpush
trigger1 = 1
time = 1
value = 0
ignorehitpause = 1

[State 8000x,noturn]
type = AssertSpecial
trigger1 =1
flag = noautoturn
flag2 = nowalk
flag3 = noshadow
ignorehitpause = 1

;-------------------------移動新式：本体がある程度ずれたらVEL再設定へ、
[state 8150,1]
type = varset
trigger1 = time = 0
fvar(20) = root,pos x
ignorehitpause = 1

[state 8150,2]
type = varset
trigger1 = time = 0
fvar(21) = root,pos y
ignorehitpause = 1

;----------------------基本移動量＝8
[state 8150,5];-217,90 横が多い、通常横配置など
type = velset
triggerall = ABS(rootdist y) != 0
triggerall = ABS(rootdist x) != 0
triggerall = ABS(rootdist y - 45) != 0
trigger1 = time = 0
trigger1 = ABS(rootdist x) > ABS(rootdist y - 50) 
x = ifelse(rootdist x < 0,-8.0,8.0) 
y = (ABS(rootdist y - 45) / ABS(rootdist x / 8)) * ifelse(root,pos y - 50 < pos y,-1,1)
ignorehitpause = 1

[state 8150,6];上に配置など、縦が多い 100 150
type = velset
triggerall = rootdist x != 0
triggerall = rootdist y != 0
triggerall = ABS(rootdist y - 45) != 0
trigger1 = time = 0
trigger1 = ABS(rootdist x) < ABS(rootdist y - 50)
x = (ABS(rootdist x) / ABS(rootdist y / 8)) * ifelse(rootdist x < 0,-1,1)
y = ifelse(root,pos y - 50 < pos y,-8,8)
ignorehitpause = 1

[state 8150,5];0除算対策3
type = velset
triggerall = rootdist x = 0
trigger1 = time = 0
x = 0
y = ifelse(root,pos y - 50 < pos y,-7,7)
ignorehitpause = 1

[state 8150,5];0除算対策3
type = velset
triggerall = rootdist y = 0
trigger1 = time = 0
x = ifelse(rootdist x < 0,-8,8)
y = 0
ignorehitpause = 1

[state 8150,5];0除算対策3
type = velset
triggerall = ABS(rootdist y - 45) = 0
trigger1 = time = 0
x = ifelse(rootdist x < 0,-8,8)
y = 0
ignorehitpause = 1

[state 8150,5];不動対策
type = velset
triggerall = root,pos y = 0 && pos y = 0
trigger1 = time = 0
y = -7
ignorehitpause = 1

;意味不明バグ対策as地面配置でXが20前後、ワープ状態になる→たぶん上の式でとんでもない数字になる？？？
;yは45引くので、もし+５であれば-40、で内部的に位置がずれる符号逆転のせい？
[state 8150,5];
type = velset
triggerall = time = 0
trigger1 = rootdist y > 0 && rootdist y - 45 <= 0
x = ifelse(rootdist x < 0,-7,7)
ignorehitpause = 1

[state 8510,];移動開始
type = changestate
trigger1 = time = 0
value = 8410

