damage = floor(20 * root,fvar(0)),1                   ;ダメージ量（左が当たった時、右はガードした時）
animtype = hard                 ;当てた時の相手のポーズ（light/midium/hard/back）から選択
guardflag = MA                   ;ガードできる状態（ｍaは全ての状態でガード可能）
hitflag = MAF                    ;当てる事のできる条件
priority = 3             ;攻撃の優先権（0弱い　4通常　7強い
pausetime = 5, ifelse(root,var(25) = 0,17,25)                    
sparkno = -1;2000;s6300   
guard.sparkno = -1;752;S6150
sparkxy = 0, -20               ;ヒットエフェクトを表示する場所（相手の座標で）
hitsound   = s205, 7
guardsound = s150, 1
ground.type = High               ;相手のくらった場所（High：頭、体, Low：足, Trip：足払い）
ground.slidetime =25             ;相手が後にすべる時間
ground.hittime  = 20             ;コンボが繋がる時間（高くしすぎない事）
ground.velocity = -9             ;地上で攻撃をくらった場合の相手の移動状況（ｘとｙで小数点可）
air.type = High                  ;空中で相手がくらった場所（上と同じ）
air.velocity = root,fvar(5), root,fvar(2) / 4 + root,fvar(6);-2.5, -6.5  
air.hittime = 20                 ;空中でコンボが繋がる時間
getpower = 30,15
