triggerall = !fvar(22);0の時は特殊
triggerall = time != 0
trigger1 = rootdist x = rootdist y
trigger1 = rootdist x != 0 && rootdist y != 0
x = ABS(rootdist x / 7) * ifelse(rootdist x < 0,-1,1);
y = ABS(rootdist y / 7) * ifelse(rootdist y < 0,-1,1)
ignorehitpause = 1

[state 8150,5];
