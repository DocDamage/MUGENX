;ブリジット ヨーヨー関連
;var(6)2JFvar(7)AirDF var(8)GroDF var(9)JレバーニュートラルF var(11)エリアル 
;13,sw,14,sm,15,ss,16,cw,17,cm,18,cs19,aw,20,am,21,as,22far StandM,23,lfsm,24,lfss
;25 stateno 
;v30,ss attack v31,LL
;fvar(0) 攻撃係数 
;s1500-地上ヨーヨー配置　s1530-空中ヨーヨー配置

;-----------------------------s260-地上ヨーヨー配置　
[statedef 1500];ここではアニメ変更のみ　じゃない！良く見て・・
type = s
physics = n
movetype = i
hitcountpersist = 1
sprpriority = 0
ctrl = 0
;anim  =265;debug
poweradd = 20
;velset = ifelse(var(8), const(velocity.run.fwd.x) - 1,0),0

[state -3,flag reset];ダッシュ慣性1　継続させる
type = velset
trigger1 = var(8)
trigger1 = time = 0
trigger1  =prevstateno = [0,52]
x = const(velocity.run.fwd.x) 
persistent = 0
ignorehitpause = 1

[state -3,flag reset];ダッシュ慣性2　　０にする
type = velset
trigger1 = !var(8)
trigger1 = time = 0
x = 0
y = 0
persistent = 0
ignorehitpause = 1

[State 200x,]
type = Velmul
trigger1 = Vel X > 0
x = 0.90

[State 200x,]
type = Velset
trigger1 =Vel X <= 0.5
x = 0

[state 1500,ca];ヴェクトル reセット
type = varrangeset
trigger1 = time = 0
fvalue =0
first = 20
last = 21 
persistent = 0

[state 1500,ca];正面投げ レバー前かにゅーとらる
type = changeanim
triggerall = time = 5
trigger1 = command = "holdF"
trigger2 = command != "holdfwd"
trigger2 = command != "holddown"
trigger2 = command != "holdup"
trigger2 = command != "holdback"
trigger3 = command = "holdDF"
trigger4 = command = "holdD"
value = 260
persistent = 0

[state 1500,ca];正面投げ レバー斜め前
type = changeanim
triggerall = time = 5
trigger1 = command = "holdUF"
value = 265
persistent = 0

[state 1500,ca];上投げ レバー上
type = changeanim
triggerall = time = 5
trigger1 = command = "holdU"
value = 270
persistent = 0

[state 1500,ca];斜め後ろ投げ レバー斜め後ろ
type = changeanim
triggerall = time = 5
trigger1 = command = "holdUB"
value = 275
persistent = 0

[state 1500,ca];真後ろ投げ レバー後ろ
type = changeanim
triggerall = time = 5
trigger1 = command = "holdB"
trigger2 = command = "holdDB"
value = 280
persistent = 0

[State 1500, 1];
type = Changestate
trigger1 = anim = [260,295]
trigger1 = time >= 5
value = 1510

