trigger1 = var(36) != 0
add = -250,-250,-250
sinadd = -250,-250,-250
time = 1

[State 3620,];一撃KOの時のみ
type = AssertSpecial
trigger1 = var(36) != 0
time = 1
flag = noBG
flag2 = nobardisplay
flag3 = noFG

[State 3620,];一撃KOの時のみ
type = AssertSpecial
trigger1 = var(36) != 0
time = 1
flag = invisible
flag2 = noshadow
flag3 = nomusic

[State 180, 1];VS メイ専用イントロ 未定につき削除
type = ChangeState
triggerall= 0;time = 0
trigger1 =enemy,authorname = "MEKA"
trigger1 = P2name = "may"
trigger2 = var(48) = 3
value = 186

;双子は除外、スプライト化け対応しきれない。170はnothitbyかかってるので余計変になるよ
[State 180, 1];KO勝ちしんぐるのみ相手キャッチへ行けます。
type = ChangeState
triggerall = time >= 0
triggerall = var(48) != 2 && !var(36)
triggerall = win = WinKO || win = WinPerfect
triggerall = win != Wintime
triggerall = numhelper(184)
triggerall = helper(184),stateno = 2810
trigger1 = TeamMode = Single && enemy,teammode = single;win ()でくくれないのでトリガ分けて
trigger2 = !var(58);dos ()でくくれないのでトリガ分けて
value = 181 + random % 3 

[State 180, 1];KO勝ちでないかチームモードなら相手キャッチ以外です
type = ChangeState
trigger1 = !var(36) 
trigger1= time >= 0
value = 181 + random % 2 

[State 181, 4]
type = AssertSpecial
trigger1 = Time  <= 300
flag = RoundNotOver

