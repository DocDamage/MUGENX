postype = p1
pos = 0,0
sprpriority = 4
bindtime = -1
removetime = -2
ownpal = 1
persistent = 0
ignorehitpause = 1
removeongethit=1
scale= 0.5,0.5

[State 6090, sound];
type = PlaySnd
trigger1 = pos y >= -20
value = s205, 7
persistent = 0
channel = 2

[State 6090, env]
type = EnvShake
trigger1 = pos y >= -20
time = 20
freq = 100
ampl = -4
phase = 0
persistent = 0

[state 6090,]
type = changestate;destroyself
trigger1 = pos y >= -5
trigger1 = vel y > 0
trigger2 = numhelper(184) = 0
value = 6092

[state -2, displayb];通常
type = displaytoclipboard
trigger1 = 1
text = "posx=%f,posy=%f,Eposx=,Eposy=,p2st=\n"
params = pos x, pos y 
;params =pos x,pos y,p2bodydist x,p2bodydist y,facing

[state -2, displayb];通常
type = appendtoclipboard
trigger1 = 1
text = "h2posx=%f,h2posy=%f,h2distx=%f,h2disy=%f"
params = helper(184),pos x, helper(184),pos y ,helper(184),rootdist x,helper(184),rootdist y
;params =pos x,pos y,p2bodydist x,p2bodydist y,facing

;---------------------追い討ち後はねて地上まで
[statedef 6092]
type = A
movetype = A
physics = n
anim = 1551
ctrl = 0
velset = -2,-4
sprpriority = -4

[state 6092,]
type = veladd
trigger1 = 1
y = 0.44

[state 6092,]
type = changestate;destroyself
trigger1 = pos y >= -5
trigger1 = vel y > 0
trigger2 = numhelper(184) = 0
value = 6095

;---------------------追い討ち後のヨーヨー横倒しにならないみたい
[statedef 6095]
type = s
movetype = A
physics = s
;anim = 1560
ctrl = 0
velset = 0,0
sprpriority = -4

[state -2, displayb]
type = displaytoclipboard
trigger1 = 1
text = "posx=%f,posy=%f,Rdistx=%f,Rdisty=%f,faci=%d\n"
params =pos x,pos y,rootdist x,rootdist y,facing

[state 6095,]
type = posset
trigger1 = time = 0
y = 0

[state 6095,]
type =destroyself
trigger1 = 0;time >= 60;animtime = 0

;-------------------ヨーヨー追い討ち用相手ステート奪取　7000（同5110--------------------------------------------------------
;5150で情報消失なので手前の5110に入った瞬間奪取　したがって7000=5110である
; HIT_LIEDOWN
;[Statedef 5110]
[Statedef 7000]
type    = L
movetype= H
physics = N

[State 5110, EnvShake]
type = FallEnvShake
trigger1 = Time = 0

[State 5110, 1] ;For hit up/up-diag type (from state 5081)
type = ChangeAnim
persistent = 0
trigger1 = SelfAnimExist(5110 + (anim % 10))
trigger1 = anim = [5081,5089]
trigger2 = anim = 5091
value = 5110 + (anim % 10)

;--------------ちょっといじったところーー----------------
[State 5110, 2] ;Hit ground anim (normal)
type = ChangeAnim
triggerall = prevstateno != 5071
triggerall = time = 0
triggerall = anim != [5110,5119] ;Not already changed anim
trigger1 = anim != [5161,5169]
trigger2 = !SelfAnimExist(5170 + (anim % 10))
value = 5170

[State 5110, 3] ;Hit ground anim (for hit up)
type = ChangeAnim
triggerall = prevstateno != 5071
triggerall = time = 0
triggerall = anim != [5110,5119] ;Not already changed anim
trigger1 = anim = [5161,5169]
trigger1 = SelfAnimExist(5170 + (anim % 10))
value = 5170 + (anim % 10)

[State 5110, 3] ;Hit ground anim (for hit up)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim = 5070;prevstateno = 5071
value = 5171

[State 5110, 4]
type = HitFallDamage
trigger1 = Time = 0

[State 5110, 5]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5110, Var] ;Get fall velocity
type = VarSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) != 0
sysvar(1) = floor(vel y)

[State 5110, 6]
type = PlaySnd
trigger1 = Time = 0
trigger1 = !SysVar(0)
;value = F7, 0 ;Hit ground
value = F7, (sysvar(1) > 5) + (sysvar(1) > 14)

[State 5110, 7]
type = GameMakeAnim
trigger1 = Time = 0
trigger1 = !SysVar(0)
value = 60 + (sysvar(1) > 5) + (sysvar(1) > 14)
pos = 0, 0
under = sysvar(1) <= 10

[State 5110, 8]
type = VelSet
trigger1 = Time = 0
y = 0

[State 5110, 9] ;For hit up type
type = ChangeAnim
persistent = 0
triggerall = anim = [5171,5179]
triggerall = SelfAnimExist(5110 + (anim % 10))
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground anim
value = 5110 + (anim % 10)

;--------------ちょっといじったところーー----------------
[State 5110, 9ex] ;仕様うつぶせ For hit trip type
type = ChangeAnim
persistent = 0
triggerall = prevstateno = 5071
;triggerall = anim = [5171,5179]
;triggerall = SelfAnimExist(5110 + (anim % 10))
trigger1 = AnimTime = 0
;trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground anim
value = 5111 ;+ (anim % 10)

;--------------------------------------------------------
[State 5110, 10] ;For normal
type = ChangeAnim
persistent = 0
triggerall = Anim != [5111,5119]
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
value = 5110

;--------------------実際は5150に行く所を7010に　7010=5150
[State 5110, 11] ;If just died
type = ChangeState
triggerall = !alive
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
trigger3 = Anim = [5110,5119]
;value = 7010
value = 5150

[State 5110, 12]
type = VarSet
trigger1 = SysVar(0)
trigger1 = Time = 0
sysvar(0) = 0

[State 5110, 13] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 5110, 14]
type = ForceFeedback
trigger1 = alive
trigger1 = Time = 0
time = 8
ampl = 240
waveform = sine

[State 5110, 15]
type = ForceFeedback
trigger1 = !alive
trigger1 = Time = 0
ampl = 200, 7, -.467
time = 30
waveform = sine

;---------------------------------------------------------------------------
; HIT_LIEDEAD  1p state=0 && ctrl = 1 で 2p state 5150(奪い中でも可)でラウンド終了判定される。
;--
[Statedef 5150]
type    = L
movetype= H
physics = N
sprpriority = 12

[state 3800,];ササリアニメ
type = changeanim
triggerall = prevstateno = 3720
trigger1 = time =0
trigger1 = SelfAnimExist(5119) 
value = ifelse(authorname = "R-R",5119 + var(0),5119)

[state 3800,];がないとき 頭中心
type = changeanim2
triggerall = prevstateno = 3720
trigger1 = time =0
trigger1 = !SelfAnimExist(5119) 
value = ifelse(authorname = "R-R",3650 + var(0),3650)

[State 5150, 1] ;Normal anim
type = ChangeAnim
triggerall = prevstateno != 3720
triggerall = Time = 0
triggerall = SelfAnimExist(5140)
trigger1 = (anim != [5111,5119]) && (anim != [5171,5179])
trigger2 = !SelfAnimExist(5140 + (anim % 10))
value = 5140

[State 5150, 3] ;Hit up type anim
type = ChangeAnim
triggerall = prevstateno != 3720
trigger1 = Time = 0
trigger1 = (anim = [5111,5119]) || (anim = [5171,5179])
trigger1 = SelfAnimExist(5140 + (anim % 10))
value = 5140 + (anim % 10)

[State 5150, 4] ;Match over anim
type = ChangeAnim
persistent = 0
triggerall = prevstateno != 3720
;trigger1 = Time = 0
trigger1 = MatchOver = 1
trigger1 = Anim = [5140,5149]
trigger1 = SelfAnimExist(anim+10)
value = anim+10

[State 5150, 5] ;Switch to 5110 if liedead anim does not exist
type = ChangeAnim
triggerall = prevstateno != 3720
trigger1 = Time = 0
trigger1 = Anim != [5140,5159]
trigger1 = Anim != [5110,5119]
value = 5110

[State 5150, 6] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 5150, 7] ;Friction
type = VelSet
trigger1 = Vel x < .05
persistent = 0
x = 0

[State 5150, 8]
type = NotHitBy
trigger1 = 0;
value = SCA
time = 1

[state 5150,]
type = changestate
triggerall = prevstateno != 3720
trigger1 = name = "bridget"
trigger1 = roundstate=4
trigger1 = !var(47) && !var(36)
value = 7010

[state 5150,]
type = changestate
triggerall = prevstateno != 3720
trigger1 = name != "bridget"
trigger1 = roundstate=4
value = 7010

;---------------------------
[Statedef 7010]
type    = L
movetype= H
physics = N
sprpriority = -3
velset = 0,0

[state 7010,];-２どはね防止
type = varset
trigger1 = name = "bridget"
trigger1 = time = 0
var(47) = 1

[state 7010,]
type = changestate
trigger1 = p2stateno = 183
trigger1 = time >= 132
value = 7020

;-------------------------追い討ちくらって吹き飛ぶ
[Statedef 7020]
type    = L
movetype= H
physics = A
sprpriority = -3
velset = -7,-2.5

[State 875, 1]
type = ChangeAnim
Triggerall = 0;Time = 0
trigger1  = anim = 5141
trigger1 = selfanimexist(5030)
value = ifelse(authorname = "R-R",5030 + var(0),5030)

[State 875, 1]
type = ChangeAnim
Triggerall = Time <= 10
trigger1 = selfanimexist(5080)
trigger1 = name = "bridget" = 0
value = ifelse(authorname = "R-R",5080 + var(0),5080)

[State 875, 1]
type = ChangeAnim
Triggerall = Time <= 10
trigger1 = name = "bridget"
value = ifelse(authorname = "R-R",5030 + var(0),5030)

[state 7020,]
type = selfstate
trigger1 = time >= 10;pos y > -20 && vel y > 0
value = 5050

