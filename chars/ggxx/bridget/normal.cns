;ブリジット　通常技;---
;---摩擦の問題かそれとも吹き飛ばしか・・一応基準数値書いておく。同キャラ・密着での見た目基準、ロマキャン試行済。
;----がーども、同じだけ動くみたい。ダウンする技とか、guardvelovity設定わすれないように
;--特殊なのでない限り地上ヒットＸは以下の数値。(近立Ｓ1は？？)
;--Lv1,-6,lv2,-7 lv3,-8 lv4,-9? lv4,-10?
;---問題は、ダウン（Yvel)がからむ場合。Xは上のを適用かそれとも別か・・？
;--必殺技、は落ちるのも横吹き跳びも早く感じる。yaccel設定必須かも。

;----空中 重力について　physics =A　使用禁止
;V18通常0 空ダッシュ1 R移動2(前半後半でも重力違う)
;0攻撃 普通　1 カウント(v17)=0まで重力なし 
;2　軽めの重力をかける　ｘはそのままですっとぶ ;　FDC、ロジャ発動も？　SSは除外
;---------------------------------------------------------------------------
; 立ち・P・　s200,swwf13
[Statedef 200];
type    = S                      
movetype= A                      
physics = n  
;velset = ifelse(var(8), const(velocity.run.fwd.x) - 1,0),0
ctrl = 0                         ;このステート中に他のコマンドを受け付けるか(1で受け付ける)
anim = 200                       ;このステートで表示するスプライトステート番号(0で変化無し)
sprpriority = 2                  ;表示した絵の重なり具合(2一番前　0通常　-1奥)
Hitcountpersist = 1

[state -3,flag reset];ダッシュ慣性1　継続させる
type = velset
trigger1 = var(8)
trigger1 = time = 0
trigger1  =prevstateno = [0,52]
x = const(velocity.run.fwd.x) 
persistent = 0
ignorehitpause = 1

[state -3,flag reset];ダッシュ慣性2　　０にする
type = velset
trigger1 = !var(8)
trigger1 = time = 0
x = 0
y = 0
persistent = 0
ignorehitpause = 1

[state -3,flag reset];ヒットカウント
type = varadd
trigger1 = movehit
fvar(2) = 1
persistent = 0
ignorehitpause = 1

[state -3,];基底ダメ補正
type = varset
trigger1 = prevstateno = [0,52]
trigger1 = time = 0
fvar(1) = 0.9

[State 200x,]
type = Velmul
trigger1 = Vel X > 0
x = 0.93

[State 200x,]
type = Velset
trigger1 = Vel X <= 0.5
x = 0

[state 200x,staset]
type = statetypeset
triggerall =0; var(8)
trigger1 = animelem >= 2
physics =s

[State 200, 1];LV1?のけぞりってpausetimeのことかそれともhitimeのことか・・？どっちよ
type = HitDef
trigger1 = time = 0
attr = S, NA                   
damage = floor(12 * fvar(0))                
animtype = Light              
guardflag = M                  
hitflag = MAF                  
priority = 3            
pausetime = 10, ifelse(!var(25),10,10)          
sparkno =-1;700;s6300   
guard.sparkno = -1;s6150;750;S6150
sparkxy = -10, -85              
hitsound   = s205, 5
guardsound = s150, 0
ground.type = High              
ground.slidetime = 15
ground.hittime  = 12             
ground.velocity = -6           
air.type = High                
air.velocity = fvar(5), fvar(2) / 4 + fvar(6);-2.5, -6.5  
air.fall = 1                 
air.hittime = 15                
getpower = 30,15
fall.recover =ifelse(var(25),0,1)
fall.recovertime = 10 

[state 200x,atc efe];hit guardエフェクト  hitdefだとサイズが大きくなる。のでこうする？
