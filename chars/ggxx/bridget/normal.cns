trigger1 = movecontact;guarded
anim =ifelse(movehit,6200,6150)
ID=200
pos = -5,-80
postype = p2
sprpriority = 3
bindtime = 1
removetime = -2
ownpal=1
scale = 0.5,0.5
persistent = 0
ignorehitpause = 1
facing = -1

[State 200, 7]
