movetype= A
physics = N
ctrl = 0
anim = 600
sprpriority = 2
Hitcountpersist = 1

[state -3,flag reset];ヒットカウント:浮き・ダメ補正に
type = varadd
trigger1 = movehit
fvar(2) = 1
persistent = 0
ignoregutpause = 1

;-----------------airだっしゅ中の処理（ｘしばらく継続、0になったらｙかかる
[State 200x,];前空中ダッシュでセットされるvar7)、０じゃなければダッシュ慣性つき→prevだと、チェーンの場合変。
type = Velmul
trigger1 = var(17) > 0
trigger1 = Vel X > 0.1
x = 0.95

[State 200x,]
type = Velset
trigger1 = var(17)
trigger1 = Vel X = [0,1]
x = 1

[state 200x,com var];
type = varadd
trigger1 = var(17) > 0
trigger1 = 1
var(17) = -1

[state 200x,com var];
type = varset
trigger1 = var(17) <= 0
var(17) = 0

;--------------------------
[state 600];重力→普通ジャンプ、ダッシュ後なら通常、R移動ごならR移動重力。
type = veladd
triggerall = var(18) != 2 && var(18) !=3 
trigger1 = var(18) = 1 && !var(17);
trigger2 = !var(18) || !var(17) 
y = const(movement.yaccel) 

;--------------------------R移動中の処理
[state 600];重力→普通ジャンプ、ダッシュ後なら通常、R移動ごならR移動重力。
type = veladd
trigger1 = var(18)=2 ;|| var(18) = 3
y = fvar(18);0.35

;--------------------------R移動中の処理
[state 600];重力→普通ジャンプ、ダッシュ後なら通常、R移動ごならR移動重力。
type = veladd
trigger1 = var(18)=3 ;|| var(18) = 3
y = 0.4

[state 200x,com var];
type = varadd
trigger1 = time = 0
var(19) = 1

