;------------------特殊チェンステ　－3部
[State -1, sike];サイクバースト　食らい中 青 超必はぬけれないとする。はず。
type = ChangeState
value = 2050
triggerall = (command = "ALL" && command != "holdback" && command !="holdF") || command = "bust" 
triggerall = fvar(10) >= 100;power >= 1000;仮に 
trigger1 = movetype = H && alive
trigger1 = enemy,HitDefAttr = sca,na,np,nt,sa,sp,st

;--------------------------------FD -3部　
;-----------地上Jキャンセル------------------------------
[state -3,jump cancel];200,210,220,230,420
type = changestate
triggerall = command = "holdup"
triggerall = movecontact
trigger1 = stateno = [200,230]
trigger1 = stateno % 10 = 0
trigger2 = stateno = 420
value = 40

;-----空中Jキャンセルdasutotyuuhadame
[state -3,jump cancel];610,630
type = changestate
triggerall = !var(6) && !var(9)
triggerall = movecontact
triggerall = command = "holdup"
triggerall = var(22) <= 0
trigger1 = stateno = 610 || stateno = 630
value = 42

;------------空中ダストCHJ
