channel = 5

[state -3,flag reset]
type = varset
trigger1 = anim != 5300
var(55) = 0

;--------よろけアニメ指定時セリフ
[state -3,flag reset]
type = varadd
trigger1 = anim = 5003
var(56) = 1

[State -3, recove voice]
type = PlaySnd
triggerall = alive 
trigger1 = var(56) = 1
value = s2550,ifelse(var(1) = 3, random % 3,var(1))
parsistent = 0
channel = 5

[state -3,flag reset]
type = varset
trigger1 = anim != 5003
var(56) = 0

;--------KO時セリフ
[state -3,flag reset]
type = varadd
trigger1 = alive = 0
var(57) = 1

[State -3, recove voice]
type = PlaySnd
trigger1 = var(57) = 1
value = s5140,ifelse(var(1) = 3, random % 6,var(1) * 2 + random % 2)
parsistent = 0
channel = 5

[state -3,flag reset]
type = varset
trigger1 = alive = 1
var(57) = 0

