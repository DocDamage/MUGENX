;ブリジットとヨーヨー　マイナス２，３
[statedef -2]

;------------------------------デバッククリップボード--------------------
[state -2, displayb];通常 R移動以外
type = displaytoclipboard
trigger1 = 1;!numhelper(0)
text = "psx=%f,psy=%f,Edix=%f,Ediy=%f,d=%d\n"
params =pos x,pos y,p2bodydist x,p2bodydist y, var(22);facing 
ignorehitpause = 1

[state 8100x, clip];通常　ローリング
type = displaytoclipboard
trigger1 = 0;numhelper(0)
trigger1 = !numhelper(1850)
text = "psx=%f,psy=%f,YYdiX=%f,YYidsY=%f,d=%d\n"
params =pos x,pos y,helper(0),rootDist X,helper(0),rootdist y,var(22)

[state -2, displayb];ハグローリング
type = displaytoclipboard
trigger1 =numhelper(1850)
text = "velX=%f,velY=%f,HUGdX=%f,HUGdY=%f,4=%d\n"
params =vel x,vel y,helper(1850),rootdist x,helper(1850),rootdist y,var(4);facing 

[state -2, displayb];var
type = displaytoclipboard
trigger1 = 0;
text = "14=%d,15=%d,16=%d,17=%d,18=%d\n"
params =var(14),var(15),var(16),var(17),var(18) 

[state -2, displayb];ヨーヨー関連
type = appendtoclipboard
trigger1 = 0;numhelper(0)
text = "velX=%f,velY=%f,YdisX=%f,YdisY=%f,YYfac=%d"
params =fvar(14),fvar(15),fvar(16),fvar(17),facing 

[state -2, displayb];通常　
type = appendtoclipboard
trigger1 =1;!numhelper(1850)
text = "vX=%f,vY=%f,f18=%f,"
;params = fvar(5),fvar(6),fvar(2),
params =vel x,vel y,fvar(18)

[state 8000,];なんで消えない！？
type = RemoveExplod
trigger1 = var(30) = 0
trigger2 = numhelper(0) = 0
ID=1500
ignorehitpause = 1
persistent = 1

;-------------------特殊チェンステ　-2部
[state 2,];AIRダッシュ自動振り向き
type = turn
triggerall = p2dist X < -1
triggerall = time >= 0
trigger1 = stateno = 42
trigger2 = stateno = 50
trigger2 = PrevStateno = 42
trigger3 = Stateno = 50
trigger3 = var(13) ;HJ
trigger4 = Stateno = 51
trigger4 = PrevStateno = 102  
trigger5 = Stateno = 51
trigger5 = PrevStateno = 107

;-----------------------------------------FD関連 var(12)
[State -1, FD];フォルトレス
type = varset
var(12) = 1
triggerall = power > 0 && roundstate = 2
triggerall = command = "holdback" 
trigger1= command = "holdA" 
trigger2 = command = "holdP" && command  ="holdK" ;P+K
trigger3 = command = "holdP" && command  ="holdS" ;P+S
trigger4 = command = "holdP" && command  ="holdH" ;P+HS
trigger5 = command = "holdS" && command  ="holdK" ;K+S
trigger6 = command = "holdK" && command  ="holdH" ;K+HS
trigger7 = command = "holdS" && command  ="holdH" ;S+HS
ignorehitpause=1

[State -1, FD];フォルトレス 解除
type = varset
var(12) = 0
;triggerall= 1 
trigger1 = command != "holdP" && command !="holdK" ;P+K
trigger1 = command != "holdP" && command !="holdS" ;P+S
trigger1 = command != "holdP" && command !="holdH" ;P+HS
trigger1 = command != "holdS" && command !="holdK" ;K+S
trigger1 = command != "holdK" && command !="holdH" ;K+HS
trigger1 = command != "holdS" && command !="holdH" ;S+HS
trigger1= command != "holdA" 
trigger2 = command != "holdback" 
trigger3 = power <= 0
trigger4 = movetype = A
trigger5=stateno = [5000,5300] 
ignorehitpause=1

[State -1, FD];フォルトレス
type = ChangeState
value = 121
triggerall = 0;statetype = A
triggerall = power > 0 && var(12) = 1 
triggerall = command = "holdback"
trigger1 =  command = "ALL" 
trigger2 = command="FD" 
trigger8 = movetype = A && time <= 2

;---FDフラグリセット v(12)
[state -3, efe];フォルトレス　消し
type = removeExplod
trigger1 = stateno != [120,155]
ID=120

[state -2,helper partner];----test FDエフェクトヘルパー
type = Helper
triggerall = var(12) = 1 && anim = [120,155]
trigger1 = numhelper(122) = 0
trigger2 = numhelper(122) = 1
trigger2 = helper(122),stateno = 2092
helpertype = normal
sprpriority  = 0
name = "FD helper"
ID=122
pos = 0,0
postype = p1
stateno = 2090
keyctrl =0
ownpal = 1
ignorehitpause=1

[state 120x,];FD自然減少
type = poweradd
trigger1 =0; var(12)
trigger1=  time % 3 =0
value  = -1
ignorehitpause = 1

[state 120x,]
type = varset
trigger1 = !var(12)
var(21)  = life
ignorehitpause = 1

[state 120x,]
type = lifeset
trigger1 = var(12)
trigger1 = anim = [130,155]
value  = var(21)
persistent = 1
ignorehitpause = 1

[state -2,helper partner];----test ガードするヘルパー 削除　lifesetで
type = Helper
triggerall =statetype != A
triggerall = !ishelper(120)
triggerall = var(12) = 1
triggerall = NumHelper(120) = 0
trigger1 = 0
helpertype = normal
sprpriority  = 0
name = "FD helper"
ID = 120
pos = 0,0
postype = p1
stateno = ifelse(statetype = s,130,ifelse(statetype = c,131,132))
keyctrl =1
ownpal = 1

;---------------------ろじゃとの絆　solitude strings
[state -2,helper partner];----test s string 
type = Helper
triggerall = 0;!numhelper(300)
trigger1 = var(30) = 1
helpertype = normal
name = "YY solitude strings"
ID=300
pos = 0,0
postype = p1
stateno = 8300
keyctrl =0
ownpal = 1

;-------------------------------------止まったらスーパームーブで動かないように　入れ替え？出しかえ
[state 1510,helper partner];----ヨーヨー init 8010->8000
type = Helper
triggerall = 0;NumHelper(0) = 1
trigger1 = helper(0),stateno = 8005
helpertype = normal
sprpriority  = 0
name = "yo-yo"
ID=0
pos = floor(fvar(7)),floor(fvar(8))
postype = p1
stateno = 8000
keyctrl =0
ownpal = 1

;-------------------------------------------------------------イントロに使用ヘルパーなど
[state -2,helper partner];----イントロ踏み解放用ヘルパー
type = Helper
;triggerall = NumHelper(192) = 0
triggerall = var(50) != 10  
triggerall = stateno = 0
triggerall = roundstate = 2
triggerall = p2stateno = 0
trigger1 = TeamMode = Single && enemy,teammode = single;win ()でくくれないのでトリガ分けて
trigger2 = !var(58);dos ()でくくれないのでトリガ分けて
helpertype = normal
name = "intro order"
ID = 192
pos = 0,0
postype = p2
stateno = 6020
keyctrl =0
ownpal = 1

[state -2,helper partner];----勝利イントロ用相手dist情報消失対策　2800,defenceで
type = Helper
triggerall = NumHelper(184) = 0
triggerall = enemy,alive = 0
triggerall = var(48) != 2 && var(36) != 1
;trigger1 =!var(58) 
triggerall = p2stateno = 5110
trigger1 = TeamMode = Single && enemy,teammode = single;win ()でくくれないのでトリガ分けて
trigger2 = !var(58);dos ()でくくれないのでトリガ分けて
helpertype = normal
sprpriority  = 0
name = "win intro state"
ID =184
pos = 0,0
postype = p2
stateno =2800
keyctrl =0
ownpal = 1

;----------------------------------------ボイス・効果音-2部（ガードとかは-2っぽい
;--------気絶アニメ指定時セリフ
[state -3,flag reset]
type = varadd
trigger1 = stateno != 170
trigger1 = anim = 5300
var(55) = 1

[State -3, recove voice]
type = PlaySnd
triggerall = alive 
trigger1 = var(55) = 1
value = s5300,ifelse(var(1) = 3, random % 3,var(1))
