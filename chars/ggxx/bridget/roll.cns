type = ChangeState
value = 42
triggerall = !var(6) && !var(9) && !var(53)
trigger1 = command = "holdup"

[state 600,]
type = changestate
trigger1 = pos y >= -10 && vel y > 0
value = 52


;---------ダストシステムテスと、カウント内ヒット時はきりもみ、２９カウント以降ヒットは通常に。usep2spr　　
;２９以内であれば、vel継続で飛んで行く。
[Statedef 650];test ダスト
type    = A                      
movetype= H                      
physics = n
ctrl = 0 
;velset = -0.8,-9.0
                        
[state 3800,];  ふきとび
type = changeanim
trigger1 = time = 0
trigger1 = selfanimexist(5052)
trigger1 = anim != 5052 && anim != 15052
value = ifelse(authorname = "R-R",5052 + var(0),5052)
ignorehitpause = 1

[state 3800,];  ふきとび
type = changeanim
triggerall = time = 0
trigger1 = !selfanimexist(5052)
trigger1 = selfanimexist(5051)
trigger1 = anim != 5051 && anim != 15051
value = ifelse(authorname = "R-R",5051 + var(0),5051)
ignorehitpause = 1

[state 3800,];  ふきとび
type = changeanim
triggerall = time =0
trigger1 = !selfanimexist(5052)
trigger1 = !selfanimexist(5051)
trigger1 = anim != 5050 && anim != 15050
value = ifelse(authorname = "R-R",5050 + var(0),5050)
ignorehitpause = 1

[state 650,];ほったらかした場合の保険 29カウントだから30
type = selfstate
trigger1 = time >= 30
value = 5050

;------------------------29カウント時、
;----貼りつきヘルパーにしといたほうがあとあと楽だね
;---本体var(11)と、ダスト用のvar()をリセットさせる。
[statedef 670];----
type    = A
movetype= i
physics = N
poweradd= 0
ctrl = 0
velset = 0,0
anim = 1

[state 670,]
type = nothitby
trigger1 = 1
time = 1
value = sca,na,np,nt,sa,sp,st,ha,hp,ht
ignorehitpause = 1

[state 1810,]
type  =varset
trigger1 =time = 0
var(4) = root,var(4)
ignorehitpause = 1

[state 670,]
type = posset
trigger1 = 1
x= playerID(var(4)),pos x
y = playerID(var(4)),pos y
ignorehitpause = 1

[state 670,]
type  =turn
trigger1 = root,facing != facing
ignorehitpause = 1

[state 670,]
type = destroyself
trigger1 = 1
ignorehitpause = 1

[state -2, displayb]
type = displaytoclipboard
trigger1 = 1
text = "posx=%f,posy=%f,rootx=%f,rooty=%f,fac=%d\n"
params =pos x,pos y,rootdist x,rootdist y,facing

[state -2, displayb]
type = appendtoclipboard
trigger1 = numhelper(1850)
text = "posx=%f,posy=%f,hugx=%f,hugy=%f,Rf=%d\n"
params =pos x,pos y,parentdist x,parentdist y,root,facing


