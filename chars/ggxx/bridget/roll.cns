[state -2, displayb]
type = displaytoclipboard
trigger1 = 1
trigger1 = numhelper(1850)
text = "posx=%f,posy=%f,hugx=%f,hugy=%f,fac=%d\n"
params =pos x,pos y,helper(1850),parentdist x,helper(1850),parentdist y,facing

[state -2, displayb]
type = appendtoclipboard
trigger1 = 1
trigger1 = command != "holds"
text = "velX=%f,velY=%f,RdiX= %f,RdiY=%f,v4=%d"
params =vel x,vel y,rootdist x,rootdist y,var(4)

