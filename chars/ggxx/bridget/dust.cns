[Statedef 260];
type    = S                      
movetype= A                      
physics = n
ctrl = 0                        
anim = 240                      
sprpriority = 2                 
Hitcountpersist = 1

[state -3,flag reset];ダッシュ慣性1　継続させる
type = velset
trigger1 = var(8)
trigger1 = time = 0
trigger1  =prevstateno = [0,52]
x = const(velocity.run.fwd.x) 
persistent = 0
ignorehitpause = 1

[state -3,flag reset];ダッシュ慣性2　　０にする
type = velset
trigger1 = !var(8)
trigger1 = time = 0
x = 0
y = 0
persistent = 0
ignorehitpause = 1

[state -3,flag reset];ヒットカウント
type = varadd
trigger1 = movehit
fvar(2) = 1
persistent = 0
ignoregutpause = 1

[State 200x,]
type = Velmul
trigger1 = Vel X > 0
x = 0.80

[State 200x,]
type = Velset
trigger1 = Vel X <= 0.5
x = 0

[State 240, hit1]
type = HitDef
trigger1 = time = 0
attr = S, NA                     ;立ち状態で、通常の攻撃(ｓは立ち、ｎは通常、aは攻撃を表す)
damage = floor(17 * fvar(0)),0                   ;ダメージ量（左が当たった時、右はガードした時）
animtype = diagup                 ;当てた時の相手のポーズ（light/midium/hard/back）から選択
guardflag = H                   ;ガードできる状態（ｍaは全ての状態でガード可能）
hitflag = MAFD                   ;当てる事のできる条件
priority = 6, Hit                ;攻撃の優先権（0弱い　4通常　7強い
pausetime =10, 10                 ;攻撃が当たった時の硬直時間（左が自分、右が相手）
guard.pausetime =10, 10                 ;攻撃が当たった時の硬直時間（左が自分、右が相手）
sparkno = -1;701;s6300   
guard.sparkno = -1;751;S6150
sparkxy = -5, -56               ;ヒットエフェクトを表示する場所（相手の座標で）
hitsound   = s205, 6
guardsound = s150, 0
ground.type = low               ;相手のくらった場所（High：頭、体, Low：足, Trip：足払い）
ground.slidetime = 60             ;相手が後にすべる時間
ground.hittime  = 80             ;コンボが繋がる時間（高くしすぎない事）
ground.velocity = -0.8,-8.5             ;地上で攻撃をくらった場合の相手の移動状況（ｘとｙで小数点可
guard.velocity = -6.5             ;地上で攻撃をくらった場合の相手の移動状況（ｘとｙで小数点可）
guard.hittime = 20
guard.slidetime = 18             
air.type = High                
air.velocity = fvar(5), fvar(2) / 4 + fvar(6);-2.5, -6.5                    
air.hittime = 20
air.sliedtime = 18                 
down.velocity = -5,-3.5            
down.hittime  = 7
down.slidetime =  7            
yaccel = 0.38
fall.envshake.time = 15
fall = 1
getpower = 40,20
fall.recover = ifelse(var(25),0,1)
ID=260
p2facing=1

