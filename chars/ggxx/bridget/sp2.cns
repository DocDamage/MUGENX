;---ぶりじっと　ヨーヨー熊関連 root,v20でロジャー性格変更（モードチェンジ)0,normal 1,ex
;helper(0) fv20x,21y に速度代入 v34=タイムカウント v35=ヒットカウント v36=最大ヒット数(モードによる) 
;1700じゃっく　１８００ハグ　１９００らっしゅ

;-----------ジャックロジャー
;ノーマル　3回まで、無敵　これまたvar(34,35)
;ＥＸ	　　5回まで、食らいあり
[statedef 1700];----
type    = A
movetype= A
physics = N
poweradd= 0
ctrl = 0
;velset = 0,0
sprpriority = 2
hitcountpersist = 1
anim = 1700

[state 8000,]
type = velmul
trigger1 = time = 0
x = 0.65
persistent = 0
ignorehitpause = 1

[state 8000,];ハグ経由の時機械エフェクトけし　1830
type = RemoveExplod
trigger1 = time = 0
ID=1830
ignorehitpause = 1

[state 8000,];なんで消えない！？
type = RemoveExplod
trigger1 = time = 0
ID=1575
ignorehitpause = 1

[state 1700,var];タイムリセット　
type = varset
trigger1 =time = 0
var(34) = 0

[state 1700,var];リセット　
type = varset
trigger1 =time = 0
var(35) = 0

[state 1700,fvarset];ヨーヨー，本体からの命令リセット
type = parentvarset
trigger1 = time = 0
var(10) = 0

[state 1700,fvarset];ヨーヨーフラグ1900
type = parentvarset
trigger1 = time = 0
var(30) = 1700

[state 1700,fvarset];クマさん性格により速度違う vel x
type = varset
trigger1 = time = 0
fvar(20) = ifelse(root,var(20) = 0,0.5,2.0)

[state 1700,fvarset];クマさん性格により速度違う vel y
type = varset
trigger1 = time = 0
fvar(21) = ifelse(root,var(20) = 0,1,2.5)

[state 1700,fvarset];クマさん性格により攻撃回数違う　V36 = var(35)
type = varset
trigger1 = time = 0
var(36) = ifelse(root,var(20) = 0,3,5) ;+ 1

[state 1700,fvarset];攻撃力
type = varset
trigger1 = time = 0
fvar(0) = root,fvar(0)

[State 1700, g voice];N:命を無駄にする E:引き際
type = PlaySnd
triggerall = root,var(59)
trigger1 = animelem = 1
value = s1700, ifelse(root,var(20), 0,1)
channel = 5
persistent = 0

[State 1430, sound];振り回し!
type = PlaySnd
trigger1 = time = 2
value = s1400,0
persistent = 0
channel = 2

;fvar(18),root,pos x: fvar(19),rooto,pos y: fvar(22),縦横比
;-------------------------移動新式：本体がある程度ずれたらVEL再設定へ、
[state 8150,1];本体現在地X
type = varset
trigger1 = time = 0
fvar(18) = root,pos x
ignorehitpause = 1

[state 8150,2];本体現在地Y
type = varset
trigger1 = time = 0
fvar(19) = root,pos y
ignorehitpause = 1

;符号無視：大きい方が何Fでつくか計算、代入　基本量（スピード）=7、EX：X77y50>77/7で11f,移動量X=7(11F),Y移動量7/11f(11F)
;distが０以外のとき、０除算注意のため
[state 8150,2]
type = varset
triggerall = ABS(rootdist y) != 0
triggerall = ABS(rootdist x) != 0
trigger1 = time = 0
fvar(22) = ifelse(ABS(rootdist x) > ABS(rootdist y),rootdist x / fvar(21),rootdist y / fvar(21))
ignorehitpause = 1

;distが０、もしくはdist x=dist y
[state 8150,2]
type = varset
triggerall = time = 0
trigger1 = rootdist y = 0
trigger2 = rootdist x = 0
trigger3 = rootdist x = rootdist y
fvar(22) = 0
ignorehitpause = 1

;----------------------基本移動量＝7
[state 8150,5];-217,90 
type = velset
triggerall = fvar(22);0でないなら比計算されてるはず
trigger1 = time = 0
;trigger1 = ABS(rootdist x) > ABS(rootdist y - 50) 
x = ABS(rootdist x / fvar(22)) * ifelse(rootdist x < 0,-1,1)
y = ABS(rootdist y / fvar(22)) * ifelse(rootdist y < 0,-1,1)
ignorehitpause = 1

[state 8150,5];
type = velset
triggerall = !fvar(22);0の時は特殊
triggerall = time = 0
trigger1 = rootdist y = 0
trigger2 = rootdist x = 0
x = ifelse(rootdist x = 0,0,fvar(21)) * ifelse(rootdist x < 0,-1,1)
y = ifelse(rootdist y = 0,0,fvar(21)) * ifelse(rootdist y < 0,-1,1)
ignorehitpause = 1

[state 8150,5];同じ値で90.90　ともに0じゃない時（0除算　
type = velset
triggerall = !fvar(22);0の時は特殊
triggerall = time = 0
trigger1 = rootdist x = rootdist y
trigger1 = rootdist x != 0 && rootdist y != 0
x = ABS(rootdist x / fvar(21)) * ifelse(rootdist x < 0,-1,1);
y = ABS(rootdist y / fvar(21)) * ifelse(rootdist y < 0,-1,1)
ignorehitpause = 1

[state 8150,5];
type = velset
triggerall = !fvar(22);0の時は特殊
triggerall = time = 0
trigger1 = rootdist y = 0
trigger1 = vel x = 0
x = fvar(21)
ignorehitpause = 1

[state 1900,];アニメ始まったら動いてたが,判定でるのは1、2、3・・・、4から？
type = changestate
trigger1 = animelem = 4
value = 1710

;--------------------------------------------------
