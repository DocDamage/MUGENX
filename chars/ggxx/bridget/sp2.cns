;---------------以下移動、　本体に戻る

;-------------------------------------------きるろじゃだけは特殊、原作で速度０，０になったこと1度確認、条件不明
;符号無視：大きい方が何Fでつくか計算、代入　基本量（スピード）=7、EX：X77y50>77/7で11f,移動量X=7(11F),Y移動量7/11f(11F)
;distが０以外のとき、０除算注意のため
[state 8150,2]
type = varset
triggerall = ABS(rootdist y) != 0
triggerall = ABS(rootdist x) != 0
triggerall = ABS(rootdist x) > ABS(rootdist y)
trigger1 =  rootdist x !=[-50,50];[-30,30]
fvar(22) = rootdist x / fvar(21)
ignorehitpause = 1

[state 8150,2]
type = varset
triggerall = ABS(rootdist y) != 0
triggerall = ABS(rootdist x) != 0
triggerall = ABS(rootdist x) < ABS(rootdist y)
trigger1 = rootdist y !=[-10,30];[-10,10]
fvar(22) = rootdist y / fvar(21)
ignorehitpause = 1

;distが０、もしくはdist x=dist y
[state 8150,2]
type = varset
trigger1 = rootdist y = 0
trigger2 = rootdist x = 0
trigger3 = rootdist x = rootdist y
fvar(22) = 0
ignorehitpause = 1

;----------------------基本移動量＝fvar(21)
[state 8150,5];-217,90 x
type = velset
triggerall = fvar(22);0でないなら比計算されてるはず
trigger1 = rootdist x !=[-50,50];[-30,30]
x = ABS(rootdist x / fvar(22)) * ifelse(rootdist x < 0,-1,1)
ignorehitpause = 1

[state 8150,5];-217,90 y
type = velset
triggerall = fvar(22);0でないなら比計算されてるはず
trigger1 = rootdist y !=[-10,10];[-10,10]
y = ABS(rootdist y / fvar(22)) * ifelse(rootdist y < 0,-1,1)
ignorehitpause = 1

[state 8150,5];x
type = velset
triggerall = !fvar(22);0の時は特殊
trigger1 = rootdist y = 0
trigger1 = rootdist x !=[-50,50];[-30,30]
x = ifelse(rootdist x = 0,0,fvar(21)) * ifelse(rootdist x < 0,-1,1)
ignorehitpause = 1

[state 8150,5];y
type = velset
triggerall = !fvar(22);0の時は特殊
trigger1 = rootdist x = 0
trigger1 = rootdist y !=[-10,10];[-10,10]
y = ifelse(rootdist y = 0,0,fvar(21)) * ifelse(rootdist y < 0,-1,1)
ignorehitpause = 1

[state 8150,5];同じ値で90.90　ともに0じゃない時（0除算　
type = velset
triggerall = !fvar(22);0の時は特殊
triggerall = rootdist x = rootdist y
triggerall = rootdist x != 0 && rootdist y != 0
trigger1 = rootdist y !=[-10,10];[-10,10] 
trigger1 = rootdist x !=[-50,50];[-30,30]
x = ABS(fvar(21)) * ifelse(rootdist x < 0,-1,1);
y = ABS(fvar(21)) * ifelse(rootdist y < 0,-1,1)
ignorehitpause = 1

