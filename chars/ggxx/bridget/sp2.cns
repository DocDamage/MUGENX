y = ABS(rootdist y / fvar(21)) * ifelse(rootdist y < 0,-1,1)
ignorehitpause = 1

[state 8150,5];
type = velset
triggerall = !fvar(22);0の時は特殊
triggerall = time != 0
trigger1 = rootdist y = 0
trigger1 = vel x = 0
x = fvar(21)
ignorehitpause = 1


