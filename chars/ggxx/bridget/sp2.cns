;---------------以下移動、　敵に p2 あたれば→target(1820)
;符号無視：大きい方が何Fでつくか計算、代入　基本量（スピード）=7、EX：X77y50>77/7で11f,移動量X=7(11F),Y移動量7/11f(11F)
;distが０以外のとき、０除算注意のため
[state 8150,2]
type = varset
triggerall = ABS(p2dist y) != 0
triggerall = ABS(p2dist x) != 0
trigger1 = time != 0
fvar(22) = ifelse(ABS(p2dist x) > ABS(p2dist y),p2dist x / 3,p2dist y / 3)
ignorehitpause = 1

;distが０、もしくはdist x=dist y
[state 8150,2]
type = varset
triggerall = time != 0
trigger1 = p2dist y = 0
trigger2 = p2dist x = 0
trigger3 = p2dist x = p2dist y
fvar(22) = 0
ignorehitpause = 1

;----------------------基本移動量＝7
[state 8150,5];-217,90 
type = velset
triggerall = fvar(22);0でないなら比計算されてるはず
trigger1 = time != 0
;trigger1 = ABS(p2dist x) > ABS(p2dist y - 50) 
x = ABS(p2dist x / fvar(22)) * ifelse(p2dist x < 0,-1,1)
y = ABS(p2dist y / fvar(22)) * ifelse(p2dist y < 0,-1,1)
ignorehitpause = 1

[state 8150,5];
type = velset
triggerall = !fvar(22);0の時は特殊
triggerall = time != 0
trigger1 = p2dist y = 0
trigger2 = p2dist x = 0
x = ifelse(p2dist x = 0,0,3) * ifelse(p2dist x < 0,-1,1)
y = ifelse(p2dist y = 0,0,3) * ifelse(p2dist y < 0,-1,1)
ignorehitpause = 1

[state 8150,5];同じ値で90.90　ともに0じゃない時（0除算　
type = velset
triggerall = !fvar(22);0の時は特殊
triggerall = time != 0
trigger1 = p2dist x = p2dist y
trigger1 = p2dist x != 0 && p2dist y != 0
x = ABS(p2dist x / 3) * ifelse(p2dist x < 0,-1,1);
y = ABS(p2dist y / 3) * ifelse(p2dist y < 0,-1,1)
ignorehitpause = 1

[state 8150,5];
type = velset
triggerall = !fvar(22);0の時は特殊
triggerall = time != 0
trigger1 = p2dist x = p2dist y
trigger1 = p2dist x = 0 && p2dist y = 0
x = 0
y = 0
ignorehitpause = 1

