;防御・イントロ　GGXX Defense.cns
;v(0)csystem,v(1),voice v(2-4)ID v(5) root order
;var(6)2JFvar(7)AirDF var(8)GroDF var(9)JレバーニュートラルF var(11)エリアル v(12)直前Ｇ　
;v13 ハイジャンプＦ v14,R移動回数 v15,R移動開始16,YY先行入力 v20 ロジャ性格改変F
;v25カウンター判定 ;v48 キャラチェック v49 自キャラチェック v55 気絶セリフ v56 よろけv57 ＫＯセリフ
;v52,53 AI v58 チームモード判定 v59 イントロ相手解放用
;fv10,fv11 burst
;YY init in 1500 fv(20)-velX fv(21)-velY fv(22)-posX fv(23)-posY v30 states flag
;s700 挑発s710 敬意s720 一撃セリフ挑発 s750 デッドアングル（ガードキャンセル) s760 burst
;s1100,スターシップ地上 s1200,スターシップ空中, s1300,キックスタートマイハート s1400,ローリング移動
;s1500-地上YY配置 s152-地上YY戻し s1530-空中YY配置 s1550-空中YY戻し s1560-ダウンYY配置
;s1600 ラッシュ命令 1620 ハグ命令 s1640 ジャック命令 s1700 ジャック s1800 ハグ　s1900 ラッシュ 
;s2000,サイク s2100,ロマキャン s2500よろけ s2800勝利イントロ関連追加 
;s3100 るーぷざるーぷ s3200 メンテ悲劇　s3300 メンテ喜劇 s3400 キル s3500 キルロジャループ s3600 むーん
;helper var34,35 攻撃ループ関連
;s3450 暗転リング s8500必殺ヒットエフェクト

[statedef 999];AIテスト
type = s

[state 999,]
type = varset
trigger1 = time = 0
var(59) = 1

[state 999,]
type = changestate
trigger1 = time = 0
value = 0
ctrl = 1

;---------------軽ヒット＆ガードえふぇ
[statedef 8400];ヒットエフェクトテスト　
type = A
movetype = I
physics = N
anim =1;f2000; だけど場所確定まではなしで 
velset =0,0
ctrl  =0
sprpriority = 3

[state 8400,]
type = changeanim
trigger1 = time = 0
trigger1 = enemynear,stateno = [120,155]
value = 6150

[state 8400,]
type = destroyself
trigger1 = animtime = 0

;-------------必殺以上のエフェクト、重くなるので少なめにしたい。8500 + random % 5

;------当たったとこから動かずさっさと消える。場所は多少ランダムでもよさげ
