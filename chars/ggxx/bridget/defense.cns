;符号無視：大きい方が何Fでつくか計算、代入　基本量（スピード）=7、EX：X77y50>77/7で11f,移動量X=7(11F),Y移動量7/11f(11F)
;distが０以外のとき、０除算注意のため
[state 8150,2]
type = varset
triggerall = ABS(parentdist y) != 0
triggerall = ABS(parentdist x) != 0
trigger1 = time != 0
fvar(22) = ifelse(ABS(parentdist x) > ABS(parentdist y),parentdist x / 5,parentdist y / 5)
ignorehitpause = 1

;distが０、もしくはdist x=dist y
[state 8150,2]
type = varset
triggerall = time != 0
trigger1 = parentdist y = 0
trigger2 = parentdist x = 0
trigger3 = parentdist x = parentdist y
fvar(22) = 0
ignorehitpause = 1

;----------------------基本移動量＝7
[state 8150,5];-217,90 
type = velset
triggerall = fvar(22);0でないなら比計算されてるはず
trigger1 = time != 0
x = ABS(parentdist x / fvar(22)) * ifelse(parentdist x < 0,-1,1)
y = ABS(parentdist y / fvar(22)) * ifelse(parentdist y < 0,-1,1)
ignorehitpause = 1

[state 8150,5];
type = velset
triggerall = !fvar(22);0の時は特殊
triggerall = time != 0
trigger1 = parentdist y = 0
trigger2 = parentdist x = 0
x = ifelse(parentdist x = 0,0,5) * ifelse(parentdist x < 0,-1,1)
y = ifelse(parentdist y = 0,0,5) * ifelse(parentdist y < 0,-1,1)
ignorehitpause = 1

[state 8150,5];同じ値で90.90　ともに0じゃない時（0除算　
type = velset
triggerall = !fvar(22);0の時は特殊
triggerall = time != 0
trigger1 = parentdist x = parentdist y
trigger1 = parentdist x != 0 && parentdist y != 0
x = ABS(parentdist x / 5) * ifelse(parentdist x < 0,-1,1);
y = ABS(parentdist y / 5) * ifelse(parentdist y < 0,-1,1)
ignorehitpause = 1

[state 8150,5];
type = velset
triggerall = !fvar(22);0の時は特殊
triggerall = time != 0
trigger1 = parentdist x = parentdist y
trigger1 = parentdist x = 0 && parentdist y = 0
x = 0
y = 0
ignorehitpause = 1

[state 8150,]
type = destroyself
trigger1 = time >= 30
trigger2 = parentdist x = [-5,5]
trigger2 = parentdist y = [-5,5]
 
