;---------------------------------------------------------------------------
; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[state 120x,];FD自然減少
type = poweradd
trigger1 = var(12)
trigger1=  time % 3 =0
value  = -1
ignorehitpause = 1

[state 120x,]
type = bindtoroot
trigger1 = ishelper(120)
time = 1
pos  =0,0

[state 120x,]
type = destroyself
triggerall = ishelper(120)
trigger1 = root,var(12) = 0

[State type]
type = StateTypeSet
trigger1 = var(12) = 1 && statetype!= A
trigger1 = command!= "holddown"
statetype = S

[State type]
type = StateTypeSet
trigger1 =var(12) = 1 && statetype!= A
trigger1 = command = "holddown"
statetype = C

[State anim]
type = ChangeAnim
trigger1 = var(12) = 1
value = 130+(statetype=C)+(statetype=A)*2 +var(0)

[State 120, 1]
type = ChangeAnim
trigger1 = var(12) = 0 && time = 0
value = 120 + (statetype = C) + (statetype = A)*2 +var(0)

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = statetype = A
physics = n

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
trigger1 = !var(12)
value = 130 + (statetype = C) + (statetype = A)*2


[State 120, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !inguarddist
trigger2 = !var(12)
value = 140

;------------地上ダッシュ　慣性処理（おもにFD
[state -3,flag reset];ダッシュ慣性1　継続させる
type = velset
triggerall = statetype != A
trigger1 = var(8)
trigger1 = time = 0
trigger1  =prevstateno = [0,52]
x = const(velocity.run.fwd.x) 
persistent = 0
ignorehitpause = 1

[state -3,flag reset];ダッシュ慣性2　　０にする
type = velset
triggerall = statetype != A
trigger1 = !var(8)
trigger1 = time = 0
x = 0
y = 0
persistent = 0
ignorehitpause = 1

[State 200x,]
type = Velmul
triggerall = statetype != A
trigger1 = Vel X > 0
x = 0.93

[State 200x,]
type = Velset
triggerall = statetype != A
trigger1 = Vel X <= 0.5
x = 0

;-----------------airだっしゅ中の処理（ｘしばらく継続、0になったらｙかかる
[State 200x,];前空中ダッシュでセットされるvar7)、０じゃなければダッシュ慣性つき→prevだと、チェーンの場合変。
type = Velmul
triggerall = statetype = A
trigger1 = var(17) > 0
trigger1 = Vel X > 0.1
x = 0.95

[State 200x,]
type = Velset
triggerall = statetype = A
trigger1 = var(17)
trigger1 = Vel X = [0,1]
x = 1

[state 200x,com var];
type = varadd
triggerall = statetype = A
trigger1 = var(17) > 0
trigger1 = 1
var(17) = -1

[state 200x,com var];
type = varset
triggerall = statetype = A
trigger1 = var(17) <= 0
var(17) = 0

;------------------R移動キャンセルFD時の重力設定--------
[state 600];1400から来てたらｙをmulしてみる
type = velmul
triggerall = prevstateno = 1400;var(18) = 2 
trigger1 = time = 0
y = 0.5

[state 600];重力→普通ジャンプ、ダッシュ後なら通常、R移動ごならR移動重力。
type = veladd
triggerall = statetype = A
triggerall = var(18) != 2 
trigger1 = var(18) = 1 && !var(17);
trigger2 = !var(18) || !var(17) 
y = const(movement.yaccel) 

;--------------------------R移動中の処理
[state 600];重力→普通ジャンプ、ダッシュ後なら通常、R移動ごならR移動重力。
type = veladd
triggerall = statetype = A
trigger1 = var(18)=2 
y = fvar(18)

[state 120,]
type = changestate
triggerall = statetype = A
trigger1 = pos y >= 0 && vel y > 0
value = 130


