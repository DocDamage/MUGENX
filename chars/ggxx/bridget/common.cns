trigger1 = time > 0
x = 0.22

[State 100, 1];0.44dot？1.05%?
type = Veladd
trigger1 = time > 0
x = -1 * (vel x  * 0.0105)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2= NoAutoTurn

[State 100, 4];奪取中J
