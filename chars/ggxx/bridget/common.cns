; Common state file GGXX + TWIN custom 1&5
;
; System variables usage
; ----------------------
; Var name    Type   Purpose
; --------    ----   -------
; sysvar(0)   Temp   Set by state 5081 (HITL_SLIDE) to 1 to prevent
;                    showing ground hit frame in state 5110 (HIT_LIEDOWN).
;                    Used by guarding states.
; sysvar(1)   Temp   Used by state 40 (Jump Start) amd 45 (Air Jump Start)
;                    to keep track of which way to jump.
;                    Used by state 5100 and 5110 to remember downward
;                    velocity of player just before hitting the ground.
;                    Used in state 5080 for storing the anim # to display.

;
;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0
hitcountpersist = 1

[State 0, helvar]
type = parentvarset
triggerall = ishelper(0)
trigger1 = time = 0
var(10) = 0

[state 120x,]
type = changestate
triggerall = ishelper(120)
trigger1 = root,var(12) >= 1
trigger1 = time = 0
value = 130

[state 0,]
type = destroyself
trigger1 = ishelper

[State 0, 10]
type = ChangeAnim
trigger1 = 0;Anim != 0&& Anim != 5 + var(0)
trigger2 = Anim = 5 + var(0) && AnimTime = 0 ;Turn anim over
trigger3 = animtime = 0
value = 0 + var(0)

[State 0, 1ex]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 && anim !=10000 && anim != 10005
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
trigger3 = Anim = 10005 && AnimTime = 0 ;Turn anim over
value = 0+ var(0)

[state 0,tes]
type = changestate
trigger1 = time > 300
value = 2

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[Statedef 2]
type = S
physics = S
sprpriority = 0
hitcountpersist = 1
anim = 2 + var(0)

[state 2,]
type = changestate
trigger1 = time > 60
trigger1 = animtime = 0
value = 0

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10 + var(0)
hitcountpersist = 1 

[state 10,];ハイジャンプフラグ　タイマー仕様
type = varset
trigger1 =0; time = 0
var(13) = 12

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11+ var(0)
sprpriority = 0
hitcountpersist = 1

[state 10,];ハイジャンプフラグ　タイマー仕様
type = varset
trigger1 = time >= 5
var(13) = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
trigger2 = Anim = 10006 && AnimTime = 0
;trigger3 = Anim = 10014 && AnimTime = 0
value = 11+ var(0)

[State 11, 1]
type = ChangeAnim
triggerall = var(0)
triggerall = anim != 10006
trigger1 = Anim = 6
value = 6+ var(0)

[state 120x,]
type = changestate
triggerall = command = "holdback"
trigger1 = !ishelper(120) 
trigger1 = var(12) >= 1
trigger1 = time = 0
value = 131

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12+ var(0)
hitcountpersist = 1

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0
hitcountpersist = 1

[state 120x,]
type = changestate
trigger1 = var(12) >= 1
trigger1 = time = 0
value = 130

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x) 

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 + var(0)&& Anim != 5+ var(0)
trigger2 = Anim = 5+ var(0) && AnimTime = 0
value = 20+ var(0)

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 + var(0)&& Anim != 5+ var(0)
trigger2 = Anim = 5 + var(0)&& AnimTime = 0
value = 21+ var(0)

;---------------------------13ではいＪ------------------------------------------------; Jump Start
[Statedef 40]
type    = S
physics = S
;anim = 40+ var(0)
ctrl = 0
sprpriority = 1
hitcountpersist = 1

[State -1, ] ;ダストHJ　23=1 && 22 > 0
type = ChangeState
value = 43
triggerall = var(23) = 1 && var(22) > 0 && !var(53)
trigger1 = time = 0

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
triggerall = !var(11)
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
triggerall = !var(11)
trigger1 = command = "holdback"
sysvar(1) = -1

;------------meltysystem custom ggxx-------------
[state 40,ca]
type = changeanim
trigger1 = time = 0
value = 40;ifelse(sysvar(1)=0, 40, ifelse(sysvar(1)=1, 38, 39))+ var(0);前38　後３９　上40

[State 40, 4]
type = VelSet
triggerall = !var(11)
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
;y = const(velocity.jump.y) - ifelse(var(13),1.5,0)
y = ifelse(var(13),-12,const(velocity.jump.y)); - ifelse(var(13),1.5,0)

[State 40, 3];エリアル
type = Velset
triggerall = var(11)
trigger1 =AnimTime = 0
x = 1.5
y = const(velocity.jump.y) - 1

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 99 ;RUN_FWD
trigger1 = sysvar(1) = 0
x = 1.5

[State 200x,];dash  大、ホーミング
type = Afterimage
trigger1 = var(13)
trigger1 = animtime = 0
trigger2 = var(11)
trigger2 = animtime = 0
trans = add1
TimeGap = 2
FrameGap = 3
length = 20
time =40
PalBright = 0,0,0
PalContrast = 125,125,125
PalAdd = 0,0,0

[state 100x,atc efe];Jエフェクト
type = Explod
trigger1 =  animtime = -1
anim =6040;f800
ID = 100
;postype = p1
;pos = -25,20
sprpriority = -2
bindtime = 1
removetime = -2
ownpal=1
persistent =0
scale = 0.5,0.5

[State 40, 6]
type = playsnd
trigger1 = AnimTime = 0
value = s40,ifelse(var(13),1,0)
channel = 2

[State 40, 1]
type = VarSet
trigger1 = var(13)
trigger1 = Time = 0
var(6) = 1

[state 40,1];jump F
type = varset
trigger1 =AnimTime = 0
var(9) = 1

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;--------------------2段ジャンプスタート（同40）
[Statedef 42]
type    = A
physics = N
ctrl = 0
sprpriority = 1
Hitcountpersist = 1

[State 42, 1]
type = VarSet
trigger1 = Time = 0
var(6) = 1

[State 42, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 42, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 42, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 42, 4];同じにしてみる？21/2
type = VelSet
trigger1 = Time = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y) +1.5

[State 40, 6]
type = playsnd
trigger1 = Time = 0
value = s40,0
channel = 2

[State 42, 6]
type = ChangeState
trigger1 = Time = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44+ var(0))
value = 44+ var(0)

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44+ var(0))
value = 41+ var(0)

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A
hitcountpersist = 1

[state 50,1]
type = varset
trigger1 = time >= 2
trigger1 = command != "holdup"
var(9) = 0

[State 50, 1]
type = VarSet
trigger1 = 0;Time = 0
sysvar(1) = 0

;---------------------上40->41->47 前38->42->48　後39->43->49　----
[State 50, 2]
type = ChangeAnim
trigger1 = !var(11)
trigger1 = Time = 0
value = 41;ifelse((vel x)=0, 41+ var(0), ifelse((vel x)>0, 42+ var(0), 43+ var(0)))

[State 50, 2];ホーミングジャンプは垂直と同じだった。
type = ChangeAnim
trigger1 = var(11)
trigger1 = Time = 0
value = 41 + var(0);ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 40, 6];降下音
type = playsnd
trigger1 = !var(13) || !var(11)
trigger1 = vel y > 0
value = s40,2
channel = 2
persistent = 0

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3+ var(0))
persistent = 0
value = Anim + 3 + var(0)

[State 200x,]
type = Velmul
trigger1 = time > 0
y = 1.0

;---------------------------------------------------------------------------
; Jump Down (empty state for compatibility)
[Statedef 51]
type    = A
physics = N
hitcountpersist = 1

[state 40,]
type = velmul
triggerall = time = 0
trigger1 = prevstateno = 102
trigger2 = prevstateno = 107
x = 0.65
persistent = 0
ignorehitpause = 1

[State 45, 1];減算、レバーふんばり（？）分はカウントしない。
type = Varset;add
trigger1 = Time  = 0;>= 1
var(17) = 0;-1

[State 40, 6];降下音
type = playsnd
trigger1 = vel y > 0
value = s40,2
channel = 2
persistent = 0

;--------------------------
[state 600];重力→普通ジャンプ、ダッシュ後なら通常、R移動ごならR移動重力。
type = veladd
triggerall = var(18) != 2
trigger1 = var(18) = 1 && !var(17);
trigger2 = !var(18) || !var(17) 
y = const(movement.yaccel) 

;--------------------------R移動中の処理
[state 600];重力→普通ジャンプ、ダッシュ後なら通常、R移動ごならR移動重力。
type = veladd
trigger1 = var(18)=2
y = fvar(18);0.35

[State 51, 1]
type = Null
trigger1 = 0

[state 51,];Aやめたので必要
type  =changestate
trigger1 = vel y > 0 && pos y >= 10
value = 52
 
;---------------------------------------------------------------------------
; Jump Land physics Aで地上接地すると自動でくるので（システム）注意
[Statedef 52]
type    = S
movetype = U
physics = S
ctrl = 0
hitcountpersist = 1

[State 40, 6];
type = playsnd
trigger1 =time = 0
value = s100,1
channel = 2
