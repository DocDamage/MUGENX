anim =6047;f802
ID = 52
postype = p1
pos = 0,0
random = 30,0
sprpriority = -2
bindtime = 1
removetime = -2
ownpal=1
persistent =0
scale = 0.5,0.5

[state 100x,atc efe];着地エフェクト
type = Explod
trigger1 = 1;time  = 0
anim =6047;f802
ID = 52
postype = p1
pos = 0,0
random = 30,0
sprpriority = -2
bindtime = 1
removetime = -2
ownpal=1
