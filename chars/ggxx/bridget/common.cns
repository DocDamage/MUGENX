value = ifelse(sysvar(1)=0, 47+ var(0), ifelse(sysvar(1)=1, 48+ var(0), 49+ var(0)));47上　48前　49後

[State 52, 1];振り向き
type = ChangeAnim
triggerall = var(0)
triggerall = anim != [10000,10005]
trigger1 = Anim = 5
value = 5+ var(0)

[State 52, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, Landing Sound]
type = PlaySnd
trigger1 = Time = 0
value = s47, 0

[state 100x,atc efe];着地エフェクト
type = Explod
