trigger1 = command = "holdup"
value = 40

[State 100, 4]
type = ChangeState
trigger1 = 0;command != "holdfwd"
;trigger1 = animtime = 0
value = 0

[State 100, 4]
type = ChangeState
trigger1 = time >= 12
trigger1 = command != "holdfwd"
value = 99
ctrl = 0

