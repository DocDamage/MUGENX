; Player information
[Info]
name = "Jax_X"        ;Name of character
displayname = "Jax_X" ;Name of character to display
versiondate = 04,14,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "NHK"         ;Character author name
pal.defaults = 11,5,6,8,7,1,9,10,4,3,12,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = J.cmd   ;Command set
cns     = J.cns   ;Constants
st      = J.cns   ;States
st2     = natsumi.cns
st3     = rope.st
st4     = kasoku.st
st5     = dokidoki.st
st6     = op.st
stcommon = common1.cns ;Common states
sprite  = J.sff   ;Sprite
anim    = j.air   ;Animation
sound   = j.snd   ;Sound
pal1    = J.act  ;Palettes (can have up to 12)
pal2    = J2.act

; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def