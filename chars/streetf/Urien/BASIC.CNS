[Statedef -2]

[State -2]
type = DisplayToClipboard
trigger1 = 1
text = "Parry=%d RedParry =%d Dizzy =%d DizzyMash=%d PowerUp=%d"
params = var(20), var(23), var(40), var(30), var(50)
ignorehitpause = 1

[State -2]
type = VarAdd
trigger1 = var(20) != 0
var(20) = -1

[State -2]
type = VarAdd
trigger1 = var(21) != 0
var(21) = -1

[State -2]
type = VarAdd
trigger1 = var(22) != 0
var(22) = -1

[State -2]
type = VarAdd
trigger1 = var(23) >= 0
var(23) = -1

[State -2]
type = VarSet
triggerall = var(20) = 0
trigger1 = command = "parryhigh" && command != "holddown" && Command != "holdup"
trigger1 = StateType != A
trigger1 = Stateno != [5000,5400]
var(20) = 10

[State -2]
type = VarSet
