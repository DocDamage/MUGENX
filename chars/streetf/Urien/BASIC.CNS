; HITC_SLIDE
[Statedef 5011]
type    = C
movetype= H
physics = C

[State 5001, 1]
type = VarSet
trigger1 = Time = 0
v = 11
value = GetHitVar(hittime)

[State 5011, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 5011, 2]
type = ChangeAnim
trigger1 = AnimTime = 0
value = 5025 + GetHitVar(animtype)

[State 5000, 4] ;Freeze anim
