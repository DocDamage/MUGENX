;====================================================================
;=		    									  =
;=	  			URIEN'S CONSTANT	  				  =
;=		  									  =
;=	        									  =
;====================================================================

[Data]
life = 1000			;Amount of life to start with
attack = 100		;attack power (more is stronger)
defence = 100		;defensive power (more is stronger)
fall.defence_up = 50	;Percentage to increase defense everytime player is knocked down
liedown.time = 30		;Time which player lies down for, before getting up
airjuggle = 20		;Number of points for juggling
sparkno = 2			;Default hit spark number for HitDefs
guard.sparkno = S6019	;Default guard spark number
KO.echo = 0			;1 to enable echo on KO
volume = 0			;Volume offset (negative for softer)
IntPersistIndex = 60	;Variables with this index and above will not have their values
FloatPersistIndex = 40  ;reset to 0 between rounds or matches. There are 60 int variables,
  				;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
  				;If omitted, then it defaults to 60 and 40 for integer and float
  				;variables repectively, meaning that none are persistent, i.e. all
  				;are reset. If you want your variables to persist between matches,
  				;you need to override State 5900 from common1.cns.


[Size]
xscale = 1			;Horizontal scaling factor.
yscale = 1			;Vertical scaling factor.
ground.back = 15		;Player width (back, ground)
ground.front = 16		;Player width (front, ground)
air.back = 12		;Player width (back, air)
air.front = 12		;Player width (front, air)
height = 75			;Height of player (for opponent to jump over)
attack.dist = 160		;Default attack distance
proj.attack.dist = 90	;Default attack distance for projectiles
proj.doscale = 0		;Set to 1 to scale projectiles too   
head.pos = 0, -120	;Approximate position of head
mid.pos = 0, -80		;Approximate position of midsection
shadowoffset = 0		;Number of pixels to vertically offset the shadow
draw.offset = 0,0       ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.4		;Walk forward
walk.back = -2.2		;Walk backward
run.fwd  = 4.6, 0		;Run forward (x, y)
run.back = -4.5,-3.8	;Hop backward (x, y)
jump.neu = 0,-8.4		;Neutral jumping velocity (x, y)
jump.back = -2.55		;Jump back Speed (x, y)
jump.fwd = 2.5		;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1;Running jump speeds (opt)
runjump.fwd = 4,-8.1	;.
airjump.neu = 0,-8.1	;.
airjump.back = -2.55	;Air jump speeds (opt)
airjump.fwd = 2.5		;.

[Movement]
airjump.num = 0		;Number of air jumps allowed (opt)
airjump.height = 35	;Minimum distance from ground before you can air jump (opt)
yaccel = .44		;Vertical acceleration
stand.friction = .85	;Friction coefficient when standing
crouch.friction = .82	;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Jump Start
[Statedef 48]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 48, VarSet]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 48, VarSet]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 48, VarSet]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 48, Velset]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = -10

[State 48, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 49
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 49]
type    = A
physics = A

[State 49, VarSet]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 49, ChangeAnim]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 51, ifelse((vel x)>0, 52, 53))

[State 49, AfterImage]
type = AfterImage
trigger1 = (!Time)
time 	= 8
timegap = 3
framegap = 2
length = 5
paladd = 0, 0, 0
palmul = 1, 1, 1
palcontrast = 255,255,255
trans = none

;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, Explod] 
type = Explod
trigger1 = Animelem = 4
anim = 171
pos = 0, 0
removetime = 99999
scale = 1, 1
sprpriority = 3

[State 170, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win State decider
; CNS difficulty: basic
[Statedef 180]
type = S

[State 180, ChangeState]
type = ChangeState
trigger1 = Time = 0
value = IfElse(Random>=0&&Random<333,181,IfElse(Random>=333&&Random<666,182,183))

;---------------------------------------------------------------------------
; Win pose 1
; CNS difficulty: basic
[Statedef 181]
type = S
ctrl = 0
anim = 180
velset = 0,0

[State 181, PlaySnd]
type = PlaySnd
trigger1 = Time = 0
value = 0,IfElse(Random>=0&&Random<333,1,IfElse(Random>=333&&Random<666,2,4))
volume = 255

[State 181, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win pose 2
; CNS difficulty: basic
[Statedef 182]
type = S
movetype = I
physics = N
velset = 0,0
ctrl = 0

[State 182, 0]
type = ChangeState
trigger1 = time = 0
value = 184

;---------------------------------------------------------------------------
; Dash (Continue)
[Statedef 184]
type    = A
physics = A
anim = 100
sprpriority = 1

[State 184, PlaySnd]
type = PlaySnd
trigger1 = animelem = 2 
value = 100, 0
volume = 255

[State 184, Velset]
type = VelSet
trigger1 = time = 0
x = const(velocity.run.fwd.x)
y = -3

[State 184, StateTypeSet]
type = StateTypeSet
trigger1 = Time > 10
Statetype = S
Movetype = I
Physics = S

[State 184, 4]
type = ChangeState
trigger1 = time > 10
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 185

