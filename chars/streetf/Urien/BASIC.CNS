x = .6

[State 5011, 4]
type = VelSet
trigger1 = HitOver
x = 0

[State 5011, Changestate]
type = DefenceMulSet
trigger1 = HitOver
value = 1

[State 5011, 6]
type = ChangeState
trigger1 = HitOver
value = 11
ctrl = 1

[State 5011, 2]
type = ChangeState
triggerall = var(40) >= 100
trigger1 = Anim = 5025
trigger1 =  Animelem = 2
trigger2 = Anim = 5026
trigger2 = Animelem = 3
trigger3 = Anim = 5027
trigger3 = Animelem = 4
value = 5300

