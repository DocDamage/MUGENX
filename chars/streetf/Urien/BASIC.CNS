trigger1 = Anim = 5025
trigger2 = var(21) > 6
trigger2 = Anim = 5026
trigger3 = var(21) > 10
trigger3 = Anim = 5027
value = anim

[State 5001, 1]
type = VarAdd
trigger1 = var(21) > 0
v = 11
value = -1

[State 5011, 3] ;Stop sliding back
