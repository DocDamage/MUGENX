;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
[Statedef 190]
type = S
ctrl = 0
anim = 192
velset = 0,0

[State 190, ChangeAnim] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 192

[State 190, AssertSpecial] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 5000, PlaySnd]
type = PlaySnd
trigger1 = Time = 10
value = 0,IfElse(Random<333,7,0)
volume = 255

[State 190, Explod] 
type = Explod
trigger1 = Time = 0
anim = 190
pos = 0, 0
facing = 1
scale = 1, 1
sprpriority = 3
ontop = 1

[State 190, Explod] 
type = Explod
trigger1 = Time = 0
anim = 191
pos = 0, 0
facing = 1
scale = 1, 1
sprpriority = -5

[State 190, ChangeState] ;Change to stand State
type = ChangeState
trigger1 = AnimTime = 0
value = 0

