; WIN
[Statedef 180]
type = S

[State 180, VarRandom]
type = VarRandom
trigger1 = time = 0
v = 1
range = 0,120

[State 180, Jab]
type = VarSet
trigger1 = Command = "hold_x"
v = 1
value = 10

; Disabled for now
[State 180, Strong]
type = VarSet
trigger1 = Command = "hold_y"
v = 1
value = 10

[State 180, Fierce && Short]
type = VarSet
trigger1 = Command = "hold_z" || command = "hold_a"
v = 1
value = ifelse(command="hold_z",50,70)

[State 180, Forward & Roundhouse]
type = VarSet
trigger1 = command = "hold_b" || command = "hold_c"
v = 1
value = ifelse(command="hold_b",90,110)

[State 180, Normal Henchmen & Snap]
type = ChangeState
trigger1 = var(1) <= 19 || var(1) >= 100 
value = ifelse (var(1)<=19,181,186)

; Disabled for now
[State 180, Grenade Toss]
type = ChangeState
trigger1 = var(1) = [20,39]
value = 181

[State 180, Out of Sync]
type = ChangeState
trigger1 = var(1) = [40, 59]
value = 183

[State 180, Hook]
type = ChangeState
trigger1 = var(1) = [60, 79]
value = 184

[State 180, WaveMotion]
type = ChangeState
trigger1 = var(1) = [80, 99]
value = 185

