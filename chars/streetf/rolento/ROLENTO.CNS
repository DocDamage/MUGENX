; Override common states (use same number to override) :
;-------------------------------------------------------------------------------------
;---------------------------------------------------------------------------
; Super Jump Start
[Statedef 2500]
type = S
movetype = I
physics = S
ctrl = 0
velset = 0,0
anim = 50
hitcountpersist = var(10) && p2movetype = H

[State 2500, x]
type = varset
trigger1 = time = 0
fv = 4
value = pos x

[State 2500, 0]
type = varset
trigger1 = time = 0
var(8)=ifelse(command="holdback",-1,0)

[State 2500, 1]
type = PlaySnd
trigger1 = animelem = 3
value = 0, 10

[State 2500, 2]
type = changestate
trigger1 = animtime = 0
value = 2501

;---------------------------------------------------------------------------
; Super Jump
[Statedef 2501]
type = A
movetype = I
physics = N
sprpriority = 2
hitcountpersist = var(10) && p2movetype = H

[State 2501, 1]
type = changeanim
trigger1 = time = 0
value = ifelse(var(8)=0,52,53)

[State 2501, Dust Rush]
type = explod
trigger1 = time = 0
anim = 8420
id = 8420
postype = p1
pos = 0, 10
sprpriority = 3
facing = ifelse(var(8)=0,1,-1)
ownpal = 1

[State 2501, Voice]
type = PlaySnd
trigger1 = time = 0
value = 1, 1
channel = 0

; super jump forward
[State 2501, 3]
type = VelSet
trigger1 = time = 1 && var(8)=0
x = 8.6875
y = -9.1

; super jump backwards
[State 2501, 4]
type = VelSet
trigger1 = time = 1 && var(8)=-1
x = -9.24
y = -9.3

; gravity
[State 2501, 5]
type = veladd
trigger1 = time > 0
y = 0.55

[State 2502, 7]
type = ctrlset
trigger1 = time = 1
value = 1

[State 2500, 9]
type = changestate
trigger1 = vel y > 0 && pos y >= -5
value = 2502

