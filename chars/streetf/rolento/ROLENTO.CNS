;---------------------------------------------------------------------------
; Standing Jab
[Statedef 200]
type = S
movetype= A
physics = S
juggle = 3
poweradd = ifelse(var(10),floor(66/3),66/2)
velset = 0,0
ctrl = 0
anim = 200
sprpriority = 2
hitcountpersist = var(10) && p2movetype = H

[State 200, Whiff]
type = PlaySnd
trigger1 = animelem = 2
value = 0, 1

[State 200, 3]
type = HitDef
triggerall = !var(9)||var(10)
trigger1 = AnimElem = 2,=1
attr = S, NA
damage = 53 ; a-ism (checked)
animtype = Light
air.animtype = Back
guardflag = M
hitflag = MAF
priority = 5, Hit
pausetime = ifelse(var(10),4,8),ifelse(var(10),4,8)
sparkno = S7400
guard.sparkno = S7000
sparkxy = 0,-65
hitsound = S6,1
guardsound = S6,0
ground.type = Low
ground.slidetime = 10
ground.hittime = 10
ground.velocity = -5.5
air.velocity = ifelse(var(10),-3,-5),ifelse(var(10),-10,-6)
yaccel = ifelse(var(10),0.55,0.45)
fall.recover = !var(10)

[State 200, 3C]
type = HitDef
triggerall = var(9)&&!var(10)
trigger1 = AnimElem = 2,=1
attr = S, NA
damage = 60 ; a-ism (checked)
animtype = Medium
air.animtype = Back
guardflag = M
hitflag = MAF
priority = 5, Hit
pausetime = 9,9
sparkno = S7400
guard.sparkno = S7000
sparkxy = 0,-65
hitsound = S6,1+var(9)
guardsound = S6,0
ground.type = Low
ground.slidetime = 14
ground.hittime = 14
ground.velocity = -5.5
air.velocity = -3,-10
yaccel = 0.55
air.fall = var(9)

[State 200, counter flash]
type = envcolor
triggerall = var(9)&&!var(10) && p2life > 60 ; (checked)
trigger1 = movehit
value = 250,250,250
time = 1
ignorehitpause = 1
persistent = 0

[State 200, RemoveExplod]
type = null;removeexplod
triggerall = numexplod(9200) && var(9)&&!var(10)
trigger1 = movehit
id = 9200
ignorehitpause = 1

[State 200, Counter Hit]
type = explod
triggerall = var(9)&&!var(10) && movehit
trigger1 = p2life > 60
anim = 9200+teamside
id = 9200
postype = left
pos = 0,0
bindtime = -1
sprpriority = 3
ownpal = 1
ignorehitpause = 1
persistent = 0

[State 200, MoveHit Replace]
type = varset
trigger1 = var(9)&&!var(10) && movehit
var(15) = 1
ignorehitpause = 1

[State 200, ResetMoveHit]
type = MoveHitReset
trigger1 = var(9)&&!var(10) && movehit
ignorehitpause = 1

[State 200, 7]
type = ctrlset
trigger1 = var(10) && animelem = 3
value = 1

[State 200, 8]
type = StateTypeSet
trigger1 = animelemtime(3)>=0
movetype = I

[State 200, 9]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

