;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundno = 1
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundno = 1
fvalue = 0

[State 5900, Set Guard Break Variables]
type = VarRangeSet
trigger1 = 1
first = 12
last = 13
value = 30

[State 5900, 9] ;Intro
type = ChangeState
trigger1 = roundno = 1
value = 190

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -2, Kill CVC Motion Blur]
type = afterimagetime
triggerall = var(10)
trigger1 = movetype = H
trigger2 = power <= 10
value = 0

[State -2, CVC Power Reduction]
type = poweradd
triggerall = var(10)
trigger1 = !WinKo
trigger2 = movetype = H
value = ifelse(movetype=H,-1000,-10)

[State -2, Turn Off CVC]
type = varset
triggerall = var(10)
trigger1 = power <= 0
trigger2 = movetype = H
var(10) = 0

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------
[Statedef -3]

[State -3, RemoveExplod]
type = RemoveExplod
triggerall = movetype = A && numexplod(9200)
trigger1 = var(9)&&!var(10) && movehit
id = 9200
ignorehitpause = 1

[State -3, HoldBackCheck]
type = varadd
trigger1 = command="holdback"
var(7) = 1

[State -3, Counter Check]
type = varset
trigger1 = movetype = A
var(9) = ifelse((p2movetype=A),1,0)

[State -3, Kill Juggle Checking]
type = assertspecial
trigger1 = var(9)||var(10)
flag = nojugglecheck

[State -3, No Blocking]
type = assertspecial
trigger1 = var(10)
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard

[State -3, CopyHitCount]
type = varset
triggerall = var(10) && RoundState != 4
trigger1 = p2movetype != H && hitcount != 0
trigger2 = winKO = 1
;trigger3 = power<=10 ; not important
var(5) = hitcount

[State -3, CVC Damage Reduction]
type = attackmulset
trigger1 = var(10)
value = ifelse(stateno<600,0.8,1)
;value = ifelse(stateno<600,0.6,0.8)

[State -3, Custom Combo Win]
type = helper
triggerall = var(10)
trigger1 = WinKO = 1 && !numhelper(10000)
trigger1 = movehit
helpertype = normal
name = "Custom Combo Finish"
id = 10000
postype = p1
stateno = 10000
ownpal = 1
ignorehitpause = 1
persistent = 0

[State -3, Guard Points Recover]
type = varadd
triggerall = var(12) < var(13)
trigger1 = gametime%60 = 1 && movetype = I
trigger2 = gametime%45 = 1 && movetype = A
v = 12
value = 1

[State -3, Display Guard Points]
type = displaytoclipboard
trigger1 = 1
text = "guard = %d | combo count = %d | holdback = %d | counter = %d | movehit = %d"
params = var(12),var(5),var(7),var(9),var(15)

; Play Pain Sound
[State -3, Pain Sound]
type = playsnd
triggerall = movetype = H && random < 500
trigger1 = alive = 1 && time = 0
trigger1 = stateno = 5000 || stateno = 5010 || stateno = 5020
value = 10, gethitvar(animtype)
volume = 75
channel = 0

;-------------------------------------------------- E O F --------------------------------------------
