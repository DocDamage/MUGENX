;----------------------------------------------------------------------------
; Rolento's CNS ver1.8 by Tenshin - fairpear@hotmail.com
;	@ "http://kickme.to/openmugen"
;----------------------------------------------------------------------------
; var(1)	used for choosing win poses
; var(2)	used by supers for damage
; fvar(3)	used to keep height of p2 for TNP
; var(3)	used for checking command for Baton Dive
; var(4)	used by Delta Mekong Attack
; var(5)	keeping combo count 
; var(6)	knife helper block state random
; var(7)	hold back counter
; var(8)	super jump
; var(9)	counter check
; var(10)	custom v-ism combo variable
; var(11)	guard break timer
; var(12)	guard break points
; var(13)	guard break limit
; var(14)	grenade counter for Mine Sweeper
; var(15)	movehit replacement
; var(16)	patriot circle command buffer
; var(17)	deadly package - p2's head value x
; var(18)	deadly package - p2's head value y
;
;----------------------------------------------------------------------------
; note to self :
;
; jumping forward		= 140			based on a3
; jumping backwards		= 170			     "
; kick alpha counter		= 197			     "
; deadly package throw		= 181			     "
; a3 jab patriot circle		= 46			     "
; a3 jab patriot circle # 2	= 42			     "
; mekong delta attack back	= 109			     "
; jab mekong delta attack rush  = 119			     "
; strong mekong delta attack rs = 168			     "
; fierce mekong delta attack rs = 223			     "
; delta air raid jab roll	= 100			     "
; delta air raid strong roll	= 160			     "
; delta air raid fierce roll	= 220			     "
; delta air raid jab leap	= 127			     "
; delta air raid strong leap 	= 175			     "
; delta air raid fierce leap	= 223			     "  
; roundhouse slide		= 66			     "
; super jump forward		= 278			     "
; super jump backward		= 305			     "
; baton hop			= 105			     "
; baton hop back		= 125			     "
; ground recover roll		= 147			     "
; jab mine sweeper		= 138			     "
; strong mine sweeper		= 218			     "
; fierce mine sweeper		= 298			     "
;----------------------------------------------------------------------------

