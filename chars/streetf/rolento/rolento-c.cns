;---------------------------------------------------------------------------
; Standing Guard Break
[Statedef 160]
type = S
movetype = I
physics = S
velset = 0,0
ctrl = 0
anim = 160

[State 160, RemoveRedStuff]
type = RemoveExplod
trigger1 = time = 0
id = 165

[State 160, 1]
type = VarRangeSet
trigger1 = time = 0
value = ifelse(var(13)=30,20,10)
first = 12
last = 13

[State 160, Set Guard Break Time]
type = VarSet
trigger1 = time = 0
v = 11
value = 60

[State 160, Guwah!]
type = PlaySnd
trigger1 = time = 0
value = 1,18
channel = 0

[State 160, Replacement for Glass]
type = explod
trigger1 = time = 0
anim = 8900
id = 8900
pos = 0,-70
postype = p1
bindtime = 1
sprpriority = 0
ownpal = 1

[State 160, Reduce Guard Time]
type = VarAdd
trigger1 = time>0
trigger2 = command = "x" || command = "y" || command = "z" || command = "a" || command = "b" || command = "c"
trigger3 = command = "Shaking"
v = 11
value = -1

[State 160, Yellow Blinks]
type = PalFx
triggerall = 1
trigger1 = command = "x" || command = "y" || command = "z" || command = "a" || command = "b" || command = "c"
trigger2 = command = "Shaking"
add = 34,34,34
time = 1

[State 160, debug]
type = displaytoclipboard
trigger1 = 1
text = "var(11) = %d"
params = var(11)

[State 160, 9]
type = changestate
trigger1 = var(11)<=0
value = 0
ctrl = 1

