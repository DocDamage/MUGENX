;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
movetype = I
physics = S
sprpriority = 0
hitcountpersist = var(10) && p2movetype = H
velset = 0,0

[State 0, Reset Var(7)]
type = varset
trigger1 = time = 0
var(7) = 0

[State 0, Reset Var(15)]
type = varset
trigger1 = time = 0
var(15) = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type = C
movetype = I
physics = C
anim = 10
hitcountpersist = var(10) && p2movetype = H

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type = C
movetype = I
physics = C
anim = 11
sprpriority = 0
hitcountpersist = var(10) && p2movetype = H
velset = 0,0

[State 11, Reset Var(7)]
type = varset
trigger1 = command!="holdback"
var(7) = 0

[State 11, Reset Var(15)]
type = varset
trigger1 = time = 0
var(15) = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type = S
movetype = I
physics = S
anim = 12
hitcountpersist = var(10) && p2movetype = H

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type = S
movetype = I
physics = S
sprpriority = 0
hitcountpersist = var(10) && p2movetype = H

[State 20, 1]
type = VelSet
triggerall = command = "holdfwd"
trigger1 = time > 0
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
triggerall = command = "holdback"
trigger1 = time > 0
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
hitcountpersist = var(10) && p2movetype = H
velset = 0,0

[State 40, Debug]
type = varset
trigger1 = time = 0
fvar(4) = pos x

[State 40, 0]
type = NotHitBy
trigger1 = 1
value = S, NT, ST
time = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = null;VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = null;VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type = A
movetype = I
physics = N
hitcountpersist = var(10) && p2movetype = H

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(sysvar(1)=0, 41, ifelse(sysvar(1)>0, 42, 43))

[State 50, 3]
type = VelSet
trigger1 = time = 1
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = ifelse(sysvar(1)>0,-10,-10.3)

[State 50, 4]
type = VelAdd
trigger1 = time > 0
y = 0.55

[State 50, Reset SysVar(1)]
type = VarSet
trigger1 = Time = 2
sysvar(1) = 0

[State 50, Reset Var(7)]
type = varset
trigger1 = command!="holdback"
var(7) = 0

[State 50, 8]
type = null;ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50, 9]
type = ChangeState
trigger1 = pos y >= -5 && vel y > 0
value = 52

;---------------------------------------------------------------------------
; JUMP_LAND
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47
velset = 0,0
hitcountpersist = var(10) && p2movetype = H

[State 52, 1]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, LandTap]
type = PlaySnd
trigger1 = time = 0
value = 0,0

[State 52, 3]
type = changestate
trigger1 = time = 0 && p2dist x<0
value = ifelse(command="holddown",11,0)
ctrl = 1

[State 52, debug2]
type = displaytoclipboard
trigger1 = animtime = 0
text = "distant covered = %d"
params = abs(floor(pos x)-floor(fvar(4)))

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; SGUARDHIT (shaking)
[Statedef 150]
type    = S
movetype= H
physics = N
velset = 0,0

[State 150, 1]
type = ChangeAnim
trigger1 = 1
value = 150

[State 150, 3]
type = ForceFeedback
trigger1 = time = 0
waveform = square
time = 3

[State 150, Minus Guard Gauge]
type = varadd
trigger1 = time = 0
var(12) = -(gethitvar(hitshaketime)+gethitvar(hittime))/ifelse((var(7)<6 && var(7)!=0),10,8)
ignorehitpause = 1

[State 150, CustomGuardSound]
type = PlaySnd
trigger1 = time = 0 && var(12)>0
value = 0,100
ignorehitpause = 1

[State 150, Guard Dampening]
type = palfx
trigger1 = time = 0 && (var(7)<7 && var(7)!=0) && var(12)>0
time = 3
;add = -170, -85, 255
add = -64,-64,255
mul = 256,256,192

[State 150, NotHitBY]
type = nothitby
trigger1 = var(12)<=0
value = SCA
time = 1

[State 150, Guard Break BOOM!]
type = PlaySnd
trigger1 = time = 0 && var(12)<=0
value = 0,13
ignorehitpause = 1
persistent = 0

[State 150, Pause]
type = pause
trigger1 = var(12)<=0 && time = 0
time = ifelse(gethitvar(hitshaketime)<15,15-gethitvar(hitshaketime),0)
ignorehitpause =1
persistent = 0

[State 150, Red Stuff]
type = explod
triggerall = anim = 150
trigger1 = var(12) <= 10
anim = 165
id = 165
pos = -1,0
postype = p1
bindtime = -1
pausemovetime = -1
sprpriority = 0
ignorehitpause = 1

[State 150, Blue Background]
type = bgpalfx
trigger1 = time = 0 && var(12)<=0
time = 12
add = 0,0,255
mul = 100,100,255
ignorehitpause = 1
persistent = 0

[State 150, White Flash]
type = explod
trigger1 = time = 0 && var(12)<=0
anim = 9100
id = 9100
pos = 0,120
postype = left
bindtime = -1
pausemovetime = -1
ontop = 1
ownpal = 1
ignorehitpause = 1
persistent = 0

[State 150, Jewel]
type = explod
trigger1 = time = 10 && var(12)<=0
anim = 9101
id = 9101
pos = 0,-70
postype = p1
bindtime = -1
pausemovetime = -1
ontop = 1
ownpal = 1
ignorehitpause = 1
persistent = 0

[State 150, 2]
type = ChangeState
trigger1 = HitShakeOver || time = 15
value = ifelse(var(12)<=0,160,151)

