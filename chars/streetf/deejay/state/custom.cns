; Custom states
;---------------------------------------------------------------------------
; Thorwn by Overhead Throw
[Statedef 805]
type    = A
movetype= H
physics = N
velset = 0,0

[State 805, Anim2]
type = ChangeAnim2
trigger1 = Anim != 805
value = 805

[State 805, 0]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 0,0

[State 805, LifeAdd]
type = LifeAdd
trigger1 = AnimTime = 0
value = -200

[State 805, HitVelSet]
type = HitVelSet
trigger1 = AnimTime = 0
x = 1
y = 1

[State 805, SelfState]
type = SelfState
trigger1 = AnimTime = 0
value = 5050

