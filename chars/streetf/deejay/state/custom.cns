; Hit by Super Sobat Kick
[Statedef 840]
type    = A
movetype= H
physics = N
velset = 0,0

[State 840, Anim2]
type = ChangeAnim2
trigger1 = Time = 0
value = 5250

[State 840, 0]
type = AngleSet
trigger1 = Time = 0
trigger2 = BackEdgeBodyDist <= 20
trigger3 = FrontEdgeBodyDist <= 20
value = -90

[State 840, 2]
type = AngleDraw
trigger1 = 1

[State 840, 3]
type = VelSet
trigger1 = Time = 4
x = -20

[State 840, 4]
type = null ;ScreenBound
trigger1 = 1
value = 1
movecamera = 0,0

[State 840, 5]
type = ChangeState
trigger1 = BackEdgeBodyDist <= 20
trigger2 = FrontEdgeBodyDist <= 20
value = 841

; Hit Wall
[Statedef 841]
type    = A
movetype= H
physics = N

[State 841, Anim2]
type = ChangeAnim2
trigger1 = Time = 0
value = 5251

[State 841, AngleSet]
type = AngleSet
trigger1 = Time = 0
value = -90

[State 841, AngleDraw]
type = AngleDraw
trigger1 = Time < 10

[State 841, Turn]
type = Turn
trigger1 = (Time = 0) && (FrontEdgeBodyDist <= 30)

[State 841, Pos]
type = PosAdd
trigger1 = Time = 0
x = 10 - BackEdgeBodyDist

[State 841, Stop moving]
type = PosFreeze
trigger1 = Time < 10
x = 1
y = 1

[State 841, SlowMotion]
type = null ;Pause
triggerall = P2BodyDist X > 100
triggerall = Time > 10
trigger1 = TimeMod = 1,0
time = 3
movetime = 0

[State 841, PlayerPush]
type = null ;PlayerPush
trigger1 = Time > 10
value = 0

[State 841, No scroll]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 0,0

[State 841, EnvShake]
type = EnvShake
trigger1 = Time = 0
persistent = 0
time = 10
ampl = -5
freq = 100
phase = 10

[State 841, Spark]
type = Explod
trigger1 = time = 0
anim = F72
pos = -30,-50
postype = p1
facing = 1
sprpriority = 3
bindtime = 2
supermove = 1

[State 841, Sound]
type = PlaySnd
trigger1 = Time = 0
value = F7,1

[State 841, VelSet]
type = VelSet
trigger1 = Time = 10
x = 8
y = -6.5

[State 841, Gravity]
type = VelAdd
trigger1 = Time > 10
y = .4

[State 841, Turn]
type = Turn
trigger1 = Vel Y > 0
trigger1 = Pos Y > 20

[State 841, LifeAdd]
type = LifeAdd
trigger1 = Vel Y > 0
trigger1 = Pos Y > 20
value = -10

[State 841, SelfState]
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y > 20
value = 5110 ;Hit ground

