; Dee Jay's States
;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 0]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 170, 1]
type = PlaySnd
trigger1 = AnimElem = 2
value = 5000, 4
channel = 0

[State 170, 2] ; Dropped left instrument
type = Projectile
trigger1 = AnimElem = 4
projanim = 171
projhitanim = 173
projshadow = -1
offset = 20, -70
velocity = 0, 2
accel = 0, .2

[State 170, 2] ; Dropped right instrument
type = Projectile
trigger1 = AnimElem = 4
projanim = 172
projhitanim = 174
projshadow = -1
offset = 40, -70
velocity = 0, 2
accel = 0, .2

