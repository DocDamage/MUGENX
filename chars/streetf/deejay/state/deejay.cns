;---------------------------------------------------------------------------
; Intro
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 190, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 190, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, 3]
type = ChangeAnim
trigger1 = Anim = 190
trigger1 = AnimTime = 0
value = 5120

[State 190, 4]
type = PlaySnd
trigger1 = Anim = 5120
trigger1 = AnimElem = 1
value = 10, 0
channel = 0

[State 190, 5] ;Change to stand state
type = ChangeState
trigger1 = Anim = 5120
trigger1 = AnimTime = 0
value = 0

