; Definition file for Dee Jay
;--------------------
;[Player Information]
;--------------------
[Info]
name = "Dee Jay"	   ;Name of character
displayname = "Dee Jay"	   ;Name of character to display
versiondate = 2001.08.04   ;Version date of character
mugenversion = 2001.04.14  ;Version of M.U.G.E.N character works on
author = "N64Mario"	   ;Character author name
pal.defaults = 1,2,3,4,5,6 ;Default palettes in order of preference
;--------------------
;[Common Files] 
;--------------------
[Files]
cmd	 = common/command.cmd	 ;Commands
cns	 = common/constant.cns	 ;Constants
stcommon = common/common.cns	 ;Common States
sprite	 = common/sprite.sff	 ;Sprites
anim	 = common/animation.air  ;Animation
sound	 = common/sound.snd	 ;Sound
;--------------------
;[States] 
;--------------------
st	 = state/deejay.cns	;Dee Jay's States
st2	 = state/deejay-s.cns	;Special States
st3	 = state/deejay-h.cns	;Hyper States
st4      = state/override.cns	;Override States
st5	 = state/custom.cns	;Custom States
;--------------------
;[Palettes] (can have up to 12)
;--------------------
pal1   = palette/deejay.act  ;Palettes (can have up to 12)
pal2   = palette/deejay2.act
pal3   = palette/deejay3.act
pal4   = palette/deejay4.act
pal5   = palette/deejay5.act
pal6   = palette/deejay6.act
