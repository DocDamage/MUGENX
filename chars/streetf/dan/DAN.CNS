; RUN_FWD
[Statedef 100]
type    = S
physics = N
anim = 100
ctrl = 0

[State 100, 0]
type = VarSet
trigger1 = !time
var(3) = 0

[State 100, 1]
type = VelSet
trigger1 = AnimElem = 3, >= 0
trigger1 = AnimElem = 4, < 0
x = 6

[State 100, 2]
type = VelMul
trigger1 = AnimElem = 3, >= 4
x = .9

[State 100, 4]
type = CtrlSet
trigger1 = AnimTime = -4 && !var(3)
value = 1

[State 100, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = var(3)
ctrl = (var(3)=0)
anim = 0

[State 100, 6]
type = MakeDust
trigger1 = Time = 1
pos = -25,-2
spacing = 1

[State 100, 6]
type = MakeDust
trigger1 = AnimElem = 3, >= 0
pos = -15,-2

[State 100, 7]
type = VarSet
triggerall = numhelper(3477)
triggerall = helper(3477),movetype!=H  ; not in hit state
triggerall = helper(3477),Vel Y >= -1
trigger1 = animelemno(0) <= 2 || animelemno(0) = 5
trigger1 = facing*(helper(3477),Pos X-Pos X) = [3,17];[5,15]
trigger1 = helper(3477),RootDist Y = [88,98];[90,96]
trigger2 = animelemno(0) = 3
trigger2 = facing*(helper(3477),Pos X-Pos X) = [17,34];[19,31]
trigger2 = helper(3477),RootDist Y = [80,89];[82,87]
trigger3 = animelemno(0) = 4
trigger3 = facing*(helper(3477),Pos X-Pos X) = [14,27];[16,25]
trigger3 = helper(3477),RootDist Y = [80,89];[83,87]
trigger4 = animelemno(0) = 6
trigger4 = facing*(helper(3477),Pos X-Pos X) = [-1,6]
trigger4 = helper(3477),RootDist Y = [89,97];[90,96]
trigger5 = animelemno(0) = 7
trigger5 = facing*(helper(3477),Pos X-Pos X) = [-2,8]
trigger5 = helper(3477),RootDist Y = [85,93];[86,92]
var(3) = 3491

[State 100, 8]
type = VarSet
trigger1 = var(3)
var(15)=1

; Initialize (at the start of the round)
; Damn it! Persistent vars don't persist!!
[Statedef 5900]
type = S

[State 5900, 0]
type = VarSet
trigger1 = !time
var(16) = !var(59) && var(58)

[State 5900, 0]
type = VarSet
trigger1 = !time
var(4)=-8

[State 5900, 0]
type = VarAdd
trigger1 = roundno = 1
var(58) = 1

[State 5900, 0]
type = VarSet
trigger1 = roundno = 1
var(59) = 0

[State 5900, 1] ;Intro
type = ChangeState
trigger1 = roundno = 1
value = 190

