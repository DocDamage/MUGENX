;Dan's constants.
; Format (case insensitive):
;  [groupname]        
;  constname = value  

[Data]
life = 1000          ;Amount of life to start with
attack = 100         ;100% attack power (more is stronger)
defence = 100        ;100% defensive power (more is stronger)
fall.defence_up = 50 ;Def goes up by 50% everytime player is hit on ground
liedown.time = 60    ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 15       ;Can do 15 points of juggling
sparkno = 2          ;Default spark number
guard.sparkno = 40   ;Default guard spark number
KO.echo = 1          ;1 to enable echo on KO
IntPersistIndex = 58
FloatPersistIndex = 0; all float vars persist

[Size]
xscale = .88889           ;Horizontal scaling factor.
yscale = 1;1.125           ;Vertical scaling factor.
ground.back = 20     ;Player width (back, ground)
ground.front = 15    ;Player width (front, ground)
air.back = 15        ;Player width (back, air)
air.front = 10       ;Player width (front, air)
z.width = 3          ;Player width (into and out)
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 1
shadowoffset = -3
head.pos = 5, -87
mid.pos = -3, -57

[Velocity]
walk.fwd  = 2.1      ;Walk forward
walk.back = -2.0     ;Walk backward
;walk.up   = -1       ;Walk up (into)
;walk.down = 1        ;Walk down (outwards)
run.fwd  = 4.1, 0    ;Run forward (x, y)  - if y<0, player will hop
run.back = -3.5,-4.0 ;Run backward (x, y) - if y=0, player will run
;run.up = -2,0        ;Dash up/into (x, y)
;run.down = 2,0       ;Dash down/outwards (x, y)
jump.neu = 0,-7.0    ;Neutral jumping velocity (x, y)
jump.back = -2.8     ;Jump back Speed (x, y)
jump.fwd = 2.9       ;Jump forward Speed (x, y)
;jump.up = -1         ;Jump up Speed (z, y)
;jump.down = 1        ;Jump Back Speed (z, y)
;runjump.back = -2.55 ;Running jump speeds (opt)
runjump.fwd = 3.6    ;.
;runjump.up = -1.2    ;.
;runjump.down = 1.2   ;.
airjump.neu = 0      ;.
airjump.back = -2.55 ;Air jump speeds (opt)
airjump.fwd = 2.5    ;.
;airjump.up = -1      ;.
;airjump.down = 1     ;.

[Movement]
airjump.num = 0;     ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .35         ;Vertical acceleration
stand.friction = .8  ;Friction coefficient when standing
crouch.friction = .8 ;Friction coefficient when crouching

; Overridden states from common1.cns
;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4]
type = ChangeState
triggerall = numhelper(3477)
triggerall = helper(3477),movetype != H
triggerall = helper(3477),Vel Y >= -1
triggerall = helper(3477),movetype!=H  ; not in hit state
trigger1 = animelemno(0) < 4
trigger1 = facing*(helper(3477),Pos X-Pos X) = [-4,8]
trigger1 = (helper(3477),RootDist Y = [90,98])
trigger1 = animelemno(0) >= 4
trigger2 = facing*(helper(3477),Pos X-Pos X) = [-4,8]
trigger2 = (helper(3477),RootDist Y = [95,103])
value = 3491

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

[State 11, 2] ; added
type = ChangeState
triggerall = numhelper(3477)
triggerall = helper(3477),movetype!=H  ; not in hit state
triggerall = helper(3477),Vel Y >= -1
trigger1 = facing*(helper(3477),Pos X-Pos X) = [-1,10]
trigger1 = helper(3477),RootDist Y = [59,69]
value = 3491

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12

[State 12, 0]
type = Varset
trigger1 = !time
var(3) = 0

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = var(3)
ctrl = !var(3)

[State 12, 2] ; added
type = VarSet
triggerall = numhelper(3477)
triggerall = helper(3477),movetype!=H  ; not in hit state
triggerall = helper(3477),Vel Y >= -1
triggerall = facing*(helper(3477),Pos X-Pos X) = [-2,9]
trigger1 = AnimElem = 2, < 0
trigger1 = helper(3477),RootDist Y = [67,77];[69,75]
trigger2 = AnimElem = 2, >= 0
trigger2 = helper(3477),RootDist Y = [84,94];[86,92]
var(3) = 3491

[State 12, 3]
type = VarSet
trigger1 = var(3)
var(15) = 1

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 20, 5] ; added
type = ChangeState
triggerall = numhelper(3477)
triggerall = helper(3477),movetype!=H  ; not in hit state
triggerall = helper(3477),Vel Y >= -1
trigger1 = animelemno(0) = 1
trigger1 = facing*(helper(3477),Pos X-Pos X) = [-3,8]
trigger1 = helper(3477),RootDist Y = [85,93];[86,92]
trigger2 = animelemno(0) > 1
trigger2 = facing*(helper(3477),Pos X-Pos X) = [-3,11]
trigger2 = helper(3477),RootDist Y = [89,97]
value = 3491
anim = 0

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 0]
type = VarSet
trigger1 = !time
var(3) = 0

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50, 4] ; added
type = VarSet
triggerall = numhelper(3477)
triggerall = helper(3477),movetype!=H  ; not in hit state
triggerall = helper(3477),Vel Y-Vel Y >= -1
triggerall = anim = [41,43]
trigger1 = animelemno(0) = 1
trigger1 = facing*(helper(3477),Pos X-Pos X) = [-8,4]
trigger1 = helper(3477),RootDist Y = [103,112]
trigger2 = animelemno(0) = 2
trigger2 = facing*(helper(3477),Pos X-Pos X) = [-4,7]
trigger2 = helper(3477),RootDist Y = [101,110]
trigger3 = animelemno(0) = 3
trigger3 = facing*(helper(3477),Pos X-Pos X) = [-3,8]
trigger3 = helper(3477),RootDist Y = [100,109]
var(3) = 1

[State 50, 4] ; added
type = VarSet
triggerall = numhelper(3477)
triggerall = helper(3477),movetype!=H  ; not in hit state
triggerall = helper(3477),Vel Y-Vel Y >= -1
triggerall = anim = [44,46]
trigger1 = animelemno(0) = 1
trigger1 = facing*(helper(3477),Pos X-Pos X) = [-3,8]
trigger1 = helper(3477),RootDist Y = [100,109]
trigger2 = animelemno(0) = 2
trigger2 = facing*(helper(3477),Pos X-Pos X) = [-1,10]
trigger2 = helper(3477),RootDist Y = [98,107]
trigger3 = animelemno(0) = 3
trigger3 = facing*(helper(3477),Pos X-Pos X) = [-10,1]
trigger3 = helper(3477),RootDist Y = [101,110]
trigger3 = animelemno(0) > 3
trigger3 = facing*(helper(3477),Pos X-Pos X) = [-9,4]
trigger3 = helper(3477),RootDist Y = [103,112]
var(3) = 1

[State 50, 6]
type = VarSet
trigger1 = var(3)
var(15) = 1

[State 50, 7]
type = ChangeState
trigger1 = var(3)
trigger1 = Pos Y + Vel Y >= 0
value = 804

