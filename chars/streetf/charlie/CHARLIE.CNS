anim = 6201
sprpriority = 2

[State 6202, 1]
type = VelAdd
trigger1 = Time >= 0
y = .6

[State 6202, 5]
type = ChangeState
trigger1 = Pos Y >= 0
value = 1212
ctrl = 0

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = ifelse (var(20) = 1, (const(velocity.walk.fwd.x) * 1.7), (const(velocity.walk.fwd.x)))

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = ifelse (var(20) = 1, (const(velocity.walk.back.x) * 1.7), (const(velocity.walk.back.x)))

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
trigger2 = (Var(59) = 1) && (enemy, NumProj >= 1)
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Dash Forward
[Statedef 100]
type    = S
physics = N
ctrl = 0
anim = 100

[State 100, VelSet]
type = VelSet
trigger1 = AnimElem = 2
x = 8

[State 100, VelMul]
type = VelMul
trigger1 = AnimElem = 3
x = .25

[State 100, MakeDust]
type = MakeDust
trigger1 = Time = [5,22]
pos = 24,-2
spacing = 2

;[State 100, PlaySnd]
;type = PlaySnd
;trigger1 = AnimElem = 2
;value = 100,4

[State 100, ChangeState] ;Cancel into crouching
type = ChangeState
trigger1 = Command = "holddown"
value = 10
ctrl = 1

[State 100, ChangeState2] ;Cancel into jumping
type = ChangeState
trigger1 = Command = "holdup"
value = 40
ctrl = 1

[State 100, 3]
type = ChangeState
trigger1 = AnimTime = 0
ctrl = 1
value = 0

;---------------------------------------------------------------------------
; Dash  back
[Statedef 105]
type    = S
physics = N
ctrl = 0
anim = 105

;[State 105, PlaySnd]
;type = PlaySnd
;trigger1 = AnimElem = 2
;value = 100,4

[State 105, PlaySnd2]
type = PlaySnd
trigger1 = Time = 16
value = 0,1

[State 105, 1]
type = VelSet
trigger1 = AnimElem = 2
x = -6

[State 105, VelMul]
type = VelMul
trigger1 = Time >= 16
x = .9

[State 105, MakeDust]
type = MakeDust
trigger1 = Time >= 16
pos = -20,-2
spacing = 2

[State 105, ChangeState] ;Cancel into crouching
type = ChangeState
trigger1 = Command = "holddown"
value = 10
ctrl = 1

[State 105, ChangeState2] ;Cancel into jumping
type = ChangeState
trigger1 = Command = "holdup"
value = 40
ctrl = 1

[State 105, 3]
type = ChangeState
trigger1 = AnimTime = 0
ctrl = 1
value = 0

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

;[State -2, Clipboard]
;type = DisplayToClipboard
;trigger1 = 1
;text = "Super Jump = %d AI = %d Random Var = %d Fireball Cancel = %d \n In Own State? = %d"
;params = var(10), var(59), var(3), var(57), var(15)

[State -2, P2Dist XY]
type = DisplayToClipboard
trigger1 = 1
text = "P2Dist X = %f and P2BodyDist X = %f \n P2BodyDist Y = %f | AI = %d HitCount = %d"
params = P2Dist X, P2BodyDist X, P2BodyDist Y, Var(59), Var(7)

[State -2, RemoveExplod]
type = RemoveExplod
trigger1 = P2StateNo != 905
ID = 900

[State -2, Super Jump VarSet]
type = VarSet
trigger1 = StateNo = 0
trigger2 = StateNo = 52
v = 10
value = 0

[State -2, Super Jump Spark VarSet]
type = VarSet
trigger1 = StateNo = 0
trigger2 = StateNo = 52
trigger3 = MoveType = H
trigger4 = Vel Y >= 0
v = 12
value = 0

[State -2, Recovery Roll Reset]
type = VarSet
trigger1 = (StateNo != 5050) && (StateNo != 5071)
v = 30
value = 0

[State -2, FireBall Dust Trail VarSet 1]
type = VarSet
trigger1 = 1
v = 50
value = 0

[State -2, FireBall Dust Trail VarSet 2]
type = VarSet
trigger1 = ProjContact1000 = 1
trigger2 = NumProjID(1000) = 0
v = 50
value = 1

[State -2, FireBall Cancel VarSet 1]
type = VarSet
trigger1 = AnimTime = 0
trigger2 = Ctrl = 1
trigger3 = StateNo != [1000,1120]
v = 57
value = 0

[State -2, FireBall Cancel VarSet 2]
type = VarSet
trigger1 = ProjContact1000 = 1
v = 57
value = 1

[State -2, VarSet 1];detects if in own state
type = VarSet
trigger1 = NumExplod(6105) <= 0
v = 15
value = 0

[State -2, VarSet 2];detects if in own state
type = VarSet
trigger1 = NumExplod(6105) >= 1
v = 15
value = 1

;-----------------------------
;Custom Combo
;-----------------------------

[State -2, VarSet];CC VarSet
type = VarSet
trigger1 = Power = 0
trigger2 = MoveType = H
trigger3 = RoundState = 3
v = 20
value = 0

[State -2, AfterImageTime];Cancels AfterImages if hit
type = AfterImageTime
triggerall = Var(15) = 1
trigger1 = MoveType = H
trigger2 = RoundState = 3
trigger3 = StateNo = 3910
time = 1

[State -2, AfterImageTime];CC AfterImageTime
type = AfterImageTime
trigger1 = Var(20) = 1
time = power
persistent = 1

[State -2, PowerAdd];CC Power draining
type = PowerAdd
trigger1 = Var(20) = 1
persistent = 1
ignorehitpause = 1
value = -4

[State -2, AssertSpecial];CC No juggle check
type = AssertSpecial
trigger1 = Var(20) = 1
flag = NoJuggleCheck
persistent = 1

;---------------------------------------
; Kamek's Combo Ranking
;---------------------------------------

[State -2, Set Up For Count]
type = VarSet
trigger1 = P2MoveType = H
trigger1 = Var(5) = 0
v = 5
value = 1

[State -2, Keep Track Of Hit Count]
type = VarSet
trigger1 = HitCount > 0
trigger1 = Var(5) != 0
v = 6
value = HitCount

[State -2, Add To Total Hit Count]
type = VarSet
triggerall = Var(5) != 0
trigger1 = HitCount = 0
trigger2 = P2MoveType != H
v = 7
value = Var(7) + Var(6)

[State -2, Projectile Hits]
type = VarSet
triggerall = Var(5) != 0
trigger1 = ProjHit = 1
v = 7
value = Var(7) + 1

[State -2, Reset Current Hit Count]
type = VarSet
trigger1 = HitCount = 0
trigger1 = Var(5) != 0
v = 6
value = 0

[State -2, Combo Is Finished]
type = VarSet
trigger1 = EnemyNear, MoveType != H
trigger1 = Var(5) != 0
v = 6
value = 0

[State -2, Reset]
type = VarSet
triggerall = Var(5) != 0
trigger1 = EnemyNear, MoveType != H
v = 5
value = 0

[State -2, Reset]
type = VarSet
trigger1 = Var(5) = 0
trigger1 = Var(7) > 0
v = 7
value = 0

