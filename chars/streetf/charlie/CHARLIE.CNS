[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 12
sparkno = 2
guard.sparkno = S8003
KO.echo = 0
volume = 100
IntPersistIndex = 59
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 24     ;Player width (back, ground)
ground.front = 26    ;Player width (front, ground)
air.back = 24        ;Player width (back, air)
air.front = 26       ;Player width (front, air)
z.width = 3          ;Player width (into and out)
height = 60	         ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.4      ;Walk forward
walk.back = -2.2     ;Walk backward
run.fwd  = 5.5, -3.8 ;Run forward (x, y)
run.back = -5.5,-3.8 ;Hop backward (x, y)
jump.neu = 0,-8.8    ;Neutral jumping velocity (x, y)
jump.back = -3.2,-2.55    ;Jump back Speed (x, y)
jump.fwd = 3.2,2.5        ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-8.1      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .44         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
[Statedef 180]
type = S

[State 180, 1]
type = VarRandom
trigger1 = Time = 0
v = 1
range = 0,3

[State 180, ChooseWin1]
type = VarSet
trigger1 = Command = "holdx"
v = 1
value = 0

[State 180, ChooseWin2]
type = VarSet
trigger1 = Command = "holdy"
v = 1
value = 1

[State 180, ChooseWin3]
type = VarSet
trigger1 = Command = "holdz"
v = 1
value = 2

[State 180, ChooseWin4]
type = VarSet
trigger1 = Command = "holda"
v = 1
value = 3

[State 180, 2]
type = ChangeState
trigger1 = Var(1) = 0
value = 181

[State 180, 3]
type = ChangeState
trigger1 = Var(1) = 1
value = 182

[State 180, 4]
type = ChangeState
trigger1 = Var(1) = 2
value = 183

[State 180, 5]
type = ChangeState
trigger1 = Var(1) = 3
value = 184

