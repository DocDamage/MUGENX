pal2    = charlie5.act
pal3    = charlie6.act
pal4    = charlie1.act
pal5    = charlie2.act
pal6    = charlie3.act
pal7    = shadow4.act
pal8    = shadow5.act
pal9    = shadow6.act
pal10   = shadow1.act
pal11   = shadow2.act
pal12   = shadow3.act

