trigger1 = command = "hold_z"
v = 1
value = 6

[state 180, 8]
type = varset
trigger1 = command = "hold_start"
v = 1
value = 7

[State 180, 9]
type = ChangeState
trigger1 = var(1) = 1
value = 181

[State 180, 10]
type = ChangeState
