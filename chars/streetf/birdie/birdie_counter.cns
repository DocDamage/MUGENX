; Introduction select
[Statedef 191]
type = S
ctrl = 0
velset = 0,0

[State 191, 1]
type = VarRandom
trigger1 = time >= 0
v = 1
range = 0,1

[state 191, 2]
type = changestate
triggerall = var(1) = 0
trigger1 = P2Name != "Bison" && P2Name != "M. Bison" && P2Name != "M Bison" 
trigger1 = P4Name != "Bison" && P4Name != "M. Bison" && P4Name != "M Bison" 
value = 192

[state 191, 3]
type = changestate
triggerall = var(1) = 1
trigger1 = P2Name != "Bison" && P2Name != "M. Bison" && P2Name != "M Bison" 
trigger1 = P4Name != "Bison" && P4Name != "M. Bison" && P4Name != "M Bison" 
value = 193

[state 191, 4]
type = changestate
triggerall = facing = 1 && numpartner = 0
trigger1 = P2Name = "Bison" || P4Name = "Bison"
trigger2 = P2Name = "M. Bison" || P4Name = "M. Bison"
trigger3 = P2Name = "M Bison" || P4Name = "M Bison"
value = 194

[state 191, 5]
type = changestate
triggerall = facing = 1 && numpartner = 1
trigger1 = P2Name = "Bison" || P4Name = "Bison"
trigger2 = P2Name = "M. Bison" || P4Name = "M. Bison"
trigger3 = P2Name = "M Bison" || P4Name = "M Bison"
value = 192

[state 191, 6]
type = changestate
triggerall = facing = -1
trigger1 = P2Name = "Bison" || P4Name = "Bison"
trigger2 = P2Name = "M. Bison" || P4Name = "M. Bison"
trigger3 = P2Name = "M Bison" || P4Name = "M Bison"
value = 193

