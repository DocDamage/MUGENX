;--------------------------------------------------------------------------
;Street Fighter Alpha/Zero 3 Counter Attack stuff
;--------------------------------------------------------------------------

;The following variable is active whenever opponent is in an attack state
[state 12,12]
type = varset
trigger1 = p2movetype = A
v = 3
value = 2

;That same variable counts down so that it only stays positive when the
;opponent is in an attack state.
[state 12,12] 
type = varadd
trigger1 = var(3) > 0
v = 3
value = -1

