;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[State -2, 1]
type = AfterImageTime
triggerall = Time >= 0
trigger1 = stateno != [1000,1190]
trigger1 = stateno != [40,50]
trigger1 = stateno != [1600,1720]
time = 0

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[state 12,12]
