;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; Hit Wall (a custom gethit state)
[Statedef 9020]
type    = A
movetype= H
physics = N

[State 9020, Turn]
type = Turn
trigger1 = (Time = 0) && (FrontEdgeBodyDist <= 30)

[State 9020, 1]
type = VelSet
trigger1 = Time = 0
x = Vel X / 2 
y = Vel Y / 2  

[State 9020, Pos]
type = PosAdd
trigger1 = Time = 0
x = 15 - BackEdgeBodyDist

[State 9020, Stop moving]
type = PosFreeze
trigger1 = 1
x = 1
y = 1

[State 9020, No scroll]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 0,1

[State 9020, Anim]
type = ChangeAnim2
trigger1 = Time = 0
value = 9020

[State 9020, State]
type = ChangeState;SelfState
trigger1 = AnimTime = 0
value = 5031;5030

