; Special Fall State (by SMI)
[Statedef 5031]
type    = A
movetype= H
physics = N
ctrl = 0
velset = .3, Vel Y -.1 ;-4.5

[State 5031, 1]
type = VelAdd;Gravity
trigger1 = 1
y = GetHitVar(yaccel)

[State 5031, 2]
type = ChangeAnim ;HitFallSet
;triggerall = Anim != 5050
trigger1 = Time = 0
trigger1 = HitFall
value = 5050
;persistent = 0

[State 5031, 3]
type = SelfState
triggerall = !HitFall
trigger1 = HitOver
trigger2 = Vel Y > 0    ;Hit ground
trigger2 = Pos Y >= 10  ;.
value = 5040 ;HITA_RECOV
ctrl = 0

[State 5031, 4]
type = SelfState
triggerall = HitFall
;trigger1 = HitOver
trigger1 = Vel Y > 0    ;Hit ground
trigger1 = Pos Y >= 10  ;.
value = 5100 ;5050 
ctrl = 0


