[State -3, Finish Hit Explod - Helper: Ryu] ;based on FlowaGirl and Ethan Lives codes
type = Helper
;triggerall = NumTarget > 0
triggerall = NumHelper(8900) = 0
;triggerall = roundstate = 3
;triggerall = !Target, Alive
triggerall = (WinKO) && (NumHelper(8920) < 1) && (StateNo != 1210)
trigger1 = (StateNo = [200,2999]) && (Time >= 0) 
trigger2 = NumHelper(1005) = 1 || NumHelper(1006) = 1 || NumHelper(1007) = 1
trigger3 = NumHelper(1013) = 1 || NumHelper(1014) = 1 || NumHelper(1015) = 1
helpertype = Normal
name = "Finish Hit Explod"
id = 8900
pos = 0, 0
postype = p1
facing = 0
stateno = 8900
keyctrl = 0
ownpal = 1
supermovetime = 1000
pausemovetime = 1000
ignorehitpause = 1

