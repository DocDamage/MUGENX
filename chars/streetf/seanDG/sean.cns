; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
triggerall = PrevStateNo != [1100, 1102]
triggerall = PrevStateNo != [1200, 1202]
triggerall = PrevStateNo != [1600, 1602]
triggerall = PrevStateNo != 1705
triggerall = PrevStateNo != 182
triggerall = PrevStateNo != 192
triggerall = PrevStateNo != 194
triggerall = PrevStateNo != 3100 
trigger1 = Time = 3
value = 1

[State 52, 4]
type = Turn
triggerall = PrevStateNo != [1100, 1102]
triggerall = PrevStateNo != [1200, 1202]
triggerall = PrevStateNo != [1600, 1602]
triggerall = PrevStateNo != 1705
triggerall = PrevStateNo != 182
triggerall = PrevStateNo != 192
triggerall = PrevStateNo != 194
triggerall = PrevStateNo != 3100 
triggerall = P2BodyDist X < -5;0
trigger1 = Command = "holdup" || Command = "holddown" 
;trigger3 = Command = "holdfwd" || Command = "holdback" 
trigger2 = Command = "holdup" && Command = "holdfwd" || Command = "holdback"

[State 52, 5]
type = ChangeState
triggerall = PrevStateNo != 9000 ;for "fall after Air Shinkuu Hadou-Ken" works fine
trigger1 = AnimTime = 0
trigger2 = AnimElem = 2 && Command = "holddown"
value = ifelse(Command = "holddown", 11, 0);0
ctrl = 1

[State 52, 6]        ;fall after Air Shinkuu Hadou-Ken 
type = ScreenBound   ;para a câmera continuar ñ filmando
triggerall = PrevStateNo = 9000
trigger1 = 1
value = 0

[State 52, 7] ;fall after Air Shinkuu Hadou-Ken 
type = ChangeState
triggerall = PrevStateNo = 9000
trigger1 = AnimTime = 0 ;time = 2
value = ifelse(BackEdgeDist > -10, 0, 9001)
ctrl = ifelse(BackEdgeDist > -10, 1, 0);1

[State 52, 8] ;shouryu land
type = ChangeState
trigger1 = PrevStateNo = [1100, 1102]
value = 1110 
ctrl = 0

[State 52, 9] ;tornado land
type = ChangeState
trigger1 = PrevStateNo = [1200, 1202]
value = ifelse(PrevStateNo = 1200, 1210, 1211) 
ctrl = 0

[State 52, 10] ;ryuubi kyaku land
type = ChangeState
trigger1 = PrevStateNo = [1600, 1602]
value = 1610
ctrl = 0

[State 52, 11] ;tackle land
type = ChangeState
trigger1 = PrevStateNo = 1705
value = 1706 
ctrl = 0

[State 52, 12] ;shouryu cannon land
type = ChangeState
trigger1 = PrevStateNo = 3100
value = 3102 
ctrl = 0

[State 52, 13] ;win pose pelé land
type = ChangeState
trigger1 = PrevStateNo = 182
value = 185 
ctrl = 0

[State 52, 14] ;intros basket shoot/miss land
type = ChangeState
trigger1 = PrevStateNo = 192
trigger2 = PrevStateNo = 194
value = 186 
ctrl = 0



