;=====================================================================
;  CNS File For "Juni"                                  Made By M.M.R.
;                                       Ver. 0.7           2001.Aug.20
;=====================================================================

;---------------------------------------------------------------------
; 変数表
;	Var(1)	: 各種ヒット判定
;	Var(2)	: 地上受け身継続入力フラグ
;	Var(3)	: サイコシールドフラグ
;	Var(4)	: 特殊勝利ポーズ用フラグ
;	Var(25)	: スーパーコンボフィニッシュフラグ
;	Var(26)	: 大ジャンプフラグ
;	Var(27) : 大ジャンプ中のレバー入力管理
;	Var(28) : 大ジャンプフラグ２
;	Var(29) : ＣＰＵ専用乱数
;	Var(30) : ＣＰＵ専用フラグ
;	Var(31) : ＩＳＭ設定
;---------------------------------------------------------------------

;---------------------------------------------------------------------
; 基本設定
[Data]
life = 1000          ; 体力ゲージ、上限値（デフォルト：1000）
power = 3000	     ; パワーゲージ、デフォルト：1000
attack = 100         ; 攻撃力（％）
defence = 100        ; 防御力（％）
fall.defence_up = 50 ; 空中コンボ修正率（％）
liedown.time = 56    ; ダウン時間
airjuggle = 15       ; 空中コンボ
sparkno = 0          ; 初期ヒットスパーク番号
guard.sparkno = 40   ; 初期ガードスパーク番号
KO.echo = 0          ; ＫＯボイスエコー（0:OFF、1:ON）
volume = -5          ; キャラボイスボリューム値

[Size]
xscale = 1           ; 水平サイズ倍率
yscale = 1           ; 垂直サイズ倍率
ground.back = 20     ; キャラ幅（地上、後ろ側）
ground.front = 25    ; キャラ幅（地上、前側）
air.back = 15        ; キャラ幅（空中、後ろ側）
air.front = 15       ; キャラ幅（空中、前側）
z.width = 10         ; キャラ幅（ｚ軸）
height = 60	     ; キャラの高さ（ジャンプで飛び越せる高さ）
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = -1,-76    ; 頭部座標
mid.pos = -4,-55     ; 体中心部座標
shadowoffset = 1     ; キャラの影・オフセット値

[Velocity]
walk.fwd  = 3.40      ; 前進速度
walk.back = -2.40     ; 後退速度
run.fwd  = 5.50, 0    ; 前ダッシュ速度（y<0の場合、ホップステップ）
run.back = -4.80, 0   ; バックステップ速度（y=0の場合、走り）
jump.neu = 0,-8.2     ; 垂直ジャンプ速度
jump.back = -4.00    ; 後方ジャンプ速度
jump.fwd = 3.50      ; 前方ジャンプ速度
;runjump.back = -2.55,-8.1 ; 後方ジャンプ速度（ダッシュ中）
;runjump.fwd = 3.6,-9.0      ; 前方ジャンプ速度（ダッシュ中）
;airjump.neu = 0,-9.3      ; 空中垂直ジャンプ速度
;airjump.back = -2.55,-8.1 ; 空中後方ジャンプ速度
;airjump.fwd = 2.5,-8.1    ; 空中前方ジャンプ速度

[Movement]
airjump.num = 0       ; 空中ジャンプ回数
;airjump.height = 35  ; 空中ジャンプ最低高度
yaccel = .43          ; キャラ重力加速度
stand.friction = .85  ; 摩擦係数（立ち状態）
crouch.friction = .82 ; 摩擦係数（しゃがみ状態）

;===============================================================================
; Definition of the Basic Action
;===============================================================================

;===============================================================================
; Definition of the Win/Lose/Intro Pause
;===============================================================================

;-------------------------------------------------------------------------------
; 時間切れ負け
[Statedef 170]
type = S
ctrl = 0
anim = 175
velset = 0,0

[State 170,1]
type = NotHitBy
trigger1 = 1
value = SCA

[State 170,12]
type = AssertSpecial
trigger1 = Time = [0,240]
flag = RoundNotOver

;-------------------------------------------------------------------------------
; 時間切れ引き分け
[Statedef 175]
type = S
ctrl = 0
velset = 0,0

[State 175,0]
type = ChangeState
trigger1 = Time = 0
value = 170

;-------------------------------------------------------------------------------
; 勝利
;------------------------ スーパーコンボフィニッシュ時の保留
[Statedef 180]
type = S
movetype = I
physics = N
velset = 0, 0
ctrl = 0

[State 180,VarRandom]
type = VarRandom
trigger1 = Time = 0
v = 1
range = 1,6

[State 180,NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 180,ChangeState]
type = ChangeState
trigger1 = !NumExplod(2600) && !NumExplod(2610) && !NumExplod(2620)
value = IfElse(Var(4) = 0,181,182)

;------------------------ 分岐
[Statedef 181]
type = S
movetype = I
physics = S
velset = 0, 0

[State 181,Muteki]
type = NotHitBy
trigger1 = 1
value = SCA

[State 180,0]
type = ChangeState
triggerall = Time = 0
trigger1 = Command = "xx" || Command = "bb"
value = 4200

[State 180,0]
type = ChangeState
triggerall = Time = 0
trigger1 = Command = "yy" || Command = "cc"
value = 4210

[State 180,0]
type = ChangeState
triggerall = Time = 0
trigger1 = Command = "zz"
value = 4220

[State 180,0]
type = ChangeState
triggerall = Time = 0
trigger1 = Command = "aa"
value = 4230

[State 180,ChangeState]
type = ChangeState
triggerall = Time = 1
trigger1 = Var(1) = 1 || Var(1) = 5
value = 4200

[State 180,ChangeState]
type = ChangeState
triggerall = Time = 1
trigger1 = Var(1) = 2 || Var(1) = 6
value = 4210

[State 180,ChangeState]
type = ChangeState
triggerall = Time = 1
trigger1 = Var(1) = 3
value = 4220

[State 180,ChangeState]
type = ChangeState
triggerall = Time = 1
trigger1 = Var(1) = 4
value = 4230

