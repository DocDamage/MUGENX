;------------------------------------------------------------
; States that execute when in self's state (use statedef -3)
;------------------------------------------------------------

[Statedef -3]

;-------------------------------------------
[State -3, Clipboard]
type = DisplayToClipboard
trigger1 = 1
text = "Rankpoint = %d, Taunt Defense LV = %d"
params = Var(59), Var(13)
ignorehitpause = 1

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52  ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 7,3

;-------------------------------------------
; Stun Code...
;-------------------------------------------
[State -3, Stun Add]
type = VarAdd
trigger1 = StateNo = 5000 && Time = 1 && UniqHitCount <= 1 && GetHitVar(HitCount) <= 3
var(6) = GetHitVar(AnimType)*50
ignorehitpause = 1

[State -3, Stun Add]
type = VarAdd
trigger1 = MoveType != H
var(6) = -1
ignorehitpause = 1

[State -3, Go to Stun]
type = ChangeState
trigger1 = RoundState = 2 && Alive && Var(6) >= 1000 && (((StateType = S || StateType = C) && HitOver) || (StateNo = 5120 && AnimTime = 0))
value = 5300
ignorehitpause = 1

[State -3, Stun Sound Stop]
type = StopSnd
trigger1 = StateNo != 5300
channel = 10

[State -3, Stun Bird]
type = RemoveExplod
trigger1 = StateNo != 5300
ID = 8150

