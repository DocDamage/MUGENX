; Taunt Defense
[State -2, d1]
type = DefenceMulSet
trigger1 = Alive = 1
trigger1 = var(13) = 0
value = 1

[State -2, d2]
type = DefenceMulSet
trigger1 = Alive = 1
trigger1 = var(13) = 1
value = 1.33

[State -2, d3]
type = DefenceMulSet
trigger1 = Alive = 1
trigger1 = var(13) = 2
value = 1.67

[State -2, d_max]
type = DefenceMulSet
trigger1 = Alive = 1
trigger1 = var(13) = 3
value = 2

;---------------------------------
[State -2, punchfix]
type = Posset
trigger1 = Prevstateno = 220
trigger1 = (Stateno = [5000,5170])
trigger2 = Prevstateno = 225
trigger2 = (Stateno = [5000,5170]) 
y = 0

[State -2, airfix]
type = Posset
trigger1 = Pos Y < 0
trigger1 = Stateno = 0
trigger2 = Pos Y < 0
trigger2 = (Stateno = [200,255]) 
y = 0

;---------------------------------
[State -2, chipKO]
type = ChangeState
trigger1 = Life <= 0 && StateNo = 5000 + (StateType = C)*10 && (PrevStateNo = [130,131])
value = 7000

