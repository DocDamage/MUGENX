; Definition file for T.Hawk
;--------------------
;[Player Information]
;--------------------
[Info]
name = "T.Hawk"	   ;Name of character
displayname = "T.Hawk"	   ;Name of character to display
versiondate = 2002.7.28   ;Version date of character
mugenversion = 2001.04.14  ;Version of M.U.G.E.N character works on
author = "N64Mario"	   ;Character author name
pal.defaults = 1,2,3,4,5,6 ;Default palettes in order of preference
;--------------------
;[Common Files] 
;--------------------
[Files]
cmd	 = command.cmd	 ;Commands
cns	 = constant.cns	 ;Constants
stcommon = common.cns	 ;Common States
sprite	 = thawk.sff	 ;Sprites
anim	 = animation.air  ;Animation
sound	 = thawk.snd	 ;Sound
;--------------------
;[States] 
;--------------------
st	 = thawk.cns	;T.Hawk's States
st2	 = thawk-s.cns	;Special States
st3	 = thawk-h.cns	;Hyper States
st4      = override.cns	;Override States
st5	 = custom.cns	;Custom States
st6	 = hawk.cns	;Hawk States
;--------------------
;[Palettes] (can have up to 12)
;--------------------
pal1   = thawk.act  ;Palettes (can have up to 12)
pal2   = thawk2.act
pal3   = thawk3.act
pal4   = thawk4.act
pal5   = thawk5.act
pal6   = thawk6.act
