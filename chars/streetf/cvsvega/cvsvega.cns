;베가 CNS 설정파일
;가고일의 것!!!!!

;Var(1) - 그로기 회복
;Var(2) - 그로기 시스템
;Var(3) - 점프
;Var(4) - 그로기 회복
;Var(5) - 약중강 구분
;Var(7) - AI
;Var(8) - 써머쏠트 스컬 드라이버
;FVar(1) - 익스플로드 스케일

[Data]
life = 1000
attack = 105
defence = 105
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 200
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1         
yscale = 1         
ground.back = 20     
ground.front = 20  
air.back = 20       
air.front = 20     
height = 60      
attack.dist = 160   
proj.attack.dist = 90
proj.doscale = 0     
head.pos = 2, -89   
mid.pos = -3, -58    
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 2
walk.back = -2     
run.fwd  = 8, 0   
run.back = -5,0
jump.neu = 0,-9.5
jump.back = -3,-9.5   
jump.fwd = 3,-9.5     
runjump.back = -5,-10
runjump.fwd = 5,-10    
airjump.neu = 0,-8      
airjump.back = -3     
airjump.fwd = 3        

[Movement]
airjump.num = 0     
airjump.height = 35 
yaccel = .48         
stand.friction = .85  
crouch.friction = .82

;---------------------------------------------------------------------------
;상단 원거리 약펀치
[Statedef 200]
type    = S                      
movetype= A                    
physics = S                    
juggle  = 3                  
velset = 0,0                     
ctrl = 0                        
anim = 200                                         
sprpriority = 2                
poweradd = 10

[State 200, Effect]
type = PlaySnd
trigger1 = AnimElem = 1
value = 1, 24
channel = 1

[State 200, Voice]
type = PlaySnd
trigger1 = AnimElem = 1 && Random <= 550
value = 0, ifelse (Random <= 550, 21, 14)
channel = 0

[State 200, Effect]
type = Explod
trigger1 = AnimElemTime(1) = 0 || (AnimElemTime(2) >= 0 && AnimElemTime(3) <= 0)
Anim = ifelse (AnimElemTime(1) = 0, 10000, ifelse ((AnimElemTime(2) = [0,1]), 10001, ifelse (AnimElemTime(3) = 0, 10003, 10002)))
pos = 0,0
postype = p1
sprpriority = 3
ownpal = 1
bindtime = -1
removeongethit = 1
ignorehitpause = 1
ID = 10000

[State 200, 1]
type = Hitdef
trigger1 = AnimElem = 2
attr = S, NA
hitflag = MA
guardflag = M
animtype = Light
air.animtype = Back
priority = 3,Hit
damage = 25, 0
pausetime = 9, 9
sparkno = S8025
guard.sparkno = S8035
sparkxy = 8, -80
hitsound = S1, 11
guardsound = S1, 15
ground.type = High
ground.slidetime = 9
ground.hittime = 10
air.hittime = 10
guard.ctrltime = 10
ground.velocity = -7
air.velocity = -5, -5

[State 200, StateChange]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

