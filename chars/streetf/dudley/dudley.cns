;더들리 cns 설정 파일
;가고일이 04년 11월 3일부터 작성
;왠만하면 손대지 마시지?-_-
;----------------------------------------
;Var 사용 목록
;----------------------------------------
;FVar(1) - 점프
;FVar(2) - 인트로 거리 계산
;Var(1) - 상하단 가드 구분
;Var(2) - 강약 구분
;Var(3) - 기술 연결, 연타 관련
;Var(4) - 랜덤
;Var(5) - 퀵스탠딩
;Var(6) - 스턴 시스템
;Var(7) - 타겟 콤보
;Var(8) - 모드 변환
;Var(9) - 셰도우
;----------------------------------------

[Data]
life = 1000
attack = 75
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 255
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 22
ground.front = 24
air.back = 20
air.front = 20
height = 94
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = 9, -98
mid.pos = -4, -65
shadowoffset = -2
draw.offset = 0,0

[Velocity]
walk.fwd  = 3.3
walk.back = -2.7
run.fwd  = 6,-3
run.back = -6,-3
jump.neu = 0,-9
jump.back = -3.7
jump.fwd = 3.7
runjump.back = -6
runjump.fwd = 6
airjump.neu = 0,0
airjump.back = 0
airjump.fwd = 0

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .55
stand.friction = .85
crouch.friction = .82

