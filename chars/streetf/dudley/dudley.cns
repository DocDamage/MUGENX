type = S
ctrl = 0
anim = 180
velset = 0,0

[State 181, Cloth]
type = Explod
trigger1 = Time = 0
anim = 8080
postype = Back
pos = 0, 20
vel = (BackEdgeDist/40), ((ScreenPos Y-122)/40)
sprpriority = 2
bindtime = 1
ID = 8080

[State 181, Cloth]
type = RemoveExplod
trigger1 = AnimElemTime(20) = 0
ID = 8080

[State 181, Cloth]
type = Explod
trigger1 = AnimElemTime(20) = 0
anim = 8081
pos = -2, -102
sprpriority = 2
bindtime = -1
ID = 8081

[State 181, Voice]
type = PlaySnd
trigger1 = AnimElem = 2 || AnimElem = 7 || AnimElem = 11 || AnimElem = 31
value = 1, Ifelse ((AnimElem = 31), 17, 8)
channel = 0

[State 181, Effect]
type = PlaySnd
trigger1 = AnimElem = 26
value = 2, 3
freqmul = 0.5
channel = 1

[State 181, Muteki]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

