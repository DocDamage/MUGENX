ctrl = 0
anim = 175
velset = 0,0

[State 170, Muteki]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
;승리포즈 결정기
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = Ifelse (Random <= 333, 181, Ifelse (Random > 666, 182, 183))

