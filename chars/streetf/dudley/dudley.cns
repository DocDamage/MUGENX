;---------------------------------------------------------------------------
;인트로2 (차량에서 하차)
[Statedef 192]
type = A
physics = N
sprpriority = 3
ctrl = 0
velset = 0,0

[State 192, Position]
type = VarSet
trigger1 = Time = 0
fvar(2) = Pos X

[State 192, Turn]
type = Turn
trigger1 = Enemy, Name = "Makoto" && (Time = 0 || (Anim = 47 && AnimTime = 0))

[State 192, Ford]
type = Helper
trigger1 = Time = 0
name = "Ford"
postype = Back
size.height = 40
size.ground.back = 0
size.ground.front = 0
stateno = 8070

[State 192, Anim]
type = ChangeAnim
trigger1 = (Helper, AnimElemTime(4) < 0) || (Anim = 41 && Vel Y > 0) || (Anim = 44 && Pos Y >= 0 && Vel Y > 0) || (Enemy, Name = "Makoto" && Anim = 47 && AnimTime = 0)
value = Ifelse (Helper, AnimElemTime(4) < 0, 41, Ifelse (Anim = 41 && Vel Y > 0, 44, Ifelse ((Anim = 44 && Pos Y >= 0 && Vel Y > 0), 47, 5)))
elem = Ifelse (Helper, AnimElemTime(4) < 0, 4, 1)

[State 192, Assert]
type = AssertSpecial
trigger1 = Anim != 0
flag = Intro

[State 192, Position]
type = PosSet
trigger1 = Time > 0 && Helper, AnimElemTime(4) < 0
x = Ifelse (Facing = 1, -200, 200)
y = -40

[State 192, Position]
type = PosFreeze
trigger1 = Helper, AnimElemTime(4) < 0

[State 192, Velocity]
type = VelSet
trigger1 = Helper, AnimElemTime(4) = 0 || Anim = 47
x= Ifelse (Helper, AnimElemTime(4) = 0, (200  - Ifelse ((Facing = -1 && Enemy, Name = "Makoto"), FVar(2), Abs(FVar(2))) + Ifelse ((Facing = 1 && Enemy, Name = "Makoto"), FVar(2)*2, 0))/33, 0)
y = Ifelse (Helper, AnimElemTime(4) = 0, -7, 0)

[State 192, Gravity]
type = Gravity
trigger1 = Vel Y

[State 192, Position]
type = PosSet
trigger1 = Anim = 47
y = 0

[State 192, StateType]
type = StateTypeSet
trigger1 = Anim = 47
value = S

[State 192, Screen]
type = ScreenBound
trigger1 = 1
Value = 0
movecamera = 0,0

[State 192, Push]
type = PlayerPush
trigger1 = 1
value = 0

[State 192, Effect]
type = PlaySnd
trigger1 = Helper, AnimElemTime(4) = 0
value = 2, 1
channel = 20

[State 192, StateChange]
type = ChangeState
trigger1 = (Anim = 47 || Anim = 5) && AnimTime = 0
value = 0

