;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, 0]
type = StateTypeSet
trigger1 = Anim = 5071
trigger1 = Statetype != L
statetype = L
movetype = H
ignorehitpause = 1

[State -2, 0]
type = PalFX
trigger1 = Var(50) = 3
time = -1
add = 0,0,136
ignorehitpause = 1

[State -2, HitUp Management]
type = ChangeAnim
trigger1 = HitPauseTime = 0
trigger1 = Anim = 5051
trigger1 = Vel Y < 0
trigger1 = GetHitVar(xvel) = 0
trigger1 = AnimElemNo(0) > 1
value = 5051
elem = 2

[State -2, HitRecover Immunity]
type = NotHitBy
trigger1 = Anim = 5040
value = SCA
time = 1

[State -2, Poke Kill]
type = AssertSpecial
trigger1 = GetHitVar(fall.recovertime) > 9999
trigger1 = Statetype != A
flag = NoKOSnd
ignorehitpause = 1

[State -2, Dash Forward Detection]
type = VarSet
trigger1 = StateNo != [100,101]
trigger1 = StateNo != [5000,5999]
v = 10
value = 0

;-----------------------------
;Personal Action
[State -2, 0]
type = VarAdd
trigger1 = Var(13)
v = 13
value = -1
ignorehitpause = 1

[State -2, 0]
type = Trans
trigger1 = Var(13) = [31,60]
trans = addalpha
alpha = 64,256
ignorehitpause = 1

[State -2, 0]
type = AssertSpecial
trigger1 = Var(13) > 60
trigger2 = Var(13) = [31,60]
trigger2 = Time % 2 = 1
trigger3 = Var(13) = [21,30]
flag = Invisible
ignorehitpause = 1

[State -2, 0]
type = Trans
trigger1 = Var(13) = [1,21]
trans = addalpha
alpha = Floor(256-(12.8*(Var(13)))),Floor(12.8*(Var(13)))
ignorehitpause = 1

[State -2, 0]
type = VarSet
trigger1 = Var(13)
trigger1 = !HitOver
v = 13
value = 0
ignorehitpause = 1

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0

[State 5071, 2] ;Acceleration
type = AssertSpecial
trigger1 = Anim = 5470
trigger2 = Anim = [5080,5150]
flag = NoAutoTurn

[State -2, 0]
type = ChangeState
triggerall = Command = "down"
trigger1 = StateNo != 5200
trigger1 = Anim = 5405
trigger1 = AnimElemNo(0) = [10,12]
trigger2 = Anim = 5405
trigger2 = AnimElemNo(0) = [9,11]
trigger3 = Anim = 5071
trigger3 = AnimElemNo(0) = [6,8]
value = 5200