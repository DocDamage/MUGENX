[Data]
life = 1000
power = 1000
attack = 100
defence = 91
fall.defence_up = 0
liedown.time = 30
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 40
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 38     ;Player width (back, ground)
ground.front = 34    ;Player width (front, ground)
air.back = 38        ;Player width (back, air)
air.front = 34       ;Player width (front, air)
height = 60          ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = -5, -90   ;Approximate position of head
mid.pos = -5, -60    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.75      ;Walk forward
walk.back = -2.25     ;Walk backward
run.fwd  = 8, 0    ;Run forward (x, y)
run.back = -8,-3.8 ;Hop backward (x, y)
jump.neu = 0,-9.0625    ;Neutral jumping velocity (x, y)
jump.back = -3.125    ;Jump back Speed (x, y)
jump.fwd = 3.5       ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-8.1      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .5         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching
;
;--------------
;Interger Vars:
;--------------
;
;Var(5) = Is Parrying
;Var(10) = Dash Forward Detection
;Var(11) = GetHitTime tracker
;Var(13) = PA Active Time

;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 170]
type = S
ctrl = 0
velset = 0,0

[State 170, 0]
type = ChangeAnim
trigger1 = Anim != 170
value = 170

[State 170, 1]
type = PlaySnd
trigger1 = Time = 4
value = 170, 0

;---------------------------------------------------------------------------
; Win state decider
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = WinTime
value = 182

[State 180, 2]
type = ChangeState
trigger1 = !MatchOver
value = 183

[State 180, 2]
type = ChangeState
trigger1 = Time = 0
value = 184

;---------------------------------------------------------------------------
; Win pose 1 - Bow
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, 1]
type = Null
trigger1 = 1

;---------------------------------------------------------------------------
; Win by Time Over
[Statedef 182]
type = S
ctrl = 0
anim = 182
velset = 0,0

[State 182, 1]
type = Null
trigger1 = 1

;---------------------------------------------------------------------------
; Win - Morph Arms
[Statedef 183]
type = S
ctrl = 0
anim = 183
velset = 0,0

[State 183, 1]
type = PlaySnd
trigger1 = AnimTime = 0
trigger1 = Anim = 183
value = 183, 0

[State 183, 2]
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 183
value = 184 + (Random <= 700) + (Random <= 400)

;---------------------------------------------------------------------------
; Win - Roar
[Statedef 184]
type = S
ctrl = 0
anim = 187
velset = 0,0

[State 183, 1]
type = PlaySnd
trigger1 = AnimTime = 0
trigger1 = Anim = 183
value = 183, 0

;---------------------------------------------------------------------------
; Personal Action
[Statedef 189]
type = S
ctrl = 0
anim = 189
velset = 0,0

[State 183, 1]
type = ChangeAnim
trigger1 = Anim != 188
trigger1 = Var(13)
value = 188

[State 183, 1]
type = VarSet
trigger1 = Var(13)
trigger1 = Anim = 188
v = 13
value = 0

[State 183, 1]
type = VarSet
trigger1 = Var(13) = 0
trigger1 = AnimTime = 0
trigger1 = Anim = 189
v = 13
value = 320

[State -2, 0]
type = AssertSpecial
trigger1 = Var(13) > 60
flag = Invisible
ignorehitpause = 1

[State 183, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[State -2, 0]
type = Trans
trigger1 = Anim = 188
trans = addalpha
alpha = Floor(4.2*(Time)), Floor(256-(4.2*(Time)))
ignorehitpause = 1

[State -2, 0]
type = Trans
trigger1 = Anim = 189
trigger1 = Time >= 18
trans = addalpha
alpha = Ceil(256-(4*(Time - 18))), Ceil(4*(Time - 18))
ignorehitpause = 1

[State 183, 1]
type = PlaySnd
trigger1 = Anim = 188
trigger1 = !Time
value = 188, 0

[State 183, 1]
type = PlaySnd
trigger1 = Anim = 189
trigger1 = Time = 21
value = 189, 0

;---------------------------------------------------------------------------
; PREINTRO
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(190)
value = 190

[State 190, 1]
type = VarSet
trigger1 = 1
v = 50
value = Floor(Abs(Pos Z))

[State 190, 2] ;Go straight to intro.
type = ChangeState
trigger1 = Time = 0
value = 191

;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 191, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = Anim

[State 183, 1]
type = PlaySnd
trigger1 = Time = 140
value = 190, 0

[State 191, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, 3] ;Change to stand state when done
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Taunt
; CNS difficulty: easy
[Statedef 195]
type = S
ctrl = 0
anim = 195
velset = 0,0
movetype = I
physics = S
sprpriority = 2

[State 195, 1]
type = CtrlSet
trigger1 = Time = 40
value = 1

[State 195, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

