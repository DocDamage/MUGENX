; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Twelve"        ;Name of character
displayname = "Twelve" ;Name of character to display
versiondate = 04,01,2006    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,22,2005   ;Version of M.U.G.E.N character works on
author = "Kung Fu Man"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = twelve.cmd   ;Command set
cns     = twelve.cns   ;Constants
st      = twelve.cns   ;States
stcommon = common1.cns ;Common states
sprite  = twelve.sff   ;Sprite
anim    = twelve.air   ;Animation
sound   = twelve.snd
pal1    = 12-2.act  ;Palettes (can have up to 12)
pal2    = 12-4.act
pal3    = 12-6.act
pal4    = 12-1.act
pal5    = 12-3.act
pal6    = 12-5.act
pal7    = 12-8.act
pal8    = 12-10.act
pal9    = 12-12.act
pal10   = 12-7.act
pal11   = 12-9.act
pal12   = 12-11.act
;pal13   = 12-13.act

; Arcade mode
[Arcade]
