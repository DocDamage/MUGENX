; Definition file for Karin by Orochi Herman
; Contains all the filenames needed for the character

; Player information
[Info]
name               = "Karin"
displayname        = "Karin"
versiondate        = 10,31,2001      ;Version date of character
mugenversion       = 04,14,2001      ;Version of M.U.G.E.N character works on
author             = "Orochi Herman" ;Character author name
pal.defaults       = 4,5,6,1,2,3     ;Default palettes in order of preference
original.creator   = "CAPCOM"
converter.homepage = "http://rotb.cjb.net"

; Files for the player
[Files]
cmd      = Karin.cmd       ;Command set
cns      = Karin.cns       ;Constants
st       = Karin.cns       ;States
stcommon = common1.cns     ;Common states
st1      = constant.cns    ; State -2, -3 and so forth.
st2      = override.cns    ; Overidden states from common1.cns
st3      = supers.cns      ; super moves
st4      = misc.cns        ; extra state data.
sprite   = Karin.sff       ;Sprite
anim     = Karin.air       ;Animation
sound    = Karin.snd       ;Sound
pal4     = original.act    ;Palettes
pal5     = alternate.act   ; Pinkish karin
pal6     = xism1.act       ; Z3 Xism color
pal1     = xism2.act       ; Z3 Xism alternate color
pal2     = vism1.act       ; VIsm color
pal3     = vism2.act       ; VIsm alternate color
pal10    = akuma.act       ; messatsu!
pal11    = black.act       ; dark outfit
pal12    = gray.act        ; greyhound!
pal7     = akuma2.act      ; shoushi...
pal8     = emerald.act     ; sweet!
pal9     = pink.act        ; yum!
