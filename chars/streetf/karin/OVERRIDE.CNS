;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
facep2 = 1

[State 40, 0]
type       = PlaySnd
trigger1   = random < 499 && time = 0
trigger1   = var(1) = 1
value      = S0,15
;persistent = 0

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 0.0]
type = VarSet
trigger1 = Time = 0
trigger1 = var(1) = 1
v = 8
value = 0

[State 40, 0.1]
type = VarSet
trigger1 = command = "holdfwd"
trigger1 = var(8) != 2
trigger1 = var(1) = 1
v = 8
value = 1

[State 40, 0.2]
type = VarSet
trigger1 = command = "holdback"
trigger1 = var(8) != -2
trigger1 = var(1) = 1
v = 8
value = -1

[State 40, 0.1b]
type = VarSet
trigger1 = Time = 0
trigger1 = command = "holdfwd"
trigger1 = command = "longjump"
trigger1 = var(1) = 1
v = 8
value = 2

[State 40, 0.2b]
type = VarSet
trigger1 = Time = 0
trigger1 = command = "holdback"
trigger1 = command = "longjump"
trigger1 = var(1) = 1
v = 8
value = -2

[State 40, 4]
type = ChangeState
triggerall = AnimTime = 0
triggerall = var(1) = 1
trigger1 = var(8) != 0
trigger1 = var(8) != 1
trigger1 = var(8) != -1
trigger1 = command = "holdup"
trigger2 = command != "holdup"
value = 2041

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; JUMP_UP (short)
[Statedef 2041]
type    = A
physics = A
velset = 0, -6.4
ctrl = 1

[State 2041, 1a] ; Play sound when jumping (normal)
type = null;PlaySnd
trigger1 = Time = 0 && random > 500
trigger1 = var(8) != -2
trigger1 = var(8) != 2
value    = S0,15
persistent = 0

[State 2041, 1b] ; Play sound when jumping (long)
type = PlaySnd
triggerall = Time = 0 && random > 500
trigger1   = var(8) = -2
trigger2   = var(8) = 2
value      = S0,17
;persistent = 0

[State 2041, 2] ; Shadows
type = Afterimage
triggerall = Time = 0
trigger1 = var(8) = -2
trigger2 = var(8) = 2
time = 17
length = 9;6;12
PalBright   =   0,  0,  0
PalContrast = 128,128,128
PalAdd      =   0,  0,  0
PalMul      =  1,1,1;.9, .9, .9
FrameGap = 3;2
Trans = Add1

[State 2041, 2] ; Shadows off
type = Afterimage
trigger1 = Time = 14
time = 0

[State 2041, -0.1] ;Holding up?
type = VelSet
trigger1 = Time = 0
trigger1 = command = "holdup"
y = -8.6

[State 2041, 0.1]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(8) = 1
x = 3.2

[State 2041, 0.1b]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(8) = 2
x = 4.4

[State 2041, 0.2]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(8) = -1
x = -3.2

[State 2041, 0.2b]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(8) = -2
x = -4.4

[State 2041, 1.1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X = 0
trigger1 = command = "holdup"
value = 41

[State 2041, 1.2] ;Short
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X = 0
trigger1 = command != "holdup"
value = 2041

[State 2041, 2.1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X > 0
trigger1 = command = "holdup"
value = 41

[State 2041, 2.2] ;Short
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X > 0
trigger1 = command != "holdup"
value = 2041

[State 2041, 3.1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X < 0
value = 41

[State 2041, 2.2] ;Short
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X < 0
trigger1 = command != "holdup"
value = 2041

;---------------------------------------------------------------------------
; RUN_FWD Starting
[Statedef 100]
type    = S
physics = S
anim = 100
ctrl = 0
velset = 0

[State 105, ChangeState]
type = ChangeState
trigger1 = animtime = 0
value = 101

;---------------------------------------------------------------------------
; RUN_FWD Dashing
[Statedef 101]
type    = A
physics = A
anim = 101
ctrl = 0
velset = 0

[State 101, SFX]
type = PlaySnd
trigger1 = time = 0
value = S0,27

[State 105, Veladd]
type = Veladd
trigger1 = Time = 0
x = 6.5
y = -3.8

[State 105, 1]
type = Velmul
trigger1 = Time > 10
x = .92

[State 105, 2]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 107

;---------------------------------------------------------------------------
; RUN Back (charging)
[statedef 105]
type = S
physics = S
ctrl = 0
anim = 105

[State 105, ChangeState]
type = ChangeState
trigger1 = animtime = 0
value = 106

; RUN_BACK
[Statedef 106]
type    = A
physics = N
ctrl = 0
anim = 106

[State 101, SFX]
type = PlaySnd
trigger1 = time = 0
value = S0,27

[state haha]
type = gravity
trigger1 = 1

[State 105, Veladd]
type = Veladd
trigger1 = Time = 0
x = -6.5
y = -3.8

[State 105, 1]
type = Velmul
trigger1 = Time > 10
x = .92

[State 105, 2]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 6
value = 107

