; Punch Throw Success
[Statedef 261]
type    = S
movetype= A
physics = S
velset = 0
ctrl = 0
anim = 261

[state hehe]
type = turn
trigger1 = animelem = 3 && var(11) = 1

[state haha]
type = targetstate
triggerall = numtarget = 1
trigger1 = animelem = 3 && var(11) = 1
value = 266

[state hehe]
;type = bindtotarget
type = targetbind
triggerall = numtarget = 1
trigger1 = animelem = 2 && target, const(size.head.pos.y) <= -90
pos = 0 + ifelse(target, const(size.head.pos.y) > -90, ((-80 - target, const(size.head.pos.y)) * -1), 0) ,0
time = 1
ignorehitpause = 1

[state haha, Orochi Herman]
type = targetbind
;type = bindtotarget
triggerall = numtarget = 1
trigger1 = animelem = 2 && target, const(size.head.pos.y) >= -89
pos = 0 + ifelse(target, const(size.head.pos.y) > -90, ((-80 - target, const(size.head.pos.y)) * -1), 0), ifelse(target, const(size.head.pos.y) > -90, (-90 - target, const(size.head.pos.y)), 0)
;pos = 0, ifelse(target, const(size.head.pos.y) > -90, (-90 - target, const(size.head.pos.y)), 0)
time = 1
ignorehitpause = 1

[state hehe]
type = targetbind
triggerall = numtarget = 1
trigger1 = animelem = 5
pos = 0,0
time = 1

[State 1010, 4]
type = PlaySnd
trigger1 = animelem = 6
value = S1,5
channel = 0

[State 212, 2]
type = TargetLifeAdd
triggerall = numtarget = 1
trigger1 = animelem = 6
value = -150
absolute = 1
persistent = 0

[State 212, 2]
type = PlaySnd
trigger1 = animelem = 6
value = S0,8

[State 212, 2]
type = PlaySnd
trigger1 = animelem = 6
value = S0,11

