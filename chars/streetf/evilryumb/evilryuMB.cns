trigger1 = Var(10) != 1
length = 15
time = 15
trans = add1
palcolor = 256
palinvertall = 0
palbright = 40,40,40
palcontrast = 200,200,200
palpostbright = 0,0,0

[State 100, ChangeState] ;Cancel into crouching
type = ChangeState
