;---------------------------------------------------------------------------
; HITA_FALL (knocked up, falling)
[Statedef 5050]
type    = A
movetype= H
physics = N

[State 5050, 1] ;Change anim when done with transition
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 5035
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035
trigger2 = (Anim != [5051, 5059]) && (Anim != [5061, 5069])
trigger2 = Anim != 5090 ;Not if hit off ground anim
value = 5050

[State 5050, 2] ;Coming down anim
type = ChangeAnim
trigger1 = anim = [5050,5059]
trigger1 = Vel Y >= ifelse(anim = 5050, 1, -2)
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State 5050, 3] ;Gravity
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 5050, 4] ;Recover near ground
type = ChangeState
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
triggerall = Var(3) != 1 ;AI doesn't do fall recover near ground
trigger1 = Command = "recovery"
value = 5200 ;HITFALL_RECOVER

[State 5050, 5]; Recover in mid air
type = ChangeState
triggerall = Vel Y > -1
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5210 ;HITFALL_AIRRECOVER

[State 5050, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, 25)
value = 5100 ;HIT_BOUNCE

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, AfterImageTime]
type = AfterImageTime
trigger1 = MoveType = H
trigger2 = RoundState = 3
trigger3 = StateNo = 3910
time = 1

[State -2, AfterImageTime];CC AfterImage
type = AfterImageTime
trigger1 = Var(10) = 1
time = power
persistent = 1

[State -2, P2Dist XY]
type = DisplayToClipboard
trigger1 = 1
text = "P2Dist X = %f and P2BodyDist X = %f \n P2BodyDist Y = %f | AI = %d and Fireball Super Cancel = %d"
params = P2Dist X, P2BodyDist X, P2BodyDist Y, Var(3), Var(20)

;[State -2, Variables]
;type = DisplayToClipboard
;trigger1 = 1
;text = "Denjin Hits = %d  Opponent Dizzy = %d  Dust Trail = %d \n AttackMul Count = %d  CC Fireball Cancel = %d"
;params = Var(56), Var(55), Var(50), Var(17), Var(57)

;[State -2, Parrying]
;type = DisplayToClipboard
;trigger1 = 1
;text = "Stand Parry = %d Holding Fwd Time = %d Crouch Parry = %d \n Air Parry = %d Holding Fwd Counter = %d"
;params = Var(5), Var(6), Var(7), Var(8), Var(9)

[State -2, VarSet];CC VarSet
type = VarSet
trigger1 = Power = 0
trigger2 = MoveType = H
trigger3 = RoundState = 3
v = 10
value = 0

[State -2, PalFX];CC PalFX
type = PalFX
trigger1 = Var(10) = 1
trigger1 = (GameTime%2) = 0
time = 1
add = 64,64,64
ignorehitpause = 1

[State -2, PowerAdd];CC Power draining
type = PowerAdd
trigger1 = Var(10) = 1
persistent = 1
ignorehitpause = 1
value = -4

[State -2, AssertSpecial];CC No juggle check
type = AssertSpecial
trigger1 = Var(10) = 1
flag = NoJuggleCheck
persistent = 1

[State -2, FireBall Dust Trail VarSet 1]
type = VarSet
trigger1 = 1
;trigger1 = AnimTime = 0
;trigger2 = Ctrl = 1
v = 50
value = 0

[State -2, FireBall Dust Trail VarSet 2]
type = VarSet
trigger1 = ProjContact = 1
trigger2 = NumProjID(1000) = 0
trigger2 = NumProjID(3500) = 0
v = 50
value = 1

[State -2, FireBall Cancel VarSet 1]
type = VarSet
trigger1 = AnimTime = 0
trigger2 = Ctrl = 1
v = 57
value = 0

[State -2, FireBall Cancel VerSet 2]
type = VarSet
trigger1 = ProjContact1000 = 1
trigger1 = StateNo != [3600,3651]
v = 57
value = 1

[State -2, FireBall Super Cancel VarSet 1]
type = VarSet
;trigger1 = AnimTime = 0
trigger1 = Ctrl = 1
v = 20
value = 0

[State -2, FireBall Super Cancel VerSet 2]
type = VarSet
trigger1 = ProjContact = 1
v = 20
value = 1

[State -2, AI VarSet]
type = VarSet
trigger1 = Var(59) = 1
v = 3
value = 1

[State -2, RemoveExplod]
type = RemoveExplod
trigger1 = StateNo != [3101,3102]
ID = 8080

[State -2, RemoveExplod];Shinkuu Haoduken
type = RemoveExplod
trigger1 = StateNo != 3000
trigger1 = StateNo != 3050
ID = 8600

[State -2, RemoveExplod];Shinkuu Hadouken
type = RemoveExplod
trigger1 = StateNo != 3000
trigger1 = StateNo != 3050
ID = 200

;---------------------------------------
; AttackMulSet (Combos take less damage)
;---------------------------------------

[State -2, AttackMulSet 1]
type = AttackMulSet
triggerall = Var(10) != 1
trigger1 = Var(17) <= 2
value = 1

[State -2, AttackMulSet 2]
type = AttackMulSet
triggerall = Var(10) != 1
trigger1 = Var(17) = [3,6]
value = 0.8

[State -2, AttackMulSet 3]
type = AttackMulSet
triggerall = Var(10) != 1
trigger1 = Var(17) = [7,10]
value = 0.6

[State -2, AttackMulSet 4]
type = AttackMulSet
triggerall = Var(10) != 1
trigger1 = Var(17) = [11,14]
value = 0.4

[State -2, AttackMulSet 5]
type = AttackMulSet
triggerall = Var(10) != 1
trigger1 = Var(17) = [15,18]
value = 0.2

[State -2, AttackMulSet 6]
type = AttackMulSet
triggerall = Var(10) != 1
trigger1 = Var(17) >= 19
value = 0.1

[State -2, CC AttackMulSet 1]
type = AttackMulSet
triggerall = Var(10) = 1
trigger1 = Var(17) <= 8
value = 1

[State -2, CC AttackMulSet 2]
type = AttackMulSet
triggerall = Var(10) = 1
trigger1 = Var(17) = [9,15]
value = 0.8

[State -2, CC AttackMulSet 3]
type = AttackMulSet
triggerall = Var(10) = 1
trigger1 = Var(17) = [16,22]
value = 0.6

[State -2, CC AttackMulSet 4]
type = AttackMulSet
triggerall = Var(10) = 1
trigger1 = Var(17) = [23,27]
value = 0.6

[State -2, CC AttackMulSet 5]
type = AttackMulSet
triggerall = Var(10) = 1
trigger1 = Var(17) >= 28
value = 0.4

;---------------------------------------
; Kamek's Combo Ranking
;---------------------------------------

[State -2, Set Up For Count]
type = VarSet
triggerall = StateNo != [3000,3900]
trigger1 = P2MoveType = H
trigger1 = Var(15) = 0
v = 15
value = 1

[State -2, Keep Track Of Hit Count]
type = VarSet
triggerall = StateNo != [3000,3900]
trigger1 = HitCount > 0
trigger1 = Var(15) != 0
v = 16
value = HitCount

[State -2, Add To Total Hit Count]
type = VarSet
triggerall = Var(15) != 0
triggerall = StateNo != [3000,3900]
trigger1 = HitCount = 0
trigger2 = P2MoveType != H
v = 17
value = Var(17) + Var(16)

[State -2, Add Helper Hits To Total Hit Count]
type = VarSet
triggerall = Var(15) != 0
trigger1 = Var(19) != 0
trigger2 = p2movetype != H
v = 17
value = Var(17) + Var(19)

[State -2, Keep Track of Helper Hit Count]
type = VarSet
trigger1 = Var(19) != 0
trigger1 = Var(15) != 0
v = 19
value = 0

[State -2, Projectile Hits]
type = VarSet
triggerall = Var(15) != 0
trigger1 = ProjHit = 1
v = 17
value = Var(17) + 1

[State -2, Reset Current Hit Count]
type = VarSet
trigger1 = HitCount = 0
trigger1 = Var(15) != 0
v = 16
value = 0

[State -2, Combo Is Finished]
type = VarSet
trigger1 = p2movetype != H
trigger1 = Var(15) != 0
v = 16
value = 0

[State -2, Reset]
type = VarSet
triggerall = Var(15) != 0
trigger1 = p2movetype != H
v = 15
value = 0

[State -2, Reset]
type = VarSet
trigger1 = NumHelper(9990) = 0
trigger1 = Var(15) = 0
trigger1 = Var(17) > 0
v = 17
value = 0

;---------------------------------------
; Parrying
;---------------------------------------

;-| Standing |--------------------------
[State -2, VarSet]
type = VarSet
trigger1 = Command != "holdfwd"
v = 6
value = 0

[State - 2, VarAdd]
type = VarAdd
trigger1 = Command = "holdfwd"
v = 6
value = 1
persistent = 1
ignorehitpause = 1

[State -2, VarSet 2]
type = VarSet
trigger1 = (StateNo != 20) && (StateNo != 0) && (StateNo != 960)
v = 5
value = 0

[State -2, HitOverride 1]
type = HitOverride
triggerall = Var(5) = 1
trigger1 = PalNo > 6
slot = 0
time = 5
attr = S, NA, SA, HA, NP, SP, HP
stateno = 960

;-| Crouching |-------------------------
[State -2, VarSet 1]
type = VarSet
trigger1 = StateNo = 10
v = 7
value = 1

[State -2, VarSet 2]
type = VarSet
trigger1 = (StateNo != 10) && (StateNo != 12)
trigger2 = StateNo = 11
v = 7
value = 0

[State -2, HitOverride 2]
type = HitOverride
triggerall = Var(7) = 1
trigger1 = PalNo > 6
slot = 1
time = 1
attr = C, NA, SA, HA, NP, SP, HP
stateno = 961

;-| Air |-------------------------------
[State -2, VarSet 1]
type = VarSet
triggerall = Var(9) > 0
trigger1 = StateNo = 50
trigger2 = StateNo = 963
trigger3 = StateNo = 999
v = 8
value = 1

[State -2, VarSet 2]
type = VarSet
trigger1 = Var(9) <= 0
trigger2 = StateNo != 50
trigger2 = StateNo != 963
trigger2 = StateNo != 999
v = 8
value = 0

[State -2, VarAdd]
type = VarAdd
trigger1 = 1
trigger1 = Var(9) > 0
v = 9
value = -1

[State -2, VarSet]
type = VarSet
triggerall = Command = "tapfwd"
triggerall = Command != "FF"
trigger1 = StateNo = 50
trigger2 = StateNo = 963
trigger3 = StateNo = 999
v = 9
value = 8

[State -2, HitOverride 3]
type = HitOverride
triggerall = Var(8) = 1
trigger1 = PalNo > 6
slot = 2
time = 1
attr = A, NA, SA, HA, NP, SP, HP
stateno = 962

;---------------------------------------

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 0,1

[State -3, Landing Explod]
type = Explod
anim = 8000
triggerall = Time = 1
trigger1 = stateno = 52
postype = P1
pos = 0,2
ownpal = 1

[State -3, Explod 2];energy wave
type = Explod
anim = 8001
triggerall = (GameTime%50) = 0
triggerall = RoundState = 2
trigger1 = statetype != A
trigger1 = statetype != C
ID = 8001
postype = P1
pos = 0,0
ownpal = 1
persistent = 0

[State -3, Energy 1 Explod];emitting electricity
type = Explod
anim = 8002
triggerall = (GameTime%120) = 0
triggerall = RoundState = 2
trigger1 = statetype = S
trigger1 = statetype != A
trigger1 = movetype != H
ID = 8002
postype = P1
pos = 0,0
ownpal = 1
sprpriority = 3
bindtime = -1
persistent = 0

[State -3, Energy 2 Explod];emitting electricity crouching
type = Explod
anim = 8003
triggerall = (GameTime%120) = 0
triggerall = RoundState = 2
triggerall = statetype = C
trigger1 = statetype != A
trigger1 = movetype != H
ID = 8002
postype = P1
pos = 0,-4
ownpal = 1
sprpriority = 3
bindtime = -1
persistent = 0

[State -3, Remove Explod];remove emitting electricity
type = RemoveExplod
ID = 8002
trigger1 = statetype = A
trigger2 = movetype = H
trigger3 = RoundState = 4
trigger4 = stateno = [3000,3910]

[State -3, Remove Explod2];remove energy wave
type = RemoveExplod
ID = 8001
trigger1 = stateno = [3000,3910]

[State -3, PlaySnd];emitting electricity sound
type = PlaySnd
triggerall = (GameTime%120) = 0
triggerall = RoundState = 2
triggerall = stateno != 3000
trigger1 = statetype != A
trigger1 = movetype != H
