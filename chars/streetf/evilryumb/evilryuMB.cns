;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, VarSet 1]
type = VarSet
triggerall = Var(5) = 1
triggerall = Var(6) <= 2
trigger1 = Time = 0
trigger2 = Time <= 5
v = 5
value = 1

[State 0, VarSet 2]
type = VarSet
trigger1 = Time > 4
trigger2 = Var(5) != 1
v = 5
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = (ifelse (var(10) = 1, (const(velocity.walk.fwd.x) * 1.6), (const(velocity.walk.fwd.x))))

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = (ifelse (var(10) = 1, (const(velocity.walk.back.x) * 1.6), (const(velocity.walk.back.x))))

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

[State 20, VarSet 1]
type = VarSet
triggerall = Command = "holdfwd"
triggerall = Var(6) <= 5
trigger1 = Time = 0
trigger2 = Time <= 5
v = 5
value = 1

[State 20, VarSet 1a]
type = VarSet
trigger1 = Command = "FF"
v = 5
value = 1

[State 20, VarSet 2]
type = VarSet
trigger1 = Command != "holdfwd"
trigger2 = Time > 5
v = 5
value = 0

;---------------------------------------------------------------------------
