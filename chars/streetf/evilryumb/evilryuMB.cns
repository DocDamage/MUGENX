[State -3, VarSet];Variable Shinkuu Hadouken
type = VarSet
trigger1 = StateNo = 0
trigger2 = StateNo = 3051
trigger3 = StateNo = 3069
v = 11
value = 0

[State -3, VarAdd]
type = VarAdd
triggerall = Time >= 0
trigger1 = StateNo = 3070
trigger2 = StateNo = 3071
trigger3 = StateNo = 3072
trigger4 = StateNo = 3073
trigger5 = StateNo = 3074
