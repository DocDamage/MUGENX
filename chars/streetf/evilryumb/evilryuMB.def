; Definition file for Evil Ryu by MystikBlaze
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Evil Ryu"           ;Name of character
displayname = "Evil Ryu"    ;Name of character to display
versiondate = 07,21,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "MystikBlaze"      ;Character author name
pal.defaults = 4,5,6,1      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = evilryumb.cmd     ;Command set
cns     = evilryumb.cns     ;Constants
st      = evilryumb.cns     ;States
stcommon = common1.cns      ;Common states
sprite  = evilryumb.sff     ;Sprite
anim    = evilryumb.air     ;Animation
sound   = evilryumb.snd     ;Sound
pal1    = evilryu04.act     ;Palettes (can have up to 12)
pal2    = evilryu05.act
pal3    = evilryu06.act
pal4    = evilryu01.act
pal5    = evilryu02.act
pal6    = evilryu03.act
pal7    = evilryu10.act
pal8    = evilryu11.act
pal9    = evilryu12.act
pal10    = evilryu07.act
pal11    = evilryu08.act
pal12    = evilryu09.act

; Arcade mode
[Arcade]
;intro.storyboard = intro.def
ending.storyboard = ending.def