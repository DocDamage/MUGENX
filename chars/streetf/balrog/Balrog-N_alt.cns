movetype= A
physics = S
juggle  = 2
velset = 0,0
ctrl = 0
anim = 200
poweradd = 0

[State 200,3]
type = HitDef
trigger1 = Time = 0
attr = S, NA
damage    = Floor(35 * IfElse(Var(31) = 0,1,IfElse(Var(31) = -1,1.2,0.8)))
animtype = Light
getpower = IfElse(Var(31) = 0,21,21)
givepower = IfElse(Var(31) = 0,5,5)
guardflag = M
hitflag = MAF
priority = 3, Hit
pausetime = 10,10
numhits = 1
sparkno = S2100
guard.sparkno = S2200
sparkxy = -10,-76
hitsound = S300, 3
guardsound = S0, 0
ground.type = High
ground.slidetime = 6
ground.hittime  = 12
ground.velocity = -4.5
air.velocity = -2.3,-5.5

[State 200,4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

