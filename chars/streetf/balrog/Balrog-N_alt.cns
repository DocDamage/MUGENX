;=====================================================================
;  CNS File For "Balrog"                                Made By M.M.R.
;                                       Ver. 0.9           2001.Nov.19
;=====================================================================

;---------------------------------------------------------------------
; 変数表
;	Var(1)	: 各種ヒット判定
;	Var(2)	: 地上受け身継続入力フラグ
;	Var(3)	: ＲＣＦヒットフラグ
;	Var(4)	: ＳＨＣ弱～強判別フラグ
;	Var(5)	: ＲＩＤＬｖ１～３判別フラグ
;	Var(25)	: スーパーコンボフィニッシュフラグ
;	Var(26)	: 大ジャンプフラグ
;	Var(27) : 大ジャンプ中のレバー入力管理
;	Var(28) : 大ジャンプフラグ２
;	Var(29) : ＣＰＵ専用乱数
;	Var(30) : ＣＰＵ専用フラグ
;	Var(31) : ＩＳＭ設定
;---------------------------------------------------------------------

;---------------------------------------------------------------------
; 基本設定
[Data]
life = 1000          ; 体力ゲージ、上限値（デフォルト：1000）
power = 3000	     ; パワーゲージ、デフォルト：1000
attack = 100         ; 攻撃力（％）
defence = 100        ; 防御力（％）
fall.defence_up = 50 ; 空中コンボ修正率（％）
liedown.time = 45    ; ダウン時間
airjuggle = 15       ; 空中コンボ
sparkno = 0          ; 初期ヒットスパーク番号
guard.sparkno = 40   ; 初期ガードスパーク番号
KO.echo = 0          ; ＫＯボイスエコー（0:OFF、1:ON）
volume = -5          ; キャラボイスボリューム値

[Size]
xscale = 1           ; 水平サイズ倍率
yscale = 1           ; 垂直サイズ倍率
ground.back = 25     ; キャラ幅（地上、後ろ側）
ground.front = 20    ; キャラ幅（地上、前側）
air.back = 18        ; キャラ幅（空中、後ろ側）
air.front = 18       ; キャラ幅（空中、前側）
z.width = 10         ; キャラ幅（ｚ軸）
height = 50	     ; キャラの高さ（ジャンプで飛び越せる高さ）
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = 4,-94     ; 頭部座標
mid.pos = -14,-67    ; 体中心部座標
shadowoffset = 2     ; キャラの影・オフセット値

[Velocity]
walk.fwd  = 4.10      ; 前進速度
walk.back = -3.30     ; 後退速度
run.fwd  = 5.50, 0    ; 前ダッシュ速度（y<0の場合、ホップステップ）
run.back = -4.80, 0   ; バックステップ速度（y=0の場合、走り）
jump.neu = 0,-11.5     ; 垂直ジャンプ速度
jump.fwd = 4.30      ; 前方ジャンプ速度
jump.back = -3.80    ; 後方ジャンプ速度
;runjump.back = -2.55,-8.1 ; 後方ジャンプ速度（ダッシュ中）
;runjump.fwd = 3.6,-9.0      ; 前方ジャンプ速度（ダッシュ中）
;airjump.neu = 0,-9.3      ; 空中垂直ジャンプ速度
;airjump.back = -2.55,-8.1 ; 空中後方ジャンプ速度
;airjump.fwd = 2.5,-8.1    ; 空中前方ジャンプ速度

[Movement]
airjump.num = 0       ; 空中ジャンプ回数
;airjump.height = 35  ; 空中ジャンプ最低高度
yaccel = .60          ; キャラ重力加速度
stand.friction = .85  ; 摩擦係数（立ち状態）
crouch.friction = .82 ; 摩擦係数（しゃがみ状態）

;=====================================================================
; Definition of the Basic Action
;=====================================================================

;=====================================================================
; Definition of the Win/Lose/Intro Pause
;=====================================================================

;---------------------------------------------------------------------
; 時間切れ負け
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170,1]
type = NotHitBy
trigger1 = 1
value = SCA

[State 170,12]
type = AssertSpecial
trigger1 = Time = [0,140]
flag = RoundNotOver

;---------------------------------------------------------------------
; 時間切れ引き分け
[Statedef 175]
type = S
ctrl = 0
anim = 175
velset = 0,0

[State 170,1]
type = NotHitBy
trigger1 = 1
value = SCA

[State 170,12]
type = AssertSpecial
trigger1 = Time = [0,90]
flag = RoundNotOver

;---------------------------------------------------------------------
; 勝利
;------------------------ スーパーコンボフィニッシュ時の保留
[Statedef 180]
type = S
movetype = I
physics = N
velset = 0, 0
ctrl = 0

[State 180,VarRandom]
type = VarRandom
trigger1 = Time = 0
v = 1
range = 1,6

[State 180,NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 180,ChangeState]
type = ChangeState
trigger1 = !NumExplod(2600) && !NumExplod(2610) && !NumExplod(2620)
value = 181

;------------------------ 分岐
[Statedef 181]
type = S
movetype = I
physics = S
velset = 0, 0

[State 181,Muteki]
type = NotHitBy
trigger1 = 1
value = SCA

[State 180,0]
type = ChangeState
triggerall = Time = 0
trigger1 = Command = "xx" || Command = "bb" || Command = "cc"
value = 4200

[State 180,0]
type = ChangeState
triggerall = Time = 0
trigger1 = Command = "yy" || Command = "zz"
value = 4205

[State 180,0]
type = ChangeState
triggerall = Time = 0
trigger1 = Command = "aa"
value = 4210

[State 180,ChangeState]
type = ChangeState
triggerall = Time = 1
trigger1 = Var(1) = 1 || Var(1) = 5 || Var(1) = 6
value = 4200

[State 180,ChangeState]
type = ChangeState
triggerall = Time = 1
trigger1 = Var(1) = 2 || Var(1) = 3
value = 4205

[State 180,ChangeState]
type = ChangeState
trigger1 = Var(1) = 4
value = 4210

;---------------------------------------------------------------------
; 勝利１
[Statedef 4200]
type = S
movetype = I
physics = S
anim = 4200
velset = 0, 0
ctrl = 0

[State 4200,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 4
value = 300, 0

[State 4200,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 5
value = 180, 1

[State 4200,AssertSpecial]
type = AssertSpecial
trigger1 = Time = [0,120]
flag = RoundNotOver

;---------------------------------------------------------------------
; 勝利２
[Statedef 4205]
type = S
movetype = I
physics = S
anim = 4210
velset = 0, 0
ctrl = 0

[State 4200,AssertSpecial]
type = AssertSpecial
trigger1 = Time = [0,100]
flag = RoundNotOver

;---------------------------------------------------------------------
; 勝利４
[Statedef 4210]
type = S
movetype = I
physics = S
anim = 4220
velset = 0, 0
ctrl = 0

[State 4210,StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 2
statetype = A
physics = N

[State 4210,VelSet]
type = VelSet
trigger1 = AnimElem = 2
y = -9.6

[State 4210,Gravity]
type = Gravity
trigger1 = AnimElem = 2, > 0

[State 4210,PosAdd]
type = PosAdd
trigger1 = AnimElem = 8
y = -10

[State 4210,ChangeState]
type = ChangeState
trigger1 = AnimElem = 2, > 0
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 4215

[State 4200,AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = RoundNotOver

;------------------------ 
[Statedef 4215]
type = S
movetype = I
physics = S
anim = 4225
velset = 0, 0
ctrl = 0

[State 4215,PosSet]
type = PosSet
trigger1 = Time = 0
y = 0

[State 4215,PlaySnd]
type = PlaySnd
trigger1 = Time = 0
value = 47, 0

[State 4215,PlaySnd]
type = PlaySnd
trigger1 = Time = 10
value = 180, 0

[State 4200,AssertSpecial]
type = AssertSpecial
trigger1 = Time = [0,80]
flag = RoundNotOver

;---------------------------------------------------------------------
; イントロ１
[Statedef 191]
type = S
ctrl = 0
anim = 191
velset = 0,0,0

[State 191,AssertSpecial]
type = AssertSpecial
trigger1 = Time = [0,130]
flag = Intro

[State 191,Explod]
type = Explod
trigger1 = Time = 0
anim = 192
ID = 192
pos = 0,-140
postype = P1
sprpriority = 3
ownpal = 1
vel = 0,1.0

[State 191,Explod]
type = Explod
trigger1 = Time = 56
anim = 193
ID = 193
pos = 0, 0
postype = P1
sprpriority = 3
bindtime = -1
ownpal = 1

[State 191,5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;-------------------------------------------------------------------------------
; 挑発
[Statedef 195]
type = S
movetype = I
physics = S
anim = 195
velset = 0, 0
ctrl = 0
juggle = 0

[State 4200,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 4
value = 300, 0

[State 4200,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 5
value = 180, 1

[State 195,End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

