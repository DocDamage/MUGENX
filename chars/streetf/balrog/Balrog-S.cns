;---------------------------------------------------------------------
; ローリングクリスタルフラッシュ・弱
[Statedef 1000]
type = S
movetype = A
physics = S
anim = 1000
velset = 0, 0
ctrl = 0
poweradd = IfElse(Var(31) = 0,84,147)
juggle = 7

[State 1000,VarSet]
type = VarSet
trigger1 = Time = 0
v = 3
value = 0

[State 1000,StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 2
statetype = A
physics = N

[State 1000,VelSet]
type = VelSet
trigger1 = AnimElem = 2
x = 3.5
y = -6.0

[State 1000,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 2
value = 500, 1
channel = 1

[State 1000,VelAdd]
type = VelAdd
trigger1 = AnimElem = 2, > 0
y = .8

[State 1000,HitDef]
type = HitDef
trigger1 = AnimElem = 2
attr = A, SA
damage    = Floor(21 * IfElse(Var(31) = 0,1,IfElse(Var(31) = -1,1.2,0.8))),Floor(21 * IfElse(Var(31) = 0,0.125,IfElse(Var(31) = -1,0.3,0.05)))
animtype = Hard
getpower = IfElse(Var(31) = 0,21,63)
givepower = IfElse(Var(31) = 0,26,52)
guardflag = M
hitflag = MAF
pausetime = 6,6
sparkno = S2130
guard.sparkno = S2210
sparkxy = 0,-56
hitsound = S200, 6
guardsound = S0, 0
ground.type = Low
ground.slidetime = 7
ground.hittime  = 18
ground.velocity = -8.2
air.velocity = -5.0,-3.5

[State 1000,ChangeState]
type = ChangeState
trigger1 = AnimElem = 2, > 0
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 1010

