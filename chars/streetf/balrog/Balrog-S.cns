;------------------------ 壁ジャンプ
[Statedef 1130]
type = A
movetype = I
physics = N
anim = 1140
velset = Abs((P2Dist X -25) / 40),-12.0

[State 1130,PlaySnd]
type = PlaySnd
trigger1 = Time = 0
value = 47, 0

[State 1130,PosAdd]
type = PosAdd
trigger1 = Time = 0
x = 25
;y = -10

[State 1130,Gravity]
type = Gravity
trigger1 = 1

[State 1130,PlayerPush]
type = PlayerPush
trigger1 = Vel Y < 0
value = 0

[State 1130,PosAdd]
type = PosAdd
trigger1 = Command = "holdfwd" || Command = "holdback"
x = IfElse(Command = "holdfwd",4.0,-4.0)

[State 1130,ChangeState]
type = ChangeState
triggerall = Vel Y > 0
triggerall = !Command = "holddown" && !Command = "holdfwd" && !Command = "holdback"
trigger1 = Command = "x" || Command = "y" || Command = "z"
value = IfElse(Command = "x",1300,IfElse(Command = "y",1330,1360))

[State 1130,ChangeState]
type = ChangeState
triggerall = Vel Y > 0
triggerall = Command = "holddown" || Command = "holdfwd" || Command = "holdback"
trigger1 = Command = "x" || Command = "y" || Command = "z"
value = 1400

[State 1130,ChangeState]
type = ChangeState
trigger1 = Time > 0
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 1140

