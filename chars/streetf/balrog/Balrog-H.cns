;------------------------ 壁ジャンプ
[Statedef 3030]
type = A
movetype = I
physics = N
anim = 1140
velset = Abs((P2Dist X -25) / 40),-12.0

[State 3030,PlaySnd]
type = PlaySnd
trigger1 = Time = 0
value = 47, 0

[State 3030,PosAdd]
type = PosAdd
trigger1 = Time = 0
x = 25
;y = -10

[State 3030,Gravity]
type = Gravity
trigger1 = 1

[State 3030,PlayerPush]
type = PlayerPush
trigger1 = Vel Y < 0
value = 0

[State 3030,PosAdd]
type = PosAdd
trigger1 = Command = "holdfwd" || Command = "holdback"
x = IfElse(Command = "holdfwd",4.0,-4.0)

[State 3030,ChangeState]
type = ChangeState
triggerall = Vel Y > 0
triggerall = !Command = "holddown" && !Command = "holdfwd" && !Command = "holdback"
trigger1 = Command = "x" || Command = "y" || Command = "z"
value = IfElse(Var(5) = 1,3050,IfElse(Var(5) = 2,3110,3210))

[State 3030,ChangeState]
type = ChangeState
triggerall = Vel Y > 0
triggerall = Command = "holddown" || Command = "holdfwd" || Command = "holdback"
trigger1 = Command = "x" || Command = "y" || Command = "z"
value = IfElse(Var(5) = 1,3060,IfElse(Var(5) = 2,3120,3220))

[State 3030,ChangeState]
type = ChangeState
trigger1 = Time > 0
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 3040

