;---------------------------------------------------------------------
; ローリングイズナドロップ					Ｌｖ１
;------------------------ 
[Statedef 3000]
type = S
movetype = A
physics = S
anim = 1100
velset = 0, 0
ctrl = 0
poweradd = 0
juggle = 8

[State 3000,VarSet]
type = VarSet
trigger1 = Time = 0
v = 5
value = 1

[State 3000,PlaySnd]
type = PlaySnd
trigger1 = AnimTime = 0
value = 500, 5

[State 3000,ChangeState]
type = ChangeState
triggerall = AnimTime = 0
trigger1 = Command = "holdupback"
trigger2 = !Command = "holdupback" && !Command = "holdupfwd" && BackEdgeDist < 160
value = 3010

[State 3000,ChangeState]
type = ChangeState
triggerall = AnimTime = 0
trigger1 = Command = "holdupfwd"
trigger2 = !Command = "holdupback" && !Command = "holdupfwd" && BackEdgeDist >= 160
value = 3015

