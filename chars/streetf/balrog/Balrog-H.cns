; フライングバルセロナスペシャル
[Statedef 3050]
type = A
movetype = A
physics = N
anim = 3000
ctrl = 0
poweradd = 0

[State 3050,PlaySnd]
type = PlaySnd
trigger1 = Time = 0
value = 500, 6

[State 1300,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 2
value = 300, 2

[State 3050,Gravity]
type = Gravity
trigger1 = 1

[State 3050,PosAdd]
type = PosAdd
trigger1 = Command = "holdfwd" || Command = "holdback"
x = IfElse(Command = "holdfwd",4.0,-4.0)

[State 3050,HitDef]
type = HitDef
trigger1 = AnimElem = 2
attr = A, HA
damage    = Floor(112 * IfElse(Var(31) = 0,1,IfElse(Var(31) = -1,1.2,0.8))),Floor(112 * IfElse(Var(31) = 0,0.125,IfElse(Var(31) = -1,0.3,0.05)))
animtype = Hard
getpower = 0
givepower = IfElse(Var(31) = 0,42,63)
guardflag = H
hitflag = MAF
pausetime = 10,12
sparkno = S2140
guard.sparkno = S2210
sparkxy = -10,-24
hitsound = S300, 5
guardsound = S0, 0
ground.type = High
ground.slidetime = 7
ground.hittime  = 15
ground.velocity = IfElse(P2Dist X < -5,3.5,-3.5),-5.8
air.velocity = IfElse(P2Dist X < -5,3.5,-3.5),-5.8
fall = 1
fall.recover = 0
air.recover = 0
recover = 0

[State 3050,HitDef]
type = HitDef
trigger1 = AnimElem = 3
attr = A, HA
damage    = Floor(119 * IfElse(Var(31) = 0,1,IfElse(Var(31) = -1,1.2,0.8))),Floor(119 * IfElse(Var(31) = 0,0.125,IfElse(Var(31) = -1,0.3,0.05)))
animtype = Hard
getpower = 0
givepower = IfElse(Var(31) = 0,42,63)
guardflag = H
hitflag = MAF
pausetime = 10,12
sparkno = S2140
guard.sparkno = S2210
sparkxy = -10,-63
hitsound = S300, 5
guardsound = S0, 0
ground.type = High
ground.slidetime = 7
ground.hittime  = 15
ground.velocity = IfElse(P2Dist X < -5,3.5,-3.5),-5.8
air.velocity = IfElse(P2Dist X < -5,3.5,-3.5),-5.8
fall = 1
fall.recover = 0
air.recover = 0
recover = 0

[State 3050,PlaySnd]
type = PlaySnd
trigger1 = NumExplod(2600) = 1
persistent = 0
value = 2000, 3
ignorehitpause = 1

[State 3050,End]
type = ChangeState
trigger1 = Time > 0
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 3040

