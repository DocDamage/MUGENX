;---------------------------------------------------------------------------
; Stun mode

[State -2] ;initialise
type = VarSet
trigger1 = RoundState = 0
var(5) = 0

[State -2] ;limite inf
type = VarSet
trigger1 = Var(5) <= 0
var(5) = 0

[State -2] ;limite sup
type = VarSet
trigger1 = Var(5) >= 100
var(5) = 100

[State -2] ;decompte
type = VarAdd
trigger1 = (GameTime%30)=0
trigger1 = var(5) > 0 && var(5) != 100
var(5) = -1

[State -2] ;degat coup 1
type = VarAdd
trigger1 = movetype = H
trigger1 = StateNo >= 5000
trigger1 = time = 0
trigger1 = GetHitVar(damage) > 0
trigger1 = GetHitVar(damage) < 32
var(5) = 2

[State -2] ;degat coup 2
type = VarAdd
trigger1 = movetype = H
trigger1 = StateNo >= 5000
trigger1 = time = 0
trigger1 = GetHitVar(damage) >= 32
trigger1 = GetHitVar(damage) < 80
var(5) = 5

[State -2] ;degat coup 3
