;===========================================================================
[Statedef -2]
;===========================================================================
; Parry mode

[State -2]; vars a afficher
type = DisplayToClipboard
trigger1 = 1
text = "Parry High=%d  Red Parry=%d  Stun=%d  IA=%d"
params = var(10), var(13), var(5), var(7)
ignorehitpause = 1

[State -2]
type = VarAdd
trigger1 = Var(13) >= 0
var(13) = -1

[State -2]
type = VarAdd
trigger1 = Var(10) != 0
var(10) = -1

[State -2]
type = VarAdd
trigger1 = Var(11) != 0
var(11) = -1

[State -2]
type = VarAdd
trigger1 = Var(12) != 0
var(12) = -1

[State -2]
type = VarSet
triggerall = Var(10) = 0
trigger1 = command = "parryH" && command != "holddown" && Command != "holdup"
trigger1 = statetype != A
