value = 120 + (statetype = C) + (statetype = A)*2

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = P2StateType != A
value = 123 - (statetype = C)*2 - (statetype = A)

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

