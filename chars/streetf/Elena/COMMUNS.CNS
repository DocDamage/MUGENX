triggerall = time = 0
trigger1 = Prevstateno = 811 || Prevstateno = 5120 || Prevstateno = 5125 || Prevstateno = 30
value = 0
elem = 52

[State 0, 2] 
type = ChangeAnim
triggerall = time = 0
trigger1 = Prevstateno = 192 || Prevstateno = 1810
value = 0
elem = 57

[State 0, 3]
type = PlaySnd
trigger1 = Anim = 5
trigger1 = AnimElem = 5
