;---------------------------------------------------------------------------
; Stand Hit shake
[Statedef 5000]
type    = S
movetype= H
physics = N
velset = 0,0

[State 5000, 1] ; Cheap dead
type = ChangeState
trigger1 = Life <= 0
trigger1 = Prevstateno = 130 || Prevstateno = 120 || Prevstateno = 151
trigger2 = Life <= 0
trigger2 = GetHitVar(xvel) <= 3  && GetHitVar(yvel) = 0
value = 5600

[State 5000, 3] ; sound when dead
type = Playsnd
trigger1 = Life <= 0
trigger1 = time = 10
value = 13, 5

[State 5000, 4] ; Anim for Light, Medium, Hard
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),5000,5010) + GetHitVar(animtype)

[State 5000, 4] ; Anim for Back
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = 3
value = 5041

[State 5000, 4] ; Anim for Up, Diagup
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) 
value = 5027 + GetHitVar(animtype) 

[State 5000, 5] ; Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 5000, 6]
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 && GetHitVar(fall)
trigger2 = Pos Y != 0
type = A

[State 5000, 7]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0
value = 5001

[State 5000, 8]
type = ChangeState
trigger1 = HitShakeOver
value = 5030

[State 5000, 9]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 5000, 9]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5000, 9]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

