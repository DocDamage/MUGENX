
; Elena's common states file

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S

[State 0, 0]
type = VelSet
trigger1 = Time = 0
y = 0

[State 5000, 2] ; Go to Stun
type = ChangeState
trigger1= MoveType != H && var(5) = 100
trigger1 = Stateno != 5300
value = 5300

[State 0, 1]
type = Width
trigger1 = AnimElem = 1, >= 0
value = 15,10

[State 0, 1]
type = Width
trigger1 = AnimElem = 22, >= 0
value = 5,10

[State 0, 0]
type = PosAdd
trigger1 = AnimElem = 38 || AnimElem = 39 || AnimElem = 40 || AnimElem = 41
trigger2 = AnimElem = 42 || AnimElem = 43 || AnimElem = 44 
x = -3

[State 0, 0]
type = PosAdd
trigger1 = AnimElem = 53 || AnimElem = 54 || AnimElem = 55
trigger2 = AnimElem = 56 || AnimElem = 57 || AnimElem = 58
x = 3

[State 0, 2] ; se retourner
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 0

[State 0, 2] 
type = ChangeAnim
triggerall = time = 0
trigger1 = Prevstateno = 250 || Prevstateno = 280 || Prevstateno = 801
value = 0
elem = 3

[State 0, 2] 
type = ChangeAnim
triggerall = time = 0
trigger1 = Prevstateno = 195
trigger2 = Prevstateno = 1400 || Prevstateno = 1401 || Prevstateno = 1402
trigger3 = Prevstateno = 1410 || Prevstateno = 1450 || Prevstateno = 1451
value = 0
elem = 5

[State 0, 2] 
type = ChangeAnim
triggerall = time = 0
trigger1 = Prevstateno = 3200
value = 0
elem = 23

[State 0, 2] 
type = ChangeAnim
triggerall = time = 0
trigger1 = Prevstateno = 230
value = 0
elem = 25

[State 0, 2] 
type = ChangeAnim
triggerall = time = 0
trigger1 = Prevstateno = 1610
value = 0
elem = 31

[State 0, 2] 
type = ChangeAnim
triggerall = time = 0
trigger1 = Prevstateno = 240
value = 0
elem = 35

[State 0, 2] 
type = ChangeAnim
triggerall = time = 0
trigger1 = Prevstateno = 1202 || Prevstateno = 3402 || Prevstateno = 3403
trigger2 = Prevstateno = 101 || Prevstateno = 105 || Prevstateno = 260
trigger3 = Prevstateno = 290 || Prevstateno = 5300
value = 0
elem = 37

[State 0, 2] 
