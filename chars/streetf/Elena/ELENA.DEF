
; Elena's definition files

;-----------------------------------------------------------------------------------------------
; Player information
[Info]
name = "SF3 Elena"          ;Nom du perso
displayname = "Elena"       ;Nom affiche du perso
versiondate = 25,12,2005    ;Version du perso
mugenversion = 04,14,2001   ;Version de MUGEN
author = "Phirmost"         ;Nom de l'auteur du perso
pal.defaults = 4,12,14,11   ;Ordre de preference de PAL par defaut

;-----------------------------------------------------------------------------------------------
; Files for the player
[Files]
cmd      = Command.cmd    ;Command set
cns      = Constant.cns   ;Constants
st       = Moves.cns      ;Other states
st2      = Coups.cns      ;Standard moves
st3      = Supers.cns     ;Super moves
st4      = Hypers.cns     ;Hyper moves
stcommon = Communs.cns    ;Common states
sprite   = Elena.sff      ;Sprites
anim     = Elena.air      ;Animations
sound    = Elena.snd      ;Sounds

;-----------------------------------------------------------------------------------------------
; Palettes for player (12 possibles)
pal1     = el2.act  
pal2     = blue.act ;el11.act
pal3     = white.act ;el5.act
pal4     = el0.act
pal5     = el9.act
pal6     = el8.act
pal7     = el3.act
pal8     = el7.act
pal9     = el4.act
pal10    = el6.act
pal11    = el1.act
pal12    = el10.act
pal13    = el11.act
pal14    = el12.act

;-----------------------------------------------------------------------------------------------
; Arcade mode
[Arcade]
intro.storyboard = 
ending.storyboard = Elenaend.def ;(from Joseph O)
