;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------



;---------------------------------------------------------------------------
[Statedef -2]

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;구르기낙법

[State -2, c]
type = CtrlSet
triggerall = alive
trigger1 = var(10) = 1
trigger2 = var(10) = 2
value = 0

[State -2, v]
type = varset
trigger1 = Pos Y < -1
trigger1 = command = "recovery2" && command = "holdback"
trigger1 = Stateno = [5000,5071]
var(10) = 2

[State -2, v]
type = varset
trigger1 = Pos Y < -1
trigger1 = command = "recovery2" && command != "holdback"
trigger1 = Stateno = [5000,5071]
var(10) = 1

[State -2, c]
type = ChangeState
triggerall = alive
trigger1 = Anim != 998
trigger1 = Pos Y >= -2
trigger1 = var(10) = 2
value = 998

[State -2, c]
type = ChangeState
triggerall = alive
trigger1 = Anim != 999
trigger1 = Pos Y >= -2
trigger1 = var(10) = 1
value = 999


;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------



[State -2, 3]
type = envshake
triggerall = win = 1
triggerall = movehit = 1
trigger1 = stateno = 1999
trigger2 = stateno = 2000
trigger3 = stateno = 2100
trigger4 = stateno = 3000
time = 0

[State -2, 피날레]
type = explod
triggerall = win = 1
triggerall = movehit = 1
trigger1 = stateno = 1999
trigger2 = stateno = 2000
trigger3 = stateno = 2100
trigger4 = stateno = 3000
postype = back
sprpriority = -1
bindtime = -1
anim = 7000
pos = -32,260
scale = 1, 1.3

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -2, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0


[State -2, cock]
type = RemoveExplod
trigger1 = stateno != 3000
id = 3000

;--------------------------------------
; Sound when hitted(light hitted)
[State -2, light sound]
type = PlaySnd
triggerall = Time = 1
triggerall = random < 250
triggerall = Alive
tirggerall = stateno = 5000
trigger1 = anim = 5000
trigger2 = anim = 5010
trigger3 = anim = 5020
value = S5000,0

; Sound when hitted(middle hitted)
[State -2, middle sound]
type = PlaySnd
triggerall = Time = 1
triggerall = random < 200
triggerall = Alive
tirggerall = stateno = 5000
trigger1 = anim = 5001
trigger2 = anim = 5011
trigger3 = anim = 5021
value = S5000,1

; Sound when hitted(hard hitted)
[State -2, hard sound]
type = PlaySnd
triggerall = Time = 1
triggerall = random < 200
triggerall = Alive
tirggerall = stateno = 5000
trigger1 = anim = 5002
trigger2 = anim = 5012
trigger3 = anim = 5022
value = S5000,1

; Sound when hitted(tripped)
[State -2, hard sound]
type = PlaySnd
triggerall = Time = 1
triggerall = random < 200
triggerall = Alive
tirggerall = stateno = 5000
trigger1 = anim = 5070
value = S5000,2

