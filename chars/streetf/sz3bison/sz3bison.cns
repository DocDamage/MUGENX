; Jump Up
[Statedef 50]
type    = A
physics = A


[State 44, S]
type = PlaySnd
trigger1 = Time = 0
value = 1, 0

[State 44, AfterImage]
type = AfterImage
trigger1 = Time = 0
trigger1 = sysvar(3) = 1
time = 10
PalBright = 1,1,1
PalContrast = 128,128,128
PalAdd = 0,0,0
PalMul = 1,1,1
length = 9
trans = add1
FrameGap = 3

[State 44, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 44, 2A]
type = ChangeAnim
trigger1 = Time = 0 
trigger1 = sysvar(2) = 1
persistent = 0
value = Anim + 10

[State 44, 1];대점프
type = VarSet
trigger1 = Time = 0
sysvar(3) = 0

[State 44, 1];소점프
type = VarSet
trigger1 = Time = 0
sysvar(2) = 0

[State 44, 1];노말점프
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 44, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3



