;---------------------------------------------------------------------------
; RUNING_FWD
[Statedef 100]
type    = S
physics = S
anim = 103
velset = 0,0
sprpriority = 1


[State 100, S]
type = PlaySnd
trigger1 = AnimElem = 3
trigger2 = AnimElem = 6
value = 1, 3
channel = 10


[State 100,0]
type = MakeDust
trigger1 = Time >= 0
pos = -30, 0


[State 100, 1]
type = VelSet
trigger1 = AnimElemTime(9) >= 0
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = command != "holdfwd"
value = 0




;---------------------------------------------------------------------
;돌격 대쉬

[Statedef 108]
type = S
movetype = I
physics = S
anim = 100
ctrl = 0
velset = 6.5,-3.8

[State 100,StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 2
statetype = A
physics = N


[State 100,2]
type = MakeDust
trigger1 = AnimElem = 1
pos = -30, 0


[State 100,VelAdd]
type = VelAdd
trigger1 = AnimElem = 2, > 0
y = .40


[State 100,3]
type = PlaySnd
trigger1 = AnimElem = 2
value = 5, 0

[State 100,4]
type = ChangeState
trigger1 = AnimElem = 2, > 0
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 109

