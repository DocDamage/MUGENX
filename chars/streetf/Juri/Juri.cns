;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]
[State -2]
type = PlaySnd
triggerall = Time = 1
trigger1 = anim = 47
value = s4,4

[State -2]
type = PlaySnd
triggerall = Time = 1
trigger1 = anim = 100
trigger2 = anim = 105
value = s3,6

; Random variable for random sounds
[State -2, 8]
type = VarRandom
triggerall = Time = 1
trigger1 = stateno = 5000
trigger2 = stateno = 5010
v = 7
range = 0,24

; Play "ouch" sound A when hit light or medium
[State -2, 9]
type = PlaySnd
triggerall = Var(7) = [0,4]
triggerall = time = 1
triggerall = stateno = 5000
triggerall = Alive = 1
trigger1 = anim = 5000
trigger2 = anim = 5001
trigger3 = anim = 5010
trigger4 = anim = 5011
value = 9,3

; Play "ouch" sound B when hit light or medium
[State -2, 10]
type = PlaySnd
triggerall = Var(7) = [5,9]
triggerall = time = 1
triggerall = stateno = 5000
triggerall = Alive = 1
trigger1 = anim = 5000
trigger2 = anim = 5001
trigger3 = anim = 5010
trigger4 = anim = 5011
value = 9,1

; Play "ouch" sound A when hit light or medium (in the air)
