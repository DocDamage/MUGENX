;-----------------------------------------------------;
;  AI file for Gill ver. 099B (from streetfighter)    ;
;created by SlayerGatsu since February 2005.          ;
;-----------------------------------------------------;

[statedef -2]

[state -2, Ai recorgnition]
type = varset
trigger1 = command = "AIx" || command = "AIx1" || command = "AIx2" || command = "AIx3" || command = "AIx4" || command = "AIx5" || command = "AIx6" || command = "AIx7" || command = "AIx8" || command = "AIx9"
trigger2 = command = "AIy" || command = "AIy1" || command = "AIy2" || command = "AIy3" || command = "AIy4" || command = "AIy5" || command = "AIy6" || command = "AIy7" || command = "AIy8" || command = "AIy9"
v = 35
value = 2


;-------------------------------------------------
[state -2 Loop preventionA]
type = varset
trigger1 = RoundState = 0 || RoundState = 1 || RoundState = 4
trigger1 = stateno = 6550 || stateno = 6553 || stateno = 6500 || stateno = 6504
trigger1 = stateno = 7000 || stateno = 7001 || stateno = 7002 || stateno = 7003 || stateno = 7004 || stateno = 7005
v = 36
value = 5

[state -2 Loop preventionB1]
type = varset
trigger1 = stateno = 0 && Time = 35
v = 36
value = 1

[state -2 Loop preventionB2]
type = varset
trigger1 = stateno = 1
trigger1 = Time = 15
v = 36
value = 1
;------------------------------------------------


;-------------------Ai execution Dir-------------
[state -2 seraphick wingsA]
type = changestate
value = 8000
triggerall = facing = 1 && stateno = 0 && (statetype != A || statetype != C || statetype != L)
trigger1 = var(35) = 2 && power = 3000 && life >= 150 && Random <= 199 && roundstate = 2

[state -2 seraphick wingsB]
type = changestate
value = 8001
triggerall = facing = -1 && stateno = 1 && (statetype != A || statetype != C || statetype != L)
trigger1 = var(35) = 2 && power = 3000 && life >= 150 && Random <= 199 && roundstate = 2

[state -2 cometsA]
type = changestate
value = 7500
triggerall = facing = 1 && stateno = 0 && (statetype != A || statetype != C || statetype != L) && roundstate = 2
trigger1 = var(35) = 2 && power >= 2500 && (p2Bodydist X  >= 190 && p2Bodydist X <= 2000) && Random <= 149

