type = changestate
value = 7501
triggerall = facing = -1 && stateno = 1 && (statetype != A || statetype != C || statetype != L) && roundstate = 2
trigger1 = var(35) = 2 && power >= 2500 && (p2Bodydist X  >= 190 && p2Bodydist X <= 200) && Random <= 149

