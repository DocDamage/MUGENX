value = 6553 
triggerall = facing = -1 && stateno = 1 && p2Statetype != A && (statetype != A || statetype != C || statetype != L)
trigger1 = var(35) = 2 && p2bodydist X = 30 && var(36) != 5 && var(36) = 1 && Random <= 399 && roundstate = 2

