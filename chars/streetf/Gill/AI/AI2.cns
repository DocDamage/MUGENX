triggerall = facing = 1 && stateno = 0 && p2Statetype != A && (statetype != A || statetype != C || statetype != L)
trigger1 = var(35) = 2 && p2bodydist X = 30 && var(36) != 5 && var(36) = 1 && Random <= 499 && roundstate = 2

[state -2, Hand GrabB]
