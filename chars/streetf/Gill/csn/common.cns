;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1


[State 100, 1]
type = changestate
trigger1 = facing = -1
value = 101

[State 100, 2]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 3] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 4] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 5]
type = ChangeState
trigger1 = command != "holdfwd"
value = 0

;------------------------Other side!---------------------;
[Statedef 101]
type    = S
physics = S
anim = 101
sprpriority = 1

[State 101, 1]
type = changestate
trigger1 = facing = 1
value = 100

[State 101, 2]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 101, 3] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 101, 4] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 101, 5]
type = ChangeState
trigger1 = command != "holdfwd"
value = 0

;---------------------------------------------------------------------------
; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 2]
type = ChangeAnim
triggerall = facing = 1
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2

[State 120, 2]
type = ChangeAnim
triggerall = facing = -1
trigger1 = Time = 0
value = 110 + (statetype = C) + (statetype = A)*2

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 5]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 120, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 120, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

[State 120, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

;---------------------------------------------------------------------------
; STAND GUARD (guarding)
