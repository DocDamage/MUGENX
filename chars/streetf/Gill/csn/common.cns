trigger1 = anim = [5581,5589]
value = 5610 + (anim % 10)

[State 5610, 2] ;Hit ground anim (normal)
type = ChangeAnim
triggerall = time = 0
triggerall = anim != [5610,5619] ;Not already changed anim
trigger1 = anim != [5661,5669]
trigger2 = !SelfAnimExist(5670 + (anim % 10))
value = 5670

[State 5610, 3] ;Hit ground anim (for hit up)
type = ChangeAnim
triggerall = time = 0
triggerall = anim != [5610,5619] ;Not already changed anim
trigger1 = anim = [5661,5669]
trigger1 = SelfAnimExist(5670 + (anim % 10))
value = 5670 + (anim % 10)

[State 5610, 4]
type = HitFallDamage
trigger1 = Time = 0

[State 5610, 5]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5610, Var] ;Get fall velocity
type = VarSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) != 0
sysvar(1) = floor(vel y)

[State 5610, 6]
type = PlaySnd
trigger1 = Time = 0
trigger1 = !SysVar(0)
value = F7, (sysvar(1) > 5) + (sysvar(1) > 14)

[State 5610, 7]
type = GameMakeAnim
trigger1 = Time = 0
trigger1 = !SysVar(0)
value = 60 + (sysvar(1) > 5) + (sysvar(1) > 14)
pos = 0, 0
under = sysvar(1) <= 14

[State 5610, 8]
type = VelSet
trigger1 = Time = 0
y = 0

[State 5610, 9] ;For hit up type
type = ChangeAnim
persistent = 0
triggerall = anim = [5671,5679]
triggerall = SelfAnimExist(5610 + (anim % 10))
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground anim
value = 5610 + (anim % 10)

[State 5610, 10] ;For normal
type = ChangeAnim
persistent = 0
triggerall = Anim != [5611,5619]
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
value = 5610

[State 5610, 11] ;If just died
type = ChangeState
triggerall = !alive
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
trigger3 = Anim = [5610,5619]
value = 5150

[State 5610, 12]
type = VarSet
trigger1 = SysVar(0)
trigger1 = Time = 0
sysvar(0) = 0

[State 5610, 13] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 5610, 14]
type = ForceFeedback
trigger1 = alive
trigger1 = Time = 0
time = 8
ampl = 240
waveform = sine

[State 5610, 15]
type = ForceFeedback
trigger1 = !alive
trigger1 = Time = 0
ampl = 200, 7, -.467
time = 30
waveform = sine

[State 5610, 16] ;If alive
