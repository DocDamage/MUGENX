trigger1 = AnimTime = 0
value = 1
;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 0, 3]
type = changestate
trigger1 = facing = -1
value = 13

[State 20, 4]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && (Anim != 5 && Anim != 4)
trigger2 = ( Anim = 5 || Anim = 4 ) && AnimTime = 0
value = 20

[State 20, 5]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && (Anim != 5 && Anim != 4)
trigger2 = ( Anim = 5 || Anim = 4 ) && AnimTime = 00
value = 21

;------------------------Other side!---------------------;
[Statedef 13]
type    = S
physics = S
sprpriority = 0

[State 13, 1]
type = VelSet
trigger1 = command = "holdfwd"
trigger2 = facing = 1
x = const(velocity.walk.fwd.x)

[State 13, 2]
type = VelSet
trigger1 = command = "holdback"
trigger2 = facing = 1
x = const(velocity.walk.back.x)

[State 13, 3]
type = changestate
trigger1 = facing = 1
value = 20

[State 13, 4]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 13 && (Anim != 5 && Anim != 4)
trigger2 = ( Anim = 5 || Anim = 4 ) && AnimTime = 0
value = 13

[State 13, 5]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 14 && (Anim != 5 && Anim != 4)
trigger2 = ( Anim = 5 || Anim = 4 ) && AnimTime = 0
value = 14

[State 13, 6]
type = Changestate
trigger1 = vel x > -20
trigger1 = vel x = 0
trigger1 = vel x < 20
value = 0

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = changestate
trigger1 = facing = -1
value = 30

[State 40, 2]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 3]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 4]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 6]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;------------------------Other side!---------------------;
[Statedef 30]
type    = S
physics = S
anim = 30
ctrl = 0
sprpriority = 1

[State 30, 1]
type = changestate
trigger1 = facing = 1
value = 40

[State 30, 2]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 30, 3]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 30, 4]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 30, 5]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 30, 6]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 101
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 30, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 39
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 45, 1]
type = changestate
trigger1 = facing = -1
trigger1 = P2BodyDist X > 0
value = 35

[State 45, 2]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44

[State 45, 3]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41

[State 45, 4]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 5]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 6]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 7]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 8]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

;------------------------Other side!---------------------;
[Statedef 35]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 35, 1]
type = changestate
trigger1 = facing = -1
trigger1 = P2BodyDist X < 0
value = 45

[State 35, 2]
type = ChangeAnim
trigger1 = SelfAnimExist(34)
value = 34

[State 35, 3]
type = ChangeAnim
trigger1 = !SelfAnimExist(34)
value = 31

[State 35, 4]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 35, 5]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 35, 6]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 35, 7]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 35, 8]
type = ChangeState
trigger1 = Time = 2
value = 39
ctrl = 1


;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = changestate
trigger1 = facing = -1
value = 39

[State 50, 2]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 3]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 4]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

;------------------------Other side!---------------------;
[Statedef 39]
type    = A
physics = A

[State 39, 1]
type = changestate
trigger1 = facing = 1
value = 50

[State 39, 2]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 39, 3]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 31, ifelse((vel x)>0, 32, 33))

[State 39, 4]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

