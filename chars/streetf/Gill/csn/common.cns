;-----------------------------------------------------;
;common file for Gill ver. 099B (from streetfighter)  ;
;created by SlayerGatsu since February 2005.          ;
;-----------------------------------------------------;

; Common state file for M.U.G.E.N beta 2002.04.14
;
; System variables usage
; ----------------------
; Var name    Type   Purpose
; --------    ----   -------
; sysvar(0)   Temp   Set by state 5081 (HITL_SLIDE) to 1 to prevent
;                    showing ground hit frame in state 5110 (HIT_LIEDOWN).
;                    Used by guarding states.
; sysvar(1)   Temp   Used by state 40 (Jump Start) amd 45 (Air Jump Start)
;                    to keep track of which way to jump.
;                    Used by state 5100 and 5110 to remember downward
;                    velocity of player just before hitting the ground.
;                    Used in state 5080 for storing the anim # to display.

; The following states have special handling within MUGEN, and should be
; overridden with caution:
; Jump Start (40): airjumping bookkeeping at time = 0
; All guard states (120-155): guard handling throughout state
; Hit_trip, shaking (5070): defence increases at time = 0
; Hit_bounce (5100): defence increases at time = 0, player becomes
;                    invincible if within 10 ticks of getting up
; Hit_liedown (5110): player changes to get-up state (5120) when ready
; Hit_getup (5120): player's defence is restored to normal at time = 0
; Hitfall_recover (5200): player's defence is restored at time = 0
; Hitfall_airrecover (5210): player's defence is restored at time = 0

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = changeanim
trigger1 = Anim != 0 && (Anim != 5 && Anim != 3)
trigger2 = ( Anim = 5 || Anim = 3 )  && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[state 201, explod]
type = explod
trigger1 = animelem = 13
anim = 6000	
pos = 0, 0
postype = p1
sprpriority = -1
ontop = 1

[state 201, explod]
type = explod
trigger1 = animelem = 30
anim = 6010	
pos = 10, -3
postype = p1
sprpriority = -1
ontop = 1

[State 0, 4]
type = changestate
trigger1 = facing = -1
trigger1 = P2BodyDist X > -49 && (p2statetype != A || statetype != A)
value = 1

[State 0, 5] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;-----------------which side are you on????----------------
[Statedef 1]
type = S
physics = S
sprpriority = 0

[State 1, 1]
type = changeanim
trigger1 = Anim != 1 && (Anim != 5 && Anim != 3)
trigger2 = ( Anim = 5 || Anim = 3 ) && AnimTime = 0 ;Turn anim over
value = 1

[State 1, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 1, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) > 2
trigger2 = Time = 4
x = 0

[State 1, 4]
type = changestate
trigger1 = facing = -1
trigger1 = P2BodyDist X < -50 && (p2statetype != A || statetype != A)
value = 0

[State 1, explod]
type = explod
trigger1 = animelem = 13
anim = 6000	
pos = -45, -10
postype = p1
sprpriority = -1
ontop = 1

[State 1, explod]
type = explod
trigger1 = animelem = 40
anim = 6010	
pos = 50, 0
postype = p1
sprpriority = -1
ontop = 1

[State 1, 5] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = facing = -1
value = 2

[State 10, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;------------------------Other side!---------------------;
[Statedef 2]
type    = C
physics = C
anim = 7

[State 2, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 2, 2]
type = ChangeState
trigger1 = facing = 1
value = 10

[State 2, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 3
;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
sprpriority = 0

[State 11, 1]
type = changeanim
trigger1 = Anim != 11 && (Anim != 6 && Anim != 4) && facing = 1
trigger2 = ( Anim = 6 || Anim = 4 ) && AnimTime = 0 ;Turn anim over
value = 11

[State 11, 2]
type = changestate
trigger1 = facing = -1
trigger1 = P2BodyDist X > -49 && (p2statetype != A || statetype != A)
value = 3

[State 11, explod]
type = explod
trigger1 = (time = 160) || (time = 360) || (time = 520)
anim = 6000	
pos = -10, 60
postype = p1
sprpriority = -1
ontop = 1

[State 11, explod]
type = explod
trigger1 = (time = 60) || (time = 306) || (time = 506)
anim = 6010	
pos = -20, 47
postype = p1
sprpriority = -1
ontop = 1

[State 11, 3] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim != 6 && AnimTime = 0
value = 11 

;------------------------Other side!---------------------;
[Statedef 3]
type    = C
physics = C
sprpriority = 0

[State 3, 1]
type = changeanim
trigger1 = Anim != 8 && (Anim != 6 && Anim != 4) && facing = -1
trigger2 = ( Anim = 6 || Anim = 4 ) && AnimTime = 0 ;Turn anim over
value = 8

[State 3, 2]
type = changestate
trigger1 = facing = 1
value = 11

[State 3, Bug-fix]
type = changestate
triggerall = facing = -1
trigger1 = P2BodyDist X < -50 && (p2statetype != A || statetype != A)
value = 11

[State 3, explod]
type = explod
trigger1 = (time = 150) || (time = 360) || (time = 520)
anim = 6000	
pos = -70, 37
postype = p1
sprpriority = -1
ontop = 1

[State 3, explod]
type = explod
trigger1 = (time = 50) || (time = 306) || (time = 506)
anim = 6010	
pos = 40, 70
postype = p1
sprpriority = -1
ontop = 1

[State 3, 3] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim != 6 && AnimTime = 0
value = 8
