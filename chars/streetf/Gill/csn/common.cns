type    = S
physics = S

[State 130, 2]
type = ChangeAnim
triggerall = facing = 1
trigger1 = Anim != 130
value = 130

[State 130, 2]
type = ChangeAnim
triggerall = facing = -1
trigger1 = Anim != 130
value = 113

[State 130, Hi to Lo]
type = ChangeState
trigger1 = command = "holddown"
value = 131

[State 130, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

;---------------------------------------------------------------------------
; CROUCH GUARD (guarding)
