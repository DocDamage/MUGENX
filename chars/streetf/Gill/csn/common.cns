value = 5140

[State 5650, 2] ;Normal anim on the other side
type = ChangeAnim
triggerall = Time = 0
triggerall = SelfAnimExist(5640)
triggerall = facing = -1
trigger1 = (anim != [5611,5619]) && (anim != [5671,5679])
trigger2 = !SelfAnimExist(5640 + (anim % 10))
value = 5640

[State 5150, 3] ;Hit up type anim
type = ChangeAnim
triggerall = facing = 1
trigger1 = Time = 0
trigger1 = (anim = [5111,5119]) || (anim = [5171,5179])
trigger1 = SelfAnimExist(5140 + (anim % 10))
value = 5140 + (anim % 10)

[State 5650, 3] ;Hit up type anim on the other side
type = ChangeAnim
triggerall = facing = -1
trigger1 = Time = 0
trigger1 = (anim = [5611,5619]) || (anim = [5671,5679])
trigger1 = SelfAnimExist(5640 + (anim % 10))
value = 5640 + (anim % 10)

