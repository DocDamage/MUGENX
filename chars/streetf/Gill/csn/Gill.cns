;--------------------------------------------------;
;  Statedef -3, states executed in self's states   ;
;--------------------------------------------------;
[Statedef -3]

;----------------remove explod------------------;
[State -3, remove explod]
type = RemoveExplod
trigger1 = anim = 0 && animelem = 1 || anim =1 && animelem = 1

[State -3, remove explod2]
type = RemoveExplod
trigger1 = anim = 200 || anim = 202

;----------------Jumping Sounds-----------------;
[State -3, jumpstart ground]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 30 
trigger2 = stateno = 40
value = 40, 0

[State -3, touching ground]
type = PlaySnd
triggerall = Time = 1
trigger1 = anim = 37 
trigger2 = anim = 47
value = 40, 1

[state -3, dash sound]
type = playsnd 
triggerall = time = 5
trigger1 = stateno = 102
trigger2 = stateno = 103
trigger3 = stateno = 104
trigger4 = stateno = 105
value = 40,1

;---------------------Sounds--------------------;
[State -3, diyng sound]
type = PlaySnd
triggerall = alive = 0
trigger1 = stateno = 5050 && time = 8
value = 5,0
loop = 0
channel = 2
volume = -100

[State -3, Stop]
type = StopSnd
trigger1 = alive = 1
channel = 2

[State -3, hust-bad sound]
type = PlaySnd
triggerall = alive = 1
trigger1 = gethitvar(damage) >= 80
value = 5,1
loop = 0
volume = -100

[State -3, hust-mid sound]
type = PlaySnd
triggerall = alive = 1
trigger1 = gethitvar(damage) >= 50 && gethitvar(damage) <= 80
value = 5,2
loop = 0
volume = -100

[State -3, hust-light sound]
type = PlaySnd
triggerall = alive = 1
trigger1 = gethitvar(damage) >= 30 && gethitvar(damage) <= 50
value = 5,3
loop = 0
volume = -100

[State -3, Danger!]
type = PlaySnd
triggerall = alive = 1
trigger1 = life = 150 && time = 1
value = 5,4
loop = 0
channel = 3
volume = -100

;----------------------Sides--------------------;
[State -3, blueside turning changment]
type = ChangeAnim
trigger1 = (anim = 5 || anim = 6) && facing = -1
value = ifelse (anim = 5,3,4)

;-------------------Resurrection----------------;
[state -3, Resurrection]
type = changestate
triggerall = gethitvar(damage) >= life
triggerall = facing = 1
trigger1 = power = 3000
value = 5394

[state -3, Resurrection Blueside]
type = changestate
triggerall = gethitvar(damage) >= life
triggerall = facing = -1
trigger1 = power = 3000
value = 5395

[state -3, No power!]
type = Powerset
trigger1 = 1
triggerall = Var(59)=2
value = 0

;---------------------Blinking-----------------;
[state -3, Blink]
type = PalFX
triggerall = palno = 13
trigger1 =  roundstate = 0
trigger2 = (Prevstateno = 6501 || Prevstateno = 6504) && time = 0
trigger3 = stateno = [5000,5710]
time = -1
add = 40,40,40
mul = 290,290,290
sinadd = 50,50,50,180
color = 256