;--------------------------------------------------;
;CNS file for Gill ver. 099B (from streetfighter)  ;
;created by Slatergatsu since February 2005.       ;
;--------------------------------------------------;
;Var(59) used to keep track of the power after     ;
;resurrection, a value of 2 disables the ability to;
;Gain more power                                   ;
;--------------------------------------------------;

[Data]
life = 2000
attack = 100
defence = 100
power = 3000
fall.defence_up = 50
liedown.time = 15
airjuggle = 20
sparkno = 2
guard.sparkno = s5063
KO.echo = 0
volume = 1000
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 30
ground.front = 30
air.back = 30
air.front = 30
height = 100
attack.dist = 160
proj.attack.dist = 500
proj.doscale = 0
head.pos = -5, -90
mid.pos = -5, -60
shadowoffset = -0.5
draw.offset = 0,0

[Velocity]
walk.fwd  = 2.4
walk.back = -2.2
run.fwd  = 5.4, 0
run.back = -2.6,-2.7
jump.neu = 0,-9.8
jump.back = -3.55
jump.fwd = 3.5
runjump.back = -2.55,-9
runjump.fwd = 4,-9
airjump.neu = 0,-9
airjump.back = -2.55
airjump.fwd = 2.5

[Movement]
airjump.num = 0
airjump.height = 20

 (opt)
yaccel = .44
stand.friction = .85
crouch.friction = .1


;-----------Blue side Dash Forward---------------;
[Statedef 102]
type    = S
physics = N
ctrl = 0
anim =102
sprpriority = 1

[State 102, 1]
type = Gravity
trigger1 = 1


[State 102, 2]
type = VelSet
trigger1 = time = 5
x = 17 

[State 102, 3]
type = VelMul
trigger1 = time >= 5
x = .85

[State 102, 4]
type = Posset
trigger1 = time >= 2
y = 0

[state 102, 5]
type = makedust
trigger1 = animelem = 3
trigger2 = animelem = 4
trigger3 = animelem = 5
pos = 10, 0 

[State 102, 6] 
type = ChangeState
trigger1 = AnimTime = 0
value = 1
ctrl = 1


