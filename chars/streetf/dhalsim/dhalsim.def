;サリーちゃんのパパ
[Info]
name = "Dhalsim"        ;キャラの名前
displayname = "Dhalsim" ;表示されるキャラの名前
versiondate = 12,30,2001    ;キャラの更新情報
mugenversion = 04,14,2001   ;キャラが動くmugenのバージョン
author = "3ha"         ;キャラの製作者名
;pal.defaults = 6,3,4,2      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = dhalsim.cmd   ;キャラのコマンド
cns     = dhalsim.cns   ;キャラのプログラム
st      = dhalsim.cns   ;キャラのプログラム
st1     = sari.cns
st2     = brocken.cns
stcommon = common1.cns 
sprite  = dhalsim.sff   ;キャラの絵
anim    = dhalsim.air   ;キャラの動き
sound   = dhalsim.snd   ;キャラの音
pal1    = dhalsim2.act  ;キャラの色（最大１２個）
pal2    = dhalsim4.act
pal3    = dhalsim6.act
pal4    = dhalsim.act
pal5    = dhalsim3.act
pal6    = dhalsim5.act
