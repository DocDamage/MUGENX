; Definition file for sodom
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Sodom by Splode"        ;Name of character
displayname = "Sodom" ;Name of character to display
versiondate = 05,28,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "Splode"         ;Character author name
pal.defaults = 1,3,4,2,5,6    

; Files for the player
[Files]
cmd     = sodom.cmd   ;Command set
cns     = sodom.cns   ;Constants
st      = sodom.cns   ;States
stcommon = common1.cns ;Common states
sprite  = sodom.sff   ;Sprite
anim    = sodom.air   ;Animation
sound   = sodom.snd   ;Sound
pal1    = sodom.act  ;Palettes (can have up to 12)
pal2    = sodom2.act
pal3    = sodom3.act
pal4    = sodom4.act
pal5    = sodom5.act
pal6    = sodom6.act
pal7	  = sodom.act
pal8	  = sodom2.act
pal9 	  = sodom3.act
pal10	  = sodom4.act
pal11   = sodom5.act
pal12   = sodom6.act

