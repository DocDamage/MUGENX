trigger2 = time = 0
trigger3 = command = "TenguWalking"
trigger3 = Alive
value = 1330

[State 5100, ChangeState2]
type = ChangeState
triggerall = LoseKO = 0
trigger1 = var(4) = 2
trigger1 = Alive
trigger2 = var(1) = 1 
trigger2 = random <= 100
trigger2 = Alive = 1
trigger3 = Alive
trigger3 = command = "KoutenOkiagariX"
value = 1370

[State 5100, ChangeState3]
type = ChangeState
triggerall = LoseKO = 0
trigger1 = var(4) = 3
trigger1 = Alive
trigger2 = var(1) = 1 
trigger2 = random <= 200
trigger2 = Alive = 1
trigger3 = Alive
trigger3 = command = "KoutenOkiagariY"
value = 1380

[State 5100, ChangeState4]
type = ChangeState
triggerall = LoseKO = 0
trigger1 = var(4) = 4
trigger1 = Alive
trigger2 = var(1) = 1 
trigger2 = random <= 300
trigger2 = Alive = 1
trigger3 = Alive
trigger3 = command = "KoutenOkiagariZ"
value = 1390

[State 5100, 1]
type = VelSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) = 0
trigger1 = vel x > 1
x = 1

[State 5100, EnvShake]
type = FallEnvShake
trigger1 = Time = 0

[State 5100, Var] ;Save fall velocity
type = VarSet
trigger1 = Time = 0
;trigger1 = GetHitVar(fall.yvel) = 0
sysvar(1) = floor(vel y)

[State 5100, 2] ;Hit ground anim (normal)
type = ChangeAnim
triggerall = time = 0
trigger1 = (anim != [5051,5059]) && (anim != [5061,5069])
trigger2 = !SelfAnimExist(5100 + (anim % 10))
value = 5100

[State 5100, 3] ;Hit ground anim (for hit up)
type = ChangeAnim
trigger1 = time = 0
trigger1 = (anim = [5051,5059]) || (anim = [5061,5069])
trigger1 = SelfAnimExist(5100 + (anim % 10))
value = 5100 + (anim % 10)

[State 5100, 4]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5100, 5]
type = VelSet
trigger1 = Time = 0
y = 0

[State 5100, 6] ;Reduce speed
type = VelMul
trigger1 = Time = 0
x = 0.75

[State 5100, 7]
type = ChangeState
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) = 0
value = 5110 ;HIT_LIEDOWN

[State 5100, 8]
type = GameMakeAnim
trigger1 = Time = 1
;value = 61
;pos = 0, 0
;under = 1
value = 60 + (sysvar(1) > 5) + (sysvar(1) > 14)
pos = 0, 0
under = sysvar(1) <= 10

[State 5100, 9]
type = HitFallDamage
trigger1 = Time = 3

[State 5100, 10]
type = PlaySnd
trigger1 = Time = 1
;value = F7, 0 ;Hit ground
value = F7, (sysvar(1) > 5) + (sysvar(1) > 14)

[State 5100, 11]
type = PosFreeze
trigger1 = 1

[State 5100, 12]
type = ChangeState
trigger1 = AnimTime = 0
value = 5101

[State 5100, 13]
type = ForceFeedback
trigger1 = Time = 0
waveform = sinesquare
ampl = 128,-3,-.2,.005
time = 20

