; Sodom's constants and state file.
;
; Variables:
; var(0) - Temporary variable
; var(1) - AI Active?
; var(2) - Is 1 if in "easy mode". 
; var(3) - Temp Var 2
; var(4) - Tengu Walking variable
;                1: Tengu Walking activated
;                2: KoutenOkiagari X activated
;                3: KoutenOkiagari Y activated
;                4: KoutenOkiagari Z activated
; var(5) - ID # of nearest foe
; var(6) - AC Var
;Permanent variables:
; var(59) - AI was active
;
[Data]
  ;Amount of life to start with
life = 1000
power = 3000
  ;attack power (more is stronger)
attack = 100
  ;defensive power (more is stronger)
defence = 100
  ;Percentage to increase defense everytime player is knocked down
fall.defence_up = 50
  ;Time which player lies down for, before getting up
liedown.time = 70
  ;Number of points for juggling
airjuggle = 15
  ;Default hit spark number for HitDefs
sparkno = 2
  ;Default guard spark number
guard.sparkno = 40
  ;1 to enable echo on KO
KO.echo = 0
  ;Volume offset (negative for softer)
volume = 200
  ;Variables with this index and above will not have their values
  ;reset to 0 between rounds or matches. There are 60 int variables,
  ;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
  ;If omitted, then it defaults to 60 and 40 for integer and float
  ;variables repectively, meaning that none are persistent, i.e. all
  ;are reset. If you want your variables to persist between matches,
  ;you need to override state 5900 from common1.cns.
IntPersistIndex = 57
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 28   ;Player width (back, ground)
ground.front = 22    ;Player width (front, ground)
air.back = 20        ;Player width (back, air)
air.front = 20       ;Player width (front, air)
height = 60	     ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = 15, -95   ;Approximate position of head
mid.pos = -3, -63    ;Approximate position of midsection
shadowoffset = -1     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.5     ;Walk forward
walk.back = -2.0     ;Walk backward
run.fwd  = 5.8, 0    ;Run forward (x, y)
run.back = -5.3, 0 ;Hop backward (x, y)
jump.neu = 0,-7.9    ;Neutral jumping velocity (x, y)
jump.back = -2.4    ;Jump back Speed (x, y)
jump.fwd = 2.8       ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-8.1      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.

[Movement]
airjump.num = 0     ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .40         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
; CNS ƒŒƒxƒ‹: Šî–{
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = Projectile
triggerall = time > 27
trigger1 = (time % 35) = 0
projanim = 171
projremanim = 172
velocity = 0, .9
projheightbound = -270, 0
postype = p1
offset = 40, -36

[State 170, 2]
type = AssertSpecial
trigger1 = time < 250
flag = RoundNotOver



;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
[Statedef 180]
type = S

[State 180, 1]
type = VarRandom
trigger1 = time = 0
v = 0
range = 0, 1000

[State 180, a]
type = ChangeState
trigger1 = time >= 2
trigger1 = var(0) <= 1000
trigger1 = var(0) >= 800
trigger2 = command = "HoldY"
value = 730

[State 180, b]
type = ChangeState
trigger1 = time >= 2
trigger1 = var(0) < 800
trigger1 = var(0) >= 600
trigger2 = command = "HoldA"
value = 720

[State 180, c]
type = ChangeState
trigger1 = time >= 2
trigger1 = var(0) < 600
trigger1 = var(0) >= 400
trigger2 = command = "HoldZ"
value = 740

[State 180, 2]
type = ChangeState
trigger1 = time >= 2
trigger1 = var(0) < 400
trigger1 = var(0) >= 200
trigger2 = command = "HoldC"
trigger3 = command = "HoldX"
value = 181

[State 180, 3]
type = ChangeState
trigger1 = Time >= 2
trigger1 = var(0) < 200
trigger1 = var(0) >= 0
trigger2 = command = "HoldB"
value = 700

