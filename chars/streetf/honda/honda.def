; エドモンド・本田（ストリートファイターＺＥＲＯ３)
[Info]
name = "E.HONDA"          ;キャラの名前
displayname = "E.HONDA"   ;表示されるキャラの名前
versiondate = 02,09,2002  ;キャラの更新情報
mugenversion = 04,14,2001 ;キャラが動くmugenのバージョン
author = "H”"             ;キャラの製作者名
pal.defaults = 4      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = honda.cmd   ;キャラのコマンド
cns     = honda.cns   ;キャラのプログラム
st      = honda.cns   ;キャラのプログラム
st1      = honda_S.cns 
st2      = honda_SC.cns     
st3      = honda_T.cns
stcommon=common1.cns 
sprite  = honda.sff   ;キャラの絵
anim    = honda.air   ;キャラの動き
sound   = honda.snd   ;キャラの音
pal1    = act/honda4.act  ;キャラの色（最大１２個）
pal2    = act/honda3.act
pal3    = act/honda5.act
pal4    = act/honda.act
pal5    = act/honda6.act
pal6    = act/honda2.act

[Arcade]
intro.storyboard  = Arcade/intro.def   ;開始直後のストーリーイントロを管理するファイルを呼び出します。
;ending.storyboard = Arcade/end.def     ;最後の一人を倒した後のエンディングを管理するファイルを呼び出します。
