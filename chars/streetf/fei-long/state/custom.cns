; Spun by Counter
[Statedef 910]
type    = A
movetype= H
physics = N
velset = 0,0

[State 910, 0]
type = ChangeAnim2
trigger1 = 1
value = 930

[State 910, 1]
type = PosAdd
trigger1 = Time = 0
y = -30

[State 910, SelfState]
type = ChangeState
trigger1 = HitShakeOver
value = 911

;---------------------------------------------------------------------------
; Spun by Counter
[Statedef 911]
type    = A
movetype= H
physics = N
velset = 0,0

[State 910, 2]
type = HitVelSet
trigger1 = Time = 0
x = 1
y = 1

[State 910, 3]
type = VelAdd
trigger1 = 1
y = .4

[State 910, 4]
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 5100 ;Hit ground

