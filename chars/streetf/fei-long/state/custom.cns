; Custom states
;---------------------------------------------------------------------------
; Opponent Hit
[Statedef 805]
type    = S
movetype= H
physics = N
velset = 0,0

[State 805, Anim]
type = ChangeAnim2
Trigger1 = Time = 0
value = 805

[State 805, SelfState]
type = SelfState
