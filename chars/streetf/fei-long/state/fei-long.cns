;---------------------------------------------------------------------------
; Introduction
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 190, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
triggerall = PalNo < 7
trigger1 = RoundState = 0
value = 190

[State 190, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
triggerall = PalNo > 6
trigger1 = RoundState = 0
value = 181

[State 190, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

