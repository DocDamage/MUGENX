; Definition file for Fei-Long
;--------------------
;[Player Information]
;--------------------
[Info]
name = "Fei-Long"	   ;Name of character
displayname = "Fei-Long"   ;Name of character to display
versiondate = 2001.08.04   ;Version date of character
mugenversion = 2001.04.14  ;Version of M.U.G.E.N character works on
author = "N64Mario"	   ;Character author name
pal.defaults = 1,2,3,4,5,6 ;Default palettes in order of preference
;--------------------
;[Common Files] 
;--------------------
[Files]
cmd	 = common/command.cmd	 ;Commands
cns	 = common/constant.cns	 ;Constants
stcommon = common/common.cns	 ;Common States
sprite	 = common/sprite.sff	 ;Sprites
anim	 = common/animation.air  ;Animation
sound	 = common/sound.snd	 ;Sound
;--------------------
;[States] 
;--------------------
st	 = state/fei-long.cns	;Fei-long's States
st2	 = state/feilong-s.cns	;Special States
st3	 = state/feilong-h.cns	;Hyper States
st4	 = state/feilong-ex.cns	;EX States
st5	 = state/custom.cns	;Custom States
st6      = state/override.cns	;Override States
;--------------------
;[Palettes] (can have up to 12)
;--------------------
pal1   = palette/feilong.act
pal2   = palette/feilong2.act
pal3   = palette/feilong3.act
pal4   = palette/feilong4.act
pal5   = palette/feilong5.act
pal6   = palette/feilong6.act
pal7   = palette/feilong7.act
pal8   = palette/feilong8.act
pal9   = palette/feilong9.act
pal10   = palette/feilong10.act
pal11   = palette/feilong11.act
pal12   = palette/feilong12.act
