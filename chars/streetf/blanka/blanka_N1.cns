;=====================================================================
;  CNS File For "blanka"                                    Made By H"
;                                                            2002.3.25
;=====================================================================
;---------------------------------------------------------------------
; 変数表
;	Var(1)	: イントロ・勝利ポーズランダムフラグ
;	Var(3)	: 掴み技・トロピカルハザード回数カウンタ
;	Var(4)	: レバガチャ入力カウンタ
;	Var(5)	: レバガチャ入力カウンタ（相手側）
;	Var(6)	: グランドシェイブローリング停止時間延長フラグ
;	Var(7)	: グランドシェイブローリングコマンド認識フラグ
;	Var(8)	: フルーツ種類ランダムフラグ（食べかす）
;	Var(9)	: フルーツ数制御カウンタ
;	Var(10) : スーパーコンボフィニッシュフラグ
;	Var(11) : 弱中強ボタン認識フラグ
;	Var(12) : エレクトリックサンダ－コマンド認識フラグ
;	Var(13) : 地上受け身継続入力フラグ
;	Var(14) : フルーツ種類ランダムフラグ（通常)
;	Var(15) : ダメージ修正1
;	Var(16) : ダメージ修正2
;	Var(17) : ダメージ修正3
;	Var(18) : ダメージ修正4
;	FVar(1) : 敵距離計測カウンタ
;---------------------------------------------------------------------
;---------------------------------------------------------------------
; 基本設定
[Data]
life = 1000          ; 体力ゲージ、上限値（デフォルト：1000）
power = 3000	     ; パワーゲージ、デフォルト：1000
attack = 100         ; 攻撃力（％）
defence = 100        ; 防御力（％）
fall.defence_up = 50 ; 空中コンボ修正率（％）
liedown.time = 51    ; ダウン時間
airjuggle = 15       ; 空中コンボ
sparkno = 0          ; 初期ヒットスパーク番号
guard.sparkno = 40   ; 初期ガードスパーク番号
KO.echo = 0          ; ＫＯボイスエコー（0:OFF、1:ON）
volume = -5          ; キャラボイスボリューム値

[Size]
xscale = 1           ; 水平サイズ倍率
yscale = 1           ; 垂直サイズ倍率
ground.back = 24     ; キャラ幅（地上、後ろ側）
ground.front = 30    ; キャラ幅（地上、前側）
air.back = 20        ; キャラ幅（空中、後ろ側）
air.front = 20       ; キャラ幅（空中、前側）
z.width = 10         ; キャラ幅（ｚ軸）
height = 50	     ; キャラの高さ（ジャンプで飛び越せる高さ）
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = 28,-89    ; 頭部座標
mid.pos = -5,-63     ; 体中心部座標
shadowoffset = 1     ; キャラの影・オフセット値

[Velocity]
walk.fwd  = 2.30      ; 前進速度
walk.back = -1.90     ; 後退速度
run.fwd  = 4.60, 0    ; 前ダッシュ速度（y<0の場合、ホップステップ）
run.back = -4.50, 0   ; バックステップ速度（y=0の場合、走り）
jump.neu = 0,-10.0     ; 垂直ジャンプ速度
jump.fwd = 3.40      ; 前方ジャンプ速度
jump.back = -3.30    ; 後方ジャンプ速度
;runjump.back = -2.55,-8.1 ; 後方ジャンプ速度（ダッシュ中）
;runjump.fwd = 3.6,-9.0      ; 前方ジャンプ速度（ダッシュ中）
;airjump.neu = 0,-9.3      ; 空中垂直ジャンプ速度
;airjump.back = -2.55,-8.1 ; 空中後方ジャンプ速度
;airjump.fwd = 2.5,-8.1    ; 空中前方ジャンプ速度

[Movement]
airjump.num = 0       ; 空中ジャンプ回数
;airjump.height = 35  ; 空中ジャンプ最低高度
yaccel = .5           ; キャラ重力加速度
stand.friction = .85  ; 摩擦係数（立ち状態）
crouch.friction = .82 ; 摩擦係数（しゃがみ状態）

;=====================================================================
; Definition of the Basic Action
;=====================================================================

;=====================================================================
; Definition of the Win/Lose/Intro Pause
;=====================================================================

;---------------------------------------------------------------------
; 時間切れ負け
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170,1]
type = NotHitBy
trigger1 = 1
value = SCA

[State 170, 2]
type = PlaySnd
trigger1 = AnimElem = 2
value = 0, 9

[State 170,12]
type = AssertSpecial
trigger1 = Time = [0,250]
flag = RoundNotOver

;---------------------------------------------------------------------
; 時間切れ引き分け
[Statedef 175]
type = S
ctrl = 0
anim = 175
velset = 0,0

[State 170,1]
type = NotHitBy
trigger1 = 1
value = SCA

[State 170,12]
type = AssertSpecial
trigger1 = Time = [0,250]
flag = RoundNotOver

;---------------------------------------------------------------------
; 勝利
;------------------------ スーパーコンボフィニッシュ時の保留
[Statedef 180]
type = S
movetype = I
physics = N
velset = 0, 0
ctrl = 0

[State 180,VarRandom]
type = VarRandom
trigger1 = Time = 0
v = 1
range = 0,599

[State 180,NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 180,ChangeState]
type = ChangeState
trigger1 = !NumExplod(8600) && !NumExplod(8610)
value = 181

;------------------------ 分岐
[Statedef 181]
type = S
movetype = I
physics = S
velset = 0, 0

[State 181,Muteki]
type = NotHitBy
trigger1 = 1
value = SCA

[State 180,0]
type = ChangeState
triggerall = Time = 0
trigger1 = Command = "hold_x"
value = 4200

[State 180,0]
type = ChangeState
triggerall = Time = 0
trigger1 = Command = "hold_y"
value = 4210

[State 180,0]
type = ChangeState
triggerall = Time = 0
trigger1 = Command = "hold_z"
value = 4220

[State 180,0]
type = ChangeState
triggerall = Time = 0
trigger1 = Command = "hold_a"
value = 4230

[State 180,0]
type = ChangeState
triggerall = Time = 0
trigger1 = Command = "hold_b"
value = 4230

[State 180,ChangeState]
type = ChangeState
triggerall = Time = 0
trigger1 = Command = "hold_c"
value =  4240

[State 180,ChangeState]
type = ChangeState
trigger1 = Time >= 0
trigger1 = Var(1) = [0,99]
trigger2 = WinKO = 0
trigger2 = Time >= 0
trigger2 = Var(1) = [500,519]
value = 4200

[State 180,ChangeState]
type = ChangeState
trigger1 = Time >= 0
trigger1 = Var(1) = [100,199]
trigger2 = WinKO = 0
trigger2 = Time >= 0
trigger2 = Var(1) = [520,539]
value = 4210

[State 180,ChangeState]
type = ChangeState
trigger1 = Time >= 0
trigger1 = Var(1) = [200,299]
trigger2 = WinKO = 0
trigger2 = Time >= 0
trigger2 = Var(1) = [540,559]
value = 4220

[State 180,ChangeState]
type = ChangeState
triggerall = Time = 1 
trigger1 = Var(1) = [300,499]
trigger2 = WinKO = 0
trigger2 = Time >= 0
trigger2 = Var(1) = [560,599]
value = 4230

[State 180,ChangeState]
type = ChangeState
triggerall = WinKO = 1
triggerall = MatchOver
triggerall = Time >= 0
trigger1 = Var(1) = [500,599]
value =  4240

