;------------------------残りカス登場
[Statedef 7500]
type = S
movetyp = I
physics = N
velset = 0,-9.3
sprpriority = 3

[State 7500,ChangeAnim]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Anim != [7050,7350]
value = IfElse(Parent,Var(8) = 0,7050,IfElse(Parent,Var(8) = 1,7050,IfElse(Parent,Var(8) = 2,7150,IfElse(Parent,Var(8) = 3,7250,IfElse(Parent,Var(8) = 4,7350,7450)))))

[State 7500,Veladd]
type = Veladd
trigger1 = 1
y = .3

[State 7500,VelSet]
type = VelSet
triggerall = helper,time >= 0
trigger1 = Ishelper(7500) = 1
trigger2 = Ishelper(7501) = 1
trigger3 = Ishelper(7502) = 1
trigger4 = Ishelper(7503) = 1
trigger5 = Ishelper(7504) = 1
x = ((Parent,fVar(1))+IfElse(Ishelper(7500) = 1,-30,IfElse(Ishelper(7501) = 1,-15,IfElse(Ishelper(7502) = 1,-22,IfElse(Ishelper(7503) = 1,0,-7)))))/(64+0.00000001)

[State 7500,VelSet]
type = VelSet
triggerall = helper,time >= 0
trigger1 = Ishelper(7505) = 1
trigger2 = Ishelper(7506) = 1
trigger3 = Ishelper(7507) = 1
trigger4 = Ishelper(7508) = 1
trigger5 = Ishelper(7509) = 1
x = ((Parent,fVar(1))+IfElse(Ishelper(7505) = 1,-15,IfElse(Ishelper(7506) = 1,-45,IfElse(Ishelper(7507) = 1,-37,IfElse(Ishelper(7508) = 1,-30,-22)))))/(64+0.00000001)

[State 7500,ChangeState]
type = ChangeState
trigger1 = Pos Y >= -10 && Ishelper(7500) = 1
trigger2 = Pos Y >= -10 && Ishelper(7501) = 1
trigger3 = Pos Y >= -20 && Ishelper(7502) = 1
trigger4 = Pos Y >= -10 && Ishelper(7503) = 1
trigger5 = Pos Y >= -20 && Ishelper(7504) = 1
trigger6 = Pos Y >= -30 && Ishelper(7505) = 1
trigger7 = Pos Y >= -10 && Ishelper(7506) = 1
trigger8 = Pos Y >= -20 && Ishelper(7507) = 1
trigger9 = Pos Y >= -30 && Ishelper(7508) = 1
trigger10 = Pos Y >= -40 && Ishelper(7509) = 1
value = 7501

;------------------------残りカス停止
[Statedef 7501]
type = S
movetype = I
physics = S
velset = 0,0
ctrl = 0

[State 7501,ChangeAnim]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Parent,Var(8) != 2
value = IfElse(Parent,Var(8) = 0,7051,IfElse(Parent,Var(8) = 1,7051,IfElse(Parent,Var(8) = 3,7251,IfElse(Parent,Var(8) = 4,7351,7451))))

[State 7501,ChangeAnim]
type = ChangeAnim
triggerall = Time = 0
trigger1 = Parent,Var(8) = 2
value = (7151+random%2)

[State 7501,ChangeState]
type = ChangeState
trigger1 = Parent,Var(9) = 0
value = 7502

