;=====================================================================
; Definition of the Special Arts
;=====================================================================

;---------------------------------------------------------------------
; エレクトリックサンダ－　弱
;------------------------発動
[Statedef 1000]
type = S
movetype = A
physics = S
poweradd = 42
velset = 0,0
anim = 1000
ctrl = 0

[State 1000, 1]
type = PlaySnd
trigger1 = Time = 2
value = 0, 5

[State 1100, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 1001
ctrl = 0

;------------------------攻撃１
[Statedef 1001]
type = S
movetype = A
physics = S
velset = 0,0
anim = 1001
ctrl = 0

[State 1000, 2]
type = PlaySnd
trigger1 = TimeMod = 8, 0
value = 1, 3

[State 1200, 0]
type = VarSet
trigger1 = Time = 0
var(12) = 23

[State 1200, 1]
type = VarAdd
trigger1 = Time >= 0 && var(12) != 0
var(12) = -1

[State 1200, 2]
type = VarAdd
trigger1 = Command = "electric1" || command = "electric2" || command = "electric3"
var(12) = 1

[State 1151, VarSet]
type = VarSet
trigger1 = Time = 0
var(11) = 0

[State 1151, VarSet]
type = VarSet
trigger1 = command = "electric1"
var(11) = 1

[State 1151, VarSet]
type = VarSet
trigger1 = command = "electric2"
var(11) = 2

[State 1151, VarSet]
type = VarSet
trigger1 = command = "electric3"
var(11) = 3

[State 1001, 1]
type = HitDef
trigger1 = AnimElem = 1
trigger2 = AnimElem = 3
trigger3 = AnimElem = 5
p2stateno = 9010
attr = S, SA
damage = 84-((Var(15)*12/32)*7),10
animtype = Medium
getpower = 21
givepower = 5
guardflag = MA
hitflag = MAF
pausetime = 5,5
sparkno = S8130
guard.sparkno = S8210
sparkxy = 5, 0
hitsound = S3, 8
guardsound = S4, 0
ground.type = High
ground.slidetime = 15
ground.hittime  = 23
ground.velocity = -15
airhittime = 23
air.velocity = -2,-2

[State 1001,Explod]
type = Explod
trigger1 = NumExplod(2200) = 0
trigger1 = P2StateNo = 9010
anim = 2200
id = 2200
pos = 0,Target,Const(size.mid.pos.y)
postype = P2
sprpriority = 2
bindtime = -1
removetime = 50
ownpal = 1

[State 1151, ChangeState]
type = ChangeState
trigger1 = var(12) > 0
trigger1 = AnimTime = 0
value = ifelse(Var(11) = 1,1002,ifelse(Var(11) = 2,1012,1022))
ctrl = 0

[State 1151, ChangeState]
type = ChangeState
trigger1 = var(12) <= 0
trigger1 = AnimTime = 0
value = 1050
ctrl = 0

