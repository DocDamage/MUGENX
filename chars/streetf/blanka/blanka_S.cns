;------------------------喰らい側
[Statedef 9010]
type = S
movetype = H
physics = N
velset = 0,0
ctrl = 0
anim = 5010

[State 9010,ChangeAnim]
type = ChangeAnim
triggerall = Anim != 9010 && AnimExist(9010)
trigger1 =  Authorname= "M.M.R."
trigger2 =  Authorname= "H”"
trigger3 =  Authorname= "Adamskie"
value = 9010

[State 9010,ChangeAnim]
type = ChangeAnim
triggerall = Anim != 3520 && AnimExist(3520)
trigger1 = P1Name = "Lilith" && Authorname= "M.M.R."
trigger2 = P1Name = "E.HONDA" && Authorname= "H”"
trigger3 = P1Name = "M.bison" && Authorname= "H”"
value = 3520

[State 9010,ChangeAnim]
type = ChangeAnim
triggerall = Anim != 9999 && AnimExist(9999)
trigger1 =  Authorname= "zolagun"
trigger2 =  Authorname= "zamtong"
trigger3 =  Authorname= "ﾁ､ﾈﾆｱｺ(JungHoonGoon)"
value = 9999       

[State 9010,ChangeAnim]
type = ChangeAnim
triggerall = Anim != 7696 && AnimExist(7696)
trigger1 = Authorname= "Baby Bonnie Hood"
trigger2 = Authorname= "Splode"
trigger3 = Authorname= "Zelgadis296"
trigger4 = Authorname= "Sander71113"
value = 7696

[State 9010,ChangeAnim]
type = ChangeAnim
trigger1 = P1Name = "Anakaris By Third"&& AnimExist(5641) && Authorname= "Third"
trigger1 = Anim != 5641
value = 5641

[State 9010,ChangeAnim]
type = ChangeAnim
trigger1 = P1Name = "Gallon" && AnimExist(5647) && Authorname= "Adamskie"
trigger1 = Anim != 5647
value = 5647

[State 9010,ChangeAnim]
type = ChangeAnim2
trigger1 = P1Name = "Tin's Felicia" && Authorname= "Tin"
trigger1 = Anim != 5651
value = 5651

[State 9010,PalFx]
type = PalFx
trigger1 = Anim = 5010
trigger1 = Time = 0
time = 60
add = 48,48,0
mul = 200,200,30
sinadd = 180,190,20, 8

[State 9010,velset]
type = velset
trigger1 = Time = 35
x = -2.0
y = -9.0

[State 9010,Veladd]
type = Veladd
trigger1 = Time >= 35
y = .44

[State 9010,Muteki]
type = nothitby
trigger1 = Time = 0
value = SCA
time = -1

[State 9010,Selfstate]
type = Selfstate
trigger1 = Pos Y > 0
value = 5100

