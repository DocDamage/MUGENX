guardsound = S4, 0
ground.type = Low
ground.slidetime = 18
ground.hittime  = 18
ground.velocity = -2,-8
guard.velocity = -7
air.velocity = -2,-8
fall = 1
fall.recover = 0
air.recover = 0
recover = 0

[State 3000,PlaySnd]
type = PlaySnd
trigger1 = Var(10) = 1
persistent = 0
value = 1, 6
ignorehitpause = 1

[State 3000,varset]
type = varset
trigger1 = Var(10) = 1
var(10)=2
ignorehitpause=1

[State 3001,Gravity]
