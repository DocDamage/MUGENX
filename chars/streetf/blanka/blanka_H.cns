[Statedef 3000]
type = S
movetype = A
physics = S
velset = 0,0
anim = 3000
ctrl = 0

[State 3000,VarSet]
type = VarSet
trigger1 = time = 0 
v = 6
value = 0

[State 3000,Muteki]
type = NotHitBy
trigger1 = Time = 0
value = SCA
time = 9

[State 3000,PlaySnd]
type = PlaySnd
trigger1 = Time = 0
value = 0, 8

[State 3000,SuperPause]
type = SuperPause
trigger1 = Time = 4
time = 49
anim = S8010
sound = S1, 5
pos = 40,-46
darken = 1
poweradd = -1000
unhittable = 1

[State 3000,AfterImage]
type = AfterImage
trigger1 = Time = 0
time = 999
length = 16
palcolor = 256
palinvertall = 0
palbright = 30,30,30
palcontrast = 180,180,180
palpostbright = 0, 0, 0
paladd = 25,25,25
palmul = .75,.75,.75
timegap = 2
framegap = 4
trans = add1

[State 3000,ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 3001
ctrl = 0

;------------------------上昇
[Statedef 3001]
type    = A
movetype= A
physics = N
velset = 0.5,-4
anim = 3001

[State 1000, 2]
