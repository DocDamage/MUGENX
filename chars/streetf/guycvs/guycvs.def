; Definition file for Guy
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Guy"        ;Name of character
displayname = "Guy" ;Name of character to display
versiondate = 03,1,2003    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "Splode"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = guy.cmd   ;Command set
cns     = guy.cns   ;Constants
st      = guy.cns   ;States
stcommon = common1.cns ;Common states
sprite  = guy.sff   ;Sprite
anim    = guy.air   ;Animation
sound   = guy.snd   ;Sound
pal1    = guy.act  ;Palettes (can have up to 12)
pal2    = alt1.act
pal3    = alt2.act
pal4    = alt3.act
pal5    = alt4.act
pal6    = alt5.act
pal7	= alt6.act
pal8	= alt7.act
pal9	= alt8.act
pal10	= alt9.act
pal11	= alt10.act
pal12	= alt11.act
; Arcade mode
[Arcade]
