trigger1 = var(2)
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard

[State -2, Clear Combo Vars]
type = VarRangeSet
triggerall = var(59) = 2
trigger1 = var(2)
value = 0
first = 6
last = 7
ignorehitpause = 1

[State -2, Combo Vars]
type = VarSet
triggerall = var(59) = 2
triggerall = var(2)
triggerall = StateType = S || StateType = C
trigger1 = StateNo = [200,290]
trigger1 = MoveContact
trigger2 = StateNo = [300,350]
trigger2 = MoveContact
trigger3 = StateNo = [1110,1130]
trigger3 = MoveContact
trigger4 = StateNo = 1150
trigger5 = StateNo = 1160
trigger5 = MoveContact
v = 6
value = 1
ignorehitpause = 1

[State -2, Combo Vars]
type = VarSet
triggerall = var(59) = 2
triggerall = var(2)
triggerall = MoveContact
trigger1 = StateNo = [400,480]
trigger2 = StateNo = 1060
v = 7
value = 1
ignorehitpause = 1

[State -2, Decrease Damage for Repetitive Move Usage]
type = VarSet
triggerall = var(59) = 2
triggerall = var(2)
triggerall = MoveType = A
trigger1 = StateNo != var(8)
trigger1 = time = 1
fv = 1
value = ifelse(StateNo = 480, .25, .35)
ignorehitpause = 1

[State -2, Decrement]
type = VarAdd
triggerall = var(59) = 2
triggerall = var(2)
triggerall = MoveType = A
trigger1 = StateNo = var(8)
trigger1 = fvar(1) > .1
trigger1 = time = 1
fv = 1
value = -.05
ignorehitpause = 1

[State -2, Set Constant]
type = AttackMulSet
triggerall = var(59) = 2
triggerall = StateNo != [2000,2020]
triggerall = StateNo != 2070
trigger1 = var(2)
value = fvar(1)
ignorehitpause = 1

[State -2, Leave CC Mode]
type = AfterImageTime
triggerall = var(59) = 2
triggerall = var(2)
trigger1 = var(3) = 0
trigger2 = MoveType = H
trigger3 = PrevStateNo = 2010
trigger4 = PrevStateNo = 2020
trigger5 = var(19)
trigger6 = Win
time = 0
ignorehitpause = 1

[State -2, Leave CC Mode]
type = AttackMulSet
triggerall = var(59) = 2
;triggerall = var(2)
trigger1 = var(3) = 0
trigger1 = MoveType != A
trigger1 = P2MoveType != H
trigger2 = MoveType = H
trigger3 = PrevStateNo = 2010
trigger4 = PrevStateNo = 2020
trigger5 = var(19)
value = 1
ignorehitpause = 1

[State -2, Leave CC Mode]
type = PowerSet
triggerall = var(59) = 2
triggerall = var(2)
