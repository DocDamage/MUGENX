;trigger2 = Alive
;trigger2 = Random <= 50
var(5) = 1

[State -2]
type = VarSet
trigger1 = StateNo < 5000
trigger2 = StateNo > 5999
var(5) = 0

[State -2, Remove Afterimages on Gethit]
