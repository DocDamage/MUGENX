[State -2, Extra Power for C-Groove]
type = PowerAdd
triggerall = var(59) = 1
triggerall = RoundState = 2
trigger1 = (Power - var(9)) > 0
value = ceil((Power - var(9)) * .15)
ignorehitpause = 1

