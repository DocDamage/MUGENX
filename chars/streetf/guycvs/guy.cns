; Integer Variable Usage 
; var(0) - Temp var
; var(1) - Temp var
; var(2) - CC is active
; var(3) - CC timer
; var(4) - Facing at start of round
; var(5) - Tech Recovery Var
; var(6) - CC Var: Ground Moves Possible
; var(7) - CC Var: Air Moves Possible
; var(8) - Last Attack StateNo for CC
; var(9) - Power on last tick
; var(10) - Stand/Air Parry - Rise
; var(11) - "               - Fall
; var(12) - Crouch Parry - Rise
; var(13) - "            - Fall
; var(14) - 1 = Successful parry
; var(15) - WinKO timer
; var(16) - AI Active
; var(17) - Roll Timer
; var(18) - Button Press Timer
; var(19) - CC Over Signal
; var(58) - AI was active
; var(59) - Groove Selected
;           0: None selected
;           1: C-Groove
;           2: A-Groove
;           3: P-Groove
;
; Float Variable Usage
; fvar(0) - Temp var
; fvar(1) - Attack Constant for CC
; fvar(2) - Multiplier for AI super probability

[Data]
;Amount of life to start with
life = 1000
;attack power (more is stronger)
attack = 100
;defensive power (more is stronger)
defence = 100
;Percentage to increase defense everytime player is knocked down
fall.defence_up = 50
;Time which player lies down for, before getting up
liedown.time = 30
;Number of points for juggling
airjuggle = 15
;Default hit spark number for HitDefs
sparkno = 2
;Default guard spark number
guard.sparkno = 40
;1 to enable echo on KO
KO.echo = 0
;Volume offset (negative for softer)
volume = 150
;Variables with this index and above will not have their values
;reset to 0 between rounds or matches. There are 60 int variables,
;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
;If omitted, then it defaults to 60 and 40 for integer and float
;variables repectively, meaning that none are persistent, i.e. all
;are reset. If you want your variables to persist between matches,
;you need to override state 5900 from common1.cns.
IntPersistIndex = 58
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 17     ;Player width (back, ground)
ground.front = 10    ;Player width (front, ground)
air.back = 14        ;Player width (back, air)
air.front = 10       ;Player width (front, air)
height = 93          ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = -5, -84   ;Approximate position of head
mid.pos = -11, -60    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 3.6      ;Walk forward
walk.back = -3.4     ;Walk backward
run.fwd  = 4.6, 0    ;Run forward (x, y)
run.back = -4,-5.4 ;Hop backward (x, y)
jump.neu = 0,-9.5    ;Neutral jumping velocity (x, y)
jump.back = -3.9    ;Jump back Speed (x, y)
jump.fwd = 3.9      ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-8.1      ;.
airjump.neu = 0,-9.1      ;.
airjump.back = -3.2      ;Air jump speeds (opt)
airjump.fwd = 3.2         ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .45         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
[Statedef 180]
type = S

[State 180, 1]
type = VarRandom
trigger1 = time = 0
v = 0
range = 600

[State 180, 2]
type = ChangeState
trigger1 = time = 0
trigger1 = command = "holdx" || command = "holda"
trigger2 = time = 1
trigger2 = var(0) = [0,199]
value = 181

[State 180, 3]
type = ChangeState
trigger1 = time = 0
trigger1 = command = "holdy" || command = "holdb"
trigger2 = time = 1
trigger2 = var(0) = [200,399]
value = 182

[State 180, 3]
type = ChangeState
trigger1 = time = 0
trigger1 = command = "holdz" || command = "holdc"
trigger2 = time = 1
trigger2 = var(0) = [400,600]
value = 183

