value = 2000
ignorehitpause = 1

[State -2, Eliminate Power Gains]
type = PowerSet
triggerall = var(59) = 2
triggerall = var(2)
trigger1 = Power > 0
value = 0
ignorehitpause = 1

[State -2, Decrement Counter]
type = VarAdd
triggerall = var(59) = 2
triggerall = var(2)
trigger1 = var(3) > 0
v = 3
value = -1
ignorehitpause = 1

[State -2, No Guarding During CC]
