; Definition file for Remy
; Contains all the filenames needed for the character

; Player information
[Info]
name = "MVC Remy"        ;Name of character
displayname = "Remy" ;Name of character to display
author = "One Winged Angel"         ;Character author name
pal.defaults = 1, 2, 3      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = remy.cmd   ;Command set
cns     = remy.cns   ;Constants
st      = remy.cns   ;States
stcommon = common1.cns ;Common states
sprite  = remy.sff   ;Sprite
anim    = remy.air   ;Animation
sound   = remy.snd   ;Sound
pal1    = remy.act  ;Palettes (can have up to 12)
pal2    = remy1.act
pal3    = remy2.act

; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
