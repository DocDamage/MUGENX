trigger1 = command != "holdfwd"
trigger1 = command != "holdback"
trigger1 = time >= 0
trigger1 = vel x = 0
x = 0

;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
;===========================================================================
[Statedef -2]
;===========================================================================
; Parry mode

[State -2]; vars
type = DisplayToClipboard
trigger1 = 1
text = "Parry High=%d  Red Parry=%d"
params = var(10), var(13)
ignorehitpause = 1

[State -2]
type = VarAdd
trigger1 = Var(13) >= 0
var(13) = -1

[State -2]
type = VarAdd
trigger1 = Var(10) != 0
var(10) = -1

[State -2]
type = VarAdd
trigger1 = Var(11) != 0
var(11) = -1

[State -2]
type = VarAdd
trigger1 = Var(12) != 0
var(12) = -1

[State -2]
type = VarSet
triggerall = Var(10) = 0
trigger1 = command = "parryH" && command != "holddown" && Command != "holdup"
trigger1 = statetype != A
trigger1 = stateno != [5000,5400]
var(10) = 10

[State -2]
type = VarSet
triggerall = Var(11) = 0
trigger1 = command = "parryL" && command !=  "holdfwd" && Command != "holdback"
trigger1 = statetype != A
trigger1 = stateno != [5000,5400]
var(11) = 10

[State -2]
type = VarSet
triggerall = Var(12) = 0
trigger1 = command = "parryH" && command != "holddown" && Command != "holdup"
trigger1 = statetype = A
trigger1 = stateno != [5000,5400]
var(12) = 10

[state -2]
type = helper
triggerall = NumHelper(4000) = 0
triggerall = statetype != A
trigger1 = var(10) > 0
ID = 4000
pos = 0,0
postype = p1
stateno = 4000
helpertype = normal
name = "parryH"
sprpriority = 3
ownpal = 1
keyctrl = 0

[state -2]
type = helper
triggerall = NumHelper(4001) = 0
triggerall = statetype != A
trigger1 = var(11) > 0
ID = 4001
pos = 0,0
postype = p1
stateno = 4001
helpertype = normal
name = "parryL"
sprpriority = 3
ownpal = 1
keyctrl = 0

[state -2]
type = helper
triggerall = NumHelper(4002) = 0
triggerall = statetype = A
trigger1 = var(12) > 0
ID = 4002
pos = 0,0
postype = p1
stateno = 4002
helpertype = normal
name = "parryA"
sprpriority = 3
ownpal = 1
keyctrl = 0

[State -2]
type = ChangeState
triggerall = NumHelper(4000) != 0
triggerall = Stateno != 160
trigger1 = Helper(4000),stateno = 4100
value = 160

[State -2]
type = ChangeState
triggerall = NumHelper(4001) != 0
triggerall = Stateno != 161
trigger1 = Helper(4001),stateno = 4100
value = 161

[State -2]
type = ChangeState
triggerall = NumHelper(4002) != 0
triggerall = Stateno != 162
trigger1 = Helper(4002),stateno = 4100
value = 162

[State -2]
