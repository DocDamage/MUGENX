;---------------------------------------------------------------------------
; 2. State entry
; --------------
[Statedef -1]

;===========================================================================
;---------------------------------------------------------------------------
;Sardine's Beach Special Lv.1
;サーディンズビーチスペシャル（レベル１）
[State -1, Sardine's Beach Special Lv 1]
type = ChangeState
value = 3200
triggerall = command = "sardine_a" || ((command = "sardine_b" || command = "sardine_c") && power < 2000)
triggerall = power >= 1000
triggerall = Var(7) = 0
triggerall = Var(59) = 0	;Z-ISM
triggerall = Win = 0
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = 201 && Time < 9) || (stateno = 231 && (Time < 9 || (movecontact && time < 12)))
trigger3 = (stateno = [300,311]) && (Time < 15 || (movecontact && Time < 20))
trigger3 = Var(59) != 2
trigger4 = (stateno = 401 && Time < 9) || (stateno = 431 && Time < 9)
trigger5 = (stateno = 411) && (AnimElem = 8)
trigger6 = (stateno = 421) && (AnimElem = 5 || AnimElem = 6) && (movecontact) && (Pos Y = 0)
trigger7 = (stateno = 40)
trigger8 = (stateno = 211) && (Time < 10 || (Var(59) = 2 && Time < 9))

;---------------------------------------------------------------------------
;Sardine's Beach Special Lv.2
;サーディンズビーチスペシャル（レベル２）
[State -1, Sardine's Beach Special Lv 2]
type = ChangeState
value = 3210
triggerall = command = "sardine_b" || (command = "sardine_c" && power < 3000)
triggerall = power >= 2000
triggerall = Var(7) = 0
triggerall = Var(59) = 0	;Z-ISM
triggerall = Win = 0
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = 201 && Time < 9) || (stateno = 231 && (Time < 9 || (movecontact && time < 12)))
trigger3 = (stateno = [300,311]) && (Time < 15 || (movecontact && Time < 20))
trigger3 = Var(59) != 2
trigger4 = (stateno = 401 && Time < 9) || (stateno = 431 && Time < 9)
trigger5 = (stateno = 411) && (AnimElem = 8)
trigger6 = (stateno = 421) && (AnimElem = 5 || AnimElem = 6) && (movecontact) && (Pos Y = 0)
trigger7 = (stateno = 40)
trigger8 = (stateno = 211) && (Time < 10 || (Var(59) = 2 && Time < 9))

;---------------------------------------------------------------------------
;Sardine's Beach Special Lv.3
;サーディンズビーチスペシャル（レベル３）
[State -1, Sardine's Beach Special Lv 3]
type = ChangeState
value = 3220 + (Var(59) * 2)
triggerall = (command = "sardine_c") || (Var(59) = 1 && (command = "sardine_a" || command = "sardine_b"))
triggerall = power >= 3000
triggerall = Var(7) = 0
triggerall = Var(59) != 2	;Z,X
triggerall = Win = 0
trigger1 = statetype != A
trigger1 = ctrl
trigger2 = (stateno = 201 && Time < 9) || (stateno = 231 && (Time < 9 || (movecontact && time < 12)))
trigger3 = (stateno = [300,311]) && (Time < 15 || (movecontact && Time < 20))
trigger3 = Var(59) != 2
trigger4 = (stateno = 401 && Time < 9) || (stateno = 431 && Time < 9)
trigger5 = (stateno = 411) && (AnimElem = 8)
