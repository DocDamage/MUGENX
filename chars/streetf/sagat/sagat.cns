;サガット　基本設定・通常技用ｃｎｓ
;---------------------------------------
;メモ
;Var(10)  勝ちポーズ分岐
;Var(56)  地上受け身フラグ
;Var(57)  アングリーチャージ
;Var(58)  弱タイガーブロゥ
;Var(59)  フェイクキック
;=======================================
;基本能力値
;========================================
[Data]
life = 1100
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 51
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 128
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 23
ground.front = 23
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -70
mid.pos = -5, -50
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 2.5
walk.back = -2.8
jump.neu = 0,-9.3
jump.back = -2.6
jump.fwd = 2.8

[Movement]
airjump.num = 0
airjump.height = 28
yaccel = .45
stand.friction = .85
crouch.friction = .82

;---------------------------------------------------------------------------
;時間切れ負け
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0

[State 170, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1
