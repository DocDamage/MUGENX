; Definition file for ; CvsKim

; Player information
[Info]
name = "cvskim"        ;Name of character
displayname = "Kim" ;Name of character to display
versiondate = 04,01,2001    ;Version date of character
mugenversion = 04,01,2001   ;Version of M.U.G.E.N character works on
author = "pji111"         ;Character author name
;pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     =cvskim.cmd   ;Command set
cns     = cvskim.cns   ;Constants
st      = cvskim.cns   ;States
stcommon = common1.cns ;Common states
sprite  = cvskim.sff   ;Sprite
anim    = cvskim.air   ;Animation
sound   = cvskim.snd   ;Sound
pal1    = cvskim1.act
pal2    = cvskim2.act
pal3    = cvskim3.act
