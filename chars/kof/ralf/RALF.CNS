; 100 running
[Statedef 100]
type    = S
physics = S
anim = 100

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100 , 1]
type = PlaySnd
trigger1 = AnimElem = 2
value = 900,1
channel = 3

[State 100 , 1]
type = MakeDust
trigger1 = command = "FF"
value = 120
pos = -10, 0

[State 100, 5]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100 , 1]
type = MakeDust
trigger1 = command != "holdfwd"
value = 120
pos = 30, 0

[State 100, 2]
type = ChangeState
trigger1 = command != "holdfwd"
value = 0
ctrl = 1

