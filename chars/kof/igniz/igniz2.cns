trigger10 = Enemy, Numproj = 1 && P2MoveType = A
trigger10 = ctrl && statetype != A
trigger11 = Enemy, Numhelper = 1 && P2MoveType = A
trigger11 = ctrl && statetype != A
trigger12 = backedgedist <= 20 && P2MoveType = A
trigger12 = ctrl && statetype != A

