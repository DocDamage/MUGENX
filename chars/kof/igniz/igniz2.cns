[State -1]
type = ChangeState
value = 510
triggerall = var(59) = 1
triggerall = random <= 40
triggerall = statetype = A
trigger1   = p2bodydist X <= 60
trigger1 = ctrl

;---------------------------------------------------------------------------
;受身
[State -1]
type = ChangeState
value = 5201
triggerall = var(59) = 1
triggerall = random <= 300
triggerall = Vel Y > 0
triggerall = Pos Y >= 0
trigger1 = alive
trigger1 = CanRecover
trigger1 = stateno = 5050

