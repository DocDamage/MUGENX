;# 使用変数 ###############################################################
;
; 0 = 汎用ランダム
; 1 = ヴァントーズ強ヒットフラグ
; 2 = Ｓジャンプフラグ
; 3 = 小・中ジャンプフラグ
; 4 = 勝利分岐フラグ
; 5 = テルミドールダメージ
; 6 = テルミドールヒット数計算
; 7 = ヴァントーズ連射フラグ
; 8 = ヒット数計算
; 9 = 飛び道具ダメージ
; 10 = サンキュロット中ゲージ数値
; 11 = 残像用
; 12 = カウンター判定
; 13 = やられ声ランダム
; 14 = ＫＯ判定
; 15 = テルミドール2ダメージ
; 16 = テルミドール2ヒット数計算
; 17 = 死に状態
; 18 = 交代ヘルパー位置判定
; 19 = 交代攻撃ヒット判定
;
;#########################################################################
[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
;IntPersistIndex = 0;60
;IntPersistIndex = 1

[Size]
xscale = 1
yscale = 1
ground.back = 14
ground.front = 14
air.back = 14
air.front = 14
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 162
head.pos = 10, -90
mid.pos = -0, -62
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3
walk.back = -2.8
run.fwd  = 6.5, 0
run.back = -6.5,-2.9
jump.neu = 0,-8.3
jump.back = -4
jump.fwd = 4
runjump.back = -2.55,-8.1
runjump.fwd = 5,-8.1
airjump.neu = 0,-8.1
airjump.back = -2.55
airjump.fwd = 2.5

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .51
stand.friction = .85
crouch.friction = .82

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;---------------------------------------------------------------------------
; Jump Start
[Statedef 39]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
velset = 0,0

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(2) = 1

[State 40, 10]
type = ChangeState
trigger1 =Time = 0
value = 40

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
velset = 0,0

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 4]
type = VarSet
trigger1 = Time = 0
trigger1 = PrevStateNo != 39
var(2) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VarSet
trigger1 = Time = 0
trigger1 = prevstateno = 100
var(2) = 1

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(3) = 0

[State 40, 5]
type = VarSet
trigger1 = command != "holdup"
var(3) = 1

[State 40, 6]; ジャンプ・小ジャンプX軸速度設定
type = VelSet
trigger1 = AnimTime = 0
trigger1 = Var(2) = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))

[State 40, 7]; 中ジャンプ・大ジャンプX軸速度設定
type = VelSet
trigger1 = AnimTime = 0
trigger1 = Var(2) = 1
x = ifelse(sysvar(1)=0, 0, ifelse(sysvar(1)=1, 4.8, -4.8))

[State 40, 8]; ジャンプ・大ジャンプY軸速度設定
type = VelSet
trigger1 = AnimTime = 0
trigger1 = Var(3) = 0
y = const(velocity.jump.y)

[State 40, 9]; 小ジャンプ・中ジャンプY軸速度設定
type = VelSet
trigger1 = AnimTime = 0
trigger1 = Var(3) = 1
y = -6.0

[State 40, 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State -2,2]
type = VarSet
trigger1 = Time = 0
V = 11
Value = 1

[State -2,2]
type = VarAdd
trigger1 = AnimElem = 2
trigger2 = AnimElem = 3
trigger3 = AnimElem = 4
trigger4 = AnimElem = 5
trigger5 = AnimElem = 6
trigger6 = AnimElem = 7
trigger7 = AnimElem = 8
trigger8 = AnimElem = 9
trigger9 = AnimElem = 10
trigger10 = AnimElem = 11
V = 11
Value = 1

[State 1011, 4]
type = Helper
trigger1 = Time = 0
trigger1 = Var(2) = 1
trigger1 = NumHelper(590) = 0
ID = 590
pos = 0,0
postype = p1
stateno = 590
Persistent = 0
pausemovetime = 0
supermovetime = 0
name = "kage1"
helpertype = normal
ownpal = 0

[State -3,]
type = PlaySnd
trigger1 = Time = 0
value = 41, 0

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

;[State 50, 1]
;type = AfterImage
;trigger1 = Time = 0
;trigger1 = Var(2)
;time = 999
;length = 8
;framegap = 3
;trans = add1
;palcontrast = 128,128,128
;paladd = 0,0,0
;palmul = 1,1,1

;[State -2,]
;type = AfterImageTime
;trigger1 = Vel y >= 0
;Time = 0

[State 50, 2]; ジャンプ・大ジャンプアニメ設定
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Var(3) = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 2]; 小ジャンプアニメ設定
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Var(3) = 1
trigger1 = Var(2) = 0
value = 51

[State 50, 2]; 中ジャンプアニメ設定
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Var(3) = 1
trigger1 = Var(2) = 1
value = ifelse((vel x)=0, 51, ifelse((vel x)>0, 52, 53))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = Var(3) = 0
trigger1 = Var(2) = 0
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

