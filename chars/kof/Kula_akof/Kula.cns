; Jump Landing
[Statedef 52]
type    = S
physics = S
velset = 0,0
anim = 47
ctrl = 1

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 1]
type = Playsnd
trigger1 = Time = 0
value = 47,0
persistent = 0

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
[Statedef 100]
type = S
physics = S
ctrl = 0
velset = 0,0,0
anim = 100

[State 100,1]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 2]
type = velset
trigger1 = time >= 3
x = const(velocity.run.fwd.x)

[State 100, 2]
type = PlaySnd
trigger1 = Time = 3
value = 100,0
loop = 1
channel = 8

[State 100, 3]
type = ChangeState
trigger1 = (command = "holdup") && (time >= 4)
value = 40
ctrl = 0

[State 100, 3]
type = ChangeState
trigger1 = (command != "holdfwd") && (time >= 13)
value = 101
ctrl = 0

