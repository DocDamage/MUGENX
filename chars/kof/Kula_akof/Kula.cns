;======================================================================
; CNS for Kula
;======================================================================
; Var(0)  - P1 or P2 facing detect
; Var(1)  - temp use
; Var(2)  - combo cancel vars and temp use
; Var(3)  - fallen juggle
; Var(4)  - not in use
; Var(5)  - Counter Mode
; Var(6)  - Armor Mode
; Var(8)  - KOF jump system
; Var(55) - enemy name, winning vars.. (what a waste XD)
;-----------------------------------------------------------------------
; Sound Channel Usage
;-----------------------------------------------------------------------
; CH (7)  - normal jump snd
; CH (8)  - running Snd..(skating?)
; CH (9)  - SDM surround sound (lol)
;========================================================================

[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 13
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 250
IntPersistIndex = 40,55
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 15
ground.front = 16
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 160
proj.doscale = 0
head.pos = -5, -90
mid.pos = -5, -60
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd   =  3.3
walk.back  = -3.3
run.fwd    =  6.3, 0
run.back   = -6,-6
jump.neu   =  0,-8.8
jump.fwd   =  3.3
jump.back  = -3.3
runjump.back = -4,-8
runjump.fwd = 4,-8
airjump.neu = 0,-8
airjump.back = -3
airjump.fwd = 3

[Movement]
airjump.num = 0       ;Number of air jumps allowed (opt)
airjump.height = 35   ;Minimum distance from ground before you can air jump (opt)
yaccel = .524         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 1]
type = Helper
triggerall = numhelper(1) = 0
trigger1 = time = 0
trigger2 = anim = 5 && animtime = 0
trigger3 = (anim = 0) && (animelem = 1, = 0)
name = "aura"
ID = 1
pos = 0,0
postype = P1
stateno = 1
keyctrl = 0
ownpal = 1
 
[State 0, normal bg]
type = BGPalfx
trigger1 = time = 0
trigger1 = prevstateno = 3102 || prevstateno = 3203
persistent = 0
invertall = 0
mul = 255,255,255
ignorehitpause = 1
time = 2



;======================
; Kula's Aura helper
[Statedef 1]
type = S
physics = S
anim = 1
ctrl = 0
velset = 0,0,0
sprpriority = 2

[State turn]
type = turn
trigger1 = p2dist X < 0

[State fade]
type = Afterimage
trigger1 = time = 0
time = 99999999
length = 24
palbright = 128,128,192
palcontrast = 160,160,220
FrameGap = 1
timegap = 1
Trans = Add

[State bind]
type = bindtoparent
trigger1 = 1
pos = 0,0

[State end]
type = destroyself
trigger1 = parent, stateno != 0
trigger2 = parent, movetype = H
trigger3 = parent, anim = 5





;=================================================================
; 99 jumping system
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
velset = 0,0,0

[State 40, jumpsnd]
type = PlaySnd
trigger1 = anim = 40 && animtime = 0
value = 40,0
channel = 7
persistent = 0

[State 40, turn]
type = turn
trigger1 = time = 0 && P2dist X < 0

[State 40, 0]
type = VarSet
trigger1 = Time = 0
var(8) = 0

[State 40, 1]
type = VarSet
trigger1 = command = "holdfwd"
trigger1 = var(8) != 2
var(8) = 1

[State 40, 2]
type = VarSet
trigger1 = command = "holdback"
trigger1 = var(8) != -2
var(8) = -1

[State 40, 3]
type = VarSet
triggerall = Time = 0
triggerall = command = "holdfwd"
trigger1 = command = "longjump"
trigger2 = prevstateno = 100 ;RUN_FWD
var(8) = 2

[State 40, 4]
type = VarSet
trigger1 = Time = 0
trigger1 = command = "holdback"
trigger1 = command = "longjump"
var(8) = -2

[State 40, 5]
type = Afterimage
trigger1 = prevstateno = 100
trigger1 = sysvar(1) = 1
time = 15
length = 6
PalBright = 0, 0, 0
PalContrast = 128,128,128
PalAdd = 0, 0, 0
PalMul = 1,1,1
FrameGap = 4
Trans = Add1

[State 40, 6]
type = ChangeState
triggerall = AnimTime = 0
trigger1 = var(8) != 0
trigger1 = var(8) != 1
trigger1 = var(8) != -1
trigger1 = command = "holdup"
trigger2 = command != "holdup"
value = 2041

[State 40, 7]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(var(8)=0, const(velocity.jump.neu.x), ifelse(var(8)>0, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 8]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1


;---------------------------------------------------------------------------
; JUMP_UP (short)
[Statedef 2041]
type    = A
physics = A
velset = 0, -6.4
ctrl = 1

[State 2041, 0] ;killing normal jump snd
type = StopSnd
triggerall = Time = 0
trigger1 = var(8) = -2
trigger2 = var(8) = 2
channel = 7

[State 2041, 2] ; Play sound when jumping (long)
type = PlaySnd
triggerall = Time = 0
trigger1 = var(8) = -2
trigger2 = var(8) = 2
value = 2041,0
persistent = 0

[State 2041, 3] ; Shadows
type = Afterimage
triggerall = Time = 0
trigger1 = var(8) = -2
trigger2 = var(8) = 2
time = 17
length = 9
PalBright   =   0,  0,  0
PalContrast = 128,128,128
PalAdd      =   0,  0,  0
PalMul      =  1,1,1;.9, .9, .9
FrameGap = 3
Trans = Add1

[State 2041, 4] ; Shadows off
type = Afterimage
trigger1 = Time = 14
time = 0

[State 2041, 5] ;Holding up?
type = VelSet
trigger1 = Time = 0
trigger1 = command = "holdup"
y = -8.8

[State 2041, 6]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(8) = 1
x = 3

[State 2041, 7]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(8) = 2
x = 5

[State 2041, 8]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(8) = -1
x = -3

[State 2041, 9]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(8) = -2
x = -5

[State 2041, 10]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X = 0
trigger1 = command = "holdup"
value = 41

[State 2041, 11] ;Short
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X = 0
trigger1 = command != "holdup"
value = 2041

[State 2041, 12]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X > 0
trigger1 = command = "holdup"
value = 42

[State 2041, 13] ;Short
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X > 0
trigger1 = command != "holdup"
value = 2042

[State 2041, 3.1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X < 0
value = 43

[State 2041, 13] ;Short
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X < 0
trigger1 = command != "holdup"
value = 2043

