; State -3
[Statedef -3]
[State -3, width]
type = width
trigger1 = time >= 0
trigger1 = movetype != H
trigger1 = stateno != 5100 && stateno != 5120 && stateno != 0
edge = 8,0

[state -3, debug output]
type = DisplayToClipboard
trigger1 = 1
text="Var(1): %d, Var(2): %d, var(3): %d, var(55): %d, hitshake: %d"
params = var(1), var(2), var(3), var(55), (enemy,hitpausetime)
ignorehitpause = 1

[state -3, debug output]
type = AppendToClipboard
trigger1 = 1
text="\n- CM :%d, AM :%d"
params = var(5), var(6)
ignorehitpause = 1

[State -3, resetvar1+var2]
type = VarRangeSet
trigger1 = movetype = H
trigger2 = stateno = 0
trigger3 = ctrl = 1
first = 1
last = 2
value = 0

[State -3, removeice]
type = removeExplod
trigger1 = statetype != A
trigger2 = (prevstateno = 600 || prevstateno = 620) && (stateno != 600 || stateno != 620)
trigger3 = movetype = H
ID = 620

[State -3, velset]
type = velset
trigger1 = stateno = 130 || stateno = 131
x = 0

[State -3, ice-crash(S)]
type = explod
trigger1 = stateno = 140 && statetype = S && time = 0
persistent = 0
anim = 143
bindtime = 1
pos = 0,0
postype = P1
sprpriority = 1
ownpal = 1
shadow = 128,128,128

[State -3, ice-crash(C)]
type = explod
trigger1 = stateno = 140 && statetype = C && time = 0
persistent = 0
anim = 144
bindtime = 1
pos = 0,0
postype = P1
sprpriority = 1
ownpal = 1
shadow = 128,128,128

;Slow Down When ProjHit
[State -3, Slow Down]
type = SuperPause
triggerall = RoundState = 2
triggerall = !(((stateno=3000)||(stateno=3050)||(stateno=3100)||(stateno=3200))&&(time=[1,30]))
trigger1 = ProjHitTime(1000) = [12,23]
trigger2 = ProjHitTime(3000) = [12,23]
trigger3 = ProjHitTime(3099) = [12,23]
trigger4 = ProjHitTime(3199) = [12,23]
trigger5 = ProjHitTime(3201) = [1,12]
trigger6 = ProjHitTime(1111) = [12,23]
anim = -1
sound = -1
time = 1
darken = 0
p2defmul = 1

[State -3, playsnd-on-shooting-ice]
type = PlaySnd
trigger1 = projhit1111 = 1
value = 240,0
persistent = 0

