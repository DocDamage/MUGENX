x = 0
y = 0

[State 52, 1]
type = Playsnd
trigger1 = Time = 0
value = 47,0

[State 52, 3]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, 3]
type = changestate
