;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -3, 5];
type = lifeadd
triggerall = alive = 1
triggerall = palno = 6
trigger1 = (GameTime%12) = 1
ignorehitpause = 1
value = 2

[State -3, 5];
type = powerset
triggerall = palno = 6
trigger1 = 1
ignorehitpause = 1
value = 3000


;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, ai]
type = varset
triggerall = var(59) = 0
trigger1 = command = "cpu"
trigger2 = command = "cpu2"
trigger3 = command = "cpu3"
trigger4 = command = "cpu4"
trigger5 = command = "cpu5"
trigger6 = command = "cpu6"
trigger7 = command = "cpu7"
trigger8 = command = "cpu8"
trigger9 = command = "cpu9"
trigger10 = command = "cpu10"
trigger11 = command = "cpu11"
trigger12 = command = "cpu12"
trigger13 = command = "cpu13"
trigger14 = command = "cpu14"
trigger15 = command = "cpu15"
trigger16 = command = "cpu16"
trigger17 = command = "cpu17"
trigger18 = command = "cpu18"
trigger19 = command = "cpu19"
trigger20 = command = "cpu20"
trigger21 = command = "cpu21"
trigger22 = command = "cpu22"
trigger23 = command = "cpu23"
trigger24 = command = "cpu24"
trigger25 = command = "cpu25"
trigger26 = command = "cpu26"
trigger27 = command = "cpu27"
trigger28 = command = "cpu28"
trigger29 = command = "cpu29"
trigger30 = command = "cpu30"
trigger31 = command = "cpu31"
trigger32 = command = "cpu32"
trigger33 = command = "cpu33"
trigger33 = command = "cpu34"
var(59) = 1

[State x]
type = Explod
triggerall = numexplod(3130) = 0
triggerall = roundstate != 0
triggerall = roundstate != 1
triggerall = roundstate != 3
trigger1 = roundstate = 2
anim = 3130
ID = 3130
postype = back
pos = 30,210
sprpriority = 6
persistent = 0
bindtime = -1
ownpal = 1

[State x]
type = RemoveExplod
trigger1 = roundstate = 4
ID = 3130

[State 191, 1]
type = AssertSpecial
;triggerall = stateno != [3020,3022]
;triggerall = stateno != [3050,3052]
trigger1 = roundstate = 0
trigger2 = roundstate = 1
trigger3 = roundstate = 4
flag = nobardisplay

[State -3, 3];着地
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52
value = S0,16

[State -3, 5];ジャンプ
type = PlaySnd
trigger1 = Time = 1
trigger1 = stateno = 50
value = S0,14

[State -3, 5];喰らい弱
type = PlaySnd
triggerall = alive = 1
trigger1 = Time = 1 && stateno = 5000 && (anim = 5000 || anim = 5010)
triggerall = random <= 333
value = S0,33

[State -3, 5];喰らい強
type = PlaySnd
triggerall = alive = 1
trigger1 = Time = 1 && stateno = 5000 && (anim = 5001 || anim = 5011)
trigger2 = Time = 1 && stateno = 5000 && (anim = 5002 || anim = 5012)
triggerall = random <= 333
value = S0,34

[State -3, 5];喰らいダウン
type = PlaySnd
triggerall = alive = 1
trigger1 = Time = 1 && stateno = 5101
triggerall = random <= 333
value = S0,35

[State -2]
type = AssertSpecial
trigger1 = 1
flag = NoAirGuard
ignorehitpause = 1

[State 240, 4]
type = varset
trigger1 = P2statetype = S
trigger1 = 1
var(12) = 0

[State 240, 4]
type = varset
trigger1 = P2statetype = C
trigger1 = 1
var(12) = 30

[State 240, 4]
type = varset
trigger1 = 1
trigger1 = P2statetype = A
var(12) = -150 - (-150 - floor(p2bodydist y))

[State -2]
type = Helper
trigger1 = winko = 1
trigger1 = numhelper(10000) = 0
ID = 10000
name = "winflash"
postype = back
pos = 0,0
sprpriority = 2
stateno = 10000
helpertype = normal
keyctrl = 0
persistent = 0
ignorehitpause = 1
ownpal = 1

[State 4100,1]
type = Helper
trigger1 = winko = 1
trigger1 = numhelper(10001) = 0
;trigger1 = numhelper(11) = 1
ID = 10001
name = "sound"
postype = back
pos = 0,0
sprpriority = 2
stateno = 10001
helpertype = normal
keyctrl = 0
persistent = 0
ignorehitpause = 1
ownpal = 1

;-------------------------------------------------------
;AI
;立ちガード(相手立ち)
[State -3]
type = ChangeState
value = 130
triggerall = p2movetype = A
triggerall = P2Life > 0
triggerall = statetype != A
triggerall = var(59) = 1
triggerall = ctrl
triggerall = stateno != 191
triggerall = statetype != A
triggerall = random <= 900
trigger1 = Enemy, Numproj >= 1 && P2MoveType = A
trigger2 = Enemy, Numhelper >= 1 && P2MoveType = A

;攻撃を避ける
[State -3]
type = ChangeState
value = 1010
triggerall = p2movetype = A
;triggerall = P2bodydist X <= 90
;triggerall = P2Life > 0
triggerall = statetype != A
triggerall = enemy, hitdefattr = SCA, NA,SA ,AT, NP,SP
triggerall = var(59) = 1
triggerall = ctrl
triggerall = stateno != [150,153]
;triggerall = stateno != 191
;trigger1 = p2statetype = S
triggerall = random <= 17
trigger1   = p2dist X < 30 && p2movetype = A && ctrl
trigger2   = p2dist X < 100 && p2movetype = A && ctrl
trigger3   = p2dist Y > -40 && p2bodydist X < 10 && p2movetype = A && ctrl
trigger4   = P2dist X > 70 && p2movetype != H && ctrl
trigger5   = enemy, numproj >= 1 && enemy, backedgedist <= 30 && ctrl
trigger6   = p2movetype = A && ctrl && enemy, ishelper
trigger7   = (enemy, p2bodydist X = [-10, 40]) && enemy, hitdefattr = SCA, NA,SA ,AT, NP,SP
trigger8 = Enemy, Numproj = 1 && P2MoveType = A

;立ちガード(相手空中)
[State -3]
type = ChangeState
value = 130
triggerall = p2movetype = A
triggerall = P2bodydist X <= 60
triggerall = P2Life > 0
triggerall = statetype != A
triggerall = var(59) = 1
triggerall = ctrl
triggerall = stateno != 191
trigger1 = p2statetype = A
trigger1 = random <= 800
trigger1 = Enemy, Numproj = 1 && P2MoveType = A
triggerall = enemy, hitdefattr = SCA,HA,HP
trigger2 = enemy, hitdefattr = SCA,HA,HP

;--------------------------
;しゃがみガード
[State -3]
type = ChangeState
value = 131
triggerall = p2movetype = A
triggerall = P2bodydist X <= 60
triggerall = P2Life > 0
triggerall = statetype != A
triggerall = var(59) = 1
triggerall = ctrl
triggerall = stateno != 191
trigger1 = p2statetype = C
triggerall = random <= 800
trigger1 = Enemy, Numproj = 1 && P2MoveType = A
trigger2   = (enemy, p2bodydist X = [-10, 40]) && enemy, hitdefattr = SCA, AA, AT, AP
trigger2 = enemy, hitdefattr = SCA,HA,HP

