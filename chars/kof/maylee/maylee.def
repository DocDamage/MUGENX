; May -Lee KOF2001
; Contains all the filenames needed for the character

; Player information
[Info]
name = "May Lee"        ;Name of character
displayname = "May Lee" ;Name of character to display
versiondate = 14,4,2002    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "Juan Carlos"         ;Character author name
pal.defaults = 1,3,12      ;Default palettes in order of preference

; Files for the player
[Files]
;cmd     = mayleejc.cmd   ;Command set
cmd     = maylee.cmd   ;Command set
;cns     = mayleenotAI.cns   ;Constants ; 
;st      = mayleenotAI.cns   ;States
cns     = maylee.cns   ;Constants ; 
st      = maylee.cns   ;States
stcommon = common1.cns ;Common states
sprite  = maylee.sff   ;Sprite
anim    = maylee.air   ;Animation
sound   = maylee.snd   ;Sound
pal1    = may.act  ;Palettes (can have up to 12)
pal2    = may2.act
pal3    = clar-may.act
pal4    = clar-may5.act
pal5    = clar-may3.act
pal6    = clar-may4.act
pal7    = clar-may2.act
pal8    = clar-may6.act
pal9    = clar-may7.act
pal10    = clar-may8.act
pal11    = clar-may9.act
pal12    = clar-may10.act


; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def