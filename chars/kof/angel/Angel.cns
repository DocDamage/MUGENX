trigger2 = var(59) != 1 && ((facing = 1 && command = "SecretTwoA") || (facing = -1 && command = "SecretTwoB"))
trigger3 = var(59) != 2 && ((facing = 1 && command = "SecretThreeA") || (facing = -1 && command = "SecretThreeB"))
