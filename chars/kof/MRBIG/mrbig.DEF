; Definition file for Mr Big
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Mr. Big"            ;Name of character
displayname = "Mr. Big"     ;Name of character to display
versiondate = 10,14,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "Jin Kazama"       ;Character author name
pal.defaults = 1            ;Default palettes in order of preference

; Files for the player
[Files]
cmd      = mrbig.cmd   ;Command set
cns      = mrbig.cns   ;Constants
st       = mrbig.cns   ;States
stcommon = common1.cns ;Common states
sprite   = mrbig.sff   ;Sprite
anim     = mrbig.air   ;Animation
sound    = mrbig.snd   ;Sound

;pal#    = filename    ;Character (person who designed that character's color scheme)

pal1     = mrbig04.act ;Big(Orochi),    Lady1(Orochi),    Lady2(Orochi)
pal2     = mrbig05.act ;Big(Lancer),    Lady1(Jin),       Lady2(Jin)
pal3     = mrbig06.act ;Big(Jin),       Lady1(Jin),       Lady2(Jin)
pal4     = mrbig01.act ;Big(SNK),       Lady1(SNK),       Lady2(SNK)
pal5     = mrbig02.act ;Big(SNK),       Lady1(SNK),       Lady2(SNK)
pal6     = mrbig03.act ;Big(Jin),       Lady1(Lancer),    Lady2(Jorge)
pal7     = mrbig07.act ;Big(XGargoyle), Lady1(XGargoyle), Lady2(XGargoyle)
pal8     = mrbig08.act ;Big(Titiln),    Lady1(Titiln),    Lady2(Messatsu)
pal9     = mrbig09.act ;Big(Jin),       Lady1(Jin),       Lady2(Urbanism)
pal10    = mrbig10.act ;Big(Winane),    Lady1(ShoShingo), Lady2(ShoShingo)
pal11    = mrbig11.act ;Big(Jin),       Lady1(Jin),       Lady2(Jin)
pal12    = mrbig12.act ;Big(Messatsu),  Lady1(Jin),       Lady2(Jin)

; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
