;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, A]
type = PlaySnd
triggerall = random < 250 && time = 1 && stateno = 5000 && Alive
trigger1 = anim = 5000 || anim = 5001 || anim = 5010 || anim = 5011
value = 5000,0
channel = 0

[State -2, B]
type = PlaySnd
triggerall = random < 250 && time = 1 && stateno = 5010 && Alive
trigger1 = anim = 5020 || anim = 5021
value = 5000,0
channel = 0

[State -2, C]
type = PlaySnd
triggerall = random < 250 && time = 1 && stateno = 5000 && Alive
trigger1 = anim = 5002 || anim = 5012
value = 5000,1
channel = 0

[State -2, D]
type = PlaySnd
trigger1 = random < 250 && time = 1 && stateno = 5010 && Alive && anim = 5022
value = 5000,1
channel = 0

[State -2, E]
type = PlaySnd
trigger1 = random < 250 && time = 1 && stateno = 5100 && Alive
value = 5100,2
channel = 0

[state -2, F]
type = stopsnd
trigger1 = stateno != 100
channel = 1

[state -2, G]
type = stopsnd
trigger1 = stateno != [800, 805]
channel = 3

[state -2, H]
type = assertspecial
triggerall = RoundState < 3
trigger1 = RoundState < 2 || (Ctrl = 0 && Anim = 0 && MoveType != H)
flag = NoBarDisplay

[State -2, I]
type = AfterImage
trigger1 = (MoveType = H) && (Stateno != [1100,1199])
trigger2 = ((stateno = 50) || (stateno = [600,699])) && vel y > -1
time = 0

[State -2, J]
type = Explod
trigger1 = p2stateno = 2110 && p2movetype = H && NumExplod(917) = 0
anim = 917
id = 917
sprpriority = 3
postype = p2
pos = -15,0
bindtime = 1
ownpal = 1

[State -2, K]
type = Explod
trigger1 = (p2stateno = [2000,2110]) && (p2movetype = H) && Time % 10 = 0
anim = 918
id = 918
sprpriority = 3
postype = p2
pos = 0,-65
bindtime = 1
ignorehitpause = 1
ownpal = 1

[State -2, L]
type = Explod
trigger1 = (p2stateno = [2000,2110]) && (p2movetype = H) && Time % 10 = 5
anim = 918
id = 918
sprpriority = 3
postype = p2
pos = -50,-65
bindtime = 1
ignorehitpause = 1
ownpal = 1

[State -2, M]
type = VarAdd
trigger1 = Var(15) > 0
v = 15
value = -1

[State -2, N]
type = ModifyExplod
trigger1 = Var(15) > 0
ID = 1201
scale = ((1000 - Var(15)) / 1000.0), 1
;ontop = 1
ignorehitpause = 1

[State -2, O]
type = RemoveExplod
trigger1 = Var(15) = 0
id = 1200

[State -2, P]
type = RemoveExplod
trigger1 = Var(15) = 0
id = 1201

[State -2, Q]
type = Explod
trigger1 = NumExplod(1202) = 0 && teamside = 1 && Var(15) = [1,2]
anim = 1202
id = 1202
sprpriority = 3
ontop = 1
postype = left
pos = 58,215
bindtime = -1
removetime = -2
ownpal = 1

[State -2, R]
type = Explod
trigger1 = NumExplod(1202) = 0 && teamside = 2 && Var(15) = [1,2]
anim = 1202
id = 1202
sprpriority = 3
ontop = 1
postype = right
pos = -58,215
bindtime = -1
removetime = -2
ownpal = 1

[State -2, S]
type = PalFX
