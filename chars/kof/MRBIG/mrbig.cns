time = 1
add = 60,60,60
ignorehitpause = 1
;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, A]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 || stateno = 107
value = 50, 0
