;---------------------------------------------------------------------------
; HIT_BOUNCE (bounce into air)
[Statedef 2101]
type    = L
movetype= H
physics = N

[State 2101, 1] ;Coming hit ground anim (normal)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim != [5101,5109]
trigger2 = !SelfAnimExist(5160 + (anim % 10))
value = 5160

[State 2101, 2] ;Coming hit ground anim (for hit up)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim = [5101,5109]
trigger1 = SelfAnimExist(5160 + (anim % 10))
value = 5160 + (anim % 10)

[State 2101, 3]
type = HitFallVel
trigger1 = Time = 0

[State 2101, 4]
type = PosSet
trigger1 = Time = 0
y = 20

[State 2101, 5] ;Acceleration
type = VelAdd
trigger1 = 1
y = .4

[State 2101, 6] ;Hit ground
trigger1 = Vel Y > 0 && Pos Y >= 12
type = ChangeState
value = 2110

[State 2101, 7]
type = PalFX
trigger1 = Time % 2 = 0
time = 1
color = 64
invertall = 1
add = 1,1,1
mul = 256,256,256
sinadd = 96,96,96,4
;---------------------------------------------------------------------------
; HIT_LIEDOWN
[Statedef 2110]
type    = L
movetype= H
physics = N

[State 2110, 1]
type = FallEnvShake
trigger1 = Time = 0

[State 2110, 2]
type = ChangeAnim
triggerall = time = 0
triggerall = anim != [5110,5119] ;Not already changed anim
trigger1 = anim != [5161,5169]
trigger2 = !SelfAnimExist(5170 + (anim % 10))
value = 5170

[State 2110, 3]
type = HitFallDamage
trigger1 = Time = 0

[State 2110, 4]
type = PosSet
trigger1 = Time = 0
y = 0

[State 2110, 5]
type = VarSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) != 0
sysvar(1) = floor(vel y)

[State 2110, 6]
type = PlaySnd
trigger1 = Time = 0
trigger1 = !SysVar(0)
;value = F7, 0 ;Hit ground
value = F7, (sysvar(1) > 5) + (sysvar(1) > 14)

[State 2110, 7]
type = GameMakeAnim
trigger1 = Time = 0
trigger1 = !SysVar(0)
value = 60 + (sysvar(1) > 5) + (sysvar(1) > 14)
pos = 0, 0
under = sysvar(1) <= 10

[State 2110, 8]
type = VelSet
trigger1 = Time = 0
y = 0

[State 2110, 10]
type = ChangeAnim
persistent = 0
triggerall = Anim != [5111,5119]
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
value = 5110

[State 2110, 11]
type = SelfState
triggerall = !alive
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
trigger3 = Anim = [5110,5119]
value = 5150

[State 2110, 12]
type = VarSet
trigger1 = SysVar(0) && Time = 0
sysvar(0) = 0

[State 2110, 13]
type = VelMul
trigger1 = 1
x = 0.85

[State 2110, 14]
type = ForceFeedback
trigger1 = alive && Time = 0
time = 8
ampl = 240
waveform = sine

[State 2110, 15]
type = ForceFeedback
trigger1 = !alive && Time = 0
ampl = 200, 7, -.467
time = 30
waveform = sine

[State 2110, 16]
type = SelfState
trigger1 = time = 10
value = 5110

[State 2110, 17]
type = PalFX
trigger1 = Time % 2 = 0
time = 1
color = 64
invertall = 1
add = 1,1,1
mul = 256,256,256
sinadd = 96,96,96,4
