; Definition file for baom
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Eiji Kisaragi"                 ;Name of character
displayname = "Eiji" ;Name of character to display
versiondate = 11,29,2000      ;Version date of character
mugenversion = 11,29,2000     ;Version of M.U.G.E.N character works on
author = "Misamu K Young"           ;Character author name
pal.defaults = 1,2,3,4        ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = eiji.cmd   ;Command set
cns     = eiji.cns   ;Constants
st      = eiji.cns   ;States
stcommon = common1.cns ;Common states
sprite  = eiji.sff   ;Sprite
anim    = eiji.air   ;Animation
sound   = eiji.snd   ;Sound
pal1    = eiji0.act
pal2    = 2p.act
pal3    = 3p.act
pal4    = 4p.act
pal5    = 5p.act
pal6    = 6p.act


