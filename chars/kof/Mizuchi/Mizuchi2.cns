trigger1 = time = 0
trigger1 = var(11) = 1
v = 8
value = -128

[state a];スパキャンゲージ減少
type = poweradd
trigger1 = time = 0
trigger1 = var(11) = 1
value = -1000

[state a];スパキャンコマンド判定初期化
