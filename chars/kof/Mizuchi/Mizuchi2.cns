[Statedef 2000]
type    = S
movetype= A
physics = N
velset = 0,0
juggle = 15
poweradd= -1000
anim = 2000
ctrl = 0

;---------------------[強弱判定]
[state a]
type = varset
trigger1 = command = "x"
trigger1 = time = 0
v = 5
value = 0

[state a]
type = varset
trigger1 = command = "y"
trigger1 = time = 0
v = 5
value = 1


;---------------------[アニメーション変更]
[state a]
type = changeanim
trigger1 = time = 0
trigger1 = var(5) = 1
value = 2001


;---------------------[パワーゲージ減少,MAX関係]
[state a];スパキャン時のゲージ減少
type = poweradd
triggerall = time = 0
trigger1 = prevstateno = 1100
trigger2 = prevstateno = 1101
trigger3 = prevstateno = 1200
trigger4 = prevstateno = 1201
trigger5 = prevstateno = 1702
trigger6 = prevstateno = 1150
trigger7 = prevstateno = 1250
value = -1000

[State -2, a];どこキャン時の点滅(失敗)
type = palfx
triggerall = gametime %2
triggerall = time <= 10
trigger1 = prevstateno = 1100
trigger2 = prevstateno = 1101
trigger3 = prevstateno = 1200
trigger4 = prevstateno = 1201
trigger5 = prevstateno = 1702
trigger6 = prevstateno = 1150
trigger7 = prevstateno = 1250
time = 1
add = 248,248,248
;mul = 248,248,248
color = 1
ignorehitpause = 1



;---------------------[スパキャン]
[state a];スパキャンMAXゲージ減少
