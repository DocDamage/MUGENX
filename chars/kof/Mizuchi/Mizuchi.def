; ここにキャラ情報を書いてください
[Info]
name = "Mizuchi"        ;キャラの名前
displayname = "Mizuchi" ;表示されるキャラの名前
versiondate = 11,22,2000    ;キャラの更新情報
mugenversion = 11,22,2000   ;キャラが動くmugenのバージョン
author = "ahuron"         ;キャラの製作者名
pal.defaults = 1      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = Mizuchi.cmd   ;キャラのコマンド
cns     = Mizuchi.cns   ;キャラのプログラム
st      = Mizuchi.cns   ;基本動作、必殺技、特殊ゲージ、-2、-3
st2     = Mizuchi2.cns  ;超必殺技
st3     = Mizuchi3.cns  ;表示エフェクト
stcommon = common1.cns 
sprite  = Mizuchi.sff   ;キャラの絵
anim    = Mizuchi.air   ;キャラの動き
sound   = Mizuchi.snd   ;キャラの音
pal1    = Mizuchi2.act
pal2    = Mizuchi.act
pal3    = Mizuchi2.act
pal4    = Mizuchi.act
pal5    = Mizuchi2.act
pal6    = Orochi.act
pal7    = Orochi2.act
pal8    = Orochi.act
pal9    = Orochi2.act
pal10   = Orochi.act
pal11   = Orochi2.act
pal12   = Orochi.act