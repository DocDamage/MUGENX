; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "CVSMAI"        ;Name of character
displayname = "MAI" ;Name of character to display
versiondate = 04,01,2001    ;Version date of character
mugenversion = 04,01,2001   ;Version of M.U.G.E.N character works on
author = "shacti"         ;Character author name
pal.defaults = 1,6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = mai.cmd   ;Command set
cns     = mai.cns   ;Constants
st      = mai.cns   ;States
st1      = move1Ex.cns   ;super cancel altered by Ex-Inferis
stcommon = common1.cns ;Common states
sprite  = cvsmai.sff   ;Sprite
anim    = mai.air   ;Animation
sound   = mai.snd   ;Sound
pal1    = MAI.act  ;Palettes (can have up to 12)
pal2    = mai_green.act
pal3    = mai_blue.act
pal4    = mai_purple.act
pal5    = mai_orange.act
pal6    = mai_yellow.act
pal7    = mai_black.act
pal8    = mai_pink.act
pal9    = mai_ff.act
pal10   = ytmai.act
pal11   = tmai.act
