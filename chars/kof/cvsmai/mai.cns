;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
; CNS 깒긹깑: 딈?
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 191, 1]
type = ChangeState
triggerall = Time = 0
trigger1 = p2name = "Chun li" || p4name = "Chun li"
trigger2 = p2name = "chunli" || p4name = "chunli"
value = 193

[State 191, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 191, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, 3]
type = PlaySnd
trigger1 = AnimElem = 3
value = 7,0

[State 191, 4] ;Change to stand state
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;--------------------------------------------
; Introduction VS chunli
; CNS difficulty: basic
