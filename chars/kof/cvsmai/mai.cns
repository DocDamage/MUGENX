type = S
ctrl = 0
anim = 191
velset = 0,0

[State 191, 3]
type = PlaySnd
trigger1 = AnimElem = 14
value = 7,2


[State 192, ChState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0




