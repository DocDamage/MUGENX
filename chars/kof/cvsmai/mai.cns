sparkxy = -0,-82
hitsound   = s5,1
guardsound = s6,0
ground.type = High
ground.slidetime = 12
ground.hittime  = 15
ground.velocity = -5,-5
air.velocity = -2.5,-4
envshake.time = 14
envshake.ampl = 5
air.fall = 1
fall = 1

