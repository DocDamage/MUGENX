ontop = 1
ownpal = 1
bindtime = 1
pausemovetime = -1
supermove = 1
ignorehitpause = 1

[State -3, Jump Dust]
type = Explod
triggerall = MoveType != H && StateNo != 1050 && Anim != 1013 && StateNo != 2030 && NumExplod(8020) < 5
trigger1 = ((StateNo != [600,699]) && Vel Y < 0 && Time <= 5) || (StateNo = 1010 && (AnimElemTime(4) >= 0 && AnimElemTime(4) < 6)) || (StateNo = 1030 && (Time >= 1 && Time < 6))
trigger2 = (StateNo = 3050 && Anim != 1035 && (AnimElemTime(5) >= 0 && AnimElemTime(5) < 6)) || (StateNo = 3100 && Anim = 3100 && (AnimElemTime(5) >= 0 && AnimElemTime(5) < 6)) 
trigger3 = StateNo = 3105 && Anim = 3105 && (AnimElemTime(5) >= 0 && AnimElemTime(5) < 6)
trigger4 = (StateNo = 2010 && (AnimElemTime(4) >= 0 && AnimElemTime(4) < 6))
Anim = 8020
pos = 0, Floor(-Pos Y) + 5
postype = p1
ontop = 1
ownpal = 1
bindtime = 1
vel = ifelse (NumExplod(8020) = 0, 0, ifelse (NumExplod(8020) = 1, 1, ifelse(NumExplod(8020) = 2, -1, ifelse (NumExplod(8020) = 3, 2, -2)))), -1
pausemovetime = -1
supermove = 1
ignorehitpause = 1
ID = 8020

[State -3, Jump Dust]
type = Explod
triggerall = MoveType != H && StateNo != 1050 && Anim != 1013 && StateNo != 2030 && NumExplod(8021) < 2
trigger1 = ((StateNo != [600,699]) && Vel Y < 0 && Time <= 2) || (StateNo = 1010 && (AnimElemTime(4) >= 0 && AnimElemTime(4) < 2)) || (StateNo = 1030 && (Time >= 1 && Time < 3))
trigger2 = (StateNo = 3050 && Anim != 1035 && (AnimElemTime(5) >= 0 && AnimElemTime(5) < 3)) || (StateNo = 3100 && Anim = 3100 && (AnimElemTime(5) >= 0 && AnimElemTime(5) < 2)) 
trigger3 = StateNo = 3105 && Anim = 3105 && (AnimElemTime(5) = 1 && AnimElemTime(5) = 3)
trigger4 = (StateNo = 2010 && (AnimElemTime(4) >= 0 && AnimElemTime(4) < 2))
Anim = ifelse (NumExplod(8021), 8022, 8021)
