sprpriority = 1

[State 40, 1];노말점프
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 1];소점프
type = VarSet
trigger1 = Time = 0
sysvar(2) = 0

[State 40, 1];대점프
type = VarSet
trigger1 = Time = 0
sysvar(3) = 0


[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 4]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 2]
type = VarSet
trigger1 = command != "holdup"
sysvar(2) = 1

[State 40, 2]
type = VarSet
trigger1 = prevstateno = 101 ;RUN_FWD
trigger2 = command = "HighJump"
sysvar(3) = 1


[State 40, 4]
type = VelSet
trigger1 = sysvar(3) = 0
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = ifelse(sysvar(2)=0, const(velocity.jump.y), -6.3)

[State 40, 4]
type = VelSet
trigger1 = sysvar(3) = 1
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, 0, ifelse(sysvar(1)=1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))
y = ifelse(sysvar(2)=0, const(velocity.runjump.y), -6.8)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1


