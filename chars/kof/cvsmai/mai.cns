; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]
[State -2, Power Chage]
type = RemoveExplod
trigger1 = NumExplod(8005) || MoveType = H
ID = 8000


;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 1, 1

[State -3, GetHurt Sound]
type = PlaySnd
triggerall = Random < 500
triggerall = Time = 1
triggerall = Alive = 1
trigger1 = StateNo = 5000 || StateNo = 5010 || StateNo = 5020 || StateNo = 5070 || StateNo = 5100
value = 18, ifelse (StateNo = 5100 || GetHitVar(animtype) = 2, 3, ifelse (GetHitVar(animtype) = 1, 2, 1))


[State -3, PlaySnd]
type = PlaySnd
triggerall = Time = 1 && Random <= 450
trigger1 = Stateno = 200
trigger2 = Stateno = 205
trigger3 = Stateno = 230
trigger4 = Stateno = 235
trigger5 = Stateno = 400
trigger6 = Stateno = 430
trigger7 = Stateno = 600
trigger8 = Stateno = 630
value = 7, ifelse (Random <= 500, 4, 6)
channel = 0

[State -3, PlaySnd]
type = PlaySnd
triggerall = Time = 1 && Random <= 450
trigger1 = Stateno = 210
trigger2 = Stateno = 215
trigger3 = Stateno = 240
trigger4 = Stateno = 245
trigger5 = Stateno = 410
trigger6 = Stateno = 440
trigger7 = Stateno = 610
trigger8 = Stateno = 640
value = 7, ifelse (Random <= 500, 5, 7)
channel = 0



