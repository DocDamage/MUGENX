[Statedef 200]
type = S
movetype = A
physics = S
anim = 200
poweradd = 0
velset = 0
ctrl = 0
facep2 = 1

[State 200, 1]
type = PlaySnd
trigger1 = Time = 0
value = 5,0

[State 200, 2]
channel = 0
type = PlaySnd
trigger1 = Time = 0 && Random < 500
value = 1,0

[State 5040, 4]
type = StateTypeSet
trigger1 = AnimElem = 3
movetype = I

[State 200, 3]
type = HitDef
trigger1 = AnimElem = 2
attr = S, NA
animtype = Light
damage = ifelse(enemy,var(0) = 1,75,45)
getpower = ifelse(Var(10) != 0,0,105),ifelse(Var(10) != 0,0,105)
givepower = 20,20
hitflag = MAF
guardflag = M
pausetime = 12,12
sparkno = 0
sparkxy = -15,-80
guard.sparkno = 40
hitsound = S4,ifelse(Random < 500,16,0)
guardsound = S4,9
ground.type = High
ground.slidetime = 30
ground.hittime = 9
ground.velocity = -7.5
guard.hittime = 9
guard.velocity = -6
ground.cornerpush.veloff = -8.5
guard.cornerpush.veloff = -8.5
air.cornerpush.veloff = 0
