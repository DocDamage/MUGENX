;屈み・弱・パンチ
;     これも通常の攻撃とはあまり変わらないが、変わった点といえばpriority（優先順位）
;     が３になっている事です。
;     これによって他の大抵の攻撃よりも優先権が下がる事になり相手と攻撃がかち合った
;     時は負けてしまいます。
[Statedef 400]
type    = C
movetype= A
physics = C
juggle  = 8
poweradd= 0
ctrl = 0
anim = 400
sprpriority = 2

[State 200, 5]
type = PlaySnd
trigger1 = random < 350
trigger1 = AnimElem = 1
value = 200,0+var(1)*2

[State 400, 1]
type = PlaySnd
trigger1 = Time = 1
value = 201, 0

[State 400, 2]
type = HitDef
trigger1 = Time = 0
attr = C, NA
damage    = 30
priority  = 3
animtype  = Light
hitflag = MAF
guardflag = M
getpower = 55,0
pausetime = 7,8
sparkno = s7000
sparkxy = -10,-27
hitsound   = s202,0
guard.sparkno = s7010
guardsound = s120,0
ground.type = Low
ground.slidetime = 9
ground.hittime  = 9
ground.velocity = -5
air.velocity = -2.5,-3

[State 400, 3]
type = CtrlSet
trigger1 = animelem = 9
value = 1

[State 400, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 11
ctrl = 1

