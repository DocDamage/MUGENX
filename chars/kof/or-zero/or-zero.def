; ここにキャラ情報を書いてください
[Info]
name = "Original Zero"        ;キャラの名前
displayname = "Original Zero" ;表示されるキャラの名前
versiondate = 11,22,2000    ;キャラの更新情報
mugenversion = 11,22,2000   ;キャラが動くmugenのバージョン
author = "ahuron"         ;キャラの製作者名
pal.defaults = 1      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = or-zero.cmd   ;キャラのコマンド
cns     = or-zero.cns   ;キャラのプログラム
st      = or-zero.cns   ;キャラのプログラム
st2     = or-zero2.cns
st3     = or-zero3.cns
st4     = or-zero4.cns
stcommon = common1.cns 
sprite  = or-zero.sff   ;キャラの絵
anim    = or-zero.air   ;キャラの動き
sound   = or-zero.snd   ;キャラの音
pal1    = ch-zero.act  ;キャラの色（最大１２個）
pal2    = ch-zero.act
pal3    = ch-zero.act
pal4    = or-zero.act
pal5    = or-zero.act
pal6    = or-zero.act
pal7    = or-zero.act
pal8    = or-zero.act
pal9    = or-zero.act
pal10   = ch-zero.act
pal11   = ch-zero.act
pal12   = ch-zero.act