; Definition file for Hayate
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Duke"        ;Name of character
displayname = "Duke" ;Name of character to display
versiondate = 18,1,2002    ;Version date of character
mugenversion = 18,1,2002   ;Version of M.U.G.E.N character works on
author = "MR.S&&Misamu K Young"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = duke.cmd   ;Command set
cns     = duke.cns   ;Constants
st      = duke.cns   ;States
stcommon = common1.cns ;Common states
sprite  = duke.sff   ;Sprite
anim    = duke.air   ;Animation
sound   = duke.snd   ;Sound
pal1    = duke1.act  ;Palettes (can have up to 12)
pal2    = duke2.act
pal3    = duke3.act
pal4    = duke4.act
pal5    = duke5.act
pal6    = duke6.act
