;var(16) = POW MAX energy
;var(17) = Counter Hit
;var(18) = P. Jump
;var(19) = Counter Hit
;var(20) = Counter Hit
;var(30) = Hit Count 1
;var(31) = Hit Count 2
;var(32) = Hit Count 3
;var(33) = Hit Count Total
;var(45) = CMD Logic (Simple)
;var(46) = CMD Logic (DM)
;var(47) = CMD Logic (Special)
;var(48) = CMD Logic (Basic)
;var(49) = Advantage
;var(51) = Roundtime
;var(52) =  Dizzy |
;var(53) =        |
;var(54) = _______|
;var(55) = Striker Fatigue
;var(56) = Striker Select Complete
;var(57) = RAGE Bar Visibility
;var(58) = Striker Index
;        = 1 - Kyo Kusanagi
;        = 2 - Iori Yagami
;        = 3 - Heavy D!
;        = 4 - Duck King
;        = 5 - Seth
;        = 6 - Another Iori
;var(59) = Mode
;        = 0 - '98
;        = 1 - '00
;        = 2 - A
;        = 3 - K
;fvar(38) = Combo RAGE Mod
;fvar(39) = K-Meter

[Data]
life = 1000               ;Amount of life to start with
attack = 100              ;100% attack power (more is stronger)
defence = 100             ;100% defensive power (more is stronger)
power = 5000              ;Thanks, Herman!!  :D
fall.defence_up = 50      ;Def goes up by 50% everytime player is hit on ground
liedown.time = 10         ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 20            ;Can do 20 points of juggling
sparkno = 0               ;Default spark number
guard.sparkno = 40        ;Default guard spark number
KO.echo = 0               ;1 to enable echo on KO
volume = 100              ;Volume offset (negative for softer)
IntPersistIndex = 55      ;Anything higher can be global
FloatPersistIndex = 38    ;.

[Size]
xscale = 1                ;Horizontal scaling factor.
yscale = 1                ;Vertical scaling factor.
ground.back = 15          ;Player width (back, ground)
ground.front = 16         ;Player width (front, ground)
air.back = 12             ;Player width (back, air)
air.front = 11            ;Player width (front, air)
z.width = 3               ;Player width (into and out)
height = 60	              ;Height of player (for opponent to jump over)
attack.width = 4,4        ;Default attack width: back, front
attack.dist = 160         ;Default attack distance
proj.attack.dist = 90     ;Default attack distance for projectiles
proj.doscale = 0          ;Set to 1 to scale projectiles too   
draw.offset = -2,-2

[Velocity]
walk.fwd  = 3.18          ;Walk forward
walk.back = -3.22         ;Walk backward
run.fwd  = 7.75, 0        ;Run forward (x, y)  - if y<0, player will hop
run.back = -7.75, 0       ;Run backward (x, y) - if y=0, player will run

[Movement]
yaccel = .46              ;Vertical acceleration
stand.friction = 0.852263 ;Friction coefficient when standing
crouch.friction = 0.852263;Friction coefficient when crouching


