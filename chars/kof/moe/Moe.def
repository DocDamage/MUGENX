; Contains all the filenames needed for the character

; Player information
[Info]
name = "Moe"        ;Name of character
displayname = "Moe" ;Name of character to display
versiondate = 07,25,2002    ;Version date of character
mugenversion = 04,01,2001   ;Version of M.U.G.E.N character works on
author = "Fangke"         ;Character author name

; Files for the player
[Files]
cmd     = Moe.cmd   ;Command set
cns     = Moe.cns   ;Constants
st      = Moe.cns   ;States
st1	= MoeNA.cns
st2	= MoeSA.cns
st3	= MoeHA.cns
stcommon = common1.cns ;Common states
sprite  = Moe.sff   ;Sprite
anim    = Moe.air   ;Animation
sound   = Moe.snd   ;Sound
pal1	= Moe1.act
pal2	= Moe2.act
pal3	= Moe3.act
pal4	= Moe4.act
pal5	= Moe5.act
pal6	= Moe6.act
;pal11	= w.act
pal12	= MoeG.act
