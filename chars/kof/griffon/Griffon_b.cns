;=====================================================================
;  CNS File For "The Griffon"                           Made By M.M.R.
;                                       Ver. Final         2000.Jul.22
;=====================================================================

;---------------------------------------------------------------------
; Basic Constants
[Data]
life = 1500          ;Amount of life to start with
attack = 105         ;100% attack power (more is stronger)
defence = 90         ;100% defensive power (more is stronger)
fall.defence_up = 50 ;Def goes up by 50% everytime player is hit on ground
liedown.time = 40    ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 15       ;Can do 15 points of juggling
sparkno = 2        ;Default spark number
guard.sparkno = 40 ;Default guard spark number
KO.echo = 0          ;1 to enable echo on KO
volume = -5          ;Volume offset (negative for softer)

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 18     ;Player width (back, ground)
ground.front = 15    ;Player width (front, ground)
air.back = 17        ;Player width (back, air)
air.front = 17       ;Player width (front, air)
z.width = 10         ;Player width (into and out)
height = 80	     ;Height of player (for opponent to jump over)
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = -5,-110   ;Approximate position of head
mid.pos = -5, -60    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow

[Velocity]
walk.fwd  = 2.3      ;Walk forward
walk.back = -2.2     ;Walk backward
run.fwd  = 5.0, -3.0    ;Run forward (x, y)  - if y<0, player will hop
run.back = -4.5,-3.8 ;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-8.5    ;Neutral jumping velocity (x, y)
jump.back = -2.55    ;Jump back Speed (x, y)
jump.fwd = 2.5       ;Jump forward Speed (x, y)
;runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
;runjump.fwd = 4,-8.1      ;.
;airjump.neu = 0,-8.1      ;.
;airjump.back = -2.55,-8.1 ;Air jump speeds (opt)
;airjump.fwd = 2.5,-8.1    ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
;airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .43         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;===============================================================================
; Definition of the Basic Action
;===============================================================================

;-------------------------------------------------------------------------------
;Dash Foward override
[Statedef 100]
type    = A
movetype = I
physics = N
ctrl = 0
anim = 100
velset = 5.0,-3.0

[State 100,1]
type = VelAdd
trigger1 = 1
y = .43

[State 100,3]
type = PlaySnd
trigger1 = Time = 0
value = 100, 0

[State 100,4]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 101

;---------------------------------------------------------------------------
; Dash Foward override (land)
[Statedef 101]
type    = S
movetype = I
physics = S

[State 101,1]
type = ChangeAnim
trigger1 = Time = 0
value = 47

[State 101,2]
type = PlaySnd
trigger1 = Time = 0
value = 47, 0

[State 101,3]
type = VelSet
trigger1 = Time = 0
y = 0

[State 101,4]
type = PosSet
trigger1 = Time = 0
y = 0

[State 101,5]
type = CtrlSet
trigger1 = Time = 7
value = 1

[State 101,6]
type = ChangeState
trigger1 = Time = 7
value = 0

;===============================================================================
; Definition of the Win/Lose/Intro Pause
;===============================================================================

;-------------------------------------------------------------------------------
; LOSE (Time over)
[Statedef 170]
type = S
ctrl = 0
anim = 175
velset = 0,0,0

[State 170,0]
type = PlaySnd
trigger1 = AnimElem = 5
value = 175, 0

[State 170,1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

;-------------------------------------------------------------------------------
; WIN
[Statedef 180]
type = S

[State 180,1]
type = ChangeState
trigger1 = MatchOver != 1
trigger1 = Time = 0
value = 181

[State 180,2]
type = ChangeState
trigger1 = MatchOver = 1
trigger1 = Time = 0
value = 182

;-------------------------------------------------------------------------------
; WIN 1
[Statedef 181]
type = S
ctrl = 0
anim = 180
velset = 0,0,0

[State 181,1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

[State 181,2]
type = PlaySnd
trigger1 = AnimElem = 6
value = 180, 0

;-------------------------------------------------------------------------------
; WIN 2
[Statedef 182]
type = S
ctrl = 0
anim = 185
velset = 0,0,0

[State 182,1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

[State 182,2]
type = PlaySnd
trigger1 = AnimElem = 7
value = 185, 0

[State 182,3]
type = PlaySnd
trigger1 = AnimElem = 14
value = 185, 1

;-------------------------------------------------------------------------------
; INTRO
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0,0

[State 191,0]
type = VarSet
trigger1 = Time = 0
v = 12
value = 1

[State 191,1]
type = VarSet
trigger1 = Time = 0
v = 20
value = 3

[State 191,2]
type = AssertSpecial
trigger1 = Time = [0,141]
flag = Intro

[State 191,3]
type = PlaySnd
triggerall = AnimElem = 3
trigger1 = P2Name != "Kain"
trigger1 = P4Name != "Kain"
trigger1 = P2Name != "Rugal Bernstein"
trigger1 = P4Name != "Rugal Bernstein"
trigger1 = P2Name != "Geonitz"
trigger1 = P4Name != "Geonitz"
trigger1 = P2Name != "Orochi"
trigger1 = P4Name != "Orochi"
trigger1 = P2Name != "Krizalid"
trigger1 = P4Name != "Krizalid"
trigger1 = P2Name != "Vega"
trigger1 = P4Name != "Vega"
trigger1 = P2Name != "Geese Howard"
trigger1 = P4Name != "Geese Howard"
trigger1 = P2Name != "Lord"
trigger1 = P4Name != "Lord"
value = 190, 0

[State 191,4]
type = PlaySnd
triggerall = AnimElem = 3
trigger1 = P2Name = "Kain"
trigger2 = P4Name = "Kain"
trigger3 = P2Name = "Rugal Bernstein"
trigger4 = P4Name = "Rugal Bernstein"
trigger5 = P2Name = "Geonitz"
trigger6 = P4Name = "Geonitz"
trigger7 = P2Name = "Orochi"
trigger8 = P4Name = "Orochi"
trigger9 = P2Name = "Krizalid"
trigger10 = P4Name = "Krizalid"
trigger11 = P2Name = "Vega"
trigger12 = P4Name = "Vega"
trigger13 = P2Name = "Geese Howard"
trigger14 = P4Name = "Geese Howard"
trigger15 = P2Name = "Lord"
trigger16 = P4Name = "Lord"
persistent = 0
value = 190, 2

[State 191,4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

