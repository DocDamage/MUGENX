triggerall = Time = 1
trigger1 = stateno = [210,215]
trigger2 = stateno = [230,240]
trigger3 = stateno = 410 || stateno = 430
trigger4 = stateno = 610 || stateno = 630
value = 300,1
channel = 0

[State -3, 2]
