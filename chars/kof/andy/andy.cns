; INTRO
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0,0

[State 191, 1] ;If opponent is Terry, go to alternate intro
type = ChangeState
triggerall = Time = 0
trigger1 = P2Name = "Terry Bogard"
trigger2 = P4Name = "Terry Bogard"
trigger3 = P2Name = "FF4 Terry"
trigger4 = P4Name = "FF4 Terry"
trigger5 = P2Name = "Joe Higashi"
trigger6 = P4Name = "Joe Higashi"
trigger7 = P2Name = "Joe"
trigger8 = P4Name = "Joe"
value = 191

[State 191, 1] ;If opponent is Mai, go to alternate intro
type = ChangeState
triggerall = Time = 0
trigger1 = P2Name = "Mai"
trigger2 = P4Name = "Mai"
trigger3 = P2Name = "Mai Shiranui"
trigger4 = P4Name = "Mai Shiranui"
trigger5 = P2Name = "Mai2"
trigger6 = P4Name = "Mai2"
value = 193

[State 190, 1] ;Intro not yet over
type = VarSet
trigger1 = Time = 0
v = 9
value = 1

[State 191, 1] ;Intro not yet over
type = AssertSpecial
trigger1 = Time = [0,90]
flag = intro

[State 190, 2]
type = PlaySnd
trigger1 = Time = 6
value = 0, 0

[State 190, 3] ;Intro over, set v9 to 0
type = VarSet
trigger1 = Time = 60
v = 9
value = 0

[State 190, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 0

