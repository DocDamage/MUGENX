; ここにキャラ情報を書いてください
[Info]
name = "Jhun Hoon"        ;キャラの名前
displayname = "Jhun Hoon" ;表示されるキャラの名前
versiondate = 11,22,2000    ;キャラの更新情報
mugenversion = 11,22,2000   ;キャラが動くmugenのバージョン
author = "adamskie"         ;キャラの製作者名
;pal.defaults = 6,3,4,2      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = hoon.cmd   ;キャラのコマンド
cns     = hoon.cns   ;キャラのプログラム
st      = hoon.cns   ;キャラのプログラム
st2     = hoon_s.cns
st3     = hoon_h.cns
st4     = hoon_t.cns
stcommon = common_hoon.cns 
sprite  = hoon.sff   ;キャラの絵
anim    = hoon.air   ;キャラの動き
sound   = hoon.snd   ;キャラの音
pal1    = hoon.act  ;キャラの色（最大１２個）
pal2     = hoon2.act
pal3     = hoon4.act
pal4     = hoon3.act
pal5     = hoon5.act
pal6     = hoon6.act