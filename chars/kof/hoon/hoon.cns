;ダッシュ
[Statedef 100]
type = S
movetype = I
physics = S
anim = 100
velset = 0,0
ctrl = 0

[State 100, 9]
type = ChangeState
trigger1 = AnimTime = 0
value = 101

[Statedef 101]
type = S
movetype = I
physics = N
anim = 101

[State 101, 1]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.fwd.x)

[State 101, 2]
type = PlaySnd
trigger1 = AnimElem = 2
value = s600,0

[State 101, 8]
type = ChangeState
trigger1 = Command = "holdup"
value = 40

[State 101, 9]
type = ChangeState
trigger1 = Command != "holdfwd"
value = 0
ctrl = 1

