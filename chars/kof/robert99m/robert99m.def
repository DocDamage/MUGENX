; Definition file for baom
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Robert Garcia"        ;Name of character
displayname = "Robert" ;Name of character to display
versiondate = 3,29,2001       ;Version date of character
mugenversion = 11,29,2000     ;Version of M.U.G.E.N character works on
author = "Misamu K Young"     ;Character author name
pal.defaults = 1,2,3,4        ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = robert99m.cmd   ;Command set
cns     = robert99m.cns   ;Constants
st      = robert99m.cns   ;States
stcommon = common1.cns ;Common states
sprite  = robert99m.sff   ;Sprite
anim    = robert99m.air   ;Animation
sound   = robert99m.snd   ;Sound
pal1    = 0.act
pal2    = 1.act
pal3    = 2.act
pal4    = 3.act
pal5    = 4.act
pal6    = 5.act


