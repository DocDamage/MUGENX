; Definition file for whip
; Contains all the filenames needed for the character

; Player information
[Info]
name = "whip"        ;Name of character
displayname = "whip" ;Name of character to display
versiondate = 08,17,2000    ;Version date of character
mugenversion = 06,27,2000   ;Version of M.U.G.E.N character works on
author = "ryokucha"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = whip.cmd   ;Command set
cns     = whip.cns   ;Constants
st      = whipnormal.cns   ;States
st1      = whipsuper.cns   ;States
st2      = whipex.cns
stcommon = whipcom.cns ;Common states
sprite  = whip.sff   ;Sprite
anim    = whip.air   ;Animation
sound   = whip.snd   ;Sound
pal1    = whip1.ACT  ;Palettes (can have up to 12)
pal2    = whip2.ACT
pal3    = whip3.ACT
pal4    = whip4.ACT
pal5    = whip5.ACT
pal6    = whip6.ACT
pal7    = whip7.ACT
pal8    = whip8.ACT

