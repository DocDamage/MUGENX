type = VarSet
trigger1 = MatchNo = 1
var(42) = 125
;------------------------ Y
[State 5900, 8]
type = VarSet
trigger1 = MatchNo = 1
var(43)= 224
;Var̐lM邱ƂɂQ[Wʒu̎ݒ肷邱Ƃo܂B
;===========================================================================
; ύXs
