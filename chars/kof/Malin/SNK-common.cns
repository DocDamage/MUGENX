; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 5900, 1] 
type = VarRangeSet
trigger1 = roundno = 1
first = 49
last = 49
value = 0

[State 1000, 3]
type = VarRangeSet
trigger1 = roundno >= 1 
first = 0
last = 29
value = 0

[State 1000, 3]
type = VarRangeSet
trigger1 = roundno >= 1 
first = 31
last = 48
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundno = 1
fvalue = 0

;===========================================================================
; ύXs
;===========================================================================
;---------------------------------------------------------------------
; VXeݒ
[State 5900, 1] 
type = VarRangeSet
trigger1 = MatchNo = 1
trigger1 = roundno = 1
first = 30
last = 30
value = -1
;-1:ZNgL 
;0`2:VXeZNgŒ(0:No System 1:KOF2002 2:SVCj
;lύX邱ƂŃVXe̐ݒ邱Ƃo܂B

