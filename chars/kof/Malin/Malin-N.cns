;===============================================================================
; Definition of the Basic Action
;===============================================================================

;-------------------------------------------------------------------------------
; _bV
[Statedef 100]
type    = S
movetype = I
physics = N
anim = 100
ctrl = 0

[State 100,0]
type = PosAdd
trigger1 = AnimElem = 4,=0
x = 10

[State 100,1]
type = PlaySnd
trigger1 = Time%68=0
value = 1, 0
channel = 2

[State 100,0]
type = VelSet
trigger1 = AnimElem = 6
x = Const(velocity.run.fwd.x)

[State 100,4]
type = ChangeState
trigger1 = Command != "holdfwd" && Time >= 15
value = 101
ctrl = 1

[State 100,5]
type = ChangeState
trigger1 = Command = "holdupfwd"
value = 40

[State 100,6]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

;-------------------------------------------------------------------------------
; OhtgXebv
[Statedef 110]
type    = S
movetype = I
physics = N
anim = 110
ctrl = 0

[State 100, 1]
type = VelSet
trigger1 = AnimElem = 4
x = const(velocity.run.fwd.x)*1.5

[State 100, 1]
type = VelMul
trigger1 = AnimElem = 4,> 0
x = .93

[State 105,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 3,=1
value = 1, 12

[State 100,6]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100,5]
type = ChangeState
trigger1 = Command = "holdupfwd"
value = 40

[State 100,4]
type = ChangeState
trigger1 = AnimTime = 0
value = 101
ctrl = 1

