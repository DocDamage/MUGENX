; Definition file for Mary
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Blue Mary"
displayname = "Blue Mary"
versiondate = 06,27,2000    ;Version date of character
mugenversion = 06,27,2000   ;Version of M.U.G.E.N character works on
author = "TESTP"            ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = Mary.cmd   ;Command set
cns     = Mary.cns   ;Constants
st      = Mary.cns   ;States
st1     = Mary-s.cns ;States (her supers)
stcommon = common1.cns     ;Common states
sprite  = Mary.sff   ;Sprite
anim    = Mary.air   ;Animation
sound   = Mary.snd   ;Sound
pal1    = mary06.act  ;Palettes
pal2    = mary04.act  ;
pal3    = mary02.act  ;
pal4    = mary05.act  ;
pal5    = mary03.act  ;
pal6    = mary01.act  ;
