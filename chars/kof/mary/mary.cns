; WIN
[Statedef 180]
type = S

[State 180, 1]
type = VarRandom
trigger1 = 1
v = 1
range = 0,100

[State 180, 2] ;Choose win1
type = VarSet
trigger1 = Command = "hold_a"
var(1) = 0

[State 180, 3] ;Choose win2
type = VarSet
trigger1 = Command = "hold_d"
var(1) = 33

[State 180, 4] ;Choose win3
type = VarSet
trigger1 = Command = "hold_b"
var(1) = 66

[State 180, 2]
type = ChangeState
trigger1 = Var(1) < 30
value = 181

[State 180, 3]
type = ChangeState
trigger1 = Var(1) = [33,65]
value = 182

[State 180, 4]
type = ChangeState
trigger1 = 1;var(1) >= 66
value = 183

