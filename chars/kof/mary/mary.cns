;---------------------------------------------------------------------------
; States that are always checked (use -2) :
;---------------------------------------------------------------------------

[Statedef -2]

;Stop sound channel 2 when hit
[State -2, 1]
type = StopSnd
triggerall = Time = 0
trigger1 = movetype = H
channel = 2

;---------------------------------------------------------------------------
; States that are always checked when in self's rc (use -3) :
;---------------------------------------------------------------------------

[Statedef -3]

; Play "heh" sound when recovering in air or on ground
[State -3, 1]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 5201
trigger2 = stateno = 5210
value = 0,1
channel = 0

; Play sound when jumping
[State -3, 1]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 50
trigger2 = stateno = 2040
value = 30,0

; Play sound when landing
[State -3, 1]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52
trigger2 = stateno = 106
value = 30,2

; Play sound when running
[State -3, 1]
type = PlaySnd
triggerall = stateno = 100
trigger1 = AnimElem = 3, -1
trigger2 = AnimElem = 6, -1
value = 30,2

; Play "ow" sound when hit
[State -3, 1]
type = PlaySnd
triggerall = Time = 1
triggerall = alive
trigger1 = stateno = 5001
trigger1 = anim != 5000 ;Not hit light
trigger1 = anim != 5010 ;Not hit light
trigger2 = stateno = 5040
trigger2 = random < 400
trigger3 = stateno = 5050
trigger4 = stateno = 5011
trigger4 = anim != 5020 ;Not hit light
value = 5,1 + (random % 2)
channel = 1
lowpriority = 1
;volume = -30

; Get rid of trailing anims when hit
[State -3, 1]
type = AfterImageTime
triggerall = Time = 0
trigger1 = stateno = 5000
trigger2 = stateno = 5010
trigger3 = stateno = 5020
trigger4 = stateno = 5070
time = 0

