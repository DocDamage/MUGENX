; Definition file for kfm
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Brian Battler"        ;Name of character
displayname = "Brian" ;Name of character to display
versiondate = 05,21,2001    ;Version date of character
mugenversion = 11,29,2000   ;Version of M.U.G.E.N character works on
author = "Fangke"         ;Character author name

; Files for the player
[Files]
cmd     = Brian.cmd   ;Command set
cns     = Brian.cns   ;Constants
st      = Brian.cns   ;States
st1     = BrianNA.cns ;States
st2     = BrianSA.cns ;States
st3     = BrianHA.cns ;States
stcommon = common1.cns ;Common states
sprite  = Brian.sff   ;Sprite
anim    = Brian.air   ;Animation
sound   = Brian.snd   ;Sound
pal1    = Brian1.act  ;Palettes (can have up to 12)
pal2    = Brian2.act
pal3    = Brian7.act
pal4    = Brian4.act
pal5    = Brian5.act
pal6    = Brian8.act
pal7    = Brian3.act
pal8    = Brian6.act