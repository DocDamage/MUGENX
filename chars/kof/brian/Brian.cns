;'98跳跃系统
[Statedef 40]
type=S
physics=S
anim=40
ctrl=0

[State 40,var8初始化]
type=VarSet
trigger1=Time=0
var(8)=0

[State 40,前跳]
type=VarSet
trigger1=command="holdfwd"
trigger1=var(8)!=2
var(8)=1

[State 40,后跳]
type=VarSet
trigger1=command="holdback"
trigger1=var(8)!=-2
var(8)=-1

[State 40,大前跳]
type=VarSet
triggerall=Time=0
triggerall=command="holdfwd"
trigger1=command="longjump"
trigger2=prevstateno=100
var(8)=2

[State 40,大后跳]
type=VarSet
trigger1=Time=0
trigger1=command="holdback"
trigger1=command="longjump"
var(8)=-2

[State 40,残影]
type=Afterimage
trigger1=prevstateno=100
trigger1=sysvar(1)=1
time=17
length=9
PalBright=0,0,0
PalContrast=128,128,128
PalAdd=0,0,0
PalMul=1,1,1
FrameGap=4
Trans=Add1

[State 40,普通跳声音]
type=PlaySnd
trigger1=Time=0
trigger1=var(8)!=-2
trigger1=var(8)!=2
value=100,1

[State 40,设定速度方向]
type=VelSet
trigger1=AnimTime=0
x=ifelse(var(8)=0,const(velocity.jump.neu.x),ifelse(var(8)>0,const(velocity.jump.fwd.x),const(velocity.jump.back.x)))
y=const(velocity.jump.y)

[State 40,转向小/大跳设定]
type=ChangeState 
triggerall=AnimTime=0
trigger1=var(8)!=0
trigger1=var(8)!=1
trigger1=var(8)!=-1
trigger1=command="holdup"
trigger2=command!="holdup"
value=49

[State 40,转向跳跃处理]
type=ChangeState 
trigger1=AnimTime=0
value=50
ctrl=1

