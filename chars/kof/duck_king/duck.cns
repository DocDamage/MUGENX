;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

;空中回復時のSE
[State -2, 1]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 5201
trigger2 = stateno = 5210
value = S50,8

;ジャンプ時のSE
[State -2, 1]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 50
trigger2 = stateno = 2040
value = S10,2

;着地
[State -2, 1]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52
value = S10,5

;バウンド
[State -2, 1]
type = PlaySnd
triggerall = stateno = 5100
triggerall = Time = 1
trigger1 = alive = 1
value = S50,1

;残像カット
[State -2, 1]
type = AfterImageTime
trigger1 = movetype = H
time = 0

;CPUモードON
[State -2, 10]
type = Varset
triggerall = var(20) != 1
trigger1 = command = "cpu"
trigger2 = command = "cpu2"
trigger3 = command = "cpu3"
trigger4 = command = "cpu4"
trigger5 = command = "cpu5"
trigger6 = command = "cpu6"
trigger7 = command = "cpu7"
trigger8 = command = "cpu8"
trigger9 = command = "cpu9"
trigger10 = command = "cpu10"
var(20) = 1

; 音止め
[State -2, 11]
type = StopSnd
trigger1 = MoveType = H
channel = 1 && 2 && 3


