;===========================================================================

; var(1) 技を出すときの声
; var(2) やられたときの声
; var(3) 汎用フラグ
; var(8) ジャンプの種類
; var(10) TOPシステム用
; var(11) ジャストディフェンス用
; var(12) 文字の向き判別フラグ
; var(15) ダックダンスレベル
; var(20) AI判別フラグ
; var(30) 反撃


;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

