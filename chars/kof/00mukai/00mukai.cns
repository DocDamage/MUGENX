;AI_Stand
[Statedef 2]
type = S
physics = S
movetype = I
sprpriority = 2
velset=0,0
anim=0
ctrl = 0

[State 2]
type = ChangeAnim
trigger1 = (Anim != 0) && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 0

[State 2]
type = VelSet
trigger1 = Time = 0
y = 0

[STate 2]
type=PosSet
trigger1 = Time = 0
y = 0

;//////////////////////相手が攻撃
[STate 2]
type = Changestate
triggerall = Roundstate = 2
triggerall = var(1) && fvar(24)
triggerall = statetype != A && ctrl && stateno != 130
triggerall = movetype = I && enemy,movetype = A
triggerall = enemy,hitdefattr = SA,NA,SA,HA,NP,SP,HP
trigger1 = var(23) = [0,1000]
trigger1 = p2bodydist X = [0,120]
value = 130

[STate 2]
type = Changestate
triggerall = Roundstate = 2
triggerall = var(1) && fvar(24)
triggerall = statetype != A && ctrl && stateno != 131
triggerall = movetype = I && enemy,movetype = A
triggerall = enemy,hitdefattr = C,NA,SA,HA,NP,SP,HP
trigger1 = var(23) = [0,300]
trigger1 = p2bodydist X = [0,60]
value = 131

;立ち中キック
[State 2]
type = ChangeState
value = 240
triggerall = Roundstate = 2 && enemy,statetype != L
triggerall = var(1) && fvar(24)
triggerall = statetype != A && ctrl && (enemy,stateno != [5100,5120])
triggerall = movetype = I
triggerall = var(23) = [0,1000]
triggerall = (p2bodydist X = [0,80])
trigger1 = ctrl || (stateno = [100,101])

;立ち強P
[State 2]
type = ChangeState
value = 220
triggerall = Roundstate = 2 && enemy,statetype != L
triggerall = var(1) && fvar(24)
triggerall = statetype != A && ctrl && (enemy,stateno != [5100,5120])
triggerall = movetype = I
triggerall = var(23) = [200,300]
triggerall = (p2bodydist X = [0,80])
trigger1 = ctrl || (stateno = [100,101])

;しゃがみ中パンチ
[State -1]
type = ChangeState
value = 410
triggerall = Roundstate = 2 && enemy,statetype != L
triggerall = var(1) && fvar(24)
triggerall = statetype != A && ctrl
triggerall = movetype = I
triggerall = var(23) = [400,500]
triggerall = (p2bodydist X = [0,50])
trigger1 = ctrl || (stateno = [100,101])

;避け移動
[State -1]
type = ChangeState
value = 300
triggerall = Roundstate = 2
triggerall = var(1) && fvar(24)
triggerall = statetype != A && ctrl
triggerall = movetype = I && (enemy,stateno != [5100,5120])
trigger1 = var(23) = [600,650]
trigger1 = p2bodydist X = [0,300]
trigger2 = (var(23) = [600,900]) && enemy,movetype = A
trigger2 = p2bodydist X = [0,300]

[State 2]
type = changestate
trigger1 = time >= 10
trigger1 = random < 50
trigger2 = p2bodydist X <= 20
value = 0
ctrl = 1
