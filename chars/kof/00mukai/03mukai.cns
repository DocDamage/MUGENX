;//////////////////////////////////特殊
[Statedef -3]
[State -3]
type=DisplayToClipboard
trigger1=1
text="AI:%d,p2name,:%d";,fvar(34):%f,var(5):%d";,frontedgebodydist:%d,enemy,pos Y:%f"
params=var(1),p2name="tin's mukai";,fvar(34),var(5);frontedgebodydist,enemy,pos Y

;///////////////////////////////////////////////////////////////
[STate -3]
type=varSet
trigger1=roundstate!=2
var(2)=0

[State -3]
type = Helper
triggerall = (Stateno = [190,193])
trigger1 = Var(1) = 0 && fvar(24) = 1
trigger1 = NumHelper(5999)=0
name = "mukai_AI"
id = 5999
helpertype = normal
pos = 0,-9999
postype = p1
stateno = 5999
keyctrl = 1

[State -3]
type = Helper
triggerall = movetype = A
triggerall = NumHelper(3990)=0
trigger1 = stateno = 3100 && animelem = 5,>= 0
trigger2 = stateno = 3200 && animelem = 7,>= 0
trigger3 = stateno = 3300 && animelem = 3,>= 0
trigger4 = stateno = 3400 && animelem = 5,>= 2
name = "back"
id = 3990
helpertype = normal
pos = 0,-9999
postype = p1
stateno = 3990
keyctrl = 1

;---------------------------------------------
[State -3];ヒット数用
type = varset
triggerall = enemy,movetype != H
trigger1 = stateno = 190 || stateno = 5900
trigger2 = enemy,stateno = 0 || enemy,stateno = 52 || enemy,stateno = 5040
trigger3 = movetype != A
var(5) = 0

[State -3];ヒット数用
type = varset
trigger1 = stateno = 56
var(5) = 0

[State -3]
type = varadd
trigger1 = Movehit = 1 && HitPauseTime = 1
trigger1 = (p2stateno != [800,999]) && (p2stateno != [1500,1520])
var(5) = 1
ignorehitpause = 1

[State -3]
type = varset
trigger1 = var(5) != 0
fvar(5) = ifelse(var(5),.7,1.4)
ignorehitpause = 1

[State -3]
type = varset
trigger1 = var(5) = 0
fvar(5) = 0
ignorehitpause = 1

[State -3]
type = velset
triggerall = (prevstateno = [100,101])
triggerall = time = 1
trigger1 = stateno = [200,255]
trigger2 = stateno = [400,450]
x = const(velocity.run.fwd.x)

[STate -3]
type = varadd
trigger1 = enemy,stateno = 4120
trigger1 = enemy,time = 1
var(10) = 1

[STate -3]
type = varset
trigger1 = enemy,stateno = 0
trigger2 = enemy,stateno = 5120
var(10) = 0

;/////////////////////////////
[State -3];大ジャンプ関連
type = varSet
triggerall = var(12)
trigger1 = statetype = A
trigger2 = MoveType = A || Movetype = H
trigger3 = command = "holddown2"
trigger4 = stateno = 52 || stateno = 50 || stateno = 56
trigger5 = stateno = 0
trigger5 = time >= 3
trigger6 = stateno = [10,12]
trigger6 = time >= 6
trigger7 = stateno = 20
trigger7 = time >= 5
var(12) = 0

[State -3]
type = Explod
triggerall = time%5 = 0
triggerall = vel Y < 0
trigger1 = stateno = 56
trigger2 = anim = 601 || anim = 611 || anim = 621 || anim = 631 || anim = 636 || anim = 641 || anim = 651
anim = 2280
id = 2280
pos = 0,-45
postype = p1
random = 40,90
ownpal = 1
sprpriority = 3

[State -3]
type = varSet
triggerall = var(12) = 0
triggerall = movetype != A
trigger1 = command = "down"
trigger1 = stateno != 52 && stateno != 50 && stateno != 56
