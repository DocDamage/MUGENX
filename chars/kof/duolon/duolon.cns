;==============================================================
;var(0)コマンド判別
;var(1)Fall中攻撃ヒット
;var(2)Fall中攻撃ヒット　Hitdef制御
;var(3)幻魔飛翔軽功・秘伝・幻夢怨霊壁　Hitdef制御
;var(4・14)奥義・多重幻影暗勁　時間
;var(5)投げ抜け用
;var(6)～var(8)奥義・多重幻影暗勁　animelemtime
;var(9)ジャンプ関連
;var(10)1pか2p判別
;var(11)～var(13)カウンターヒット関連
;var(15)ガーキャン用
;var(16)ジャンプ識別
;var(17)幻無脚ヒット制御
;var(18)死両撥生斤制限
;var(19)半数補正用
;var(20)スパキャン用
;var(21・25)varrandom
;var(22)～var(23)死亡関係
;var(24)試合終了時演出用
;==============================================================
;helper,var(0)空中攻撃ヒット
;helper,var(1・3)movecontact時の攻撃判定増加用
;helper,var(2)空中攻撃ヒット　Hitdef制御
;helper,var(4)カウンターヒット関連
;==============================================================
;fvar(0)奥義・多重幻影暗勁　空中攻撃Vel X
;fvar(1)奥義・多重幻影暗勁　空中攻撃Vel Y
;fvar(2)ダメージ補正用
;==============================================================
;helper,fvar(0・4)奥義・多重幻影暗勁　空中攻撃（最初）Vel X
;helper,fvar(1・5)奥義・多重幻影暗勁　空中攻撃（最初）Vel Y
;helper,fvar(2・6)奥義・多重幻影暗勁　空中攻撃（本体攻撃ヒット後）Vel X
;helper,fvar(3・7)奥義・多重幻影暗勁　空中攻撃（本体攻撃ヒット後）Vel Y
;==============================================================
;channel=1　ダッシュ
;channel=2　幻魔飛翔軽功
;channel=3　秘伝・幻夢怨霊壁
;==============================================================

[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 20
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 20
ground.front = 20
air.back = 15
air.front = 15
height = 60
attack.dist = 0;160
proj.attack.dist = 90
proj.doscale = 0
head.pos = 3, -100
mid.pos = 0, -70
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 2.0
walk.back = -2.0
run.fwd  = 4.6, 0
run.back = -4.5,-3.8
jump.neu = 0,-9.7
jump.back = -3
jump.fwd = 3
runjump.back = -2.55,-8.1
runjump.fwd = 4,-8.1
airjump.neu = 0,-8.1
airjump.back = -2.55
airjump.fwd = 2.5

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .58
stand.friction = .85
crouch.friction = .82

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
velset = 0,0
sprpriority = 1
facep2 = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State -2]
type = varset
trigger1 = sysvar(1) != 1 && (prevstateno = [100,102])
v = 9
value = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)+ifelse(command != "holdup",2.2,0)

[State 40, 5]
type = VelSet
triggerall = AnimTime = 0
trigger1 = (prevstateno = [100,101]) && sysvar(1) = 1
trigger2 = var(9) >= 0
x = ifelse(sysvar(1)=0,0,ifelse(sysvar(1) = 1,4.5,-4.5))

[State 40, 2]
type = AfterImage
triggerall = AnimTime = 0 && var(4) <= 0
trigger1 = (prevstateno = [100,101]) && sysvar(1) = 1
trigger2 = var(9) >= 0
time = 9999999
length = 8
framegap = 3
trans = add1
palcontrast = 100,100,100
PalAdd = 0,0,0
palmul = 1,1,1

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = ifelse(command != "holdup",60,50)
ctrl = 1

;---------------------------------------------------------------------------
