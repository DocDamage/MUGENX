y = 0

[State 53, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 53, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 53, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; AGUARDHIT2 (knocked away)
[Statedef 155]
type    = A
movetype= H
physics = N
anim = 152

[State 155, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1
y = 1

[State 155, 2]
type = VelAdd
trigger1 = 1
y = Const(movement.yaccel)

[State 155, 3]
type = CtrlSet
trigger1 = Time = GetHitVar(ctrltime)
value = 1

[State 155, 4]
type = VarSet
trigger1 = 1
sysvar(0) = (pos y >= 0) && (vel y > 0)

[State 155, 5]
type = VelSet
trigger1 = sysvar(0)
y = 0

[State 155, 6]
type = PosSet
trigger1 = sysvar(0)
y = 0

[State 155, 7]
type = VarSet
trigger1 = time = 0
var(2) = 0

[State 155, 8]
type = VarSet
trigger1 = command = "recoveryg"
trigger1 = pos y >= -50 && vel y > 0
var(2) = 1

[State 155, 9]
type = ChangeState
trigger1 = sysvar(0)
trigger1 = var(2)
value = 5201

[State 155, 10]
type = ChangeState
trigger1 = sysvar(0)
trigger1 = command != "holdback"
value = 52

[State 155, 11]
type = ChangeState
trigger1 = sysvar(0)
value = 130

;---------------------------------------------------------------------------
; タイムオーバーで負けた時
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
;勝った動作分岐
[Statedef 180]
type = S

[State 180, 1]
type = VarRandom
trigger1 = 1
v = 1
range = 1,100

[State 180, 2]
type = VarSet
trigger1 = Command = "holdx"
var(1) = 1

[State 180, 3]
type = VarSet
trigger1 = Command = "holda"
var(1) = 21

[State 180, 4]
type = VarSet
trigger1 = Command = "holdz"
var(1) = 41

[State 180, 5]
type = VarSet
trigger1 = Command = "holdy"
var(1) = 61

[State 180, 6]
type = VarSet
trigger1 = Command = "holdb" || Command = "holdc"
var(1) = 81

[State 180, 7]
type = ChangeState
trigger1 = var(1) = [ 1,40]
value = 182

[State 180, 8]
type = ChangeState
trigger1 = var(1) = [41,60]
value = 183

[State 180, 9]
type = ChangeState
trigger1 = var(1) = [61,100]
value = 181

;---------------------------------------------------------------------------
;勝った動作（立ち合掌）
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 181, 2]
type = PlaySnd
trigger1 = AnimElem = 3 && var(1) = [61,80]
value = 195,0

[State 181, 3]
type = PlaySnd
trigger1 = AnimElem = 3 && var(1) = [81,100]
value = 180,1

[State 181, 4]
type = AssertSpecial
trigger1 = time = [1,400]
flag = RoundNotOver

;---------------------------------------------------------------------------
;勝った動作（浮き合掌）
[Statedef 182]
type = S
physics = N
ctrl = 0
anim = 182
velset = 0,0

[State 182, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 182, 2]
type = PlaySnd
trigger1 = time = 16 && var(1) = [ 1,20]
value = 180,0

[State 182, 3]
type = PlaySnd
trigger1 = time = 16 && var(1) = [21,40]
value = 180,1

[State 182, 4]
type = velset
trigger1 = time > 16
y =  cos(0.25 * time)

[State 182, 5]
type = AssertSpecial
trigger1 = time = [1,400]
flag = RoundNotOver

;---------------------------------------------------------------------------
;勝った動作（浮き笑い）
