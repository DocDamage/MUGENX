[State 183, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 183, 2]
type = PlaySnd
trigger1 = time = 16
value = 180,0

[State 183, 3]
type = velset
trigger1 = time > 16
y =  cos(0.25 * time)

[State 183, 4]
type = AssertSpecial
trigger1 = time = [1,400]
flag = RoundNotOver

