;---------------------------------------------------------------------------
;スライドヘッド
[Statedef 1000]
type    = S
movetype= A
physics = S
ctrl = 0
velset = 0,0
anim = 1000
sprpriority = 2

[State 1000,HitDef]
type = HitDef
trigger1 = Time = 0 && Var(21) = 0
attr = S,SA
animtype  = Hard
damage = ifelse(P2movetype = A,150,100)
hitflag = MA
guardflag = MA
pausetime = 20,20
guard.pausetime = 12,12
sparkno = s51
guard.sparkno = s61
sparkxy = -15,ifelse(P2StateType = A,-100,-70)
hitsound = s6,0
guardsound = s2,0
ground.type = Low
ground.slidetime = 20
ground.hittime = 15
ground.velocity = -4,-6
ground.cornerpush.veloff = 0
air.velocity = -3.5,-7
air.cornerpush.veloff = 0
getpower = ifelse(Var(25) = 1,0,140)
yaccel = .5
fall = 1
fall.recovertime = 15

[State 1000,PalFx]
type = PalFx
triggerall = GameTime%2 = 1
triggerall = Var(25) = 1 && MoveContact
trigger1 = command = "FDFDDBBa" || command = "FDFDDBBb"
trigger2 = command = "FDDFa" || command = "FDDFb"
trigger3 = command = "DDFFa" || command = "DDFFb"
trigger4 = command = "DDFFx" || command = "DDFFy"
add = 255,255,255
ignorehitpause = 1
Time = 1

;---------------------------
[State 1000,ChangeState]
type = ChangeState
triggerall = Var(25) = 1 && MoveContact
trigger1 = command = "FDFDDBBa" || command = "FDFDDBBb"
value = ifelse(command = "FDFDDBBa",1400,1401)
[State 1000,ChangeState]
type = ChangeState
triggerall = Var(25) = 1 && MoveContact && Palno <= 6
trigger1 = command = "FDDFa" || command = "FDDFb"
value = ifelse(command = "FDDFa",1300,1301)
[State 1000,ChangeState]
type = ChangeState
triggerall = Var(25) = 1 && MoveContact && Palno <= 6
trigger1 = command = "DDFFa" || command = "DDFFb"
value = ifelse(command = "DDFFa",1500,1550)
[State 1000,ChangeState]
type = ChangeState
triggerall = Var(25) = 1 && MoveContact && Palno > 6
trigger1 = command = "DDFFx" || command = "DDFFy"
value = ifelse(command = "DDFFx",3000,3010)
[State 1000,ChangeState]
type = ChangeState
triggerall = Var(25) = 1 && MoveContact && Palno <= 6
trigger1 = command = "DDFFx" || command = "DDFFy"
value = ifelse(command = "DDFFx",1100,1110)
[State 1020,ChangeState]
type = ChangeState
triggerall = Var(25) = 1 && MoveContact && Palno > 6
trigger1 = command = "BDBDDFFa" || command = "BDBDDFFb"
value = ifelse(command = "BDBDDFFa",3400,3450)
[State 1020,ChangeState]
type = ChangeState
triggerall = Var(25) = 1 && MoveContact && Palno > 6
trigger1 = command = "FDDFx" || command = "FDDFa"
value = ifelse(command = "FDDFx",3100,3110)
[State 1020,ChangeState]
type = ChangeState
triggerall = Var(25) = 1 && MoveContact && Palno > 6
trigger1 = command = "FDDFy" || command = "FDDFb"
value = ifelse(command = "FDDFy",3120,3130)
;---------------------------

[State 1000,MoveHitReset]
type = MoveHitReset
trigger1 = MoveContact

[State 1000,EnvShake]
type = EnvShake
trigger1 = MoveHit
time = 20
freq = 90
ampl = 4
phase = 0
ignorehitpause = 1
persistent = 0

[State 1000,ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

