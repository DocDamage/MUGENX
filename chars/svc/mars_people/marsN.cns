trigger1 = Time = 0 && Var(21) = 0
attr = S,SA
animtype  = Hard
damage = 0
hitflag = MA
guardflag = MA
pausetime = 30,30
guard.pausetime = 12,12
sparkno = s51
guard.sparkno = s61
sparkxy = -15,ifelse(P2StateType = A,-100,-70)
hitsound = s6,0
guardsound = s2,0
ground.type = Low
ground.slidetime = 20
ground.hittime = 15
ground.velocity = -4,-6
ground.cornerpush.veloff = 0
air.velocity = -3.5,-7
air.cornerpush.veloff = 0
