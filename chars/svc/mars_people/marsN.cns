;---------------------------------------------------------------------------
; 各種ジャンプ
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
velset = 0,0,0

[State 40,Turn]
type = Turn
trigger1 = time = 0 && P2dist X < 0

[State 40,VarSet]
type = VarSet
trigger1 = Time = 0
var(20) = 0

[State 40,VarSet]
type = VarSet
trigger1 = command = "holdfwd"
trigger1 = Var(20) != 2
var(20) = 1

[State 40,VarSet]
type = VarSet
trigger1 = command = "holdback"
trigger1 = Var(20) != -2
var(20) = -1

[State 40,VarSet]
type = VarSet
triggerall = Time = 0
triggerall = command != "holdfwd" || Command != "holdback"
trigger1 = command = "longjump"
trigger2 = PrevStateno = 100
var(20) = 3

[State 40,VarSet]
type = VarSet
triggerall = Time = 0
trigger1 = command = "holdfwd"
trigger1 = command = "longjump"
var(20) = 2

[State 40,VarSet]
type = VarSet
trigger1 = Time = 0
trigger1 = Command = "holdback"
trigger1 = Command = "longjump"
var(20) = -2

[State 40,ChangeState]
type = ChangeState
triggerall = AnimTime = 0
trigger1 = Var(20) != 0
trigger1 = Var(20) != 1
trigger1 = Var(20) != -1
trigger1 = Command = "holdup"
trigger2 = Command != "holdup"
value = 48

[State 40,PlaySnd] 
type = PlaySnd
trigger1 = AnimTime = 0
value = s20,0
channel = 7

[State 40,VelSet]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(var(20)=0, const(velocity.jump.neu.x), ifelse(var(20)>0, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40,ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; ジャンプ
[Statedef 48]
type    = A
physics = A
velset = 0,-10
ctrl = 1
anim = 41

[State 40,PlaySnd] 
type = PlaySnd
triggerall = Time = 0
trigger1 = Var(20) = -2
trigger2 = Var(20) = 2
trigger3 = Var(20) = 3
value = s20,1

[State 48,StopSnd]
type = StopSnd
triggerall = Time = 0
trigger1 = Var(1) = -2
trigger2 = Var(1) = 2
trigger2 = Var(1) = 3
channel = 7

[State 48,AfterImage]
type = AfterImage
triggerall = Time = 0
trigger1 = Var(20) = -2
trigger2 = Var(20) = 2
trigger3 = Var(20) = 3
Time = 10
Trans = none
Length = 10
FrameGap = 4
PalContrast = 160,160,160
PalColor = 256
PalAdd = 0,0,0
PalMul = 1,1,1
PalBright = 21,21,21

[State 48,VelSet] 
type = VelSet
trigger1 = Time = 0
trigger1 = Command = "holdup"
y = -10

[State 48,VelSet]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(20) = 2
x = 3.5

[State 48,VelSet]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(20) = -2
x = -3.5

