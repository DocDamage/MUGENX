value = s250,1

[State 705,Pause]
type = Pause
trigger1 = Time = 0
time = 4
movetime = 4

[State 705,NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 705,PalFx]
type = PalFx
trigger1 = GameTime % 2 && Time = [0,5]
add = 200,200,200
Time = 1

[State 705,HitDef]
