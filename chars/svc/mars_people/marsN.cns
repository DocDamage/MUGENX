;Var(10)=マーズショット
;Var(11)=プラズマアブダクション
;Var(12)=先行入力β
;Var(13)=ヘルパーヒット

;Var(20)=ジャンプ
;Var(21)=空中判定抑止
;Var(22)=空中弱攻撃プッシュ
;Var(23)=空中強攻撃プッシュ
;Var(24)=ボタン認識ずらし
;Var(25)=MAX関連1
;Var(26)=MAX関連2
;Var(27)=エクシード規制
;Var(28)=スタイルチェンジ
;Var(29)=AI

;Var(30)=エクシード設定
;Var(31)~=コンフィグ

[Data]
life = 1000
attack = 80
defence = 100
fall.defence_up = 50
liedown.time = 10
airjuggle = 15
sparkno = -1
guard.sparkno = -1
KO.echo = 0
volume = 0
IntPersistIndex = 25,27,29
FloatPersistIndex = 40

[Size]
xscale = 1           
yscale = 1           
ground.back = 18     
ground.front = 18    
air.back = 14        
air.front = 14       
height = 60          
attack.dist = 160
proj.attack.dist = 120
proj.doscale = 0
head.pos = -5, -100
mid.pos = -5, -60
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 2.5
walk.back = -2.5
run.fwd  = 7, 0
run.back = -7,-3
jump.neu = 0,-10
jump.back = -2,-10
jump.fwd = 2,-10
runjump.back = -2.55,-8.1
runjump.fwd = 4.2,-8.3
airjump.neu = 0,-8.3
airjump.back = -2.57
airjump.fwd = 2.7

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .45
stand.friction = .85
crouch.friction = .82

