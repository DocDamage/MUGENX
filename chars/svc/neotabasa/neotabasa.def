;+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
; Definition file for tabasa
; Made by ryokucha
;+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
; Player information
[Info]
name = "Tabasa"        ;Name of character
displayname = "Tabasa" ;Name of character to display
versiondate = 08,28,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "ryokucha"         ;Character author name
;pal.defaults = 6,3,4,2      ;Default palettes in order of preference
pal.defaults = 1,2,3,4

; Files for the player
[Files]
cmd     = tabasa.cmd   ;Command set
cns     = tabasa.cns   ;Constants
st      = tabanormal.cns   ;States
st1      = tabanormal2.cns   ;States
st2      = tabasuper.cns   ;States
st3      = tabasuper2.cns   ;States
st4      = tabasuper3.cns   ;States
st5      = tabasuper4.cns   ;States
st6      = tabasuper5.cns   ;States
st7      = tabasuper6.cns   ;States
st8      = tabasuper7.cns   ;States
st9      = tabasuper8.cns   ;States
stcommon = tabacom.cns ;Common states
sprite  = neotabasa.sff   ;Sprite
anim    = tabasa.air   ;Animation
sound   = tabasa.snd   ;Sound
pal1    = tabasa1.ACT  ;Palettes (can have up to 12)
pal2    = tabasa2.ACT
pal3    = tabasa3.ACT
pal4    = tabasa4.ACT
pal5    = tabasa5.ACT
pal6    = tabasa6.ACT
;pal7    = tabasa7.ACT