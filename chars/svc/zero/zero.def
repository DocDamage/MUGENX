; Definition file for Zero
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Zero"		;Name of character
displayname = "Zero"	;Name of character to display
versiondate = 2003.5.17	;Version date of character
mugenversion = 2001.04.14 ;Version of M.U.G.E.N character
author = "N64Mario"	;Character author name
pal.defaults = 1,2,3,4,5,6 ;Default palettes in order of preference

;--------------------
;[Common Files] 
;--------------------
[Files]
cmd	= zero.cmd	;Command set
cns	= constant.cns	;Constants
stcommon = common.cns	;Common states
sprite	= zero.sff	;Sprite
anim	= zero.air	;Animation
sound	= zero.snd	;Sound
;--------------------
;[States] 
;--------------------
st	= zero.cns	;States
st2	= zero-s.cns	;Special Moves
st3	= zero-h.cns	;Hyper Moves
st4	= override.cns	;Override States
st5	= helpers.cns	;Helper States
st6	= cybr-elf.cns	;Cyber-Elf States
st7	= zero.def	;Misc. States
;--------------------
;[Palettes] (can have up to 12)
;--------------------
pal1	= zerocvs.act
pal2	= zerocvs2.act
pal3	= zerocvs3.act
pal4	= zerocvs4.act
pal5	= zerocvs5.act
pal6	= zerocvs6.act
pal7	= matr-cvs.act
pal8	= matr-cvs.act
pal9	= matr-cvs.act
pal10	= silv-cvs.act
pal11	= silv-cvs.act
pal12	= silv-cvs.act

;------------------------------------------------------------
; Shield
[Statedef 1302]
type    = A
movetype= A
physics = N
sprpriority = 2
velset = 0
ctrl = 0

[State 1302, 3]
type = ChangeAnim
trigger1 = Root, Anim = 1300
trigger2 = Root, Anim = 1301
value = Root, Anim + 50
elem = Root, AnimElemNo(0)

[State 1302, 0]
type = BindToRoot
trigger1 = 1
pos = 0, 0
facing = 1

[State 1302, Hit]
type = NotHitBy
trigger1 = 1
value = SCA, AA, AT
time = 2

[State 1302, Hit]
type = HitBy
trigger1 = 1
value = SCA, AP
time = 2

[State 1302, Hit]
type = HitOverride
trigger1 = 1
attr = SCA, AP
stateno = 1302
time = 2

[State 1302, AfterImage]
type = AfterImage
trigger1 = Root, Anim = 1300
trigger1 = Root, AnimElem = 2
palcontrast = 0,50,40
palbright = 0,0,0
paladd = 0,0,0
palmul = 1,1,1
trans = Add
framegap = 1
length = 5
time = 1

[State 1302, AfterImageTime]
type = AfterImageTime
trigger1 = 1
time = 2

[State 1302, 1]
type = ReversalDef
trigger1 = MoveContact = 0
reversal.attr = SCA, AP
p2stateno = 1304
sparkno = -1
hitsound = S3,0
guardsound = S3,0
numhits = 0

[State 1302, Destroy]
type = DestroySelf
trigger1 = Root, Anim = 1301
trigger1 = Root, AnimElem = 4
trigger2 = Root, Anim != 1300
trigger2 = Root, Anim != 1301

;------------------------------------------------------------
; Sabre/Triple-Rod Effects
[Statedef 10000]
sprpriority = 5
ctrl = 0

[State 10000, 0]
type = BindToRoot
trigger1 = 1
pos = 0, 0
facing = 1

[State 10000, Anim]
type = ChangeAnim
triggerall = Root, Anim > 160
triggerall = Root, Anim < 5000
triggerall = Root, Anim != 441
triggerall = Root, Anim != 1010
triggerall = Root, Anim != 2101
triggerall = Root, Anim != 2201
triggerall = Root, Anim != 4135
trigger1 = Time <= 0
trigger2 = Anim > 20160
trigger2 = Anim < 30000
value = Root, Anim + 20000
elem = Root, AnimElemNo(0)

[State 10000, 0]
type = SprPriority
trigger1 = 1
value = 10

[State 10000, AfterImage]
type = AfterImage
trigger1 = Time <= 0
palcontrast = 0,50,40
palbright = 0,0,0
paladd = 0,0,0
palmul = 1,1,1
trans = Add
framegap = 1
length = 5
time = 1

[State 10000, AfterImageTime]
type = AfterImageTime
trigger1 = 1
time = 2

[State 10000, Destroy]
type = DestroySelf
trigger1 = Root, Anim != 180
trigger1 = Root, Anim != 190
trigger1 = Root, Anim != 198
trigger1 = Root, Anim != 200
