;------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;------------------------------------------------------------
[Statedef -3]

;------------------------------------------------------------
; Mode Type Variable
;------------------------------------------------------------
[State -3, VarSet]
type = VarSet
trigger1 = 1
v = 40
value = 10

;------------------------------------------------------------
; Clipboard Display Variables
;------------------------------------------------------------
[State -3, Variables]
type = DisplayToClipboard
triggerall = Var(40) = 0
trigger1 = NumHelper(1050) > 0
trigger2 = NumHelper(1051) > 0
trigger3 = NumHelper(1052) > 0
text = "Mode: SvC   Z-Charge:%d"
params = Helper, Var(1)

[State -3, Variables]
type = DisplayToClipboard
triggerall = Var(40) = 0
trigger1 = NumHelper(1050) = 0
trigger1 = NumHelper(1051) = 0
trigger1 = NumHelper(1052) = 0
text = "Mode: SvC"

[State -3, Variables]
type = DisplayToClipboard
triggerall = Var(40) = 10
trigger1 = NumHelper(1050) > 0
trigger2 = NumHelper(1051) > 0
trigger3 = NumHelper(1052) > 0
text = "Mode: CvS   Z-Charge:%d"
params = Helper, Var(1)

[State -3, Variables]
