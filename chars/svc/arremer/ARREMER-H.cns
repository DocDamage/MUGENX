;=====================================================================
; Definition of the Super Arts
;=====================================================================

;-------------------------------------------------------------------------------
; サパータイム
;------------------------ 開始動作
[Statedef 3000]
type = S
movetype = A
physics = S
ctrl = 0
Anim = 3000
velset = 0, 0
poweradd = IfElse(Var(38)=2,0,IfElse(Var(38)=1,-1000,-3000))
juggle = IfElse((PrevStateNo=[1000,2999]),0,8)

[State 1020, PalFX]
type = PalFX
triggerall = GameTime % 2 && Time <= 8 && var(25) = 3
trigger1 = MoveContact=0 && (PrevStateNo = 200 || PrevStateNo = 400 || PrevStateNo = 430)
trigger2 = PrevStateNo = 440
trigger3 = (PrevStateNo=[1150,1160])
time = 1
add = 255,255,255

[State 1030, Varadd(24)]
type = Varadd
triggerall = Time = 0 && Fvar(3) > ifelse(var(38)=2,3.4,4.8)
trigger1 = MoveContact=0 && (PrevStateNo = 200 || PrevStateNo = 400 || PrevStateNo = 430)
trigger2 = PrevStateNo = 440
trigger3 = (PrevStateNo=[1150,1160])
FV = 3
value = -ifelse(var(38)=2,2.88,4.8)

[State 1030, VarSet(24)]
type = VarSet
triggerall = Time = 0 && Fvar(3) <= ifelse(var(38)=2,3.4,4.8)
trigger1 = MoveContact=0 && (PrevStateNo = 200 || PrevStateNo = 400 || PrevStateNo = 430)
trigger2 = PrevStateNo = 440
trigger3 = (PrevStateNo=[1150,1160])
FV = 3
value = 0.1

[State 10000, VarSet(23)]
type = VarSet
trigger1 = Time = 0
var(37) = 1

[State 1130, Super]
type = Helper
trigger1 = Time = 0
persistent = 0
id = 20000
name = "X"
pos = 0,0
postype = P1
stateno = 20000
helpertype = normal
keyctrl = 0
facing = 1

[State 5201,NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA

[State 1201,VelAdd]
type = VelSet
trigger1 = AnimElem = 2
x = -(Backedgedist/18)
y = -9

[State 1201,VelAdd]
type = veladd
trigger1 = AnimElem = 2,>0
y = .35

[State 1200, 9]
type = Width
trigger1 = AnimElem = 2,>0
edge = 0,8

[State 105,StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 2
statetype = A
physics = N

[State 1201,ChangeState]
type = ChangeState
Trigger1 = AnimElem = 8,>=0
Trigger1 = Backedgedist <= 20
value = 3001

[State 1201,ChangeState]
type = ChangeState
trigger1 = AnimElem = 8,>=0
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 3003

