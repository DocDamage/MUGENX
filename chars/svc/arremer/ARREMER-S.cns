;=====================================================================
; Definition of the Special Arts
;=====================================================================

;-------------------------------------------------------------------------------
; ファイアーボール（地上）・弱
[Statedef 1000]
type = S
movetype = A
physics = S
ctrl = 0
anim = 1000
velset = 0, 0
poweradd = ifelse(fvar(3) != 0,0,120)
juggle  = 8

[State 1020, PalFX]
type = PalFX
triggerall = GameTime % 2 && Time <= 8 && var(25) = 3
trigger1 = MoveContact = 0 && (PrevStateNo = 200 || PrevStateNo = 400 || PrevStateNo = 430)
trigger2 = PrevStateNo = 440
trigger3 = (PrevStateNo=[1150,1160])
time = 1
add = 255,255,255

[State 1030, Varadd(24)]
type = Varadd
triggerall = Time = 0 && Fvar(3) > ifelse(var(38)=2,3.4,4.8)
trigger1 = MoveContact = 0 && (PrevStateNo = 200 || PrevStateNo = 400 || PrevStateNo = 430)
trigger2 = PrevStateNo = 440
trigger3 = (PrevStateNo=[1150,1160])
FV = 3
value = -ifelse(var(38)=2,2.88,4.8)

[State 1030, VarSet(24)]
type = VarSet
triggerall = Time = 0 && Fvar(3) <= ifelse(var(38)=2,3.4,4.8)
trigger1 = MoveContact = 0 && (PrevStateNo = 200 || PrevStateNo = 400 || PrevStateNo = 430)
trigger2 = PrevStateNo = 440
trigger3 = (PrevStateNo=[1150,1160])
FV = 3
value = 0.1

[State -3,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1,=0
value = 0, 3
channel = 0

[State -3,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 5,=1
value = 5, 2

[State 3000,Projectile]
type = Projectile
trigger1 = AnimElem = 5,=1
projanim = 1050
ProjHitAnim = -1
projid = 1050
offset = 31,-62
velocity = 4, 0
projmisstime = 3
projhits = 2
projshadow = -1,-1,-1
attr = S, SP
animtype = Back
damage = 45,6
getpower = ifelse(fvar(3) != 0,0,240),ifelse(fvar(3) != 0,0,240)
guardflag = M
pausetime = 1,4
guard.pausetime = 1,2
sparkno = S2020
guard.sparkno = S2070
projedgebound = 100
sparkxy = 0,0
hitsound = S3, 7
guardsound = S4, 1
ground.type = Low
ground.slidetime = 16
ground.hittime  = 16
ground.velocity = -4.5,-6.5
air.hittime = 13
air.velocity = -4.5,-6.5
guard.velocity = -10
air.juggle = 8
air.cornerpush.veloff = 0
fall = 1
fall.recover = 0
yaccel = .5
Palfx.time = 30
palfx.add = 192,96,16
palfx.mul = 224,160,32
palfx.sinadd = 32,96,64,12
palfx.color = 0
palfx.invertall = 1
persistent = 0

[State 1000, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

