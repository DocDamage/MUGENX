value = 183

[State 180, 3]
type = ChangeState
triggerall = var(8) < 500
trigger1 = Time = 1
value = 181

[State 180, 4]
type = ChangeState
triggerall = var(8) >= 500
trigger1 = Time = 1
value = 182

