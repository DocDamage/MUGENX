;---------------------------------------------------------------------------
; -[ Combo Damage Control "Dampener" ]-
[State -2] ; This is the variable that counts the hits of the current combo.
type = VarSet
trigger1 = P2MoveType != H ; If they're not getting hit, there's no combo, so the counter should reset.
trigger1 = P2StateNo != 10250 ; Here is an example state that isn't an H, but perhaps a dizzy state, so the combo is not over yet.  It's actually the TargetState for Blackheart's Roundhouse demons.
trigger1 = !(P2StateNo = 9004 && P2StateType = S && P2MoveType = I) ; This is the same thing, another example.
var(9) = 0
ignorehitpause = 1

[State -2]
type = AttackMulSet
trigger1 = 1
value = fvar(0)
ignorehitpause = 1

[State -2]
type = VarSet
trigger1 = var(9) = 0
fvar(0) = 1
ignorehitpause = 1

