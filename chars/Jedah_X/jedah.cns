trigger1 = roundno = 1
fvalue = 0

[State 5900, 3] ;Intro
type = ChangeState
trigger1 = roundno = 1
value = 190

[State 5900, added] ;Turns mode Intro
type = VarSet
trigger1 = roundsexisted = 0
trigger1 = teammode = Turns
var(20) = 1

[State 5900, added]
type = ChangeState
trigger1 = roundsexisted = 0
trigger1 = teammode = Turns
value = 191

