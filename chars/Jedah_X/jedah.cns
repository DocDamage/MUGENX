[Data]
life = 1000          ;Amount of life to start with
power = 9000         ;Max super level
attack = 80          ;100% attack power (more is stronger)
defence = 100        ;100% defensive power (more is stronger)
fall.defence_up = 50 ;Def goes up by 50% everytime player is hit on ground
liedown.time = 60    ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 15       ;Can do 15 points of juggling
guard.sparkno = 40   ;Default guard spark number
KO.echo = 0          ;1 to enable echo on KO

[Size]
xscale = 1            ;Horizontal scaling factor.
yscale = 1            ;Vertical scaling factor.
ground.back = 17      ;Player width (back, ground)
ground.front = 17     ;Player width (front, ground)
air.back = 12         ;Player width (back, air)
air.front = 12        ;Player width (front, air)
z.width = 3           ;Player width (into and out)
attack.width = 4,4    ;Default attack width: back, front
attack.dist = 160     ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
shadowoffset = -2
head.pos = 0, -100
mid.pos = 0, -66

[Velocity]
walk.fwd  = 3.7
walk.back = -3.25
run.fwd  = 7.5,-3.05
run.back = -7.5,-3.05
jump.neu = 0,-9.5
jump.back = -4.45,-9.5
jump.fwd = 5.425,-9.5

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .5
stand.friction = .82
crouch.friction = .82

;===========================================================================
; JUMP/FLIGHT (common state override)
;===========================================================================
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
triggerall = var(7) = 0
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
triggerall = var(7) = 0
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
triggerall = var(7) = 0
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
triggerall = var(7) = 0
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
triggerall = var(7) = 0
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = IfElse((var(7)>0),510,50)
ctrl = 1

;---------------------------------------------------------------------------
; Jump Down
[Statedef 51]
type    = A

[State 51, 1]
type = StateTypeSet
trigger1 = var(7) <= 0
physics = A

[State 51, 2]
type = StateTypeSet
trigger1 = var(7) > 0
physics = N

[State 51, State]
type = ChangeState
trigger1 = var(7) > 0
value = 510

;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47
velset = 0,0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;===========================================================================
; DASH (common state override)
;===========================================================================
[Statedef 100]
type    = S
physics = S
velset = 0,0
anim = 40
ctrl = 0

[State 100, State]
type = ChangeState
trigger1 = animtime = 0
value = 101
ctrl = 1

[Statedef 101]
type = A
physics = N
velset = 7.5 * const(size.xscale),-3.05
anim = 101
sprpriority = 2

[State 101, DashSound]
type = PlaySnd
trigger1 = time = 0
value = 3,2
channel = 10

[State 101, Blood]
type = Explod
scale = const(size.xscale)
trigger1 = time > 5
trigger1 = time % 2 = 0
anim = 102
postype = p1
pos = -52,-75
sprpriority = 3
bindtime = 1
ownpal = 1

[State 101, State]
type = ChangeState
trigger1 = command != "holdfwd" || time = 44
value = 102

[Statedef 102]
type = A
physics = A

[State 102, Physics]
type = VelMul
trigger1 = time >= 0
x = .94

[State 102, Anim]
type = ChangeAnim
trigger1 = time = 0
value = 45

;---------------------------------------------------------------------------
; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A && var(7) <= 0
physics = A

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A && var(7) > 0
physics = N

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

;---------------------------------------------------------------------------
; AIR GUARD (guarding)
[Statedef 132]
type    = A
physics = N

[State 132, 1]
type = ChangeAnim
trigger1 = Anim != 132
value = 132

[State 132, 2]
type = VelAdd
trigger1 = 1
y = IfElse(var(7)>0,0,Const(movement.yaccel))

[State 132, 3]
type = VarSet
trigger1 = 1
sysvar(0) = (pos y >= 0) && (vel y > 0)

[State 132, 4]
type = VelSet
trigger1 = sysvar(0)
y = 0

[State 132, 5]
type = PosSet
trigger1 = sysvar(0)
y = 0

[State 132, 6]
type = ChangeState
trigger1 = sysvar(0)
trigger1 = command != "holdback"
value = IfElse(var(7)>0,510,52)

[State 132, 7]
type = ChangeState
trigger1 = sysvar(0)
value = 130

[State 132, TopBorder]
type = VelSet
triggerall = var(7) > 0
trigger1 = pos y < -99 && vel y < 0
trigger2 = vel y > -.25 && vel y < .25
y = 0

[State 132, KillDrift]
type = VelSet
triggerall = var(7) > 0
trigger1 = vel x > -.25 && vel x < .25
x = 0

[State 132, KillDrift]
type = VelSet
triggerall = var(7) > 0
trigger1 = vel y > -.25 && vel y < .25
y = 0

[State 132, TopBorder]
type = PosSet
triggerall = var(7) > 0
trigger1 = pos y < -99 && vel y < 0
y = -100

;---------------------------------------------------------------------------
; GUARD (end)
[Statedef 140]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged
ctrl = 1

[State 140, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 140 + (statetype = C) + (statetype = A)*2

[State 140, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 140, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 140, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A && var(7) <= 0
physics = A

[State 140, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A && var(7) > 0
physics = N

;---------------------------------------------------------------------------
; AGUARDHIT2 (knocked away)
[Statedef 155]
type    = A
movetype= H
physics = N
anim = 152

[State 155, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1
y = 1

[State 155, 2]
type = VelAdd
trigger1 = 1
y = IfElse(var(7)>0,0,Const(movement.yaccel))

[State 155, 3]
type = CtrlSet
trigger1 = Time = GetHitVar(ctrltime)
value = 1

[State 155, 4]
type = VarSet
trigger1 = 1
sysvar(0) = (pos y >= 0) && (vel y > 0)

[State 155, 5]
type = VelSet
trigger1 = sysvar(0)
trigger2 = var(7) > 0
y = 0

[State 155, 6]
type = PosSet
trigger1 = sysvar(0)
y = 0

[State 155, 7]
type = ChangeState
trigger1 = sysvar(0)
trigger1 = command != "holdback"
value = IfElse(var(7)>0,510,52)

[State 155, 8]
type = ChangeState
trigger1 = sysvar(0)
value = 130

[State 155, TopBorder]
type = VelSet
triggerall = var(7) > 0
trigger1 = pos y < -99 && vel y < 0
trigger2 = vel y > -.25 && vel y < .25
y = 0

[State 155, KillDrift]
type = VelSet
triggerall = var(7) > 0
trigger1 = vel x > -.25 && vel x < .25
x = 0

[State 155, KillDrift]
type = VelSet
triggerall = var(7) > 0
trigger1 = vel y > -.25 && vel y < .25
y = 0

[State 155, TopBorder]
type = PosSet
triggerall = var(7) > 0
trigger1 = pos y < -99 && vel y < 0
y = -100

[State 155, State]
type = ChangeState
trigger1 = var(7) > 0 && time >= 10
value = 510

