[Statedef 510]
type    = A
physics = N
anim    = 510
ctrl = 1

[State 510, TopBorder]
type = VelSet
trigger1 = pos y < -99 && vel y < 0
trigger2 = vel y > -.25 && vel y < .25
y = 0

[State 510, KillDrift]
type = VelSet
trigger1 = vel x > -.25 && vel x < .25
x = 0

[State 510, KillDrift]
type = VelSet
trigger1 = vel y > -.25 && vel y < .25
y = 0

[State 510, TopBorder]
type = PosSet
trigger1 = pos y < -99 && vel y < 0
y = -100

[State 510, Turn]
type = Turn
trigger1 = p2dist x < 0

[State 510, AccelUp]
type = VelAdd
triggerall = time >= 0
trigger1 = vel y > -4 && command =  "holdup" && pos y > -100
trigger2 = vel y > 0  && command != "holddown"
y = -.25

[State 510, AccelDown]
type = VelAdd
triggerall = time >= 0
trigger1 = vel y < 4 && command =  "holddown"
trigger2 = vel y < 0 && command != "holdup"
y = .25

[State 510, AccelFwd]
type = VelAdd
triggerall = time >= 0
trigger1 = vel x < 4 && command =  "holdfwd"
trigger2 = vel x < 0 && command != "holdback"
x = .25

[State 510, AccelFwd]
type = VelAdd
triggerall = time >= 0
trigger1 = vel x > -4 && command = "holdback"
trigger2 = vel x > 0 && command != "holdfwd"
x = -.25

[State 510, Land]
type = ChangeState
trigger1 = vel y > 0 && pos y >= 0
value = 52

[State 510, Fall]
type = ChangeState
trigger1 = var(7) < 1
value = 520
ctrl = 0

