; Definition file for Wolverine
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Galford_X"
displayname = "Galford_X"
versiondate = 04,14,2001	;Version date of character
mugenversion = 04,14,2001 	;Version of M.U.G.E.N character works on
author = "mugeni"         	;Character author name

; Files for the player
[Files]
;========================================================================
;CMDt@C
cmd     = gal.cmd   		;Command set

;========================================================================
;CNS,STt@C
cns     = gal.cns   		;Constants
st	= config_gal.txt	;States_galford config
st1     = gal-2.st   		;States_galford -2 control
st2     = gal.st    		;States
st3     = gal_sp.st   		;States_special
st4     = gal_ssp.st   		;States_super special
st5     = gal_renzan.st   	;States_renzan system
st6     = gal_papy01.st   	;States_papy control_1(Basic papy control)
st7     = gal_papy02.st   	;States_papy control_2(DMS papy control)

stcommon = common1.cns     	;Common states

;========================================================================
;SPR,AIR,SND,PALt@C
sprite  = gal.sff   		;Sprite
anim    = gal.air   		;Animation
sound   = gal.snd   		;Sound
pal1    = gal00.act;WC	1P
pal2    = gal01.act;WC	2P
pal3    = gal02.act;W	1P
pal4    = gal03.act;W	2P
pal5    = gal04.act;	1P
pal6    = gal05.act;	2P
pal7    = gal06.act;	3P
pal8    = gal07.act;	4P
pal9    = gal08.act;SP	1P
pal10   = gal09.act;SP	2P
pal11   = gal10.act;SP	3P
pal12   = gal11.act;SP	4P
