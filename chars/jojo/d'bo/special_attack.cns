;---------------------------------------------------------------------
;Special1000
[StateDef 1000]
type = S
physics = S
movetype = I
anim = 1000
poweradd = 100
ctrl = 0

[State Snd Play]
type = PlaySnd
trigger1 = Time = 0
value = 110,0
channel = 1
volume = 200

[State End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;Doll Wake Up
[StateDef 1001]
type = S
physics = S
movetype = I
anim = 1001
ctrl = 0

[State Snd Play]
type = PlaySnd
trigger1 = Time = 0
value = 8000,1
channel = 0
volume = 200

[State Attack Type Set]
type = VarSet
trigger1 = Time = 0
var(1) = 0

[State mark]
type = Explod
trigger1 = Time = 0
pausemovetime = 99999
removetime = 30
removeongethit = 1
shadow = -1
anim = 1006
pos = 0,-60
ownpal = 1
sprpriority = 2

[State Dust]
type = GameMakeAnim
trigger1 = Time = 0
value = 120

[State Shine]
type = PalFX
trigger1 = Time = 0
time = 12
add = 255,255,255
sinadd = 255,255,255,6

[State FaceP2]
type = Turn
trigger1 = Time = 0
trigger1 = P2Dist X < 0

[State Stand]
type = ChangeAnim
trigger1 = Anim = 1001
trigger1 = AnimTime = 0
value = 6000

[State End]
type = ChangeState
trigger1 = Anim = 6000
trigger1 = AnimElem = 1,>=4
value = 1002
ctrl = 0

;Attack
[StateDef 1002]
type = A
physics = N
movetype = A
anim = 1002
;velset = 4,-6
ctrl = 0

[State Snd Play]
type = PlaySnd
trigger1 = Time = 0
value = 1000,0
channel = 1
volume = 200

[State Jump]
type = VelSet
trigger1 = AnimElem = 3,0
x = 4
y = -6

[State HitDef]
type = HitDef
trigger1 = !MoveContact
attr = A, SA
damage = 25/(1+Parent,Var(7)/6.0),10
getpower = 50
givepower = 25
hitflag = MAF
guardflag = MA
sparkno = 0
sparkxy = 10,-50
;hitsound = S0,0
guardsound = S0,7
pausetime = 4,4
animtype = Heavy
guard.hittime = 14
guard.velocity = -4
guard.slidetime = 4
ground.type = Low
ground.hittime = 14
ground.velocity = -4*(1+Parent,Var(7)/4.0)
ground.slidetime = 4
air.type = Low
air.hittime = 14
air.velocity = -4*(1+Parent,Var(7)/4.0),-2*(1-Parent,Var(7)/4.0)
air.cornerpush.veloff = 0
down.cornerpush.veloff = 0
p2facing = 1

[State Hit P2!]
type = ChangeState
trigger1 = MoveHit
value = 1003
ctrl = 0

[State Hit P2!]
type = ChangeState
trigger1 = MoveGuarded
value = IfElse(!Parent,Var(5),1004,7001)
ctrl = 0

[State Gravity]
type = VelAdd
trigger1 = Pos Y < 0
y = 0.46

[State Land]
type = PosSet
trigger1 = Vel Y > 0
trigger1 = Pos Y > 0
y = 0

[State Land]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y = 0
value = IfElse(!Parent,Var(5),9110,7002)
ctrl = 0

;Attack Continue
[StateDef 1003]
type = A
physics = N
movetype = A
anim = 1003
velset = 2,0
ctrl = 0

[State HitDef]
type = HitDef
trigger1 = TimeMod = 4,2
attr = A, SA
damage = 25/(1+Parent,Var(7)/6.0),10
getpower = 50
givepower = 25
hitflag = MAF
guardflag = MA
sparkno = 0
sparkxy = 10,-50
;hitsound = S0,0
guardsound = S0,7
pausetime = 4,4
animtype = Heavy
guard.hittime = 14
guard.velocity = -4
guard.slidetime = 4
ground.type = Low
ground.hittime = 14
ground.velocity = -4*(1+(Parent,Var(7)-HitCount)/4.0)
ground.slidetime = 4
air.type = Low
air.hittime = 14
air.velocity = -4*(1+(Parent,Var(7)-HitCount)/4.0),-2*(1-(Parent,Var(7)-HitCount)/4.0)
air.cornerpush.veloff = 0
down.cornerpush.veloff = 0
p2facing = 1

[State End]
type = ChangeState
trigger1 = Time = 6+(Var(1)=1)*8+(Var(1)=2)*16
value = IfElse(!Parent,Var(5),1004,7001)
ctrl = 0

