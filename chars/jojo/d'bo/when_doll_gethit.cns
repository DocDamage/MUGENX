;---------------------------------------------------------------------------
;Stand Just On
[StateDef 8000]
type = U
physics = U
movetype = I
anim = 1000+(Statetype=A)*7002
sprpriority =  -1
ctrl = 0

[State Snd Play]
type = PlaySnd
trigger1 = Time = 0
value = IfElse(P2Name="Dio by ANMC",8000,110),0
channel = 1
volume = 200

[State Snd Play]
type = PlaySnd
trigger1 = Time = 0
value = 8000,2
channel = 0

[State Correct StateType]
type = StateTypeSet
trigger1 = Time = 0
trigger1 = Statetype != A
value = S
physics = S

[State Correct StateType]
type = StateTypeSet
trigger1 = Time = 0
trigger1 = Statetype = A
value = A
physics = A

[State Set Stand on]
type = VarSet
trigger1 = Time = 0
var(5) = 1

[State End]
type = ChangeState
trigger1 = AnimTime = 0
trigger1 = StateType != A
value = 8001
ctrl = 0

;Controlling doll
[StateDef 8001]
type = S
physics = S
movetype = I
anim = 8000
ctrl = 0

[State Turn Anim]
type = ChangeAnim
trigger1 = P2Dist X < 0
value = 5

[State Turn]
type = Turn
trigger1 = P2Dist X < 0

[State Walk Back]
type = ChangeAnim
triggerall = Anim != 21
trigger1 = Abs(Helper(1000),Pos X-Pos X) <= 60
trigger1 = Helper(1000),StateNo = 20
trigger1 = Helper(1000),Anim = 6021
value = 21

[State VelSet]
type = VelSet
trigger1 = Anim = 21
x = Helper(1000),Vel X

[State StopWalk]
type = ChangeAnim
triggerall = Anim != 8000
triggerall = Anim != 1000
trigger1 = Anim != 5
trigger1 = Abs(Helper(1000),Pos X-Pos X) > 60
trigger2 = Anim != 5
trigger2 = Helper(1000),StateNo != 20
trigger3 = Anim != 5
trigger3 = Helper(1000),Anim != 6021
trigger4 = Anim = 5
trigger4 = AnimTime = 0
value = 8000

[State Doll Special]
type = ChangeAnim
triggerall = Anim = 8000
triggerall = Anim != 1000
triggerall = Helper(1000),Time <= 12
trigger1 = Helper(1000),PrevStateNo = 7000
trigger1 = Helper(1000),StateNo = 1002
trigger2 = Helper(1000),StateNo = 7010
trigger3 = Helper(1000),StateNo = 7020
trigger4 = Helper(1000),StateNo = 1102
trigger5= Helper(1000),StateNo = 7200
trigger6= Helper(1000),StateNo = 7210
trigger7= Helper(1000),StateNo = 7220
value = 1000

[State Doll Special]
type = ChangeAnim
triggerall = Anim = 1000
trigger1 = AnimTime = 0
value = 8000

[State Crouch]
type = ChangeState
trigger1 = Helper(1000),StateNo = [10,11]
trigger2 = Helper(1000),StateNo = [6300,6399]
value = 10
ctrl = 0

[State Jump]
type = ChangeState
trigger1 = Abs(Helper(1000),Pos X-Pos X) <= 70
trigger1 = Helper(1000),StateNo = 50
trigger1 = Helper(1000),Time = 1
trigger1 = Helper(1000),PrevStateNo = 40
trigger1 = Helper(1000),Vel X <= 0
value = 8040
ctrl = 0

[State RunBack]
type = ChangeState
trigger1 = Abs(Helper(1000),Pos X-Pos X) <= 70
trigger1 = Helper(1000),StateNo = 6105
trigger1 = Helper(1000),Time = 1
value = 105
ctrl = 0

[State Super 3100]
type = ChangeState
trigger1 = Helper(1000),StateNo = [3102,3103]
value = 3100
ctrl = 0

[State End]
type = ChangeState
trigger1 = !Var(5)
trigger2 = RoundState = 3
trigger2 = (Enemy,StateNo=5150)||(Enemy,StateNo=0)
value = 8004
ctrl = 0

;Doll Wake Up
[StateDef 8002]
type = S
physics = S
movetype = I
anim = 1001
sprpriority = 1
ctrl = 0

[State Snd Play]
type = PlaySnd
trigger1 = Time = 0
value = 8000,1
channel = 0
volume = 200

[State Attack Type Set]
type = VarSet
trigger1 = Time = 0
var(1) = 0

[State Dust]
type = Explod
trigger1 = Time = 0
anim = 4000
sprpriority = 10
ownpal = 1

[State mark]
type = Explod
trigger1 = Time = 0
pausemovetime = 99999
removetime = 30
removeongethit = 1
shadow = -1
anim = 1006
pos = 0,-60
ownpal = 1
sprpriority = 2

[State Dust]
type = GameMakeAnim
trigger1 = Time = 0
value = 120

[State Shine]
type = PalFX
trigger1 = Time = 0
time = 12
add = 255,255,255
sinadd = 255,255,255,6

[State FaceP2]
type = Turn
trigger1 = Time = 0
trigger1 = P2Dist X < 0

[State Stand]
type = ChangeAnim
trigger1 = Anim = 1001
trigger1 = AnimTime = 0
value = 6000

[State End]
type = ChangeState
trigger1 = Anim = 6000
trigger1 = AnimElem = 1,>=4
value = 0
ctrl = 1

;Sleep
[StateDef 8003]
type = S
physics = S
movetype = I
anim = 1007
ctrl = 0

[State Pos Set]
type = PosSet
trigger1 = Time = 0
y = 0

[State End]
type = ChangeState
trigger1 = Time >= 4
value = 9110
ctrl = 0

;Receive Stand
[StateDef 8004]
type = S
physics = S
movetype = I
anim = 8001
ctrl = 0

[State End]
type = ChangeState
triggerall = Time >= 20
trigger1 = Helper(1000),StateNo = 9110
trigger2 = RoundState != 2
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Jump Start
[Statedef 8040]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 3]
type = VarSet
trigger1 = Helper(1000),Vel X < 0
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State Short Jump]
type = VelMul
trigger1 = AnimTime = 0
trigger1 = Helper(1000),Vel Y>= const(velocity.jump.y)/exp(0.5*ln(2))
y = 1/exp(0.5*ln(2))

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 0

;---------------------------------------------------------------------------
; HITG_SHAKE
[Statedef 25000]
type    = S
movetype= H
physics = N
velset = 0,0

[State Shake]
type = PosAdd
trigger1 = 1
x = 2*IfElse(TimeMod=2,0,1,-1)

[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Helper(1000),GetHitVar(animtype) != [3,5]
value = ifelse((Helper(1000),GetHitVar(groundtype) = 1),5000,5010) + Helper(1000),GetHitVar(animtype)

[State 5000, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Helper(1000),GetHitVar(animtype) = [3,5]
value = 5030

[State 5000, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (Helper(1000),GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + Helper(1000),GetHitVar(animtype)))
value = 5047 + Helper(1000),GetHitVar(animtype) ;5051 - 4 + type

[State 5000, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 5000, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = Helper(1000),GetHitVar(yvel) != 0 && Helper(1000),GetHitVar(fall)
trigger2 = Pos Y != 0
type = a

[State 5000, 6]
type = ChangeState
trigger1 = Helper(1000),HitShakeOver
trigger1 = Helper(1000),GetHitVar(yvel) = 0
trigger1 = Alive
value = 25001 ;HITG_SLIDE

[State 5000, 7]
type = ChangeState
trigger1 = Helper(1000),HitShakeOver
value = 25030

[State 5000, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 5000, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5000, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; HITG_SLIDE
[Statedef 25001]
type    = S
movetype= H
physics = S

[State 5001, 1]
type = VelSet
trigger1 = Time = 0
x = Helper(1000),GetHitVar(xvel)*Helper(1000),Facing
y = Helper(1000),GetHitVar(yvel)

[State 5001, 2]
type = ChangeAnim
trigger1 = AnimTime = 0
value = 5005 + Helper(1000),GetHitVar(animtype) + (Helper(1000),GetHitVar(groundtype)=2)*10

[State 5001, 3] ;Stop sliding back
type = VelMul
trigger1 = Time >= Helper(1000),GetHitVar(slidetime)
x = .6

[State 5001, 4]
type = VelSet
trigger1 = Helper(1000),HitOver
x = 0

[State 5001, 5]
type = DefenceMulSet
trigger1 = Helper(1000),HitOver
value = 1

[State 5001, 6]
type = ChangeState
trigger1 = Helper(1000),HitOver
value = 0
ctrl = 1

