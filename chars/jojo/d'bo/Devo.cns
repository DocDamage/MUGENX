;-------------------Parent------------------------
;Var(0): Jump Var
;Var(1): Stand Life
;Var(3): HitDef P2StateNo Checking
;Var(4): Helper(1000).PrevHitCount
;Var(5): Stand On/Off
;Var(6): PrevHitCount
;Var(7): HitCount
;Var(8): Command Buffer(Single)
;Var(9): Command Buffer(Complex)
;Var(10): Command Buffer(Super)
;Var(11~40): AI used
;Var(57): AI used
;Var(58): AI used
;Var(59): AI switch
;channel 0: SFX
;channel 1: Speaking
;---------------------Doll--------------------------
;Var(0): Parent Go To Hit State
;Var(1): Attack Type
;Var(3): HitDef P2StateNo Checking
;Var(4): Double Jump Check
;Var(7~9): PrevStateNo
;channel 0: SFX
;channel 1: Speaking
;channel 2: Hit Sound
;---------------------AI--------------------------
;Var(0): Is Human User
;Var(1): Index
;Var(2): Enemy,Attack
;Var(3): Enemy,PrevTime
[Data]
life = 1000
power = 10000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 1
volume = 0
IntPersistIndex = 0
FloatPersistIndex = 0

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 15     ;Player width (back, ground)
ground.front = 16    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
height = 60      ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = -5, -90   ;Approximate position of head
mid.pos = -5, -60    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.4      ;Walk forward
walk.back = -2.2     ;Walk backward
run.fwd  = 8, 0    ;Run forward (x, y)
run.back = -6,-3.8 ;Hop backward (x, y)
jump.neu = 0,-8.4    ;Neutral jumping velocity (x, y)
jump.back = -2.55    ;Jump back Speed (x, y)
jump.fwd = 2.5       ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 5,-8.1      
airjump.neu = 0,-8.1      
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .44         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;----------------------------------------------------------------------
;Run Fwd
[StateDef 100]
type = S
physics = N
movetype = I
anim = 100
velset = 0,0

[State NoWalk]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State VelSet]
type = VelSet
trigger1 = AnimElem = 2,>=0
x = const(velocity.run.fwd.x)

[State End]
type = ChangeState
trigger1 = Time >= 30
trigger2 = !Var(59)
trigger2 = Command = "holdback"
value = 101
ctrl = 0

;Run Fwd End
[StateDef 101]
type = S
physics = S
movetype = I
anim = 101
ctrl = 0

[State End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;----------------------------------------------------------------------
;Run Back
[StateDef 105]
type = S
physics = N
movetype = I
anim = 105
velset = 0,0

[State NoWalk]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State VelSet]
type = VelSet
trigger1 = AnimElem = 2,>=0
x = const(velocity.run.back.x)

[State End]
type = ChangeState
trigger1 = Time >= 30
trigger2 = !Var(59)
trigger2 = Command = "holdfwd"
value = 106
ctrl = 0

;Run Back End
[StateDef 106]
type = S
physics = S
movetype = I
anim = 106
ctrl = 0

[State End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;----------------------------------------------------------------------
;Roll Fwd
[StateDef 110]
type = S
physics = N
movetype = I
anim = 110
velset = 0,0
ctrl = 0

[State Snd Play]
type = PlaySnd
trigger1 = Time = 0
value = 110,0
channel = 1
volume = 200

[State 110]
type = NotHitBy
trigger1 = 1
value = SCA

[State 110]
type = PlayerPush
trigger1 = 1
value = 0

[State 110]
type = AfterImage
trigger1 = Time = 0
time = 30
removetime = 18
length = 3
timegap = 6
framegap = 1
palbright = 0,0,0
palcontrast = 255,255,255
palpostbright = 0,0,0
paladd = 0,0,0
palmul = 1,1,1
trans = Add1

[State 110]
type = VelSet
trigger1 = AnimElem = 5
x = 6

[State 110]
type = StateTypeSet
trigger1 = AnimElem = 12
value = S
physics = S

[State 110]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

