[StateDef -2]

;Hit Count
[State HitCount Reset]
type = VarSet
trigger1 = !IsHelper
trigger1 = P2MoveType != H
ignorehitpause = 1
var(4) = 0

[State HitCount Reset]
type = VarSet
trigger1 = !IsHelper
trigger1 = P2MoveType != H
ignorehitpause = 1
var(7) = 0

[State HitSpark]
type = Helper
triggerall = !IsHelper
trigger1 = HitCount-Var(6) > 0
ignorehitpause = 1
pausemovetime = 2147483647
supermovetime = 2147483647
name = "Hit Spark"
pos = (EnemyNear,Pos X-Pos X-10)*Facing,-60+(StateType=C)*50
stateno = 30000
id = 30000
ownpal = 1
keyctrl = 0

[State HitCount]
type = VarAdd
triggerall = !IsHelper
trigger1 = HitCount-Var(6) > 0
trigger2 = Helper(1000),HitCount-Var(4) > 0
ignorehitpause = 1
var(7) = (HitCount-Var(6))+(Helper(1000),HitCount-Var(4))

[State PrevHitCount]
type = VarSet
trigger1 = !IsHelper
ignorehitpause = 1
var(6) = HitCount 

[State PrevHitCount]
type = VarSet
trigger1 = !IsHelper
ignorehitpause = 1
var(4) = Helper(1000),HitCount 

;Guard Stand Image
[State Guard Image(Ground)]
type = Explod
triggerall = !IsHelper
triggerall = TimeMod = 2,0
trigger1 = (StateNo=120)||(StateNo=[130,149])
trigger1 = StateType != A
ignorehitpause = 1
pausemovetime = 9999999
removetime = 1
anim = 123
pos = 15+(StateType=C)*30,-60+(Statetype=C)*50
sprpriority = 2

[State Guard Image(Air)]
type = Explod
triggerall = !IsHelper
trigger1 = StateNo=[150,159]
pausemovetime = 9999999
ignorehitpause = 1
removetime = 1
anim = 124
pos = 10+(StateType=C)*30,-60+(Statetype=C)*50
sprpriority = 2

[State Show Value]
type = DisplayToClipBoard
trigger1 = 1
text = "HitCount: %d, Enemy,StateNo:%d, Attack Occur Time:%d, End Time:%d\n"
params = Var(7),Var(11+Helper(20000),Var(5)),Var(21+Helper(20000),Var(5)),Var(31+Helper(20000),Var(5))

[State Show Value]
type = AppendToClipBoard
trigger1 = 1
text = "Var(57): %d, Var(58): %d, HP,Var(3): %d, Enemy,NumProj: %d, Var(2):%d"
params = Var(57),Var(58),Helper(20000),Var(3),Enemy,NumProj,Helper(20000),Var(2)

;Stand Recover
[State Stand Recover]
type = VarAdd
trigger1 = !IsHelper
trigger1 = !Var(5)
trigger1 = Var(1) < 500
trigger1 = (Helper(1000),MoveType!=H)||(Helper(1000),StateNo=9110)||(Helper(1000),StateNo=1005)
var(1) = IfElse(Var(1)<=488,12,500-Var(1))

[State Stand Damage]
type = VarAdd
trigger1 = !IsHelper
trigger1 = Var(5)
var(1) = -Helper(1000),GetHitVar(damage)*3

;Put Doll
[State Put Doll]
type = Helper
trigger1 = !IsHelper
trigger1 = NumHelper(1000) = 0
name = "doll"
pos = 0,-Pos Y
stateno = 9110
ownpal = 1
keyctrl = 1
id = 1000

;Put AI
[State Put AI]
type = Helper
trigger1 = NumHelper(20000) = 0
name = "AI"
pos = 999,999
stateno = 20000
keyctrl = 1
id = 20000

;--------------------------Close Stand--------------------------
[State Behind Doll]
type = SprPriority
trigger1 = Var(5)
value = -1

[State Close Stand]
type = VarSet
triggerall = !IsHelper
triggerall = Var(5)
trigger1 = !Alive
trigger2 = Var(1) <= 0
;trigger2 = MoveType = H
;trigger2 = StateNo = [5000,5999]
;trigger2 = GetHitVar(fall)||(GetHitVar(groundtype)=3)
;trigger4 = MoveType = H
;trigger4 = (StateNo!=[120,159])||(StateNo!=[5000,5999])||(StateNo!=[25000,25999])
ignorehitpause = 1
var(5) = 0

[State GetHitSound]
type = PlaySnd
trigger1 = Time = 0
trigger1 = (StateNo=5000)||(StateNo=5010)||(StateNo=5020)||(StateNo=5070)||(StateNo=5080)
trigger2 = Time = 1
trigger2 = (StateNo=25000)||(StateNo=25010)||(StateNo=25020)||(StateNo=25070)||(StateNo=25080)
value = 5000,Random%4
channel = 1
volume = 200

;--------------------------Stand Image--------------------------
[State Stand Image]
type = Helper
triggerall = !IsHelper
triggerall = Helper(1000),Time = 1
trigger1 = Helper(1000),StateNo = 1001
trigger2 = Helper(1000),StateNo = 1011
trigger3 = Helper(1000),StateNo = 1021
trigger4 = Helper(1000),StateNo = 1101
trigger5 = Helper(1000),StateNo = 1111
trigger6 = Helper(1000),StateNo = 1121
trigger7 = Helper(1000),StateNo = 1201
trigger8 = Helper(1000),StateNo = 1211
trigger9 = Helper(1000),StateNo = 1221
trigger10 = Helper(1000),StateNo = 3001
trigger11 = Helper(1000),StateNo = 3101
trigger11 = !Var(5)
trigger12 = Helper(1000),StateNo = 8002
supermovetime = 999
name = "stand"
pos = 20*IfElse(Helper(1000),ParentDist X>=0,1,-1),-50
stateno = 10000
keyctrl = 0
ownpal = 1
id = 10000

[State Stand Image]
type = Helper
triggerall = !IsHelper
triggerall = Helper(1000),Time = 1
trigger1 = Helper(1000),StateNo = 1004
trigger2 = Helper(1000),StateNo = 1202
trigger3 = Helper(1000),StateNo = 8003
trigger4 = Helper(1000),StateNo = 9110
trigger4 = (Helper(1000),PrevStateNo=1002)||(Helper(1000),PrevStateNo=[1005,1006])||(Helper(1000),PrevStateNo=[3000,3199])
trigger5 = Helper(1000),StateNo = 1105
ignorehitpause = 1
supermovetime = 999
name = "stand"
pos = -Helper(1000),ParentDist X*Facing*Helper(1000),Facing,-Helper(1000),ParentDist Y-30
stateno = 10001
keyctrl = 0
ownpal = 1
id = 10000

;--------------------------------------------------------------------------------------------------------------
;Stand Image Get Out from Parent
[StateDef 10000]
type = A
physics = N
movetype = I
anim = 10000
ctrl = 0

[State VelSet]
type = VelSet
trigger1 = 1
x = (ParentDist X-Helper,ParentDist X*Facing*Helper(1000),Facing)/4.0
y = (ParentDist Y-(Helper(1000),ParentDist Y+30))/4.0

[State Explod]
type = Explod
trigger1 = 1
removetime = 1
anim = 4006
sprpriority = -10
ownpal = 0
scale = 1,(12-Time)/12.0

[State PalFX]
type = PalFX
trigger1 = 1
time = 1
mul = 256*(13-Time)/13.0,256*(13-Time)/13.0,256*(13-Time)/13.0

[State Remove]
type = DestroySelf
trigger1 = Time >= 12

;--------------------------------------------------------------------------------------------------------------
;Stand Image Recive from Doll
[StateDef 10001]
type = A
physics = N
movetype = I
anim = 10000
ctrl = 0

[State VelSet]
type = VelSet
trigger1 = 1
x = ParentDist X/4.0
y = (ParentDist Y-50)/4.0

[State Explod]
type = Explod
trigger1 = 1
removetime = 1
anim = 4006
sprpriority = -10
ownpal = 0
scale = 1,Time/12.0

[State PalFX]
type = PalFX
trigger1 = 1
time = 1
mul = 256*(Time+1)/13.0,256*(1+Time)/13.0,256*(1+Time)/13.0

[State Remove]
type = DestroySelf
trigger1 = Time >= 12

;--------------------------------------------------------------------------------------------------------------
;Stand Image Get Out from Parent
[StateDef 10002]
type = A
physics = N
movetype = I
anim = 4006
ctrl = 0

[State PalFX]
type = PalFX
trigger1 = 1
time = 1
mul = 128+128*cos(Pi*Time/30.0+Pi),128+128*cos(Pi*Time/30.0+Pi/2.0),128+128*cos(Pi*Time/30.0+Pi/3.0)

[State Remove]
type = DestroySelf
trigger1 = Time >= 240
trigger2 = Parent,MoveType = H

