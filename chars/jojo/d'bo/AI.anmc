;Crouch_Light_Attack
[State Crouch_Light_Attack]
type = ChangeState
triggerall = !IsHelper
triggerall = Ctrl
triggerall = StateType != A
triggerall = Var(59)
;triggerall = Command = "holddown"
triggerall = !Var(5)
triggerall = P2BodyDist X+EnemyNear,Vel X*5 = [30,60]
triggerall = P2Dist Y = [-10,0]
