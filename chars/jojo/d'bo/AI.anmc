[State Crouch Guard]
type = StateTypeSet
trigger1 = Var(59)
trigger1 = P2MoveType = A
trigger1 = P2StateType = C
trigger1 = P2BodyDist X <= 200
trigger1 = StateType = S
trigger1 = (StateNo=120)||(StateNo=130)||(StateNo=140)||(StateNo=[150,153])
ignorehitpause = 1
value = C

;--------Auto Walk----------------
[State Auto Walk]
type = ChangeState
trigger1 = Var(59)
trigger1 = !IsHelper
trigger1 = Ctrl
trigger1 = StateType != A
trigger1 = P2MoveType != A
trigger1 = !Var(5)
trigger1 = P2BodyDist X > 15
value = 20

;-------------------------------------------------------------------
;       ANMC New AI Main Part 
;-------------------------------------------------------------------
[StateDef 20000]
type = S
physics = N
movetype = I
anim = 10000
velset = 0,0
ctrl = 0

[State Is Human User Check]
type = VarSet
trigger1 = Command = "CPU"
trigger2 = Command = "holdfwd"
trigger3 = Command = "holdback"
trigger4 = Command = "holdup"
trigger5 = Command = "holddown"
var(0) = 1

[State AI user]
type = ParentVarSet
trigger1 = !Var(0)
trigger1 = (Parent,Command="CPU")&&(Command!="CPU")
var(59) = 1

[State AI user]
type = ParentVarSet
trigger1 = RoundState != 2
trigger2= Var(0)
var(59) = 0

[State Save All Date]
type = ParentVarSet
trigger1 = Enemy,StateNo != Var(4)
trigger1 = Var(1) != -1
var(11+Var(5)) = Var(1)

[State Save All Date]
type = ParentVarSet
trigger1 = Enemy,StateNo != Var(4)
trigger1 = Var(1) != -1
var(21+Var(5)) = Var(2)

[State Save All Date]
type = ParentVarSet
trigger1 = Enemy,StateNo = Var(1)
trigger1 = Var(1) != -1
var(31+Var(5)) = Enemy,Time

[State Inc index]
type = VarSet
trigger1 = Enemy,StateNo != Var(4)
trigger1 = Var(1) != -1
var(5) = (Var(5)+1)%10

[State Save All Date]
type = VarRangeSet
trigger1 = Enemy,StateNo != Var(4)
trigger1 = Var(1) != -1
trigger2 = Time = 0
value = -1
first = 1
last = 2

[State Save P2 StateNo]
type = VarSet
trigger1 = !Enemy,Ctrl
trigger1 = Enemy,MoveType != H
trigger1 = Enemy,StateNo != Parent,Var(11)
trigger1 = Enemy,StateNo != Parent,Var(12)
trigger1 = Enemy,StateNo != Parent,Var(13)
trigger1 = Enemy,StateNo != Parent,Var(14)
trigger1 = Enemy,StateNo != Parent,Var(15)
trigger1 = Enemy,StateNo != Parent,Var(16)
trigger1 = Enemy,StateNo != Parent,Var(17)
trigger1 = Enemy,StateNo != Parent,Var(18)
trigger1 = Enemy,StateNo != Parent,Var(19)
trigger1 = Enemy,StateNo != Parent,Var(20)
trigger1 = Var(1) = -1
var(1) = P2StateNo

[State Save P2 First HitDef Time]
type = VarSet
triggerall = Var(1) != -1
triggerall = Var(2) = -1
trigger1 = Enemy, HitDefAttr = SCA,AA,AP,AT
var(2) = Enemy,Time

[State P2PrevStateNo]
type = VarSet
trigger1 = 1
var(4) = Enemy,StateNo