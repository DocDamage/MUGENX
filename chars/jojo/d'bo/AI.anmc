triggerall = !IsHelper
triggerall = Ctrl
triggerall = StateType != A
triggerall = Var(59)
;triggerall = (Command!="holddown")||(StateNo=100)
triggerall = !Var(5)
triggerall = P2BodyDist X+EnemyNear,Vel X*7 = [60,80]
triggerall = P2Dist Y = [-60,0]
triggerall = EnemyNear,StateNo != [5100,5199]
trigger1 = (Var(57)-EnemyNear,Time)>7
trigger1 = StateType != C
value = 220+(StateNo=100)
ctrl = 0

