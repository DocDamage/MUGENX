[StateDef -3]

;---------------------------------------Normal Attack-----------------------------------------
;Stand_fwd_Medium_Attack
[State Stand_Medium_Attack]
type = ChangeState
triggerall = !IsHelper
triggerall = Ctrl
triggerall = StateType != A
triggerall = Var(59)
;triggerall = Command != "holddown"
;triggerall = Command = "holdfwd"
triggerall = StateNo != 100
triggerall = !Var(5)
triggerall = P2BodyDist X+EnemyNear,Vel X*7 = [0,100]
triggerall = P2Dist Y+EnemyNear,Vel Y*7+0.46*49 = [-60,0]
trigger1 = (Var(57)-EnemyNear,Time)>7
trigger2 = (PrevStateNo=[120,159])||(Var(57)=-1)
trigger2 = (Var(58)-EnemyNear,Time)>=7
trigger3 = EnemyNear,Command = "holdfwd"
trigger3 = P2MoveType != A
trigger3 = Random <= EnemyNear,Time*10
trigger4 = P2MoveType = H
trigger4 = EnemyNear,StateNo != 5110
value = 211
ctrl = 0

;Stand_Heavy_Attack
