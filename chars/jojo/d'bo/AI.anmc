ctrl = 0

;Roll Fwd
[State Run Fwd]
type = ChangeState
triggerall = !IsHelper
triggerall = Ctrl
triggerall = StateType != A
triggerall = !Var(5)
triggerall = Var(59)
triggerall = P2Dist X = [0,100]
triggerall = P2MoveType = A
trigger1 = (Var(57)=0)&&(Var(58)=0)
trigger1 = Random < 100
trigger2 = EnemyNear,HitDefAttr = SCA,AT
trigger3 = (Helper(1000),StateNo!=9110)&&(Helper(1000),StateNo!=[1004,1006])
trigger4 = (Var(58)-EnemyNear,Time)>=24
value = 110
ctrl = 0

