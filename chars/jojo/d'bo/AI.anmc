triggerall = StateType = A
triggerall = Var(59)
triggerall = !Var(5)
trigger1 = 1
value = 420
ctrl = 0

;--------------------Jump-----------------
[State Reset]
type = VarSet
trigger1 = Var(0)
var(0) = 0

[State Auto Jump]
type = VarSet
trigger1 = !IsHelper
trigger1 = Helper(1000),StateNo = [3001,3004]
trigger1 = Helper(1000),MoveGuarded
trigger1 = P2StateType = C
trigger1 = !Var(5)
trigger1 = P2BodyDist X = [0,100]
var(0) = 1

[State Jump]
type = ChangeState
trigger1 = !IsHelper
trigger1 = Var(59)
trigger1 = !Var(5)
trigger1 = Ctrl
trigger1 = Statetype != A
trigger1 = Var(0)
value = 40

;--------------------Auto Guard-----------------
[State Stand Guard]
type = ChangeState
triggerall = !IsHelper
trigger1 = Var(57) != -1
trigger1 = Var(59)
trigger1 = !Var(5)
trigger1 = P2MoveType = A
trigger1 = P2BodyDist X <= 200
trigger1 = StateNo != 120
trigger1 = Ctrl
trigger1 = (Helper(1000),StateNo=9110)||(Helper(1000),StateNo=[1004,1006])
value = 120

[State Stand Guard]
type = ChangeState
triggerall = !IsHelper
trigger1 = Var(59)
trigger1 = !Var(5)
trigger1 = P2MoveType = A
trigger1 = P2StateType = A
trigger1 = P2BodyDist X <= 200
trigger1 = (StateNo=130)||(StateNo=131)
trigger1 = (Helper(1000),StateNo=9110)||(Helper(1000),StateNo=[1004,1006])
value = 130

[State Stand Guard]
type = StateTypeSet
triggerall = !IsHelper
trigger1 = Var(59)
trigger1 = P2MoveType = A
trigger1 = P2StateType = A
trigger1 = P2BodyDist X <= 200
trigger1 = StateType = C
trigger1 = (StateNo=120)||(StateNo=131)||(StateNo=140)||(StateNo=[150,153])
ignorehitpause = 1
value = S

[State Guard Guard]
