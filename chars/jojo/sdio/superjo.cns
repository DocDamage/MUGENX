trigger1 = time > 180 ;&& P2Stateno != [2200, 2205]
value = 5030

[State Whopee]
type = ChangeAnim
trigger1 = 1 && time < 32
value = 5012

[State 2012, For Characters with Collapse Ani]
type = ChangeState
Trigger1 = time >= 0 && animexist(5130) && animexist(5131) && pos Y = 0
value = 2222

[State 2012, For Characters w/o collapse ani]
type = SelfState
Trigger1 = Time > 32 && !animexist(5130) && !animexist(5131)
trigger2 = Time > 32 && animexist(5130) && animexist(5131) && Pos Y != 0
value = 5030

; reeling
