[Statedef 180]
type = S

[State 180, Win 1]
type = VarSet
trigger1 = Command = "hold_x" && p1name = "Shadow DIO"
v = 1
value = 1

[State 180, Win 2]
type = VarSet
trigger1 = Command = "hold_y" && p1name = "Shadow DIO"
v = 1
value = 2

[State 180, Win 3]
type = VarSet
trigger1 = Command = "hold_z" && p1name = "Shadow DIO"
v = 1
value = 3

[State 180, Win 4]
type = VarSet
trigger1 = Command = "hold_a" && p1name = "Shadow DIO"
v = 1
value = 4

[State 180, Win 4]
type = VarSet
trigger1 = Command = "hold_b" && p1name = "Shadow DIO"
trigger1 = matchover
v = 1
value = 5

[State 180, Randomizer]
type     = VarRandom
trigger1 = Time = 0 && !matchover
