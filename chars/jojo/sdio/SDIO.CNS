; Shadow Dio's labyrinth of constants.
; Written by your friendly guy with Orochi Blood.
; Copy as you wish, as long as the credit is given.

;Var1 = Voice Randomization
;Var2 = Knife Positioning Randomizer
;Var3 = Scales of horror Position Randomizer
;Var4 = Taunt voice randomizer (now freed)
;Var5 = The World activator
;Var6 = Toki Yo Tomare BGPALFX
;Var7 = Stand activation switch
;Var8 = Stand positioning determiner/Jumping action determiner
;Var9 = "The World" voice randomizer.
;Var10 = Direction determiner for air stand attack
;Var11 = Throw direction switch
;Var12 = Tells which Direction should the stand go in Air stand attack.
;Var13 = Universal Invincibility Indicator
;Var14 = Indicates wether Dio was hurt.
;Var15 = Charisma Spark Randomizer
;Var16 = Screenbound Timer
;Var17 = Win Pose 2 switch
;Var18 = Punishment Switch
;Var19 = Slam sound determiner
;Var20 = Knives Manipulation
;Var21 = KO effect activator
;Var22 = AI booster
;Var23 = Voice Hurt Randomizer
;Var24 = AssertSpecial for win 2.
;Var25 = Slash explod switch
;Var26 = Slash explod Y scaler switch.
;Var27 = Local Randomizer
;Var28 = Enables Echo on lose and matchover
;Var29 = WinScreen Manipulator
;Var30 = Wall Slam switch. Detects wether Dio attacked during the time
;        stop.
;Var31 = Controlled Randomization var
;Var32 = Hit Attack Reset Switch. Tells when special hurt state has
;        passed, to prevent duplicate hitstate parsing.
;Var33 = Ditch counting limit
;Var34 = Transparency Counter
;Var35 = Helper's X positional variable
;Var36 = Helper's Y positional variable
;Var37 = Future style switch based on palfx
;Var38 = Takes Knife positioning disposition
;var39 = Secondary Knife attack sound switch
;var40 = Y position randomizer for screen
;var41 = 3-item randomizer
;var42 = backedgedist related trigger.
;var43 = detects wether the command holdback was done

; FLoat Vars
;fvar1 = Slash explod Y scaling factor
;fvar2 = Super Face scaler
;fvar3 = Records Y Velocity
;fvar4 = Records Helper(1000)'s (the knife) screen position
;fvar10 = The Stand's GetHit Velocity sum for gravity

[Data]
life            = 1200
attack          = 100
defence         = 100
fall.defence_up = 0
liedown.time    = 60
power           = 10000 ; I discovered this first! HEHAHAHAHAH!!!
airjuggle       = 15
sparkno         = 3
guard.sparkno   = 40
KO.echo         = var(28)
intpersistindex = 1

[Size]
xscale           = 1
yscale           = 1
height           = 60
ground.back      = 16
ground.front     = 24
air.back         = 11
air.front        = 24
z.width          = 23
attack.width     = 4,4
attack.dist      = 160
proj.attack.dist = 90
mid.pos          = 4,-69
head.pos         = -14,-95

[Velocity]
walk.fwd  = 2.1
walk.back = -2.1
run.fwd   = 0, 0
run.back  = -9.5
jump.neu  = 0,-9.10
jump.back = -2.7
jump.fwd  = 3.3

[Movement]
airjump.num     = 0
airjump.height  = 35
yaccel          = .49
stand.friction  = .8
crouch.friction = .8

;---------------------------------------------------------------------------
; Taunt
[Statedef 195]
type     = S
movetype = I
physics  = S
ctrl   = 0
anim   = 195
velset = 0,0

[State 180, Randomizer]
type = VarRandom
trigger1 = Time = 0
v = 4
range = 0,10

[state 195, Taunt Voice 1]
type     = PlaySnd
trigger1 = AnimElem = 7 && var(4) = [0,4]
value    = S1,2
channel  = 0

[state 195, Taunt Voice 2]
type     = PlaySnd
trigger1 = AnimElem = 7 && var(4) = [5,10]
value    = S1,6
channel  = 0

[State 195, Macula]
type          = Helper
trigger1      = AnimElem = 6
helpertype    = normal
id            = (195)
name          = "macula"
pos           = 0,0
postype       = p1
stateno       = 196
facing        = 1
keyctrl       = 0
ownpal        = 1
pausemovetime = 99999999999999
supermovetime = ifelse(var(5) = 1, 99999999999999, 0)

[State 195, Revert to Stance]
type     = ChangeState
trigger1 = animTime = 0
value    = 0
ctrl     = 1

; Macula
[Statedef 196]
type     = A
movetype = I
physics  = N
ctrl   = 0
anim   = 196
velset = 0,0
sprpriority = 1

[State 196, Always There]
type     = BindToRoot
trigger1 = 1
pos      = 0,0
time     = 1
facing   = 1

[State 1211, Exclamation]
type = Explod
trigger1 = time = 0
anim = 196
id = 196
pos = 0,0
postype = p1
sprpriority = 1
removetime = -1
bindtime = -1
supermovetime = ifelse(var(5) = 1, 99999999999999, 0)
pausemovetime = -1
ignorehitpause = 1

;[State weird]
;type = changeanim
;trigger1 = numexplod(196) = 0
;value = 196

[State that starts the palfx]
type     = PalFx
trigger1 = time = 0
sub      = 255,255,255
sinadd   = -300,-300,-300,165
time     = 85

[State weird]
type = RemoveExplod
trigger1 = (animtime = 0 && root, stateno = 195) || root, movetype = H
;trigger2 = stateno != 181 && time >= 85
id = 196

[State that deletes the macula]
type     = Destroyself
trigger1 = (animtime = 0 && root, stateno = 195) || root, movetype = H
;trigger2 = stateno != 181 && time >= 85

