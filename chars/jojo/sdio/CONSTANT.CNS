;---------------------------------------------------------------------------
; States that are always checked (use -2) :
; States checked for rc (-3)
;---------------------------------------------------------------------------
;
; States with triggers as Shadow Dio's name are put there to prevent
; other characters from activating that state, especially those who uses
; the same vars as Shadow Dio's.
;
[Statedef -2]

[state 150, Poweradd]
type = Poweradd
triggerall = var(5) = 1 && p1name = "Shadow DIO"
trigger1 = stateno != 3000
trigger2 = win = 1
trigger2 = winko = 1
ignorehitpause = 1
value = -18

[State that gives the inverted effect]
type = BGPalFx
triggerall = p1name = "Shadow DIO"
trigger1 = var(5) = 1
trigger1 = stateno != 3000
mul = 256,256,256
invertall = 1
color = 0
time = 1
ignorehitpause = 1

; Play "hmmph" sound when recovering in air or on ground
[State -2, 1]
type = PlaySnd
triggerall = Time = 1 && p1name = "Shadow DIO"
trigger1 = stateno = 5201
trigger2 = stateno = 5210
value = S2,0
channel = 0

; Less wide in front when hit
[State -2, 1]
type = Width
triggerall = p1name = "Shadow DIO"
trigger1 = stateno = 5000
trigger2 = stateno = 5001
value = -13

[State -2, Hop Sound]
type = PlaySnd
triggerall = time = 0 && p1name = "Shadow DIO"
triggerall = random > 500
triggerall = animelem = 1
trigger1   = stateno = 101
trigger2   = stateno = 106
value      = S0,27
persistent = 0

[State -2, Get rid of trailing anims when hit]
type       = AfterImageTime
triggerall = Time = 0
trigger1   = movetype = h
time       = 0
ignorehitpause = 1

[state that Prevent The World from activating in KO]
type = Varset
trigger1 = var(5) = 1 && p1name = "Shadow DIO"
trigger1 = win = 1
trigger1 = winko = 1
v = 5
value = 0

[state stuff]
type = Varadd
trigger1 = var(6) >= 1 && p1name = "Shadow DIO"
trigger1 = var(6) < 46
v = 6
value = 1

[State of THE WORLD]
type = SuperPause
trigger1 = var(5) = 1 && p1name = "shadow dio"
ignorehitpause = 1
movetime = 2
time = 2
anim = -1
darken = 0
p2defmul = 1
unhittable = 1
anim = -1

[State of THE WORLD]
type = Pause
trigger1 = var(13) >= 1 && p1name = "shadow dio"
ignorehitpause = 1
movetime = 2;ifelse((hitdefattr = S, NT), 1, 2)
time = 2;ifelse((hitdefattr = S, NT), 1, 2)
darken = 0
anim = -1

[State 1010, Override]
type = HitOverride
trigger1 = var(5) >= 1
trigger2 = var(13) >= 1
attr = SCA, AA, AT, AP
time = 2
ignorehitpause = 1

[State that ensures mightyness]
type = NotHitBy
trigger1 = var(5) >= 1 || var(13) >= 1
trigger1 = p1name = "shadow dio"
value = SCA
time = 2
ignorehitpause = 1

[State that locks control when a helper is active and attacking]
type = CtrlSet
triggerall = var(5) = 1 && p1name = "Shadow DIO"
triggerall = power = 0
triggerall = numhelper(250) >= 1
triggerall = ctrl = 1
trigger1 = stateno = 0
;trigger2 = stateno = 20
value = 0

[state assertspecial]
type = assertspecial
trigger1 = p1name = "shadow dio" && var(5) = 1
ignorehitpause = 1
flag = nomusic
flag2 = nostandguard
flag3 = nocrouchguard

[state that makes guarding impossible when the stand is around.]
type = assertspecial
trigger1 = p1name = "shadow dio" && numhelper(250) = 1
ignorehitpause = 1
flag = noairguard
flag2 = nostandguard
flag3 = nocrouchguard

[state assertspecial]
type = assertspecial
trigger1 = p1name = "shadow dio" && var(5) = 1
flag = noairguard
flag2 = nojugglecheck
flag3 = unguardable
ignorehitpause = 1

[state 150, More Asserts]
type = Assertspecial
trigger1 = var(5) = 1 && p1name = "shadow dio"
flag = nokosnd
ignorehitpause = 1

[state 150, The World!]
type = Changestate
triggerall = var(5) = 1 && p1name = "Shadow DIO"
triggerall = power = 0
triggerall = statetype != A
trigger1 = ctrl = 1
trigger2 = numhelper(250) >= 1
trigger2 = anim = 0
trigger2 = ctrl = 0
value = 3001
ignorehitpause = 1

[state that Prevent The World from activating]
type = Varset
trigger1 = numhelper(250) = 0 && p1name = "Shadow DIO"
v = 7
value = 0

[state that tells which direction to go]
type = Varset
triggerall = vel X = 0 && p1name = "Shadow DIO"
;triggerall = stateno != 5210
trigger1 = stateno = [40, 50]
;trigger2 = stateno != 451
;trigger3 = stateno != 1430
;trigger4 = stateno != 1440
;trigger5 = stateno != 1450
v = 10
value = 0
ignorehitpause = 1

[state that tells which direction to go]
type = Varset
triggerall = vel X <= -1 && p1name = "Shadow DIO"
trigger1 = stateno != 450
trigger2 = stateno != 451
trigger3 = stateno != 1430
trigger4 = stateno != 1440
trigger5 = stateno != 1450
v = 10
value = 1
ignorehitpause = 1

[state that tells which direction to go]
type = Varset
triggerall = vel X >= 1 && p1name = "Shadow DIO"
trigger1 = stateno != 450
trigger2 = stateno != 451
trigger3 = stateno != 1430
trigger4 = stateno != 1440
trigger5 = stateno != 1450
v = 10
value = 2
ignorehitpause = 1

[state that tells which direction to go]
type = Varset
trigger1 = stateno = 50 && p1name = "Shadow DIO"
v = 12
value = 1

[state that tells which direction to go]
type = Varset
trigger1 = stateno = 51 && p1name = "Shadow DIO"
v = 12
value = 0

[state assertspecial]
type = assertspecial
trigger1 = (var(13) = [1,59]) && p1name = "Shadow DIO"
flag = noairguard
flag2 = nostandguard
flag3 = nocrouchguard
ignorehitpause = 1

[state for some invincibility]
type = Varadd
trigger1 = var(13) >= 1
trigger1 = 1 && p1name = "Shadow DIO"
trigger1 = var(13) <= 61
v = 13
value = 1

[state that resets a var]
type = Varset
trigger1 = var(13) >= 61 && p1name = "Shadow DIO"
v = 13
value = 0

[state that switches when player is hurt]
type = Varset
triggerall = p1name = "Shadow Dio" && movetype = H
trigger1 = stateno != 150
trigger2 = stateno != 151
trigger3 = stateno != 152
trigger4 = stateno != 153
trigger5 = stateno != 154
trigger6 = stateno != 155
trigger7 = stateno != 130
trigger8 = stateno != 131
trigger9 = stateno != 132
v = 14
value = 1
ignorehitpause = 1

[state that switches when player is hurt]
type = Varset
trigger1 = p1name = "Shadow Dio"
trigger1 = movetype != h
v = 14
value = 0

[State 180, VarRandom]
type = VarRandom
trigger1 = 1 && p1name = "Shadow DIO"
trigger1 = roundstate = 2
v = 1
range = 1,4

[State 180, VarRandom]
type = VarRandom
trigger1 = 1 && p1name = "Shadow DIO"
v = 23
range = 0,2

[State 180, Throw switch]
type = VarSet
triggerall = p1name = "Shadow Dio"
trigger1 = command = "holdback" 
trigger1 = stateno = 900 || stateno = 905
v = 11
value = 1
persistent = 0

[State 180, Throw switch]
type = VarSet
trigger1 = command != "holdback" && p1name = "Shadow Dio"
v = 11
value = 0

[State 180, Win 4]
type = Nothitby
trigger1 = Backedgedist < -1 && p1name = "Shadow Dio"
value = SCA
time = 1

