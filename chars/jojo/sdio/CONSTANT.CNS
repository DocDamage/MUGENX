[state bwee]
type = playsnd
triggerall = name = "Shadow Dio"
trigger1 = numhelper(2210) >= 1
trigger1 = helper(2210), var(36) >= 1
;trigger1 = numhelper(1000) >= 1
;trigger2 = numhelper(2210) >= 1
;trigger2 = helper(2210), var(36) = 1
