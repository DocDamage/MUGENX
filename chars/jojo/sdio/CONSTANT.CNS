[state screenbound activator]
type = PLayerPush
triggerall = name = "Shadow Dio"
trigger1 = winko
value = 0

[state haha]
type = playsnd
triggerall = name = "Shadow Dio"
triggerall = numtarget >= 1
trigger1 = (target, stateno = 267) && (target, time = [0,1])
value = s0,12
volume = 255
abspan = ceil(p2bodydist X)
persistent = 0

[state haha]
type = varadd
triggerall = name = "Shadow Dio"
triggerall = fvar(2) <= 1.8
trigger1 = stateno = 2000 && time >= 26 ; Destruction (WWRYYYY~~!)
trigger2 = stateno = 2010 && time >= 4  ; Deception
trigger3 = stateno = 2100 && time >= 50 ; Charisma
trigger4 = stateno = 2200 && time >= 10 ; Punishment
trigger5 = stateno = 2300 && time >= 4  ; Aerial Punishment (Penalty)
trigger6 = stateno = 2020 && time >= 4  ; Demolition!!!
fvar(2) = .065;75
; var starts counting 4 ticks after superpause begins

[state hehe]
type = varrandom
triggerall = p1name = "shadow dio"
trigger1 = 1 && random = [300,600]
v = 31
range = 0,27

; Stand-based variables
[state hehe]
type = varset
triggerall = name = "Shadow Dio"
trigger1 = numhelper(250) >= 1
trigger1 = helper(250), stateno = 256
fvar(10) = helper(250), gethitvar(yaccel)
ignorehitpause = 1

[state hehehe]
type = velset
triggerall = name = "Shadow Dio"
triggerall = enemy, hitshakeover = 0 && !var(5)
triggerall = statetype = S
triggerall = prevstateno = [200,350]
trigger1 = numhelper(250) >= 1
trigger1 = stateno = 250 && helper(250), movecontact
x = -6 + ifelse((((stateno = [205, 220]) || stateno = [245, 250]) && frontedgebodydist <= 100), -3, 0)
;x = -1.2 + ifelse((((stateno = [205, 220]) || stateno = [245, 250]) && frontedgebodydist <= 100), -.9, 0)
ignorehitpause = 1
;persistent = 0

[state heh]
type = varadd
triggerall = name = "Shadow Dio"
trigger1 = var(33) = [1,60]
var(33) = 1
ignorehitpause = 1

[state heh]
type = varset
triggerall = name = "Shadow Dio"
trigger1 = var(33) >= 61
var(33) = 0
ignorehitpause = 1

; Helper Variables
[state get Y position]
type = varset
triggerall = name = "Shadow Dio"
trigger1 = statetype = A
trigger1 = stateno != [450, 451]
trigger1 = stateno != [1430, 1431]
trigger1 = stateno != [1440, 1441]
trigger1 = stateno != [1450, 1451]
trigger1 = stateno != [2300, 2301]
fvar(3) = vel y
ignorehitpause = 1

[state heh]
type = varset
triggerall = var(13) >= 1 && name = "Shadow DIO"
trigger1 = movehit
trigger2 = numhelper(250) >= 1
trigger2 = helper(250), movehit
trigger3 = numproj >= 1
trigger3 = projhit = 1
trigger4 = stateno = [905,907]
trigger5 = numhelper(1000) >= 1
trigger5 = helper(1000), movehit
trigger6 = numhelper(2101) >= 1
trigger6 = helper(2101), movehit
var(13) = 0
;ignorehitpause = 1

