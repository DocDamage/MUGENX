; Introduction cutscene for Shadow Dio's story.

; This storyboard has multiple scenes.
; Each scene uses two overlay anims, one for the picture, and
; another for the text.
; The fadein and fadeout parameters are used to fade one screen
; to the next.
;
; Shadow Dio uses some sprites in the game, just like any other JoJo
; cutscene. Sprites of Enya Gail (N-Yah) are actually used in this intro
; this time.
;
; Note that this file is pretty long, because I demand quality. >:P
; Elecbyte, we want velocity for this thing dammit!

[SceneDef]
spr = story.sff
startscene = 0         ;Starting scene number (for debugging)

;------------------------------------
[Scene 0, Intro text]
; Fade
fadein.time = 0       ;Time to take for fading in
fadein.col = 0,0,0     ;Use 255,255,255 for white-fade
fadeout.time = 0
fadeout.col = 255,255,255
; Screen color
clearcolor = 0,0,0
; Overlay Anims (from 0 to 9)
;layerall.pos = 160,0   ;Default position for all layers
layerall.pos = 0,0
layer0.anim =  0       ;Anim action number
layer0.offset = 0,0   ;Position offset
layer0.starttime = 0   ;Time to start display
layer1.anim =  13
layer1.offset = 17,99
layer2.anim =  14
layer2.offset = 17,113;99
layer3.anim =  15
layer3.offset = 17,127;99
; Music
bgm = story.mp3        ;Name of music file to play
bgm.loop = 1
; Total time
end.time = 870;780 ;720

;------------------------------------
[Scene 1, Scroll in]
; Fade
fadein.time = 0
fadein.col = 0,0,0
fadeout.time = 0
fadeout.col = 0,0,0
; Screen color
; The previous clearcolor value is carried over by default
; Overlay Anims (from 0 to 9)
; The previous layerall.pos value is carried over by default
layer0.anim =  1
layer0.offset = 0,0
layer0.starttime = 0
layer1.anim = 21
layer1.offset = 60,160
layer2.anim = 22
layer2.offset = 340, 180
layer2.starttime = 155
layer7.anim =  11
layer7.offset = 0,0
layer8.anim =  12
layer8.offset = 0,120
layer9.anim =  10
layer9.offset = 0,0
; Total time
end.time = 410 ;3000

;------------------------------------
[Scene 2, Conversation]
; Fade
fadein.time = 0
fadein.col = 0,0,0
fadeout.time = 0
fadeout.col = 0,0,0
; Overlay Anims (from 0 to 9)
layer0.anim =  16            ; Tomb Background
layer0.offset = -50,0
layer1.anim = 23             ; N-Yah
layer1.offset = 60,160
layer2.anim = 24             ; Dio
layer2.offset = 340, 180
layer6.anim =  10            ; Text Box
layer6.offset = 0,0
layer7.anim = 2              ; Texts
layer7.offset = 0,0
layer7.starttime = 90
; Total time
end.time = 810;3600

;------------------------------------
[Scene 3, final part]
; Fade
fadein.time = 0
fadein.col = 0,0,0
fadeout.time = 0
fadeout.col = 0,0,0
; Overlay Anims (from 0 to 9)
layer0.anim =  17
layer0.offset = -50,0
layer1.anim = 25             ; N-Yah
layer1.offset = 60,160
layer2.anim = 26             ; Dio
layer2.offset = 340, 180
layer4.anim =  18
layer4.offset = 0,0
