[state -1, Standing Guarding CPU Routine]
type = changestate
value = 130
triggerall = enemynear, ctrl = 0
triggerall = enemynear, hitdefattr != SCA, AT
triggerall = hitshakeover
triggerall = roundstate = 2 && win = 0
triggerall = stateno != 130
triggerall = statetype != A
