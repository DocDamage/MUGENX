triggerall = prevstateno != 270
triggerall = var(13) = 0
triggerall = numhelper(1000) = 0
triggerall = numhelper(250) = 0
triggerall = p2stateno != [5100, 5129]
trigger1 = (stateno = 131) * (enemynear, hitdefattr = SA, AA, AP)
trigger2 = (stateno = [140,141]) * (enemynear, hitdefattr = SA, AA, AP)
trigger3 = (ctrl = 1) * (p2movetype = A) * (p2statetype = S) * (enemynear, hitdefattr = SCA, AA, AP)
trigger4 = (enemynear, numhelper >= 1) * (p2movetype = A) * (ctrl = 1)
trigger5 = (stateno = [131,151]) * (p2movetype = A) * (p2bodydist X = [0, 70])
trigger6 = (stateno = [100,101]) * (p2bodydist X = [40,0]) * (p2movetype = A) * (enemynear, hitdefattr = SCA, AA, AP)
trigger7 = (stateno = 0) * (p2bodydist X = [40,0]) * (p2movetype = A) * (enemynear, hitdefattr = SCA, AA, AP)
trigger8 = (stateno = 270) * (animtime = 0) * (p2statetype = C) * (p2movetype = A) * (enemynear, hitdefattr = C, NA, SA, HA) * (p2bodydist X = [0, 50])
trigger9 = (enemynear, hitdefattr = SA, HA, HP) * (stateno = 52 || (ctrl && stateno = [0,20]))
trigger10 = (enemynear, statetype = A) * (stateno = 131) * (Time > 0)
trigger11 = (p2statetype = A) * (stateno = 131) * (Time > 0)
trigger12 = (p2bodydist X >= 10) * (stateno = [120,140]) * (statetype = S) * (enemynear, numhelper >= 1)
trigger13 = (enemynear, projhittime(0) < 0) * (enemynear, numproj >= 1) * (ctrl = 1) * (p2bodydist X <= 50) * (p2statetype != C) 
