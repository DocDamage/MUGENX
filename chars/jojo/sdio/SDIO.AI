[State -1 Guard]
type = ChangeState
value = 131
triggerall = enemynear, ctrl = 0
triggerall = enemynear, hitdefattr != SA, AT
triggerall = hitshakeover
triggerall = roundstate = 2 && win = 0
triggerall = backedgedist > -1
triggerall = var(5) = 0
triggerall = !win
triggerall = statetype != A
triggerall = p2movetype = A
triggerall = var(22) = 1
triggerall = var(13) = 0
triggerall = statetype != A
triggerall = prevstateno != 1205
triggerall = prevstateno != 270
triggerall = numhelper(1000) = 0
triggerall = numhelper(250) = 0
triggerall = p2stateno != [5100, 5129]
triggerall = stateno != 131
trigger1 = (stateno = 270) * (animtime = 0) * (p2statetype = C) * (p2movetype = A) * (enemynear, hitdefattr = C, NA, SA, HA) * (p2bodydist X = [0, 50])
trigger2 = (stateno = [0,20]) * (p2bodydist X = [40,0]) * (p2movetype = A) * (enemynear, hitdefattr = SCA, AA, AP) * (p2statetype = C)
trigger3 = (prevstateno != 270) * (ctrl = 1) * (p2statetype = C)
trigger4 = (enemynear, hitdefattr = C, AA, AP) * (p2statetype = C) * (ctrl = 1)
trigger5 = (ctrl = 1) * (enemynear, hitdefattr = SC, NA, SA, HA) * (p2bodydist X = [0, 50]) * (p2statetype = C)
trigger6 = (movetype = I) * (ctrl = 1) * (enemynear, hitdefattr = C, NA, SA, HA) * (p2bodydist X = [0, 50]) * (p2statetype = C)
trigger7 = (enemynear, hitdefattr = C, AA, AP) * (stateno = 52 || (stateno = [0,20])) * (p2statetype = C) * (ctrl = 1)
trigger8 = (p2statetype = C) * (statetype != A) * (ctrl = 1 && StateNo != 131) * (p2movetype = A)
trigger9 = (Time > 0) * (statetype != A) * (enemynear, numproj > 0) * (ctrl = 1 || stateno = 120 || (stateno = [130,131])) * (Time > 0)
trigger10 = (enemynear, numhelper >= 1) * (p2bodydist X >= 10) * (stateno = [120,140]) * (statetype = C)
trigger11 = (enemynear, projhittime(0) < 0) * (enemynear, numproj >= 1) * (ctrl = 1) * (p2bodydist X <= 50) * (p2statetype != A) 

;ignorehitpause = 1

