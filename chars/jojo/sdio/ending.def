; Ending cutscene for Shadow Dio's story.

; Like the intro, this storyboard has multiple scenes.
; Each scene uses two overlay anims, one for the picture, and
; another for the text.
; The fadein and fadeout parameters are used to fade one screen
; to the next.
;
; This ending is pretty similar to the one in the old format, sans
; Shadow Dio's proper color when you select it on the character select.

[SceneDef]
spr = story.sff
startscene = 0         ;Starting scene number (for debugging)

;------------------------------------
[Scene 0, The Whole of it!]
; Fade
fadein.time = 60       ;Time to take for fading in
fadein.col = 0,0,0     ;Use 255,255,255 for white-fade
fadeout.time = 90
fadeout.col = 0,0,0
; Screen color
clearcolor = 0,0,0
; Overlay Anims (from 0 to 9)
layerall.pos = 0,0    ;Default position for all layers
layer0.anim =  0      ;The scene
layer0.offset = 0,0
layer0.starttime = 0  ;
layer1.anim =  1      ;Dio's Face
layer1.offset = 0,0
layer1.starttime = 1350
layer2.anim =  2      ;Texts
layer2.offset = 0,0
layer2.starttime = 90
; Music
;bgm = c:\callus\jojoending.mp3
;story.mp3       ;Name of music file to play
bgm = story.mp3
bgm.loop = 1
; Total time
end.time = 2760;460

;Background image
[Begin Action 0]
23,0, 0,0, -1

;Text
[Begin Action 2]
22,0, 0,0, 420
22,1, 0,0, 420
22,2, 0,0, 420
22,3, 0,0, 420
22,4, 0,0, 420
22,5, 0,0, -1

;Dio's Face
[Begin Action 1]
20,0, 32,52, -1

