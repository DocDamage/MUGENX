; JoJO Style Recovery (grafted from MBS' Hol Horse), and optimized for
; Shadow Dio
;---------------------------------------------------------------------------

; HIT_AIRFALLRECOVER
[Statedef 5210]
type    = A
movetype= I
physics = N
anim = 5210
ctrl = 0
facing = 1

[State 5210, 1] ;Blink white
type = PalFX
trigger1 = Time = 0
time = 3
add = 64,64,64

[State 5210, 1]
type = PosFreeze
trigger1 = Time = 0
value = 3

[State 5210, 2] ;Turn if not facing opponent
type = Turn
trigger1 = p2bodydist X <= 0 && time = 20

[State 5210, 1]
type = VelMul
trigger1 = Time = 4
x = .5
y = .50

[State 5210, Straight Down]
type = Velset
triggerall = Time = 4
trigger1 = Command != "holdfwd"
trigger1 = Command != "holdback"
trigger2 = var(22) = 1 && p2bodydist X > 80
y = -10.10
x = 0

[State 5210, 2] ;Go fwd
type = Velset
triggerall = Time = 4
trigger1 = Command = "holdfwd"
trigger2 = var(22) = 1 && frontedgedist > 50 && p2bodydist X < 40
trigger3 = var(22) = 1 && backedgedist < 50 && p2bodydist X < 40
x = 5
y = -12.10

[State 5210, Straight Down]
type = Velset
triggerall = Time = 4
trigger1 = Command != "holdfwd"
trigger1 = Command != "holdback"
trigger1 = command != "holdup"
trigger1 = command = "holddown"
trigger2 = var(22) = 1 && p2bodydist Y < 0 && p2movetype = A
trigger2 = enemy, vel X < 0
y = 10.10
x = 0

[State 5210, 2] ;Go back
type = Velset
triggerall = Time = 4
trigger1 = Command = "holdback"
trigger2 = Var(22) = 1 && frontedgedist < 50 && p2bodydist X < 40
trigger3 = var(22) = 1 && backedgedist > 50 && p2bodydist X < 40
x = -5
y = -12.10

[State 5210, 3]
type = NotHitBy
trigger1 = Time = 0
value = SCA
time = 15

[State 5210, 4]
type = CtrlSet
trigger1 = Time = 20
value = 1

[State 5210, 5]
type = Gravity
trigger1 = Time >= 4
;y = .35

[State 5210, 5] ;Land on ground
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52 ;JUMP_LAND
ctrl = 1

;---------------------------------------------------------------------------
; HIT_FALLRECOVER (on the ground)
[Statedef 5201]
type    = A
movetype= H
physics = S;N
anim = 5200 + ifelse((var(37) = 1 && command = "holdback") || var(37) = 0, 1, 0)

[state haha]
type = statetypeset
trigger1 = anim = 5200
physics = A

[State 5201, 1] ;Turn if not facing opponent
type = Turn
trigger1 = Time = 0
trigger1 = p2dist X < -5

[State 5201, 2]
type = VelSet
trigger1 = Time = 0
x = ifelse(anim = 5200, -.15, -20)
y = ifelse(anim = 5200, -3.5, 0)

[State 5201, 2]
type = VelSet
trigger1 = anim = 5201 && animelem = 4
x = 0

[State 5201, 3]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5201, 4]
type = NotHitBy
trigger1 = time = 1 && anim = 5200
value = SCA
time = 90

[State 5201, 4]
type = NotHitBy
trigger1 = anim = 5201
value = SCA
time = 90

[State 5201, 4]
type = NotHitBy
trigger1 = anim = 5201 && animtime = 0
value = SCA
time = 10

[State 5201, 5] ;Blink white
type = PalFX
trigger1 = Time = 0
time = 3
add = 128,128,128 ;256,256,256

[State 5201, 6]
type = GameMakeAnim
trigger1 = Time = 1
value = 60
pos = 0, 0
under = 1

[State 5201, 4]
type = Changestate
trigger1 = anim = 5201 && animtime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; HITG_SHAKE
[Statedef 5000]
type    = S
movetype= H
physics = N
velset = 0,0

[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),5000,5010) + GetHitVar(animtype)

[State 5000, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030

[State 5000, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type

[State 5000, 3] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0 && gethitvar(animtype) = [3,5]
value = anim

[State 5000, 4] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 && GetHitVar(fall)
trigger2 = Pos Y != 0
value = a

[State 5000, 5]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0
value = 5001 ;HITG_SLIDE

[State 5000, 6]
type = ChangeState
trigger1 = HitShakeOver
value = 5030

[State 5000, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 5000, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5000, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

