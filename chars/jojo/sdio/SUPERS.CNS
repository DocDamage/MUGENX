[State 2001, Elemental]
type = ChangeAnim
trigger1 = command != "hold_x" && command != "hold_y"
trigger1 = command != "hold_z" && time <= 50
trigger2 = time > 50
trigger3 = (var(22) = 1) * (p2dist X < 60) * (ifelse(var(13) >= 1, 1, p2dist Y >= -120)) * (time <= 50) * (enemynear, ctrl = 0) * (enemynear, movehit = 0)
trigger4 = (var(22) = 1) * (p2movetype != H) * (p2stateno != [5200,5999]) * (enemynear, vel Y > 0) * (enemynear, pos Y >= -120) * (time <= 50) * (p2bodydist X = [0,120])
trigger5 = (numhelper(250) >= 1) 
trigger5 = (var(22) = 1) * (helper(250), movehit) * (p2bodydist X = [0,120]) * (enemynear, ctrl = 0)
trigger6 = (var(22) = 1) * (enemynear, vel Y > 0) * (enemynear, ctrl = 0) * (p2bodydist X = [10,120])
