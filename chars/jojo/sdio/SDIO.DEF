; Definition file for Shadow Dio
; Contains all the filenames needed for the character
; Player information.
; Omitting some of the information may cause the character may cause the
; character to malfunction.

[Info]
name               = "Shadow DIO"
;displayname       = "Jyakku no keshin DIO"
;displayname       = "DIO's evil incarnation"
versiondate        = 06,01,2001      ;Version date of character
mugenversion       = 04,14,2001      ;Version of M.U.G.E.N character works on
author             = "Orochi Herman" ;Character author name
pal.defaults       = 4,5,6,1,2,3     ;Default palettes in order of preference
original.creator   = "CAPCOM"
converter.homepage = "http://rotb.cjb.net"

; Files for the player
[Files]
cmd      = sdio.cmd       ; Command sets.
cns      = sdio.cns       ; Constants
st       = sdio.cns       ; States
st1      = override.cns   ; Overriden Constants from common1.cns
st2      = constant.cns   ; States that are always checked.
st3      = supers.cns     ; Super moves
st4      = misc.cns       ; Extra states for some special stuff
st5      = sdio.ai        ; Custom Artificial Intelligence settings.
stcommon = common1.cns    ; Common states (in data/)
sprite   = sdio.sff       ; Sprite
;sprite   = sdio2.sff
anim     = sdio.air       ; Animation
sound    = sdio.snd       ; Sound

pal4 = original.act          ; Original Color!!
pal5 = alternate.act         ; His real Alternate Pallate from JoJo
pal6 = jojo2ha.act           ; JoJo2 HA Color
pal1 = jojo2stand.act        ; JOJo2 STand color
pal2 = jojo2start.act        ; JoJo2 START color.
pal3 = shindio.act           ; Real Dio color!
pal10 = shindioalternate.act ; Real Dio's Alternate color.
pal11 = grey.act             ; Grey and WHite outfit!
pal12 = silentdio.act        ; These is Silent Strom's coloured lol!
pal7 = devil.act             ; The old Devil color from 0627!
pal8 = pink.act              ; Pink color with pale skin
pal9 = ebony.act             ; True darkness in the get-up! >:)

; Arcade mode elements!!
[Arcade]
intro.storyboard = intro.def
ending.storyboard = ending.def
