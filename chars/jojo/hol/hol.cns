;ホルホース

[Data]
life = 1000
power = 3000           ;スタート時の体力
attack = 100         ;攻撃力（％）
defence = 100        ;防御力（％）
fall.defence_up = 50 ;転んだとき（つまり寝てる状態の時の防御力ＵＰする割合）
liedown.time = 30    ;起き上がりまでの時間
airjuggle = 15       ;Can do 15 points of juggling
sparkno = 0tェクトＮＯ
guard.sparkno = 0tェクトＮＯ
KO.echo = 0          ;ＫＯ時の声のエコー
volume = 0

[Size]
xscale = 1           ;キャラ横幅の比率
yscale = 1           ;キャラ縦幅の比率
ground.back = 20     ;通常時のキャラの大きさ（後ろ方向）（中心から足先までの長さ）
ground.front = 20    ;通常時のキャラの大きさ（前方向）（中心から足先までの長さ）
air.back = 20        ;空中時のキャラの大きさ（後ろ方向）（中心から足先までの長さ）
air.front = 10       ;空中時のキャラの大きさ（後ろ方向）（中心から足先までの長さ）
z.width = 3          ;？
height = 90          ;高さ？
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90;Default attack distance for projectiles
head.pos = -5, -90   ;Approximate position of head
mid.pos = -5, -60 
shadowoffset = 0

[Velocity]
walk.fwd  = 2.5     ;前進速度
walk.back = -2.5    ;後退速度
run.fwd  = 5,0      ;前ダッシュ速度，浮き上がり設定
                    ;浮き上がり0より小さく設定することによって
                    ;キャラが飛びあがる（飛びのきなど）
run.back = -5,0     ;後ろダッシュ，浮き上がり設定
jump.neu = 0,-9     ;垂直ジャンプ
jump.back = -3,5    ;後ろジャンプ
jump.fwd = 3,5      ;前ジャンプ
runjump.neu = -20
runjump.fwd = 4.5

[Movement]
airjump.num = 0       ;二段ジャンプ回数
airjump.height = 35   ;二段ジャンプの高さ
yaccel = .43          ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching
