; Definition file for Kakyoin
; Contains all the filenames needed for the character

; Player information
[Info]
name    = "Kakyoin EX"
displayname = "Noriaki Kakyoin"
versiondate  = 04,15,2001       ;Version date of character
mugenversion = 04,01,2001       ;Version of M.U.G.E.N character works on
author       = "Orochi Herman"  ;Character author name
pal.defaults = 1,2,3,4          ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = kakyoin.cmd
cns     = kakyoin.cns      ;Constants
st      = kakyoin.cns      ;States
st1     = override.cns     ;Overriden Data
st2     = misc.cns
st3     = supers.cns
stcommon = common1.cns     ;Common states (in data/)
sprite  = kakyoin.sff      ;Sprite
anim    = kakyoin.air      ;Animation
sound   = kakyoin.snd      ;Sound
;pal1    = original.act
;pal2    = black.act
;pal3    = blue.act
;pal4    = yellow.act
;pal5    = brown.act
