; JoJO Style Recovery (grafted from MBS' Hol Horse), and optimized for
; Shadow Dio
;---------------------------------------------------------------------------

; HIT_AIRFALLRECOVER
[Statedef 5210]
type    = A
movetype= I
physics = N
anim = 5210
ctrl = 0
facing = 1

[State 5210, 1] ;Blink white
type = PalFX
trigger1 = Time = 0
time = 3
add = 64,64,64

[State 5210, 1]
type = PosFreeze
trigger1 = Time = 0
value = 3

[State 5210, 2] ;Turn if not facing opponent
type = Turn
trigger1 = p2bodydist X <= 0 && time = 20

[State 5210, 1]
type = VelMul
trigger1 = Time = 4
x = .5
y = .50

[State 5210, Straight Down]
type = Velset
triggerall = Time = 4
trigger1 = Command != "holdfwd"
trigger1 = Command != "holdback"
trigger2 = var(22) = 1 && p2bodydist X > 80
y = -12.10
x = 0

[State 5210, 2] ;Go fwd
type = Velset
triggerall = Time = 4
trigger1 = Command = "holdfwd"
trigger2 = var(22) = 1 && frontedgedist > 50 && p2bodydist X < 40
trigger3 = var(22) = 1 && backedgedist < 50 && p2bodydist X < 40
x = 5
y = -12.10

[State 5210, 2] ;Go back
type = Velset
triggerall = Time = 4
trigger1 = Command = "holdback"
trigger2 = Var(22) = 1 && frontedgedist < 50 && p2bodydist X < 40
trigger3 = var(22) = 1 && backedgedist > 50 && p2bodydist X < 40
x = -5
y = -12.10

[State 5210, 3]
type = NotHitBy
trigger1 = Time = 0
value = SCA
time = 15

[State 5210, 4]
type = CtrlSet
trigger1 = Time = 20
value = 1

[State 5210, 5]
type = Gravity
trigger1 = Time >= 4
;y = .35

[State 5210, 5] ;Land on ground
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52 ;JUMP_LAND
ctrl = 1

