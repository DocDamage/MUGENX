; Var(1) = Used for randomizing winposes
; Var(2) = Used for randomizing stances, tauntposes and some stuff.
; Var(3) = Dedicated variable for taunt poses
; Var(4) = Stores animation used, to return when turning
; Var(5) = Heirophant Green SinAdd simulator

[Data]
life = 1200          ;Amount of life to start with
attack = 120         ;100% attack power (more is stronger)
defence = 100        ;100% defensive power (more is stronger)
power = 10000        ;Power rating (10000 for JoJo Style)
fall.defence_up = 50 ;Def goes up by 50% everytime player is hit on ground
liedown.time = 60    ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 15       ;Can do 15 points of juggling
sparkno = 2        ;Default spark number
guard.sparkno = 40 ;Default guard spark number
KO.echo = 0           ;1 to enable echo on KO
;volume = 0           ;Volume offset (negative for softer)

[Size]
xscale = 1         ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
height = 60
ground.back = 16     ;Player width (back, ground)
ground.front = 24    ;Player width (front, ground)
air.back = 11        ;Player width (back, air)
air.front = 24       ;Player width (front, air)
z.width = 23          ;Player width (into and out)
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
head.pos = -26, -100
mid.pos = -10, -67

[Velocity]
walk.fwd  = 2.9      ;Walk forwar
walk.back = -2.6     ;Walk backward
run.fwd  = 0, 0    ;Run forward (x, y)  - if y<0, player will hop
run.back = -10, ;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-10    ;Neutral jumping velocity (x, y)
jump.back = -3.2     ;Jump back Speed (x, y)
jump.fwd = 4.       ;Jump forward Speed (x, y)
runjump.fwd = 3.9    ;.
airjump.neu = 0      ;.
airjump.back = -2.55 ;Air jump speeds (opt)
airjump.fwd = 2.5    ;.

[Movement]
airjump.num = 0  ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .58         ;Vertical acceleration
stand.friction = .84  ;Friction coefficient when standing
crouch.friction = .8 ;Friction coefficient when crouching

