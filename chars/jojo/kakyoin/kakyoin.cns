;---------------------------------------------------------------------------
; States that are always checked (use -2) :
;---------------------------------------------------------------------------

[Statedef -2]

; Play "hmmph" sound when recovering in air or on ground
[State -2, 1]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 5201
trigger2 = stateno = 5210
value = 2,ifelse(random >= 500, 1, 2)
channel = 0

; Less wide in front when hit
[State -2, 1]
type = Width
trigger1 = stateno = 5000
trigger2 = stateno = 5001
value = -13

; Get rid of trailing anims when hit
[State -2, 1]
type = AfterImageTime
triggerall = Time = 0
trigger1 = movetype = H
time = 0

[state haha]
type = varrandom
trigger1 = 1
v = 3
range = 0,4
ignorehitpause = 1

[state haha]
type = varset
trigger1 = stateno != 0
var(4) = 0
ignorehitpause = 1

[State -3, Ow Sound]
type = PlaySnd
triggerall = alive && time = 1
trigger1 = stateno = 5001 || stateno = 5011
;trigger1 = (anim % 10) != 0 ;Not hit light
trigger1 = random < ifelse ((anim % 10) = 1, 400, 750)
trigger2 = stateno = 5040 || stateno = 5050
trigger2 = random < 500
trigger3 = stateno = 5070
trigger4 = stateno = 5100 && random < 250
value = S3,var(3)
channel = 0
;lowpriority = 1
ignorehitpause = 1

[State 210, KO Screen 8]
type = helper
triggerall = lose && numhelper(6010) = 0
triggerall = roundstate <= 3
