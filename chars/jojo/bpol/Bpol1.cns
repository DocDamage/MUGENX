; INTRO
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0,0

[State 191, 1]
type = ChangeState
trigger1 = p2name = "HOL HORSE"
value = 195
ctrl = 0

[State 191, 1]
type = ChangeState
trigger1 = p1name = "HOL HORSE"
value = 197
ctrl = 0

[State 191, 2] ;Assert this until you want "round 1, fight" to begin
