; Definition file for bpol
; Contains all the filenames needed for the character

; Player information
[Info]
name = "BlackPolnareff"
displayname = "BlackPolnareff"


; Files for the player
[Files]
cmd     = Bpol.cmd   ;Command set
cns     = Bpol1.cns   ;Constants
st      = Bpol1.cns   ;States
st1     = bpol-s1.cns      ;ExStates 
st2     = bpol-s2.cns      ;ExStates 
st3     = bpol-s3.cns      ;ExStates 
st4     = bpol--1.cns     ;ExStates (-1 state)
st5     = bpol-stand1.cns   ;ExStates (standbutton)
st6     = bpol-stand2.cns   ;ExStates (standbutton)
st7     = bpol-stand3.cns   ;ExStates (standbutton)
st8     = bpol-stand4.cns   ;ExStates (standbutton)
st9     = bpol-stand5.cns   ;ExStates (standbutton)
stcommon = common1.cns     ;Common states
sprite  = Bpol01.sff   ;Sprite
anim    = Bpol.air   ;Animation
sound   = Bpol.snd   ;Sound
pal1    = bpol1.ACT   ;Palettes (can have up to 12)
pal2    = bpol2.act  ;
;pal3    = bpol3.act  ;
;pal4    = bpol4.act  ;
