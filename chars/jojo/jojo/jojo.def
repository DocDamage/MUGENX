; Player information
[Info]
name = "Jotaro Kujo"        ;Name of character
displayname = "Jotaro Kujo" ;Name of character to display
versiondate = 08,12,2000    ;Version date of character
mugenversion = 06,27,2000   ;Version of M.U.G.E.N character works on
author = "MBS" 
[Files]
cmd      = jojo.cmd       ;コマンド
cns      = jojo.cns       ;基本設定
st       = jojo0.st      ;行動（スタンドダメージ）
st1      = jojo1.st       ;行動（基本攻撃）
st2      = jojo2s.st      ;行動（スタンドが発生する必殺技）
st3      = jojo2.st       ;行動（必殺技）
st5      = jojo-s1.st     ;スタンドモード基本行動
st6      = jojo-s2.st     ;スタンドモード（必殺技）
st9      = jojo-ss.st     ;スタンドモードシステム
stcommon = jojo-c.cns     ;コモンファイル
sprite   = jojo.sff       ;スプライト
anim     = jojo.air       ;アニメーション
;sound   = jojo.snd       ;効果音（未対応）
pal1     = jojo.act      ;パレット
pal2     = jojo2.act     ;パレット
;pal3     = jojo3.act     ;パレット
