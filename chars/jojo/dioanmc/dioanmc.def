; Definition file for kfm
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Dio by ANMC"        ;Name of character
displayname = "Dio" ;Name of character to display
versiondate = 17,11,2000    ;Version date of character
mugenversion = 07,31,2000   ;Version of M.U.G.E.N character works on
author = "ANMC"         ;Character author name
pal.defaults = 1,4,7      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = dioanmc.cmd   ;Command set
cns     = dioanmc.cns   ;Constants
st      = dioanmc.cns   ;States
st2 = always.txt
st3 = Special1000.txt
st4 = TheWorldGetHit.txt
st5 = TheWorld(Pause).txt
st6 = kinfe.txt
st7 = StandState.txt
st8 = Standattack.txt
st9 = StandSuperAttack.txt
stcommon = diocommon1.cns ;Common states
sprite  = dioanmc.sff   ;Sprite
anim    = dioanmc.air   ;Animation
sound   = Dioanmc.snd   ;Sound
pal1    = dioanmc.act  ;Palettes (can have up to 12)
pal2    = dioanmc.act  ;Palettes (can have up to 12)
pal3    = dioanmc.act  ;Palettes (can have up to 12)
pal4    = dioanmc3.act  ;Palettes (can have up to 12)
pal5    = dioanmc3.act  ;Palettes (can have up to 12)
pal6    = dioanmc3.act  ;Palettes (can have up to 12)
pal7    = dioanmc2.act  ;Palettes (can have up to 12)
pal8    = dioanmc2.act  ;Palettes (can have up to 12)
pal9    = dioanmc2.act  ;Palettes (can have up to 12)
pal10    = dioanmc2.act  ;Palettes (can have up to 12)
pal11    = dioanmc2.act  ;Palettes (can have up to 12)
pal12    = dioanmc2.act  ;Palettes (can have up to 12)
