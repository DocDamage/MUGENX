;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
;		カレー先輩勝利の瞬間 「おなかすいちゃいました（はぁと」
;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[Statedef 180]
type = S
anim = 180
velset = 0,0
ctrl = 0

[State 180, 0]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

[State 180, 0-voice.random]
type = VarRandom
trigger1 = Time = 0
V = 26
range = 0,3
[State 180, 0-voice]
type = PlaySnd
trigger1 = Time = 1 && Life < 600
value = 56,IfElse(Var(26) <= 1 ,5, 7)
[State 180, 1-voice]
type = PlaySnd
trigger1 = Time = 1 && Life >= 600
value = 56,IfElse(Var(26) <= 1, 6, IfElse(Var(26) = 2, 5, 7))

;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[State 180, win_]
type = AssertSpecial
trigger1 = MatchOver = 1 && (Time = [0,960])
flag = RoundNotOver

[State 180, win_]
type = AssertSpecial
trigger1 = MatchOver = 1 && Time >= 180
flag = NoShadow
flag2 = Invisible
flag3 = NoBarDisplay

[State 180, cut_in];
type = Helper
trigger1 = MatchOver = 1 && Time = 180
name = "cut_in_s"
stateno = 181
postype = Right
pos = -220,-118
sprpriority = 4
ignorehitpause = 1
persistent = 0
bindtime = 1
ownpal = 1
size.xscale = 0.54
size.yscale = 0.54


