;//////////////////////////////////////////////////////////////////////////////
;by sumi			- シエル -			CIEL (ELEICIA)
;//////////////////////////////////////////////////////////////////////////////
[Data]
life = 1000		;Amount of life to start with
attack = 98		;100% attack power (more is stronger)
defence = 102		;100% defensive power (more is stronger)
fall.defence_up = 60	;Def goes up by 50% everytime player is hit on ground
liedown.time = 70	;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 25		;Can do 15 points of juggling
sparkno = 0		;Default spark number
guard.sparkno = S8090	;Default guard spark number
KO.echo = 0		;1 to enable echo on KO
Volume = 255		;大声で（違
IntPersistIndex = 59	;次ラウンドへVar持ち越し

[Size]
xscale = 1		;Horizontal scaling factor.
yscale = 1		;Vertical scaling factor.
ground.back = 20	;Player width (back, ground)
ground.front = 20	;Player width (front, ground)
air.back = 20		;Player width (back, air)
air.front = 20		;Player width (front, air)
z.width = 3		;Player width (into and out)
attack.width = 4,4	;Default attack width: back, front
attack.dist = 160	;Default attack distance
proj.attack.dist = 90	;Default attack distance for projectiles

[Velocity]
walk.fwd  = 2.2;2.4	;Walk forward
walk.back = -1.8	;Walk backward
run.fwd  = 4.6;7	;Run forward (x, y)  - if y<0, player will hop
run.back = -4.5,-3.8;-6	;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-7.6;-13,8	;Neutral jumping Vel (x, y)
jump.back = -1.32;-0.27	;Jump back Speed (x, y)
jump.fwd = 1.8;0.2	;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1;Running jump speeds (opt)
runjump.fwd = 4,-8.1	;
airjump.neu = 0,-6.5	;0,-9,1
airjump.back = -1.33	;,-9.1
airjump.fwd = 1.8;,-9.1	;

[Movement]
airjump.num = 0;1	;Number of air jumps allowed (opt)
airjump.height = 55	;Minimum distance from ground before you can air jump (opt)
yaccel = .34		;Vertical acceleration
stand.friction = .85	;Friction coefficient when standing
crouch.friction = .82	;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...
;---------------------------------------------------------------------------

;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
;　カレー先輩、カレーに登場（寒）　「さてさて、お相手しましょうか（黒はぁと」
;++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
[Statedef 190]
type = S
ctrl = 0

[State 190, remove_shadow]
type = AfterImageTime
trigger1 = Time = 0
value = 0
[State 190, power]
type = PowerSet
trigger1 = Time = 0
value = 1000

[State 190, Random]
type = VarRandom
trigger1 = Time = 0
V = 1
range = 1,2
[State 190, intro_1]
type = ChangeState
trigger1 = Var(1) = 1
value = 191
[State 190, intro_2]
type = ChangeState
trigger1 = Var(1) = 2
value = 195

