;渡辺製作所さんの「MELTY BLOOD」より　シエル先輩です！
; Player information
[Info]
name = "CIEL(ELEICIA)"			;Name of character
displayname = "CIEL"		;Name of character to display
versiondate = 12,09,2003	;Version date of character
mugenversion = 04,14,2001	;Version of M.U.G.E.N character works on
author = "SUMI"			;Character author name
pal.defaults = 1,2,3,4

; Files for the player
[Files]
cmd	= ciel.cmd		;Command set
cns	= ciel.cns		;Constants
st	= ciel.cns		;Usual States
st1	= ciel-s.cns		;Special & Super States
st2	= ciel-ai.cns		;カレーなﾖｶｰﾝ＠擬似AI
;st3	= today.cns		;today.system
stcommon = ciel_common.cns	;Common states
sprite	= ciel.sff		;Sprite
anim	= ciel.air		;Animation
;sound	= ciel_nv.snd		;Sound
sound	= ciel.snd		;Sound
pal1	= ciel.act		;Palettes (can have up to 12)
pal2	= ciel2.act
pal3	= ciel3.act
pal4	= ciel4.act
pal5	= ciel.act
pal6    = ciel2.act
pal7    = ciel.act
pal8    = ciel4.act
pal9    = ciel.act
pal10   = ciel2.act
pal11   = ciel3.act
pal12   = ciel4.act


;[][][][][][][][][][][][][][ 製作者の戯言 ][][][][][][][][][][][][][][][][]


;━━━━━━━━━━━━ちょっと素敵な先輩━━━━━━━━━━━━
;放課後、特に用があるわけでもないのに俺は教室に残っていた。
;「だって、この選択肢を選ぶと現れるんだもんな、彼女が・・・」
;などと意味不明なことを呟くも、その"彼女"は一向に現れない。
;(´-`).｡ｏO(･･･おかすぃな・・・選択肢、間違えたかな？)
;さすがにちょっと心配になってきた・・・。
;かれこれ、２時間も待ってるじゃないか。（帰れよ
;しょうがない、あと１０秒待ってこなかったら帰ろう。
;「い～～～ち」
;「健全で善良な一般市民は・・（低音）」←背後から
;「どわああ、せっせせ、先輩！」
;「ﾀｲﾐﾝｸﾞ見計らってたんですかぁ！？」
;「(￣ー￣)ﾆﾔﾘ」

;━━━━━━━━━━━ほとばしる熱いパトスで━━━━━━━━━━━
;「いったいどうしたんですか？こんな時間まで」
;「いや、特に意味はないんだけど・・・」
;「じゃあ暇なんですね？」
;「まぁ、そうですね・・・」
;「じゃあ、これから私とビーフカレーについて熱く語りま「帰れ」

;━━━━━━━━━━━同情するならカレー食え━━━━━━━━━━━
;「ひどいです、遠野君。先輩に向かっていきなり『帰れ』だなんて」
;「いや、だって先輩が・・・」
;「わかりました、じゃあチキンカレーについて熱「いいから帰れ」


;はいはい～、鬼屋敷の管理人すみです。こんにちは。
;いやはや、ようやくVer.1.00公開です。
;長かった・・・（ＴＴ
;原作に忠実に再現したつもりですが・・・どうなってることやらｗ
;さてさて、第一作目ということもあって色々と思いで深いｷｬﾗになりました＾＾
;一時はＳＦＦの内容がすべて消滅、バックアップを取ってなかった僕は
;ヽ(`Д´)ﾉｳﾜｰﾝ、と思わず自転車で日本一周したくなるような衝動に駆られつつ
;なんとか、ここまで完成させることが出来ました・・・。
;そして、基本技だけで半分くらい時間を取られましたね～（汗
;ハイロゥや黒鍵投げはすぐに出来たんですが、、なぜか基本技（笑
;さて、だらだら書くと容量の問題で見つかってしまうので（拓也さんみたいにｗ）
;え？十分容量がﾌﾂｰじゃないって？そうですか(´･ω･`)
