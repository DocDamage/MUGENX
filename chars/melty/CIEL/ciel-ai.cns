ID = 8400
POSTYPE = P1
POS = 0,0
VEL = 0,0
SPRPRIORITY = -4
SUPERMOVETIME = 999
PAUSEMOVETIME = 999
PERSISTENT = 0
IGNOREHITPAUSE = 1
BINDTIME = 1
;OWNPAL = 1
SCALE = 0.5,0.5

