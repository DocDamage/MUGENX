[Statedef -2];【 常時監視 】

[State -2, 100];Over
type = DisplayToClipboard
trigger1 = 1
text = "P2Dist X:%f, P2Dist Y:%f, Var(16)[ECS]:%d, HSN:%d, ccc:%d"
params = P2BodyDist X,P2BodyDist Y,Var(16),Var(11),Var(33)
[State -2, 101];Under
type = AppendToClipboard
trigger1 = 1
text = "\nPos X[ %f ], V(6)[kokken]:%d, V(14)[T-CH]:%d, Var(7)[H.UP]:%d, [AI]:%d"
params = Pos X,Var(6),Var(14),Var(7),Var(59)

;//////////////////////////////// Debug system ////////////////////////////////
[State -2, debug_pos y]
type = PosSet
trigger1 = (StateNo = 0 || Anim = 0)||(StateNo = 11 || Anim = 11)||(StateNo = 12 || Anim = 12)
;trigger3 = Pos Y > 0
trigger2 = ((StateNo = [200,202])||(StateNo = [210,221]))||(StateNo = [400,410])||(StateNo = 420)
Y = 0

[State -2, dash_anim]
type = RemoveExplod
trigger1 = PrevStateNo = 100 && MoveType = H
ID = 102
[STate -2, HitSparkBlue];Remove
type = null;RemoveExplod
trigger1 = Time = 0
ID = 8010
[State 1020, shadow]
type = AfterImageTime
trigger1 = StateNo != [1020,1021]
trigger1 = StateNo != [1070,1071]
value = 0

[State 52, 0-1];AirDash VarReset
type = VarSet
trigger1 = StateNo = 0 || StateType = S
V = 10
value = 0
[State 52, 0-2];ErialComboStart VarReset
type = VarSet
triggerall = !(StateNo = 40 || StateNo = 50)
trigger1 = StateType = A || P2StateType != A || StateNo = 20
V = 16
value = 0
[State -2, 0-3];Hylow Edge to Jump Flag
type = VarSet
trigger1 = StateType = S || Ctrl = 1
V = 17
value = 0
[State -2, 0-3];Kokken Light or Medium Flag
type = VarSet
trigger1 = (StateNo != [1200,1399]) || Ctrl = 1
V = 6
value = 0
[State -2, 0-4];Throw-CrouchHigh FlagReset
type = VarSet
trigger1 = P2MoveType != H || ((P2StateNo != [5000,5999])&&(P2StateNo != [900,999])&&(P2StateNo != [208,209]))
V = 14
value = 0
[State -2, HitSparkNoBlue];RoundStart HitSparkBlue VaeSet
type = VarRandom
trigger1 = RoundState = 2 && Time = 0
V = 12
range = 8010,8017

[State -2, standlow];varreset
type = VarSet
trigger1 = StateNo != [200,202]
var(27) = 0

[State 780, -];CommandVarReset
type = VarSet
trigger1 = Command != "holdback"
var(29) = 1
[State 780, --]
type = VarSet
trigger1 = Anim = 21 || (Anim = [150,152]);Ctrl = 0 && StateNo != 780
trigger2 = StateNo = 780 && Command = "holdback"
var(29) = 0

[State 780, -];CommandVarReset
type = VarSet
trigger1 = Command != "holddown"
var(30) = 1
[State 780, --]
type = VarSet
trigger1 = Anim = 10 || Anim = 11;;Ctrl = 0 && StateNo != 780
trigger2 = StateNo = 790 && Command = "holddown"
var(30) = 0

[State -2, dash];DashJumpFlagReset
type = VarSet
trigger1 = StateNo != 40 && (StateNo = 0 || StateType != A)
trigger2 = StateNo = 110 || StateNo = 115
var(32) = 0

[State -2, cc];counter _vs arc
type = VarSet
trigger1 = StateNo = 0;!= [200,299]; || StateType = S
trigger2 = P2Name = "Arcueid Brunestud" && P2MoveType = A
V = 33
value = 0
[State -2, cc];counter _vs arc[2]
type = VarSet
trigger1 = StateNo = 0 || StateNo = 11 || StateType = A;!= [200,299]; || StateType = S
;trigger2 = P2Name = "Arcueid Brunestud" && P2MoveType = A
V = 34
value = 0

;///////////////////////////// Cancel Jump System /////////////////////////////
[State 600, -620];AirAttackCancelJump[VarSet]
type = null;VarSet
trigger1 = ((StateNo = 600 && AnimElem >= 2)||(StateNo = 610 && AnimElem >= 5)||(StateNo = 620 && AnimElem >= 8))&&(Command = "holdup") && Var(8) = 0
V = 8
value = 1
[State 600, -620];AirAttackCancel[VarReset]
type = VarSet
trigger1 = StateNo = 0 || StateType = S
V = 8
value = 0
[State 600, -620];HoldupCommandStopVarSet
type = VarSet
triggerall = (StateNo = [50,51])||(StateNo = [600,621])
trigger1 = Command != "holdup";1
V = 7
value = 1;ifelse(Command != "holdup", 1, 0)
[State 600, -620];HoldupCommandStopVarReset
type = VarSet
trigger1 = StateNo = 0 || StateType = S
V = 7
value = 0

[State 600, -620];AirAttackCancelJump[State]
type = null;ChangeState
trigger1 = ((StateNo = 600 && AnimElem >= 2)||(StateNo = 610 && AnimElem >= 5)||(StateNo = 620 && AnimElem >= 8))&&(Command = "holdup")
value = 45


;//////////////////////////////// SOUND & VOICE ///////////////////////////////
[State -3, Land]
