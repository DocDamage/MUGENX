trigger1 = P2StateNo = 208 && P2MoveType = H
value = 41,0
;channel = 0
PERSISTENT = 0
IGNOREHITPAUSE = 1

[State -3, StopSnd]
type = StopSnd
triggerall = Time = 1
trigger1 = StateNo = 52
channel = 0

