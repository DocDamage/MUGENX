;==============================================================================
;　HEAT状態
;==============================================================================
[State -2, DisplayToClipBord]
Type = DisplayToClipBoard
Trigger1 = 1
Text = "33=%d,36=%d,32=%d,1=%d"
Params = var(33),var(36),var(32),var(1)
IgnoreHitPause = 1

[State -2, AfterImage]
Type = AfterImage
Trigger1 = Power != 3000
Trigger1 = Var(32) = 0
trans = add
TimeGap = 1
FrameGap = 3
time = 99999
PalBright = 0,0,0
PalContrast = 70,70,70
PalAdd = 0,0,160
PalMul = 1,1,1


[State -2, VarSet]
Type = VarAdd;Set
Trigger1 = Var(33) = 0
Trigger1 = Power >= 3000
V = 33
Value = 1			;HEAT状態フラグ

[State -2, VarSet]
Type = VarSet
Triggerall = var(33) = 1
Trigger1 = var(32) = 2
Trigger2 = power = 0
Trigger2 = var(36) = 0;Power <= 2999
V = 33
Value = 2
[State -2, VarSet]
Type = VarSet
Trigger1 = var(33) = 2
Trigger1 = power >= 1
Trigger2 = power = 0
Trigger2 = var(36) != 0
V = 33
Value = 0		;通常状態フラグ

[State -2, VarSet]
Type = VarSet
Trigger1 = Var(32) = 0
Trigger1 = Power >= 3000
V = 32
Value = 502			;HEAT制限時間設定
Peresistent = 0

[State -2, VarSet]
Type = VarAdd
Trigger1 = Var(32) >= 1
V = 32
Value = -1                      ;HEAT制限時間減少

[State -2, VarSet]
Type = VarSet
Trigger1 = power = 0;Var(33) = 0
V = 32
Value = 0			;通常状態で32 を0 に
Peresistent = 0

[State -2, VarSet]
Type = PowerAdd
Trigger1 = Var(32) >= 1
Value = -6			;ゲージ減少

[State -2, VarSet]
Type = VarSet
Trigger1 = Var(33) = 1
Trigger1 = Var(32) = 1
V = 32
Value = 0			;HEAT制限時間終了

[State -2, PowerSet]
Type = PowerSet
Triggerall = Var(36) = 0
Triggerall = Var(33) >= 1
Trigger1 = var(32) = 2
Trigger2 = power = 0
Value = 2000			;HEAT後ゲージ２００％

[State -2, PowerSet]
Type = PowerSet
Trigger1 = ((stateno = 2100) || (stateno = 2200))
Trigger2 = ((stateno = 2400) || (stateno = 2500)) 
Trigger1 = var(24) = 0
triggerall = var(36) = 0
Value = 1000			;Arc Drive使用後ゲージ１００％

[State -2, VarSet]
Type = VarSet
trigger1 = var(33) = 0
Trigger1 = ((power <= 999) && (power >= 900))
V = 36
Value = 0			;偽HEAT状態フラグ

[State -2, LifeAdd]
Type = LifeAdd
Trigger1 = Var(33) = 1
Trigger1 = GameTime % 5 = 0
Value = 1

