; var(1)  = CPU
; var(6)  = スパーク用
; var(7)  = カットイン用

; var(11) = 音声判定
; var(12) = イントロ判定
; var(13) = イントロ判定

; var(20) = 連続技用
; var(21) = 空中攻撃用
; var(22) = ジャンプ判定用
; var(23) = 空中ダッシュ用
; var(24) = アークドライブ用
; var(25) = コンボ修正用

; var(31) = タイプ判定用
; var(32) = BH時間
; var(33) = BH状態判定
; var(36) = 強制H判定

; var(40) = スパーク用

; fvar(1) = スパーク用
; fvar(2) = スパーク用
; fvar(21) = コンボ修正用
; fvar(22) = コンボ修正用
; fvar(23) = コンボ修正用

;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
;      基本データ
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; キャラクター基準値の設定
;------------------------------------------------------------------------------
[Data]
life              = 1000
attack            = 100
defence           = 100
power             = 3000
fall.defence_up   = 50
liedown.time      = 40
airjuggle         = 12
sparkno           = -1
guard.sparkno     = 40
KO.echo           = 0
volume            = 255
IntPersistIndex   = 31
FloatPersistIndex = 60

;------------------------------------------------------------------------------
; サイズ指定
;------------------------------------------------------------------------------
[Size]
xscale           = 1
yscale           = 1
ground.back      = 13
ground.front     = 19
air.back         = 17
air.front        = 14
height           = 60
attack.dist      = 160
proj.attack.dist = 90
proj.doscale     = 0
head.pos         = -5,-90
mid.pos          = -5,-60
shadowoffset     = 0

;------------------------------------------------------------------------------
; 移動速度の設定
;------------------------------------------------------------------------------
[Velocity]
walk.fwd     = 1.6
walk.back    = -1.2
run.fwd      = 12,0
run.back     = -10,0
jump.neu     = 0,-9
jump.back    = -1.7
jump.fwd     = 2.1
runjump.back = -3,-9.5
runjump.fwd  = 4,-9.5

airjump.neu  = 0,-8
airjump.back = -2.55,-8
airjump.fwd  = 2.5,-8

;---------------------------------------------------------------------------
; 動作の設定
;------------------------------------------------------------------------------
[Movement]
airjump.num     = 1
airjump.height  = 30
yaccel          = .44
stand.friction  = .85
crouch.friction = .82

;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
