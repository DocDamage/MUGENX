;Var(3) = ハイジャンプ
;Var(4) = ヒット数補正
;Var(5) = クリティカルヒット判定
;Var(6) = 
;Var(7) = 
;Var(8) = 
;Var(9) = 空中ダッシュ回数
;Var(10) = ジャンプキャンセル回数
;Var(11) = 2段ジャンプ回数
;Var(12) = リバーサルアタック
;Var(13) = HEAT&BLOODHEAT
;Var(14) = HEAT強制開放
;Var(15) = MAX表示
;Var(16) = 
;Var(17)～Var(19) = スーパーアーマー
;Var(20) = 弱攻撃コンボ制限
;Var(21) = 中攻撃コンボ制限
;Var(22) = 強攻撃コンボ制限
;Var(23) = 特殊攻撃コンボ制限
;Var(24) = 特殊攻撃コンボ制限
;Var(25) = 
