;Var(36)&Var(37) = 根性値
;Var(38) = カウンター判定
;Var(39) = リバースビートスイッチ
;Var(40) = リバースビート/シールドキャンセルカウント
;Var(41) = 特殊基底ダメージ補正カウント
;Var(42) = ＥＸキャンセル補正カウント
;Var(43) = ＥＸエッジダメージ補正カウント
;Var(44) = ＥＸエッジゲージ補正カウント
