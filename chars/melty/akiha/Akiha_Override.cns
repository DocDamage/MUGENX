;立ち
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; ジャンプ開始
[Statedef 40]
type    = S
physics = S
ctrl = 0
sprpriority = 1
facep2 = 1
movehitpersist = 1

;投げに対して無敵
[State 200, 1]
type = NotHitBy
trigger1 = Time = 0
time = 4
value = SC, AT

[State 40, 0]
type = HitBy
trigger1 = Time = 0
time = 4
value = SCA,AA,AP

[State -2, ikari]
type = VelSet
trigger1 = Time = 0
y = 0

[State -2, ikari]
type = PosSet
trigger1 = Time = 0
y = 0

;---------------------
;ジャンプキャンセル用
[State -2, ikari]
type = VarSet
trigger1 = Time = 0
trigger1 = PrevStateNo = [200, 499]
v = 25
value = 1
ignorehitpause = 1

;---------------------
;二段ジャンプ用
[State -2, ikari]
type = VarSet
trigger1 = Time = 0
v = 14
value = 0
ignorehitpause = 1

[State -2, ikari]
type = VarSet
trigger1 = Command != "holdup"
trigger1 = Var(14) = 0
v = 14
value = 1
ignorehitpause = 1

;---------------------

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

;---------------------
;ノーマルジャンプ
[State 40, 6]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(Command = "holdfwd", 41, ifelse(Command = "holdback", 42, 40))

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

;---------------------
;ダッシュジャンプ
[State -2, ikari]
type = VarSet
trigger1 = Time = 0
trigger1 = prevstateno != 100
v = 22
value = 0

[State -2, ikari]
type = VarSet
trigger1 = Time = 0
trigger1 = prevstateno = 100
v = 22
value = ceil(Vel X)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = Var(22) > 0
x = ifelse(sysvar(1) = 0, 1.5, ifelse(sysvar(1) = 1, 3, -1))

;---------------------
;ハイジャンプ
[State 40, 6]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Var(21) = [-9,-1]
trigger1 = sysvar(1) = 1
trigger1 = MoveContact = 0
value = 46

[State 40, 4]
type = VelSet
trigger1 = Var(21) = [-9,-1]
trigger1 = sysvar(1) = 1
trigger1 = AnimTime = 0
trigger1 = MoveContact = 0
x = 5
y = const(velocity.jump.y)

[State 40, 6]
type = ChangeState
trigger1 = Var(21) = [-9,-1]
trigger1 = sysvar(1) = 1
trigger1 = AnimTime = 0
trigger1 = MoveContact = 0
value = 7300
ctrl = 1

;---------------------
[State 40, 6]
