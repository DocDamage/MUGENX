;Var(0)	：ランダム音声、炎
;Var(1)	：カウンターヒット
;Var(2)	：チェーン判定(立－小)
;Var(3)	：チェーン判定(立－中)
;Var(4)	：チェーン判定(立－大)
;Var(5)	：チェーン判定(立－→大)
;Var(6)	：チェーン判定(立－←大)
;Var(7)	：チェーン判定(屈－小)
;Var(8)	：チェーン判定(屈－中)
;Var(9)	：チェーン判定(屈－大)
;Var(10)	：チェーン判定(ジャンプ－小)
;Var(11)	：チェーン判定(ジャンプ－中)
;Var(12)	：チェーン判定(ジャンプ－大)
;Var(13)	：チェーン判定(ジャンプ－↓大)
;Var(14)	：二段ジャンプ用(回数制限)
;Var(15)-(20)	：空中ダッシュ用
;Var(21)	：ハイジャンプ用
;Var(22)	：速さ(ダッシュジャンプ)
;Var(23)	：必殺技汎用(シールド/赤手・檻髪/赤手・焔華/空中投げ)
;Var(24)	；壁激突の音用フラグ
;Var(25)	：ジャンプキャンセル
;Var(26)	；バウンドコンボ用フラグ
;Var(27)	：受身用
;Var(28)	：バウンドコンボカウント
;Var(29)	：ヒットエフェクト、赤手・焔華(炎の座標)被ってた
;Var(30)	：赤手・焔華(炎の座標)
;Var(31)	：空中ダッシュ用
;Var(32)	：アークドライブ連打用(ヒットカウント増加用フラグ)
;Var(33)	：受身用
;Var(34)	：ガードキャンセルシールドバンカーキャンセル用

;Var(40)	；HEAT状態
;Var(41)-(50)	；EXエフェクト時間
;Var(51)	；HEAT残り時間

;FVar(0)	：ヒットカウント
;FVar(1)	：シールド速さ(X軸)
;FVar(2)	：シールド速さ(Y軸)


;FVar(20)	：重力

;--------------------
;ヘルパー用
;Var(0)	：炎ヒットカウント
;Var(29)-(30)	；赤手・焔華（炎の座標)

;FVar(0)	：カットイン画像サイズ
;FVar(1)	：星の座標(X軸)
;FVar(2)	：星の座標(Y軸)
;-----------------------------------------

[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 50
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 40
FloatPersistIndex = 20

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 16     ;Player width (back, ground)
ground.front = 14    ;Player width (front, ground)
air.back = 18        ;Player width (back, air)
air.front = 17       ;Player width (front, air)
height = 60          ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = -5, -90   ;Approximate position of head
mid.pos = -5, -60    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 1.7      ;Walk forward
walk.back = -1.1     ;Walk backward
run.fwd  = 5.9, 0    ;Run forward (x, y)
run.back = -5,-4.2 ;Hop backward (x, y)
jump.neu = 0,-9.5    ;Neutral jumping velocity (x, y)
jump.back = -1.5    ;Jump back Speed (x, y)
jump.fwd = 2.2       ;Jump forward Speed (x, y)
runjump.back = -1.2, -8.4 ;Running jump speeds (opt)
runjump.fwd = 2,-8.4      ;.
airjump.neu = 0,-8.6      ;.
airjump.back = -1.5      ;Air jump speeds (opt)
airjump.fwd = 2.2        ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .44         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching


