guard.sparkno = S3150
sparkxy = -20, -75
hitsound = S15, 0
guardsound = S15, 20
ground.type = High
ground.slidetime = 7
ground.hittime = 10     ;五分
ground.velocity = -3.6
guard.slidetime = 7
guard.ctrltime = 10     ;五分
air.velocity = -1.5, -4.7
airguard.velocity = -4, -.5
ground.cornerpush.veloff = -5
air.cornerpush.veloff = -6.5
yaccel = .4
getpower = ifelse(Var(40) = 0, 30, 0), ifelse(Var(40) = 0, 24, 0)
air.fall = ifelse(P2MoveType != A, 0, 1)
fall.recover = ifelse(P2MoveType != A, 1, 0)

