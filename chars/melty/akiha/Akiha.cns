type = PlaySnd
trigger1 = AnimElem = 2
value = 10, 0

[State 200, 1]
type = HitDef
triggerall = Var(28) < 3
trigger1 = AnimElem = 4
attr = S, NA
damage = 20, 0
animtype = Light
guardflag = M
hitflag = MAF
priority = 3, Hit
pausetime = 6, ifelse(P2MoveType != A, 6, 9)
