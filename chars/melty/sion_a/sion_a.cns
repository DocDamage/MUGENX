;==============================================================================
;　HEAT状態
;==============================================================================
[State -2, DisplayToClipBord]
Type = DisplayToClipBoard
Trigger1 = 1
Text = "20=%d,24=%d"
Params = var(20),var(24)
IgnoreHitPause = 1

[State -2, AfterImage]
Type = AfterImage
Trigger1 = Power != 3000
Trigger1 = Var(32) = 0
trans = add
TimeGap = 1
FrameGap = 3
time = 99999
PalBright = 0,0,0
PalContrast = 70,70,70
PalAdd = 0,0,160
PalMul = 1,1,1

[State -2, VarSet]
Type = VarAdd;Set
Trigger1 = Var(33) = 0
Trigger1 = Power >= 3000
V = 33
Value = 1			;HEAT状態フラグ

[State -2, VarSet]
Type = VarSet
Trigger1 = var(32) = 0;Power <= 2999
V = 33
Value = 0			;通常状態フラグ

[State -2, VarSet]
Type = VarSet
Trigger1 = Var(32) = 0
Trigger1 = Power >= 3000
V = 32
Value = 500			;HEAT制限時間設定
Peresistent = 0

[State -2, VarSet]
Type = VarAdd
Trigger1 = Var(32) >= 1
V = 32
Value = -1                      ;HEAT制限時間減少

[State -2, VarSet]
Type = VarSet
Trigger1 = power = 0;Var(33) = 0
V = 32
Value = 0			;通常状態で32 を0 に
Peresistent = 0

[State -2, VarSet]
Type = PowerAdd
Trigger1 = Var(32) >= 1
Value = -6			;ゲージ減少

[State -2, VarSet]
Type = VarSet
Trigger1 = Var(33) = 1
Trigger1 = Var(32) = 1
V = 32
Value = 0			;HEAT制限時間終了

[State -2, PowerSet]
Type = PowerSet
Trigger1 = Var(36) = 0
Trigger1 = Var(33) = 1
Trigger1 = power = 0
Value = 2000			;HEAT後ゲージ２００％

[State -2, PowerSet]
Type = PowerSet
trigger1 = var(33) >= 1
Trigger1 = ((stateno = 2500) || (stateno = 2100) || (stateno = 2200)) 
trigger1 = var(36) = 0
Value = 1000			;Arc Drive使用後ゲージ１００％

[State -2, VarSet]
Type = VarSet
trigger1 = var(33) = 0
Trigger1 = ((power <= 999) && (power >= 900))
V = 36
Value = 0			;偽HEAT状態フラグ

[State -2, LifeAdd]
Type = LifeAdd
Trigger1 = Var(33) = 1
Trigger1 = GameTime % 5 = 0
Value = 1

;==============================================================================
;　BLOOD HEAT
;==============================================================================
[State -2, VarAdd]
Type = VarAdd
Trigger1 = Var(33) = -1
Trigger1 = Var(32) >= 1
V = 32
Value = -1      		;BLOOD HEAT制限時間減少

[State -2, VarSet]
Type = PowerAdd
Trigger1 = Var(33) = -1
Value = -6			;ゲージ減少

[State -2, VarSet]
Type = VarSet
Trigger1 = Var(33) = -1
Trigger1 = Var(32) = 1
V = 32
Value = 0			;BLOOD HEAT制限時間終了

[State -2, LifeAdd]
Type = LifeAdd
Trigger1 = Var(33) = -1
Trigger1 = GameTime % 2 = 0
Value = 2

;==============================================================================
;　ジャンプキャンセル
;==============================================================================
[State -2, CS]
Type = ChangeState
TriggerAll = Command = "holdup"
triggerall = MoveContact
Trigger1 = StateNo = 200
Trigger2 = StateNo = 210
Trigger3 = StateNo = 215
Trigger4 = StateNo = 220
Trigger5 = StateNo = 410
Trigger6 = StateNo = 400
Trigger7 = StateNo = 420
Trigger8 = StateNo = 415
Value = 40
Ctrl = 1

;==============================================================================
;　コンボ修正用変数管理（怪しい出来）
;==============================================================================
[State -1, AttackMulSet]
Type = AttackMulSet
Trigger1 = 1
Value = 1 * fvar(21) * fvar(22) - fvar(23)
IgnoreHitPause = 1

[State -1, VarSet1]
Type = VarSet
Trigger1 = P2MoveType != H
FV = 22
value = 1

[State -1, VarSet1]
Type = VarSet
Trigger1 = ((roundstate = 2) && (P2StateType = S))
FV = 21
value = 1

[State -1, VarSet1]
Type = VarSet
Trigger1 = ((roundstate = 2) && (P2StateType = A))
FV = 21
value = 0.88

[State -1, VarSet1]
Type = VarSet
Trigger1 = ((roundstate = 2) && (P2StateType = A))
FV = 21
value = 1.08

[State -1, VarSet2]
Type = VarSet
Triggerall = fvar(22) > 0.75
Triggerall = ((PrevStateNo != 421) && (PrevStateNo != 620))
Trigger1 = ((StateNo = 200) && (MoveContact))
Trigger2 = ((StateNo = 400) && (MoveContact))
Trigger3 = ((StateNo = 600) && (MoveContact))
Trigger4 = ((StateNo = 605) && (MoveContact))
FV = 22
value = 0.75 

[State -1, VarSet3]
Type = VarSet
Trigger1 = ((StateNo = 421) && (MoveContact))
Trigger2 = ((StateNo = 620) && (MoveContact))
FV = 22
value = 0.5

[State -1, VarSet4]
Type = VarSet
Triggerall = fvar(22) > 0.68
Trigger1 = ((StateNo = 415) && (MoveContact))
Trigger2 = ((StateNo = 225) && (MoveContact))
FV = 22
value = 0.68

[State -1, VarSet7]
Type = VarSet
Trigger1 = var(25) > 0
trigger1 = fvar(23) < 0.7
FV = 23
value = 0.0255*var(25)

[State -1, VarSet8]
Type = VarSet
Trigger1 = ((roundstate = 2) && (P2MoveType != H))
V = 25
value = 0

