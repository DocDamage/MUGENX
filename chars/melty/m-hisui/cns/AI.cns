;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------
[Statedef -3]

;---------------------------------------------------------------------------
;AI Level(from 1 to 5)
[State -3]
type = VarSet
trigger1 = var(59) >= 1
ignorehitpause = 1
v = 55
value = 3;Default = 3

[State -3, AIswitch]
type = VarSet
triggerall = var(59)     = 0
triggerall = roundstate != 3
trigger1   = command     = "AI_1"
trigger2   = command     = "AI_2"
