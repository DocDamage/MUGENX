[State -3];強制解放
type = ChangeState
value = 700
triggerall = alive
triggerall = var(55)      >= 4
triggerall = var(58)       = [0,99]
triggerall = var(59)      >= 2
triggerall = statetype    != A
triggerall = p2movetype    = A
triggerall = p2bodydist x  = [-10,10]
triggerall = p2bodydist y  = [-30,0]
trigger1   = var(10)       = 0 && fvar(20) >= 200
trigger1   = fvar(22)-life > 100 || (100*life/const(data.life)) <= 50
trigger1   = ctrl
trigger2   = var(10)       = 0 && fvar(20) >= 200
trigger2   = var(24)/100  >= 5
trigger2   = fvar(22)-life > 100 || (100*life/const(data.life)) <= 50
trigger2   = stateno       = [900,910]
trigger3   = var(10)       = 1 && fvar(20) >= 200 || var(10) = 4
trigger3   = fvar(22)-life > 150 || (100*life/const(data.life)) <= 25
trigger3   = ctrl
trigger4   = var(10)       = 1 && fvar(20) >= 200 || var(10) = 4
trigger4   = var(24)/100  >= 5
trigger4   = fvar(22)-life > 150 || (100*life/const(data.life)) <= 25
trigger4   = stateno       = [900,910]

