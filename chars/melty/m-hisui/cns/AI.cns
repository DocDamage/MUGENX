[State -3]
type = VarSet
triggerall = var(59)    >= 1
trigger1   = roundstate  = 4
trigger2   = p2life     <= 0
trigger3   = wintime     = 1
trigger4   = losetime    = 1
ignorehitpause = 1
v = 59
value = -1

[State -3]
type = VarSet
trigger1 = var(59)    = -1
trigger1 = roundstate = 2
ignorehitpause = 1
v = 59
value = 1

[State -3]
type = VarSet
triggerall = var(59)  = 1
trigger1   = var(55)  = 4
trigger1   = (100*life/const(data.life)) <= 25
trigger2   = var(55)  = 5
trigger2   = (100*life/const(data.life)) <= 50
ignorehitpause = 1
v = 59
value = 2

[State -3]
type = VarSet
trigger1 = var(55) = 5
trigger1 = var(59) = 2
trigger1 = (100*life/const(data.life)) <= 25
ignorehitpause = 1
v = 59
value = 3

;---------------------------------------------------------------------------
[State -3]
type = VarSet
triggerall = var(59)     >= 1
trigger1   = stateno      = 420
trigger1   = p2statetype  = L
trigger2   = stateno      = 620
trigger2   = p2movetype  != H
ignorehitpause = 1
v = 12
value = 18

[State -3]
type = VarSet
trigger1 = var(55)      >= 4
trigger1 = var(59)      >= 2
trigger1 = p2bodydist x  < 60
ignorehitpause = 1
v = 21
value = 8

;---------------------------------------------------------------------------
;反撃系
;---------------------------------------------------------------------------
[State -3];L・S・O (超人姉妹同盟)
type = ChangeState
value = 3000
triggerall = alive
triggerall = fvar(20)     <= ifelse(var(10) = 4, 300, 200)
triggerall = var(10)       > 0 && var(10) != 3
triggerall = var(55)      >= 4
triggerall = var(58)       = [0,24]
triggerall = var(59)      >= 2
triggerall = statetype    != A
triggerall = p2movetype    = A
triggerall = numhelper(3020) = 0
trigger1   = ctrl
trigger1   = stateno       = 5120
trigger2   = var(24)/100  >= 1

[State -3];幻視力ミサイル・ナイトメア
type = ChangeState
value = 1300
triggerall = alive
triggerall = fvar(20)     <= 300
triggerall = var(10)       > 0
triggerall = var(55)      >= 3
triggerall = var(58)       = [0,49]
triggerall = var(59)      >= 1
triggerall = statetype    != A
triggerall = p2movetype    = A
triggerall = p2bodydist x  = [-10,40]
triggerall = p2bodydist y  = [-60,0]
trigger1   = ctrl
trigger1   = random        < 300+100*var(55)
trigger2   = var(24)/100  >= 1

[State -3];幻視力ミサイル・ナイトメア
