[Data]
life              = 1000        ;ライフ初期値
power             = 3000        ;パワーゲージ初期値
attack            = 100         ;基本攻撃力
defence           = 100         ;基本防御力
fall.defence_up   = 50          ;コンボ中の防御力補正
liedown.time      = 33          ;倒れてから起上がるまでのフレーム数
airjuggle         = 16          ;空中コンボ制限
sparkno           = 2           ;基本ヒットスパークナンバー
guard.sparkno     = 40          ;基本ガードスパークナンバー
KO.echo           = 0           ;KOした時のエコー
volume            = 128         ;音の大きさ
IntPersistIndex   = 10          ;次ラウンドに持ち越すvarの開始No.
FloatPersistIndex = 40          ;次ラウンドに持ち越すfvarの開始No.

[Size]
xscale            = 1           ;水平方向の縮尺
yscale            = 1           ;垂直方向の縮尺
ground.back       = 11          ;キャラの幅(後方,地上)
ground.front      = 13          ;キャラの幅(前方,地上)
air.back          = 11          ;キャラの幅(後方,空中)
air.front         = 13          ;キャラの幅(前方,空中)
z.width           = 3           ;キャラの押し出す幅
height            = 60          ;キャラの高さ
attack.width      = 4,4         ;攻撃をした時キャラの押し出す幅 (後方, 前方)
attack.dist       = 100         ;攻撃をした時相手がガード体制に入る最低距離
proj.attack.dist  = 90          ;攻撃をした時相手がガード体制に入る最低距離 (飛び道具)
proj.doscale      = 0           ;上で設定した縮尺を飛び道具にも適用するか (1でON)
head.pos          = -5,-90      ;頭の座標(x,y)
mid.pos           = -5,-60      ;腰の座標(x,y)
shadowoffset      = 0           ;影の位置

[Velocity]
walk.fwd          =  2.00       ;前進の速度
walk.back         = -2.00       ;後退の速度
run.fwd           =  2.00, 0    ;前ダッシュの速度（ホップする時はyを-にする）
run.back          = -1.50,-2.0  ;後ダッシュの速度（ホップする時はyを-にする）
jump.neu          =     0,-9.0  ;垂直ジャンプの速度
jump.back         = -1.50       ;後ジャンプの速度
jump.fwd          =  2.65       ;前ジャンプの速度
runjump.back      = -2.55,-9.5  ;後ダッシュしながらのジャンプ速度(オプション)
runjump.fwd       =  4.65,-9.5  ;前ダッシュしながらのジャンプ速度(オプション)
airjump.neu       =     0,-8.0  ;２段ジャンプ以降の垂直ジャンプの速度(オプション)
airjump.back      = -2.55       ;２段ジャンプ以降の後ジャンプの速度(オプション)
airjump.fwd       =  2.55       ;２段ジャンプ以降の前ジャンプの速度

[Movement]
airjump.num       = 0           ;空中でジャンプする回数
airjump.height    = 20          ;空中でジャンプする最低限の高さ
yaccel            = 0.42        ;重力
stand.friction    = 0.85        ;立ち状態の摩擦係数
crouch.friction   = 0.82        ;屈み状態の摩擦係数

;---------------------------------------------------------------------------
; ステートの解説
; [Statedef Stateno]
; type     = ?  S/C/A/L/U    ;S:立ち C:屈み A:空中 L:ダウン U:前に依存
; movetype = ?  I/A/H/U      ;I:通常状態 A:攻撃状態 H:やられ状態 U:前に依存
; physics  = ?  S/C/A/N/U    ;S:立ち C:屈み A:空中 N:無し U:前に依存
; juggle   = (int)           ;その攻撃に使うジャグル数
; poweradd = (int)           ;ゲージの増減
; velset   = (x,y)           ;X方向の速度, Y方向の速度
; ctrl     = (0 to 1)        ;コントロール (1で可)
; anim     = (int)           ;指定したアニメを表示
; facep2   = (0 to 1)        ;1でステートに入った途端に相手側に振り向く
; sprpriority = (int) 　　   ;表示の優先度 (デフォルト2)
; hitdefpersist = (0 to 1)   ;1でhitdefを引き継ぐ
; movehitpersist = (0 to 1)  ;1でmovehitを引き継ぐ
; hitcountpersist = (0 to 1) ;1でhitcountを引き継ぐ

;---------------------------------------------------------------------------
; タイムオーバーで負けた時
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 0]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; 勝利動作
[Statedef 180]
type = S

[State 180, 0]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 180, 3]
type = ChangeState
triggerall = time    = 1
trigger1   = var(43) = 1 ;志貴
trigger2   = var(43) = 3 ;琥珀
trigger3   = var(43) = 4 ;翡翠
value = 181

[State 180, 3]
type = ChangeState
triggerall = time    = 1
trigger1   = var(43) = 0
trigger2   = var(43) = 2 ;秋葉
value = 182

;---------------------------------------------------------------------------
; 勝利動作 1
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 182, 0] 
type = AssertSpecial
trigger1 = var(43)  = 1
trigger1 = time    <= 680
trigger2 = var(43)  = 3
trigger2 = time    <= 410
trigger3 = var(43)  = 4
trigger3 = time    <= 770
flag = RoundNotOver

[State 181, 1]
type = PlaySnd
trigger1 = var(43)  = 1 ;志貴
trigger1 = animelem = 1
value = 410,4

[State 181, 1]
type = PlaySnd
trigger1 = var(43)  = 3 ;琥珀
trigger1 = animelem = 1
value = 410,6

[State 181, 1]
type = PlaySnd
trigger1 = var(43)  = 4 ;翡翠
trigger1 = animelem = 1
value = 410,5

;---------------------------------------------------------------------------
; 勝利動作 2
[Statedef 182]
type = S
ctrl = 0
anim = 180
velset = 0,0

[State -2, 0]
type = VarRandom
trigger1 = animelem = 1
persistent = 0
ignorehitpause = 1
v = 57
range = 0,9

[State 182, 0] 
type = AssertSpecial
trigger1 = var(57) = [0,1]
trigger1 = time   <= 490
trigger2 = var(57) = [2,9]
trigger2 = time   <= 100
flag = RoundNotOver

[State 182, 1]
type = PlaySnd
trigger1 = var(43)  = 0
trigger1 = animelem = 1
value = 410,ifelse(var(57) < 2, 0, 2)

;---------------------------------------------------------------------------
; 登場 (分岐)
[Statedef 190]
type = S

[State 190, 0]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 191, 1] 
type = PowerSet
trigger1 = time = 0
value = ceil(const(data.power)/3)

[State 190, 3]
type = ChangeState
trigger1 = time    = 1
trigger1 = var(43) = 1 ;志貴
value = 191

[State 190, 3]
type = ChangeState
trigger1 = time    = 1
trigger1 = var(43) = 2 ;秋葉
value = 193

[State 190, 3]
type = ChangeState
trigger1 = time    = 1
trigger1 = var(43) = 4 ;翡翠
value = 194

[State 190, 3]
type = ChangeState
triggerall = time    = 1
trigger1   = var(43) = 0
trigger2   = var(43) = 3 ;琥珀
value = 192

