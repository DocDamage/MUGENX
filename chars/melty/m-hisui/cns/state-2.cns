triggerall = alive
triggerall = time    = 1
triggerall = var(22) = 0
triggerall = random  = [0,99]
trigger1   = stateno = 150
trigger2   = stateno = 152
trigger3   = stateno = 154
persistent = 0
ignorehitpause = 1
value = 300,8

