[State -2, Display1]
type = DisplayToClipboard
trigger1 = 1
text =  "ATK:%f, DEF:%f, VITAL:%f, FAINT:%f, var(59):%d \n"
params = fvar(0), fvar(11), fvar(22), fvar(23), var(59)

[State -2, Display2]
type = AppendToClipboard
trigger1 = 1
text =  "P2dist X:%f, P2dist Y:%f, Vel X:%f, Vel Y:%f \n"
params = p2bodydist x, p2bodydist y, vel x, vel y

