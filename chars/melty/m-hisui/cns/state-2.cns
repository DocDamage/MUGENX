[State -2, 1]
type = LifeAdd
trigger1 = movetype = H
trigger1 = fvar(11) > 1.00
trigger1 = var(14)  = 0
trigger1 = life     < var(13)
value = ceil((var(13)-(life))*(1.00-fvar(11))/(fvar(11)))

