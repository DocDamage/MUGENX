;---------------------------------------------------------------------------
[State -2, Attack]
type = VarSet
trigger1 = 1
ignorehitpause = 1
fv = 0
value = 1.00*fvar(1)*fvar(4)*fvar(5)*(1.00-(0.08*fvar(8)))*fvar(9)*fvar(10)*(1+fvar(15))*fvar(16)

[State -2, Attack]
type = VarSet
trigger1 = roundstate = 0
ignorehitpause = 1
fv = 10
value = 1.00

[State -2, Attack]
type = VarSet
trigger1 = fvar(2) >= 0.45
ignorehitpause = 1
fv = 10
value = ifelse(fvar(2) < fvar(3), fvar(2), fvar(3))*fvar(6)*fvar(7)

[State -2, Attack]
type = VarSet
trigger1 = fvar(2) != 1.00
trigger1 = fvar(2) >= 0.45
trigger1 = fvar(3) != 1.00
trigger1 = fvar(10) = [0.01,0.45]
ignorehitpause = 1
fv = 10
value = 0.45

[State -2, Attack]
type = VarSet
trigger1 = fvar(2) < 0.45
ignorehitpause = 1
fv = 10
value = fvar(2)

;---------------------------------------------------------------------------
[State -2, Defence]
type = VarSet
trigger1 = roundstate = 2
trigger1 = life       > 0
trigger1 = alive
ignorehitpause = 1
fv = 11
value = 1.00*fvar(12)*fvar(13)/((1+fvar(15))*fvar(16))

[State -2, Defence]
type = VarSet
triggerall = fvar(11)   != 1.00
trigger1   = roundstate != 2
trigger2   = life       <= 0
trigger3   = !alive
ignorehitpause = 1
fv = 11
value = 1.00

[State -2, Defence]
type = DefenceMulSet
trigger1 = 1
ignorehitpause = 1
value = fvar(11)

;---------------------------------------------------------------------------
[State -2, 1]
type = LifeAdd
trigger1 = movetype  = H
trigger1 = fvar(11) <= 1.00
trigger1 = var(14)   = 0
trigger1 = life      < var(13)
