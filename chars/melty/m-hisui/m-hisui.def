;-----基本情報------------------------------------------------------

[Info]
Name         = "Mech-HISUI"        ;キャラの名前
DisplayName  = "Mech-HISUI"        ;ゲーム中表示される名前
VersionDate  = 01,22,2006          ;このキャラの最終更新日
MugenVersion = 06,14,2003          ;このキャラを使用出来るM.U.G.E.Nのバージョン
Author       = "kuro"              ;このキャラの作成者の名前
Pal.Defaults = 2,3,4,5             ;CPUで出てくるキャラカラー

;-----必要なファイルの設定------------------------------------------

[Files]
cmd      = etc/m-hisui.cmd         ;入力コマンド定義ファイルの登録
cns      = cns/m-hisui.cns         ;基本ステータス情報を含むファイルの登録
st       = cns/m-hisui.cns         ;動作プログラムファイルの登録
st0      = cns/m-hi_normal.cns     ;通常攻撃系
st1      = cns/m-hi_special.cns    ;必殺技系
st2      = cns/m-hi_overdrive.cns  ;超必殺技系
st3      = cns/m-hi_tech.cns       ;特殊系
st4      = cns/m-hi_helper.cns     ;Helperステート
st5      = cns/state-2.cns         ;-2ステート
st6      = cns/AI.cns              ;AI用ステート
stcommon = cns/m-hi_common.cns     ;コモン動作プログラムファイルの登録
sprite   = etc/m-hisui.sff         ;複数のPCX画像を１パック化したスプライトファイルの登録
anim     = etc/m-hisui.air         ;アニメーションファイルの登録
sound    = etc/m-hisui.snd         ;複数のWAV音声を１パック化したサウンドファイルの登録

;---カラーパレットファイルの設定（最大１２個まで可能）---

pal1  = act/m-hi01.act             ;Ａボタンで決定
pal2  = act/m-hi02.act             ;Ｂボタンで決定
pal3  = act/m-hi09.act             ;Ｃボタンで決定
pal4  = act/m-hi03.act             ;Ｘボタンで決定
pal5  = act/m-hi04.act             ;Ｙボタンで決定
pal6  = act/m-hi10.act             ;Ｚボタンで決定

;※ここから設定する下のカラーを選ぶ時は、キャラクターセレクト時に
;スタートボタン（Ｓボタン）を押しながら各攻撃ボタンで決定すれば使えます。

pal7  = act/m-hi05.act             ;Ｓ押しながらＡボタンで決定
pal8  = act/m-hi06.act             ;Ｓ押しながらＢボタンで決定
pal9  = act/m-hi11.act             ;Ｓ押しながらＣボタンで決定
pal10 = act/m-hi07.act             ;Ｓ押しながらＸボタンで決定
pal11 = act/m-hi08.act             ;Ｓ押しながらＹボタンで決定
pal12 = act/m-hi12.act             ;Ｓ押しながらＺボタンで決定

;-----ストーリーボード設定------------------------------------------
;別途作成したキャラ固有のオープニングとエンディングのファイルを
;入れる場合は、ここの項目で設定が出来ます。

[Arcade]
;Intro.Storyboard  = Option/intro.def
;Ending.Storyboard = Option/ending.def

