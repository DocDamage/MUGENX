;Var(10) = ジャンプキャンセル回数
;Var(11) = 2段ジャンプ回数
;Var(12) = リバーサルアタック
;Var(13) = HEAT&BLOODHEAT
;Var(14) = HEAT強制開放
;Var(15) = MAX表示
;Var(16) = 
