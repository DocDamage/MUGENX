triggerall = fvar(11) < 64 && root,time = [0,4]
trigger1 = root,stateno = 42 || root,stateno = 100 || root,stateno = 102 || root,prevstateno = 951
trigger2 = root,stateno = 900 || root,stateno = 910 || root,stateno = 920
trigger3 =(root,prevstateno = [200,590])&& root,stateno = 105
fvar(11) = 1.6
[State var]
type = varset
triggerall = fvar(11)>= 1
trigger1 = root,stateno = 42 || root,stateno = 100 || root,stateno = 102 || root,prevstateno = 951
trigger2 = root,stateno = 900 || root,stateno = 910 || root,stateno = 920
trigger3 =(root,prevstateno = [200,590])&& root,stateno = 105
trigger4 = root,movetype = H && root,stateno!= [120,155]
var(46) = 64

[State var]
type = varset
triggerall = fvar(11)>= 1
trigger1 = root,var(45) = 0
var(46) = 64

[State explod]
type = RemoveExplod
trigger1 = roundstate>= 3
ignorehitpause = 1

