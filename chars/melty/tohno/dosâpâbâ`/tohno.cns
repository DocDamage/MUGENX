;Var(0)モード
;Var(1)切換え
;Var(2)
;Var(3)ctrl
;Var(4)KOボイス
;Var(5)ランダムボイス
;Var(6)フェニッシュ判定
;Var(7)カラー調整用
;Var(8)ダッシュジャンプ判定
;Var(9-10)キャンセルジャンプ処理
;Var(11)空中ダッシュ処理
;Var(12)カットインフェード処理
;Var(13)カットイン拡大処理
;Var(14)パートナー死亡
;Var(15)魔眼のフェードその他汎用
;Var(16)声合わせ
;Var(17-25)メルブラコンボシステム処理
;var(26)避け
;Var(27)
;Var(28)バク転処理
;Var(29)
;Var(30)トレーニング処理
;Var(31)避け処理

;Var(32-3)月姫ヒロインズフェード処理(アルク+シオン+さっちん)＋志貴の勝利判定
;Var(34-5)月姫ヒロインズフェード処理(秋葉+琥珀+都古)+魔眼のフェード
;Var(36-7)月姫ヒロインズフェード処理(シエル+翡翠)+敵体力検出
;Var(38-9)月姫ヒロインズフェード処理(双子+レン+シエル+秋葉)
;Var(32-39)直死分身処理と併用&シールド残像
;Var(40)死の予感回数制限処理
;-------------------------------------持ち越すVar
;Var(41)モード持ち越し用(20原作通常モード:19原作finaltunedモード)
;Var(42)キャラ認識
;Var(43)キャラ認識
;Var(44)無空
;Var(45)マジックサーキット(0:none,1:強制開放,2:自動開放,3:BH)

;Var(47)開放判定
;Var(48)閃鎖溜め判定
;Var(50)反転フラグ
;Var(51)ナイフ位置
;Var(52)チームモード判定
;Var(53)地面を殺す終了判定
;Var(54)勝利
;Var(55)AI
;Var(56)AIランダム
;--------------------------------------
;fvar(2)

;fvar(10)マジックサーキットの値
[Data]

life = 1000		;Amount of life to start with
power = 3000
attack = 100		;100% attack power (more is stronger)
defence = 100		;100% defensive power (more is stronger)
fall.defence_up = 50	;Def goes up by 50% everytime player is hit on ground
liedown.time = 60	;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 23		;Can do 15 points of juggling
sparkno = 0		;Default spark number
guard.sparkno = S8030	;Default guard spark number
KO.echo = 0		;1 to enable echo on KO
Volume = 255		
IntPersistIndex = 41
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 13     ;Player width (back, ground)
ground.front = 12    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
height = 60          ;Height of player (for opponent to jump over)
attack.dist = 120    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = -5, -90   ;Approximate position of head
mid.pos = -5, -60    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 0.8      ;Walk forward
walk.back = -0.5     ;Walk backward
run.fwd  = 9.9, 0    ;Run forward (x, y)
run.back = -5.9,-2 ;Hop backward (x, y)
jump.neu = 0,-10.5    ;Neutral jumping velocity (x, y)
jump.back = -1.55    ;Jump back Speed (x, y)
jump.fwd = 2.5       ;Jump forward Speed (x, y)
runjump.back = 1.55,-10.5 ;Running jump speeds (opt)
runjump.fwd = 4.7,-9.9      ;.
airjump.neu = 0,-7.4      ;.
airjump.back = -1.55      ;Air jump speeds (opt)
airjump.fwd = 1.5         ;.

[Movement]
airjump.num = 1      ;Number of air jumps allowed (opt)
airjump.height = 25  ;Minimum distance from ground before you can air jump (opt)
yaccel = .54        ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 210, 1]
type = PlaySnd
trigger1 = time = 1
value = 170, 0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; DRAWGAME (Time over)
[Statedef 175]
type = S
ctrl = 0
velset = 0,0

[State 175, 1] ; If no anim, use go to lose state.
type = ChangeState
trigger1 = Time = 0
trigger1 = !SelfAnimExist(175)
value = 170

[State 210, 1]
type = PlaySnd
trigger1 = animelem = 3
value = 175, 0

[State 175, 2]
type = ChangeAnim
trigger1 = Time = 0
value = 175

[State 175, 3]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

