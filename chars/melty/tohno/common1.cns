trigger2 = var(55) = 1
trigger2 = var(56) >= 4
value = 5221

[State 5100, Change]
type = ChangeState
triggerall = Time >= 0
trigger1 = command = "UU"
value = 5220

[State 5100, Change]
type = ChangeState
triggerall = Time >= 0
trigger1 = command = "FF"
trigger2 = var(0) >= 1
trigger2 = var(55) = 1
trigger2 = var(56) <= 1
value = 5222

[State 5100, 1]
type = VelSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) = 0
trigger1 = vel x > 1
x = 1

[State 5100, EnvShake]
