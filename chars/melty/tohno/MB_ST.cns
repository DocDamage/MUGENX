; HIT_BOUNCE (hit ground)
[Statedef 5100]
type = L
movetype= H
physics = N

[State 5100, Change]
type = ChangeState
triggerall = Time >= 1
trigger1 = command = "BB"
value = 5221

[State 5100, Change]
type = ChangeState
triggerall = Time >= 1
trigger1 = command = "UU"
value = 5220

[State 5100, Change]
type = ChangeState
triggerall = Time >= 1
trigger1 = command = "FF"
value = 5222

[State 5100, 1]
type = VelSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) = 0
trigger1 = vel x > 1
x = 1

[State 5100, EnvShake]
type = FallEnvShake
trigger1 = Time = 0

[State 5100, Var] ;Save fall velocity
type = VarSet
trigger1 = Time = 0
sysvar(1) = floor(vel y)

[State 5100, 2] ;Hit ground anim (normal)
type = ChangeAnim
triggerall = time = 0
trigger1 = (anim != [5051+var(0)*10000,5059+var(0)*10000]) && (anim != [5061+var(0)*10000,5069+var(0)*10000])
trigger2 = !SelfAnimExist(5100 + (anim % 10))
value = 5100+var(0)*10000

[State 5100, 3] ;Hit ground anim (for hit up)
type = ChangeAnim
trigger1 = time = 0
trigger1 = (anim = [5051+var(0)*10000,5059+var(0)*10000]) || (anim = [5061+var(0)*10000,5069+var(0)*10000])
trigger1 = SelfAnimExist(5100 + (anim % 10))
value = 5100+var(0)*10000 + (anim % 10)

[State 5100, 4]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5100, 5]
type = VelSet
trigger1 = Time = 0
y = 0

[State 5100, 6] ;Reduce speed
type = VelMul
trigger1 = Time = 0
x = 0.75

[State 5100, 7]
type = ChangeState
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) = 0
value = 5110 ;HIT_LIEDOWN

[State 5100, 8]
type = GameMakeAnim
trigger1 = Time = 1
value = 60 + (sysvar(1) > 5) + (sysvar(1) > 14)
pos = 0, 0
under = sysvar(1) <= 14

[State 5100, 9]
type = HitFallDamage
trigger1 = Time = 3

[State 5100, 10]
type = PlaySnd
trigger1 = Time = 1
value = S2,1

[State 5100, 11]
type = PosFreeze
trigger1 = 1

[State 5100, 12]
type = ChangeState
trigger1 = AnimTime = 0
value = 5101

[State 5100, 13]
type = ForceFeedback
trigger1 = Time = 0
waveform = sinesquare
ampl = 128,-3,-.2,.005
time = 20

