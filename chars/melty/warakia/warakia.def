; Player information
[Info]
name = "warakia"        ;Name of character
displayname = "warakia" ;Name of character to display
versiondate = 04,14,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "MEKA"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd	= warakia.cmd   ;Command set
cns     = CNS/warakia.cns   ;Constants
st      = CNS/warakia_normal.cns
st0	= CNS/warakia_special.cns
st1	= CNS/warakia_hyper.cns   ;States
st2	= CNS/-2.cns   ;States
st3	= CNS/etc.cns
stcommon = CNS/common1.cns ;Common states
sprite  = warakia.sff   ;Sprite
anim    = warakia.air   ;Animation
sound   = warakia.snd   ;Sound
pal1    = ACT/WARAKIA.act  ;Palettes
pal2    = ACT/WARAKIA2.act  ;Palettes
pal3    = ACT/WARAKIA3.act  ;Palettes
pal4    = ACT/WARAKIA4.act  ;Palettes
pal5    = ACT/WARAKIA5.act  ;Palettes
pal6    = ACT/WARAKIA6.act  ;Palettes

; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def