;---------------------------------------------------------------------------
; 時間切れにて負け ※lifeがまだ残っている（state170)
;
; このstateはmugen内部より強制的に飛ばされるstateで
; 必ず設定しなくてはならない
; もし負けを数種類設定したい場合は他のstateに飛ばしたり
; 条件を変えたりして処理しましょう
; ※このstateはcommon1.cnsを上書きしています
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1];一応無敵にしておく
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; 勝利（state180）
;
; このstateはmugen内部より強制的に飛ばされるstateで
; 必ず設定しなくてはならない
; もし勝利ポーズを何種類も設定したい場合は他のstateに飛ばしたり
; 条件を変えたりして処理しましょう
; ※このstateはcommon1.cnsを上書きしています
[Statedef 180]
type = S

[State 180, 0] 
type = VarRandom
trigger1 = Time = 0
v = 1
range = 0,1

[State 180, 1]
type = ChangeState
trigger1 = Var(1) = 0
trigger1 = Time = 0
value = 181

[State 180, 1]
