; Arcueid Brunestud - cns file No.1
;===========================================================================
;---------------------------------------------------------------------------
; キャラクター基準値の設定
[Data]
life              = 1001
attack            = 100
defence           = 100
power             = 3001
fall.defence_up   = 100
liedown.time      = 60
airjuggle         = 15
sparkno           = 2
guard.sparkno     = 40
KO.echo           = 0
volume            = 255
IntPersistIndex   = 1
FloatPersistIndex = 99

;---------------------------------------------------------------------------
; サイズ指定
[Size]
xscale           = 1
yscale           = 1
ground.back      = 13
ground.front     = 19
air.back         = 17
air.front        = 14
z.width          = 3
height           = 60
attack.width     = 4,4
attack.dist      = 100
proj.attack.dist = 90
proj.doscale     = 0
head.pos         = -5,-90
mid.pos          = -5,-60
shadowoffset     = 0

;---------------------------------------------------------------------------
; 移動速度の設定
[Velocity]
walk.fwd     = 2.0
walk.back    = -1.5
run.fwd      = 12,0
run.back     = -10,0
jump.neu     = 0,-8.5
jump.back    = -1.7
jump.fwd     = 2.1
runjump.back = -3,-9.5
runjump.fwd  = 4,-9.5

;airjump.neu = 0,-8.1
;airjump.back = -2.55,-8.1
;airjump.fwd = 2.5,-8.1

;---------------------------------------------------------------------------
; 動作の設定
[Movement]
airjump.num     = 1
airjump.height  = 20
yaccel          = .36
stand.friction  = .85
crouch.friction = .82

;===========================================================================
; 基本動作
;===========================================================================
;---------------------------------------------------------------------------
; 前ダッシュ
[Statedef 100]
type    = S
physics = N
anim    = 100
velset  = 0,0
ctrl    = 1

;******************************
[State 100, Pos]
type = PosSet
trigger1 = Time >= 0
y = 0

[State 100, Speed]
type = Velset
trigger1 = Time >= 8
x = 8
y = 0

[State 100, Dust]
type = MakeDust
trigger1 = Time = 1
pos = 0,0
spacing = 1

;******************************
[State 100, No Walk & No Turn]
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2= NoAutoTurn
ignorehitpause = 1

[State 100, Arcueid Voice]
type = PlaySnd
triggerall = var(3) = [1,40]
trigger1 = AnimElemTime(3) = 0
value = s4,4

[State 100, SE]
type = PlaySnd
trigger1 = AnimElemTime(3) = 1
value = s1,7

[State 100, SE]
type = PlaySnd
trigger1 = AnimElemTime(9) = 0
trigger2 = AnimElemTime(15) = 0
value = s1,9

;******************************
[State 100, DashStop]
type = ChangeState
triggerall = ((var(6) = 0) && (command = "holdfwd"))
;<--------------->triggerall = command = "holdfwd"
trigger1 = ((Time >= 8) && (P2BodyDist X <= 0))
value = 105

[State 100, DashStop]
type = ChangeState
triggerall = time > 10
trigger1 = command != "holdfwd"
value = 101
ctrl = 1

;--------------------------------------
; ダッシュ終了
