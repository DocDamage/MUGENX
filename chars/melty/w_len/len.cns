trigger1 = 1
trigger1 = var(5) = 0
v = 2
range = 0,5

[State -2]
type = VarRandom
trigger1 = 1
trigger1 = var(5) = 0
v = 22
range = 0,3

;---------------------------------------------------------------------
; 変数直し
[State -2]
type = varset
trigger1 = Anim = 0 || Anim = 5
trigger2 = var(4) <= 0
trigger3 = Stateno != 0
var(5) = 0

[State -2]
type = varset
trigger1 = pos Y = 0
var(8) = 0

; 変数減少
[State -2]
type = varadd
trigger1 = var(5) >= 1
trigger1 = Time >= 1
var(4) = -1
[State -2]
type = varset
trigger1 = var(4) <= 0
var(4) = 0

