triggerall = 1
trigger1 = var(5) >= 1
trigger2 = Anim = 5
var(1) = 0

[State -2]
type = VarSet
trigger1 = palno = [1,6]
var(30) = 1

[State -2]
type = VarRandom
trigger1 = 1
trigger1 = var(5) = 0
v = 1
range = 0,500

[State -2]
