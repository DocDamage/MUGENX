; ヒート＆ブラッドヒート
[State -2]
type = Helper
triggerall = numhelper(2600) = 0 && roundstate >= 2 && movetype != H
trigger1 = (var(25) = [1,3])
name = "Heat"
stateno = 2600
ID = 2600
supermovetime = 99999
pausemovetime = 99999
size.xscale = 1.02
size.yscale = 1.02
ignorehitpause = 1

[State -2]
type = PowerSet
trigger1 = palno = 12
value = 3000
ignorehitpause = 1
[State -2]
type = varset
trigger1 = palno = 12
var(25) = 3

[State -2]
type = PowerAdd
trigger1 = var(25) = [1,3]
trigger1 = stateno != 900
value = -ifelse(var(25) = 3, 7, 4)
ignorehitpause = 1

[State -2]
type = varset
trigger1 = var(25) = 0 && power = const(data.power)
var(25) = 1
ignorehitpause = 1

[State -2]
type = varset
trigger1 = var(25) = 2
trigger1 = power <= 1
var(25) = 0
[State -2]
type = varset
trigger1 = (var(25) = [1,2]) && (var(25) != 2)
trigger1 = power <= 1
var(25) = 4
[State -2]
type = varset
trigger1 = var(25) = 3
trigger1 = power <= 1
var(25) = 5
[State -2]
type = PowerAdd
trigger1 = var(25) = 4
trigger1 = power < 2000
value = 200

[State -2]
type = PowerAdd
trigger1 = Time = 0
trigger1 = var(25) != [1,3]
trigger1 = moveguarded
value = 40

[State -2]
type = varset
triggerall = var(25) >= 4
trigger1 = Stateno < 3500 && power >= 2000
trigger2 = Stateno >= 3500 && power >= 1000
trigger3 = var(25) = 5
var(25) = 0

[State -2]
type = LifeAdd
trigger1 = gametime%2 && movetype!= H
trigger1 = (var(25) = [1,3])
trigger1 = stateno != 900
value = 0+ifelse((var(25) = [1,2]), 1, 2)
ignorehitpause = 1

