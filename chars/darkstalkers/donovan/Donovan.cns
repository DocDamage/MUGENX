ctrl = 0
velset = 0,0
anim = 175

[State 175, 3]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 175, 4]
type = AssertSpecial
trigger1 = Time <= 60
flag = RoundNotOver

