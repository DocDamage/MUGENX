;Used Var
;var(1)  = Sword Released
;var(2)  = Sword Recall
;var(3)  = D.F. Sword Released
;var(4)  = Call Lightning
;var(5)  = Change Immortal (time)
;var(6)  = Change Immortal (animation)
;var(7)  = Facing
;var(8)  = Winning Pose
;var(9)  = A.I.
;var(10) = ES ON/OFF
;var(11) = ES Timer
;var(12) = DARK FORCE ON/OFF
;var(13) = DARK FORCE BG color
;var(14) = DARK FORCE Timer
;var(20) = Finish
;var(21) = First Attack
;var(22) = Randomizer
;var(30) = Combo start
;var(31) = Hit Count
;var(32) = Total hits
;var(33) = helper hits
;-------------------------------------------------------------------

; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4]
type = PosSet
trigger1 = Time = 0
y = 0

[State 0, 5]
type = Helper
triggerall = name = "Donovan"
triggerall = !NumHelper(7000)
trigger1 = Time = 0
name = "sword"
ID = 7000
pos = 0,0
postype = p1
facing = ifelse(facing=1,1,-1)
stateno = 7000

; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
ctrl = 0
sprpriority = 1

[State 100, 1]
type = PosSet
trigger1 = Time = 0
y = 0

[State 100, 2]
type = VelSet
trigger1 = time < 20
x = const(velocity.run.fwd.x)
y = const(velocity.run.fwd.y)

[State 100, 3]
type = VelSet
triggerall = anim = 100
trigger1 = AnimTime = 0
x = 0

[State 100, 4] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 5] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 6]
type = Explod
trigger1 = Time = 0
anim = 6100
pos = 0,0
postype = p1
sprpriority = 3
bindtime = -1
removeongethit = 1

[State 100, 7]
type = Explod
trigger1 = Time = 0
anim = 6101
pos = -20,-80
postype = p1
sprpriority = -1
bindtime = -1
removeongethit = 1

[State 100, 8]
type = Explod
trigger1 = Time = 0
anim = 6102
pos = -20,-80
postype = p1
sprpriority = 2
bindtime = -1
removeongethit = 1

[State 100, 9]
type = Changeanim
triggerall = anim = 100
trigger1 = AnimTime = 0
value = 12

[State 100, 10]
type = ChangeState
triggerall = Anim = 12
trigger1 = AnimTime = 0
value = 0
ctrl = 1

