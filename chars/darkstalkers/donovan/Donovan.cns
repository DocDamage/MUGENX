type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 170, 2]
type = AssertSpecial
trigger1 = Time <= 200
flag = RoundNotOver

