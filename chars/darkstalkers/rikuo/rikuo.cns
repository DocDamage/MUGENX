; Combo Ranking (by Kamek, cut and pasted from BB Hood)
[State -2, Set Up For Count]
type = VarSet
trigger1 = p2movetype = H
trigger1 = !Var(15)
v = 15
value = 1

[State -2, Keep Track Of Hit Count]
type = VarSet
trigger1 = UniqHitCount > 0
trigger1 = Var(15)
v = 16
value = UniqHitCount

[State -2, Add To Total Hit Count]
type = VarSet
triggerall = Var(15)
trigger1 = UniqHitCount < Var(16)
trigger2 = p2movetype != H
v = 17
value = Var(17) + Var(16)

[State -2, Add Helper Hits To Total Hit Count]
type = VarSet
triggerall = Var(15)
trigger1 = Var(19) != 0
trigger2 = p2movetype != H
v = 17
value = Var(17) + Var(19)

[State -2, Keep Track of Helper Hit Count]
type = VarSet
trigger1 = Var(19) != 0
trigger1 = Var(15)
v = 19
value = 0

[State -2, Projectile Hits]
type = VarSet
triggerall = Var(15)
trigger1 = ProjHit = 1
v = 17
value = Var(17) + 1

[State -2, Reset Current Hit Count]
type = VarSet
trigger1 = UniqHitCount < Var(16)
trigger1 = Var(15)
v = 16
value = UniqHitCount

[State -2, Combo Is Finished]
type = VarSet
triggerall = Var(15)
trigger1 = p2movetype != H
trigger2 = (enemy, stateno = 5150) && (enemy, alive = 0)
v = 16
value = 0

[State -2, Combo Is Finished]
type = Helper
triggerall = Var(15)
triggerall = Var(17) > 1
triggerall = !NumHelper(9200)
trigger1 = p2movetype != H
trigger2 = (enemy, stateno = 5150) && (enemy, alive = 0)
name = "Combo Report!"
postype = left
facing = 1
ID = 9200
stateno = 9200
ownpal = 1

[State -2, Reset]
type = VarSet
triggerall = Var(15)
trigger1 = p2movetype != H
trigger2 = (enemy, stateno = 5150) && (enemy, alive = 0)
v = 15
value = 0

[State -2, Reset]
type = Null ;VarSet
trigger1 = p2movetype != H
trigger2 = (enemy, stateno = 5150) && (enemy, alive = 0)
v = 14
value = 0

[State -2, Reset]
type = VarSet
trigger1 = NumHelper(9200)
trigger1 = Helper(9200), time = 1
trigger1 = !Var(15)
trigger1 = Var(17) > 0
trigger2 = !NumHelper(9200)
trigger2 = !Var(15)
trigger2 = Var(17) > 0
v = 17
value = 0

; Report DF Win
[State -2, Report DF Win]
type = Helper
triggerall = var(5) = 1
trigger1 = WinKO
trigger1 = NumHelper(9230) = 0
ID = 9230
name = "Dark Force Finish"
stateno = 9230
ownpal = 1
postype = p1
pos = 0, 0

; Counter for determining AI's ability to perform charge moves
[State -2, Increment Counter]
type = VarAdd
triggerall = var(11)
trigger1 = StateNo = 11
trigger2 = (StateNo = 20) && (Vel X < 0)
trigger3 = (StateNo = 50) && (Vel X <= 0)
trigger4 = (StateNo = 105) || (StateNo = 500) || (StateNo = 106)
trigger5 = MoveType = H
trigger6 = StateNo = [120,140]
v = 12
value = 1
ignorehitpause = 1

[State -2, Reset Counter]
type = VarSet
triggerall = var(11)
trigger1 = StateNo = 0
trigger2 = (StateNo = 20) && (Vel X > 0)
trigger3 = (StateNo = 50) && (Vel X > 0)
trigger4 = StateNo = 100
trigger5 = StateNo = [1000,1020]
trigger6 = StateNo = 810
trigger7 = StateNo = 920 || StateNo = 960 || StateNo = 1040
trigger8 = StateNo = 2000 || StateNo = 2200 || StateNo = 2300
v = 12
value = 0
ignorehitpause = 1

[State -2, Remove]
type = RemoveExplod
trigger1 = PrevStateNo = 670
ID = 23

[State -2, Clear DF Var]
type = VarSet
trigger1 = RoundState = 4
v = 5
value = 0

[State -2, Remove Foreground]
type = AssertSpecial
trigger1 = var(5) = 1
flag = NoFG
ignorehitpause = 1

[State -2, Remove BackGround]
type = AssertSpecial
triggerall = NumExplod(1005) = 1
trigger1 = var(5) = 1
flag = NoBG
ignorehitpause = 1

; Advancing Guard
[State -2, Add]
type = VarAdd
triggerall = StateNo = 150 || StateNo = 152 || (StateNo = 151 && time <= 10) || (StateNo = 153 && time <= 10)
trigger1 = command = "a"
trigger2 = command = "b"
trigger3 = command = "c"
trigger4 = command = "x"
trigger5 = command = "y"
trigger6 = command = "z"
v = 9
value = 1
ignorehitpause = 1

[State -2, Clear]
type = VarSet
triggerall = var(9) > 0
trigger1 = MoveType != H
v = 9
value = 0

[State -2, Change]
type = ChangeState
trigger1 = var(9) = 4
value = 1150
ignorehitpause = 1

; Get Poison to use depending on opponent distance
; AI ONLY
[State -2, Get Distance]
type = VarSet
trigger1 = var(11)
v = 13
value = ifelse(P2BodyDist X <= 128, 860, ifelse(P2BodyDist X <= 180, 880, 890))
ignorehitpause = 1

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime Rikuo lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
;trigger2 = stateno = 106 ;Run-back land
value = 1, 9

; Clear the Trick Fish variable if Rikuo gets hit
[State -3, Clearit]
type = VarSet
trigger1 = StateNo = 5000
v = 0
value = 0

; Gethit sounds (Used BB Hood as reference)
; Ouch sound randomizer
[State -3, 1]
type = VarRandom
trigger1 = StateNo = 5000
trigger1 = time = 1
v = 1

; Ow sound 1
[State -3, Ow 1]
type = PlaySnd
triggerall = alive
triggerall = time = 1
triggerall = var(1) < 500
trigger1 = stateno = 5001 || stateno = 5011
trigger1 = (anim % 10) != 0
trigger2 = stateno = 5040 || stateno = 5050
trigger2 = random < 500
trigger3 = stateno = 5070
value = 2, 1
channel = 0

; Ow sound 2
[State -3, Ow 2]
type = Playsnd
triggerall = alive
triggerall = time = 1
triggerall = var(1) >= 500
trigger1 = stateno = 5001 || stateno = 5011
trigger1 = (anim % 10) != 0
trigger2 = stateno = 5040 || stateno = 5050
trigger2 = random < 500
trigger3 = stateno = 5070
value = 2, 2
channel = 0

; Clear Var 3
[State -3, Clear Var3]
type = VarSet
trigger1 = Stateno = 0
trigger2 = StateNo = 52
trigger3 = StateNo = 5100
v = 3
value = 0

; Stop Camera from following Rikuo up if in DF mode
[State -3, Camera Freeze]
type = ScreenBound
trigger1 = var(5) = 1
trigger1 = NumHelper(751) = 1
value = 1
movecamera = 100, 0

; Decrement DF counter if in DF mode
[State -3, Decrement DF]
type = VarAdd
triggerall = var(4) > 0
trigger1 = var(5) = 1
trigger1 = StateNo != 3000
v = 4
value = -1
ignorehitpause = 1

; Leave DF mode if counter = 0 or other conditions met
[State -3, Leave DF]
type = ChangeState
triggerall = var(5) = 1
triggerall = StateNo != 3000
trigger1 = var(4) <= 0
trigger2 = life = 0
trigger3 = Win
trigger4 = command = "DarkForce"
trigger4 = !var(11)
trigger5 = RoundState = 3
value = 3200

; Hyper Armor for DF mode
[State -3, DF VarSet]
type = VarSet
trigger1 = var(5) = 1
trigger1 = MoveType != H
var(3) = StateNo

[State -3, Overide Hits]
type = HitOverRide
trigger1 = var(5) = 1
time = 2
slot = 0
attr = SCA, AA, AP, AT
stateno = 3210

[State -3, Don't Leave 3000's During DF]
type = ChangeState
trigger1 = var(5) = 1
trigger1 = Movetype = H
trigger1 = Stateno != 3210
value = 3100

[State -3, Remove Foreground]
type = AssertSpecial
trigger1 = var(5) = 1
flag = NoFG
ignorehitpause = 1

[State -3, Kill AI When Fight is Over]
type = VarSet
triggerall = var(11)
trigger1 = Win
trigger2 = Lose
v = 11
value = 0

[State -3, Record AI being active]
type = VarSet
triggerall = var(11)
trigger1 = !var(59)
v = 59
value = 1

[State -3, Debug]
type = DisplayToClipboard
