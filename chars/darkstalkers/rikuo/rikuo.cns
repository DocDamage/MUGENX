; Rikuo's constants and state file.
;
; Variables:
; var(0) - Trick Fish variable
;		0: No button pressed during hopback
;		1: "a" pressed during hopback
;		2: "b" pressed during hopback
;		3: "c" pressed during hopback
;           4: ES Trick Fish command entered during hopback
; var(1) - all purpose temporary variable
; var(2) - also temporary variable
; var(3) - Last air attack executed
;             1 3 5
;		  2 4 6
; var(4) - Timer for Dark Force mode (starts at 600 = 10 seconds)
; var(5) - Is 1 if player is in Dark Force mode
; var(6) - X Pos
; var(7) - Holds Rikuo's screenpos Y at start of round
; var(8) - Facing at start of round
; var(9) - Advancing Guard var
; var(10) - Button pressed to activate advancing guard
; var(11) - AI Variable
; var(12) - AI Charge var
; var(13) - AI distance var
; var(14) - First Attack Counter
; var(15) = Combo active
; var(16) = Hitcount for current state
; var(17) = Total HitCount
; var(18) = Null
; var(19) = Helper hit count
; var(59) - AI was active
;
[Data]
  ;Amount of life to start with
life = 1000
power = 9000
  ;attack power (more is stronger)
attack = 100
  ;defensive power (more is stronger)
defence = 100
  ;Percentage to increase defense everytime player is knocked down
fall.defence_up = 50
  ;Time which player lies down for, before getting up
liedown.time = 70
  ;Number of points for juggling
airjuggle = 15
  ;Default hit spark number for HitDefs
sparkno = 2
  ;Default guard spark number
guard.sparkno = 40
  ;1 to enable echo on KO
KO.echo = 0
  ;Volume offset (negative for softer)
volume = 255
  ;Variables with this index and above will not have their values
  ;reset to 0 between rounds or matches. There are 60 int variables,
  ;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
  ;If omitted, then it defaults to 60 and 40 for integer and float
  ;variables repectively, meaning that none are persistent, i.e. all
  ;are reset. If you want your variables to persist between matches,
  ;you need to override state 5900 from common1.cns.
IntPersistIndex = 59
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 37   ;Player width (back, ground)
ground.front = 20    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
height = 60	     ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = -5, -90   ;Approximate position of head
mid.pos = -5, -60    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 3.4      ;Walk forward
walk.back = -3.2     ;Walk backward
run.fwd  = 4.8, 0    ;Run forward (x, y)
run.back = -5.3,-2.4 ;Hop backward (x, y)
jump.neu = 0,-8.4    ;Neutral jumping velocity (x, y)
jump.back = -4    ;Jump back Speed (x, y)
jump.fwd = 4       ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-8.1      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.

[Movement]
airjump.num = 0     ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .44         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
[Statedef 180]
type = S

[State 180, 1]
type = VarRandom
trigger1 = time = 0
v = 1
range = 0, 1250

[State 180, a]
type = ChangeState
trigger1 = time >= 2
trigger1 = var(1) = [0,250]
trigger2 = command = "HoldC"
value = 2600

[State 180, b]
type = ChangeState
trigger1 = time >= 2
trigger1 = var(1) = [251,500]
trigger2 = command = "HoldX"
value = 2500

[State 180, 2]
type = ChangeState
trigger1 = time >= 2
trigger1 = var(1) = [501,750]
trigger2 = command = "HoldY"
value = 181

[State 180, 3]
type = ChangeState
trigger1 = Time >= 2
trigger1 = var(1) = [751,1000]
trigger2 = command = "HoldZ"
value = 182

[State 180, 4]
type = ChangeState
trigger1 = time >= 2
trigger1 = var(1) = [1001,1250]
trigger2 = command = "HoldB"
value = 183

;---------------------------------------------------------------------------
; Win pose 1 - Gills
[Statedef 181]
type = S
ctrl = 0
physics = N
velset = -1,-10

[State 181, 1]
type = ChangeAnim
trigger1 = time = 0
value = 43

[State 181, 2]
type = Gravity
trigger1 = Pos Y <= -1

[State 181, 3]
type = ChangeAnim
trigger1 = time = 50 
value = 181

[State 181, 4]
type = VelSet
triggerall = time > 10
trigger1 = Pos Y >= -1
y = 0
x = 0

[State 181, 4a]
type = PosSet
triggerall = time > 10
trigger1 = Pos Y >= -1
y = 0

[State 181, 5]
type = AssertSpecial
trigger1 = time < 300
flag = roundnotover

[State 181, 6]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

