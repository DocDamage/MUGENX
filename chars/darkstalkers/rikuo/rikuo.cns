;---------------------------------------------------------------------------
; Introduction State Decider
; 
[Statedef 191]
type = S
ctrl = 0
velset = 0,0

[State 191, Set]
type = Varset
trigger1 = time = 0
v = 0
value = 0

[State 191, Set2]
type = Varset
trigger1 = time = 0
v = 6
value = floor(Pos X)

[State 191, Set3]
type = VarSet
trigger1 = time = 0
v = 3
value = 0

[State 191, 1]
type = VarRandom
trigger1 = time = 0
v = 2
range = 0, 100

[State 191, 2]
type = ChangeState
trigger1 = Var(2) <= 50
trigger2 = p2name = "Rikuo"
trigger2 = Pos X > 0
value = 192

[State 191, 3]
type = ChangeState
trigger1 = Var(2) > 50
value = 2400

;---------------------------------------
; Intro 1 - Frog
[Statedef 192]
type = S
ctrl = 0
velset = 0,0

[State 192, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 192, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, 4] ;Change to stand state
type = ChangeState
trigger1 = AnimTime = 0
value = 0

