; Definition file for kfm
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Rikuo"        ;Name of character
displayname = "Rikuo" ;Name of character to display
versiondate = 11,22,2000    ;Version date of character
mugenversion = 11,22,2000   ;Version of M.U.G.E.N character works on
author = "Splode"         ;Character author name
pal.defaults = 1,3,4,2,5,6    

; Files for the player
[Files]
cmd     = rikuo.cmd   ;Command set
cns     = rikuo.cns   ;Constants
st      = rikuo.cns   ;States
stcommon = common1.cns ;Common states
sprite  = rikuo.sff   ;Sprite
anim    = rikuo.air   ;Animation
sound   = rikuo.snd   ;Sound
pal1    = rikuo.act  ;Palettes (can have up to 12)
pal2    = alt1.act
pal3    = alt2.act
pal4    = alt3.act
pal5    = alt4.act
pal6    = alt5.act