[Statedef 5120]
type    = L
movetype= I
physics = N
velset = 0

[State 5120, 1a]
type = ChangeAnim
triggerall = time = 0
trigger1 = anim != [5111,5119]
trigger2 = !SelfAnimExist(5120 + (anim % 10))
value = 5120

[State 5120, 1b]
type = ChangeAnim
triggerall = time = 0
trigger1 = anim = [5111,5119]
trigger1 = SelfAnimExist(5120 + (anim % 10))
value = 5120 + (anim % 10)

[State 5120, var]
type = varset
trigger1 = time = 0
var(2) = 0

[State 5120, var]
type = varset
triggerall = time <= 5
triggerall = command = "hold_a" || command = "hold_b" || command = "hold_c" || command = "hold_x" || command = "hold_y" || command = "hold_z"
trigger1 = command = "holddownforward"
trigger2 = command = "holdfwd"
var(2) = 1;fwd

[State 5120, var]
