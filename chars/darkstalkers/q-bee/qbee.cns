;---------------------------------------------------------------------------
; Air Dash
[Statedef 102]
type    = A
physics = N
anim = 102
sprpriority = 1
velset = 0,0
;face2p = 1

[State 102, 0]
type = PlaySnd
trigger1 = time = 1
value = 10,1
channel = 3

[State 102, 1]
type = Width
trigger1 = 1
edge = 20,

[State 102, 2]
type = changeanim
trigger1 = time = 1
trigger1 = var(6) > 40
value = 104

[State 102, 5]
type = turn
trigger1 = time = 1
trigger1 = var(5) < 0

[State 102, vel]
type = VelSet
trigger1 = time >= 1
trigger1 = var(6) = [-10,10]
x = const(velocity.run.fwd.x)
y = 0

;近
[State 102, vel]
type = VelSet
trigger1 = time >= 1
trigger1 = (var(5) = [0,50]) || (var(5) = [-50,0])
trigger1 = var(6) != [-10,10]
x = ifelse((p2bodydist x = [0,5]),0,const(velocity.run.fwd.x))
y = ifelse(var(6) > 0,5.5,-5.5)

;遠
[State 102, vel]
type = VelSet
trigger1 = time >= 1
trigger1 = (var(5) > 50) || (var(5) < -50)
trigger1 = var(6) != [-10,10]
x = ifelse((p2bodydist x = [0,5]),0,const(velocity.run.fwd.x))
y = (var(6)/var(5))+(var(6)/30)

[State 102, 3]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 102, 4]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 102, 5]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52

[State 102, 5]
type = ChangeState
trigger1 = animtime = 0
value = 103
ctrl = 1

