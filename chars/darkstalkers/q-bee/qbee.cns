;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

;デバッグ用数値表示
[State -2, Dsp]
type = DisplayToClipboard
trigger1 = !win
text="var(26) is %d"
params = var(13)
ignorehitpause = 1

;音止め1
[State -2]
type = StopSnd
triggerall = Time = 0
trigger1 = MoveType = H
channel = 1

;音止め2
[State -2]
type = StopSnd
triggerall = Time = 0
trigger1 = MoveType = H
channel = 2

;音止め3
[State -2]
type = StopSnd
triggerall = Time = 0
trigger1 = MoveType = H
channel = 3

;palfx reset
[State -2,palreset]
type = null;Palfx
trigger1 = MoveType = H; && ((stateno = [1280,1281]) || (stateno = [1300,1301]) || stateno = 1202 || stateno = 1252 || (stateno = [1580,1583]) || (stateno = [1590,1593]) || (stateno = [2000,2099]) || (stateno = [2500,2800]))
time = 1
add = 0,0,0
mul = 256,256,256
ignorehitpause = 1

;BGpalfx reset
[State -2,BGreset]
type = null;BGPalfx
trigger1 = MoveType = H
trigger2 = !var(23) && var(24)
time = 1
add = 0,0,0
mul = 256,256,256
ignorehitpause = 1


;===================================================================================================
;ダークフォース

;timer
[State -2, i2]
type = Varadd
trigger1 = var(23)
var(24) = 1
ignorehitpause = 1

;v23リセット
[State -2, i2]
type = Varset
triggerall = var(23) != 0
trigger1 = var(24) >= 700
trigger2 = win || lose
trigger3 = command = "i2" && ctrl;中断
var(23) = 0
ignorehitpause = 1

;v24リセット
[State -2, i2]
type = Varset
triggerall = var(24) != 0
trigger1 = var(23) = 0
var(24) = 0
ignorehitpause = 1

;v27(色2)セット
[State -2, i2]
type = Varset
triggerall = var(26) != 0
trigger1 = var(23) = 0 && numexplod(3500) = 0
;trigger2 = win || lose
;trigger3 = command = "i2" && ctrl;中断
var(27) = 1
ignorehitpause = 1

;v26(色1)リセット
[State -2, i2]
type = Varset
triggerall = var(26) != 0
trigger1 = var(23) = 0 && numexplod(3500) = 0
var(26) = 0
ignorehitpause = 1

[State -2, i2]
type = ScreenBound
trigger1 = numexplod(3500) = 1
value = 1
movecamera = 0,1

[State -2, i2]
type = changestate
triggerall = var(23)
trigger1 = stateno = 50
value = 3530

;DF中のY軸補正
[State -2, i2]
type = velset
triggerall = var(23)
trigger1 = (stateno = [600,699]) || stateno = 1252
y = 0

[State -2, i2]
type = assertspecial
trigger1 = numexplod(3500) = 1
ignorehitpause = 1
flag = nobardisplay

[State -2, i2]
type = null;EnvColor
triggerall = !var(23)
trigger1 = numexplod(3500) = 1
ignorehitpause = 1
persistent = 0
value = 0,0,0
time = 1
under = 1

;BG color
[State -2, i2]
type = Varadd
triggerall = var(26) != 0
trigger1 = var(26) < 64;43
var(26) = 1
ignorehitpause = 1

;BG color
[State -2, i2]
type = BGPalFX
trigger1 = var(26)
trigger2 = var(23) = 1
trigger3 = stateno = [3500,3510]
ignorehitpause = 1
mul = var(26)*2,var(26)*2,var(26)*2;var(26)*3,var(26)*3,var(26)*3
time = 1
invertall = 1
color = 512;var(26)*12

;BG color#2
[State -2, i2]
type = Varadd
triggerall = var(27)
trigger1 = var(27) < 32
var(27) = 1
ignorehitpause = 1

;BG color#2
[State -2, i2]
type = BGPalfx
trigger1 = var(27)
ignorehitpause = 1
time = 1
add = 128-(var(27)*4),128-(var(27)*4),128-(var(27)*4)
mul = 128+(var(27)*4),128+(var(27)*4),128+(var(27)*4)

;BG color#2 end
[State -2, i2]
type = BGPalfx
trigger1 = var(27) = 32
ignorehitpause = 1
time = 1
add = 0,0,0
mul = 256,256,256

;v27リセット
[State -2, i2]
type = Varset
trigger1 = var(27) = 32
var(27) = 0
ignorehitpause = 1

; 点滅
[State -2, i2]
type = PalFX
triggerall = var(23)
triggerall = stateno != [3500,3520]
triggerall = timemod = 4,0
triggerall = !win
trigger1 = !lose
time = 2
add = 64,64,64
ignorehitpause = 1

