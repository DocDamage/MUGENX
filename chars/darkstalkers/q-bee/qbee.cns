;===========================================================================
; Q-Bee (Vampire Savior)
; Made by M@PPY
;http://izanai.cjb.net/

;===========================================================================

;var(1) 勝利分岐フラグ
;var(2) rol
;var(3) ジャンプ用
;var(4) SxP用
;var(5) 空中ダッシュ用X
;var(6) 空中ダッシュ用Y
;var(8) C→R ES用
;var(9) C→R ES 色変化用
;var(10) FA
;var(11) combo
;var(12) facing or not
;var(13) hit counter
;var(14) finish flag
;var(15) reversal
;var(16) Advancing Guard
;var(17) Guard Cancel
;var(20) デルタA用X
;var(21) デルタA用Y
;var(22) WinKO effect
;var(23) DF ON/OFF
;var(24) DF タイマー用
;var(25) DF 浮沈用
;var(26) DF 色1
;var(27) DF 色2
;
;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 0]
type = ChangeState
trigger1 = Time = 0
trigger1 = var(23) = 1
value = 3530

[State 40, 1]
type = VarSet
trigger1 = Time = 0
var(3) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
var(3) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
var(3) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(var(3)=0, const(velocity.jump.neu.x), ifelse(var(3)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100
trigger1 = var(3) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100
trigger1 = var(3) = 1
var(3) = 2

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

