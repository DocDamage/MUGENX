;---------------------------------------------------------------------------
; i2 stay in air
[Statedef 3530]
type    = A
physics = N
ctrl = 1
anim = 3530
sprpriority = 2
velset = 0,0

[State 3530, pos]
type = PosSet
trigger1 = Pos Y < -140
y = -140

;停止
[State 3530, 0]
type = VelSet
trigger1 = var(25) = 0
trigger1 = command != "holdfwd"
trigger1 = command != "holdback"
trigger1 = command != "holdup"
trigger1 = command != "holddown"
trigger2 = Pos Y < -140
x = 0
y = 0

;上昇
[State 3530, 1]
type = VelSet
trigger1 = Pos Y > -140
trigger1 = command = "holdup"
y = -4

;下降
[State 3530, 2]
type = VelSet
trigger1 = command = "holddown"
y = 4

;前進
[State 3530, 3]
type = VelSet
trigger1 = command = "holdfwd"
x = 4

;後退
[State 3530, 4]
type = VelSet
trigger1 = command = "holdback"
x = -4

;地面
[State 3530, 5]
type = Changestate
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52
ctrl = 1

;方向転換
[State 3530, 6]
type = Turn
trigger1 = P2Dist X < 0

[State 3530,fuwa]
type = VarSet
trigger1 = command != "holdfwd"
trigger1 = command != "holdback"
trigger1 = command != "holdup"
trigger1 = command != "holddown"
trigger1 = var(25) != 2
trigger2 = var(25) = 2
trigger2 = Vel Y >= .3
v = 25
value = 1

[State 3530,fuwa]
type = VarSet
triggerall = var(25) = 1
trigger1 = Vel Y <= -.3
;trigger2 = P2BodyDist Y > 140
;trigger2 = Vel Y < 0
v = 25
value = 2

[State 3530,fuwa]
type = VelAdd
trigger1 = var(25) = 1
y = -.01

[State 3530,fuwa]
type = VelAdd
trigger1 = var(25) = 2
y = .01

[State 3530,fuwa]
type = VelSet
triggerall = var(25) != 0
trigger1 = command = "holdfwd"
trigger2 = command = "holdback"
trigger3 = command = "holdup"
trigger4 = command = "holddown"
y = 0

[State 3530,fuwa]
type = VarSet
trigger1 = command = "holdfwd"
trigger2 = command = "holdback"
trigger3 = command = "holdup"
trigger4 = command = "holddown"
