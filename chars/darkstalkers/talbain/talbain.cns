;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, a]
type = ChangeAnim
trigger1 = PrevStateNo = 20
trigger1 = time = 0
value = 22

[State 0, b]
type = VarSet
trigger1 = time = 0
v = 0
value = 0

[State 0, c]
type = VarAdd
trigger1 = Anim = 0
trigger1 = AnimTime = 0
v = 0
value = 1

[State 0, d]
type = PlaySnd
trigger1 = (var(0) % 2) = 1
trigger1 = AnimElem = 14
value = 3, 0
channel = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 && Anim != 22
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
trigger3 = Anim = 22
trigger3 = AnimTime = 0
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1

[State 100, 1]
type = StateTypeSet
trigger1 = AnimElem = 4
statetype = A
persistent = 0

[State 100, a]
type = StateTypeSet
trigger1 = AnimElem = 4
physics = N
persistent = 0

[State 100, b]
type = PlayerPush
trigger1 = StateType = A
value = 0

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = NoAirGuard

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = VelSet
trigger1 = AnimElem = 4
x = 7
y = -4.5
persistent = 0

[State 100, 5]
type = Gravity
trigger1 = AnimElemNo(0) = 4
trigger2 = AnimElemNo(1) = 5

[State 100, 6]
type = ChangeState
trigger1 = AnimElemNo(0) = [4,5]
trigger1 = Pos Y >= 0
trigger1 = Vel Y >= 0
value = 101

; Land from forward leap
[Statedef 101]
type = S
physics = S
anim = 101
velset = 0, 0
ctrl = 0

[State 101, 1]
type = PosSet
trigger1 = time = 0
y = 0

[State 101, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; RUN_BACK
[Statedef 105]
type    = A
physics = A
ctrl = 0
anim = 105
sprpriority = 1

[State 105, 1]
type = VelSet
trigger1 = AnimElem = 2
x = -7
y = -5
persistent = 0

[State 105, 3]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 106

;---------------------------------------------------------------------------
; RUN_BACK2 (land)
[Statedef 106]
type    = S
physics = S
ctrl = 0
anim = 106

[State 106, 1]
type = VelSet
trigger1 = Time = 0
x = 0
y = 0

[State 106, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 106, 3]
type = MakeDust
trigger1 = Time = 2
pos = -5,-2
spacing = 1

[State 106, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


;---------------------------------------------------------------------------
; HITG_SHAKE
[Statedef 5000]
type    = S
movetype= H
physics = N
velset = 0,0

[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),5000,5010) + GetHitVar(animtype)

[State 5000, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030

[State 5000, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type

[State 5000, 4] ;Freeze anim
type = Null ;ChangeAnim
trigger1 = Time > 0
value = anim

[State 5000, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 && GetHitVar(fall)
trigger2 = Pos Y != 0
type = a

[State 5000, 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0
value = 5001 ;HITG_SLIDE

[State 5000, 7]
type = ChangeState
trigger1 = HitShakeOver
value = 5030

[State 5000, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 5000, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5000, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; HITC_SHAKE
[Statedef 5010]
type    = C
movetype= H
physics = N
velset = 0,0

[State 5010, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = 5020 + GetHitVar(animtype)

[State 5010, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030

[State 5010, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type

[State 5010, 4] ;Freeze anim
type = Null ;ChangeAnim
trigger1 = Time > 0
value = anim

[State 5010, 5]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0
value = 5011 ;HITC_SLIDE

[State 5010, 6]
type = ChangeState
trigger1 = HitShakeOver
value = 5030

[State 5010, FFB Light]
type = ForceFeedback
trigger1 = anim = 5020
persistent = 0
time = 6
waveform = square

[State 5010, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5021
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5010, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5022
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; HITA_SHAKE
[Statedef 5020]
type    = A
movetype= H
physics = N
velset = 0,0

[State 5020, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(airtype) = 1),5000,5010) + GetHitVar(animtype)

[State 5020, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030

[State 5020, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type

[State 5020, 4] ;Freeze anim
type = Null ;ChangeAnim
trigger1 = Time > 0
value = anim

[State 5020, 5]
type = ChangeState
trigger1 = HitShakeOver
value = 5030

[State 5020, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 5020, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5020, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
trigger4 = anim = [5051,5059]
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; HITL_SHAKE
[Statedef 5080]
type    = L
movetype= H
physics = N
velset = 0,0

[State 5080, 1] ;Set default anim
type = VarSet
trigger1 = time = 0
sysvar(2) = ifelse (GetHitVar(yvel) = 0, 5080, 5090)

[State 5080, 2]
type = VarAdd
trigger1 = time = 0
trigger1 = (anim = [5081,5089]) || (anim = [5111,5119])
trigger1 = SelfAnimExist(sysvar(2) + (anim % 10))
sysvar(2) = anim % 10

[State 5080, 3] ;If 5090 doesn't exist, default to 5030
type = VarSet
trigger1 = time = 0
trigger1 = sysvar(2) = 5090
trigger1 = !SelfAnimExist(5090)
sysvar(2) = 5030

[State 5080, 3] ;Freeze
type = ChangeAnim
trigger1 = 1
value = sysvar(2)
persistent = 0

[State 5080, 4]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0
value = 5081 ;HITL_SLIDE

[State 5080, 5]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) != 0
value = 5030 ;HITA_UP

;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0

[State 5900, Activate AI]
type = VarSet
trigger1 = time = 0
trigger1 = var(59)
v = 20
value = 1

[State 5900, 3] ;Intro for round 1
type = ChangeState
trigger1 = roundno = 1
value = 190


;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -2, Report ES Finishes]
type = Helper
triggerall = WinKO
triggerall = NumHelper(9240) = 0
trigger1 = StateNo = [1000,1140]
trigger1 = var(0) = 1
trigger2 = StateNo = 1230
trigger3 = StateNo = 1270
trigger4 = StateNo = 1310
trigger5 = StateNo = 980
ID = 9240
postype = p1
pos = 0, 0
name = "ES Finish"
stateno = 9240
ownpal = 1

[State -2, Report EX Finishes]
type = Helper
triggerall = WinKO
triggerall = NumHelper(9250) = 0
trigger1 = NumHelper(2010) = 1
trigger1 = Helper(2010), MoveHit
trigger2 = StateNo = 2040 
ID = 9250
postype = p1
pos = 0, 0
name = "EX Finish"
stateno = 9250
ownpal = 1

; Dark Force
[State -2, Decrement Counter]
type = VarAdd
triggerall = StateNo != 2100
trigger1 = var(14) = 1
trigger1 = var(13) != 0
v = 13
value = -1
ignorehitpause = 1

[State -2, Leave Darkforce]
type = ChangeState
triggerall = var(14) = 1
trigger1 = var(13) = 0
trigger1 = StateType = S || StateType = C
trigger1 = MoveType != H
value = 2120

[State -2, Turn off background]
type = AssertSpecial
triggerall = var(14) = 1
trigger1 = NumExplod(132) = 1
flag = NoBG
flag2 = NoFG
ignorehitpause = 1

[State -2, Remove DF Stuff]
type = RemoveExplod
triggerall = var(14) = 1
trigger1 = Win
trigger2 = Lose
trigger3 = !Alive

[State -2, Report DF Win]
type = Helper
triggerall = var(14) = 1
trigger1 = WinKO
trigger1 = NumHelper(9230) = 0
ID = 9230
name = "Dark Force Finish"
stateno = 9230
ownpal = 1
postype = p1
pos = 0, 0

[State -2, Remove DF Stuff]
type = VarSet
triggerall = var(14) = 1
trigger1 = Win
trigger2 = Lose
trigger3 = !Alive
v = 14
value = 0

[State -2, Check if in custom state]
type = VarSet
trigger1 = 1
v = 6
value = ifelse(var(4) - var(5) = 0, 1, 0)

[State -2, Set Var]
type = VarSet
trigger1 = 1
v = 5
value = var(4)

[State -2, Set Direction]
type = VarSet
trigger1 = RoundState = 0
v = 9
value = Facing

; Guard triggers for AI (from BB Hood)
[State -2, Stand guard]
type = ChangeState
triggerall = var(20) > 0
triggerall = StateType != A
triggerall = PlayerID(var(21)), StateType != C
triggerall = PlayerID(var(21)), MoveType = A
trigger1 = ctrl = 1
value = 130

[State -2, S-to-C guard]
type = ChangeState
triggerall = var(20) > 0
triggerall = StateType != A
triggerall = PlayerID(var(21)), statetype = C
triggerall = PlayerID(var(21)), Movetype = A
trigger1 = stateno = 150
value = 152

[State -2, Crouch guard]
type = ChangeState
triggerall = var(20) > 0
triggerall = StateType != A
triggerall = PlayerID(var(21)), statetype = C
triggerall = PlayerID(var(21)), Movetype = A
trigger1 = ctrl = 1
value = 131

[State -2, C-to-S guard]
type = ChangeState
triggerall = var(20) > 0
triggerall = StateType != A
triggerall = PlayerID(var(21)), statetype != C
triggerall = PlayerID(var(21)), Movetype = A
trigger1 = stateno = 152
value = 150

[State -2, Air guard]
type = ChangeState
triggerall = var(20) > 0
triggerall = StateType = A
triggerall = PlayerID(var(21)), Movetype = A
trigger1 = ctrl = 1
value = 132

; First Attack message (by M@ppy, cut and pasted from BB Hood)
[State -2, Var]
type = VarSet
triggerall = Var(10) = 0
triggerall = p2movetype = H
triggerall = p2StateNo != [150,155]
triggerall = RoundState = 2
trigger1 = movecontact = 1
trigger2 = projcontact = 1
trigger3 = NumHelper(1280) > 0
trigger3 = Helper(1280), MoveContact
trigger4 = NumHelper(2010) > 0
trigger4 = Helper(2010), MoveContact
v = 10
value = 1
ignorehitpause = 1

[State -2, Message]
type = Helper
triggerall = NumHelper(9208) = 0
trigger1 = Var(10) = 1
ID = 9208
name = "First Attack!"
facing = 1
postype = left
stateno = 9220
ownpal = 1

[State -2, Var]
type = VarSet
trigger1 = Var(10) = 1
trigger2 = movetype = H
trigger2 = StateNo != [150,155]
v = 10
value = 2

; Combo Ranking (by Kamek, cut and pasted from BB Hood)
[State -2, Set Up For Count]
type = VarSet
trigger1 = p2movetype = H
trigger1 = !Var(15)
v = 15
value = 1

[State -2, Keep Track Of Hit Count]
type = VarSet
trigger1 = UniqHitCount > 0
trigger1 = Var(15)
v = 16
value = UniqHitCount

[State -2, Add To Total Hit Count]
type = VarSet
triggerall = Var(15)
trigger1 = UniqHitCount < Var(16)
trigger2 = p2movetype != H
v = 17
value = Var(17) + Var(16)

[State -2, Add Helper Hits To Total Hit Count]
type = VarSet
triggerall = Var(15)
trigger1 = Var(19) != 0
trigger2 = p2movetype != H
v = 17
value = Var(17) + Var(19)

[State -2, Keep Track of Helper Hit Count]
type = VarSet
trigger1 = Var(19) != 0
trigger1 = Var(15)
v = 19
value = 0

[State -2, Reset Current Hit Count]
type = VarSet
trigger1 = UniqHitCount < Var(16)
trigger1 = Var(15)
v = 16
value = UniqHitCount

[State -2, Combo Is Finished]
type = VarSet
triggerall = Var(15)
trigger1 = p2movetype != H
trigger2 = (enemy, stateno = 5150) && (enemy, alive = 0)
v = 16
value = 0

[State -2, Combo Is Finished]
type = Helper
triggerall = Var(15)
triggerall = Var(17) > 1
triggerall = !NumHelper(9200)
trigger1 = p2movetype != H
trigger2 = (enemy, stateno = 5150) && (enemy, alive = 0)
name = "Combo Report!"
postype = left
facing = 1
ID = 9200
stateno = 9200
ownpal = 1

[State -2, Reset]
type = VarSet
triggerall = Var(15)
trigger1 = p2movetype != H
trigger2 = (enemy, stateno = 5150) && (enemy, alive = 0)
v = 15
value = 0

[State -2, Reset]
type = Null ;VarSet
trigger1 = p2movetype != H
trigger2 = (enemy, stateno = 5150) && (enemy, alive = 0)
v = 14
value = 0

[State -2, Reset]
type = VarSet
trigger1 = NumHelper(9200)
trigger1 = Helper(9200), time = 1
trigger1 = !Var(15)
trigger1 = Var(17) > 0
trigger2 = !NumHelper(9200)
trigger2 = !Var(15)
trigger2 = Var(17) > 0
v = 17
value = 0

; Advancing Guard
[State -2, Add]
type = VarAdd
triggerall = StateNo = 150 || StateNo = 152 || (StateNo = 151 && time <= 10) || (StateNo = 153 && time <= 10)
trigger1 = command = "a"
trigger2 = command = "b"
trigger3 = command = "c"
trigger4 = command = "x"
trigger5 = command = "y"
trigger6 = command = "z"
v = 12
value = 1
ignorehitpause = 1

[State -2, Clear]
type = VarSet
triggerall = var(12) > 0
trigger1 = MoveType != H
v = 12
value = 0

[State -2, Change]
type = ChangeState
trigger1 = var(12) = 4
value = 760
ignorehitpause = 1

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, Increment]
type = VarAdd
trigger1 = 1
v = 4
value = 1

[State -3, Turn Over]
type = VarSet
trigger1 = var(4) > 4000
v = 4
value = 0

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 2, 5

; Gethit sounds
[State -3, 1]
type = VarRandom
trigger1 = StateNo = 5000
trigger1 = time = 1
v = 0

; Ouch sound 1
[State -3, Owie 1]
type = PlaySnd
triggerall = alive
triggerall = time = 1
triggerall = var(0) < 500
trigger1 = stateno = 5001 || stateno = 5011
trigger1 = (anim % 10) != 0
trigger2 = stateno = 5040 || stateno = 5050
;trigger2 = random < 500
trigger3 = stateno = 5070
value = 3, 2

; Clear Var 3
[State -3, Clear Var3]
type = VarSet
trigger1 = Stateno = 0
trigger2 = StateNo = 52
trigger3 = StateNo = 5100
v = 3
value = 0

; Get ID of nearest enemy
[State -3, Get ID]
type = VarSet
trigger1 = 1
v = 21
value = EnemyNear, ID
ignorehitpause = 1

[State -3, Randomize]
type = VarRandom
triggerall = var(20) = 1
trigger1 = var(22) = 0
trigger1 = MoveContact
v = 22
range = 1, 1000
ignorehitpause = 1

[State -3, Clear]
type = VarSet
triggerall = var(20) = 1
triggerall = var(22) > 0
trigger1 = MoveType != A
trigger2 = MoveContact = 0 
v = 22
value = 0
ignorehitpause = 1

[State -3, Kill AI when fight is over]
type = VarSet
triggerall = var(20) > 0
trigger1 = Win
v = 20
value = 0

[State -3, Record AI being Active]
type = VarSet
trigger1 = var(20)
trigger1 = !var(59)
v = 59
value = 1
