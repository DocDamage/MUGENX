

; Variables:
; var(0) = Temp
; var(1) = Temp
; var(2) = Temp 
; var(3) = Last air move executed
; var(4) = Count A for custom state detection
; var(5) = Count B "   "        "     "
; var(6) = Set to 1 if in custom state
; var(7) = Holds # of direction changes remaining for Beast Cannon
; var(8) = Holds direction to rush in:
;                        Upback -1    Up  1   UpFwd 3
;                        Back   -2            Fwd   4
;                        DnBack -3    Dn  2   DnFwd 5
; var(9) = Holds Jon's facing at start of round
; var(10) = First attack counter
; var(11) = Button pressed to activate Advancing Guard
; var(12) = Advancing guard button press count
; var(13) = Timer for Dark Force mode
; var(14) = DF Active
; var(15) = Combo active
; var(16) = Hitcount for current state
; var(17) = Total HitCount
; var(18) = Null
; var(19) = Helper hit count
; var(20) = AI Activated?
; var(21) = ID of nearest enemy
; var(22) = Random (changed every time a move hits)
; var(59) = AI was active
[Data]
;Amount of life to start with
;体力ゲージの初期値
life = 1000
power = 9000
;attack power (more is stronger)
;攻撃ダメージ
attack = 100
;defensive power (more is stronger)
;体力パワー
defence = 100
;Percentage to increase defense everytime player is knocked down
fall.defence_up = 50
;Time which player lies down for, before getting up
liedown.time = 40
;Number of points for juggling
airjuggle = 15
;Default hit spark number for HitDefs
sparkno = 2
;Default guard spark number
guard.sparkno = 40
;1 to enable echo on KO
KO.echo = 0
;Volume offset (negative for softer)
volume = 0
;Variables with this index and above will not have their values
;reset to 0 between rounds or matches. There are 60 int variables,
;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
;If omitted, then it defaults to 60 and 40 for integer and float
;variables repectively, meaning that none are persistent, i.e. all
;are reset. If you want your variables to persist between matches,
;you need to override state 5900 from common1.cns.
IntPersistIndex = 59
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 19     ;Player width (back, ground)
ground.front = 19    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
height = 60      ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = 30, -58   ;Approximate position of head
mid.pos = -2, -40    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 3.1      ;Walk forward
walk.back = -2.8     ;Walk backward
run.fwd  = 4.6, 0    ;Run forward (x, y)
run.back = -4.5,-3.8 ;Hop backward (x, y)
jump.neu = 0,-8.8    ;Neutral jumping velocity (x, y)
jump.back = -3.5    ;Jump back Speed (x, y)
jump.fwd = 3.2      ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-8.1      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .52         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = ChangeAnim
trigger1 = time = 0
value = ifelse(random <= 499, 170, 171)

;---------------------------------------------------------------------------
; Win state decider
[Statedef 180]
type = S

[State 180, 1]
type = VarRandom
trigger1 = time = 0
v = 0
range = 1, 1200

[State 180, a]
type = StopSnd
trigger1 = time = 0
channel = 0

[State 180, 1]
type = ChangeState
trigger1 = command = "holdx"
trigger2 = time = 1
trigger2 = var(0) <= 200
value = 181

[State 180, 2]
type = ChangeState
trigger1 = command = "holdy"
trigger2 = time = 1
trigger2 = var(0) > 200
trigger2 = var(0) <= 400
value = 182

[State 180, 3]
type = ChangeState
trigger1 = command = "holdz"
trigger2 = time = 1
trigger2 = var(0) > 400
trigger2 = var(0) <= 600
value = 183

[State 180, 4]
type = ChangeState
trigger1 = command = "holda"
trigger2 = time = 1
trigger2 = var(0) > 600
trigger2 = var(0) <= 800
value = 184

[State 180, 5]
type = ChangeState
trigger1 = command = "holdb"
trigger2 = time = 1
trigger2 = var(0) > 800
trigger2 = var(0) <= 1000
value = 185

[State 180, 6]
type = ChangeState
trigger1 = command = "holdc"
trigger2 = time = 1
trigger2 = var(0) > 1000
trigger2 = var(0) <= 1200
value = 186

;---------------------------------------------------------------------------
; Win pose: Tsk Tsk Tsk
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 181, 2]
type = PlaySnd
trigger1 = AnimElem = 4
value = 3, 7

[State 181, 3]
type = AssertSpecial
trigger1 = time < 300
flag = RoundNotOver

