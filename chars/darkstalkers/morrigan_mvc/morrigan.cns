;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundno = 1
value = 0
last = const(data.IntPersistIndex) - 1

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundno = 1
fvalue = 0

[State 5900, 3] ;Intro
type = ChangeState
trigger1 = roundno = 1
value = 190

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, Hurt Sound]
type = PlaySnd
triggerall = random < 333
triggerall = time = 1
trigger1 = stateno = 5000
trigger2 = stateno = 5010
trigger3 = stateno = 5020
value = 5000,2

[State -3, Remove Stand Spark]
type = RemoveExplod
trigger1 = NumExplod(4040) != 0
trigger1 = StateNo != 0
ID = 4040

[State -3, Turn On Camera]
type = VarSet
trigger1 = StateType != A
trigger2 = MoveType = H
v = 3
value = 0

[State -3, Hit Down Camera]
type = ScreenBound
trigger1 = var(3) = 1
value = 1
movecamera = 1,0

[State -3, Remove AfterImage on Hit]
type = AfterImageTime
trigger1 = MoveType = H
time = 0

[State -3, Turn During Air Guard]
type = Turn
trigger1 = StateNo = 132
trigger1 = P2Dist X < 0
trigger1 = var(2) = 1

[State -3, Go To Super Jump State]
type = ChangeState
trigger1 = var(2) = 1
trigger1 = StateNo = 51
value = 112

[State -3, 4]
type = DisplayToClipboard
trigger1 = 1
text="var(59) = %d, var(58) = %d, P2BodyDist X = %f, P2BodyDist Y = %f"
params = var(59), var(58), P2BodyDist X, P2BodyDist Y
ignorehitpause = 1

