trigger1 = AnimElem = 2, = 0
value = 190,0
channel = 0

[State 191, 6]
type = ChangeAnim
trigger1 = Anim = 191
trigger1 = NumHelper(193) = 0
value = 192

[State 191, 7] ;Change to stand state when done
