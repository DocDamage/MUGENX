;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = N
anim = 100
sprpriority = 1

[State 100, 1] ;Jet Sound
type = PlaySnd
trigger1 = Time = 1
value = 100, 0

[State 100, 3]
type = VelSet
trigger1 = Time = 1
x = const(velocity.run.fwd.x)

[State 100, 4]
type = VelAdd
trigger1 = Time > 1
trigger1 = Vel X > 0
x = -const(velocity.run.fwd.x)/30.0

[State 100, 5]
type = VelSet
trigger1 = Time > 1
trigger1 = Vel X < 0
x = 0

[State 100, 6] ;Dash Sparks
type = explod
trigger1 = Time % 2 = 0
anim := 4100 + (Time % 8) / 2
pos = -20,-45
vel = -4
random = 12,60
sprpriority = 7
ownpal = 1

[State 100, 8] ;Slide Dust
type = explod
trigger1 = Time % 5 = 0
anim := 4018
sprpriority = 5
ownpal = 1

[State 100, 8] ;Sliding
type = ChangeAnim
trigger1 = Time = 13
value = 101

[State 100, 9] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 10] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 11]
type = ChangeState
trigger1 = Anim = 101
trigger1 = AnimTime = 0
value = 0

