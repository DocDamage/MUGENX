; Definition file for Morrigan
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Morrigan"           ;Name of character
displayname = "Morrigan"    ;Name of character to display
versiondate = 04,14,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "Thomas Hsieh"     ;Character author name
pal.defaults = 1,2,3,4      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = morrigan.cmd   ;Command set
cns     = morrigan.cns   ;Constants
st      = morrigan.cns   ;States
stcommon = common1.cns ;Common states
sprite  = morrigan.sff   ;Sprite
anim    = morrigan.air   ;Animation
sound   = morrigan.snd   ;Sound
pal1    = morrigan4.act  ;Palettes (can have up to 12)
pal4    = morrigan1.act
pal7    = morrigan1.act
pal10    = morrigan7.act
