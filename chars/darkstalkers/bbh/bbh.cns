; Combo Ranking (by Kamek)
[State -2, Set Up For Count]
type = VarSet
trigger1 = p2movetype = H
trigger1 = !Var(15)
v = 15
value = 1

[State -2, Keep Track Of Hit Count]
type = VarSet
trigger1 = UniqHitCount > 0
trigger1 = Var(15)
v = 16
value = UniqHitCount

[State -2, Add To Total Hit Count]
type = VarSet
triggerall = Var(15)
trigger1 = UniqHitCount < Var(16)
trigger2 = p2movetype != H
v = 17
value = Var(17) + Var(16)

[State -2, Add Helper Hits To Total Hit Count]
type = VarSet
triggerall = Var(15)
trigger1 = Var(19) != 0
trigger2 = p2movetype != H
v = 17
value = Var(17) + Var(19)

[State -2, Keep Track of Helper Hit Count]
type = VarSet
trigger1 = Var(19) != 0
trigger1 = Var(15)
v = 19
value = 0

[State -2, Projectile Hits]
type = VarSet
triggerall = Var(15)
trigger1 = ProjHit = 1
v = 17
value = Var(17) + 1

[State -2, Reset Current Hit Count]
type = VarSet
trigger1 = UniqHitCount < Var(16)
trigger1 = Var(15)
v = 16
value = UniqHitCount

[State -2, Combo Is Finished]
type = VarSet
triggerall = Var(15)
trigger1 = p2movetype != H
trigger2 = movetype = H
trigger3 = (enemy, stateno = 5150) && (enemy, alive = 0)
v = 16
value = 0

[State -2, Combo Is Finished]
type = Helper
triggerall = Var(15)
triggerall = Var(17) > 0
triggerall = !NumHelper(9200)
trigger1 = p2movetype != H
trigger2 = movetype = H
trigger3 = (enemy, stateno = 5150) && (enemy, alive = 0)
name = "Combo Ranker"
ID = 9200
stateno = 9200

[State -2, Reset]
type = VarSet
triggerall = Var(15)
trigger1 = p2movetype != H
trigger2 = movetype = H
trigger3 = (enemy, stateno = 5150) && (enemy, alive = 0)
v = 15
value = 0

[State -2, Reset]
type = VarSet
trigger1 = p2movetype != H
trigger2 = movetype = H
trigger3 = (enemy, stateno = 5150) && (enemy, alive = 0)
v = 14
value = 0

