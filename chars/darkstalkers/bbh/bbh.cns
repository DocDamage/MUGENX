; BUTTERFLY ENGINE
[Statedef 8000]
type    = A
movetype= I
sprpriority = 5

[State 8000, Wander]
type = VelSet
trigger1 = time = 0
x = ((random / 333) - 1.5)
y = ((random / 333) - 1.5)

[State 8000, Too Far X]
type = VelSet
trigger1 = time = 0
trigger1 = RootDist X < -10 || RootDist X > 10
x = (RootDist X) / 30

[State 8000, Too Far Y]
type = VelSet
trigger1 = time = 0
trigger1 = RootDist Y < 60 || RootDist Y > 80
y = (RootDist Y - 70) / 30

[State 8000, Right Face]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X > .5
trigger1 = Anim != 8000
value = 8000

[State 8000, Front Face]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X = [-.5,.5]
trigger1 = Anim != 8001
value = 8001

[State 8000, Left Face]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X < -.5
trigger1 = Anim != 8002
value = 8002

[State 8000, Loop]
type = ChangeState
trigger1 = Time = 10
value = 8000

