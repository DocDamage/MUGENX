trigger1 = Time = 5
value = 50
ctrl = 1

; JUMP_UP (short & long)
[Statedef 2041]
type    = A
physics = A
ctrl = 1
velset = 0,0

[State 2041, -0.1] ;Holding up?
type = VelSet
trigger1 = Time = 0
trigger1 = command = "holdup"
y = const(velocity.jump.y)

[State 2041, -0.2]
type = VelSet
trigger1 = Time = 0
trigger1 = command != "holdup"
y = (const(velocity.jump.y) + 3)

[State 2041, 0.1]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(10) = 1
x = const(velocity.jump.fwd.x)

[State 2041, 0.1b]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(10) = 2
x = const(velocity.runjump.fwd.x)

[State 2041, 0.2]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(10) = -1
x = const(velocity.jump.back.x)

[State 2041, 0.2b]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(10) = -2
x = const(velocity.runjump.back.x)

[State 2041, 1.1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X = 0
trigger1 = command = "holdup"
value = 41

[State 2041, 1.2] ;Short
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X = 0
trigger1 = command != "holdup"
value = 2041

[State 2041, 2.1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X > 0
trigger1 = command = "holdup"
value = 42

[State 2041, 2.2] ;Short
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X > 0
trigger1 = command != "holdup"
value = 2041

[State 2041, 3.1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X < 0
trigger1 = command = "holdup"
value = 43

[State 2041, 3.2] ;Short
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X < 0
trigger1 = command != "holdup"
value = 2042

[State 2041, 4]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
trigger1 = Anim != 2041 && Anim != 2042
persistent = 0
value = Anim + 3

