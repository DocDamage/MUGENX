;---------------------------------------------------------------------------
; States that are always checked in self's rc (use -3) :
;---------------------------------------------------------------------------
[Statedef -3]

; Play sound when recovering in air or on ground
[State -3, 1]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 5201
trigger2 = stateno = 5210
value = S1,11
channel = 0

; "Ow" sound randomizer
[State -3, 1]
type = VarRandom
trigger1 = alive
v = 8

; Play "ugh" sound when hit
[State -3, Ow Sound]
type = PlaySnd
triggerall = Time = 1
triggerall = alive
triggerall = var(8) < 500
trigger1 = stateno = 5001 || stateno = 5011
trigger1 = (anim % 10) != 0 ;Not hit light
trigger1 = random < ifelse ((anim % 10) = 1, 400, 750)
trigger2 = stateno = 5040 || stateno = 5050
trigger2 = random < 500
trigger3 = stateno = 5070
trigger4 = stateno = 5100 && random < 250
value = S1,12
channel = 0

; Play "ahh" sound when hit
[State -3, Ow Sound]
type = PlaySnd
triggerall = Time = 1
triggerall = alive
triggerall = var(8) >= 500
trigger1 = stateno = 5001 || stateno = 5011
trigger1 = (anim % 10) != 0 ;Not hit light
trigger1 = random < ifelse ((anim % 10) = 1, 400, 750)
trigger2 = stateno = 5040 || stateno = 5050
trigger2 = random < 500
trigger3 = stateno = 5070
trigger4 = stateno = 5100 && random < 250
value = S1,13
channel = 0

