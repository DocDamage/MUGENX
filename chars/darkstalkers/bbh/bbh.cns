; Baby Bonnie Hood's constants, the heart of the entire lot.
; Written by Baby Bonnie Hood (bbhood21@yahoo.com)
; Format (case insensitive):
;  [groupname]        
;  constname = value  

[Data]
life = 1000            ;Amount of life to start with
attack = 100           ;100% attack power (more is stronger)
defence = 95           ;95% defensive power (more is stronger)
fall.defence_up = 50   ;Def goes up by 50% everytime player is hit on ground
liedown.time = 60      ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 15         ;Can do 15 points of juggling
KO.echo = 0            ;1 to enable echo on KO
volume = 0             ;Volume offset (negative for softer)
IntPersistIndex = 58   ;Variables with this index and above will not have
FloatPersistIndex = 40 ;their values reset to 0 between rounds or matches.

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 15     ;Player width (back, ground)
ground.front = 15    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
z.width = 3          ;Player width (into and out)
height = 60	         ;Height of player (for opponent to jump over)
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = -5, -90   ;Approximate position of head
mid.pos = -5, -60    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow

[Velocity]
walk.fwd  = 2.8      ;Walk forward
walk.back = -2.7     ;Walk backward
run.fwd  = 6, 0      ;Run forward (x, y)  - if y<0, player will hop
run.back = -5.8, 0   ;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-8.8    ;Neutral jumping velocity (x, y)
jump.back = -2.9     ;Jump back Speed (x, y)
jump.fwd = 2.85      ;Jump forward Speed (x, y)
runjump.back = -5.8,-8.8   ;Running jump speeds (opt)
runjump.fwd = 6,-8.8       ;.
airjump.neu = 0,-8.8       ;.
airjump.back = -2.9,-8.8   ;Air jump speeds (opt)
airjump.fwd = 2.85,-8.8    ;.

[Movement]
airjump.num = 1       ;Number of air jumps allowed (opt)
airjump.height = 35   ;Minimum distance from ground before you can air jump (opt)
yaccel = .43          ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 5900, Var]
type = VarSet
trigger1 = matchno != Var(58)
var(59) = 0

[State 5900, Turns]
type = ChangeState
trigger1 = (roundno != 1) && (Var(59) != 1)
value = 7125

[State 5900, Stand]
type = ChangeState
trigger1 = roundno != 1
value = 0

[State 5900, Intro]
type = ChangeState
trigger1 = roundno = 1
value = 190

;---------------------------------------------------------------------------
; LOSE (Determiner)
[Statedef 170]
type = S

[State 170, Select]
type = VarRandom
trigger1 = time >= 0
v = 1
range = 0,100

[State 170, 1]
type = ChangeState
trigger1 = Var(1) < 25
value = 171

[State 170, 2]
type = ChangeState
trigger1 = Var(1) = [25,50]
value = 172

[State 170, 3]
type = ChangeState
trigger1 = Var(1) = [50,75]
value = 173

[State 170, 4]
type = ChangeState
trigger1 = Var(1) > 75
value = 174

;---------------------------------------------------------------------------
; LOSE 1
[Statedef 171]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 171, Assert]     ;Assert this until you want the round to end
type     = AssertSpecial
trigger1 = Time = [0,170]
flag     = roundnotover

[State 171, Speech]
type = PlaySnd
trigger1 = Time = 15
value = S1,14
channel = 0

[State 171, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

