; Definition file for Baby Bonnie Hood
; Contains all the filenames needed for the character, yada yada...
; Written by Baby Bonnie Hood (bbhood21@yahoo.com)

; Character information
[Info]
name    = "B.B. Hood"               ;Bulleta to you Japanese people
versiondate = 10,19,2001                   ;The last time I worked on her
mugenversion = 04,14,2001                  ;For MUGEN 2001.04.14 only
author = "Baby Bonnie Hood"                ;That's my name :)
pal.defaults = 4,1,5,2,6,3,10,7,11,8,12,9  ;Default palettes in order of preference

; Files for the character
[Files]
cmd      = bbh.cmd        ;Command set (her moves)
cns      = bbh.cns        ;Constants (the center of things)
st       = bbh.cns        ;States (another center of things)
stcommon = common1.cns    ;Common states (MUGEN defaults)
sprite   = bbh.sff        ;Sprite (her cute self)
anim     = bbh.air        ;Animation (how she moves)
sound    = bbh.snd        ;Sound (her voices)
pal4     = red.act        ;Palettes (red; normal)
pal1     = cyan.act       ;Palettes (cyan; mirror)
pal5     = orange.act     ;Palettes (orange)
pal2     = green.act      ;Palettes (green)
pal6     = pink.act       ;Palettes (pink)
pal3     = blue.act       ;Palettes (blue)
;pal10    = yakko.act      ;Palettes (dark blue; ever watch Akazukin ChaCha?)
;pal7     = b&w.act        ;Palettes (black & white; yuck! :p )
;pal11    = violet.act     ;Palettes (violet; MvC2)
;pal8     = winter.act     ;Palettes (bright cyan; MvC2)
;pal12    = blue2.act      ;Palettes (blue again; MvC2)
;pal9     = dark.act       ;Palettes (dark BBH, BWAHAHAHAHAHAHAHA!!! >:) ; MvC2)

; More palettes!!! (too bad MUGEN can only handle 12 at a time :\)
pal10    = kuangshi.act   ;Palettes (Hsien-Ko style)
pal7     = silent.act     ;Palettes (Silent Storm style lol lmao!!1)
pal11    = gold.act       ;Palettes (gold)
pal8     = evil.act       ;Palettes (evil BBH >:) )
