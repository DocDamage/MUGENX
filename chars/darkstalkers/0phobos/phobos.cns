physics = A
velset = 0, -9.5
ctrl = 1

[State 41, 13]
type = playsnd
trigger1 = Time = 1
value = 40,0
volume = 255

[State 41, 0] ;Holding up?
type = VelSet
trigger1 = Time = 0
trigger1 = Var(11) != 1
trigger1 = Var(11) != -1
y = -9.5

[State 41, 2]
type = VelSet
triggerall = var(10) <= 1
trigger1 = Time >= 0
trigger1 = Var(11) = -1
x = -2.5

[State 41, 1]
type = VelSet
triggerall = var(10) <= 1
trigger1 = Time >= 0
trigger1 = Var(11) = 1
x = 2.5

[State 41, 3]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X = 0
value = 41

[State 41, 4]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X > 0
value = 42

[State 41, 5]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X < 0
value = 43

