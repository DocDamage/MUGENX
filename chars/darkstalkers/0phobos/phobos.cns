;var(8) 불타는 소리
;var(9) 점프후 반복정지 막음
;var(10) 공중체류
;var(11) 점프관련

[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 26
ground.front = 25
air.back = 37
air.front = 14
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -90
mid.pos = -5, -60
shadowoffset = -7
draw.offset = 0, 0

[Velocity]
walk.fwd  = 2.4
walk.back = -2
run.fwd  = 4.6, 0
run.back = -4.5, 0
jump.neu = 0,-9.5
jump.back = -2.5
jump.fwd  =  2.5
runjump.back = -2.5 ,-8.1
runjump.fwd = 4,-8.1
airjump.neu = 0,-8.1
airjump.back = -2.55
airjump.fwd = 2.5

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .46
stand.friction = .85
crouch.friction = .82

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; Walk
[Statedef 22]
type    = C
physics = C
sprpriority = -1
ctrl = 1

[State 22, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 22, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 22, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 23 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 23

[State 22, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 24 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 24


[State 22, 1]
type = changestate
trigger1 = command != "holdfwd"
value = 11

[State 22, 1]
type = changestate
trigger1 = command != "holddown"
value = 12


; Walk back
[Statedef 23]
type    = C
physics = C
sprpriority = -1
ctrl = 1

[State 23, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 23, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 23, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 23 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 23

[State 22, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 24 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 24


[State 22, 1]
type = changestate
trigger1 = command != "holdback"
value = 11

[State 22, 1]
type = changestate
trigger1 = command != "holddown"
value = 12


