;---------------------------------------------------------------------------
;===========================================================================
;　　アナカリス　　　　　　　　　　　　　　　　　　　　　　　　Ｂｙ　参号(Third)
;===========================================================================
;---------------------------------------------------------------------------
;===========================================================================
;Var設定
;1.ホバリング判定用
;2.浮遊回数制限用
;3.ホバリング時ガード判定用
;4.挑発回数制限用
;5.バグ技判定用
;6.チェーンコンボ判定用
;7.コンボヒット数判定用
;8.方向判定用
;9.状態判定用
;10.フィニッシュ判定用
;11.ジャンプキック攻撃ヒット時の判定用
;12･咎めの穴判定用
;13.ES必殺技判定用
;14.EX必殺技判定用
;15.戒めの墓碑回数制限用
;16.ミイラドロップスイング回数決定用
;17.ミイラドロップヒット判定用
;18.ES版ミイラドロップタイムカウント用
;19.言霊返し判定用
;20.対戦キャラ判定用
;21.王家の裁きタイムカウント用
;22.ダッシュ攻撃分割用
;23.ダークフォースカウント用
;24.乗っかりカイビト判定用
;25.ファラオスプリット下半身方向判定用
;26.ファラオスプリット下半身硬直時間判定用
;29.CPUか否かの判定用
;30.CPUか否かの判定用
;31.CPUのルーチン決定用
;32.発狂モード判定用
;===========================================================================
;---------------------------------------------------------------------------
; キャラクター基準値の設定

[Data]
life = 1000          ;スタート時の体力総計
power = 9000         ;パワーゲージの上限
attack = 100         ;攻撃力パーセンテージ （多いほど強くなります Def:100%）
defence = 100        ;防御力パーセンテージ （多いほど強くなります Def:100%）
fall.defence_up = 50 ;ダウン時に攻撃された時に一時的に上がる防御力のパーセンテージ
liedown.time = 30    ;ダウンしてから起き上がるまでの時間
airjuggle = 15       ;ジャグリングポイント数
sparkno = -1         ;ディフォルトのスパーク番号
guard.sparkno = -1   ;ガード時のディフォルトスパーク番号
KO.echo = 0          ;1にするとKOされた時に声にエコーがかかります
volume = 250         ;SNDの基本値

;---------------------------------------------------------------------------
; サイズ指定

[Size]
xscale = 1            ;水平方向の縮尺
yscale = 1            ;垂直方向の縮尺
ground.back = 25      ;キャラクターの幅（後方、地上）
ground.front = 25     ;キャラクターの幅（前方、地上）
air.back = 34         ;キャラクターの幅（後方、空中）
air.front = 34        ;キャラクターの幅（前方、空中）
z.width = 3           ;Player width (into and out)（現在使用されていないと思われます）
height = 80           ;キャラクターの高さ
attack.width = 4,4    ;Default attack width: back, front（現在使用されていないと思われます）
attack.dist = 40      ;攻撃時に相手がガード体勢に入る最低距離（最大320）
proj.attack.dist =120 ;相手がガード体勢に入る発射物との最低距離（最大320） 
proj.doscale = 0      ;xscale, yscaleの設定が発射物にも有効かどうかの設定（1なら有効です）
head.pos = 8,-101     ;頭の大体の座標（BindToTarget使用時に必要です。）
mid.pos = 0,-68       ;体中心の大体の座標（BindToTarget使用時に必要です。）
shadowoffset = 0      ;影の垂直方向オフセット

;---------------------------------------------------------------------------
; 移動速度の設定

[Velocity] 
walk.fwd  = 4.5            ;前に歩く時の速度
walk.back = -4             ;後ろに歩く時の速度
run.fwd  = 5,9             ;前に走る時の速度 (x, y) ホップさせる時は y を 0 以下にします
run.back = -5,9            ;後ろに走る時の速度 (x, y) 走らせる時は y を 0 にします
jump.neu = 0,-5.5          ;ジャンプ時の垂直移動速度 (x, y)
airjump.neu = 0,-4.5       ;空中ジャンプ時の垂直移動速度 (x, y)
jump.back = -2.5,-4        ;後ろにジャンプした時の水平移動速度
jump.fwd = 2.5,-4          ;前にジャンプした時の水平移動速度
runjump.back = -2.5,-6     ;後ろに走りながらのジャンプ時の速度指定 (オプション)
runjump.fwd = 2.5,-6       ;前に走りながらのジャンプ時の速度指定 (オプション)

;---------------------------------------------------------------------------
; 動作の設定

[Movement]
airjump.num = 0       ;空中ジャンプの回数 （オプション）
airjump.height = 20   ;空中ジャンプに必要な最低限の高さ （オプション）
yaccel = .46          ;垂直方向にかかる加速度（重力）
stand.friction = .92  ;立ち状態の摩擦係数
crouch.friction = .92 ;しゃがみ状態の摩擦係数

;===========================================================================
;　演出系
;===========================================================================
;---------------------------------------------------------------------------
;敗北(タイムオーバー時)
[Statedef 170]
type = S
anim = 170
ctrl = 0
velset = 0,0

[State 170, 1]
type = AssertSpecial
trigger1 = Time = [0,200]
flag = RoundNotOver

[State 170, 2]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

