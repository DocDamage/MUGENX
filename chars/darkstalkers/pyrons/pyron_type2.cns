[State -2, special]
type = AssertSpecial
trigger1 = fvar(5) >= 0 && Var(20) = 1
flag = noFG

[State -2, change]
type = ChangeState
triggerall = fvar(5) <= 0 && Var(20) = 1
triggerall = statetype = S || statetype = C
trigger1 = ctrl
trigger2 = stateno = 200
trigger2 = time >= 9
trigger3 = stateno = 230
trigger3 = time >= 9
trigger4 = (stateno = 400) || (stateno = 430)
trigger4 = time >= 6
value = 1131

[State -2, change]
type = varset
trigger1 = (RoundState = 3) || (RoundState = 4)
trigger2 = life <= 0
v = 20
value = 0

[State -2, Pal]
type = PalFX
trigger1 = Var(20) = 1 && fvar(5) >= 0
time = 1
add = 45, 45, 0
ignorehitpause = 1

; 현재 X좌표 위치
[State -2, debug]
type = DisplayToClipboard
trigger1 = 1
text = "posx = %f"
params = Pos X

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
value = 40, 0

;다크 포스 시간
[State -3, varset]
type = varset
trigger1 = RoundState = 1
fvar(5) = 500
