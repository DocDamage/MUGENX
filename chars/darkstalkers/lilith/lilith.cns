; Lilith's CNS file
; Written by Baby Bonnie Hood (bbhood21@yahoo.com)

; Var list:
; var(0)  = AI condition
; var(1)  = generic determiner
; var(2)  = generic determiner
; var(3)  = generic determiner
; var(6)  = dark force condition
; var(7)  = dark force timer
; var(8)  = ow sound determiner
; var(9)  = multi-hit counter
; var(10) = jump determiner
; var(11) = short jump determiner
; var(12) = push block counter
; var(20) = GPS stuff
; var(21) = GPS stuff
; var(22) = GPS stuff
; var(59) = AI on for entire match

[Data]
life = 1000            ;Amount of life to start with
power = 9000           ;Maximum power level
attack = 100           ;100% attack power (more is stronger)
defence = 100          ;100% defensive power (more is stronger)
fall.defence_up = 50   ;Def goes up by 50% everytime player is hit on ground
liedown.time = 60      ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 15         ;Can do 15 points of juggling
guard.sparkno = 40     ;Default guard spark number
KO.echo = 0            ;1 to enable echo on KO
volume = 0             ;Volume offset (negative for softer)
IntPersistIndex = 58   ;Variables with this index and above will not have
FloatPersistIndex = 40 ;their values reset to 0 between rounds or matches.

[Size]
xscale = 1            ;Horizontal scaling factor.
yscale = 1            ;Vertical scaling factor.
ground.back = 15      ;Player width (back, ground)
ground.front = 15     ;Player width (front, ground)
air.back = 12         ;Player width (back, air)
air.front = 12        ;Player width (front, air)
z.width = 3           ;Player width (into and out)
height = 60	      ;Height of player (for opponent to jump over)
attack.width = 4,4    ;Default attack width: back, front
attack.dist = 160     ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0      ;Set to 1 to scale projectiles too   
head.pos = 0, -90     ;Approximate position of head
mid.pos = 0, -60      ;Approximate position of midsection
shadowoffset = 0      ;Number of pixels to vertically offset the shadow

[Velocity]
walk.fwd  = 3.3            ;Walk forward
walk.back = -3             ;Walk backward
run.fwd  = 5.5, 0          ;Run forward (x, y)  - if y<0, player will hop
run.back = -5, 0           ;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-8            ;Neutral jumping velocity (x, y)
jump.back = -3             ;Jump back Speed (x, y)
jump.fwd = 3.3             ;Jump forward Speed (x, y)
runjump.back = -5,-8       ;Running jump speeds (opt)
runjump.fwd = 5.5,-8       ;.

[Movement]
yaccel = .43          ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Initialize (start of round)
[Statedef 5900]
type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundno = 1
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundno = 1
fvalue = 0

[State 5900, 3]
type = VarSet
trigger1 = var(59) > 0
var(0) = var(59)

[State 5900, 4] ;Intro
type = ChangeState
trigger1 = roundno = 1
value = 190

[State 5900, 5] ;Turns mode Intro
type = ChangeState
trigger1 = roundsexisted = 0
trigger1 = teammode = Turns
value = 198

;---------------------------------------------------------------------------
; LOSE
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = AssertSpecial
trigger1 = Time = [0,150]
flag = RoundNotOver

[State 170, 2]
type = PlaySnd
trigger1 = AnimElem = 3
value = S1,0
channel = 0

[State 170, 3]
type = NotHitBy
trigger1 = 1
value = SCA

;---------------------------------------------------------------------------
; WIN (Determiner)
[Statedef 180]
type = S
anim = 0

[State 180, Assert]
type     = AssertSpecial
trigger1 = 1
flag     = roundnotover

[State 180, Random]
type = VarRandom
trigger1 = time >= 0
v = 1
range = 1,6

[State 180, Select]
type = VarSet
trigger1 = command = "hold_x"
v = 1
value = 1

[State 180, Select]
type = VarSet
trigger1 = command = "hold_y"
v = 1
value = 2

[State 180, Select]
type = VarSet
trigger1 = command = "hold_z"
v = 1
value = 3

[State 180, Select]
type = VarSet
trigger1 = command = "hold_a"
v = 1
value = 4

[State 180, Select]
type = VarSet
trigger1 = command = "hold_b"
v = 1
value = 5

[State 180, Select]
type = VarSet
trigger1 = command = "hold_c"
v = 1
value = 6

[State 180, Win]
type = ChangeState
trigger1 = Var(1) <= 2
value = 180 + var(1)

[State 180, Win]
type = ChangeState
trigger1 = Var(1) > 2
value = 184

