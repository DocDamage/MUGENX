; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, Turn]
type = Turn
trigger1 = p2dist X < 0

[State 40, 0.0a]
type = VarSet
trigger1 = Time = 0
var(10) = 0

[State 40, 0.0b]
type = VarSet
trigger1 = Time = 0
var(11) = 0

[State 40, 0.1]
type = VarSet
trigger1 = command = "holdfwd"
trigger1 = var(10) != 2
var(10) = 1

[State 40, 0.2]
type = VarSet
trigger1 = command = "holdback"
trigger1 = var(10) != -2
var(10) = -1

[State 40, 0.1b]
type = VarSet
triggerall = Time = 0
triggerall = command = "holdfwd"
trigger1 = command = "longjump"
trigger2 = prevstateno = 100 ;RUN_FWD
var(10) = 2

[State 40, 0.2b]
type = VarSet
triggerall = Time = 0
triggerall = command = "holdback"
trigger1 = command = "longjump"
trigger2 = prevstateno = 105 ;RUN_BACK
var(10) = -2

[State 40, 4]
type = ChangeState
triggerall = AnimTime = 0
trigger1 = var(10) != 0
trigger1 = var(10) != 1
trigger1 = var(10) != -1
trigger1 = command = "holdup"
trigger2 = command != "holdup"
value = 2041

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(var(10)=0, const(velocity.jump.neu.x), ifelse(var(10)>0, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

; Jump Up (normal)
[Statedef 50]
type    = A
physics = A

[State 50, SFX]
type = PlaySnd
triggerall = Time = 0
trigger1 = prevstateno = 40
value = S0,1
channel = 3

[State 50, 1]
type = VarSet
trigger1 = Time = 0
var(10) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

