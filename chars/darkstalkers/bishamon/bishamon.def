;毘沙門　　　　　　by　３㌶
[Info]
name = "Bishamon"        ;キャラの名前
displayname = "Bishamon" ;表示されるキャラの名前
versiondate = 06,16,2001    ;キャラの更新情報
mugenversion = 04,14,2001   ;キャラが動くmugenのバージョン
author = "3ha"              ;キャラの製作者名
pal.defaults = 4,5,6,1,2      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = bishamon.cmd    ;キャラのコマンド
cns     = bishamon.cns    ;キャラのプログラム
st      = bishamon.cns    ;キャラのプログラム
st1     = tama.cns ;キャラのプログラム
st2     = blodia.cns
st3     = bit.cns
st4     = galford.cns
st5     = papy.cns
stcommon = common1.cns 
sprite  = bishamon.sff    ;キャラの絵
anim    = bishamon.air    ;キャラの動き
sound   = bishamon.snd    ;キャラの音
pal1    = act/bishamon4.act
pal2    = act/bishamon5.act
pal3    = act/bishamon6.act
pal4    = act/bishamon.act
pal5    = act/bishamon2.act
pal6    = act/bishamon3.act
pal7    = act/bishamon7.act
pal8    = act/bishamon7.act
pal9    = act/bishamon7.act
pal10   = act/bishamon8.act
pal11   = act/bishamon8.act
pal12   = act/bishamon8.act