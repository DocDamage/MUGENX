;毘沙門
;---------------------------------------------
;v=2 強弱判定
;v=3 ＨＩＴ判定
;v=4 魂寄せ
;v=5 辻疾風ＥＳ
;v=6 魂
;v=7 鬼火
;v=8 鬼首捻り
;v=9 ＧＣ判定
;v=10 リバーサルカウント
;v=11 点滅
;v=12 点滅
;v=13 向き判定
;v=14 斬り返し
;v=15 ガトリングロッド
;v=16 ブレイクシャフト
;v=17 ビットカウント
;v=18 メガクラッシュ
;v=19 パピー唸る
;v=20 パイロット
;v=21 パイロット
;v=22 怒りモード
;v=23 怒りゲージ
;v=24 怒りゲージ
;v=25 パピー
;v=26 パピー

;------------------------------------------------
[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 21,26
FloatPersistIndex = 40

[Size]
xscale = 1           ;水平方向の縮尺（通常１）
yscale = 1           ;垂直方向の縮尺（通常１）
ground.back = 17     ;キャラの幅(後方,地上)
ground.front = 19    ;キャラの幅(前方,地上)
air.back = 17        ;キャラの幅(後方,空中)
air.front = 19       ;キャラの幅(前方,空中)
height = 60          ;キャラの高さ
attack.dist = 160    ;攻撃をした時相手がガード体制に入る最低距離
proj.attack.dist = 90;攻撃をした時相手がガード体制に入る最低距離（飛び道具）
proj.doscale = 1     ;上で設定した縮尺を飛び道具にも適用するか（１でＯＮ）   
head.pos = -3, -90   ;頭の大体の座標
mid.pos = 0, -60     ;体の中心の大体の座標
shadowoffset = 0     ;影の垂直方向のオフセット
draw.offset = 0,0    ;使用しない

[Velocity]
walk.fwd  = 2.3      ;前進の速度
walk.back = -2.3     ;後退の速度
run.fwd  = 7.2, 0    ;前ダッシュの速度（ホップする時はyを-にする）
run.back = -5,-5.5　 ;後ダッシュの速度（ホップする時はyを-にする）
jump.neu = 0,-8.8    ;垂直ジャンプの速度
jump.back = -2.7     ;後ジャンプの速度
jump.fwd = 2.7       ;前ジャンプの速度
runjump.back = -2.55,-8.1 ;後ダッシュしながらのジャンプ速度(オプション)
runjump.fwd = 4,-8.8      ;前ダッシュしながらのジャンプ速度(オプション)
airjump.neu = 0,-8.8      ;２段ジャンプ以降の垂直ジャンプの速度(オプション)
airjump.back = -2.55      ;２段ジャンプ以降の後ジャンプの速度(オプション)
airjump.fwd = 2.5         ;２段ジャンプ以降の前ジャンプの速度

[Movement]
airjump.num = 0      ;空中でジャンプする回数
airjump.height = 35  ;空中でジャンプする最低限の高さ
yaccel = .48         ;重力
stand.friction = .86  ;立ち状態の摩擦係数
crouch.friction = .83 ;屈み状態の摩擦係数

;---------------------------------------------------------------------------
; ステイトの解説
; [Statedef STATENO]
; type = ?      S/C/A/L  Ｓ：立ち/Ｃ：屈み/Ａ：空中/Ｌ：ダウン
; movetype = ?  I/A/H    Ｉ：通常状態/Ａ：攻撃状態/Ｈ：ダメージをくらってる状態
; physics = ?   S/C/A/N  Ｓ：立ち/Ｃ：屈み/Ａ：空中/Ｎ：無し
; juggle = ?             その攻撃に使うジャグル数
;




;------------------------------------------------------
;普通のジャンプ
[Statedef 50]
type = A
physics = A

;下の50,0は三角跳びには関係ありませんが、
;空中戦主体のキャラは追加しておくと便利です。
[State 50, 0]
type = turn
trigger1 = time = 0
trigger1 = p2dist x < 0

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

;相手の方向にある画面端で、後ろと上を押しっぱなしにすると
;画面中央の方向に向き直ります。
[State 50, 4]
type = Turn
triggerall = frontedgebodydist < 3
triggerall = pos y < -12
triggerall = var(20) = 2
trigger1 = command = "holdup"
trigger1 = command = "holdback"

;どちらかの画面端で｢上と画面中央に向かった方向｣の
;同時押しで、三角跳び専用ステイトへ。
[State 50, 5]
type = ChangeState
triggerall = backedgebodydist < 3
triggerall = pos y < -12
triggerall = var(20) = 2
trigger1 = command = "holdup"
trigger1 = command = "holdfwd"
value = 53

;------------------------------------------------------
;三角跳び
;　commonで使われていないステイトなので、
;　ここで使っちゃいましょう！
[Statedef 53]
type = A
physics = A
anim = 42

[State 53, 1]
type = velset
trigger1 = time < 2
x = 0
y = 0

[State 53, 2]
type = VelSet
trigger1 = Time = 2
x = const(velocity.airjump.fwd.x)
y = const(velocity.airjump.y)

[State 53, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(45)
persistent = 0
value = 45













