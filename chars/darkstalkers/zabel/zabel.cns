;AI AIR MOVES
;===========================================================

[State -2, AI]
type = ChangeState
value = 620 + 50*(random >= 500)
triggerall = p2movetype != A
triggerall = P2bodydist X <= 50
triggerall = vel Y <=1 && vel Y>=-1
triggerall = random < 500
triggerall = statetype = A
triggerall = var(9) = 1
triggerall = !var(12) ;D.F. OFF
triggerall = ctrl
trigger1 = p2statetype != L

[State -2, AI]
type = ChangeState
value = 700 + 20*(random >= 500)
triggerall = p2movetype != A
triggerall = P2bodydist X >= 100 && P2bodydist X <= 150
triggerall = vel Y <=1 && vel Y>=-1
triggerall = statetype = A
triggerall = var(9) = 1
triggerall = !var(12) ;D.F. OFF
triggerall = ctrl
trigger1 = p2statetype = S

;Death Copter
[State -2, AI]
type = ChangeState
value = 1170 + 10*(power >= 1000 && random = [290,300])
triggerall = p2movetype != A
triggerall = random <= 300
triggerall = P2bodydist X >= 80 
triggerall = vel Y <=1 && vel Y>=-1
triggerall = statetype = A
triggerall = var(9) = 1
triggerall = !var(12) ;D.F. OFF
triggerall = ctrl
trigger1 = p2statetype != L

;Skull Sting
[State -2, AI]
type = ChangeState
value = 1270 + 10*(power >= 1000 && random = [690,700])
triggerall = p2movetype != A
triggerall = random >= 700
triggerall = P2bodydist X >= 80 
triggerall = vel Y <=1 && vel Y>=-1
triggerall = statetype = A
triggerall = var(9) = 1
triggerall = !var(12) ;D.F. OFF
triggerall = ctrl
trigger1 = p2statetype != L

[State -2]
type = Posset
triggerall = var(9)=1
triggerall = stateno = 0
trigger1 = Pos Y > 5
trigger2 = Pos Y <-5
y = 0

;-----------------------------------------------------------------------------------
[Statedef -3]

[State -3, AI_Check]
type = Helper
trigger1 = NumHelper(9999) = 0
trigger1 = var(9) = 0
trigger1 = RoundState = 2
name = "AI Trigger"
id = 9999
pos = 1000, 1000
stateno = 9999
helpertype = normal
keyctrl = 1

[State -3, Stop_AI]
type = Varset
trigger1 = var(9) = 1
trigger1 = RoundState = 3
var(9) = 0

; Play sound when landing
[State -3, 1]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52
trigger2 = stateno = 106
value = 4,0

[State -3,Display AI]
type = DisplayToClipboard
trigger1 = var(9)=1
text = "Zabel by Zelgadis296 controlled by CPU"

[State -3,Display AI]
type = DisplayToClipboard
trigger1 = var(9)=-1
text = "Zabel by Zelgadis296 controlled by Player"
