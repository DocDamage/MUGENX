y = const(velocity.run.back.y)

[State 105, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 105, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 105, 4]
type = PosSet
trigger1 = Time = 0
y = 0

[State 105, 5]
type = ChangeState
trigger1 = time = 25
value = 0

; Crouching Run BACK
[Statedef 106]
type    = C
physics = C
anim = 105
sprpriority = 1
ctrl = 0

[State 106, 1]
type = VelSet
trigger1 = 1
x = -2

[State 106, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 106, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 106, 4]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = command != "holddown"
value = 11
ctrl = 1

;---------------------------------------------------------------------------
; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 1]
type = ChangeAnim
triggerall = !var(12)
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2

[State 120, DF]
type = ChangeAnim
triggerall = var(12)
trigger1 = Time = 0
value = 3120 + (statetype = C) + (statetype = A)*2

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

