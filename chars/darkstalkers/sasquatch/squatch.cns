triggerall = Life <= 0
trigger1 = time = 0
value = 5102 

[State 5100, 2] ;Hit ground anim (normal)
type = ChangeAnim
triggerall = Life > 0
triggerall = time = 0
trigger1 = (anim != [5051,5059]) && (anim != [5061,5069])
