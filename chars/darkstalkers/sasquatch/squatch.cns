type = varset
trigger1 = hitdefattr = SCA, NA, AP && movehit
var(6) = 60
ignorehitpause = 1 

[State -2, throwb]
type = varadd
trigger1 = var(6) >= 1 
var(6) = -1
ignorehitpause = 1 

[State -2, AttackMulset]
type = attackmulset
trigger1 = var(6) > 0
trigger1 = var(15) <= 0
value = .8

[State -2, AttackMulset]
type = attackmulset
trigger1 = var(6) > 0
trigger1 = var(15) > 0
value = 1

[State -2, AttackMulset]
type = attackmulset
trigger1 = var(6) <= 0
trigger1 = var(15) <= 0
value = 1

