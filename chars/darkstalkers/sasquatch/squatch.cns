value = 1.2

;Get rid of trailing anims when hit
[State -2, 3]
type = AfterImageTime
triggerall = Time = 1
trigger1 = stateno = 5000
trigger2 = stateno = 5010
trigger3 = stateno = 5020
trigger4 = stateno = 5070
time = 0

[State -2, 4]
type = Velset
trigger1 = FrontEdgeDist < 10
trigger1 = vel x > 0.1
x = 0.1

;Sorrow edge' Throw limitter-------------------------------
[State -2, throwa]
type = varset
trigger1 = hitdefattr = SCA, NA, AP && movecontact
var(4) = 15
ignorehitpause = 1 

[State -2, throwb]
type = varadd
trigger1 = var(4) >= 1
var(4) = -1
ignorehitpause = 1 

