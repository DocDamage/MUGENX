trigger1 = Time = 0
y = 0

[State 3095, 6] ;If just died
type = ChangeState
triggerall = !Alive
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
trigger3 = Anim = [5110,5119]
value = 5150

[State 3095, 7] ;If just died
type = SelfState
triggerall = Alive
trigger1 = Time = 50
value = 5120

[State 3095, 12]
type = VarSet
trigger1 = SysVar(0)
trigger1 = Time = 0
sysvar(0) = 0

[State 3095, 8] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 3095, 9]
