damage = 36, ;　　　　　　　　ダメージの設定（ヒット時36、ガード時4）
animtype = Medium ;　　　　　　　ヒット時の相手のやられアニメーションの強さ指定
pausetime = 0,15 ;　　　　　　　　　ヒット時の硬直時間（自分は0、相手は9）
;sparkno = 0 ;　　　　　　　　　　ヒット時エフェクト（省略の場合はディフォルト）
sparkxy = -5, 0 ;　　　　　　　　　ヒット時のエフェクト表示位置
hitsound = S9,0 ;　　　　　　　　　ヒット時の効果音
guardflag = MA ;　　　　　　　　　　相手キャラクターのガード状態指定
guardsound = S9,0 ;　　　　　　　　　ガードされた時の効果音
ground.type = Low ;　　　　　　　　相手が攻撃を受けた時の状態（地上にいるとき）
ground.slidetime = 25 ;　　　　　　相手の後ずさり時間
ground.hittime = 16 ;　　　　　　　ヒット状態を維持させる時間
ground.velocity = -5 ;　　　　　　　相手が攻撃を受けた時に与える初速度
air.animtype = Low ;　　　　　　　相手が攻撃を受けた時の状態（空中にいるとき）
air.velocity = -2.5,-5 ;　　　　　　　相手が攻撃を受けた時に与える初速度（空中で）　　
hitflag = MAF


