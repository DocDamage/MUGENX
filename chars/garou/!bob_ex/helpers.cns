trigger1 = time = 0
pausemovetime = 100
supermovetime = 100
removetime = 20
bindtime = -1
anim = 1301
pos = 0, 0
scale = 0,0
sprpriority = 5
id = 1301
removeongethit = 1

[state 8010]
type = modifyexplod
trigger1 = 1
id = 1301
