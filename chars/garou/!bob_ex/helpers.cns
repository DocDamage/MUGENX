[state 8010,1]
type = palfx
trigger1 = time = [5,20]
time = 1
add = ceil(-time/15.0*300),ceil(-time/15.0*300),ceil(-time/15.0*300)

[state 8080, remove]
type = Destroyself
trigger1 = time >= 20

