; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Bob Wilson"        ;Name of character
displayname = "Bob Wilson" ;Name of character to display
versiondate = 04,14,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "O Ilusionista"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = bob_ex.cmd   ;Command set
cns     = bob_ex.cns   ;Constants
st      = bob_ex.cns   ;States
st1	= supers.cns
st2	= hypers.cns
st3	= helpers.cns
stcommon = common1.cns ;Common states
sprite  = bob_ex.sff   ;Sprite
anim    = bob_ex.air   ;Animation
sound   = bob_ex.snd   ;Sound
pal1    = paletas\bob_1.act  ;Palettes (can have up to 12)
pal2    = paletas\bob_2.act
pal3    = paletas\bob_3.act
pal4    = paletas\bob_4.act
pal5    = paletas\bob_5.act
pal6    = paletas\bob_6.act

; Arcade mode
[Arcade]
intro.storyboard = 
ending.storyboard = 