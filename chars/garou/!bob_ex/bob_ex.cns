; ************************************************************
; ************  Bob Wilson EX - BY O Ilusionista  ************
; ************************************************************

; [0200-0220]	- Standing Punchs
; [0230-0255]	- Standing Kicks
; [0400-0420]	- Crouching Punchs
; [0430-0450]	- Crouching Kicks
; [0600-0620]	- Jumping Punchs
; [0630-0660]	- Jumping Kicks

; [0700-0722]	- Guard Push

; [0750-0796]	- 

; [0810-0860]	- 

; [0880-0885]	- Alpha Counter - 
; [0886-0888]	- Alpha Counter - 

; [0890-0895]	- Super Jump

; [0895-0897]	- Triangle Jump

; [0900-0910]	- 
; [0920-0933]	- 
; [0950-0966]	- 
; [0970-0976]	- 

; [0980-0990]	- Dizzy

; [0950-0960]	- 
; [0970-0995]	- 

;----------------------------________________-------------------------------
;---------------------------|                |------------------------------
;---------------------------| Configuration  |------------------------------
;---------------------------|________________|------------------------------

;---------------------------------------------------------------------------

[data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 60
liedown.time = 30
airjuggle = 15
sparkno = 2
guard.sparkno = 40
ko.echo = 0
volume = 0
intpersistindex = 60
floatpersistindex = 40

[size]
xscale = 1           ;horizontal scaling Factor.
yscale = 1           ;vertical scaling Factor.
ground.back = 15     ;player width (back, ground)
ground.front = 16    ;player width (front, ground)
air.back = 12        ;player width (back, air)
air.front = 12       ;player width (front, air)
height = 60      ;height of player (for opponent to jump over)
attack.dist = 160    ;default attack Distance
proj.attack.dist = 90 ;default attack Distance For projectiles
proj.doscale = 0     ;set to 1 to scale projectiles too
head.pos = -5, -90   ;approximate position of head
mid.pos = -5, -60    ;approximate position of midsection
shadowoffset = 0     ;number of pixels to vertically offset the shadow
draw.offset = 0,0    ;player Drawing offset in pixels (x, y)

[velocity]
walk.fwd  = 3.4      ;walk Forward
walk.back = -3.2     ;walk backward
run.fwd  = 5.6, 0    ;run Forward (x, y)
run.back = -5.5,-3.8 ;hop backward (x, y)
jump.neu = 0,-10.4    ;neutral jumping velocity (x, y)
jump.back = -4.55    ;jump back speed (x, y)
jump.fwd = 4.5       ;jump Forward speed (x, y)
runjump.back = -4.55,-9.1 ;running jump speeds (opt)
runjump.fwd = 6,-9.1      ;.
airjump.neu = 0,-9.1      ;.
airjump.back = -3.55      ;air jump speeds (opt)
airjump.fwd = 3.5         ;.

[movement]
airjump.num = 1      ;number of air jumps allowed (opt)
airjump.height = 35  ;minimum Distance From ground before you can air jump (opt)
yaccel = .54         ;vertical acceleration
stand.friction = .85  ;friction coefficient when standing
crouch.friction = .82 ;friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [statedef stateno]
; type = ?      s/c/a/l  stand/crouch/air/liedown
; movetype = ?  i/a/h    idle/attack/gethit
; physics = ?   s/c/a/n  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [state stateno, ?]     ? - any number you choose
; type = ?
; ...
;---------------------------------------------------------------------------
;crouch walk
[statedef 23]
type = c
movetype = i
physics = c
anim = 13

[state 23, 1]
type = velset
trigger1 = 1
x = 1.5

[state 23, 2]
type = velset
trigger1 = command != "holdfwd"
x = 0

[state 23, 3]
type = changestate
trigger1 = command != "holdfwd"
value = 11

[state 23, 4]
type = changestate
trigger1 = command != "holddown"
value = 0

[state 23, 5]
type = changestate
trigger1 = p2dist x < 0
value = 24

;---------------------------------------------------------------------------
;crouch turn
[statedef 24]
type = c
movetype = i
physics = c
velset = 0

[state 24, 1]
type = turn
trigger1 = time = 0

[state 24, 2]
type = changestate
trigger1 = animtime = 0
value = 11

;---------------------------------------------------------------------------
;crouch walk back
[statedef 25]
type = c
movetype = i
physics = c
anim = 14

[state 23, 1]
type = velset
trigger1 = 1
x = -1.5

[state 23, 2]
type = velset
trigger1 = command != "holdback"
x = 0

[state 23, 3]
type = changestate
trigger1 = command != "holdback"
value = 11

[state 23, 4]
type = changestate
trigger1 = command != "holddown"
value = 0

[state 23, 5]
type = changestate
trigger1 = p2dist x < 0
value = 24

;---------------------------------------------------------------------------
; lose by time over
; cns Difficulty: basic
; cns ƒœƒxƒ‹: šî–{
[statedef 170]
type = s
ctrl = 0
anim = 170
velset = 0,0

[state 170, 1]
type = nothitby
trigger1 = 1
value = sca
time = 1

;----------------------------________________-------------------------------
;---------------------------|                |------------------------------
;---------------------------|    win pose    |------------------------------
;---------------------------|________________|------------------------------

;---------------------------------------------------------------------------
; pre win

[statedef 180]
type = s

[state 180, 1]
type = varrandom
trigger1 = time = 0
v = 1
range = 0,2

[state 180, 2]
type = varset
trigger1 = command = "holdx" || command = "holda"
v = 1
value = 0

[state 180, 3]
type = varset
trigger1 = command = "holdy" || command = "holDB"
v = 1
value = 1

[state 180, 4]
type = varset
trigger1 = command = "holdz" || command = "holdc"
v = 1
value = 2

[state 180, 5]
type = changestate
trigger1 = var(1) = 0
value = 181

[state 180, 6]
type = changestate
trigger1 = var(1) = 1
value = 182

[state 180, 7]
type = changestate
trigger1 = var(1) = 2
value = 183

;---------------------------------------------------------------------------
; win pose 1 - bob !

[statedef 181]
type = s
ctrl = 0
anim = 181
velset = 0,0
sprpriority = 3

[state 181, 1]
type = playsnd
trigger1 = animelem = 2
value = s181,0

[state 181, 1]
type = playsnd
trigger1 = animelem = 3
value = s3,5

;---------------------------------------------------------------------------
; win pose 2 - pose De lutador

[statedef 182]
type = s
ctrl = 0
anim = 182
velset = 0,0
sprpriority = 3

[state 181, galera]
type = playsnd
trigger1 = animelem = 1
value = s181,2

;---------------------------------------------------------------------------
; win pose 3 - oiaiaia


[statedef 183]
type = s
ctrl = 0
anim = 183
velset = 0,0
sprpriority = 3

[state 181, 1]
type = playsnd
trigger1 = animelem = 1
value = s181,3

;---------------------------------------------------------------------------
; win pose 4 - clear hands


[statedef 184]
type = s
ctrl = 0
anim = 184
velset = 0,0
sprpriority = ifelse(var(40)=1,-5,3)

[state 184, 1]
type = playsnd
trigger1 = animelem = 14
value = s3,2

;----------------------------________________-------------------------------
;---------------------------|                |------------------------------
;---------------------------|   intro pose   |------------------------------
;---------------------------|________________|------------------------------

;---------------------------------------------------------------------------
; preintro

[statedef 190]
type = s
ctrl = 0
velset = 0,0

[state 190, 1]
type = varrandom
trigger1 = time = 1
range = 1, 3
v = 10

;---------------------------------------------------------------------------
; pre intro - sign on back

[state 190, 4]
type = changestate
trigger1 = stateno != 19100
triggerall = var(10) = [1,3]
trigger1 = matchover = 0
value = 191

;----------------------------________________-------------------------------
;---------------------------|                |------------------------------
;---------------------------|   intro pose   |------------------------------
;---------------------------|________________|------------------------------

;---------------------------------------------------------------------------
; introduction 01 - mortal Duplo

[statedef 191]
type = s
ctrl = 0
anim = 190

[state 19100, 2]
type = assertspecial
trigger1 = 1
flag = intro

type = changeanim
trigger1 = roundstate = 0
value = 190

[state 181, galera]
type = playsnd
trigger1 = animelem = 2
value = s181,0

[state 19100, 4]
type = changestate
trigger1 = animtime = 0
value = 0


