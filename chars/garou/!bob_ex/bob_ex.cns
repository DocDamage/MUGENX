[state -2, 4]
type = changestate
triggerall = roundstate = 2
triggerall = (var(59) =2) 
triggerall = (statetype = a) 
triggerall = (movehit)
trigger1 = (p2bodydist x <= 100) 
trigger1 = (stateno = 610) 
trigger1 = (prevstateno = 630)
value = 640

;---------------------------------------------------------------------------
; air combo 4 - air Finalizer

[state -2, 4]
type = changestate
triggerall = roundstate = 2
triggerall = (var(59) =2) 
triggerall = (statetype = a) 
triggerall = (movehit)
trigger1 = (p2bodydist x <= 100) 
trigger1 = (stateno = 640) 
trigger1 = (prevstateno = 610)
value = ifelse (random <= 500,650,620)

;---------------------------------------------------------------------------
; A.I. - Dizzy

[State -2, 1]
type = DisplayToClipboard
trigger1 = 1
text = "damge = %d - CC = %d - P2dist = %.0f - Super Cancel = %d"
params = Var(32), Var(15), p2bodydist x, Var(12)
;---------------------------------------------------------------------------
; states that are executed when in self's state File (use statedef -3)
;---------------------------------------------------------------------------

[statedef -3]

;this controller plays a sound everytime kfm lands From a jump, or
;from his back-dash.
[state -3, landing sound]
type = playsnd
triggerall = time = 1
trigger1 = stateno = 52 ;jump land
value = s0, 0

[state -3, jumping sound]
type = playsnd
triggerall = time = 1
trigger1 = stateno = 40 ;jump land
value = s0, 3

[state 1051, land explod]
type = helper
trigger1 = stateno = 52 & numhelper(8010) = 0
name = "land explod"
id = 8010
stateno = 8010
postype = p1
pos = 0,0
sprpriority = -1
bindtime = 1
ownpal = 1
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
; without life bars - intro/wins

[state -3, lifebars]
type = assertspecial
trigger1 = roundstate < 2
trigger2 = stateno = [180,185] 
trigger3 = winko = 1 
trigger4 = (var(25) = 1) 
trigger4 = (numexplod(8420) != 0) 
trigger4 = (roundstate = 3)
flag = nobardisplay
ignorehitpause = 1

;---------------------------------------------------------------------------
; Combo Counter - Less damage combo system

[State -3, 1]
type = VarSet
trigger1 = P2MoveType != H
ignorehitpause = 1
var(32) = 0;Reset Combo counter

[State -3, 2]
type = VarAdd
trigger1 = HitCount-Var(31)>0
ignorehitpause = 1
var(32) = 1;Combo Counting

[State -3, 3]
type = VarSet
trigger1 = 1
ignorehitpause = 1
var(31) = HitCount;PrevHitCount

;---------------------------------------------------------------------------
; Super/Hyper Combo Finish - Background Effect

[State -3: Helper]
type = Helper
trigger1 = (WinKO) && (NumHelper(8400) = 0) && (hitdefattr = SCA, HA)
helpertype = Normal
name = "WinKO"
id = 8400
pos = 0,0
postype = p1
facing = 0
stateno = 8400
keyctrl = 0
ownpal = 1
supermovetime = 1000
pausemovetime = 1000
ignorehitpause = 1

[State -3: Helper]
type = Helper
trigger1 = (WinKO) && (NumHelper(8420) = 0) && (hitdefattr = SCA, NA, SA)
helpertype = Normal
name = "WinKO"
id = 8420
pos = 0,0
postype = p1
facing = 0
stateno = 8420
keyctrl = 0
ownpal = 1
supermovetime = 1000
pausemovetime = 1000
ignorehitpause = 1

;--------------------------------------------------------------------------- Custom Combo

[State -3, Timer] 
type = VarAdd
trigger1 = Var(15) > 0
v = 15
value = -1
ignorehitpause = 1

[State -3, Cancel] ;Cancel CC Mode if you get hit or win the round
type = VarSet
trigger1 = (MoveType = H) || (Roundstate = 3)
v = 15
value = 0

;Sorrowedge's Haste Code (tm)
;Modified for faster anims
[State -3, Speed] 
type = ChangeAnim
triggerall = (Var(15) > 0) && (RoundState = 2) && (MoveType != H)
trigger1 = AnimElemTime(AnimElemNo(0) + 1) < 0
trigger1 = AnimElemTime(AnimElemNo(0)) > floor ((AnimElemTime(AnimElemNo(0)) - AnimElemTime(AnimElemNo(0) + 1))/3)
ignorehitpause = 1
value = anim
elem = AnimElemNo(0) + 1

[State -3, Blink]
type = PalFX
trigger1 = Var(15) > 0 && timemod = 3,0
time = 2
add = 0,16,132
sinadd = 5,32,164,2

[State -3, AfterImageTime] ;This ensures that afterimages are displaying during mode
type = AfterimageTime
trigger1 = var(15) > 0
time = 2

[State -3, NoJuggleCheck] ;Infinnite juggle points!
type = AssertSpecial
trigger1 = var(15) > 0
flag = nojugglecheck

[State -3, AttDwn] ;Tone down the damage
type = AttackMulSet
trigger1 = Var(15) > 0
value = 0.8

[State -3, AttUp] ;Back to normal
type = AttackMulSet
trigger1 = Var(15) = 0
value = 1

;------------------------------------- Velset no CC
[State -3, velset]
type = Velset
triggerall = StateType = S || StateType = C
trigger1 = Var(15) > 0 && (Stateno != [9000,9001])
x = 4

;---------------------------- Choose Mode
[State -3, Mode]
type = VarSet
trigger1 = Palno = [0,6]
v = 40
value = 0

[State -3, Mode]
type = VarSet
trigger1 = Palno = [7,12]
v = 40
value = 50

;----------------------------________________-------------------------------
;---------------------------|                |------------------------------
;---------------------------|      NEW	   |------------------------------
;---------------------------|________________|------------------------------

;Super Cancel code - Thanx Necromancer

[State -3: Null]
type = Null
trigger1 = (Var(2) = 1) && (NumTarget = 0) && (Pos Y >= 0)
trigger1 = (Var(2) := 0)
trigger2 = (Var(4) = 1) && (NumTarget = 0)
trigger2 = (Var(4) := 0)
trigger3 = (Var(12) := 0)
trigger4 = (StateType != A) && (Pos Y >= 0) && ((Time < 20) || (MoveContact) || (NumTarget))
trigger4 = (StateNo = [1000,2999]) ;|| (StateNo = [1100,1127]) || (StateNo = [1200,1220]) || (StateNo = [1230,1270])
trigger4 = (Var(12) := 1)
;trigger5 = (StateType != A) && (Pos Y >= 0) && ((Time < 20) || (MoveContact) || (NumTarget))
;trigger5 = (StateNo = [1300,1335]) || (StateNo = [1350,1370]) || (StateNo = [1400,1435]) || (StateNo = [1450,1475]) || (StateNo = [1500,1530]) || (StateNo = [1900,1925])
;trigger5 = (Var(12) := 1)
;trigger6 = (StateType != A) && (Pos Y >= 0) && ((Time < 20) || (MoveContact) || (NumTarget))
;trigger6 = (StateNo = [2000,2020]) || (StateNo = [2100,2120]) || (StateNo = [2200,2221]) || (StateNo = [2250,2270]) || (StateNo = [2300,2325]) || (StateNo = [2350,2426])
;trigger6 = (Var(12) := 1)
ignorehitpause = 1

[State -3: ScreenBound]
type = ScreenBound
triggerall = (BackEdgeBodyDist <= -5)
trigger1 = (StateNo = [50,52]) || (StateNo = 100) || (StateNo = 895) || (Var(2))
value = 0
movecamera = 0,0

[State -3: ChangeState]
type = ChangeState
triggerall = (BackEdgeBodyDist <= -5)
trigger1 = ((StateType = S) && (Ctrl)) && (StateNo != 100)
value = 100

[State -3: CtrlSet]
type = CtrlSet
trigger1 = ((StateNo = [50,52]) || (StateNo = 100)) && (BackEdgeBodyDist <= -5)
value = 0

[State -3: RemoveExplod]
type = RemoveExplod
trigger1 = (NumExplod(8050) > 0) && (StateNo != [100,105])
value = 8050





