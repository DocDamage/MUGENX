triggerall = roundstate = 2
triggerall = (var(59) =2) 
trigger1 = (stateno = 430) 
trigger1 = (movehit) 
trigger1 = (random = [0,500])
trigger2 = (stateno = [950,956]) 
trigger2 = (movehit) 
value = 420

;---------------------------------------------------------------------------
