[state -2, 3]
type = changestate
triggerall = roundstate = 2
triggerall = (var(59) =2) 
trigger1 = (stateno = 430) 
trigger1 = (movehit) 
trigger1 = (random = [501,999])
value = 210 

;---------------------------------------------------------------------------
; combo 4 - light punch > medium punch

[state -2, 3]
type = changestate
triggerall = roundstate = 2
triggerall = (var(59) =2) 
trigger1 = (stateno = 210) 
trigger1 = (movehit) 
trigger1 = (random = [501,999])
value = 230

;---------------------------------------------------------------------------
; a.i. - special attack - Finisher

[state -2, Finish]
type = null;changestate
triggerall = roundstate = 2
triggerall = (var(59) =2) 
trigger1 = (stateno = 230) 
trigger1 = (movehit) 
value = 950
ignorehitpause = 1

;---------------------------------------------------------------------------
; combo 6 - heavy punch > aerial rave

[state -2, 6]
type = changestate
triggerall = roundstate = 2
triggerall = (var(59) =2) 
triggerall = (statetype = c)
trigger1 = (stateno = 420) 
trigger1 = (movehit)
trigger1 = time >10 
value = 892

