;-------------------------------------------------------------
; Jump Initiate
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0

[State 40, 1]
type = VarSet
trigger1 = Time = 0
v = 2
value = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdback"
trigger1 = var(1) != 1
v = 2
value = -1

[State 40, 3]
type = VarSet
trigger1 = command = "holdfwd"
trigger1 = var(1) != -1
v = 2
value = 1

[State 40, 4]
type = ChangeState
trigger1 = AnimTime = 0
trigger1 = command != "holdup"
value = 41

[State 40, 5]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 6]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 7]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 8]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 9]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1


