; Gato's constants.
; Written by Deuce, copyright 2000 Deuce
; deuce@classicgaming.com
; Not for copying or redistribution.  Do not modify.

[Data]
life = 1000          ;Amount of life to start with
;attack = 833         ;100% attack power (more is stronger)
attack = 750
defence = 100        ;100% defensive power (more is stronger)
fall.defence_up = 50 ;Def goes up by 50% everytime player is hit on ground
liedown.time = 60    ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 15        ;Can do 15 points of juggling
sparkno = 2        ;Default spark number
guard.sparkno = 40 ;Default guard spark number
KO.echo = 0          ;1 to enable echo on KO
volume = 0           ;Volume offset (negative for softer)

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 15     ;Player width (back, ground)
ground.front = 15    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
z.width = 3          ;Player width (into and out)
height = 60	     ;Height of player (for opponent to jump over)
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
shadowoffset = 2
head.pos = -15, -74
mid.pos = -21,-47

[Velocity]
walk.fwd  = 2.3      ;Walk forward
walk.back = -1.8     ;Walk backward
;run.fwd  = 4.6, 0    ;Run forward (x, y)  - if y<0, player will hop
run.back = -4.5,-3.8 ;Run backward (x, y) - if y=0, player will run
run.fwd  = 5.3, 0    ;Run forward (x, y)  - if y<0, player will hop
;run.back = -5.5,-3.2 ;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-9.1    ;Neutral jumping velocity (x, y)
jump.back = -2.75, -9.1    ;Jump back Speed (x, y)
jump.fwd = 2.85, -10.1       ;Jump forward Speed (x, y)
runjump.back = -1.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-8.1      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55,-8.1 ;Air jump speeds (opt)
airjump.fwd = 2.5,-8.1    ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .43         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; LOSE (Time over)
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0,0

[State 170, voice]
type = PlaySnd
trigger1 = time = 0
value = S30,10

[State 170, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

;---------------------------------------------------------------------------
; WIN
[Statedef 180]
type = S
velset = 0,0

[State 180, Hotaru]
type = Changestate
triggerall = Matchover = 1
trigger1 = p2name = "Hotaru"
trigger2 = p4name = "Hotaru"
trigger3 = p2name = "Hotaru Futaba"
trigger4 = p4name = "Hotaru Futaba"
trigger5 = p2name = "Futaba Hotaru"
trigger6 = p4name = "Futaba Hotaru"
value = 183

[State 180, NotFinal]
type = ChangeState
trigger1 = matchover != 1
value = 182

[State 180, anim]
type = ChangeAnim
trigger1 = time = 0
value = 181

[State 180, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

[State 180, 2]
type = PlaySnd
trigger1 = Time = 0
value = 30, 0 ;"Sono teido nara... yamete shimae!"

[State 180, 3]
type = Assertspecial
trigger1 = time = [0,225]
Flag = roundnotover

; WIN2 (first round)
[Statedef 182]
type = S
ctrl = 0
anim = 182
velset = 0,0,0

[State 182, anim]
type = ChangeAnim
trigger1 = time = 0
value = 182

[State 182, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

[State 182, 2]
type = PlaySnd
trigger1 = AnimElem = 4
value = S30, 7 ;"Zuibun to samesasete kureru."

[State 182, 3]
type = Assertspecial
trigger1 = time = [0,225]
Flag = roundnotover

; Second round winpose vs. Hotaru
[Statedef 183]
type = S
ctrl = 0
anim = 182
velset = 0,0,0

[State 183, anim]
type = ChangeAnim
trigger1 = time = 0
value = 182

[State 183, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

[State 183, 2]
type = PlaySnd
trigger1 = AnimElem = 4
value = S30, 11 ;"Tatakai kara miyo hike."

[State 183, 3]
type = Assertspecial
trigger1 = time = [0,225]
Flag = roundnotover

