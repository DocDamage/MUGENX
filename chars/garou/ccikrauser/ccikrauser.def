; Definition file for CCIron krauser RBS
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Wolfgang Krauser"
displayname = "Wolfgang Krauser"
versiondate = 03,07,2005 ;Started
mugenversion = 04,01,2001
author = "David Demianoff"
pal.defaults = 1,7,2,8,3,9,4,10,5,11,6,12

; Files for the player
[Files]
cmd      = krauser.cmd        ;Other config
cns      = krauser.cns        ;Constants
st       = krauser.cns        ;States
st1      = attacks.cns        ;States
st2      = specials.cns        ;States
st3      = hypers.cns        ;States
st4      = misc.cns
stcommon = common1.cns     ;Common states
sprite   = krauser.sff        ;Sprite
anim     = krauser.air        ;Animation
sound    = krauser.snd        ;Sound
pal1     = psicoso_kof.act        ;Normal palette
pal2     = walt_negro.act
pal3     = juan_piccollo.act
pal4     = psicoso_king.act
pal5     = psicoso_yurei.act
pal6     = krauser.act
pal7     = psicoso_angela.act
pal8     = psicoso_psicoso.act
;pal9     = pal\8.act
;pal10    = pal\9.act
;pal11    = pal\10.act
;pal12    = pal\11.act