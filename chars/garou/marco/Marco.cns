;=====================================================================
;  CNS File For "Marco Rodriguez"                       Made By M.M.R.
;                                       Ver. 1.0           2000.Aug.24
;=====================================================================

;---------------------------------------------------------------------
; Basic Constants
[Data]
life = 1200          ;Amount of life to start with
attack = 165         ;100% attack power (more is stronger)
defence = 100         ;100% defensive power (more is stronger)
fall.defence_up = 50 ;Def goes up by 50% everytime player is hit on ground
liedown.time = 40    ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 15       ;Can do 15 points of juggling
sparkno = 2        ;Default spark number
guard.sparkno = 40 ;Default guard spark number
KO.echo = 0          ;1 to enable echo on KO
volume = -5          ;Volume offset (negative for softer)

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 18     ;Player width (back, ground)
ground.front = 15    ;Player width (front, ground)
air.back = 17        ;Player width (back, air)
air.front = 17       ;Player width (front, air)
z.width = 10         ;Player width (into and out)
height = 80	     ;Height of player (for opponent to jump over)
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = 0,-80   ;Approximate position of head
mid.pos = -5, -50    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow

[Velocity]
walk.fwd  = 2.3      ;Walk forward
walk.back = -2.2     ;Walk backward
run.fwd  = 12.5, 0   ;Run forward (x, y)  - if y<0, player will hop
run.back = -4.5,-3.0 ;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-8.5    ;Neutral jumping velocity (x, y)
jump.back = -2.80    ;Jump back Speed (x, y)
jump.fwd = 2.65      ;Jump forward Speed (x, y)
;runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
;runjump.fwd = 4,-8.1      ;.
;airjump.neu = 0,-8.1      ;.
;airjump.back = -2.55,-8.1 ;Air jump speeds (opt)
;airjump.fwd = 2.5,-8.1    ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
;airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .43         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;===============================================================================
; Definition of the Basic Action
;===============================================================================

;-------------------------------------------------------------------------------
;Dash Foward override
[Statedef 100]
type    = S
movetype = I
physics = S
ctrl = 0
anim = 100
velset = 12.5,0

[State 100,3]
type = PlaySnd
trigger1 = Time = 0
value = 100, 0

[State 100,4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;===============================================================================
; Definition of the Win/Lose/Intro Pause
;===============================================================================

;-------------------------------------------------------------------------------
; LOSE (Time over)
[Statedef 170]
type = S
ctrl = 0
anim = 175
velset = 0,0,0

[State 170,0]
type = PlaySnd
trigger1 = AnimElem = 3
value = 175, 0

[State 170,1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

;-------------------------------------------------------------------------------
; WIN
[Statedef 180]
type = S

[State 180,1]
type = ChangeState
trigger1 = MatchOver != 1
trigger1 = Time = 0
value = 181

[State 180,2]
type = ChangeState
trigger1 = MatchOver = 1
trigger1 = Time = 0
value = 182

;-------------------------------------------------------------------------------
; WIN 1
[Statedef 181]
type = S
ctrl = 0
anim = 180
velset = 0,0,0

[State 181,1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

[State 181,2]
type = PlaySnd
trigger1 = AnimElem = 4
value = 180, 0

;-------------------------------------------------------------------------------
; WIN 2
[Statedef 182]
type = S
ctrl = 0
anim = 185
velset = 0,0,0

[State 182,0]
type = Turn
trigger1 = Time = 0
trigger1 = Facing = -1

[State 182,1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

[State 182,2]
type = PlaySnd
trigger1 = AnimElem = 2
value = 185, 0

[State 182,3]
type = PlaySnd
trigger1 = AnimElem = 10
value = 185, 1

