;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = prevstateno = 192 || prevstateno = 193
trigger1 = Anim != 1 && Anim != 5
value = 1

[State 0, 2]
type = ChangeAnim
trigger1 = prevstateno != 192 && prevstateno != 193
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 0

[State 0, 3]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 50]
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0


