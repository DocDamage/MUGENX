trigger1 = Time = 0
value = 5110

[state 5150,1]
type = ChangeAnim
trigger1 = p2stateno >= 180
trigger1 = p2stateno < 190
trigger1 = Time > 0
trigger1 = anim = 5110
trigger1 = matchover = 1
value = 5150

[state 5150,1]
type = ChangeAnim
trigger1 = p2stateno >= 180
trigger1 = p2stateno < 190
trigger1 = Time > 0
trigger1 = anim = 5110
trigger1 = matchover != 1
value = 4987

[State 5150, 2]
type = SprPriority
trigger1 = Time = 0
value = -3

[State 5150, 3] ;Friction
type = VelMul
trigger1 = Time >= 0
x = 0.85

[State 5150, 3] ;Friction
type = VelSet
trigger1 = Vel x < .05
persistent = 0
x = 0

[State 5150, 4]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

