;===========================================================================
;移動系
;===========================================================================
;---------------------------------------------------------------------------
;ダッシュ
[Statedef 100]
type    = S
physics = N

[State 100, 1]
type = VelSet
trigger1 = AnimElem = 1, >= 0
x = const(velocity.run.fwd.x)
y = const(velocity.run.fwd.y)


[State 100, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 100

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 2]
type = ChangeAnim
trigger1 = time >= 3
trigger1 = time <= 9
trigger1 = command != "holdfwd"
value = 101
persistent = 0

[State 197, 1]
type = PlaySnd
trigger1 = AnimTime = 0
value = 1,0

[State 100, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

