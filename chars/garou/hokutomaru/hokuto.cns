;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1
velset = 0

[State 100, 1]
type = VelSet
trigger1 = time >= 3
x = const(velocity.run.fwd.x)

[State 100, 2]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 192, 2]
type = PlaySnd
trigger1 = timemod = 16,3
value = S10,0

[State 100, 3]
type = ChangeState
trigger1 = command != "holdfwd"
value = 101

