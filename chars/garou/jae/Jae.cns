; Player's constants.
; Format (case insensitive):
;  [groupname]        
;  constname = "value"

[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 70
power = 3000

[Size]
xscale = 1
yscale = 1
ground.back = 17
ground.front = 17
air.back = 17
air.front = 17
z.width = 3
attack.width = 4,4
attack.dist = 160
proj.attack.dist = 90
head.pos =  3,-93
head.pos = -1,-58

[Velocity]
walk.fwd  = 2.85
walk.back = -2.25
run.fwd  = 5.6, 0
run.back = -4.8,-4.6
jump.neu = 0,-9.8
jump.back = -2.65
jump.fwd = 2.6

[Movement]
airjump.num = 0
yaccel = .5
stand.friction = .8
crouch.friction = .8

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; LOSE (Time over)
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0,0

[State 170, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

;---------------------------------------------------------------------------
; WIN
[Statedef 180]
type   = S
velset = 0

[State 180, 1]
type = VarRandom
trigger1 = Time = 0
v = 1
range = 0,100

[State 180, 2]
type = ChangeState
trigger1 = Var(1) = [0,33]
value = 181

[State 180, 3]
type = ChangeState
trigger1 = Var(1) = [34,66]
value = 184

[State 180, 4]
type = ChangeState
trigger1 = Var(1) = [67,100]
value = 185

