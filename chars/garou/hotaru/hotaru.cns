triggerall = Time = 0
trigger1 = P2Name = "Gato"
trigger2 = P4Name = "Gato"
value = 182

[State 191, 1]
type = ChangeState
trigger1 = Time = 10
value = 181

[State 180, 2] ;Choose win1
type = VarSet
trigger1 = Command = "hold_x"
v = 1
value = 1

[State 180, 3] ;Choose win2
type = VarSet
trigger1 = Command = "hold_y"
v = 1
value = 2

[State 180, 4] ;Choose win3
type = VarSet
trigger1 = Command = "hold_a"
v = 1
value = 3

[State 180, 5]
type = ChangeState
trigger1 = Var(1) = 1
value = 181

[State 180, 6]
type = ChangeState
trigger1 = Var(1) = 2
value = 185

[State 180, 7]
type = ChangeState
trigger1 = Var(1) = 3
value = 183
 
