; ここにキャラ情報を書いてください
[Info]
name = "Laurence Blood"     ;キャラの名前
displayname = "Laurence"    ;表示されるキャラの名前
versiondate = 08,16,2004    ;キャラの更新情報
mugenversion = ;Win Mugen;  ;キャラが動くmugenのバージョン
author = "FUJY"             ;キャラの製作者名
pal.defaults = 2,3          ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = laurence.cmd       ;キャラのコマンド
cns     = laurence.cns       ;キャラのプログラム
st      = laurence.cns       ;キャラのプログラム
st1     = laurence-Int.cns   ;イントロ関係のプログラム
st2     = laurence-N.cns     ;通常攻撃・特殊攻撃・通常投げのプログラム
st3     = laurence-S.cns     ;必殺技のプログラム
st4     = laurence-H.cns     ;超必殺技のプログラム
st5     = laurence-O.cns     ;ヘルパーのプログラム
stcommon = common1.cns 
sprite  = laurence.sff    ;キャラの絵
anim    = laurence.air    ;キャラの動き
sound   = laurence.snd    ;キャラの音
pal1    = laurence01.act  ;キャラの色（最大１２個）
pal2    = laurence02.act
pal3    = laurence03.act

;---------------------------------------------------------------------------
