trigger1 = AnimElem = 1
trigger2 = AnimElem = 2
trigger3 = AnimElem = 3
trigger4 = AnimElem = 4
trigger4 = AnimElem = 5
pos = 30,0

[State 810, Bind 5]
type = TargetBind
trigger1 = AnimElem = 6
pos = 120,0

[State 810, Hurt 11]
