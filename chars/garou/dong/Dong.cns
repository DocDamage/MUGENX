;---------------------------------------------------------------------------
; INTRO
[Statedef 191]
type = S
ctrl = 0
anim = 191
velset = 0,0,0

[State 191, 1]
type = AssertSpecial
trigger1 = time = [0, 85]
flag = intro

[State 191, 2]
type = PlaySnd
trigger1 = Time = 1 
value = 4, 0

[State 191, 3]
type = PlaySnd
trigger1 = Time = 70 
value = 4, 1

[State 191, 4] ;If opponent is Jae Hoon, go to alternate intro
type = ChangeState
triggerall = Time = 0
trigger1 = P2Name = "MOTW JAEHOON"
trigger2 = P4Name = "MOTW JAEHOON"
value = 192

[State 191, 5] ;If opponent is Jae Hoon, go to alternate intro
type = ChangeState
triggerall = Time = 0
trigger1 = P2Name = "Kim Jae Hoon"
trigger2 = P4Name = "Kim Jae Hoon"
value = 192

[State 191, 6] ;If opponent is Jae Hoon, go to alternate intro
type = ChangeState
triggerall = Time = 0
trigger1 = P2Name = "Jae Hoon"
trigger2 = P4Name = "Jae Hoon"
value = 192

[State 191, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 0

