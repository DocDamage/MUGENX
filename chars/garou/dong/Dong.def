; Definition file for Kim Dong Hwan
; Contains all the filenames needed for the character

; Character information
[Info]
name = "Kim Dong Hwan"        ;Name of character
displayname = "Dong Hwan" ;Name of character to display
versiondate = 06,27,2000    ;Version date of character
mugenversion = 06,27,2000   ;Version of M.U.G.E.N character works on
author = "Kazuya"         ;Character author name
pal.defaults = 1,4,7,10      ;Default palettes in order of preference

; Files for the character
[Files]
cmd     = Dong.cmd     ;Garou Command set
;cmd     = DongAlt.cmd     ;Capcom Command set
cns     = Dong.cns     ;Constants
st      = Dong.cns     ;States
stcommon = common1.cns   ;Common states
sprite  = Dong.sff     ;Sprite
anim    = Dong.air     ;Animation
sound   = Dong.snd     ;Sound
pal1    = Dong1.act     
pal2    = Dong1.act
pal3    = Dong1.act
pal4    = Dong2.act
pal5    = Dong2.act
pal6    = Dong2.act
pal7    = Dong3.act     
pal8    = Dong3.act
pal9    = Dong3.act
pal10    = Dong4.act
pal11    = Dong4.act
pal12    = Dong4.act
