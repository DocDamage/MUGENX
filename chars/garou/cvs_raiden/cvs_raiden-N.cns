; _bV
[Statedef 100]
type    = S
movetype = I
physics = N
ctrl = 0
VelSet = 0,0

[State 200, ChangeAnim]
type = ChangeAnim
trigger1 = Time = 0 && prevstateno != 10000
value = 100

[State 3001, Super]
type = Helper
trigger1 = Time = 0 && NumHelper(2155) = 0
persistent = 0
id = 2155
name = "Sand cloud"
pos = 0,0
postype = P1
stateno = 2155
helpertype = normal
keyctrl = 0
ownpal = 1
facing = 1

[State 100,0]
type = VelSet
trigger1 = AnimElem = 2,= 0
x = Const(velocity.run.fwd.x)

[State 100,1]
type = PlaySnd
trigger1 = AnimElem = 2,= 0
trigger2 = AnimElem = 5,= 0
value = 1, 0

[State 100,4]
type = ChangeState
trigger1 = Time > 10
trigger1 = AnimElem = 2,> 0 && Command != "holdfwd"
value = 101
ctrl = 0

[State 100,5]
type = ChangeState
trigger1 = Time > 0
trigger1 = Command = "holdupfwd"
value = 40

[State 100,6]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

