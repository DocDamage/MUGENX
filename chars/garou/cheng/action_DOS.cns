;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
triggerall = p2bodydist x >= 44
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 1]
type = ChangeAnim
triggerall = p2bodydist x < 44
trigger1 = Anim != 1 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 1


[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
;-------------------------------------------------
;ジャンプ開始
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, NOTHITBY]
type = nothitby
trigger1 = 1
value = SC,NT, ST, HT

[State 40, 13]
type = ChangeState
triggerall = AnimTime = 0
triggerall = Var(7) = 1
trigger1 = p2bodydist x = [26,40]
trigger2 = p2bodydist x = [0,25]
trigger2 = p2stateno = 5120
value = 60

[State 40, 1]
type = VarSet
trigger1 = Time = 0
v = 4
value = 0

[State 40, 2]
type = VarSet
trigger1 = Time >= 0
trigger1 = command = "holdfwd"
v = 4
value = 1

[State 40, 3]
type = VarSet
trigger1 = Time >= 0
trigger1 = command = "holdback"
v = 4
value = -1

[State 40, 4]
type = ChangeState
trigger1 = AnimTime = 0
trigger1 = command != "holdup"
trigger1 = prevstateno = 101
value = 61

[State 40, 4]
type = ChangeState
trigger1 = AnimTime = 0
trigger1 = command != "holdup"
value = 60

[State 40, 5]
type = VarSet
trigger1 = Time = 0
sysvar(4) = 0

[State 40, 6]
type = VarSet
trigger1 = command = "holdfwd"
trigger2 = AnimTime = 0
trigger2 = Var(7) = 1
trigger2 = p2bodydist x = [61,100]
sysvar(4) = 1

[State 40, 7]
type = VarSet
trigger1 = command = "holdback"
sysvar(4) = -1

[State 40, 8]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(4)=0, const(velocity.jump.neu.x), ifelse(sysvar(4)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 9]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 101 ;前ダッシュ
trigger1 = sysvar(4) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
;ジャンプ上昇
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(4) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 40, 13]
type = ChangeState
triggerall = Var(7) = 1
trigger1 = p2bodydist x = [0,25]
trigger1 = p2stateno != 5120
trigger1 = Vel Y > 0
value = 680

