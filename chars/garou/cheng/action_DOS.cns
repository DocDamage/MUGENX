; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = var(22) = 0
value = 120 + (statetype = C) + (statetype = A)*2

[State 120, 1]
type = ChangeAnim
triggerall = statetype != A
triggerall = statetype != C
trigger1 = var(22) = 1
trigger1 = Time = 0
value = 123

[State 120, 1]
type = ChangeAnim
triggerall = statetype != A
triggerall = statetype = C
trigger1 = var(22) = 1
trigger1 = Time = 0
value = 121

[State 120, 1]
type = ChangeAnim
triggerall = statetype = A
trigger1 = var(22) = 1
trigger1 = Time = 0
value = 122

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

