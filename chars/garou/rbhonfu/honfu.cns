; これはカンフーマンのＣＮＳファイルです。
; コメントを参考にしてＣＮＳを理解してください

; これはKFMの定数と状態のファイルです。
; 絶対記入し、削除はしないでください。
[Data]
  ;体力ゲージの初期値
life = 1000
  ;攻撃力（これ以上に設定すると強くなる）
attack = 100
  ;防御力（これ以上に設定すると強くなる）
defence = 100
  ;コンボをくらっている時にあがる防御力
fall.defence_up = 50
  ;倒れてから起上がるまでのフレーム数
liedown.time = 60
  ;空中でどれだけコンボが繋がるか（高くすると無限コンボになるので注意）
airjuggle = 15
  ;hitdefで設定していない時の基本ヒットスパークナンバー
sparkno = s10000
  ;設定してない時のガードナンバー
guard.sparkno = s11000
  ;KOした時に声にエコーをかけるか（１でＯＮ）
KO.echo = 0
 volume = 200
  IntPersistIndex = 60
FloatPersistIndex = 40
power = 2000

[Size]
xscale = 1           ;水平方向の縮尺（通常１）
yscale = 1           ;垂直方向の縮尺（通常１）
ground.back = 15     ;キャラの幅(後方,地上)
ground.front = 16    ;キャラの幅(前方,地上)
air.back = 12        ;キャラの幅(後方,空中)
air.front = 12       ;キャラの幅(前方,空中)
height = 60          ;キャラの高さ
attack.dist = 160    ;攻撃をした時相手がガード体制に入る最低距離
proj.attack.dist = 90;攻撃をした時相手がガード体制に入る最低距離（飛び道具）
proj.doscale = 0     ;上で設定した縮尺を飛び道具にも適用するか（１でＯＮ）   
head.pos = -5, -90   ;頭の大体の座標
mid.pos = -5, -60    ;体の中心の大体の座標
shadowoffset = 0     ;影の垂直方向のオフセット
draw.offset = 0,0    ;使用しない

[Velocity]
walk.fwd  = 2.3
walk.back = -2.2
run.fwd  = 4.6
run.back = -5,-2.5
jump.neu = 0,-10   ;垂直ジャンプの速度
jump.back = -3    ;後ジャンプの速度
jump.fwd = 3       ;前ジャンプの速度
runjump.back = -2.55,-8.1 ;後ダッシュしながらのジャンプ速度(オプション)
runjump.fwd = 4,-8.1      ;前ダッシュしながらのジャンプ速度(オプション)
airjump.neu = 0,-8.1      ;２段ジャンプ以降の垂直ジャンプの速度(オプション)
airjump.back = -2.55      ;２段ジャンプ以降の後ジャンプの速度(オプション)
airjump.fwd = 2.5         ;２段ジャンプ以降の前ジャンプの速度

[Movement]
airjump.num = 0      ;空中でジャンプする回数
airjump.height = 40  ;空中でジャンプする最低限の高さ
yaccel = .55       ;重力
stand.friction = .85  ;立ち状態の摩擦係数
crouch.friction = .82 ;屈み状態の摩擦係数

;---------------------------------------------------------------------------
; ステイトの解説
; [Statedef STATENO]
; type = ?      S/C/A/L  Ｓ：立ち/Ｃ：屈み/Ａ：空中/Ｌ：ダウン
; movetype = ?  I/A/H    Ｉ：通常状態/Ａ：攻撃状態/Ｈ：ダメージをくらってる状態
; physics = ?   S/C/A/N  Ｓ：立ち/Ｃ：屈み/Ａ：空中/Ｎ：無し
; juggle = ?             その攻撃に使うジャグル数
;

;---------------------------------------------------------------------------
;立ち
[StateDef 0]
type = S
physics = S
velSet = 0, 0
sprPriority = 0
anim = 0

[State 0]
type = ChangeState
trigger1 = Anim != 0 || (Anim != 1 && P2Dist X < 81)
value = 1
;---------------------------------------------------------------------------
;立ち
[StateDef 1]
type = S
physics = S
velSet = 0, 0
sprPriority = 0
anim = 1

[State 0]
type = ChangeState
trigger1 = P2Dist X > 81
trigger2 = P2Dist X < -1
value = 0
;---------------------------------------------------------------------------
;前ダッシュ開始
[Statedef 100]
type = S
movetype = I
physics = S
velset = 0
ctrl = 0
anim = 100

[State 220, 3];前に進む
type = Velset
trigger1 = time = [4,10]
x = 8

[State 220, 3];前に進む
type = VelAdd
trigger1 = time = [15,20]
x = 0.3

[State 180, win]
type = PlaySnd
trigger1 = time = 11
value = 400, 1

[State 1100, kemuri]
type = explod
trigger1 = time = 3
pos = -30, -13
postype = p1
anim = 12100
facing = 1
sprpriority = 3
bindtime = 1
removetime = 10
ignorehitpause = 1
persistent = 0


[State 195, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
;---------------------------------------------------------------------------
;バックステップ開始
[Statedef 105]
type = S
movetype = I
physics = S
velset = 0
ctrl = 0
anim = 105

[State 1051, 1]
type = VelSet
trigger1 = animelem = 2
x = -3

[State 105, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 106
;---------------------------------------------------------------------------
;バックステップ中
[Statedef 106]
type = A
movetype = I
physics = N
velset = 0,0
anim = 106

[State 106, 音]
type = PlaySnd
trigger1 = time = 0
value = 500,0

[State 1051, 1]
type = VelSet
trigger1 = animelem = 1
x = -5

[State 1051, 1]
type = VelSet
trigger1 = animelem = 4
x = -8

[State 106, 2]
type = ChangeState
trigger1 = animtime = 0
value = 107
;---------------------------------------------------------------------------
;バックステップ着地
[Statedef 107]
type = S
movetype = I
physics = S
velset = 0,0
ctrl = 0
anim = 107

[State 107, 音]
type = PlaySnd
trigger1 = time = 0
value = s0,4

[State 107, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
;---------------------------------------------------------------------------
;タイムオーバーで負けた時
[Statedef 170]
type = S
ctrl = 0
anim = 175
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1
;---------------------------------------------------------------------------
; 勝った動作ランダム
[Statedef 180] 
type = S 
physics = S 
velset = 0 

[State 180, 8]
type = VarRandom
trigger1 = Time = 0
v = 1
range = 3

[State 180,1]
type = ChangeState 
trigger1 = Time = 1 && var(1) = 0
value = 181

[State 180,1]
type = ChangeState 
trigger1 = Time = 1 && var(1) = 1
value = 182

[State 180,1]
type = ChangeState 
trigger1 = Time = 1 && var(1) = 2
value = 183

[State 180,1]
type = ChangeState 
trigger1 = Time = 1 && var(1) = 3
value = 184

;---------------------------------------------------------------------------
;勝利1
[Statedef 181]
type = S
ctrl = 0
anim = 180
velset = 0,0

[State 180, win]
type = PlaySnd
trigger1 = AnimElem = 1
value = 1000, 21

