[Info]
name = "Honfu"        ;キャラの名前
displayname = "Honfu" ;表示されるキャラの名前
author = "montana"         ;キャラの製作者名
pal.defaults = 1,2,3,4,5      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = honfu.cmd   ;キャラのコマンド
cns     = honfu.cns   ;キャラのプログラム
st      = honfu.cns   ;基本
st1     = honfu2.cns  ;通常技
st2     = honfu3.cns  ;必殺技
st3     = honfu4.cns  ;その他
st4     = honfu5.cns  ;音声関係
stcommon = common1.cns 
sprite  = honfu.sff   ;キャラの絵
anim    = honfu.air   ;キャラの動き
sound   = honfu.snd   ;キャラの音
pal1    = honfu.act
pal2    = 1.act
pal3    = 2.act
pal4    = 3.act
pal5    = 4.act
pal6    = 5.act