;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]
;----------------------------------------------
;varと相対距離のチェック用。
;面倒な処理しだすとかなり助かります。
;--------------------------------------------------------------------------------------------
[State -2,]
type = DisplayToClipboard
trigger1 = 1
text = "etc=%d,ikari=%d, kenki=%f,Distance X=%d,Y=%d"
params = var(35) ,var(15) ,fvar(10) ,floor(P2BodyDist X) ,floor(P2BodyDist Y)
;--------------------------------------------------------------------------------------------

;[State -2, kesu];同キャラの勝利画面でゲージ類を消去 （自キャラを調整しても他のキャラは無理なので保留） 
;type = removeExplod
;trigger1 = p2name = "Yumeji Kurokouchi"　&&  p2stateno = 189
;trigger2 = p4name = "Yumeji Kurokouchi"　&&  p2stateno = 189

[State -2,]; CPUデモ有り
type = Varset
trigger1 = PalNo =[7,12]
v = 30
value = 1

[State -2];剣気減少
Type = Varadd
triggerall = var(41) = 1
;triggerall = stateno !=[3300,3314]
;triggerall = p2stateno !=[3320,3323]
;triggerall = movetype = A
trigger1 = fvar(11) >= p2life
fvar(10) =(fvar(10)-(fvar(11)-p2life))*0.002
ignorehitpause = 1

[State -2,];2Pの体力値
type = Varset
trigger1 = 1
fvar(11) = p2life
ignorehitpause = 1
;--------------------------------------------------------------------------------------------  ＢＯＳＳ補正
