; Definition file for Player
; Contains all the filenames needed for the character
; Template player 9X-09-12

; Character information
[Info]
name    = "TamTam";<-- Replace with a real name
displayname = "TAMTAM";<-- Replace with name to display

; Files for the character
[Files]
cmd     = tamtam.cmd     ;Command set
cns     = tamtam.cns     ;Constants
st      = tamtam.cns     ;States
stcommon = common1.cns   ;Common states
sprite  = tamtam.sff     ;Sprite
anim    = tamtam.air     ;Animation
sound   = tamtam.snd     ;Sound
;pal1    = player.act     ;Palettes
;pal2    = player2.act
;pal3    = player3.act
;pal4    = player4.act
;pal5    = player5.act
;pal6    = player6.act
