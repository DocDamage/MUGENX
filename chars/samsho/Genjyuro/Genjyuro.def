; ここにキャラ情報を書いてください
[Info]
name = "Genjyuro"        ;キャラの名前
displayname = "Genjyuro" ;表示されるキャラの名前
versiondate = 11,22,2000    ;キャラの更新情報
mugenversion = 11,22,2000   ;キャラが動くmugenのバージョン
author = "ahuron"         ;キャラの製作者名
pal.defaults = 1      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = Genjyuro.cmd   ;キャラのコマンド
cns     = Genjyuro.cns   ;キャラのプログラム
st      = Genjyuro.cns   ;基本動作、必殺技、特殊ゲージ、-2、-3
st2     = Genjyuro2.cns  ;モード超必殺技
st3     = Genjyuro3.cns  ;表示エフェクト
stcommon = common1.cns 
sprite  = Genjyuro.sff   ;キャラの絵
anim    = Genjyuro.air   ;キャラの動き
sound   = Genjyuro.snd   ;キャラの音
pal1    = Genjyuro2.act   ;キャラの色（最大１２個）
pal2    = Genjyuro2.act
pal3    = Genjyuro2.act
pal4    = Genjyuro.act
pal5    = Genjyuro.act
pal6    = Genjyuro.act
