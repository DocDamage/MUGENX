[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = S1991
KO.echo = 0
volume = 25
IntPersistIndex = 40
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 15     ;Player width (back, ground)
ground.front = 17    ;Player width (front, ground)
air.back = 16        ;Player width (back, air)
air.front = 16       ;Player width (front, air)
z.width = 3          ;Player width (into and out)
height = 60	     ;Height of player (for opponent to jump over)
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = -5, -55   ;Approximate position of head
mid.pos = 0, -35    ;Approximate position of midsection
shadowoffset = 0

[Velocity]
walk.fwd  = 2.0      ;Walk forward
walk.back = -1.8     ;Walk backward
run.fwd  = 6, 0    ;Run forward (x, y)  - if y<0, player will hop
run.back = -5, -3   ;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-11.1    ;Neutral jumping velocity (x, y)
jump.back = -2    ;Jump back Speed (x, y)
jump.fwd = 2.1       ;Jump forward Speed (x, y)
runjump.back = -2.55,-9.8 ;Running jump speeds (opt)
runjump.fwd = 3,-9.8      ;.
airjump.neu = 0, -9.8 ;-8.1      ;.
airjump.back = -2.55,-9.8 ;Air jump speeds (opt)
airjump.fwd = 2.5,-9.8   ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .44 ;39         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; LOSE (Time over)
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0,0

[State 170, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

;---------------------------------------------------------------------------
; WIN
[Statedef 180]
type = S
ctrl = 0
velset = 0,0,0

    [State 180, begin]
    type = AssertSpecial
    trigger1 = Time = [1,400]
    flag = roundnotover

[State 180, RANDOM]
type = varRandom
trigger1 = Time = 0
v = 8
range = 0, 4

[State 180, RANDOM]
type = ChangeAnim
trigger1 = Time = 1
value = 180 + var(8)

[State 180, NAME]
type = PlaySnd
trigger1 = Time = 40
value = 7, 25

[State 180, NAME]
type = Explod
trigger1 = time = 40
trigger1 = Pos X >= 0
anim = 10099
pos = 100,180
postype = left
sprpriority = 20
ownpal = 1
ontop = 1

[State 180, NAME]
type = Explod
trigger1 = time = 40
trigger1 = Pos X < 0
anim = 10099
pos = 220,180
postype = left
sprpriority = 20
ownpal = 1
ontop = 1

[State 180, LAUGH]
type = PlaySnd
trigger1 = anim = 180 && animelem = 4
value = 7, 22

[State 180, *CRACK*]
type = PlaySnd
trigger1 = anim = 180 && animelem = 24
value = 9, 9

[State 180, *CRACK*]
type = PlaySnd
trigger1 = anim = 180 && animelem = 44
value = 10, 1

[State 180, PING]
type = PlaySnd
trigger1 = anim = 181 && animelem = 13
value = 7, 23

[State 180, BEARD]
type = PlaySnd
trigger1 = anim = 182 && animelem = 6
trigger2 = anim = 182 && animelem = 10
value = 7, 24
volume = 100

[State 180, SMOKE]
type = PlaySnd
trigger1 = anim = 183 && animelem = 12
trigger2 = anim = 184 && animelem = 16
value = 7, 32

;--------------------------------------------------------------------------
; INTRO
[Statedef 190]
type = S
ctrl = 0
velset = 0,0,0
anim = 190

    [State 190, 2] 
    type = AssertSpecial
    trigger1 = Time = [0,200]
    flag = Intro

[State 190, VS_GENJURO]
type = ChangeAnim
triggerall = Time = 0
trigger1 = p2name = "Kibagami Genjuro"
trigger2 = p4name = "Kibagami Genjuro"
value = 191

[State 190, VS_HAOHMARU]
type = ChangeAnim
triggerall = Time = 0
trigger1 = p2name = "Haohmaru"
trigger2 = p4name = "Haohmaru"
value = 192

[State 180, STOMP]
type = PlaySnd
triggerall = anim = 191 && time >= 90 && time < 184
trigger1 = timemod = 10,0
value = 7, 19

[State 180, LAUGH]
type = PlaySnd
trigger1 = anim = 192 && AnimElem = 2
value = 7, 22

