triggerall = UniqHitCount <= 1 && GetHitVar(hitcount) <= 3
trigger1 = (stateno = 5001 && anim = 5000) || (stateno = 5001 && anim = 5010) || (stateno = 5011 && anim = 5020) 
var(4) = 30
ignorehitpause = 1

