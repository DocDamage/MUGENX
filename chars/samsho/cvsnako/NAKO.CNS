;Nakoruru Cns Document Files
;====================================
;Sound assignments
;====================================
;channel = 1 = 기모으기 효과음
;channel = 2 = 뺑글이
;channel = 3 = 기모으기 기합
;channel = 4 = 마마하하 날기
;channel = 9 = 힐
;channel = 10 = 도발
;====================================
;====================================
;Var assignments
;====================================
;Var(1)  = Intro/Win Select
;Var(2)  = 이단판정
;Var(3)  = 그로기 모드
;Var(4)  = 그로기 해제
;Var(5)  = 잡기 풀기 source from SanderX
;Var(7)  = Special Finish
;Var(8)  = jump
;Var(9)  = 카운터 어택 표시 시스템
;Var(10)  = 마마하하 잡기 카운터
;Var(11)  = 
;Var(12)  = 가드 크러시
;Var(13)  = 오펜스 가드 크러시
;Var(14)  = 기합소리용
;Var(15)  = 
;Var(16)  =
;Var(17)  = 
;Var(18)  = 페이싱
;Var(19)  = intro
;Var(20)  = 마마하하 백대쉬
;Var(21)  = 카무이림새 관련
;Var(22)  = 마마하하 중립
;Var(23)  = 마마하하 행동
;Var(24)  = 나코 힐 에너지 계산
;Var(25)  =
;Var(26)  =
;Var(27)  =
;Var(28)  =
;Var(29)  = 
;Var(30)  = 
;Var(31)  = 
;Var(32)  =
;Var(33)  =
;Var(34)  =
;Var(36)  = 
;Var(40)  = 

[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = S3
guard.sparkno = s49
guardsound = s6, 0
KO.echo = 0
volume = 200
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 25
ground.front = 26
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -90
mid.pos = -5, -60
shadowoffset = -2
draw.offset = 0,0

[Velocity]
walk.fwd  = 2.8
walk.back = -2.6
run.fwd  = 6, 0
run.back = -4.5,-3.8
jump.neu = 0,-9
jump.back = -2.75
jump.fwd = 2.7
runjump.back = -2.55,-8.1
runjump.fwd = 4,-8.1

[Movement]
airjump.num = 0
airjump.height = 35
;yaccel = .44
yaccel = .50
stand.friction = .82
crouch.friction = .82

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; JUMP_UP
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
velset = 0,0

[State 40, 0.0]
type = VarSet
trigger1 = Time = 0
var(8) = 0

[State 40, 0.1]
type = VarSet
trigger1 = command = "holdfwd"
trigger1 = var(8) != 2
var(8) = 1

[State 40, 0.2]
type = VarSet
trigger1 = command = "holdback"
trigger1 = var(8) != -2
var(8) = -1

[State 40, 0.1b]
type = VarSet
triggerall = Time = 0
triggerall = command = "holdfwd"
trigger1 = command = "longjump"
trigger2 = prevstateno = 100 ;RUN_FWD
var(8) = 2

[State 40, 0.2b]
type = VarSet
trigger1 = Time = 0
trigger1 = command = "holdback"
trigger1 = command = "longjump"
var(8) = -2

[State 40, 4]
type = ChangeState
triggerall = AnimTime = 0
trigger1 = var(8) != 0
trigger1 = var(8) != 1
trigger1 = var(8) != -1
trigger1 = command = "holdup"
trigger2 = command != "holdup"
value = 2041

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(var(8)=0, const(velocity.jump.neu.x), ifelse(var(8)>0, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; JUMP_UP (short)
[Statedef 2041]
type    = A
physics = A
velset = 0, -6
ctrl = 1

[State 2041, 1a] ; Play sound when jumping (normal)
type = PlaySnd
trigger1 = Time = 0
trigger1 = var(8) != -2
trigger1 = var(8) != 2
value = 40,0

[State 2041, 1b] ; Play sound when jumping (long)
type = PlaySnd
triggerall = Time = 0
trigger1 = var(8) = -2
trigger2 = var(8) = 2
value = 40,0

[State 2041, 2] ; Shadows
type = Afterimage
triggerall = Time = 0
trigger1 = var(8) = -2
trigger2 = var(8) = 2
time = 17
length = 9
PalBright   =   0,  0,  0
PalContrast = 128,128,128
PalAdd      =   0,  0,  0
PalMul      =  1,1,1;.9, .9, .9
FrameGap = 3
Trans = Add1

[State 2041, 2] ; Shadows off
type = Afterimage
trigger1 = Time = 14
time = 0

[State 2041, -0.1] ;Holding up?
type = VelSet
trigger1 = Time = 0
trigger1 = command = "holdup"
y = -8.8

[State 2041, 0.1]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(8) = 1
x = 3.8

[State 2041, 0.1b]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(8) = 2
x = 4.4

[State 2041, 0.2]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(8) = -1
x = -3.8

[State 2041, 0.2b]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(8) = -2
x = -4.4

[State 2041, 1.1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X = 0
trigger1 = command = "holdup"
value = 41

[State 2041, 1.2] ;Short
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X = 0
trigger1 = command != "holdup"
value = 41

[State 2041, 2.1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X > 0
trigger1 = command = "holdup"
value = 42

[State 2041, 2.2] ;Short
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X > 0
trigger1 = command != "holdup"
value = 41

[State 2041, 3.1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X < 0
trigger1 = command = "holdup"
value = 43

[State 2041, 3.1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X < 0
trigger1 = command != "holdup"
value = 41

