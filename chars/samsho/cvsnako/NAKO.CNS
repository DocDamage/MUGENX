;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = command != "holdfwd"
value = 101

[State 100, 5]
type = ChangeState
triggerall = var(0) = 1
triggerall = P2statetype != C
triggerall = P2Movetype = A
triggerall = Stateno != 1404
trigger1 = Time = 0
value = 40

[State 100, 5]
type = ChangeState
triggerall = ((var(0) = 1) && (P2stateno = 160))
triggerall = ((P2statetype = S) && (P2Movetype != A))
trigger1 = P2BodyDist X <= 40
value = 435 ;Sliding kick

[Statedef 101]
type = S
ctrl = 0
physics = S
anim = 101
velset = 5,0

[State 101, Snd]
type = PlaySnd
trigger1 = time = 0
value = 100,1

[State 101, Ctrl]
type = CtrlSet
trigger1 = time >= 8
value = 1

[State 101, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

