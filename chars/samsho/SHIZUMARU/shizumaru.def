
[Info]
name = "Hisame Shizumaru"
displayname = "Shizumaru"
versiondate = 12,06,2000
mugenversion = 11,29,2000
author = "masquer"
pal.defaults = 1,2,3,4,5,6

[Files]
cmd     = hs.cmd         ;招式   
cns     = hs.cns         ;角色定義
st      = normal1.cns    ;一般攻擊定義
st1     = supers1.cns    ;sp1~sp2 定義
st2     = supers2.cns    ;sp3~sp4 定義
st3     = supers3.cns    ;sp5~sp8 定義
st4     = supers4.cns    ;sp9~sp13 定義
st5     = normal2.cns    ;一般攻擊定義
stcommon =common.cns     ;基本定義
sprite  = hs.sff         ;圖檔
anim    = hs.air         ;圖檔定義
sound   = hs.snd         ;聲音檔(44100Hz.16bit.mono)
pal1    = 01.act         ;2P修羅色
pal2    = 02.act        ;1P修羅色
pal3    = 03.act        ;2P羅煞色
pal4    = 04.act        ;1P羅煞色
pal5    = 05.act        ;四代1P羅煞色
pal6    = 06.act        ;女性版色(皮膚有比較白喔) ^O^
