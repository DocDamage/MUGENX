; ここにキャラ情報を書いてください
[Info]
name = "genan"        ;キャラの名前
displayname = "Gen-an" ;表示されるキャラの名前
versiondate = 9,14,2000    ;キャラの更新情報
mugenversion = 11,29,2000   ;キャラが動くmugenのバージョン
author = "kojya"         ;キャラの製作者名
pal.defaults = 6,3,4,2      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = genan.cmd   ;キャラのコマンド
cns     = genan.cns   ;キャラのプログラム
st      = genan.cns   ;キャラのプログラム
st2     = gewaza.cns
st3     = gehyper.cns
stcommon = common1.cns 
sprite  = genan.sff   ;キャラの絵
anim    = genan.air   ;キャラの動き
sound   = genan.snd   ;キャラの音
pal1    = genan.act  ;キャラの色（最大１２個）
