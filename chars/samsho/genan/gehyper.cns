
;---------------------------------------------------------------------------
; 三連カンフー突き手(超必殺)
; 
;        さて、これは超必殺技のステートです。
;        注目する事はgetpowerが0になっている事です、通常超必殺はゲージを使って
;        発動する物なのでゲージが増えるのは変ですね？なので0になっています
;        攻撃の状態はattr = S, HAですＳ：立ち状態　Ｈ：超必殺　Ａ：攻撃です。
;        後、上でHitDefは一つに統合できると書きましたがここではそれを使用しています。
;        HitDefを見ると
;        trigger1 = AnimElem = 5
;        trigger2 = AnimElem = 12
;        となっていますね？これの意味は「スプライトステートの５枚目と９枚目の絵の時に」
;        という意味になります、triggerが1と2なのは条件を表しもし両方とも1ならば
;        意味が変わってきます。例えば「スプライトステートの１枚目の２０フレーム目」とするなら
;        trigger1 = AnimElem = 1
;        trigger1 = time = 20
;        と書けばＯＫです。
[Statedef 3000]
type    = S
movetype= A
physics = S
juggle  = 4
velset = 5,0
anim = 3000
ctrl = 0
sprpriority = 2

[State 1000, 1]
type = PosAdd
trigger1 = 1
x = 5

[State 3000, Width]
type = Width
trigger1 = AnimElem = 2, >= 0
value = 15,0

[State 3000, Super A]
type = SuperPause
Trigger1 = Time = 0
;trigger1 = AnimElem = 1, 1
pos = -100, -155
anim = S901
sound = 20, 0
poweradd = -1000
time = 75

[State 3000, Super B]
type = AfterImage
trigger1 = AnimElem = 2, 1
time = 2

[State 3000, Super C]
type = AfterImageTime
trigger1 = AnimElemTime(2) >= 1 && Time < 60
time = 2

[State 3000, Super D]
type = NotHitBy
trigger1 = AnimElem = 2
value = , NA, SA, AT
time = 12

[State 3000, Super E]
type = NotHitBy
trigger1 = AnimElemTime(2) >= 0 && Time < 30
value2 = C, NA
time = 1

;[State 3000, 1]
;type = PlaySnd
;trigger1 = AnimElem = 2
;trigger2 = AnimElem = 4
;trigger3 = AnimElem = 6
;value = 1, 0

[State 3000, 5]
type = PosAdd
trigger1 = AnimElem = 5
x = 5

[State 3000, 6]
type = HitDef
Trigger1 = Time = 0
attr = S, NA;T
hitflag = M
guardflag = M
priority = 1, Miss
sparkno = -1
sprpriority = 1
p2facing = 1
p1stateno = 3001
p2stateno = 3002
fall = 1

[State 3000, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;まわってる
[Statedef 3001]
type    = S
movetype= A
physics = S
velset = 0,0
anim = 3001
ctrl = 0
sprpriority = 1

[State 3001, 1]
type = PlaySnd
Trigger1 = Time = 0
value = 1, 2

[State 3001, 1]
type = PlaySnd
Trigger1 = Time = 0
value = 1, 2

[State 3001, 1]
type = PlaySnd
trigger1 = AnimElem = 4
value = 2, 5

[State 3001, 1]
type = PlaySnd
trigger1 = AnimElem = 4
value = 2, 5

[State 3001, Bind 1]
type = TargetBind
trigger1 = AnimElemTime(18) < 0
pos = 0, 0

[State 3000,00]
type = AllPalfx
trigger1 = AnimElem = 2
trigger2 = AnimElem = 4
trigger3 = AnimElem = 6
trigger4 = AnimElem = 8
trigger5 = AnimElem = 10
trigger6 = AnimElem = 12
trigger7 = AnimElem = 14
trigger8 = AnimElem = 16
trigger9 = AnimElem = 18
trigger10 = AnimElem = 20
trigger11 = AnimElem = 22
add = 80,10,10
sinadd = 10, 10, 10
time = 3

[State 3001, ]
type = TargetLifeAdd
trigger1 = AnimElem = 2
trigger2 = AnimElem = 4
trigger3 = AnimElem = 6
trigger4 = AnimElem = 8
trigger5 = AnimElem = 10
trigger6 = AnimElem = 12
trigger7 = AnimElem = 14
trigger8 = AnimElem = 16
trigger9 = AnimElem = 18
trigger10 = AnimElem = 20
trigger11 = AnimElem = 22
value = -25

[State 3001, 5]
type = PlaySnd
trigger1 = AnimElem = 2
trigger2 = AnimElem = 4
trigger3 = AnimElem = 6
trigger4 = AnimElem = 8
trigger5 = AnimElem = 10
trigger6 = AnimElem = 12
trigger7 = AnimElem = 14
trigger8 = AnimElem = 16
trigger9 = AnimElem = 18
trigger10 = AnimElem = 20
trigger11 = AnimElem = 22
value = 1, 7

[State 3002, 6]
type = TargetState
trigger1 = AnimElem = 22
value = 3003

[State 3001, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 105
ctrl = 0

;あいて
[Statedef 3002]
type    = S
movetype= H
physics = N
ctrl = 0
sprpriority = 2

[State 3002, 1]
type = ChangeAnim2
Trigger1 = Time = 0
value = 3002

[State 3002, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;相手終わり
[Statedef 3003]
type    = A
movetype= H
physics = N
velset = -2.8,-7

[State 821, 1]
type = VelAdd
Trigger1 = 1
y = .4

[State 821, 2]
type = ChangeState
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5200

[State 821, 3] 
type = SelfState
triggerall = Vel Y > 0
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5210 

[State 821, 4] 
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 5100 
