;==============================================================================================
;
; RERA'S CONSTANTS
;
;==============================================================================================

[Data]
life = 1000				;Amount of life to start with
power = 1000			;Maximum power of the char
attack = 100			;attack power (more is stronger)
defence = 84			;defensive power (more is stronger)
fall.defence_up = 50		;Percentage to increase defense everytime player is knocked down
liedown.time = 60			;Time which player lies down for, before getting up
airjuggle = 15			;Number of points for juggling
sparkno = 2				;Default hit spark number for HitDefs
guard.sparkno = 40		;Default guard spark number
KO.echo = 0				;1 to enable echo on KO
volume = 100				;Volume offset (negative for softer)

IntPersistIndex 	= 20
FloatPersistIndex = 40

[Size]
xscale		= 1		;Horizontal scaling factor.
yscale		= 1		;Vertical scaling factor.
ground.back		= 27		;Player width (back, ground)
ground.front	= 18		;Player width (front, ground)
air.back		= 16		;Player width (back, air)
air.front		= 23		;Player width (front, air)
height		= 70		;Height of player (for opponent to jump over)
attack.dist		= 160		;Default attack distance
proj.attack.dist	= 90		;Default attack distance for projectiles
proj.doscale	= 0		;Set to 1 to scale projectiles too
head.pos		= 12, -70	;Approximate position of head
mid.pos		=  0, -45	;Approximate position of midsection
shadowoffset	= -1		;Number of pixels to vertically offset the shadow
draw.offset		= 0		;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd		=  3.00,0		;Walk forward
walk.back		= -2.50,0		;Walk backward
run.fwd 		=  7.25,0		;Run forward (x, y)
run.back		= -9.20,-3		;Run backward (x, y)
jump.neu		=  0,-13.9		;Neutral jumping velocity (x, y)
jump.back		= -3.25,-13.9	;Jump back Speed (x, y)
jump.fwd		=  3.50,-13.9	;Jump forward Speed (x, y)
runjump.back	= -4.75,-13.9	;Running jump speeds (opt)
runjump.fwd		=  5.25,-13.9	;
airjump.neu		=  0.00,-11.875	;
airjump.back	=  0			;Air jump speeds (opt)
airjump.fwd		=  4.6		;

[Movement]
airjump.num 	= 0    	;Number of air jumps allowed (opt)
airjump.height 	= 0	  	;Minimum distance from ground before you can air jump (opt)
yaccel 		= .66		;Vertical acceleration
stand.friction 	= .85  	;Friction coefficient when standing
crouch.friction 	= .82	 	;Friction coefficient when crouching



;==============================================================================================
;
; NAKORURU'S VARS AND CHANNELS
;
;==============================================================================================

; Var 0 = Nakoruru state definer :
;		- 0  -> on her feet
;		- 10 -> carried by Mamahaha
;		- 20 -> riding Sikuruu
; Var 1 = super attack level definer
;		- 1 -> level 1
;		- 2 -> level 2
;		- 3 -> level 3
; Var 3 = special attack level definer
;		- 1 -> light
;		- 2 -> medium
;		- 3 -> fierce
; Var  4 = long jump var
; Var  5 = misc :
;		- life recovery timer
;		- get off Sikuruu direction
; Var  6 = intro & ending randomizer
;
; Var  7 = dizzy gauge 
; Var  8 = guard gauge
;
; Var  9 = bloody ending switch
; Var 10 = super ending switch
;
; Var 15 = sound randomizer 1
; Var 16 = sound randomizer 2
; Var 17 = sound randomizer 3
; Var 18 = voices randomizer 1
; Var 19 = voices randomizer 2
;
; var 20 = rage mode enabler
; var 21 = rage gauge
; var 22 = rage explosion mode enabler
; var 23 = hit gauge
; var 24 = life gauge
;
; var 25 = Myu no Kyouchi enabler
; var 26 = Myu no Kyouchi timer
;
; Var 59 = AI definer
;		- 0 -> off
;		- 1 -> on



; channel 0 = Nakoruru voice
; channel 1 = Nakoruru effects (run, brake, jump, land, slash...)
; channel 2 = Nakoruru/enemy effects (sparks sounds)
; channel 3 = Shikuruu voice
; channel 4 = Shikuruu effects
; channel 5 = Mamahaha voice & effects

