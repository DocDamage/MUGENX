; ここにキャラ情報を書いてください
[Info]
name = "Gaoh"        ;キャラの名前
displayname = "Gaoh" ;表示されるキャラの名前
versiondate = 02,04,2006    ;キャラの更新情報
mugenversion = 02,04,2006   ;キャラが動くmugenのバージョン
author = "shimon"         ;キャラの製作者名
pal.defaults = 6,3,4,2      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = gaoh.cmd   ;キャラのコマンド
cns     = gaoh.cns   ;キャラのプログラム
st      = gaoh.cns   ;キャラのプログラム
stcommon = common1.cns 
sprite  = gaoh.sff   ;キャラの絵
anim    = gaoh.air   ;キャラの動き
sound   = gaoh.snd   ;キャラの音
pal1    = 2p.act     ;Aキャラの色(B)
pal2    = 4p.act     ;Bキャラの色(D)
pal3    = gaoh.act   ;Cキャラの色
pal4    = gaoh.act   ;Xキャラの色(A)
pal5    = 3p.act     ;Yキャラの色(C)
pal6    = gaoh.act   ;Zキャラの色

pal7    = gaoh.act  ;キャラの色（最大１２個）
pal8    = gaoh.act  ;キャラの色（最大１２個）
pal9    = gaoh.act  ;キャラの色（最大１２個）
pal10   = gaoh.act  ;キャラの色（最大１２個）
pal11   = gaoh.act  ;キャラの色（最大１２個）
pal12   = gaoh.act  ;キャラの色（最大１２個）



