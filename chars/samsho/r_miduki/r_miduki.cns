[Data]
life = 1000          ;Amount of life to start with
attack = 100         ;100% attack power (more is stronger)
defence = 100        ;100% defensive power (more is stronger)
fall.defence_up = 50 ;Def goes up by 50% everytime player is hit on ground
liedown.time = 60    ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 20       ;Can do 15 points of juggling
sparkno = 2        ;Default spark number
guard.sparkno = 40 ;Default guard spark number
KO.echo = 0          ;1 to enable echo on KO
volume = 0           ;Volume offset (negative for softer)

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 18     ;Player width (back, ground)
ground.front = 22    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
z.width = 3          ;Player width (into and out)
height = 60	     ;Height of player (for opponent to jump over)
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = -5, -90   ;Approximate position of head
mid.pos = -5, -60    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow

[Velocity]
walk.fwd  = 2.3      ;Walk forward
walk.back = -1.8     ;Walk backward
run.fwd  = 0, 0    ;Run forward (x, y)  - if y<0, player will hop
run.back = -4, -4 ;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-8.0    ;Neutral jumping velocity (x, y)
jump.back = -2.55    ;Jump back Speed (x, y)
jump.fwd = 2.5       ;Jump forward Speed (x, y)
runjump.back = -2.55,-9.0 ;Running jump speeds (opt)
runjump.fwd = 4,-9.0      ;.
airjump.neu = 0,-7.0      ;.
airjump.back = -2.55,-7.0 ;Air jump speeds (opt)
airjump.fwd = 2.5,-7.0    ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .30         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; 前ダッシュ
[Statedef 100]
type    = S
physics = N
velset = 0,0
ctrl = 0
anim = 100

[State 100, 0]
type = PlayerPush
trigger1 = Time >= 0
value = 0

[State 100, 0]
type = PlaySnd
trigger1 = Time = 0
value = 1, 2

[State 100, 1]
type = velset
trigger1 = AnimElem = 1,>=0
x = 8

[State 100, 3]
type = ChangeState
trigger1 = Time >= 24
trigger2 = Time >= 8
trigger2 = command != "holdfwd"
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; バックステップ
[Statedef 105]
type    = A
physics = A
ctrl = 0
anim = 105

[State 100, 0]
type = PlayerPush
trigger1 = Time >= 0
value = 0

[State 100, 0]
type = PlaySnd
trigger1 = Time = 0
value = 1, 2

[State 100, 0]
type = VelSet
trigger1 = Time = 0
x = -4
y = -4

[State 105, 5]
type = Posset
trigger1 = Pos y > -5
trigger1 = Vel y > 0
y = 0

[State 105, 5]
type = ChangeState
trigger1 = Pos y > -5
trigger1 = Vel y > 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; LOSE (Time over)
[Statedef 170]
type = S
ctrl = 0
velset = 0,0,0
anim = 170

;[State 170, 0]
;type = PlaySnd
;trigger1 = time = 12
;value = 3, 0

[State 170, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

;---------------------------------------------------------------------------
; WIN
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = 181

;---------------------------------------------------------------------------
; WIN1
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0,0

[State 181, 名前]
type = explod
trigger1 = facing = 1
persistent = 0
removetime = -1
anim = 182
pos = 30, -140
postype = p1
sprpriority = 2
bindtime = 1000
facing = 1
ontop =1

[State 181, 名前]
type = explod
trigger1 = facing = -1
persistent = 0
removetime = -1
anim = 182
pos = 75, -140
postype = p1
sprpriority = 2
bindtime = 1000
facing = -1
ontop =1

[State 181, 1]
type = PlaySnd
trigger1 = Time = 0
value = 1, 0

[State -2, Attack]
type = VarRandom
trigger1 = Time = 0
v = 0
range = 0, 2

[State 181, 1]
type = PlaySnd
trigger1 = Time = 70
trigger1 = var(0) < 1.3
value = 3, 9

[State 181, 1]
type = PlaySnd
trigger1 = Time = 70
trigger1 = var(0) >= 1.3
value = 2, 6

[State 181, 2]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

;---------------------------------------------------------------------------
; INTRO
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State -2, jump]
type = VarSet
trigger1 = Time = 0
v = 20
value = 0

[State -2, jump]
type = VarSet
trigger1 = Time = 0
v = 21
value = 0

[State 190, 1] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = Time = [0,80]
flag = Intro

[State 180, 1]
type = ChangeAnim
trigger1 = Time = 24
value = 191

[State 190, 2]
type = PlaySnd
trigger1 = Time = 24
value = 2, 5

[State 190, 3]
type = ChangeState
trigger1 = Time = 60
value = 0


;---------------------------------------------------------------------------
; 立ち＿弱
[Statedef 200]
type    = S                      ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= A                      ;Move-type: A-attack, I-idle, H-gethit
physics = S                      ;Physics: S-stand, C-crouch, A-air
juggle  = 1                      ;Number of air juggle points move takes
;Commonly-used controllers:
velset = 0,0                     ;Set velocity (x,y) (Def: no change)
ctrl = 0                         ;Set ctrl (Def: no change)
anim = 200                       ;Change animation (Def: no change)
poweradd = 20                    ;Power to add (Def: 0)

[State 200, 1]
type = PlaySnd
trigger1 = AnimElem = 5
value = 5,0

[State 230, 0]
