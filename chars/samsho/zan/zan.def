; Definition file for kfm
; Contains all the filenames needed for the character

; Player information
[Info]
name = "zankuro"
displayname = "zankuro"

; Files for the player
[Files]
cmd     = zan.cmd   ;Command set
cns     = zan.cns   ;Constants
st      = zan.cns   ;States
stcommon = common1.cns     ;Common states
sprite  = zan.sff   ;Sprite
anim    = zan.air   ;Animation
sound   = zan.snd   ;Sound
pal1    = zan.ACT
pal2    = zan2.ACT
pal3    = zan3.ACT
pal4    = zan4.ACT
