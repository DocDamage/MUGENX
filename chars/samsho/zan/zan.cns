type = S
ctrl = 0
anim = 182
velset = 0,0,0

[State 220, 1]
type = PlaySnd
trigger1 = AnimElem = 8
value = 0, 42

[State 181, 1]
type = AssertSpecial
trigger1 = Time = [0,350]
flag = RoundNotOver

[State 181, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1
;---------------------------------------------------------------------------
; INTRO
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0,0

[State 1200, 13]
type = EnvShake
trigger1 = AnimElem = 6
time = 20
ampl = -9
freq = 90
phase = 90

[State 191, 1] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = Time = [0,350]
flag = Intro

[State 220, 1]
type = PlaySnd
trigger1 = AnimElem = 12
value = 0, 16

[State 220, 1]
type = PlaySnd
trigger1 = AnimElem = 12
value = 0, 29

[State 190, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
;敗北(最終ラウンド）
[Statedef 5150]
type    = S
velset = 0,0

[State 5150, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

[state 5150,1]
type = ChangeAnim
trigger1 = p2stateno >= 180
trigger1 = p2stateno < 190
trigger1 = Time > 0
trigger1 = anim = 5110
trigger1 = matchover = 1
value = 5151

[state 5150,1]
type = ChangeAnim
trigger1 = p2stateno >= 180
trigger1 = p2stateno < 190
trigger1 = Time > 0
trigger1 = anim = 5110
trigger1 = matchover != 1
value = 5150


