;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; LOSE (Time over)
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0,0

[State 170, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

;----------------------------------------

; DRAWGAME (Time over)
[Statedef 175]
type = S
ctrl = 0
velset = 0,0

[State 175, 1] ; If no anim, use go to lose state.
type = ChangeState
trigger1 = Time = 0
trigger1 = !AnimExist(175)
value = 170

[State 175, 2]
type = ChangeAnim
trigger1 = Time = 0
value = 175

[State 175, 3]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

[State 175, 3]
type = playsnd
trigger1 = animelem = 1
value = 0,15

;---------------------------------------------------------------------------
; WIN
[Statedef 180]
type = S
facep2 = 1

[State 180, 1]
type = ChangeState
trigger1 = MatchOver = 0
value = 181

[State 180, 1]
type = ChangeState
trigger1 = MatchOver = 1
value = 182

;---------------------------------------------------------------------------
; WIN1
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0,0
facep2 = 1

[State 181, 0]
type = PlaySnd
trigger1 = animelem = 1
value = 0,13

[State 181, begin]
type = AssertSpecial
trigger1 = Time = [0,160]
flag = roundnotover

[State 181, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

; WIN2
[Statedef 182]
type = S
ctrl = 0
anim = 182
velset = 0,0,0

[State 182, begin]
type = AssertSpecial
trigger1 = Time = [0,300]
flag = roundnotover

[State 182, 1]
type = explod
trigger1 = animelem = 9
anim = 183
sprpriority = 0
postype = p1
pos = 0,0
;shadow = 68,68,68
bindtime = -1

[State 181, 0]
type = PlaySnd
trigger1 = animelem = 8
value = 0,14

;------------------------------------------------
; INTRO
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0,0

[State 190, 1] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = Time = [0,273]
flag = Intro

[State 190, 2]
type = explod
trigger1 = animelem = 145
anim = 1750
sprpriority = 2
postype = p1
pos = 0,0
bindtime = -1
ignorehitpause = 1

[State 190, 2]
type = playsnd
trigger1 = animelem = 140
value = 0,24

[State 190, 0]
type = PlaySnd
trigger1 = animelem = 145
value = 0,42

[State 190, 0]
type = PlaySnd
trigger1 = animelem = 3
value = 0,50


