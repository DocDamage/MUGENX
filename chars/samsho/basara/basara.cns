triggerall = time = 1
triggerall = Random < 650
trigger1 = stateno = 5001
trigger2 = stateno = 5006
trigger3 = stateno = 5011
trigger4 = stateno = 5016
trigger5 = stateno = 5021
trigger6 = stateno = 5026
