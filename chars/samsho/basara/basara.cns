;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, 4]
type = VarSet
trigger1 = Command = "cpu"
persistent = 0
v = 30
value = 1

[State -2, 1]
type = PlaySnd
triggerall = time = 1
triggerall = Random < 650
trigger1 = stateno = 5000
trigger2 = stateno = 5005
trigger3 = stateno = 5010
trigger4 = stateno = 5015
trigger5 = stateno = 5020
trigger6 = stateno = 5025
value =S1000,10

