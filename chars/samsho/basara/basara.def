; Definition file for kfm
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Basara"        ;Name of character
displayname = "BASARA" ;Name of character to display
versiondate = 11,22,2000    ;Version date of character
mugenversion = 11,22,2000   ;Version of M.U.G.E.N character works on
author = "K-Z"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = basara.cmd   ;Command set
cns     = basara.cns   ;Constants
st      = basara.cns   ;States
st1      = basara01.cns
st2      = basara02.cns
st3      = basara03.cns
st4      = basara04.cns
stcommon = common1.cns ;Common states
sprite  = basara.sff   ;Sprite
anim    = basara.air   ;Animation
sound   = basara.snd   ;Sound
pal1    = basara.ACT;Palettes (can have up to 12)
