; Run
;----

[Statedef 100]
Type = S
MoveType = I
Physics = N
anim = 100
ctrl = 0

;[State 100, Snd01]
;type = PlaySnd
;trigger1 = AnimElem =1
;value = 310, 0
;volume = 2500
;channel = 0

[State 100, animation]
type = ChangeAnim
trigger1 = time = 0
value = 100
ifelse = anim = 101

[State 100, velocity]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x) + (var(0)=20)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, player push]
type = PlayerPush
trigger1 = var(0) = 20
value = 0

;[State 100, run sound]
;type = PlaySnd
;triggerall = var(0) = 0
;trigger1 = time = 0
;trigger2 = (GameTime%47) = 0
;value = 100, 3
;channel = 1

[State 100, emergency stop state] ; brake when stop running
type = ChangeState
trigger1 = command = "holdback"
value = 102

[State 100, end state] ; brake when stop running
type = ChangeState
triggerall = command != "holdfwd"
trigger1 = var(0) = 0
value = 101

