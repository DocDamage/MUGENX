;Here is the Def for my 3rd Samurai Showdown-ish Character Liu Yunfei.
;Im not to fond of this character actually but I wanted to mugen-up the SSV-Special
;version of Mizuki but it looks like someone is already on that. (I dont think anyone
;is particularily fond of Yunfei so I chose the underdog).
;I ripped all the sprites and sounds myself. =3

;NOTE: This is not a true conversion of the SSV/Special Yunfei as I have given him
;new moves and adjusted his attacks/properties to suit my own tastes.

[Info]

Name = "SSVYunfei"
DisplayName = "Yunfei"
VersionDate = 02,22,2006
MugenVersion = 04,14,2002
Author = "John.M"
Pal.Defaults = 1


[Files]

; Samurai Class
;--------------
cmd	= SSVYunfei.cmd	; Commands
cns	= SSVYunfei.cns	; Constants
st	= SSVYunfei.cns	; Jun States
anim	= SSVYunfei.air	; Animations
sprite	= SSVYunfei.sff	; Sprites


; Common files
;-------------
sprite		= SSVYunfei.sff		; Sprites
stcommon	= common1.cns		; Common States
sound		= SSVYunfei.snd		; Sounds

pal1		= SSVYunfei.act	; Palettes
pal2		= BUST.act
pal3		= Young.act
pal4		= Clown.act


