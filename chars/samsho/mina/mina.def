; プレイヤー情報
[Info]
name = "Mina Majikina"        ;プレイヤー名
displayname = "Mina" ;表示される名前
versiondate = 08,5,2004    ;キャラの最終更新日
mugenversion = 04,14,2001   ;キャラが動くmugenのバージョン
author = "PriPri Man"       ;キャラ作者名
pal.defaults = 1,2,3,4      ;パレット優先順位

; プレイヤーファイル
[Files]
cmd     = mina.cmd   ;コマンドファイル
cns     = mina.cns   ;定数ファイル
st      = mina.st    ;標準ステート
st1     = override.st ;共通ステートの上書き
st2     = helper.st    ;ヘルパーが参照するステート
st3     = -2and-3.st ;自動処理されるステート
stcommon = common1.cns ;共通ステート
sprite  = mina.sff   ;スプライト
anim    = mina.air   ;アニメ
sound   = mina.snd   ;サウンド
pal1    = original.act   ;パレット(最大12個)
pal2    = ressie.act
pal3    = red.act
pal4    = black.act
pal5    = blue.act
pal6    = shiela.act
