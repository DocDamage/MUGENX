;定数ファイル

[Data]
life = 800;体力の初期値
power = 2000;ゲージの最大値
attack = 100;攻撃力(％)
defence = 100;防御力(％)
fall.defence_up = 50;ダウンしたときに上昇する防御力(％)
liedown.time = 70;ダウンしてから起き上がるまでの時間
airjuggle = 8;空中ヒット制限値
sparkno = 2;ヒットマーク
guard.sparkno = 40;ガードマーク
KO.echo = 0;1 にするとKOボイス(11,0)にエコーがかかるらしい。
volume = 255;ボリューム

IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1           ;横の縮尺
yscale = 1           ;縦の縮尺
ground.back = 10     ;キャラの後ろの幅
ground.front = 10    ;キャラの前の幅
air.back = 10        ;空中での後ろの幅
air.front = 10       ;空中での前の幅
height = 75      ;キャラの高さ。当たり判定より低いとめくられやすくなりますが、
;高すぎるとジャンプで跳び越えられなくなってしまいます。
attack.dist = 320    ;敵がガードモーションを取る距離
proj.attack.dist = 320 ;上の飛び道具用
proj.doscale = 0     ;1にすると、飛び道具にも縮尺が適用されます。
head.pos = 0, -75   ;大体の頭の座標
mid.pos = 0, -50    ;大体の体の中間座標
shadowoffset = 0     ;影の垂直位置
draw.offset = 0,0    ;プレイヤーの表示座標

[Velocity];設定した数値がcommonステートに渡されます。commonを上書きする場合はあまり意味なし。
walk.fwd  = 1.55      ;前進速度
walk.back = -1.21     ;後退速度
run.fwd  = 5.6,0  ;前ダッシュの速度 (x, y)ステップにする場合はステートを再定義する必要あり。
run.back = -6.3,-4 ;後ろダッシュの速度 (x, y)
jump.neu = 0,-15    ;垂直ジャンプ初速 (x, y)
jump.back = -2.63    ;バックジャンプ初速 (x, y)
jump.fwd = 3.3       ;前ジャンプ初速 (x, y)
runjump.back = -3,-15 ;ダッシュバックジャンプ初速 (任意)
runjump.fwd = 4,-15      ;ダッシュ前ジャンプ初速
airjump.neu = 0,-12      ;垂直２段ジャンプ初速
airjump.back = -2.55      ;バック　〃
airjump.fwd = 2.5         ;前　　　〃

[Movement]
airjump.num = 0      ;空中でジャンプできる回数 (任意)
airjump.height = 35  ;空中でジャンプ可能な最低高度 (任意)
yaccel = .682         ;重力
stand.friction = .85  ;立ち状態の摩擦
crouch.friction = .82 ;しゃがみ　〃

;-------------------------------------------------------------------------------
;使用変数
;var(3) 現体力を保存
;var(4) 移動起き上がり方向
;var(5) コマンドを記憶
;var(6) ゲーム時間を一時的に記憶
;var(7) 弾ッキング判定フラグ
;var(8) 大ジャンプフラグ
;var(10) 
;var(15) スンガンストック数
;var(16) キャンセルフラグ
;var(20) CPUロジック
;Var(29) :怒ゲ量
;Var(30) :怒ゲ状態(-1:消失 0:通常　24:怒り 40:爆発)
;Var(31) :剣ゲ位置X
;Var(32) :剣ゲ位置Y
;Var(33) :ターゲットのダメージを記録
;FVar(1) :剣ゲ量
;FVar(2) :ダメージ計算用
;Fvar(11) 矢の角度(ヘルパー用)
;Fvar(12) 矢の重力(ヘルパー用)
