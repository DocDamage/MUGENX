;=====================================================================
;MUGEN CharData (01.04.14)
;"SvC EarthQuake"                                             ActJapan
;=====================================================================
;---------------------------------------------------------------------
; 基本設定
[Data]
life = 1000          ; 体力ゲージ、上限値（デフォルト：1000）
attack = 100         ; 攻撃力（％）
defence = 100        ; 防御力（％）
fall.defence_up = 50 ; 空中コンボ修正率（％）
liedown.time = 35    ; ダウン時間
airjuggle = 9        ; 空中コンボ
sparkno = 2        ; 初期ヒットスパーク番号
guard.sparkno = 40 ; 初期ガードスパーク番号
KO.echo = 0          ; ＫＯボイスエコー（0:OFF、1:ON）
volume = 25          ; キャラボイスボリューム値
Power = 3000
IntPersistIndex = 7,8,30,36,37,39,40
FloatPersistIndex = 31

[Size]
xscale = 1           ; 水平サイズ倍率
yscale = 1           ; 垂直サイズ倍率
ground.back = 35     ; キャラ幅（地上、後ろ側）
ground.front = 25    ; キャラ幅（地上、前側）
air.back = 30        ; キャラ幅（空中、後ろ側）
air.front = 30       ; キャラ幅（空中、前側）
z.width = 25         ; キャラ幅（ｚ軸）
height = 85	     ; キャラの高さ（ジャンプで飛び越せる高さ）
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = 12,-118   ; 頭部座標
mid.pos = 0,-64      ; 体中心部座標
shadowoffset = 3     ; キャラの影・オフセット値

[Velocity]
walk.fwd  = 2.45		; 前進速度
walk.back = -2.38		; 後退速度
run.fwd  = 5.22, 0		; 前ダッシュ速度（y<0の場合、ホップステップ）
run.back = -6.10,-3.8		; バックステップ速度（y=0の場合、走り）
jump.neu = 0,-8.1		; 垂直ジャンプ速度
jump.back = -3.00		; 後方ジャンプ速度
jump.fwd = 3.45			; 前方ジャンプ速度
runjump.back = -4.40,-5.4	; 後方ジャンプ速度（ダッシュ中）
runjump.fwd = 4.80,-5.4		; 前方ジャンプ速度（ダッシュ中）
;airjump.neu = 0,-9.3		; 空中垂直ジャンプ速度
;airjump.back = -2.55,-8.5	; 空中後方ジャンプ速度
;airjump.fwd = 2.5,-8.5		; 空中前方ジャンプ速度

[Movement]
airjump.num = 0       ; 空中ジャンプ回数
;airjump.height = 35  ; 空中ジャンプ最低高度
yaccel = .43          ; キャラ重力加速度
stand.friction = .87  ; 摩擦係数（立ち状態）
crouch.friction = .84 ; 摩擦係数（しゃがみ状態）

