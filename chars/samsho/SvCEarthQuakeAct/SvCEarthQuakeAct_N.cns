;-------------------------------------------------------------------------------
; ダッシュ
[Statedef 100]
type    = S
movetype = I
physics = N
anim = 100
ctrl = 0

[State 4000,3]
type = NotHitBy
trigger1 = PrevStateno = 4000
trigger1 = 1
value = SCA

[State 100,0]
type = VelSet
trigger1 = AnimElem = 2
x = Const(velocity.run.fwd.x)

[State 100,1]
type = PlaySnd
trigger1 = Time = 1
value = 100, 0

[State 100,2040]
type = ChangeState
triggerall = !(var(30)!=0 && var(31)!=0 && var(32)!=0)
trigger1 = Var(30)!=0 && Random <300 && Time >= 4
trigger1 = P2BodyDist X = [130,180]
trigger1 = P2StateType = S || P2StateType = C
value = 2040
ctrl = 0

[State 100,101]
type = ChangeState
trigger1 = AnimTime = 0
value = 101
ctrl = 0

[State 100,ChangeState]
type = ChangeState
triggerall = !(var(30)!=0 && var(31)!=0 && var(32)!=0)
trigger1 = Command = "holdupfwd" && Time >= 4
value = 40

[State 100,4]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

