; ここにキャラ情報を書いてください
[Info]
name = "Asura"        ;キャラの名前
displayname = "Asura" ;表示されるキャラの名前
versiondate = 11,22,2000    ;キャラの更新情報
mugenversion = 11,22,2000   ;キャラが動くmugenのバージョン
author = "ahuron"         ;キャラの製作者名
pal.defaults = 1      ;敵としてでるキャラのパレット

; Files for the player
[Files]
cmd     = asura_nbc.cmd   ;キャラのコマンド
cns     = asura_nbc.cns   ;キャラのプログラム
st      = asura_nbc.cns   ;基本動作、必殺技、特殊ゲージ、-2、-3
st2     = asura_nbc2.cns  ;超必殺技
st3     = asura_nbc3.cns  ;表示エフェクト
stcommon = common1.cns 
sprite  = asura_nbc.sff   ;キャラの絵
anim    = asura_nbc.air   ;キャラの動き
sound   = asura_nbc.snd   ;キャラの音
pal1    = asura_nbc2.act
pal2    = asura_nbc2.act
pal3    = asura_nbc2.act
pal4    = asura_nbc.act
pal5    = asura_nbc.act
pal6    = asura_nbc.act