;ヴァー
;var(3) = ジャンプ音
;var(4) = 挑発
;var(5) = 攻撃分岐
;var(6) = 向き
;var(7) = 廃莢X
;var(8) = 廃莢Y
;var(9) = 受け返し
;var(10) = ブーストダッシュ
;var(11) = ブーストダッシュ
;var(12) = ブーストエネルギー
;var(13) = ブーストエネルギー
;var(14) = コンタクト
;var(15) = バルカンゲージ


;var(20) = モード

;fvar(2) = vel x

;------------------------------------------------
;基本設定 [Data]部分
[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = S992
guard.sparkno = S990
KO.echo = 0
volume = 0
IntPersistIndex = 20
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 26
ground.front = 23
air.back = 24
air.front = 24
height = 70
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -90
mid.pos = -5, -60
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 2.1
walk.back = -1.7
run.fwd  = 4.4, 0
run.back = -3.6,-4.6
jump.neu = 0,-12.4
jump.back = -2.5
jump.fwd = 2.5
runjump.back = -2.5,-12.4
runjump.fwd = 2.5,-12.4
airjump.neu = 0,-8.1
airjump.back = -2.55
airjump.fwd = 2.5

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .57
stand.friction = .85
crouch.friction = .82

;---------------------------------------------------------------------------


;---------------------------------------------------------------------------
;しゃがみ開始
[Statedef 10]
type    = C
physics = C

[State 10, 1]
type = ChangeState
trigger1 = Anim = 10 && AnimTime = 0
value = 11

[State 10, 2]
type = VarSet
trigger1 = time = 0
var(3) = 0

[State 10, 3]
type = VarSet
trigger1 = prevstateno = 100
var(3) = 1

[State 10, 4]
type = ChangeState
triggerall = var(20) = 0
triggerall = prevstateno = 100
trigger1 = command = "holddown"
value = 110

[State 10, 5]
type = ChangeState
triggerall = var(20) = 1
trigger1 = prevstateno = 102
value = 102

[State 10, 6]
type = ChangeState
triggerall = var(20) = 1
trigger1 = prevstateno = 107
value = 107

[State 10, 7]
type = ChangeAnim
trigger1 = Time = 0
value = 10

;---------------------------------------------------------------------------
;しゃがみ終了
[Statedef 12]
type    = S
physics = S
anim = 12

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
trigger2 = prevstateno = 115
value = 0

;-------------------------------------------
;ジャンプ開始
[Statedef 40]
type    = S
physics = S
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = Time = 1 && var(20) = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = Time = 1 && var(20) = 1
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x)*1.2, const(velocity.jump.back.x)*1.2))
y = const(velocity.jump.y) / 2

[State 40, 6]
type = VarSet
trigger1 = time = 0
var(3) = 0

[State 40, 7]
type = VarSet
trigger1 = prevstateno = 100
var(3) = 10

[State 40, 8]
type = ChangeState
trigger1 = Time = 1
value = 50 + (var(20) = 1) * 1750
ctrl = 1

;------------------------------------------------------
;ジャンプ
[Statedef 50]
type = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = turn
trigger1 = time = 0
trigger1 = p2dist x < 0

[State 50, 3]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 4]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50, 5]
type = PlaySnd
trigger1 = Time = 2 + var(3)
value = 50, 0
volume = -100

;---------------------------------------------------------------------------
;着地
[Statedef 52]
type    = S
physics = S
ctrl = 0

[State 52, 1]
type = ChangeAnim
trigger1 = Time = 1 - var(20)
value = 47

[State 52, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 4]
type = VelSet
trigger1 = Time = 0 && var(20) = 0
x = 0

[State 52, 5]
type = AssertSpecial
trigger1 = var(20) = 0
flag = NoAutoTurn

[State 52, 6]
type = Turn
trigger1 = Time = 0
trigger1 = var(20) = 1
trigger1 = p2bodydist X < -5
trigger1 = PrevStateNo != 2320

[State 52, 7]
type = CtrlSet
trigger1 = var(20) = 0
trigger1 = command !="holdup"
trigger2 = var(20) = 1
trigger2 = time = 4
value = 1

[State 52, 8]
type = PlaySnd
trigger1 = var(20) = 0
trigger1 = Time = 0
value = 50, 1
volume = -100

[State 52, 9]
type = PlaySnd
trigger1 = var(20) = 1
trigger1 = time = 0
value = 100, 3
volume = -100

[State 52, 10]
type = ChangeState
trigger1 = AnimTime = 0 && anim = 47
trigger2 = Anim = 5
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;踏み込み
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl = 0

[State 100, 1]
type = ChangeAnim
trigger1 = time = 0 && prevstateno = 106
value = 100
elem = 4

[State 100, 2]
type = VelSet
trigger1 = time > 2
trigger2 = prevstateno = 106
x = const(velocity.run.fwd.x)

[State 100, 3] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 4] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 5]
type = PlaySnd
trigger1 = time = 3
value = 100, 0
volume = -100
channel = 10

[State 100, 6]
type = CtrlSet
trigger1 = time = 3
value = 1

[State 100, 7]
type = VarSet
trigger1 = time = 0
var(5) = 101

[State 100, 8]
type = VarSet
trigger1 = time >= 3
trigger1 = command = "x"
var(5) = 400

[State 100, 9]
type = VarSet
trigger1 = time >= 3
trigger1 = command = "y"
var(5) = 420

[State 100, 10]
type = VarSet
trigger1 = time >= 3
trigger1 = command = "z"
var(5) = 440

[State 100, 11]
type = VarSet
trigger1 = time >= 3
trigger1 = command = "a"
var(5) = 450

[State 100, 12]
type = VarSet
trigger1 = time >= 3
trigger1 = command = "b"
var(5) = 460

[State 100, 13]
type = VarSet
trigger1 = time >= 3
trigger1 = command = "c"
var(5) = 310

[State 100, 14]
type = ChangeState
triggerall = time > 3
trigger1 = command = "holddown"
value = 110

[State 100, 15]
type = ChangeState
triggerall = time > 3 && timemod = 22,0
trigger1 = command != "holdfwd"
trigger2 = FrontEdgeBodyDist < 5
trigger3 = p2bodydist X >= -5 && p2bodydist X < 10
trigger3 = p2statetype != A
trigger4 = var(5) != 101
value = var(5)

[State 100, 16]
type = ChangeState
triggerall = time > 3 && timemod = 11,0
trigger1 = command = "holdback"
value = var(5)

