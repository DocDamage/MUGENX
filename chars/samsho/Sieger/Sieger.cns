;---------------------------------------------------------------------------
; 勝利（state180）
;
; このstateはmugen内部より強制的に飛ばされるstateで
; 必ず設定しなくてはならない
; もし勝利ポーズを何種類も設定したい場合は他のstateに飛ばしたり
; 条件を変えたりして処理しましょう
; ※このstateはcommon1.cnsを上書きしています
[Statedef 180]
type = S

[State 180, 1]
type = VarRandom
trigger1 = 1
v = 1
range = 0,2

[State 180, 2]
type = VarSet
trigger1 = Command = "holddown"
var(1) = 0

[State 180, 3]
type = VarSet
trigger1 = Command = "holdup"
trigger1 = Command = "holdback"
var(1) = 1

[State 180, 4]
type = VarSet
trigger1 = Command = "holdfwd"
var(1) = 2

[State 180, 5]
type = Explod
triggerall = time = 0
triggerall = var(20) = 0
trigger1 = Pos X >= 0
anim = 185 - var(6)
removetime = 88
pos = 110,55
postype = left
sprpriority = 6
ownpal = 1

[State 180, 6]
type = Explod
triggerall = time = 0
triggerall = var(20) = 0
trigger1 = Pos X < 0
anim = 185 - var(6)
removetime = 88
pos = 170,55
postype = left
sprpriority = 6
ownpal = 1

[State 180, 7]
type = ChangeState
trigger1 = Time = 0
value = 181 + var(1) + var(20) * 3

