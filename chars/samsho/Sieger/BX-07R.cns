;ブーストダッシュ
[Statedef 102]
type    = S
physics = S
sprpriority = 1
ctrl = 1

[State 102, 1]
type = ChangeAnim
trigger1 = anim != 102
value = 102

[State 102, 2]
type = VarSet
trigger1 = var(10) = 0
var(11) = 0

[State 102, 3]
type = VarSet
trigger1 = var(10) = 0
var(10) = 1

[State 102, 4]
type = Varadd
trigger1 = var(10) = 1
var(11) = 1

[State 102, 5]
type = PlaySnd
trigger1 = var(11) = 1
value = 100, 2
volume = -100
channel = 11

[State 102, 6]
type = VelSet
trigger1 = var(11) > 0
x = const(velocity.run.fwd.x) * 1.3

[State 102, 7]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 102, 8]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 102, 9]
type = Explod
trigger1 = var(11) != 0
anim = 1850 + var(11) - floor(var(11) /4) * 4
ignorehitpause = 1
removeongethit = 1
pos = -25,-65
bindtime = -1
postype = P1
sprpriority = -2

[State 102, 10]
type = ChangeState
trigger1 = var(11) > 2
trigger1 = command = "boost"
value = 0

[State 102, 11]
type = ChangeState
triggerall = var(11) > 20
trigger1 = command != "holdfwd" && command != "boost2"
trigger2 = var(11) > 40
value = 103

