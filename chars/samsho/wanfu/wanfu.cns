;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type=playSnd
trigger1=AnimElem=1
Value=0,18
channel=1

[State 100, 5]
type=playSnd
trigger1 = command != "holdfwd"
Value=0,19

[State 100, 12]
type = ChangeState
trigger1 = command != "holdfwd"
value = 0

