trigger1= AnimElem=3
Value=0,1
[State 191, 4]
type=PlaySnd
trigger1= AnimElem=6
Value=0,1
[State 191, 5]
type=PlaySnd
trigger1= AnimElem=9
Value=0,1
[State 191, 6]
type=PlaySnd
trigger1= AnimElem=12
Value=0,16

[State 191, 6] ;Change to stand state when done
type = ChangeState
trigger1 = AnimTime = 0
value = 0

