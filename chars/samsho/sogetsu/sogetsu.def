; Definition file for Sogetsu kazama V0.7 by Sela
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Sogetsu"
displayname = "SOGETSU"

; Files for the player
[Files]
cmd     = sogetsu.cmd   ;Command set
cns     = sogetsu.cns   ;Constants
st      = sogetsu.cns   ;States
st1     = sogetsu-h.cns
st2     = sogetsu-d.cns
stcommon = common1.cns     ;Common states
sprite  = sogetsu.sff   ;Sprite
anim    = sogetsu.air   ;Animation
sound   = sogetsu.snd   ;Sound  too big 
pal1    = sogetsu1.act   ;Palettes (can have up to 12)




