; プレイヤー情報
[Info]
name = "Rimururu"        ;プレイヤー名
displayname = "Rimururu" ;表示される名前
versiondate = 12,30,2004    ;キャラの最終更新日
mugenversion = 04,14,2001   ;キャラが動くmugenのバージョン
author = "PriPri Man"       ;キャラ作者名
pal.defaults = 1,2,3,4      ;パレット優先順位

; プレイヤーファイル
[Files]
cmd     = rimururu.cmd   ;コマンドファイル
cns     = rimururu.cns   ;定数ファイル
st      = rimururu.st    ;標準ステート
st1     = override.st ;共通ステートの上書き
st2     = helper.st    ;ヘルパーが参照するステート
st3     = -2and-3.st ;自動処理されるステート
st4     = ini.txt    ;初期化用ステート
stcommon = common1.cns ;共通ステート
sprite  = rimururu.sff   ;スプライト
anim    = rimururu.air   ;アニメ
sound   = rimururu.snd   ;サウンド
pal1    = pal4.act   ;パレット(最大12個)
pal2    = pal2.act
pal3    = pal3.act
pal4    = pal1.act
pal5    = pal5.act
pal6    = pal6.act
pal7    = pal7.act
pal8    = nak.act