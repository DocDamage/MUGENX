; Player information
[Info]
name = "Yoshitora Tokugawa"        ;Name of character
displayname = "YOSHITORA" ;Name of character to display
versiondate = 04,14,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "MEKA"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd	= Yoshitora.cmd
cns     = CNS/Yoshitora.cns
st      = CNS/-2.cns
st0     = CNS/Yoshitora_normal.cns
st1	= CNS/Yoshitora_special.cns
st2	= CNS/Yoshitora_hyper.cns
stcommon = CNS/common1.cns
sprite  = Yoshitora.sff
anim    = Yoshitora.air
sound   = Yoshitora.snd
pal1    = ACT/Yoshitora.ACT
pal2    = ACT/Yoshitora2.ACT 
pal3    = ACT/Yoshitora3.ACT
pal4    = ACT/Yoshitora4.ACT 
pal5    = ACT/Yoshitora5.ACT
pal6    = ACT/Yoshitora6.ACT 