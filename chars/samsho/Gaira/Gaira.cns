;---------------------------------------------------------------------------
; ここから下は-3のステートを書いてください、ここに書いたものはゲーム中
; に条件が成立すればいつでも開始するステートです。
;---------------------------------------------------------------------------
[Statedef -3]
;ゲーム中に常にいつでも開始したいステート
;---------------------------------------------------------------------------
; ダッシュ効果音の停止
[State -3, Dash stop]
type = StopSnd
trigger1 = stateno != 100
channel = 2
;---------------------------------------------------------------------------
;ジャンプ時効果音
[State -3]
type = PlaySnd
triggerall = Time  = 1
trigger1 = anim = 40
trigger2 = anim = 105
Value = 2,0
;---------------------------------------------------------------------------
; 着地音その1
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52  ;ジャンプ着地時
trigger2 = stateno = 106 ;退き込み着地時
value = 2, 1
;---------------------------------------------------------------------------
; 着地音その2
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 641  ;ぶちかまし着地時
trigger2 = stateno = 651  ;百貫落とし着地時
trigger3 = stateno = 1102 ;地震丸着地時
trigger4 = stateno = 1701 ;円心殺失敗時
value = 2, 4
;---------------------------------------------------------------------------
; 転倒時の効果音
[State -3]
type = PlaySnd
triggerall = Time  = 1
trigger1 = anim = 5100
trigger2 = anim = 5105
trigger3 = anim = 5160
Value = 2,8
;---------------------------------------------------------------------------
；着地時の画面の振動
[State -3, Landing Shake]
type = EnvShake
triggerall = Time = 1
trigger1 = stateno = 52  ;ジャンプ着地時
trigger2 = stateno = 106 ;退き込み着地時
trigger3 = stateno = 641 ;ぶちかまし着地時
trigger4 = stateno = 651 ;百貫落とし着地時
trigger5 = anim = 5100 ;転倒時
trigger6 = anim = 5105 ;転倒時
trigger7 = anim = 5160 ;転倒時
freq = 160
ampl = 8
phase = 70
time = 15
;---------------------------------------------------------------------------
；必殺技での画面の振動
[State -3, Landing Shake]
type = EnvShake
triggerall = Time = 1
trigger1 = stateno = 1102 ;地震丸着地時
trigger2 = stateno = 1701 ;円心殺失敗時
freq = 160
ampl = 10
phase = 80
time = 20
;---------------------------------------------------------------------------
