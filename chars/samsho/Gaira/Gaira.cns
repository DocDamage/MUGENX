trigger4 = anim = 5010
trigger5 = anim = 5011
trigger6 = anim = 5012
trigger7 = anim = 5020
trigger8 = anim = 5021
trigger9 = anim = 5022
trigger10 = anim = 5070
persistent = 0
value = s0, 16

[State -2]
