;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = Random <=500
value = 6002

[State 180, 2]
type = ChangeState
trigger1 = Random <=500
value = 6003


;---------------------------------------------------------------------------
; Introduction Decider
[Statedef 191]
type = S

[State 191, panda]
type = ChangeState
trigger1 = P2Name = "Pandarate"
value = 6004

[State 191, akuma]
type = ChangeState
triggerall = Palno != 7
trigger1 = P2Name = "Akuma" || P2Name = "Shin Akuma" || P2Name = "Gouki" || P2Name = "Shin Gouki" || P2Name = "Mech Gouki" || P2Name = "Cyber Akuma"
trigger2 = P2Name = "Cvshaohmaru"; && enemy,Var(12) = 1
value = 6005

[State 191, decider]
type = ChangeState
trigger1 = P2Name != "Pandarate"
trigger1 = P2Name != "Akuma" || P2Name != "Shin Akuma" || P2Name != "Gouki" || P2Name != "Shin Gouki"
trigger1 = Random <= 500
value = 6000

[State 191, decider2]
type = ChangeState
trigger1 = P2Name != "Pandarate"
trigger1 = P2Name != "Akuma" || P2Name != "Shin Akuma" || P2Name != "Gouki" || P2Name != "Shin Gouki"
trigger1 = Random <= 500
value = 6001

