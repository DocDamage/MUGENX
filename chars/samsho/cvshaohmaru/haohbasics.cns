;---------------------------------------------------------------------------
;Esquiva
[Statedef 700]
type = S
Physics = S
anim = 700
ctrl = 0

[State 700, snd]
type = PlaySND
triggerall = Random <=499
trigger1 = AnimElem = 1
volume = 75
channel = 0
value = 700,0

[State 700, snd1]
type = PlaySND
triggerall = Random >=500
trigger1 = AnimElem = 1
volume = 75
channel = 0
value = 700,1

[State 700, afterimage]
type = AfterImage
trigger1 = Time = 1
time = 30
trans = add1
paladd = 0,0,0
palmul = 1,1,1
palbright = 10,10,10
palcontrast = 120,120,120

[State 700, noautoturn]
type = AssertSpecial
trigger1 = 1
flag = noautoturn

[State 700, vel]
type = VelSet
trigger1 = Time > 1 && AnimTime != 0
x = 4

[State 700, vel2]
type = VelSet
trigger1 = AnimTime = 0
x = 0

[State 700, back]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;Burst
[Statedef 705]
type = S
physics = S
poweradd = 0
velset = 0,0
ctrl = 0
anim = 1080

[State 705, explod]
type = Explod
trigger1 = AnimElem = 1
anim = 8080
sprpriority = 5
postype = p1
pos = 0,0
bindtime = 38
removetime = -2
removeongethit = 1

[State 705, poweradd]
type = PowerAdd
trigger1 = AnimElem = 9
value = -1000

[State 705, var]
type = VarSet
trigger1 = AnimElem = 9
v = 1
value = 25

[State 705, palfx]
type = PalFX
trigger1 = var(1) = 25
trigger1 = AnimElem = 9
time = 300
add = 0,0,0
ignorehitpause = 1
sinadd = 150,150,100, 4

[State 705, back]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;Super Jump Start
[Statedef 710]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 710, afterimage]
type = AfterImage
trigger1 = Vel y <= 0
time = 20
framegap=3
length=9
trans = add1
paladd = 0,0,0
palmul = 1,1,1
palbright = 10,10,10
palcontrast = 120,120,120

[State 710, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 710, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 710, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 710, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x)+1, const(velocity.jump.back.x)-1))
y = -10

[State 710, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
;Power Charge
[Statedef 6145]
ctrl = 0
anim = 6150

[State 6145, powerup]
type = Poweradd
trigger1 = Command = "charge" && Time > 1
value = 12

[State 6145, explod]
type = Explod
trigger1 = Command = "charge" && NumExplod = 0
anim = 6145
sprpriority = 5
postype = p1
id = 1
pos = 0,0
removetime = -2
removeongethit = 1

[State 6145, remove]
type = RemoveExplod
trigger1 = Command != "charge"
id = 1

[State 6145,end]
type = ChangeState
trigger1 = Command != "charge"
value = 50
ctrl = 1

