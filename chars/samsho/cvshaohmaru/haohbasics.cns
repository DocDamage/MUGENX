;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, RandomSpark]
type = VarRandom
trigger1 = MoveHit
V = 10
range = 0,7

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52
trigger2 = stateno = 106
value = 40, 0

[State -3, Jumping Effect]
type = Explod
triggerall = Time = 1
trigger1 = Anim = 40
anim = 6131
sprpriority = 5
postype = p1
removetime = -2
removeongethit = 1

[State -3, Landing Effect]
type = Explod
triggerall = Time = 1
trigger1 = stateno = 52
trigger2 = stateno = 106
anim = 6130
sprpriority = 5
postype = p1
removetime = -2
removeongethit = 1

[State -3, weakhit]
type = PlaySnd
triggerall = Random <= 333
triggerall = Time = 1 && Alive = 1
trigger1 = StateNo = 5000 || StateNo = 5010 || StateNo = 5020 || StateNo = 5070 || StateNo = 5100
value = 2,0

[State -3, weakhit1]
type = PlaySnd
triggerall = Random <= 334;
triggerall = Time = 1 && Alive = 1
trigger1 = StateNo = 5000 || StateNo = 5010 || StateNo = 5020 || StateNo = 5070 || StateNo = 5100
value = 2,1

[State -3, burstvar]
type = VarAdd
triggerall = Var(1) = 25
trigger1 = Time
v = 2
value = 1

[State -3, varreset]
type = VarSet
triggerall = Var(1) = 25
trigger1 = var(2) >= 299
v = 1
value = 0

[State -3, varreset1]
type = VarSet
trigger1 = var(2) >= 299
v = 2
value = 0

[State -3, varreset2]
type = VarSet
trigger1 = Movetype != A
v = 0
value = 0

[State -3, snd]
type = PlaySND
trigger1 = Stateno = 705
trigger1 = Time = 1
volume = 75
channel = 1
value = 705,0

[State -3, defset]
type = DefenceMulSet
trigger1 = Life <= 194 && Life > 97
value = 0.75

[State -3, defset1]
type = DefenceMulSet
trigger1 = Life <= 97 && Life > 48
value = 0.5

[State -3, defset2]
type = DefenceMulSet
trigger1 = Life <= 48
value = 0.25

