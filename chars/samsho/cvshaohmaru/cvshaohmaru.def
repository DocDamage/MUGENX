; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Cvshaohmaru"        ;Name of character
displayname = "Haohmaru" ;Name of character to display
versiondate = 04,14,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "Z Sabre User"         ;Character author name
pal.defaults = 1,7,4,9     ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = haoh.cmd   ;Command set
cns     = haoh.cns   ;Constants
st      = haohbasics.cns   ;Basic States
st1      = haohnormals.cns   ;Normal States
st2      = haohoverride.cns   ;Override States
st3      = haohspecials.cns   ;Specials States
st4      = haohhypers.cns    ;Hypers States
st5      = haohnormals2.cns   ;Normal States Throws
st6      = rasetsuspecials.cns   ;Rasetsumaru Mode's States
stcommon = common1.cns ;Common states
sprite  = haoh.sff   ;Sprite
anim    = haoh.air   ;Animation
sound   = haoh.snd   ;Sound
pal1    = haohmaru.act  ;Palettes
pal2    = haohred.act
pal3    = haohsilent.act
pal4    = haohgreen.act
pal5    = haohblue.act
pal6    = neo_haoh_red.act
pal7    = rasetsumaru.act
pal8    = neo_haoh_green.act
pal9    = neo_haoh_blue.act

; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def