;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]
;----------------------------------------------
;varと相対距離のチェック用。
;面倒な処理しだすとかなり助かります。
;--------------------------------------------------------------------------------------------
[State -2,]
type = DisplayToClipboard
trigger1 = 1
text = "CPU=%d,ikari=%d, kenki=%f,Distance X=%d,Y=%d"
params = var(49) ,var(15) ,fvar(6) ,floor(P2BodyDist X) ,floor(P2BodyDist Y)
;--------------------------------------------------------------------------------------------

[State 191, 0];自決 補助
type = AssertSpecial
trigger1 = numhelper(9600) = 1
flag = invisible

;--------------------------------------- 死亡
[State -2,]
Type = VarSet
trigger1 = statetype = A
trigger1 = alive = 1
v = 32
Value = 0

[State -2,]
Type = VarSet
trigger1 = statetype != A
trigger1 = alive = 1
v = 32
Value = 1

[State -2];WIN版対策
Type = VarSet
trigger1 = alive = 0
trigger1 = prevstateno = [130,139]
fvar(22) = 1.0

[State -2]
type = ChangeState
triggerall = var(30)= 0
triggerall = var(32)= 1
triggerall = fvar(22) = 1.0
triggerall = var(11) = 1
triggerall = prevstateno = [130,139]
triggerall = alive = 0
trigger1 = stateno != 5950
trigger1 = stateno != 5150
ignorehitpause = 1
value = 5950
