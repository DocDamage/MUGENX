trigger1 = var(5) = 2
fvar(38) = IfElse(Floor((root,fvar(38))+Floor(root,fvar(35)))>(Floor(root,fvar(37))),Floor(root,fvar(37))+(root,fvar(38)-Floor(root,fvar(38))),Floor(root,fvar(35))+root,fvar(38))
;10.0+(root,fvar(38)-Floor(root,fvar(38)))

