;===========================================================================
; THE GAME-BOY ADVANCE MODULE
;===========================================================================
[StateDef 19100] ; The GBA appears
type = A
movetype = I
physics = N
anim = 19100
ctrl = 0
sprpriority = 4

[State 19100, Intro]
type = AssertSpecial
trigger1 = 1
flag = intro

[State 19100, StartPos]
type = PosSet
trigger1 = time = 0
X = IfElse((parent, Facing) = 1,-512,188)
Y = -ScreenPos Y

[State 19100, VelIni]
type = VelSet
trigger1 = time = 0
X = IfElse((Pos X) < 0,5,-5)

[State 19100, Replace]
type = PosSet
trigger1 = Pos X > -162
X = -162

[State 19100, Stop]
type = VelSet
trigger1 = Pos X = -162
X = 0

[State 19100, Screen]
type = Explod
trigger1 = Pos X = -162
trigger1 = !NumExplod(19101)
anim = 19101
ID = 19101
postype = left
pos = 90,82
bindtime = -1
sprpriority = 5

[State 19100, This is the end]
type = ChangeState
triggerall = Pos X = -162
trigger1 = Root, command = "start"
trigger2 = Root, var(58) < 50
value = 19110

