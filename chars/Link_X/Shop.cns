type = ParentVarAdd
triggerall = var(5) = 2
trigger1 = var(2):= ((Anim = [19201,19203]) || (Anim = 19205) || (Anim = 19218) || (Anim = [19224,19225]))
trigger2 = var(2):= 2*((Anim = 19204) || (Anim = 19206) || (Anim = 19208) || (Anim = 19210) || ((Anim = [19219,19220]) && (var(5)=2)))
trigger3 = var(2):= 3*((Anim = 19207) || (Anim = 19209) || ((Anim = [19221,19222]) && (var(5)=2)))
trigger4 = var(2):= 4*((Anim = [19211,19212]) || ((Anim = 19223) && (var(5)=2)))
trigger5 = var(2):= 5*(Anim = 19213)
trigger6 = var(2):= 6*(Anim = [19214,19215])
trigger7 = var(2):= 8*(Anim = 19216)
trigger8 = var(2):= 10*(Anim = 19217)
