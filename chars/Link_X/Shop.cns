[State 19200, Arrow]
type = Explod
trigger1 = abs(var(0)) = 1
trigger1 = !NumExplod(19980)
anim = 19981+var(0)
ID = 19980
pos = 1+134*(var(0)=1),42
removetime = -1
ontop = 1
ownpal = 1

[State 19200, EndCommand]
type = VarSet
trigger1 = var(0)
trigger1 = !(root, command = "holdfwd")
trigger1 = !(root, command = "holdback")
