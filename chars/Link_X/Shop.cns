;===========================================================================
; TINGLE APPEARS
;===========================================================================
[StateDef 19000] ; "I'm flying like a fairy !"
type = A
movetype = I
physics = N
ctrl = 0
anim = 19000
velset = .5,1
sprpriority = 5

[State 19000, Pos - Solo]
type = PosSet
triggerall = Time = 0
trigger1 = !NumPartner
trigger2 = NumPartner
trigger2 = (Root, ID) < (Partner, ID)
X = 10*(1-2*(TeamSide = 2))
Y = -(Root, ScreenPos Y)-90

[State 19000, Pos - Partner]
type = PosSet
trigger1 = Time = 0
trigger1 = NumPartner
trigger1 = (Root, ID) > (Partner, ID)
X = 40*(1-2*(TeamSide = 2))
Y = -(Root, ScreenPos Y)-90

[State 19000, I'm here, don't fight !]
type = AssertSpecial
trigger1 = Vel Y >= 0
flag = intro

[State 19000, Wow-wow]
type = VelMul
trigger1 = !(Time%20)
trigger1 = Anim = 19000
trigger1 = Time
X = -1

[State 19000, Stop, please : I'm falling !]
type = VelSet
trigger1 = Anim != 19000
trigger1 = Vel X
X = 0

[State 19000, Woops !]
type = ChangeAnim
triggerall = Root, command = "start"
triggerall = Anim = 19000
triggerall = Vel Y = 0
trigger1 = !NumPartner
trigger2 = NumPartner
trigger2 = Partner, name != "Link 0.95"
trigger3 = NumPartner
trigger3 = Partner, name = "Link 0.95"
trigger3 = !(Partner, NumHelper(19000))
trigger4 = NumPartner
trigger4 = Partner, name = "Link 0.95"
trigger4 = !(Partner, NumHelper(19001))
value = 19001

[State 19000, StopPartner]
type = Helper
trigger1 = Anim = 19001
trigger1 = !NumHelper(19001)
name = "stoppartner"
ID = 19001
stateno = 19010

[State 19000, Falling]
type = ChangeState
trigger1 = Anim = 19001
trigger1 = AnimTime = 0
value = 19001

[State 19000, Stop&Bye]
type = VelAdd
triggerall = Anim = 19000
trigger1 = Time = 80
trigger2 = Time = 200
Y = -1

[State 19000, Snd]
type = PlaySnd
trigger1 = Vel Y = -1
persistent = 0
value = 190,3

[State 19000, Bye !]
type = DestroySelf
trigger1 = ScreenPos Y <= -100

