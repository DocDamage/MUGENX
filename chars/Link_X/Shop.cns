[State 1920, EndArrow]
type = RemoveExplod
trigger1 = !var(0)
trigger1 = NumExplod(19980)
ID = 19980

[State 19200, Command]
type = VarSet
triggerall = !var(5)
trigger1 = root, command = "holdup"
trigger2 = root, command = "holddown"
