[State 19200, ItemSnd]
type = PlaySnd
trigger1 = abs(var(0)) = 1
trigger1 = AnimElem = 1, > 9
trigger2 = abs(var(0)) = 2
value = 11000,5

[State 19200, Item Up]
type = ChangeAnim
trigger1 = var(0) > 0
trigger1 = AnimElem = 1, > 9
value = IfElse((Anim-100*var(1) < 19225),(Anim-100*var(1))+1,(Anim-100*var(1))-24)

[State 19200, Item Down]
type = ChangeAnim
trigger1 = var(0) < 0
trigger1 = AnimElem = 1, > 9
value = IfElse((Anim-100*var(1) > 19201),(Anim-100*var(1))-1,(Anim-100*var(1))+24)

;-----------------------------------------------------------------------------------------------;
; The following controller is really important !!!						;
; DO NOT MODIFY IT IF YOU DON'T UNDERSTAND HOW IT WORKS OR YOU MAY RUIN THE SHOP SYSTEM !!!!! 	;
; The following controller check if the displayed object on the GBA can be bought or not. So it ;
; checks the following points :									;
; * Do you have enough money ?									;
; * Do you already own the object (except for Bottles, Bottle items, Arrows and Bombs) ?	;
; * Do you have the needed objects to buy this one ?						;
; * For Bottles : do you already have four bottles ?						;
; * For Bottle Items : are your bottles already all filled ?					;
; * For Bombs and Arrows : have you already the max number of these items ?			;
;-----------------------------------------------------------------------------------------------;

[State 19200, Unavailable]
type = ChangeAnim
triggerall = Anim < 19300 ; not already unavailable
;---------------------------------------------------------------------------
trigger1 = root, var(58) < 50 ; not enough money !
;---------------------------------------------------------------------------
trigger2 = Anim = [19201,19218] ; "Normal" object... 
trigger2 = (root, var(57) & 2**(Anim-19201)) != 0 ; ...aleady bought
;---------------------------------------------------------------------------
trigger3 = Anim = 19204 ; Hylian Symbol
trigger3 = (root, var(58)) < 100
;---------------------------------------------------------------------------
trigger4 = Anim = 19205 ; Hammer
trigger4 = (MatchNo < 3) || ((root, var(57) & 1) = 0)
;---------------------------------------------------------------------------
trigger5 = Anim = 19206 ; Ocarina
trigger5 = (MatchNo < 3) || (root, var(58) < 100) || ((root, var(57) & 8) = 0)
;---------------------------------------------------------------------------
trigger6 = Anim = 19207 ; Hookshot
trigger6 = (MatchNo < 3) || (root, var(58) < 150) || ((root, var(57) & 8) = 0) || ((root, var(57) & 4) = 0)
;---------------------------------------------------------------------------
trigger7 = Anim = 19208 ; Poisonned Arrows
trigger7 = ((root, var(57) & 2) = 0) || (MatchNo < 4) || (root, var(58) < 100)
;---------------------------------------------------------------------------
trigger8 = Anim = 19209 ; Powder Keg
trigger8 = (MatchNo < 4) || (root, var(58) < 150) || ((root, var(57) & 1) = 0) || (Floor((root, fvar(38)-Floor(root, fvar(38)))*100) = 0)
;---------------------------------------------------------------------------
trigger9 = Anim = 19210 ; Inquirring Arrows
trigger9 = (MatchNo < 5) || (root, var(58) < 100) || ((root, var(57) & 2) = 0) || ((root, var(57) & 32) = 0)
;---------------------------------------------------------------------------
trigger10 = Anim = [19211,19212] ; Ice & Fire Staffs
trigger10 = (MatchNo < 5) || (root, var(58) < 200) || ((root, var(57) & 8) = 0) || ((root, var(57) & 2) = 0)
;---------------------------------------------------------------------------
trigger11 = Anim = 19213 ; Mushu
trigger11 = (MatchNo < 6) || (root, var(58) < 250) || ((root, var(57) & 64) = 0)
;---------------------------------------------------------------------------
trigger12 = Anim = 19214 ; Biggoron Sword
trigger12 = (MatchNo < 6) || (root, var(58) < 300) || ((root, var(57) & 8) = 0) || ((root, var(57) & 1) = 0) || ((root, var(57) & 64) = 0)
;---------------------------------------------------------------------------
trigger13 = Anim = 19215 ; Mirror Shield
trigger13 = (MatchNo < 7) || (root, var(58) < 300) || ((root, var(57) & 8192) = 0)
;---------------------------------------------------------------------------
trigger14 = Anim = 19216 ; Spooky's Mask
trigger14 = (MatchNo < 7) || (root, var(58) < 400) || ((root, var(57) & 2048) = 0)
;---------------------------------------------------------------------------
trigger15 = Anim = 19217 ; Nayru's love
trigger15 = (MatchNo < 8) || (root, var(58) < 500) || ((root, var(57) & 32768) = 0)
;---------------------------------------------------------------------------
trigger16 = Anim = 19218 ; Majora's Mask - Not Used Yet
;---------------------------------------------------------------------------
trigger17 = Anim = 19219 ; Bottle
trigger17 = (root, var(58)<100) || ((Floor(root, fvar(39)*10) != 0) && (Floor(root, fvar(39)*100)%10 != 0) && (Floor(root, fvar(39)*1000)%10 != 0) && (Floor(root, fvar(39)*10000)%10 != 0))
;---------------------------------------------------------------------------
trigger18 = Anim = 19220 ; Bottle item = fairy
trigger18 = (MatchNo < 3) || (root, var(58)<100) || ((Floor(root, fvar(39)*10) != 1) && (Floor(root, fvar(39)*100)%10 != 1) && (Floor(root, fvar(39)*1000)%10 != 1) && (Floor(root, fvar(39)*10000)%10 != 1))
;---------------------------------------------------------------------------
trigger19 = Anim = [19221,19222] ; Bottle item = life or mana potion
trigger19 = (MatchNo < 3) || (root, var(58)<150) || ((Floor(root, fvar(39)*10) != 1) && (Floor(root, fvar(39)*100)%10 != 1) && (Floor(root, fvar(39)*1000)%10 != 1) && (Floor(root, fvar(39)*10000)%10 != 1))
;---------------------------------------------------------------------------
trigger20 = Anim = 19223 ; Bottle item = complete potion
trigger20 = (MatchNo < 3) || (root, var(58)<200) || ((Floor(root, fvar(39)*10) != 1) && (Floor(root, fvar(39)*100)%10 != 1) && (Floor(root, fvar(39)*1000)%10 != 1) && (Floor(root, fvar(39)*10000)%10 != 1))
;---------------------------------------------------------------------------
trigger21 = Anim = 19224 ; Arrows
trigger21 = (MatchNo < 3) || ((root, var(57) & 2) = 0) || (Floor(root, fvar(38)) = Floor(root, fvar(37))) || (root, var(56) & 16)
;---------------------------------------------------------------------------
trigger22 = Anim = 19225 ; Bombs
trigger22 = Floor((root, fvar(38)-Floor(root, fvar(38)))*100) = Floor((root, fvar(37)-Floor(root, fvar(37)))*100) || (root, var(56) & 64)
;---------------------------------------------------------------------------
value = Anim + 100

