trigger1 = 1
flag = nofg

[State 19200, FadeBG]
type = BGPalFX
trigger1 = 1
time = 1
add = -100,-100,-100

[State 19200, On The Screen]
type = PosSet
trigger1 = Time = 0
X = -70
Y = -(screenpos Y)+82

[State 19200, NoCommand]
type = VarSet
trigger1 = var(0)
trigger1 = AnimElem = 1, = 10
var(0) = 0

[State 19200, TypeAnim]
type = VarSet
trigger1 = !var(1)
trigger1 = Anim = [19301,19325]
trigger2 = var(1)
trigger2 = Anim = [19201,19225]
var(1) = 1-var(1)

[State 19200, Command]
