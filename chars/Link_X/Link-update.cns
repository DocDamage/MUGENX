[StateDef 7100]
type = A
anim = 362
ctrl = 0

[State 7100, Set Choice 1 - NoArrow]
type = VarSet
trigger1 = Floor(root,fvar(37))>0
trigger2 = !(root, var(56) & 16)
var(2) = 1

[State 7100, Set Choice 2 - NoBomb]
type = VarSet
trigger1 = (root,fvar(37))-Floor(root,fvar(37))>0
trigger2 = !(root, var(56) & 64)
var(3) = 1

[State 7100, Choose Item]
type = VarRandom
trigger1 = Time = 0
v = 0
range = 0,(1+var(2)+var(3))

[State 7100, Anim Item]
type = ChangeAnim
trigger1 = Time = 0
value = 7300+var(0) + ((var(0) = 2) && (var(2) = 0))

[State 7100, end]
type = ChangeState
trigger1 = Time = 0
value = Anim-199

