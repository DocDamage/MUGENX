[StateDef 7500] ; Rupee Bonus on Perfect & Malus on a 3rounds Match
type = S
movetype = I
physics = N
anim = 362

[State 7500, MemoryRup]
type = VarSet
trigger1 = Time = 0
var(0) = parent,var(58)

[State 7500, Snd]
type = PlaySnd
;triggerall = Time%2 = 0
trigger1 = WinPerfect
trigger1 = parent, var(58) < var(0)+50
trigger1 = Parent, var(58) < Parent, var(55)
trigger2 = !Win & !DrawGame
trigger2 = parent, var(58) > 0
trigger2 = parent, var(58) > var(0)-100
value = 7000,0

[State 7500, Perfect Bonus]
type = ParentVarAdd
trigger1 = Parent, var(58) < Parent, var(55)
trigger1 = WinPerfect
trigger1 = parent,var(58) < var(0)+50
var(58) =  1

[State 7500, 3RoundsMatch Malus]
type = ParentVarAdd
trigger1 = !Win && !DrawGame
trigger1 = parent,var(58) > 0
trigger1 = parent,var(58) > var(0)-100
var(58) =  -1

