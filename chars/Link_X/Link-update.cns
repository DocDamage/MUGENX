;------------------------------------------------
[StateDef 6010] ; Baril
type = S
movetype = I
physics = S
anim = 381
velset = 0,0
sprpriority = 3

[State 6010, Unhittable]
type = NotHitBy
trigger1 = 1
value = SCA

[State 6010, Deplace 1] ; pushed by enemy
type = VelSet
trigger1 = anim = 381
trigger1 = Floor(Pos X)-Floor(EnemyNear, Pos X) = [-20,20]
trigger1 = EnemyNear, Vel X > 0
trigger1 = EnemyNear, Pos Y >= 0
trigger1 = Pos Y = 0
X = (EnemyNear, Vel X)*IfElse((Facing = EnemyNear, Facing),1.5,-1.5)
Y = -3.0

[State 6010, Deplace 1] ; pushed by partner
type = VelSet
trigger1 = NumPartner
trigger1 = anim = 381
trigger1 = Floor(Pos X)-Floor(Partner, Pos X) = [-20,20]
trigger1 = Partner, Vel X > 0
trigger1 = Partner, Pos Y >= 0
trigger1 = Pos Y = 0
X = (Partner, Vel X)*IfElse((Facing = Partner, Facing),1.5,-1.5)
Y = -3.0

[State 6010, Deplace 3] ; pushed by Link
type = VelSet
trigger1 = anim = 381
trigger1 = Floor(ParentDist X) = [-20,20]
trigger1 = Parent, Vel X > 0
trigger1 = Parent, Pos Y >= 0
trigger1 = Parent, Stateno != 6000 && Parent, Stateno != [1100,1120]
trigger1 = Pos Y = 0
X = (Root, Vel X)*IfElse((Facing = Root, Facing),1.5,-1.5)
Y = -3.0

[State 6010, Sound]
type = PlaySnd
triggerall = Pos Y = 0
triggerall = anim = 381
trigger1 = Floor(Pos X)-Floor(EnemyNear, Pos X) = [-20,20]
trigger1 = EnemyNear, Vel X > 0
trigger1 = EnemyNear, Pos Y >= 0
trigger2 = NumPartner
trigger2 = Floor(Pos X)-Floor(Partner, Pos X) = [-20,20]
trigger2 = Partner, Vel X > 0
trigger2 = Partner, Pos Y >= 0
trigger3 = Floor(ParentDist X) = [-20,20]
trigger3 = Parent, Vel X > 0
trigger3 = Parent, Pos Y >= 0
trigger3 = Parent, Stateno != 6000 && Parent, Stateno != [1100,1120]
value = 340,1

[State 6010, TypeAir]
type = StateTypeSet
trigger1 = Vel Y < 0
trigger1 = StateType != A
statetype = A
physics = N

[State 6010, Gravity on Deplace]
type = VelAdd
trigger1 = Pos Y < 0
y = .4

[State 6010, Replace]
type = PosSet
trigger1 = Pos Y < 0
trigger1 = abs(Pos Y) < Vel Y
Y = 0

[State 6010, StopVel]
type = VelSet
trigger1 = Vel Y > 0
trigger1 = Pos Y = 0
Y = 0

[State 6010, Dust]
type = Explod
trigger1 = Vel Y = 0
trigger1 = StateType = A
anim = 911
ID = 6010
pos = -Floor(Pos Y),0
bindtime = -1
sprpriority = 2

[State 6010, TypeGround]
type = StateTypeSet
trigger1 = Pos Y = 0
trigger1 = Vel Y = 0
trigger1 = StateType = A
statetype = S
physics = S

[State 6010, PreventSnd]
type = PlaySnd
trigger1 = AnimElemTime(1) = 90
value = 8000,2

[State 6010, ExplodSnd]
