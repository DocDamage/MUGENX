;------------------------------------------------
[StateDef 7111] ; Heart Down
type = A
velset = 1,0
sprpriority = 5

[State 7111, Down]
type = VelSet
trigger1 = !(time%10)
trigger1 = StateType = A
Y = 3

[State 7111, XVel]
type = VelSet
trigger1 = abs(Vel X) != 1
trigger1 = StateType = A
X = 1

[State 7111, Slow]
type = VelMul
trigger1 = !(time%5)
trigger1 = StateType = A
Y = 0.5

[State 7111, ChangeX]
type = VelMul
trigger1 = !(time%30)
trigger1 = StateType = A
X = -1

[State 7111, Land]
type = PosSet
trigger1 = Vel Y <= Pos Y
trigger1 = StateType = A
Y = 0

[State 7111, Type]
type = StateTypeSet
trigger1 = Pos Y = 0
statetype = S

[State 7111, VelOff]
type = ChangeState
trigger1 = StateType = S
value = 7112

;------------------------------------------------
[StateDef 7112] ; Heart on ground
type = S
velset = 0,0
sprpriority = 5

[State 7112, Blinking]
type = AssertSpecial
trigger1 = Time > 60
trigger1 = Time%5 = 0
trigger2 = var(1)
flag = invisible

[State 7112, Catch]
type = ParentVarSet
triggerall = !var(1)
trigger1 = ParentDist X = [-(Parent, Const(size.ground.back))-5, 5+(Parent, Const(size.ground.front))]
trigger1 = ParentDist Y > -10
trigger2 = NumHelper(315)
trigger2 = abs((Pos X) - (Helper(315), Pos X)) = [0,10]
trigger2 = abs((Pos Y) - (Helper(315), Pos Y-30)) = [0,10]
var(52) = 1

[State 7112, SndCount]
type = VarSet
trigger1 = root, var(52) = 1
var(1) = 4

[State 7112, LifeSnd]
type = PlaySnd
trigger1 = var(1) > 1
trigger1 = !(time%10)
value = 11000,2

[State 7112, DecSnd]
type = VarAdd
trigger1 = var(1) > 1
trigger1 = !(time%10)
var(1) = -1

[State 7112, Kill]
type = DestroySelf
trigger1 = var(1) = 1
trigger2 = !var(1)
trigger2 = Time = 90

