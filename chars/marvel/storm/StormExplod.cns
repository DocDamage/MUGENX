type = VarSet
trigger1 = Pos Y < 0
trigger1 = Vel Y >= 4
trigger1 = command = "holdup"
var(11) = 1

[State -2]
type = VarSet
trigger1 = command != "holdup"
trigger2 = StateType != A
var(11) = 0

[State -2]
type = VelSet
trigger1 = var(11)
trigger1 = MoveType != H
trigger1 = Vel Y >= 4
y = 4

;---------------------------------------------------------------------------
;-[ After KO attacking ]-
