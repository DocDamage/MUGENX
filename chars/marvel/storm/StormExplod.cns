type = Helper
trigger1 = 0
stateno = 10000
postype = p1
pos = 0,0
bindtime = -1
id = 10000
name = "Cape"

;---------------------------------------------------------------------------
;-[ Dizzy ]-
[State -2]
type = VarAdd
trigger1 = var(53) > 0
var(53) = -5

[State -2]
type = VarSet
trigger1 = var(53) < 0
var(53) = 0

[State -2]
type = VarSet
trigger1 = StateNo != 9004
trigger1 = MoveType != H
var(54) = 0

[State -2]
type = VarSet
trigger1 = var(53) > 15000
var(53) = 15000

[State -2]
type = VarAdd
trigger1 = StateNo = 5000 || StateNo = 5010 || StateNo = 5020
trigger1 = Time = 0
var(52) = 1

[State -2]
type = VarSet
trigger1 = MoveType != H
var(52) = 0

[State -2]
type = VarAdd
trigger1 = var(54) = 0
trigger1 = StateNo = 5000 || StateNo = 5010 || StateNo = 5020
trigger1 = Time = 0
trigger1 = var(52) < 15
var(53) = ((GetHitVar(animtype) = 0) * 300) + ((GetHitVar(animtype) = 1) * 400) + ((GetHitVar(animtype) = 2) * 500) + ((GetHitVar(animtype) >= 3) * 600)
ignorehitpause = 1
persistent = 0

[State -2]
type = SelfState
trigger1 = StateNo = 5000 || StateNo = 5010 || StateNo = 5020
trigger1 = Time = 1
trigger1 = var(53) >= 15000
trigger1 = LoseKO = 0
value = 9001
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
