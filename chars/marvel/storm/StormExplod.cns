trigger1 = Random < 500
value = 192

[State 191, AssertSpecial]
type = AssertSpecial
trigger1 = Time < 120
flag = Intro

[State 191, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 191
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; TAUNT
[Statedef 195]
type = S
movetype = I
physics = S
;anim = 195
velset = 0,0,0
ctrl = 0

[State 195, ChangeAnim]
type = ChangeAnim
trigger1 = Time = 0 && Anim != StateNo
value = StateNo

[State 195, PlaySnd]
type = PlaySnd
trigger1 = Time = 10
value = 180,0

[State 195, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundno = 1
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundno = 1
fvalue = 0

[State 5900, VarSet]
type = VarSet
trigger1 = roundno = 1
var(36) = IfElse(facing,1,-1)

[State 5900, 3] ;Intro
type = ChangeState
trigger1 = roundno = 1
value = 190

;---------------------------------------------------------------------------
; HITG_SHAKE
[Statedef 5000]
type    = S
movetype= H
physics = N
velset = 0,0

[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Anim = ifelse((GetHitVar(groundtype) = 1),15000,15010) + GetHitVar(animtype)
trigger1 = AnimTime = 0
trigger1 = GetHitVar(animtype) != [3,5]
trigger2 = Anim = ifelse((GetHitVar(groundtype) = 1),35000,35010) + GetHitVar(animtype)
trigger2 = AnimTime = 0
trigger2 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),25000,25010) + GetHitVar(animtype)
ignorehitpause = 1

[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Anim = ifelse((GetHitVar(groundtype) = 1),25000,25010) + GetHitVar(animtype)
trigger1 = AnimTime = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),35000,35010) + GetHitVar(animtype)
ignorehitpause = 1

[State 5000, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),15000,15010) + GetHitVar(animtype)
ignorehitpause = 1

[State 5000, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 15030

[State 5000, 2] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Anim = 15030
trigger1 = AnimTime = 0
trigger1 = GetHitVar(animtype) = [3,5]
trigger2 = Anim = 35030
trigger2 = AnimTime = 0
trigger2 = GetHitVar(animtype) = [3,5]
value = 25030
ignorehitpause = 1

[State 5000, 2] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Anim = 25030
trigger1 = AnimTime = 0
trigger1 = GetHitVar(animtype) = [3,5]
value = 35030
ignorehitpause = 1

[State 5000, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type

[State 5000, 3] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 5000, 4] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 && GetHitVar(fall)
trigger2 = Pos Y != 0
value = a

[State 5000, 5]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0
value = 5001 ;HITG_SLIDE

[State 5000, 6]
type = ChangeState
trigger1 = HitShakeOver
value = 5030

[State 5000, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 5000, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 5000, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

