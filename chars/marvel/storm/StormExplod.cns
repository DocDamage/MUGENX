;---------------------------------------------------------------------------
;----------------------------[Shinta] presents...---------------------------
;-----------------------------------Storm-----------------------------------
;---------------------------------------------------------------------------

;Variables
;var(0)  = Random
;var(4)  = Win!
;var(5)  = Hyper KO Black screen
;var(7)  = AI
;var(8)  = Hyper Combo Finish
;var(9)  = Combo counter
;var(10) = Super Jump direction toggler
;var(11) = Float
;fvar(12)= P2 X coordinate
;fvar(13)= P2 Y coordinate
;var(20) = Kuuchu Nage
;var(30) = Mind Gem
;var(31) = Power Gem
;var(32) = Reality Gem
;var(33) = Soul Gem
;var(34) = Space Gem
;var(35) = Time Gem
;var(36) = Player x
;var(37) = Gem cursor
;var(38) = Gem Display count
;var(39) = HIT!
;var(40) = Mind Gem Timer
;var(41) = Power Gem Timer
;var(42) = Reality Gem Timer
;var(43) = Soul Gem Timer
;var(44) = Space Gem Timer
;var(45) = Time Gem Timer
;var(46) = Super Armor
;var(47) = Random
;var(48) = Recovery Roll
;var(51) = Reality X/A counter
;var(52) = Enemy combo counter
;var(53) = Dizzy
;var(54) = Disable redizzy combo
;var(59) = Win pose

[Data]
life = 1000               ;Amount of life to start with
attack = 100              ;100% attack power (more is stronger)
defence = 100             ;100% defensive power (more is stronger)
power = 5000              ;Thanks, Herman!!  :D
fall.defence_up = 50      ;Def goes up by 50% everytime player is hit on ground
liedown.time = 10         ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 20            ;Can do 20 points of juggling
sparkno = 0               ;Default spark number
guard.sparkno = 40        ;Default guard spark number
KO.echo = 0               ;1 to enable echo on KO
volume = 255              ;Volume offset (negative for softer)
IntPersistIndex = 60      ;Anything higher can be global
FloatPersistIndex = 40    ;.

[Size]
xscale = 1                ;Horizontal scaling factor.
yscale = 1                ;Vertical scaling factor.
ground.back = 30          ;Player width (back, ground)
ground.front = 30         ;Player width (front, ground)
air.back = 24             ;Player width (back, air)
air.front = 24            ;Player width (front, air)
z.width = 3               ;Player width (into and out)
height = 60	              ;Height of player (for opponent to jump over)
attack.width = 4,4        ;Default attack width: back, front
attack.dist = 160         ;Default attack distance
proj.attack.dist = 90     ;Default attack distance for projectiles
proj.doscale = 0          ;Set to 1 to scale projectiles too   

[Velocity]
walk.fwd  = 3.75          ;Walk forward
walk.back = -3.66         ;Walk backward
run.fwd  = 7.75, 0        ;Run forward (x, y)  - if y<0, player will hop
run.back = -7.75, 0       ;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-8.5         ;Neutral jumping velocity (x, y)
jump.back = -3,-9         ;Jump back Speed (x, y)
jump.fwd = 3,-9           ;Jump forward Speed (x, y)

[Movement]
airjump.num = 0           ;Number of air jumps allowed (opt)
airjump.height = 50       ;Minimum distance from ground before you can air jump (opt)
yaccel = .39              ;Vertical acceleration
stand.friction = .85      ;Friction coefficient when standing
crouch.friction = .82     ;Friction coefficient when crouching



;---------------------------------------------------------------------------
;-------------------------------[State -2]----------------------------------
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
[Statedef -2]

;---------------------------------------------------------------------------
;-[ Debug Display ]-
[State -2]
type = DisplayToClipboard
trigger1 = Time >= 0
text = "AI:%d,Gem:%d,RecoveryRoll:%d,Dizzyable:%d,Dizzy:%d"
params = var(7),var(37),var(48),var(54),var(53)

;---------------------------------------------------------------------------
;-[ Explod Control ]-
ignorehitpause = 1
[State -2]
type = RemoveExplod
trigger1 = Anim != 0
id = 20000
ignorehitpause = 1
[State -2]
type = RemoveExplod
trigger1 = Anim != 100
id = 10100
ignorehitpause = 1
[State -2]
type = RemoveExplod
trigger1 = Anim != 105
id = 10105
ignorehitpause = 1

;---------------------------------------------------------------------------
; -[ Cape ]-
