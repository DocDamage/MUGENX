; Stand to Crouch
[Statedef 10]
type    = C
physics = C
;anim = 10
ctrl = 1

[State 10, 1]
type = VelMul
trigger1 = !Time
x = .75

[State 10, ChangeAnim]
type = ChangeAnim
trigger1 = !Time && Anim != 10
value = 10

[State 10, 2]
type = ChangeState
trigger1 = !AnimTime
value = 11

