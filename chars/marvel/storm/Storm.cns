;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, Explod]
type = Explod
trigger1 = !(Time%90)
anim = 20000
sprpriority = 2
postype = p1
pos = 0,0
bindtime = 1
pausemovetime = 2147483647
supermovetime = 2147483647
name = "Stand Wind/Electricity"
id = 20000

[State 0, CtrlSet]
type = CtrlSet
trigger1 = PrevStateNo = 9000
value = 1

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = !Time
y = 0

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = !Time && Anim != 0
value = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, DestroySelf]
type = DestroySelf
trigger1 = IsHelper

;---------------------------------------------------------------------------
; Cape
[Statedef 10000]
type = S
physics = N
anim = 10000
sprpriority = 0

[State 10000, AssertSpecial]
type = AssertSpecial
trigger1 = parent, Anim != 0
flag = Invisible

[State 10000, PosSet]
type = PosSet
trigger1 = 1
x = parent, Pos X
y = parent, Pos Y

[State 10000, Turn]
type = Turn
trigger1 = facing != parent, facing

