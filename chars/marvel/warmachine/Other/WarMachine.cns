trigger1 = time = 0
sysvar(1) = 0

[state 700, 2]
type = varset
trigger1 = command = "holdfwd"
sysvar(1) = 1

[state 700, 3]
type = varset
trigger1 = command = "holdback"
sysvar(1) = -1

[state 700, 5]
type = velset
trigger1 = (animtime = 0) && (prevstateno = 100) && (sysvar(1) = 1)
x = const(velocity.runjump.fwd.x)

[state 700, 4]
type = velset
triggerall = palno <= 6
trigger1 = animtime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = -14

[state 700, 4]
type = velset
triggerall = palno >= 7
trigger1 = animtime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = -12

[state 700, 2]
type = PlaySnd
trigger1 = time = 0
value = 710,0

[state 700, 6]
type = changestate
trigger1 = animtime = 0
value = 701
ctrl = 1

