phase = 10

[State 20, 2]
type = VelSet
triggerall = palno >= 7
trigger1 = Anim = 22
trigger1 = AnimElemNo(0) = 9
trigger2 = AnimElemNo(0) = 29
x = 0

[State 20, 2]
type = PosFreeze
triggerall = palno >= 7
trigger1 = Anim = 22
trigger1 = AnimElemNo(0) = 9
trigger2 = AnimElemNo(0) = 29
value = 1

[State 20, 3]
type = ChangeAnim
triggerall = palno <= 6
triggerall = command = "holdfwd"
trigger1 = Anim != 20
value = 20

[State 20, 3]
type = ChangeAnim
triggerall = palno >= 7
triggerall = command = "holdfwd"
trigger1 = Anim != 22
value = 22

[State 20, 2]
type = VelSet
triggerall = palno >= 7
trigger1 = command = "holdback"
trigger1 = AnimElemNo(0) != [21,24]
trigger1 = AnimElemNo(0) != [45,48]
x = -1.75

[State 20, 2]
type = VelSet
triggerall = palno >= 7
trigger1 = Anim = 23
trigger1 = AnimElemNo(0) = 21
trigger2 = AnimElemNo(0) = 45
x = 0

[State 20, 2]
type = PosFreeze
triggerall = palno >= 7
trigger1 = anim = 23
trigger1 = AnimElemNo(0) = 21
trigger2 = AnimElemNo(0) = 45
value = 1

[State 20, 1]
type = EnvShake
triggerall = palno >= 7
triggerall = anim = 23
trigger1 = AnimElemNo(1) = 21
trigger2 = AnimElemNo(1) = 45
time = 8
phase = 10

[State 20, 3]
type = ChangeAnim
triggerall = palno >= 7
triggerall = command = "holdback"
trigger1 = Anim != 23
value = 23

[State 20, 3]
type = ChangeAnim
triggerall = palno <= 6
triggerall = command = "holdback"
trigger1 = Anim != 21
value = 21

[State 20, 1]
type = VelSet
