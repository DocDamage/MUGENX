trigger1 = !Time
trigger2 = Time = 1
trigger3 = Time = 5
trigger4 = Time = 9
trigger5 = Time = 13
time = 2
add = 164,11,0
mul = 358,256,256
color = 128
ignorehitpause = 1

[State 1000, 0]
