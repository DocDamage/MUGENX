; Definition file for WarMachine
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Marvel vs. Capcom's WarMachine"        ;Name of character
displayname = "WarMachine" ;Name of character to display
author = "One Winged Angel"      ;Character author name
pal.defaults = 1,2,3   ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = WM/WarMachine.cmd   ;Command set
cns     = Other/WarMachine.cns   ;Constants
st      = Other/WarMachine.cns   ;States
stcommon = Other/common.cns ;Common states
sprite  = Other/WarMachine.sff   ;Sprite
anim    = Other/WarMachine.air   ;Animation
sound  = Other/WarMachine.snd   ;Sound
pal1   = Palette/normal2.act   ;Palettes (can have up to 12)
pal2   = Palette/spec1.act     ; Palette by Snake
pal3   = Palette/WM1.act	     ; Palette by Snake
pal4   = Palette/normal.act
pal5   = Palette/WM2.act	     ;Palette by Snake
pal6   = Palette/normal.act
pal7   = Palette/gold2.act
pal8   = Palette/WM3.act	     ;Palette by Snake
pal9   = Palette/gold2.act
pal10  = Palette/gold.act
pal11  = Palette/WM4.act 	     ;Palette by Snake
pal12  = Palette/WM5.act       ;Palette by Snake
