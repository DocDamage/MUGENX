;Contains all the filenames needed for the character
;----------------------------------------------------

;Character Information
[Info]

;----------------------------------------------------------------------
name         = "Colossus"     ;Name of character
displayname  = "Colossus"     ;Name of character to display
versiondate  = 7,26,2001      ;Version date of character
mugenversion = 01129          ;Version of M.U.G.E.N character works on
author       = "Loki"         ;Character author name
;----------------------------------------------------------------------
;Files for 
[Files]

;|===============|
;|Character Files|
;|===============|

sprite    = colossusEX.sff     ;Sprite
sound     = colossusEX.snd     ;Sound
anim      = colossusEX.air     ;Animation
cmd       = colossusEX.cmd     ;Command set
cns       = constants.cns      ;Constants
stcommon  = common1.cns        ;Common states
st        = override.cns       ;Override states
st2       = state-2.cns        ;States
st3       = poses.cns
st4       = misc.cns
st5       = moves.cns
st6       = attacks.cns
;st7      = ai.cns	       ;Not available  

;|========|
;|Palettes|
;|========|

pal1      = colossusEX.act
pal2      = colossusEX1.act
pal3      = colossusEX2.act
pal4      = colossusEX3.act
pal5      = Purple.act
pal6      = Teal.act
pal7      = Green.act



