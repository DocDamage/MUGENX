;Novo state
[Statedef 704]
type    = A
movetype= H
physics = N

[State 703, 1]
type = velset
trigger1 = time = 0
x = -20   
y = -4

[State 703, 2]
type = veladd
trigger1 = 1
y = 0.7 

[State 703, 3] ;Change anim when done with transition
type = ChangeAnim
trigger1 = Animtime = 0
trigger1 = Anim = 5035
trigger2 = time = 0     ;If no transition anim
trigger2 = Anim != 5035
trigger2 = (Anim != [5051, 5059]) && (Anim != [5061, 5069])
trigger2 = Anim != 5090 ;Not if hit off ground anim
value = 5050

[State 703, 5] ;Recover near ground
type = selfstate
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5200 ;HITFALL_RECOVER

[State 703, 6]; Recover in mid air
type = selfstate
triggerall = Vel Y > -1
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5210 ;HITFALL_AIRRECOVER

[State 703, 7]
type = selfstate
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, 25)
value = 5100

