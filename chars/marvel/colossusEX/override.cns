;Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47

[State 52, 2]
type = Explod
pos = -62,7
triggerall=1
trigger1 = stateno=52
persistent =0 
anim = 6020

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = turn
trigger1 = p2dist x < 0
;trigger1 = animelem = 4
persistent = 0

[State 52, 4]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, 5]
type = playsnd
trigger1 = time = 0
value = 4, 0

[State 52, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type = S
physics = S
anim = 100
sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, explod]
type = explod
trigger1 = time = 2
postype = p1
pos = -40,0
anim = 6030
sprpriority = 2
bindtime = 32
removetime = 32

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = changestate
trigger1 = animtime = 0
value = 101

;---------------------------------------------------------------------------
; RUN_FWD End
[Statedef 101]
type = S
physics = S
anim = 101
sprpriority = 1
velset = 0,0
facep2 = 0

[State 101, 1]
type = changestate
trigger1 = animtime = 0
value = 0

