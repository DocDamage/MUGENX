;//===============================
;//Colossus's poses actions file
;//===============================
;//Created By Loki

;---------------------------------------------------------------------------
; LOSE (Time over)
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; DRAWGAME (Time over)
[Statedef 175]
type = S
ctrl = 0
velset = 0,0

[State 175, 1] ; If no anim, use go to lose state.
type = ChangeState
trigger1 = Time = 0
trigger1 = !SelfAnimExist(175)
value = 170

[State 175, 2]
type = ChangeAnim
trigger1 = Time = 0
value = 175

[State 175, 3]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
;Win
[Statedef 180]
type = S

[State 180, 1]
type = changeanim
trigger1 = life < 900
value = ifelse(random<=500,180,181)

[State 180, 2]
type = changeanim
trigger1 = life > 900
value = 182

[State 180, 3]
type = changestate
trigger1 = time = 0
value = 181

;Win1
[Statedef 181]
type = S
ctrl = 0
velset = 0,0
sprpriority = -3

[State 181, 1]
type = nothitby
trigger1 = 1
value = SCA
time = 1

[State 181, 2]
type = playsnd
trigger1 = time = 0
value = 1,6

;---------------------------------------------------------------------------
; PREINTRO
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(190)
value = 190

[State 190, 2] ;Go straight to intro.
type = ChangeState
trigger1 = Time = 0
value = 191

;---------------------------------------------------------------------------
; INTRO (override this state to give character an intro)
[Statedef 191]
type = S
ctrl = 0

[State 191, 1]
type = assertspecial
trigger1 = 1
flag = intro

[State 191, 2]
type = envshake
trigger1 = animelem = 22
time = 10

[State 191, 3]
type = playsnd
trigger1 = animelem = 22
value = 0,0

[State 191, 4]
type = playsnd
trigger1 = animelem = 23
value = 1, 2

[State 191, 5]
type = changestate
trigger1 = animtime = 0
value = 0