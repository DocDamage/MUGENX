[Statedef -2]
;----------------------------------------------------------------------
;Debug
[State -2, P2Dist X]
type = varset
trigger1 = 1
fvar(0) = p2dist x

[State -2, P2Dist Y]
type = varset
trigger1 = 1
fvar(1) = p2dist y

[State -2, Debug]
type = displaytoclipboard
trigger1 = 1
text = "AI = %d Dizzy = %d P2Dist X = %f P2Dist Y = %f"
params = var(5), var(0), fvar(0), fvar(1)
