trigger1 = backedgedist <= 2
persistent = 0
anim = f72

[State 0]
type = changeanim
trigger1 = gethitvar(hittime) < 4
trigger1 = !selfanimexist(5061)
trigger1 = selfanimexist(5060)
value = 5060

[State Debug Display]
