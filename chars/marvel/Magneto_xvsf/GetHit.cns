;バウンド
[Statedef 296]
type    = A
movetype= H
physics = N

[State EnvShake]
type = FallEnvShake
trigger1 = Time = 0

[State Var]
type = VarSet
trigger1 = Time = 0
sysvar(1) = floor(vel y)

[State 2]
type = ChangeAnim
triggerall = time = 0
trigger1 = (anim != [5051,5059]) && (anim != [5061,5069])
trigger2 = !SelfAnimExist(5100 + (anim % 10))
value = 5100

[State 3]
type = ChangeAnim
trigger1 = time = 0
trigger1 = (anim = [5051,5059]) || (anim = [5061,5069])
trigger1 = SelfAnimExist(5100 + (anim % 10))
value = 5100 + (anim % 10)

[State 4]
type = PosSet
trigger1 = Time = 0
y = 0

[State 6]
type = VelMul
trigger1 = Time = 0
x = 0.55
y = -0.5

[State 6]
type = Veladd
trigger1 = Time = 0
y = -3

[State 12]
type = ChangeState
trigger1 = Time = 0
value = 295

