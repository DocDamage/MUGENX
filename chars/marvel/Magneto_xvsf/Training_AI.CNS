;40 = 1	７，３で上段、下段の二択(真上SJ)
;40 = 2	左右の揺さ振りも入れる(前SJ＜前下D)
;40 = 3	投げ(1.5割)も入れる。
;var(42)		後ろに回りこむか	0-前から	1-後ろへ



[Statedef -3]

;================================================================================
[State -1, AI];↑のように設定可能
type = varset
trigger1  = var(40) = 0
var(40) = 2

[State -1, AI];数字を調整する事で空中ダッシュする高さを調整できます
type = varset
trigger1  = var(41) = 0
fvar(40) = -60.0

[State -1, AI]
type = VarSet
trigger1 = Life <= 0
persistent = 0
v = 40
value = 0

[State -1, AI]
type = VarSet
trigger1 = Win
persistent = 0
v = 40
value = 0

