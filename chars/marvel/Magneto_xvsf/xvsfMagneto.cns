walk.back=-2.2
run.fwd=12,0
run.back=-12.5,0
runjump.back=-3,-10
runjump.fwd=3,-10
jump.neu=0,-10
jump.back=-3,0
jump.fwd=3,0
airjump.neu=0,-8.1
airjump.back=-2.55,-8.1
airjump.fwd=2.5,-8.1

