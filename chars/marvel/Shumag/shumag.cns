;*******standing****************************************************************
;*******************************************************************************


;*******standing low punch******************************************************
[statedef 200]
type = s
movetype = a
physics = s
ctrl = 0
anim = ifelse(var(16) = 1, ifelse(var(10) = 6,8200,200),200)
juggle = 2

[state 200, playsnd]
type = playsnd
trigger1 = animelem = 2
value = s20, 2 

[state 200, playsnd]
type = null;playsnd
trigger1 = random < 200  
trigger1 = animelem = 1
value = s1000, 2 

[state 200, hitdef]
type = HitDef
trigger1 = AnimElem = 3
attr = S, NA
damage    = 25
animtype = Light
getpower = 30,15
givepower = 15,8
guardflag = MA
hitflag = MAF
priority = 3, Hit
pausetime = ifelse( var(16) = 1, ifelse(var(10) = 2, 7, 4),4),ifelse( var(16) = 1, ifelse( var(10) = 2, 9, ifelse( var(10) = 6, ifelse(p2movetype != h, 80, 6),6)), 6) 
numhits = 1
sparkno = s(ifelse( var(16) = 1, ifelse(var(10) = 2,20110, 20000), 20000))
guard.sparkno = s20020
sparkxy = -15,-58
hitsound = s30,0
guardsound = s31,0
ground.type = low
ground.slidetime = ifelse( prevstateno = 200, 10,5)
ground.hittime  = 12
ground.velocity = ifelse(prevstateno = 200, -10, -4)
airguard.velocity = -1.9
air.velocity = -2.3,-3
palfx.add = ifelse(var(16) = 1, ifelse(var(10) = 2,255,0),0), 0, 0
palfx.time = 7

[state 200, power_gem!]
type = null;envcolor
trigger1 = var(16) = 1
trigger1 = var(10) = 2 
trigger1 = movecontact = 1
trigger1 = p2movetype = h
value = 255, 0,0
time = 1
 

[state 200, end]
type = changestate
trigger1 = animtime = 0
ctrl = 1
value = 0  

