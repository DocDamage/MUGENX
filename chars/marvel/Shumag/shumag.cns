;*******************************************************************************
;*******************************************************************************
;**************Qkrtkf's Shhuma Gorath*******************************************
;*******************************************************************************
;*******************************************************************************
;var(1) : mystic smash x,y,z switch*********************************************
;var(2) : mystuc smash air combo switch*****************************************
;var(3) : mysric stare a,b,c switch********************************************* 
;var(4) : exp. for mystic stare************************************************* 
;var(5), var(6) : random value for explod in run********************************
;var(7) : chaos dimension activation *******************************************
;var(8) : chaos dimension timer ************************************************
;vsr(9) : mystic stare chain explosion *****************************************
;*******************************************************************************


[Data]
  ;Amount of life to start with
life = 1000
attack = 95
defence = 100
fall.defence_up = 50
liedown.time = 50
airjuggle = 18
sparkno = ;s20000
guard.sparkno = ;s20030
KO.echo = 0
volume = 255
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 0.9           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 30     ;Player width (back, ground)
ground.front = 30    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
height = 60	     ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = -5, -90   ;Approximate position of head
mid.pos = -5, -60    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 1.6      ;Walk forward
walk.back = -1.6     ;Walk backward
run.fwd  = 4.6, 0    ;Run forward (x, y)
run.back = -4.5,-2.0;Hop backward (x, y)
jump.neu = 0,-9.0   ;Neutral jumping velocity (x, y)
jump.back = -3.2, -9.0    ;Jump back Speed (x, y)
jump.fwd = 3.4, -9.0       ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-8.1      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.

[Movement]
;airjump.num = 1      ;Number of air jumps allowed (opt)
;airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .43         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
; CNS レベル: 基?
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;run
[statedef 100]
type = s
physics = n
anim =  100
ctrl = 1
velset = 8, 0


[state 100, nowalk]
type = assertspecial
trigger1 = 1
flag = nowalk

[state 100, var]
type = varrandom
trigger1 = 1
v = 5 
range = -35, 46

[state 100, var]
type = varrandom
trigger1 = 1
v = 6
range = -50, -5

[state 100, wind~]
type = explod
trigger1 = time >= 4
trigger1 = (time%4) = 2
trigger1 = anim = 100
anim = 20050
pos = var(5), var(6)
removetime = -2
sprpriority = 2

[state 100, end]
type = changeanim
triggerall = time >= 19
triggerall = anim = 100
trigger1 = command != "holdfwd"
trigger2 = p2bodydist x < 20
value =  101

[state 100, stop]
type = velset 
trigger1 = anim = 101
x = 0

[state 100, realend]
type = changestate
trigger1 = animtime = 0
trigger1 = anim = 101
value = 0

;back dash
[statedef 110]
type = s
physics = n
ctrl = 0
velset = -4, 0 
anim = 105

[state 110, back]
type = posadd
trigger1 = time = 0
x = -50

[state 110, velset]
type = velset
trigger1 = time = 27
x = 0

[state 110, end]
type = changestate
trigger1 = animtime = 0
ctrl = 1
value = 0

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
; CNS レベル: 基?
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
trigger1 = random < 500
value = 181

[state 180, 2]
type = changestate
trigger1 = time = 0
value = 182

;---------------------------------------------------------------------------
; Win pose  
; CNS レベル: 基?
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[state 181, snd]
type = playsnd
trigger1 = time = 12
value = s10,9

[Statedef 182]
type = S
ctrl = 0
anim = 182
velset = 0,0

[State 182, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[state 181, snd]
type = playsnd
trigger1 = time = 12
value = s10,9

;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
; CNS レベル: 基?
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0


[State 191, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 191, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[state 191, 10]
type = explod
trigger1 = animtime = 0
anim = 191
pos = 0, 0
removetime = -2
sprpriority = -3


[State 191, 3]
type = PlaySnd
trigger1 = animelem = 23
value = s30,4

[State 191, 4] ;Change to stand state
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;taunt---------------------------------------
[statedef 195]
type = s
movetype = i
physics = s
ctrl = 0
anim = 195

[state 195 , end]
type = changestate
trigger1 =  animtime = 0
ctrl = 1
value = 0

