;************activation!******************************
[statedef 4000]
type = s
physics = s
movetype = i
ctrl = 0
velset = 0, 0
anim = 4000

[state 4000, superpause]
type = superpause
trigger1 = time = 16
trigger1 = var(10) != 4
anim = s(4000 + var(10))
movetime = 70
time = 70
poweradd = -500
sound = s20,5

[state 4000, snd]
type = playsnd
trigger1 = time = 30
value = s10, (10+var(10))
 
[state 4000, superpause]
type = superpause
trigger1 = time = 16
trigger1 = var(10) = 4
anim = s4003 
movetime = 70
time = 70
sound = s20, 5


[state 4000, gem_activation_trigger]
type = varset
trigger1 = animtime = 0
var(16) = 1

[state 4000, remove_prev_explod]
type =removeexplod
trigger1 = animtime = -1
id = ifelse( teamside = 1, 300, 400 )

