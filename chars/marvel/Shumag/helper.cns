[state 4050, afterimg]
type = afterimage
trigger1 = time = 1
time = 288
palcolor = 256
palinvertall = 0
palbright = 50,50,50
palcontrast = 120,120,120
palpostbright = 50,50,50
paladd = 10,10,10
palmul = 1.01,1.01,1.01
length = 15
trans = add 

[state 4050, timer]
type = varadd
trigger1 = 1
v = 21
value = 1

[state 4050, pos]
type = posadd
trigger1 = 1
x = (parentdist x)-var(19)
y = (parentdist y)-var(20)

[state 4050, vel]
type = velset
trigger1 = 1
x = 60*sin((0.2)*(time))
y = 15*sin((0.1)*(time))

[state 4050, spr]
type = sprpriority
trigger1 = ((time)%(32)) = [0, 16]  
value = 5

[state 4050, spr]
type = sprpriority
trigger1 = ((time)%(32)) = [17, 31]
value = -2 

[state 4050, pos]
type = varset
trigger1 = 1
var(19) = parentdist x
var(20) = parentdist y

[state 4050, end]
type = destroyself
trigger1 = var(21) = 384


