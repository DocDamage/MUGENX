trigger1 = animelem = 4
value = 180,0

[state 12,12]
type = varrandom
trigger1 = time = 0
v = 1
range = 1,2

[state 12,12]
type = changestate
trigger1 = animtime = 0
value = 0

[state 12,12]
type = changestate
trigger1 = time = 0 && var(1) = 2
value = 192
