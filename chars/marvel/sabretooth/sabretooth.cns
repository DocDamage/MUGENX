;---------------------------------------------------------------------------
; Super Jump (for combos)
[Statedef 10022]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 10022, 2]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 10022, 3]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 10022, 4]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 10022, 5]
type = VelSet
trigger1 = AnimTime = 0
y = -10

[State 10022, 6]
type = VelSet
trigger1 = AnimTime = 0  && sysvar(1) = 1
x = 1;ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))

[State 10022, 7]
type = VelSet
trigger1 = AnimTime = 0  && sysvar(1) = -1
x = -1;ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))

[State 10022, 8]
type = veladd
trigger1 = time > 8 && command = "holdback"
x = -.02

[State 10022, 9]
type = veladd
trigger1 = time > 8 && command = "holdfwd"
x = .02

[State 10022, 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1
