;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0 && sysvar(1) = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = -12

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0 && sysvar(1) = 1
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = -10.4

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0 && sysvar(1) = -1
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = -11.6

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1
;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 0]
type = explod
trigger1 = prevstateno = 10023 && numexplod(778) = 0 && time < 30
anim = 778
id = 778
postype = p1
pos = -10,-15
bindtime = -1
supermove = 1
sprpriority = 3
ownpal = 1

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[state 50,0]
type = veladd
trigger1 = time <= 1 && prevstateno = [10022,10023]
y = -3.6

[state 12,12]
type = playsnd
triggerall = time = 1
trigger1 = prevstateno = 10022 || prevstateno = 10023
value = 42,0

[state 50,0]
type = veladd
trigger1 = time >= 8 && command = "holdfwd" && prevstateno = 10022
x = 0.07

[state 50,0]
type = veladd
trigger1 = time >= 8 && command = "holdback" && prevstateno = 10022
x = -0.07

[state 12,12]
type = veladd
trigger1 = time >= 44 || prevstateno = [400,405]
y = -0.2

[state 50,0]
type = veladd
triggerall = vel x < const(velocity.jump.fwd.x)
trigger1 = time >= 8 && command = "holdfwd" && prevstateno = 10023
x = 0.2

[state 50,0]
type = veladd
triggerall = vel x > const(velocity.jump.back.x)
trigger1 = time >= 8 && command = "holdback" && prevstateno = 10023
x = -0.2

[state 12,12]
type = changestate
trigger1 = backedgedist < 20 && command = "holdfwd" && time > 18 && time < 26 && prevstateno != 851
value = 851

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3
