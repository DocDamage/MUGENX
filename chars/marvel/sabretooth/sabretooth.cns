;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[state -2, 1]
type = removeexplod
trigger1 = stateno != 1000 && stateno != 2000
id = 575

[state -2, 2]
type = removeexplod
trigger1 = stateno != [3001, 3003] 
id = 506

[state 12345,12]
type = veladd
trigger1 = stateno = [400,405]
trigger1 = movehit = 1
persistent = 0
y = -0.4

[state 12,12]
type = playsnd
trigger1 = anim = 5300
persistent = 0
value = 5300,0
;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0

[State -3, a]
type = playsnd
triggerall = random < 500 && time = 1 && alive = 1
trigger1  = stateno = 5000 && anim = 5000 
trigger2  = stateno = 5000 && anim = 5001
trigger3  = stateno = 5000 && anim = 5010
trigger4  = stateno = 5000 && anim = 5011
trigger5  = stateno = 5010 && anim = 5020
trigger6  = stateno = 5010 && anim = 5021
trigger7  = stateno = 5020 && anim = 5000
trigger8  = stateno = 5020 && anim = 5001 
trigger9  = stateno = 5020 && anim = 5010
trigger10 = stateno = 5020 && anim = 5011 
value = 5000, 0

[State -3, b]
type = playsnd
triggerall = random < 400 && time = 1 && alive = 1
trigger1 = stateno = 5000 && anim = 5002
trigger2 = stateno = 5000 && anim = 5012 
trigger3 = stateno = 5010 && anim = 5022 
trigger4 = stateno = 5020 && anim = 5012
trigger5 = stateno = 5020 && anim = 5002 
value = 5000, 1

