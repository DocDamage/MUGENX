; Player information
[Info]
name = "Sabretooth"         ;Name of character
displayname = "Sabretooth"  ;Name of character to display
versiondate = 05,05,2001    ;Version date of character
mugenversion = 07,31,2000   ;Version of M.U.G.E.N character works on
author = "Jin Kazama"       ;Character author name
pal.defaults = 1,2,3        ;Default palettes in order of preference

; Files for the player
[Files]
cmd      = sabretooth.cmd     ;Command set
cns      = sabretooth.cns     ;Constants
st       = sabretooth.cns     ;States

stcommon = common1.cns        ;Common states

sprite   = sabretooth.sff     ;Sprite
anim     = sabretooth.air     ;Animation
sound    = sabretooth.snd     ;Sound
pal1     = sabre01.act        ;Red on Yellow
pal2     = sabre02.act        ;Purple on Yellow
pal3     = sabre03.act        ;Blue on Yellow
pal4     = sabre04.act        ;Green on Yellow
pal5     = sabre05.act        ;Orange on Yellow
pal6     = sabre06.act        ;Black on Yellow
pal7     = sabre07.act        ;Red on White
pal8     = sabre08.act        ;Purple on White
pal9     = sabre09.act        ;Blue on White
pal10    = sabre10.act        ;Green on White
pal11    = sabre11.act        ;Orange on White
pal12    = sabre12.act        ;Black on White

[Arcade]
ending.storyboard = sabreend.def