type = S
ctrl = 0
anim = 170
velset = 0,0,0

[State 170, 2]   ; What happened?
type = PlaySnd
trigger1 = Time = 5
value = 3, 3

[State 170, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

