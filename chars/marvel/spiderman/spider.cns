trigger1 = Alive
trigger1 = Time >= floor(gethitvar(hittime) * 0.8)
value = var(46)

[State 9000, VelSet]
type = VelSet
trigger1 = !Alive
x = gethitvar(xvel)
y = gethitvar(yvel)

[State 9000, End]
type = ChangeState
trigger1 = !Alive
value = 5050

