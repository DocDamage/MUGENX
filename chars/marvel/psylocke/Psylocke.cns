physics = A

[State 50, VelAdd]
type = VelAdd
triggerall = var(10)
triggerall = command = "holdfwd"
triggerall = command != "holdback"
trigger1 = !sysvar(1)
trigger1 = Vel X < 4
trigger2 = sysvar(1) = -1
trigger2 = Vel X < 4
x = .25

[State 50, VelAdd]
type = VelAdd
triggerall = var(10)
triggerall = command != "holdfwd"
triggerall = command = "holdback"
trigger1 = !sysvar(1)
trigger1 = Vel X > -1
trigger2 = sysvar(1) = 1
trigger2 = Vel X > 2.5
x = -.15

[State 50, ChangeAnim]
type = ChangeAnim
trigger1 = Anim != 41
trigger1 = Anim != 42
trigger1 = Anim != 43
trigger1 = Vel Y < 0
trigger1 = !Time
trigger2 = var(10)
trigger2 = AnimElem = 3
trigger2 = Vel Y < -8.5
value = (ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43)))

[State 50, ChangeAnim]
type = ChangeAnim
trigger1 = Anim = 41 || Anim = 42 || Anim = 43 || Anim = 10041 || Anim = 10042 || Anim = 10043
trigger1 = !AnimTime
trigger2 = Anim != 41 && Anim != 42 && Anim != 43 && Anim != 44 && Anim != 10041 && Anim != 10042 && Anim != 10043
trigger2 = Vel Y > 0
value = 44

[State 50, ChangeState]
type = ChangeState
triggerall = !IsHelper
triggerall = Time > 10
triggerall = var(11) < 3
trigger1 = command = "up"
trigger2 = command = "UF"
trigger3 = command = "UB"
value = 45

