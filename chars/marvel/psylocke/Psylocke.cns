;---------------------------------------------------------------------------
;----------------------------[Rumiko] presents...---------------------------
;--------------------------------Psylocke-----------------------------------
;---------------------------------------------------------------------------

;Variables
;var(0)  = Random
;fvar(0) = Combo Damage Dampener
;var(1)  = -> Key
;var(2)  = Hold Up toggle
;var(4)  = Win!
;var(5)  = Hyper KO Black screen
;var(7)  = AI
;var(8)  = Hyper Combo Finish
;var(9)  = Combo counter
;var(10) = Super Jump direction toggler
;var(11) = Air Jump counter
;var(12) = PsiDrill detector
;fvar(12)= P2 X coordinate
;fvar(13)= P2 Y coordinate
;var(14) = Knife attacking!
;var(15) = Knife Circle Controller - aborted
;var(16) = PsiThrust counter
;var(17) = Hyper Combo Finish Keep-track
;var(20) = Kuuchu Nage
;var(21) = Knife One
;var(22) = Knife Two
;var(23) = Knife Three
;var(24) = Knife Four
;var(25) = Knife Five
;var(26) = Knife Six
;var(28) = PsiBlades
;var(30) = Mind Gem
;var(31) = Power Gem
;var(32) = Reality Gem
;var(33) = Soul Gem
;var(34) = Space Gem
;var(35) = Time Gem
;var(36) = Player x
;var(37) = Gem cursor
;var(38) = Gem Display count
;var(39) = HIT!
;var(40) = Mind Gem Timer
;var(41) = Power Gem Timer
;var(42) = Reality Gem Timer
;var(43) = Soul Gem Timer
;var(44) = Space Gem Timer
;var(45) = Time Gem Timer
;var(46) = Super Armor
;var(47) = Random
;var(48) = Recovery Roll
;var(51) = Reality X/A counter
;var(52) = Enemy combo counter
;var(53) = Dizzy
;var(54) = Disable redizzy combo
;var(55) = Gem pop threshold
;var(59) = Win pose

[Data]
life = 1000               ;Amount of life to start with
attack = 100              ;100% attack power (more is stronger)
defence = 100             ;100% defensive power (more is stronger)
power = 5000              ;Thanks, Herman!!  :D
fall.defence_up = 50      ;Def goes up by 50% everytime player is hit on ground
liedown.time = 10         ;Time player takes before getting up from HIT_LIEDOWN
airjuggle = 20            ;Can do 20 points of juggling
sparkno = 0               ;Default spark number
guard.sparkno = 40        ;Default guard spark number
KO.echo = 0               ;1 to enable echo on KO
volume = 50               ;Volume offset (negative for softer)
IntPersistIndex = 60      ;Anything higher can be global
FloatPersistIndex = 40    ;.

[Size]
xscale = 1                ;Horizontal scaling factor.
yscale = 1                ;Vertical scaling factor.
ground.back = 30          ;Player width (back, ground)
ground.front = 30         ;Player width (front, ground)
air.back = 24             ;Player width (back, air)
air.front = 24            ;Player width (front, air)
z.width = 3               ;Player width (into and out)
height = 60	              ;Height of player (for opponent to jump over)
attack.width = 4,4        ;Default attack width: back, front
attack.dist = 160         ;Default attack distance
proj.attack.dist = 90     ;Default attack distance for projectiles
proj.doscale = 0          ;Set to 1 to scale projectiles too   

[Velocity]
walk.fwd  = 3.3           ;Walk forward
walk.back = -2.8          ;Walk backward
run.fwd  = 7.75, 0        ;Run forward (x, y)  - if y<0, player will hop
run.back = -7.75, 0       ;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-8.5         ;Neutral jumping velocity (x, y)
jump.back = -4,-8.25      ;Jump back Speed (x, y)
jump.fwd = 4,-8.25        ;Jump forward Speed (x, y)
airjump.neu = 0,-8.25     ;.
airjump.back = -4,-8      ;Air jump speeds (opt)
airjump.fwd = 4,-8        ;.

[Movement]
airjump.num = 0           ;Number of air jumps allowed (opt)
airjump.height = 50       ;Minimum distance from ground before you can air jump (opt)
yaccel = .39              ;Vertical acceleration
stand.friction = .85      ;Friction coefficient when standing
crouch.friction = .82     ;Friction coefficient when crouching



;---------------------------------------------------------------------------
;-------------------------------[State -2]----------------------------------
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
[Statedef -2]

;---------------------------------------------------------------------------
;-[ Debug Display ]-
[State -2]
type = DisplayToClipboard
trigger1 = Time >= 0
text = "AI:%d,Gem:%d,AirJump:%d,Dizzyable:%d,Dizzy:%d"
params = var(7),var(37),var(11),var(54),var(53)

;---------------------------------------------------------------------------
;-[ Angle to P2 ]-
[State -2]
type = VarSet
trigger1 = p2dist X != 0
trigger1 = p2dist Y != 0
fvar(1) = atan((p2dist Y)/(p2dist X))

[State -2]
type = VarSet
trigger1 = !p2dist X
trigger1 = p2dist Y >= 0
fvar(1) = (pi/2)

[State -2]
type = VarSet
trigger1 = !p2dist X
trigger1 = p2dist Y < 0
fvar(1) = -(pi/2)

[State -2]
type = VarSet
trigger1 = p2dist X >= 0
trigger1 = !p2dist Y
fvar(1) = 0

[State -2]
type = VarSet
trigger1 = p2dist X < 0
trigger1 = !p2dist Y
fvar(1) = pi/2

;---------------------------------------------------------------------------
;-[ Vels, Vels! ]-
[State -2]
type = VelSet
triggerall = PrevStateNo = 20
trigger1 = StateNo = [200,499]
x = 0

;---------------------------------------------------------------------------
;-[ Dizzy ]-
[State -2]
type = VarAdd
trigger1 = var(53) > 0
var(53) = -5

[State -2]
type = VarSet
trigger1 = var(53) < 0
var(53) = 0

[State -2]
type = VarSet
trigger1 = StateNo != 9004
trigger1 = MoveType != H
var(54) = 0

[State -2]
type = VarSet
trigger1 = var(53) > 15000
var(53) = 15000

[State -2]
type = VarAdd
trigger1 = StateNo = 5000 || StateNo = 5010 || StateNo = 5020
trigger1 = !Time
var(52) = 1

[State -2]
type = VarSet
trigger1 = MoveType != H
var(52) = 0

[State -2]
type = VarAdd
trigger1 = var(54) = 0
trigger1 = StateNo = 5000 || StateNo = 5010 || StateNo = 5020
trigger1 = !Time
trigger1 = var(52) < 15
var(53) = ((GetHitVar(animtype) = 0) * 300) + ((GetHitVar(animtype) = 1) * 400) + ((GetHitVar(animtype) = 2) * 500) + ((GetHitVar(animtype) >= 3) * 600)
ignorehitpause = 1
persistent = 0

[State -2]
type = SelfState
trigger1 = StateNo = 5000 || StateNo = 5010 || StateNo = 5020
trigger1 = Time = 1
trigger1 = var(53) >= 15000
trigger1 = LoseKO = 0
value = 9001
ignorehitpause = 1
persistent = 0

;---------------------------------------------------------------------------
;-[ After KO attacking ]-
[State -2, ChangeState]
type = Null ;ChangeState
trigger1 = StateNo = [180,184]
trigger1 = command = "s"
value = 0
ctrl = 1

