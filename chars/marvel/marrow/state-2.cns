; Quem_sou_eu [Var(39)]: 0-Morto, 1-Primeiro, 2-Segundo
; Colaboração [Var(38)]: 1-Lutar só, 2-Duplo Especial, 3-Um Ataque, 4-Counter
; Vez na luta [Var(37)]: 1-Primeiro, 2-Segundo
; Verificação [Var(36)]: Meu ID
;             [Var(35)]: 0-Proíbe sair de tela, 1-Permite sair de tela
; P3 life     [Var(34)]: Memoriza a vida
; Recuperação [Var(33)]: Memoriza a vida


;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -2, 1] ; debug
type = DisplayToClipboard
trigger1 = roundstate > 0
;text="eu39 %d, vez37 %d, Id %d, sair? %d";bake %d";
;params = Var(39), var(37),var(36),Var(35);floor(backedgedist);
;text="Q_s_e Var(49) %d, proj Var(6) %d, V_n_l Var(5) %d, pos y %d var(3) %d"
;params = Var(49), Var(6), Var(5), floor(pos y),var(3)
;text="39=37? %d, Colab %d, p3life %d, sair? %d";bake %d";
;params = (Var(39)=Var(37)), var(38),var(34),Var(35);floor(backedgedist);
text="p2bodydist x %d, p2bodydist y %d, var(20) %d, var(2) %d"
params = floor(p2bodydist x), floor(p2bodydist y), (var(20)),var(2)

;[State 0, ]; super-pulo
;type = DisplayToClipboard
;trigger1 = Alive
;text = "Var(0): %d"
;params = Var(0)
;;ignorehitpause = 0
;;persistent = 1

[State -2, bonerang sound]   ; custom jump-landing sound
trigger1 = NumProjID(1050) = 1
trigger1 = (Time % 10) = 0
type = PlaySnd
;persistent = 0
value = 0,var(2)
volume=95

[State -2, jump landing sound]   ; custom jump-landing sound
trigger1 = stateno = 52
trigger1 = Time = 1
type = PlaySnd
persistent = 0
value = 8,1
volume=190

;[State -2, fall landing sound]   ; custom fall-landing sound
;trigger1 = stateno = [5100, 5110]
;trigger1 = Time = 1
;type = PlaySnd
;persistent = 0
;value = 8,2

; custom gethit sounds
[State -2, gethits]
type = PlaySnd
triggerall = Alive && (Time = 1) && (!IsHelper)
triggerall = random % 10 > 5
triggerall = stateno = 5000 || stateno = 5020
trigger1 = anim = 5001  ; standing medium hit high
trigger2 = anim = 5011  ; stand medium hit low
trigger3 = anim = 5021  ; crouching medium hit
persistent = 0
value = 4,0
channel = 0
volume=255
ignorehitpause = 1

[State -2, gethits]
type = PlaySnd
triggerall = Alive && (Time = 1) && (!IsHelper)
triggerall = random % 10 > 5
;triggerall = stateno = 5000 || stateno = 5020
trigger1 = anim = 5002  ; standing hard hit high
trigger2 = anim = 5012  ; stand hard hit low
trigger3 = anim = 5022  ; crouching hard hit
trigger4 = anim = 5030  ; air hit
trigger5 = anim = 5070  ; tripped
persistent = 0
value = 4,1
channel = 0
volume=255
ignorehitpause = 1

