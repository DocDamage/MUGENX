
; Doctor Doom Hecho por Juan Carlos para Mugen 28-3-2003
[Info]
name = "Dr.Doom"        ;Name of character
displayname = "Dr.Doom" ;Name of character to display
versiondate = 04,14,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "Juan Carlos"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = doctordoom.cmd   ;Command set
cns     = doctordoom.cns   ;Constants
st      = doctordoom.cns   ;States
st1     = volar.cns
st2     = a.cns
st3     = finalvictory.cns
stcommon = common1.cns ;Common states
sprite  = drdoom.sff   ;Sprite
anim    =  doctordoom.air   ;Animation
sound   =  drdoom.snd   ;Sound
pal1    =  doctordoom.act  ;Palettes (can have up to 12)
pal2    =  doctor2.act  
pal3    = doctor3.act
pal4    = doctor4.act
pal5    = doctor5.act
; Arcade mode
[Arcade]
;intro.storyboard = intro.def
ending.storyboard = ending.def

; Cualquier bug que encuentres comunicamelo a tony7@wanadoo.es