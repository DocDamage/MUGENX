; Definition file for Rogue
; Contains all the filenames needed for the character
; Rogue, X-men, and all affiliated characters are trademarks of Marvel Comics.

; Player information
[Info]
name = "Rogue"        ;Name of character
displayname = "Rogue" ;Name of character to display
versiondate = 10,31,2001    ;Version date of character
mugenversion = 4,14,2001   ;Version of M.U.G.E.N character works on
author = "Big Eli King"         ;Character author name
pal.defaults = 7,1,5,10      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = NoAI.cmd   ;Rename to "AI-on.cmd", if you want AI enabled 
cns     = rogue.cns   ;Constants
st      = rogue.cns   ;Default Move States
st1     = stolen.cns  ;Stolen Power States
st2     = assist.cns  ;Assist/Striker States
stcommon = common1.cns ;Common states
sprite  = rogue.sff   ;Sprite
anim    = rogue.air   ;Animation
sound   = rogue.snd   ;Sound
pal1=rogue1.act   ;MvC2 Color (Green and Silver)
pal2=rogue2.act   ;MvC2 Alt. Color (Green and Gold)
pal3=rogue3.act   ;Blue & Silver
pal4=rogue4.act   ;Black & Silver
pal5=rogue5.act   ;XMvSF Color 
pal6=rogue6.act   ;XMvSF Alt. Color(USA)
pal7=rogue7.act   ;Cool Blue and Black
pal8=rogue8.act   ;New Comic Colors
pal9=rogue9.act   ;Purple & Gold
pal10=rogue10.act ;Red :D
pal11=rogue11.act ;Flesh tone and Red
pal12=rogue12.act ;Movie Colors(Black)

