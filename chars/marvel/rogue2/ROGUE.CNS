attack = 100
defence = 100
power = 5000
fall.defence_up = 50
liedown.time = 20
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 150
IntPersistIndex = 51
FloatPersistIndex = 40

[Size]
