ground.front = 36    
air.back = 12        
air.front = 12       
height = 60	     
attack.dist = 160   
proj.attack.dist = 90 
proj.doscale = 0     
head.pos = -5, -90   
mid.pos = -5, -60    
shadowoffset = 0     
draw.offset = 0,0    

[Velocity]
