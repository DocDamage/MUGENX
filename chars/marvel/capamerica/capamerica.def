; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Captain America"
displayname = "Captain America"
versiondate = 09,23,2001
mugenversion = 04,14,2001
author = "MystikBlaze"
pal.defaults = 6,3,4,2

; Files for the player
[Files]
cmd     = capamerica.cmd
cns     = capamerica.cns
st      = capamerica.cns
;st1     = shield.cns
st1     = shield2.cns ;alternate shield CNS file (for slower computers)
stcommon = common1.cns
sprite  = capamerica.sff
;anim    = capamerica.air
anim    = capamerica2.air ;alternate AIR file (for slower computers)
sound   = capamerica.snd
pal1    = cap04.act
pal2    = cap05.act
pal3    = cap06.act
pal4    = cap01.act
pal5    = cap02.act
pal6    = cap03.act
pal7    = cap04.act
pal8    = cap05.act
pal9    = cap06.act
pal10   = cap01.act
pal11   = cap02.act
pal12   = cap03.act

; Arcade mode
[Arcade]
;intro.storyboard = intro.def
ending.storyboard = ending.def