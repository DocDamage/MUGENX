v = 40
range = 1,6

[State 190, VarRandom]
type = VarRandom
trigger1 = Time = 0
v = 1
range = 0,1

[State 190, Intro 1]
type = ChangeState
trigger1 = Var(1) = 0
value = 191

[State 190, Intro 2]
type = ChangeState
trigger1 = Var(1) = 1
value = 8000

;---------------------------------------------------------------------------
; Introduction 1 A (Fixing his wrist)

[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 191, AssertSpecial] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, Shield Helper]
type = Helper
trigger1 = Time = 0
helpertype = Normal
name = "Flying Shield"
ID = 191
pos = 50,-170
postype = Front
facing = -1
stateno = 193
ownpal = 0
size.ground.back = 20
size.ground.front = 20
ignorehitpause = 1

[State 191, Shield VarSet]
type = VarSet
trigger1 = Time = 0
v = 59
value = 1

[State 191, PlaySnd]
type = PlaySnd
trigger1 = Time = 54
value = 21,4

[State 191, ChangeState]
type = ChangeState
trigger1 = (Helper(191), ParentDist X < 150) && (Helper(191), BackEdgeBodyDist > 0)
value = 192

;---------------------------------------------------------------------------
; Introduction 1 B (Jumping up grabbing shield)

[Statedef 192]
type = A
physics = N
ctrl = 0
anim = 191

[State 192, 2]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 192, VelSet]
type = VelSet
trigger1 = AnimElemTime(3) = 0
y = -8

[State 192, VelAdd]
type = VelAdd
trigger1 = AnimElemTime(3) >= 0
y = 0.38

[State 192, PlaySnd];grunt
type = PlaySnd
trigger1 = AnimElemTime(5) = 0
value = 30,0

[State 192, PlaySnd];grab shield sound
type = PlaySnd
trigger1 = AnimElemTime(6) = 1
value = 20,3

[State 192, ChangeState]
type = ChangeState
trigger1 = (Pos Y >= 0) && (AnimElemTime(4) >= 0)
value = 194

;---------------------------------------------------------------------------
; Introduction 1 C (Flying Shield Helper)

[Statedef 193]
type = A
physics = N
ctrl = 0
anim = 192

[State 193, VelSet]
type = VelSet
trigger1 = Time = 50
x = 6

[State 193, DestroySelf]
type = DestroySelf
trigger1 = (parent, Anim = 191) && (parent, AnimElemTime(6) >= 1)
trigger2 = FrontEdgeBodyDist <= -40

