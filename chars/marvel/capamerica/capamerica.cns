;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, CtrlSet];Super Armor
type = CtrlSet
trigger1 = PrevStateNo = 3950
value = 1

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = ifelse(Var(40) = 16, (const(velocity.walk.fwd.x) * 1.5), (const(velocity.walk.fwd.x)))

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = ifelse(Var(40) = 16, (const(velocity.walk.back.x) * 1.5), (const(velocity.walk.back.x)))

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5 && Anim != 25
trigger2 = Anim = 5 && AnimTime = 0
value = ifelse(Var(40) = 16, 25, 20)

[State 20, 3b]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = (Anim = 25) && (Var(40) != 16)
value = 20
elem = AnimElemNo(0)

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5 && Anim != 26
trigger2 = Anim = 5 && AnimTime = 0
value = ifelse(Var(40) = 16, 26, 21)

[State 20, 4b]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = (Anim = 26) && (Var(40) != 16)
value = 21
elem = AnimElemNo(0)

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
;anim = ifelse(command != "holdfwd" && command != "holdback", 40, 39)
ctrl = 0
sprpriority = 1

[State 40, ChangeAnim 1]
type = ChangeAnim
trigger1 = (Time = 0) && (PrevStateNo != 3950)
value = ifelse(command != "holdfwd" && command != "holdback", 40, 39)

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
triggerall = Var(40) != 16
trigger1 = (AnimTime = 0) && (Var(10) != 1)
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 4b];Time Gem Velocity
type = VelSet
triggerall = Var(40) = 16
trigger1 = (AnimTime = 0) && (Var(10) != 1)
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x) * 1.4, const(velocity.jump.back.x) * 1.4))
y = const(velocity.jump.y) * 1.1

[State 40, 5]
type = VelSet
triggerall = Var(10) != 1
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = ifelse(Var(40) = 16, const(velocity.runjump.fwd.x) * 2.6, const(velocity.runjump.fwd.x))

[State 40, Super Jump Detect VarSet]
type = VarSet
trigger1 = Command = "superjump"
trigger2 = PrevStateNo = 201
trigger3 = PrevStateNo = 202
trigger4 = PrevStateNo = 402
trigger5 = PrevStateNo = 403
v = 10
value = 1

[State 40, Super Jump VarSet Neutral]
type = VarSet
trigger1 = (command != "holdfwd") && (command != "holdback")
v = 11
value = 0

[State 40, Super Jump VarSet Fwd]
type = VarSet
trigger1 = command = "holdfwd"
v = 11
value = 1

[State 40, Super Jump VarSet Back]
type = VarSet
trigger1 = command = "holdback"
v = 11
value = -1

[State 40, Super Jump VelSet]
type = VelSet
trigger1 = (AnimTime = 0) && (Var(10) = 1)
y = -12.5

[State 40, Super Jump Sound]
type = PlaySnd
trigger1 = (AnimTime = 0) && (Var(10) = 1)
value = 10,0

[State 40, Super Jump Up Sparks]
type = Explod
anim = 8035
ID = 8035
trigger1 = (Var(10) = 1) && (Var(11) = 0) && (AnimTime = 0)
postype = P1
pos = -2,-8
ownpal = 1
bindtime = -1
removeongethit = 1
sprpriority = 5

[State 40, Super Jump Forward Sparks]
type = Explod
anim = 8036
ID = 8035
trigger1 = (Var(10) = 1) && (Var(11) = 1) && (AnimTime = 0)
postype = P1
pos = 0,0
ownpal = 1
bindtime = -1
removeongethit = 1
sprpriority = 5

[State 40, Super Jump Back Sparks]
type = Explod
anim = 8037
ID = 8035
trigger1 = (Var(10) = 1) && (Var(11) = -1) && (AnimTime = 0)
postype = P1
pos = 0,0
ownpal = 1
bindtime = -1
removeongethit = 1
sprpriority = 5

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up (also Super Jump)

[Statedef 50]
type    = A
physics = A

[State 50, CtrlSet];Super Armor
type = CtrlSet
trigger1 = PrevStateNo = 3950
value = 1

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = (Time = 0) && (Var(10) != 1) && (PrevStateNo != 3950)
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, Double Jump ChangeAnim Neutral] ;during super jump
type = ChangeAnim
trigger1 = (Time = 0) && (Var(10) = 1) && (PrevStateNo = 45) && (Vel X = 0)
value = 41

[State 50, Double Jump ChangeAnim Fwd] ;during super jump
type = ChangeAnim
trigger1 = (Time = 0) && (Var(10) = 1) && (PrevStateNo = 45) && (Vel X > 0)
value = 42

[State 50, Double Jump ChangeAnim Back] ;during super jump
type = ChangeAnim
trigger1 = (Time = 0) && (Var(10) = 1) && (PrevStateNo = 45) && (Vel X < 0)
value = 43

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50, Super Jump VelAdd] ;falls slower during super jump
type = VelAdd
trigger1 = Var(10) = 1
y = -0.05

[State 50, Time Gem VelAdd] ;falls faster during Time Gem
type = VelAdd
trigger1 = (Var(40) = 16) && (Var(10) != 1)
y = 0.05

[State 50, Super Jump HoldFwd]
type = VelAdd
triggerall = Var(10) = 1
triggerall = Vel X <= 4
trigger1 = command = "holdfwd"
x = 0.25

[State 50, Super Jump HoldBack]
type = VelAdd
triggerall = Var(10) = 1
triggerall = Vel X >= -3
trigger1 = command = "holdback"
x = -0.1

[State 50, Super Jump VelSet Fwd]
type = VelSet
triggerall = Var(10) = 1
triggerall = PrevStateNo != 45
trigger1 = (Time = [0,2]) && (Anim = 9002)
x = 3.0

[State 50, Super Jump VelSet Back]
type = VelSet
triggerall = Var(10) = 1
triggerall = PrevStateNo != 45
trigger1 = (Time = [0,2]) && (Anim = 9003)
x = -1.5

[State 50, ChangeAnim Neutral]
type = ChangeAnim
triggerall = Var(10) = 1
triggerall = PrevStateNo != 45
trigger1 = (Time = 0) && (Var(11) = 0)
value = 9001

[State 50, ChangeAnim Fwd]
type = ChangeAnim
triggerall = Var(10) = 1
triggerall = PrevStateNo != 45
trigger1 = (Time = 0) && (Var(11) = 1)
value = 9002

[State 50, ChangeAnim Back]
type = ChangeAnim
triggerall = Var(10) = 1
triggerall = PrevStateNo != 45
trigger1 = (Time = 0) && (Var(11) = -1)
value = 9003

