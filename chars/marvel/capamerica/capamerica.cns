; AttackMulSet (Combos take less damage)
;---------------------------------------

[State -2, AttackMulSet 1]
type = AttackMulSet
triggerall = Var(40) != 12 ;not while Power Gem is active
trigger1 = Var(7) <= 1
trigger1 = StateNo != [1200,1221]
value = 1

[State -2, AttackMulSet 2]
type = AttackMulSet
triggerall = Var(40) != 12 ;not while Power Gem is active
trigger1 = Var(7) = 2
trigger1 = StateNo != [1200,1221]
value = .8

[State -2, AttackMulSet 3]
type = AttackMulSet
triggerall = Var(40) != 12 ;not while Power Gem is active
trigger1 = Var(7) = 3
trigger1 = StateNo != [1200,1221]
value = .6

[State -2, AttackMulSet 4]
type = AttackMulSet
triggerall = Var(40) != 12 ;not while Power Gem is active
trigger1 = Var(7) = 4
trigger1 = StateNo != [1200,1221]
value = .4

[State -2, AttackMulSet 5]
type = AttackMulSet
triggerall = Var(40) != 12 ;not while Power Gem is active
trigger1 = Var(7) >= 5
trigger1 = StateNo != [1200,1221]
value = .2

;---------------------------------------
; Kamek's Combo Ranking (altered to suit Captain America)
;---------------------------------------

[State -2, Set Up For Count]
type = VarSet
trigger1 = P2MoveType = H
trigger1 = Var(5) = 0
v = 5
value = 1

[State -2, Keep Track Of Hit Count]
type = VarSet
;triggerall = StateNo < 1000
trigger1 = HitCount > 0
trigger1 = Var(5) != 0
v = 6
value = HitCount

[State -2, Add To Total Hit Count]
type = VarSet
;triggerall = StateNo < 1000
triggerall = Var(5) != 0
trigger1 = HitCount = 0
trigger2 = P2MoveType != H
v = 7
value = Var(7) + Var(6)

[State -2, Projectile Hits]
type = VarSet
;triggerall = StateNo < 1000
triggerall = Var(5) != 0
trigger1 = ProjHit = 1
v = 7
value = Var(7) + 1

[State -2, Reset Current Hit Count]
type = VarSet
trigger1 = HitCount = 0
trigger1 = Var(5) != 0
v = 6
value = 0

[State -2, Combo Is Finished]
type = VarSet
trigger1 = EnemyNear, MoveType != H
trigger1 = Var(5) != 0
v = 6
value = 0

[State -2, Reset]
type = VarSet
triggerall = Var(5) != 0
trigger1 = EnemyNear, MoveType != H
v = 5
value = 0

[State -2, Reset]
type = VarSet
trigger1 = Var(5) = 0
trigger1 = Var(7) > 0
v = 7
value = 0

