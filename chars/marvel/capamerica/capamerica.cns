[State -2, Shield VarSet 2]
type = VarSet
triggerall = (helper(1000), StateNo != [1000000,1000100]) && (Var(59) != 1)
triggerall = (helper(1000), StateNo != 1100500) && (helper(1000), StateNo != 1101500) && (helper(1000), StateNo != 1102500)
triggerall = (helper(1000), StateNo != 1100600) && (helper(1000), StateNo != 1101600) && (helper(1000), StateNo != 1102600)
triggerall = (helper(1000), StateNo != 1110500) && (helper(1000), StateNo != 1111500) && (helper(1000), StateNo != 1112500)
triggerall = (helper(1000), StateNo != 1110600) && (helper(1000), StateNo != 1111600) && (helper(1000), StateNo != 1112600)
triggerall = (StateNo != 1201) && (StateNo != 1211) && (StateNo != 1221)
trigger1 = (StateType != C) && ((helper(1000), Pos X) - (Pos X) = [-40,40]) && ((helper(1000), Pos Y) - (Pos Y)= [-100,0])
trigger2 = (StateType = C) && ((helper(1000), Pos X) - (Pos X) = [-40,40]) && ((helper(1000), Pos Y) - (Pos Y)= [-60,0])
trigger3 = (RoundState = 0) || (RoundState = 1)
v = 59
value = 1

[State -2, Stand B Var Reset]
type = VarSet
trigger1 = StateNo != 211
v = 2
value = 0

[State -2, Stand Z Explod A] ;opponent hits ground
type = Explod
