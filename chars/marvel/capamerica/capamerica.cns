v = 40
value = 1

[State 195, Choose Power Gem]
type = VarSet
trigger1 = (command = "tap_y") && (Var(40) = [1,6])
v = 40
value = 2

[State 195, Choose Reality Gem]
type = VarSet
trigger1 = (command = "tap_z") && (Var(40) = [1,6])
v = 40
value = 3

[State 195, Choose Soul Gem]
type = VarSet
trigger1 = (command = "tap_a") && (Var(40) = [1,6])
v = 40
value = 4

[State 195, Choose Space Gem]
type = VarSet
trigger1 = (command = "tap_b") && (Var(40) = [1,6])
v = 40
value = 5

[State 195, Choose Time Gem]
type = VarSet
trigger1 = (command = "tap_c") && (Var(40) = [1,6])
v = 40
value = 6

[State 195, Gem Display];P1 Side
