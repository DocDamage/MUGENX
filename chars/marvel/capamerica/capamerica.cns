;---------------------------------------------------------------------------
; Lose by Time Over

[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider

[Statedef 180]
type = S

[State 180, VarRandom]
type = VarRandom
trigger1 = Time = 0
v = 19
range = 0,29

[State 180, Win Pose 1]
type = ChangeState
trigger1 = Command = "holdx"
trigger2 = (Var(19) = [0,9]) && (Command != "holdx") && (Command != "holdy") && (Command != "holdz")
value = 181

[State 180, Win Pose 2]
type = ChangeState
trigger1 = Command = "holdy"
trigger2 = (Var(19) = [10,19]) && (Command != "holdx") && (Command != "holdy") && (Command != "holdz")
value = 182

[State 180, Win Pose 3]
type = ChangeState
trigger1 = Command = "holdz"
trigger2 = (Var(19) = [20,29]) && (Command != "holdx") && (Command != "holdy") && (Command != "holdz")
value = 183

