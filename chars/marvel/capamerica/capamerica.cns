;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, ChangeState] ;Change to grabbing shield high
type = ChangeState
trigger1 = (Var(31) = 1) && (Var(33) = 1)
value = 990
ctrl = 1

[State 0, ChangeState] ;Change to grabbing shield low
type = ChangeState
trigger1 = (Var(31) = 1) && (Var(33) = 2)
value = 995
ctrl = 1

[State 0, CtrlSet];Super Armor
type = CtrlSet
trigger1 = PrevStateNo = 3950
value = 1

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

