trigger2 = (command = "tap_a") || (command = "tap_b") || (command = "tap_c")
id = 8070

[State 195, Gem Display];P2 Side
type = RemoveExplod
triggerall = TeamSide = 2
triggerall = Var(40) = [1,6]
trigger1 = (command = "tap_x") || (command = "tap_y") || (command = "tap_z")
trigger2 = (command = "tap_a") || (command = "tap_b") || (command = "tap_c")
anim = (8071)
id = 8070

[State 195, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

