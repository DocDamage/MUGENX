;===========================================================================
;---------------------------------------------------------------------------
;Captain America's Shield States
;---------------------------------------------------------------------------
;===========================================================================

;---------------------------------------------------------------------------
; Idle
[Statedef 1000000]
type    = S
movetype = I
physics = N
sprpriority = 2
anim = 1000000
ctrl = 0

[State 1000000, BindToParent]
type = BindToParent
trigger1 = 1
facing = 1
pos = 0,0
time = ifelse (parent, Var(59) = 1, -1, 0)

[State 1000000, SprPriority 1]
type = SprPriority
triggerall = parent, Var(59) = 1
trigger1 = parent, Anim = 0
trigger2 = parent, Anim = 5
trigger3 = parent, Anim = 6
trigger4 = parent, Anim = 10
trigger5 = parent, Anim = 11
trigger6 = parent, Anim = 12
trigger7 = parent, StateNo = 0
trigger8 = parent, StateNo = 11
trigger9 = parent, StateNo = 20
value = 1

[State 1000000, SprPriority 2]
type = SprPriority
triggerall = parent, Var(59) = 1
trigger1 = parent, Anim = 40
trigger2 = parent, Anim = 47
trigger3 = parent, Anim = 48
trigger4 = parent, StateNo = 50
trigger5 = parent, Anim = 100
trigger6 = parent, Anim = 105
value = 2

[State 1000000, SprPriority 3]
type = SprPriority
triggerall = parent, Var(59) = 1
trigger1 = parent, MoveType = A
value = 3

[State 1000000, PlaySnd]
type = PlaySnd
trigger1 = (parent, Var(31) = 1) && (Time = 1) && (RoundState = [2,3])
value = 20,3

[State 1000000, ChangeState]
type = ChangeState
trigger1 = parent, Var(59) = 0
trigger1 = parent, command = "x" && parent, command = "a"
value = 2000000

;---------------------------------------------------------------------------
;Standing

[State 1000000, SprPriority]
type = SprPriority
triggerall = parent, Var(59) = 1
trigger1 = parent, Anim = 0
value = 1

[State 1000000, Stand 1]
type = ChangeAnim
triggerall = parent, Var(59) = 1
trigger1 = (parent, Anim = 0)
value = 1000000
elem = parent, animelemno(0)

