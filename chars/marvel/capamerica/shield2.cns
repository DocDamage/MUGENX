;---------------------------------------------------------------------------
;Win 1 (Raises Shield)

[State 1018100, SprPriority 1]
type = SprPriority
trigger1 = (parent, Anim = 181);Win 1
trigger2 = (parent, Anim = 182);Win 2
trigger3 = (parent, Anim = 183);Win 3
value = 2

[State 1018100, Win 1]
type = ChangeAnim
triggerall = parent, Var(59) = 1
trigger1 = (parent, Anim = 181) && (parent, AnimElemTime(1) >= 0) && (parent, AnimElemTime(2) < 0)
value = 1018100

[State 1018100, Win 2]
type = ChangeAnim
triggerall = parent, Var(59) = 1
trigger1 = (parent, Anim = 181) && (parent, AnimElemTime(2) >= 0) && (parent, AnimElemTime(3) < 0)
value = 1018101

[State 1018100, Win 3]
type = ChangeAnim
triggerall = parent, Var(59) = 1
trigger1 = (parent, Anim = 181) && (parent, AnimElemTime(3) >= 0) && (Anim != 1018102)
value = 1018102

