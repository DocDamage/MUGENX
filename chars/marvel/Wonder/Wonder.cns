;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

; Super Armor
[State -2]
type = VarSet
trigger1 = Life > 1
trigger1 = MoveType != H
trigger1 = StateNo != 9000
var(46) = StateNo
ignorehitpause = 1

[State -2]
type = VarSet
trigger1 = Life > 1
trigger1 = StateNo = [120,159]
trigger1 = StateNo != 9000
var(46) = StateNo
ignorehitpause = 1

[State -2, copyright]
type = DisplayToClipboard
trigger1 = 1
text="Wonder Woman by Erradicator and Loganir"

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 1310 ; Pouso do Shoryuken ;)
trigger3 = stateno = 106; dash land
value = 40, 0

; Marble Wonder Woman makes it SHAKE!!
[state -3, Landing shake]
type = envshake
triggerall = Time = 1
trigger1 = stateno = 52 && palno = 7
trigger2 = stateno = 1310 && palno = 7
trigger3 = stateno = 106 && palno = 7
time = 8
ampl = -6

; She Hulk makes it SHAKE!!
[state -3, Landing shake]
type = envshake
triggerall = Time = 1
trigger1 = stateno = 52 && palno = 8
trigger2 = stateno = 1310 && palno = 8
trigger3 = stateno = 106 && palno = 8
time = 8
ampl = -6

[State -3, PULO SOM]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 40 ;Jump START
trigger2 = stateno = 106 ;AIR JUMP ??? :P
value = 100, 3

[State -3, BRACELETES GUARD SOM]
type = PlaySnd
triggerall = Time = 0
triggerall = Alive
trigger1 = stateno = 150 || stateno = 152 || stateno = 154 
value = 7, 0
channel = 1

[State -3, APANHANDO]
type = PlaySnd
triggerall = Random < 850
triggerall = Time = 1
triggerall = Alive 
trigger1 = stateno = 5000 || stateno = 5010 || stateno = 5020 || stateno = 5070 || stateno = 5080 || stateno = 5100
value = 51, ifelse (stateno = 5100 || GetHitVar(animtype) = 2, 3, ifelse (GetHitVar(animtype) = 0, 1, 2))
channel = 0

[State -3, GET UP]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 5120 ;GETUP FROM LIE DOWN 
trigger1 = random > 500
value = 60, 4

[State -3, ground landing effect]
type = Explod 
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
trigger3 = stateno = 1310 ; Divine assault landing ;)
anim = F60
pos = 0, 0

;This controller puts a target sign on P2 every time you do a super jump.
[State -3, target sign]
type = Explod
triggerall = NumExplod(4500) = 0
trigger1 = P2Dist y > 200
anim = 4500
id = 4500
pos = 0,-30
postype = p2
sprpriority = 4
ignorehitpause = 1
ontop = 1
bindtime = -1
persistent = 1
facing = -1

[State -3,remove]
type = RemoveExplod
trigger1 = P2Dist y < 200
ID = 4500

; Super Armor
[State -3]
type = HitOverride
trigger1 = palno = 8 || palno = 7
trigger1 = Random <= 600
trigger1 = MoveType != H
trigger1 = Anim != 5300
trigger1 = StateNo != [120,159]
trigger1 = PrevStateNo != 9000
time = 1
slot = 7
attr = SCA, NA, SA, NP, SP
stateno = 9000

[State -3, 0]
type = AttackMulSet
trigger1 = palno = 7
value = 1.09

[State -3, 1]
type = AttackMulSet
trigger1 = palno = 8
value = 1.09

[State -3, 2]
type = AttackMulSet
trigger1 = palno = 9
value = .86

[State -3, 3]
type = DefenceMulSet
trigger1 = palno = 9
value = 1.15

; no life bars for you
[state -3, 4]
type = assertspecial
trigger1 = roundstate < 2
trigger2 = stateno = [180,185]
trigger3 = winko = 1 
trigger4 = (var(25) = 1) && (numexplod(8420) != 0) && (roundstate = 3)
flag = nobardisplay
ignorehitpause = 1
