
; Player information
[Info]
name = "Thanos"        ;Name of character
displayname = "Thanos" ;Name of character to display
versiondate = 04,14,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "CPoC and Splode"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
cmd     = thanos.cmd   ;Command set
cns     = thanos.cns   ;Constants
st      = thanos.cns   ;States
stcommon = common1.cns ;Common states
sprite  = thanos.sff   ;Sprite
anim    = thanos.air   ;Animation
sound   = thanos.snd   ;Sound
pal1    = thanos.act  ;Palettes (can have up to 12)
pal2    = thanos2.act
pal3    = thanos3.act
pal4    = thanos4.act
pal5    = thanos5.act
pal6    = thanos6.act

; Arcade mode
[Arcade]
