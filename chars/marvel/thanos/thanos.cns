triggerall = var(5) = 4
trigger1 = NumHelper(500) = 0
ID = 87

[State -2, VarSet]
type = VarSet
triggerall = var(5) > 0
trigger1 = var(5) = 1
trigger1 = StateNo != 194
trigger2 = var(5) = 2
trigger2 = StateNo != 2000
trigger2 = StateNo != 2010
trigger2 = StateNo != 2015
trigger2 = StateNo != 2020
trigger3 = var(5) = 3
trigger3 = StateNo != 2070
trigger4 = NumHelper(500) = 0
trigger4 = var(5) = 4
v = 5
value = 0


; Get target ID if Paralyze Shot hits
[State -2, Get Target ID]
type = VarSet
trigger1 = ProjHit111 = 1
v = 6
value = target, ID

[State -2, Spawn Paralyze Shot FX]
type = Helper
trigger1 = ProjHit111 = 1
trigger1 = NumHelper(27) = 0
name = "Paralyze FX Spawner"
ID = 27
postype = p2
pos = 0, 0
stateno = 1050
ownpal = 1

; Combo Ranking (by Kamek, taken from BB Hood)
[State -2, Set Up For Count]
type = VarSet
trigger1 = p2movetype = H
trigger1 = !Var(7)
v = 7
value = 1

[State -2, Keep Track Of Hit Count]
type = VarSet
trigger1 = UniqHitCount > 0
trigger1 = Var(7)
v = 8
value = UniqHitCount

[State -2, Add To Total Hit Count]
type = VarSet
triggerall = Var(7)
trigger1 = UniqHitCount < Var(8)
trigger2 = p2movetype != H
v = 9
value = Var(9) + Var(8)

[State -2, Add Helper Hits To Total Hit Count]
type = VarSet
triggerall = Var(7)
trigger1 = Var(10) != 0
trigger2 = p2movetype != H
v = 9
value = Var(9) + Var(10)

[State -2, Keep Track of Helper Hit Count]
type = VarSet
trigger1 = Var(10) != 0
trigger1 = Var(7)
v = 10
value = 0

[State -2, Projectile Hits]
type = VarSet
triggerall = Var(7)
trigger1 = ProjHit = 1
v = 9
value = Var(9) + 1

[State -2, Reset Current Hit Count]
type = VarSet
trigger1 = UniqHitCount < Var(8)
trigger1 = Var(7)
v = 8
value = UniqHitCount

[State -2, Combo Is Finished]
type = VarSet
triggerall = Var(7)
trigger1 = p2movetype != H
trigger2 = (enemy, stateno = 5150) && (enemy, alive = 0)
v = 8
value = 0

; Combo Damage Dampening
[State -2, Set Damage]
type = AttackMulSet
trigger1 = 1
value = fvar(0)

[State -2, Set]
type = VarSet
trigger1 = var(9) = 0
fv = 0
value = 1

[State -2, 1st decrease]
type = VarSet
trigger1 = var(9) > 3
trigger1 = var(9) <= 5
fv = 0
value = .50

[State -2, 2nd Decrease]
type = VarSet
trigger1 = var(9) > 5
trigger1 = var(9) <= 8
fv = 0
value = .40

[State -2, 3rd Decrease]
type = VarSet
trigger1 = var(9) > 8
trigger1 = var(9) <= 12
fv = 0
value = .30

[State -2, Reset]
type = VarSet
triggerall = Var(7)
trigger1 = p2movetype != H
trigger2 = (enemy, stateno = 5150) && (enemy, alive = 0)
v = 7
value = 0

[State -2, Reset]
type = Null ;VarSet
trigger1 = p2movetype != H
trigger2 = (enemy, stateno = 5150) && (enemy, alive = 0)
v = 14
value = 0

[State -2, Reset]
type = VarSet
trigger1 = !Var(7)
trigger1 = Var(9) > 0
v = 9
value = 0

