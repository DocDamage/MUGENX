trigger1 = var(5) = 1
channel = 2

[State -2, Stop Souldrain sound]
type = StopSnd
triggerall = var(5) = 2
trigger1 = StateNo != 2000
trigger1 = StateNo != 2010
trigger1 = StateNo != 2015
trigger1 = StateNo != 2020
channel = 2

[State -2, Stop Space Sound]
