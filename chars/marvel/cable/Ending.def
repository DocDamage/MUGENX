[SceneDef]
spr = intro_ending.sff
startscene = 0         ;Starting scene number (for debugging)

;------------------------------------
[Scene 0]
; Fade
fadein.time = 6       ;Time to take for fading in
fadein.col = 0,0,0     ;Use 255,255,255 for white-fade
; Overlay Anims (from 0 to 9)
layerall.pos = 0,0   ;Default position for all layers
layer0.anim =  0       ;Anim action number
layer0.offset = 0,0   ;Position offset
layer0.starttime = 0   ;Time to start display

layer1.anim =  1       ;Anim action number
layer1.offset = 0,16    ;Position offset
layer1.starttime = 400   ;Time to start display

layer2.anim =  2       ;Anim action number
layer2.offset = 0,16    ;Position offset
layer2.starttime = 800   ;Time to start display

layer3.anim =  3       ;Anim action number
layer3.offset = 0,16    ;Position offset
layer3.starttime = 1200   ;Time to start display

;layer4.anim =  4       ;Anim action number
;layer4.offset = 0,0    ;Position offset
;layer4.starttime = 1900   ;Time to start display

; Music
bgm = Xmen01.mid        ;Name of music file to play
bgm.loop = 1
; Total time
end.time = 1650;1800;1890


[Scene 1 ]
fadein.time = 1
bg.name = BG1        ;Name of BG
layerall.pos = 0,0   ;Default position for all layers
layer0.anim =  6       ;Anim action number
layer0.offset = 0,0   ;Position offset
layer0.starttime = 0   ;Time to start display
layer5.anim =  4
layer5.offset = 0,0
layer5.starttime = 50;1900
end.time = 1950
fadeout.time = 5
fadeout.col = 255,255,255
; Screen color
clearcolor = 0,0,255;0,0,0

[BG1def] ;For scene 11

[BG1]; Cast
