[SceneDef]
spr = ending2.sff
startscene = 0         ;Starting scene number (for debugging)

;------------------------------------
[Scene 0]
; Fade
fadein.time = 6       ;Time to take for fading in
fadein.col = 255,255,255     ;Use 255,255,255 for white-fade

; Screen color
clearcolor = 0,0,0

bg.name = BG1        ;Name of BG
; Overlay Anims (from 0 to 9)
layerall.pos = 0,0   ;Default position for all layers
layer0.anim =  0       ;Anim action number
layer0.offset = 0,0    ;Position offset
layer0.starttime = 180   ;Time to start display

layer1.anim =  1       ;Anim action number
layer1.offset = 320,0    ;Position offset
layer1.starttime = 282   ;Time to start display

layer2.anim =  2       ;Anim action number
layer2.offset = 0,240    ;Position offset
layer2.starttime = 384   ;Time to start display

layer3.anim =  3       ;Anim action number
layer3.offset = 320,240    ;Position offset
layer3.starttime = 486   ;Time to start display

layer4.anim =  4       ;Anim action number
layer4.offset = 145,-30    ;Position offset
layer4.starttime = 1800;1404;1500   ;Time to start display


fadeout.time = 6
fadeout.col = 255,255,255

; Music
bgm = mvsfselect.mid        ;Name of music file to play
bgm.loop = 1
; Total time
end.time = 2000;1920


