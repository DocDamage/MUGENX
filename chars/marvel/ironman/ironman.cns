; Ironman's CNS file

; Secreto's variables
; Var(1) - Fast Screen Effect for Air Combos
; Var(2) - Multi-Hit Defense Variable
; Var(3) - Standing Light Punch2 & Crounching Fierce Kick
; Var(4) - Unibeam number of hits
; Var(5) - Air Dash control set
; Var(6) - Numbers of Air Dash
; Var(7) - Fly mode
; Var(8) - HitCount for Repulsor Blast/Proton Cannon
; Var(9) - Proton Cannon Damage
; Var(12) - 
; Var(15)&Var(16)&Var(17)&Var(19) - Kamek's Combo Counter
; Special Partner's Variables
; Var(20) - Random selection
; Var(21) - How many are left

[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 20
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 100
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 50
ground.front = 46
air.back = 42
air.front = 39
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = 16, -86
mid.pos = 0, -54
shadowoffset = 4
draw.offset = 0,0

[Velocity]
walk.fwd  = 3
walk.back = -2.5
run.fwd  = 6.3
run.back = -6
jump.neu = 0,-9.6
jump.back = -2.6
jump.fwd = 2.8
runjump.back = -3.7,-8.1
runjump.fwd = 4,-8.1
airjump.neu = 0,-8.1
airjump.back = -2.55
airjump.fwd = 2.5

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .44
stand.friction = .85
crouch.friction = .82

