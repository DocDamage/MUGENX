;---------------------------------------------------------------------------
; Code done by Mystik Blaze in Captain America (Thanks man!)
; HITG_SHAKE (Vs-Style Hitbounce)
[Statedef 244]
type    = S
movetype= H
physics = N
velset = 0,0

[State 244, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
value = 5012

[State 244, NotHitBy]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

[State 244, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 244, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 && GetHitVar(fall)
trigger2 = Pos Y != 0
type = a

[State 244, 7]
type = ChangeState
trigger1 = HitShakeOver
value = 245

[State 244, FFB Light]
type = ForceFeedback
trigger1 = anim = 5000
trigger2 = anim = 5010
persistent = 0
time = 6
waveform = square

[State 244, FFB Medium]
type = ForceFeedback
trigger1 = anim = 5001
trigger2 = anim = 5011
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 244, FFB Hard]
type = ForceFeedback
trigger1 = anim = 5012
trigger2 = anim = 5002
trigger3 = anim = 5030
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; HITA_UP (initial going up) (Vs-Style Hitbounce)
[Statedef 245]
type    = A
movetype= H
physics = N
anim = 5030
ctrl = 0

[State 245, NotHitBy]
type = NotHitBy
trigger1 = Time = 0
value = SCA
time = 10

[State 245, 1]
type = VelAdd;Gravity
trigger1 = 1
y = GetHitVar(yaccel)

[State 245, 2]
type = HitVelSet
trigger1 = Time = 0
x = 1
y = 1

[State 245, 5]
type = ChangeState
trigger1 = (AnimTime = 0) || (Time = 10)
value = 246 ;HITA_UP (transition)

;---------------------------------------------------------------------------
; HITA_UP_T (transition) (Vs-Style Hitbounce)
[Statedef 246]
type    = A
movetype= H
physics = N

[State 246, 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = SelfAnimExist(5035)
trigger1 = Anim != [5051,5059] ;Not if in hit up anim
trigger1 = Anim != 5090 ;Not if hit off ground anim
value = 5035

[State 246, 2]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 246, 4]
type = ChangeState
trigger1 = HitOver  ;Hit is over
trigger2 = AnimTime = 0 ;Anim is over
trigger3 = Time = 0     ;No transition anim
trigger3 = Anim != 5035 ;.
value = 247 ;HITA_FALL

;---------------------------------------------------------------------------
; HITA_FALL (knocked up, falling) (Vs-Style Hitbounce)
[Statedef 247]
type    = A
movetype= H
physics = N

[State 247, 1] ;Change anim when done with transition
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 5035
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 5035
trigger2 = (Anim != [5051, 5059]) && (Anim != [5061, 5069])
trigger2 = Anim != 5090 ;Not if hit off ground anim
value = 5050

[State 247, 2] ;Coming down anim
type = ChangeAnim
trigger1 = anim = [5050,5059]
trigger1 = Vel Y >= ifelse(anim = 5050, 1, -2)
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State 247, 3] ;Gravity
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 247, 6]
type = ChangeState
triggerall = Alive = 1
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, 25)
value = 248 ;HIT_BOUNCE

[State 247, SelfState]
type = SelfState
triggerall = Alive = 0
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [5051,5059]) || (anim = [5061,5069]), 0, 25)
value = 5101 ;HIT_BOUNCE

;---------------------------------------------------------------------------
; HIT_BOUNCE (hit ground) (Vs-Style Hitbounce)
[Statedef 248]
type    = L
movetype= H
physics = N

[State 248, 1]
type = VelSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) = 0
trigger1 = vel x > 1
x = 1

[State 248, EnvShake]
type = EnvShake
trigger1 = Time = 0
time = 20
freq = 60
ampl = -5

[State 248, Var] ;Save fall velocity
type = VarSet
trigger1 = Time = 0
;trigger1 = GetHitVar(fall.yvel) = 0
sysvar(1) = floor(vel y)

[State 248, 2] ;Hit ground anim (normal)
type = ChangeAnim
triggerall = time = 0
trigger1 = (anim != [5051,5059]) && (anim != [5061,5069])
trigger2 = !SelfAnimExist(5100 + (anim % 10))
value = 5100

[State 248, 3] ;Hit ground anim (for hit up)
type = ChangeAnim
trigger1 = time = 0
trigger1 = (anim = [5051,5059]) || (anim = [5061,5069])
trigger1 = SelfAnimExist(5100 + (anim % 10))
value = 5100 + (anim % 10)

[State 248, 4]
type = PosSet
trigger1 = Time = 0
y = 0

[State 248, 5]
type = VelSet
trigger1 = Time = 0
y = 0

[State 248, 6] ;Reduce speed
type = VelMul
trigger1 = Time = 0
x = 0.75

[State 248, 10]
type = PlaySnd
trigger1 = Time = 1
;value = F7, 0 ;Hit ground
value = F7, (sysvar(1) > 5) + (sysvar(1) > 14)

[State 248, 11]
type = PosFreeze
trigger1 = 1

[State 248, 12]
type = ChangeState
trigger1 = AnimTime = 0
value = 249

[State 248, 13]
type = ForceFeedback
trigger1 = Time = 0
waveform = sinesquare
ampl = 128,-3,-.2,.005
time = 20

