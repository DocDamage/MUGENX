; Definition file for Iron Man by Gou-San
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Iron Man"        ;Name of character
displayname = "Iron Man" ;Name of character to display
versiondate = 10,23,2002    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "Gou-San"         ;Character author name
pal.defaults = 1,2,3,4,5,6      ;Default palettes in order of preference

; Files for the player
[Files]
cmd      = ironman.cmd   ;Command set
cns      = ironman.cns   ;Constants
st       = ironman.cns   ;States
stcommon = common1.cns ;Common states
sprite   = ironman.sff   ;Sprite
anim     = ironman.air   ;Animation
sound    = ironman.snd   ;Sound
pal1     = ironman02.act ;2nd color MSH
pal2     = ironman04.act ;Brasil
pal3     = ironman06.act ;Evil
pal4     = ironman01.act ;Normal
pal5     = ironman03.act ;Reverse
pal6     = ironman05.act ;Saikyo+Daphne
pal7     = ironman08.act ;2nd color MSH
pal8     = ironman10.act ;Brasil
pal9     = ironman12.act ;Evil
pal10     = ironman07.act ;Normal
pal11     = ironman09.act ;Reverse
pal12     = ironman11.act ;Saikyo+Daphne

;[Arcade]
;ending.storyboard = ending.def

