;|=================|
;|Omega Red's poses|
;|=================|

;Lose (Time over)
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = nothitby
trigger1 = 1
value = SCA
time = 1

;DRAWGAME (Time over)
[Statedef 175]
type = S
ctrl = 0
velset = 0,0

[State 175, 1];If no anim, use go to lose state.
type = changestate
trigger1 = time = 0
trigger1 = !selfanimexist(175)
value = 170

[State 175, 2]
type = changeanim
trigger1 = time = 0
value = 175

[State 175, 3]
type = nothitby
trigger1 = 1
value = SCA
time = 1

;Win
[Statedef 180]
type = S

[State 180, 1]
type = varrandom
trigger1 = time = 0
v = 20
range = 0, 3

[State 180, 2]
type = changeanim
trigger1 = time = 0
value = 180 + var(20)

[State 180, 3]
type = changestate
trigger1 = time = 0
value = 181

;Win1
[Statedef 181]
type = S
ctrl = 0
velset = 0,0
sprpriority = -3

[State 181, 1]
type = nothitby
trigger1 = 1
value = SCA
time = 1

[State 181, 2]
type = playsnd
trigger1 = time = 0
value = 195,0

[State 181, 3]
type = playsnd
trigger1 = anim = 183 && animelem = 5
value = 1,3

;Preintro
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 190, 1]
type = changeanim
trigger1 = selfanimexist(190)
value = 190

[State 190, 2]
type = changestate
trigger1 = time = 0
value = 191

;Intro
[Statedef 191]
type = S
ctrl = 0

[State 191, 1]
type = assertspecial
trigger1 = 1
flag = intro

[State 191, 2]
type = playsnd
trigger1 = time = 0
value = 190, 0

[State 191, 3]
type = playsnd
trigger1 = animelem = 101
value = 190, 1

[State 191, 4]
type = changestate
trigger1 = animtime = 0
value = 0