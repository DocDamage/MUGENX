x = ifelse(var(13)=0,-7.5,ifelse(var(13)=1,-5.5,0))
y = ifelse(var(13)=0,0,ifelse(var(13)=1,4,6))

[State 1002, ChangeAnim]
type = changeanim
trigger1 = var(13) = 0 && animtime = 0
value = ifelse(anim=1001||anim=1003,1002,1001)

[State 1002, ChangeAnim2]
type = changeanim
trigger1 = var(13) = 1 && animtime = 0
value = ifelse(anim=1020||anim=1022,1021,1020)

[State 1002, ChangeAnim3]
type = changeanim
trigger1 = var(13) = 2 && animtime = 0
value = ifelse(anim=1030||anim=1032,1031,1030)

[State 1002, ChangeState]
type = changestate
trigger1 = var(11) <= 0
value = 1003

;Omega Strike (Recoil End)
[Statedef 1003]
