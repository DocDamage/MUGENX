[State 1004, VarSet]
type = varset
trigger1 = time = 0
var(11) = 0

[State 1004, VarSet2]
type = varset
trigger1 = time = 0
var(12) = 0

[State 1004, ChangeState]
type = changestate
trigger1 = animtime = 0
value = ifelse(statetype=S,0,803)
ctrl = 1

;Omega Strike (Hand)
[Statedef 1005]
anim = ifelse(parent,var(13)=0,1004,ifelse(parent,var(13)=1,1023,1033))
