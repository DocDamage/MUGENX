trigger1 = parent, anim = 1001 || parent, anim = 1003
trigger2 = parent, anim = 1020 || parent, anim = 1022
trigger3 = parent, anim = 1030 || parent, anim = 1032
value = anim - 1

[State 1005, ChangeAnim2]
