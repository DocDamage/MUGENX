;-| Omega Strike |---------------------------------------------------------------------------------------------------

;Omega Strike (Begin)
[Statedef 1000]
type = S
movetype = A
physics = S
anim = 1000
velset = 0,0
ctrl = 0
poweradd = 100

[State 1000, VarSet]
type = varset
trigger1 = time = 0
var(12) = 1

[State 1000, ChangeState]
type = changestate
trigger1 = animtime = 0
value = 1001

;Omega Strike (Attacking)
[Statedef 1001]
movetype = A
anim = ifelse(var(13)=0,1001,ifelse(var(13)=1,1020,1030))
velset = ifelse(var(13)=0,7.5,ifelse(var(13)=1,5.5,0)),ifelse(var(13)=0,0,ifelse(var(13)=1,-4,-6))
juggle = 5
sprpriority = 3

[State 1001, Statetypeset]
type = statetypeset
trigger1 = var(13) = 0 && time = 0
statetype = S
physics = S

[State 1001, Statetypeset]
type = statetypeset
trigger1 = var(13) != 0 && time = 0
statetype = A
physics = A

[State 1001, PlaySnd]
type = playsnd
trigger1 = time = 0
value = 1,1

[State 1001, SprPriority]
type = sprpriority
trigger1 = 1
value = 3
ignorehitpause = 1

[State 1001, ScreenBound]
type = screenbound
trigger1 = 1
value = 0
movecamera = 1,1
ignorehitpause = 1

[State 1001, PlayerPush]
type = playerpush
trigger1 = 1
value = 0
ignorehitpause = 1

[State 1001, Omega Strike Length]
type = varadd
trigger1 = 1
var(11) = 1

[State 1001, Hand]
type = helper
trigger1 = time = 0
helpertype = player
name = "hand"
ID = 2
pos = 0
postype = p1
facing = 1
stateno = 1005
keyctrl = 0
ownpal = 0
