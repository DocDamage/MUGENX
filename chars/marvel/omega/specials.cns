name = "ground tentacle 2"
ID = 4
pos = 0
postype = p1
facing = 1
stateno = 1006
keyctrl = 0
ownpal = 0
supermovetime = 0
pausemovetime = 0

[State 1001, PosFreeze]
type = posfreeze
trigger1 = var(13) != 2 && frontedgebodydist <= -15
value = 1

[State 1001, VelSet]
type = velset
trigger1 = 1
x = ifelse(var(13)=0,ifelse(frontedgebodydist>=-109,7.5,0),ifelse(var(13)=1,ifelse(frontedgebodydist>=-109,5.5,0),0))
y = ifelse(var(13)=0,0,ifelse(var(13)=1,-4,-6))

[State 1001, PosAdd]
type = posadd
trigger1 = time = 0
x = ifelse(var(13)=0,135,ifelse(var(13)=1,122,19))
y = ifelse(var(13)=0,0,ifelse(var(13)=1,-18,-27))

[State 1001, ChangeAnim]
type = changeanim
trigger1 = var(13) = 0 && animtime = 0
value = ifelse(time=30,1003,ifelse(anim=1001,1002,1001))

[State 1001, ChangeAnim2]
type = changeanim
trigger1 = var(13) = 1 && animtime = 0
value = ifelse(time=30,1022,ifelse(anim=1020,1021,1020))

[State 1001, ChangeAnim3]
type = changeanim
trigger1 = var(13) = 2 && animtime = 0
value = ifelse(time=30,1032,ifelse(anim=1030,1031,1030))

[State 1001, Attack]
type = hitdef
trigger1 = movecontact = 0
attr = S, SA
hitflag = MAF
guardflag = MA
animtype = up
air.animtype = up
fall.animtype = up
priority = 4
damage = ifelse(var(13)=0,210,ifelse(var(13)=1,230,260)),10
pausetime = 11,11
guard.pausetime = 11,11
sparkno = S2020
guard.sparkno = S2010
sparkxy = -10,-10
hitsound = S5,2
guardsound = S6,0
ground.type = low
air.type = low
ground.slidetime = 23
guard.slidetime = 23
ground.hittime = 24
guard.hittime = 24
air.hittime = 24
ground.velocity = 0, -10
guard.velocity = -3
air.velocity = 0, -10
airguard.velocity = -3, -3
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
down.cornerpush.veloff = 0
guard.cornerpush.veloff = 0
airguard.cornerpush.veloff = 0
fall = 0
fall.recover = 1
fall.recover.time = 28
air.fall = 0
hitonce = 0
numhits = 1
getpower = 10
givepower = 10

[State 1001, Recoil]
type = changestate
triggerall = time != 0
triggerall = (command = "holdback")
trigger1 = (command = "a")
trigger2 = (command = "b")
trigger3 = (command = "c")
value = 1002

[State 1001, End VelSet]
type = velset
trigger1 = (command = "holddown") && (command = "a") && time != 0
trigger2 = (command = "holddown") && (command = "b") && time != 0
trigger3 = (command = "holddown") && (command = "c") && time != 0
x = 0

[State 1001, End]
type = changestate
trigger1 = time >= 40
trigger2 = frontedgebodydist < -15 && time != 0
trigger3 = (command = "holddown") && (command = "a") && time != 0
trigger4 = (command = "holddown") && (command = "b") && time != 0
trigger5 = (command = "holddown") && (command = "c") && time != 0
value = 1004

;Omega Strike (Recoil)
[Statedef 1002]
movetype = I
velset = ifelse(var(13)=0,-7.5,ifelse(var(13)=1,-5.5,0)),ifelse(var(13)=0,0,ifelse(var(13)=1,4,6))
