;Super Jump
[Statedef 41]
type = A
physics = S
ctrl = 0
anim = 40
velset = 0,0

[State 41, 1]
type = playsnd
trigger1 = animtime = 0
value = 40,0

[State 41, 2]
type = velset
trigger1 = animtime = 0
x = 0
y = -11

[State 41, 3]
type = changestate
trigger1 = animtime = 0
value = 42
ctrl = 1

;Super Jump Up
[Statedef 42]
type    = A
physics = A

[State 42, 1]
type = varset
trigger1 = time = 0
sysvar(1) = 0

[State 42, 2]
type = veladd
trigger1 = vel x < 3.25
trigger1 = (command = "holdfwd")
trigger1 = (command != "holdback")
x = .45

[State 42, 3]
type = veladd
trigger1 = vel x > -3.25
trigger1 = (command != "holdfwd")
trigger1 = (command = "holdback")
x = -.45

[State 42, 4]
type = changeanim
trigger1 = time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 42, 5]
type = changeanim
trigger1 = vel y > -2
persistent = 0
value = 48

[State 42, 6]
type = posset
trigger1 = pos y > 0 && time > 0
y = 0

[State 42, 7]
type = changestate
trigger1 = pos y >= 0 && time > 0
value = 52

