;Dizzy
[Statedef 5300]
type = S
physics = N
anim = 5300
velset = 0,0
ctrl = 0
facep2 = 1

[State 5300, 1]
type = playsnd
trigger1 = time = 0
value = 5300,0

[State 5300, 2]
type = varset
trigger1 = time = 0
var(0) = 0

[State 5300, 3]
type = varset
trigger1 = time = 0
var(1) = 21

[State 5300, 4]
type = varadd
triggerall = animtime != 0
trigger1 = (command = "x") || (command = "y") || (command = "z")
trigger2 = (command = "a") || (command = "b") || (command = "c")
trigger3 = (command = "F") || (command = "B") || (command = "U") || (command = "D")
var(1) = -1

[State 5300, 5]
type = varset
trigger1 = animtime = 0
var(1) = 0

[State 5300, 5]
type = changestate
trigger1 = var(1) <= 0
value = 0
ctrl = 1