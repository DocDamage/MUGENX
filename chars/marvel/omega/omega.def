;|===========================|
;|Omega Red's definition file|
;|===========================|

;Contains all the filenames needed for the character
;---------------------------------------------------

;Character Information
[Info]

;----------------------------------------------------------------------
name         = "Omega Red"        ;Name of character
displayname  = "Omega Red"        ;Name of character to display
versiondate  = 4,24,2001(My b-day);Version date of character
mugenversion = 10401              ;Version of M.U.G.E.N character works on
author       = "OnslaughtX"       ;Character author name
;----------------------------------------------------------------------

;|==============|
;|Palette Orders|
;|==============|

pal.defaults = 1,2,3,4,5,6        ;Default palettes in order of preference
;----------------------------------------------------------------------

;Files for 
[Files]

;|===============|
;|Character Files|
;|===============|

sprite    = omega.sff             ;Sprite
sound     = omega.snd             ;Sound
anim      = omega.air             ;Animation
cmd       = omega.cmd             ;Command set
cns       = constants.cns         ;Constants
stcommon  = common1.cns           ;Common states
st        = override.cns          ;Override states
st2       = state-2.cns           ;States
st3       = poses.cns
st4       = misc.cns
st5       = moves.cns
st6       = specials.cns
st7       = supers.cns

;|========|
;|Palettes|
;|========|

pal1      = omega.act
pal2      = xmcota.act
pal3      = gold.act
pal4      = black.act
pal5      = blue.act
pal6      = silver.act
pal7      = white.act
pal8      = green.act
pal9      = light_green.act
pal10     = purple.act
pal11     = teal.act
pal12     = yellow.act

;Arcade mode
[Arcade]
;intro.storyboard = intro.def
ending.storyboard = ending.def