;|====================|
;|Omega Red's state -2|
;|====================|

[Statedef -2]
;----------------------------------------------------------------------
;Debug
[State -2, P2Dist X]
type = varset
trigger1 = 1
fvar(0) = p2dist x

[State -2, P2Dist Y]
type = varset
trigger1 = 1
fvar(1) = p2dist y

[State -2, Debug]
type = displaytoclipboard
trigger1 = 1
text = "AI = %d Dizzy = %d P2Dist X = %f Vel X = %f \n Frontedgedist = %f"
params = var(5), var(0), fvar(0), vel x, fvar(2)
;----------------------------------------------------------------------
;Hit Sounds
[State -2, Light Hit]
type = playsnd
triggerall = gethitvar(animtype) = [0, 1]
triggerall = movetype = H
triggerall = random = [0, 300]
triggerall = stateno  = 5000 || stateno = 5070
trigger1 = time = 0
channel = 1
value = 5000,0

[State -2, Strong Hit]
type = playsnd
triggerall = gethitvar(animtype) > 1
triggerall = movetype = H
triggerall = random = [0, 300]
triggerall = stateno = 5000 || stateno = 5070
trigger1 = time = 0
channel = 1
value = 5000,1
;----------------------------------------------------------------------
;FrontEdgeBodyDist
[State -2, FrontEdgeBodyDist]
type = varset
trigger1 = 1
fvar(2) = frontedgebodydist

;Omega Strike Helper Destroyer
[State -2, Omega Strike Helper Destroyer]
type = varset
trigger1 = movetype = H
trigger2 = stateno = [5000, 5999]
var(12) = 0