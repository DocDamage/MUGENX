;|=====================|
;|Omega Red's constants|
;|=====================|

;Variables
;Var0 = Dizzy Activator
;Var1 = Dizzy Timer
;Var5 = AI
;Var6 = AI Move Randomizer
;Var11 = Omega Strike Length
;Var12 = Omega Strike Helper Remover
;Var13 = Omega Strike Toggler
;Var20 = Win Pose Randomizer
;FVar0 = P2Dist X
;FVar1 = P2Dist Y
;FVar2 = FrontEdgeDist
;ID1 = Ground Tentacle
;ID2 = Hand
;ID3 = Omega Strike Tentacle
;ID4 = Omega Strike Tentacle 2
;ID5 = Omega Strike Tentacle Chain
;ID6 = Omega Strike Tentacle Chain 2

[Data]
life = 1000               ;Amount of life to start with
attack = 50               ;100% attack power (more is stronger)
defence = 100             ;100% defensive power (more is stronger)
fall.defence_up = 50      ;Def goes up by 50% everytime player is hit on ground
liedown.time = 40         ;Time player takes before getting up from HIT_LIEDOWN
power = 3000              ;Maximum amount of power
airjuggle = 17            ;Can do 15 points of juggling
sparkno = S2015           ;Default spark number
guard.sparkno = S2010     ;Default guard spark number
KO.echo = 0               ;1 to enable echo on KO
volume = 0                ;Volume offset (negative for softer)
IntPersistIndex = 60      ;Variable to persist
FloatPersistIndex = 40    ;Float Variable to persist

[Size]
xscale = 1                ;Horizontal scaling factor.
yscale = 1                ;Vertical scaling factor.
ground.back = 15          ;Player width (back, ground)
ground.front = 16         ;Player width (front, ground)
air.back = 12             ;Player width (back, air)
air.front = 12            ;Player width (front, air)
z.width = 3               ;Player width (into and out)
height = 60               ;Height of player (for opponent to jump over)
attack.width = 4,4        ;Default attack width: back, front
attack.dist = 160         ;Default attack distance
proj.attack.dist = 90     ;Default attack distance for projectiles
proj.doscale = 0          ;Set to 1 to scale projectiles too   
head.pos = -5, -90        ;Approximate position of head
mid.pos = -5, -60         ;Approximate position of midsection
shadowoffset = 0          ;Number of pixels to vertically offset the shadow
draw.offset = 0,0         ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2             ;Walk forward
walk.back = -1.6          ;Walk backward
run.fwd  = 5.5, 0         ;Run forward (x, y)  - if y<0, player will hop
run.back = -7,-5          ;Run backward (x, y) - if y=0, player will run
jump.neu = 0,-8.4         ;Neutral jumping velocity (x, y)
jump.back = -3.5          ;Jump back Speed (x, y)
jump.fwd = 3              ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-8.1      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.

[Movement]
airjump.num = 0           ;Number of air jumps allowed (opt)
airjump.height = 35       ;Minimum distance from ground before you can air jump (opt)
yaccel = .44              ;Vertical acceleration
stand.friction = .85      ;Friction coefficient when standing
crouch.friction = .82     ;Friction coefficient when crouching