; Definition file for sodom
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Juggernaut by Splode"        ;Name of character
displayname = "Juggernaut" ;Name of character to display
versiondate = 07,23,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "Splode"         ;Character author name
pal.defaults = 1,3,4,2,5,6    

; Files for the player
[Files]
cmd     = juggy.cmd   ;Command set
cns     = juggy.cns   ;Constants
st      = juggy.cns   ;States
stcommon = common1.cns ;Common states
sprite  = juggy.sff   ;Sprite
anim    = juggy.air   ;Animation
sound   = juggy.snd   ;Sound
pal1    = juggy.act  ;Palettes (can have up to 12)
pal2    = alt1.act
pal3    = alt2.act
pal4    = alt3.act
pal5    = alt4.act
pal6    = alt5.act
;pal7	  = sodom.act
;pal8	  = sodom2.act
;pal9 	  = sodom3.act
;pal10	  = sodom4.act
;pal11   = sodom5.act
;pal12   = sodom6.act

[Arcade]
;intro.storyboard = 
;ending.storyboard = ending.def
